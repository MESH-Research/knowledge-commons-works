// General form typography

button,
input,
optgroup,
select,
textarea {
  font-family: @fontName;
}

/* fieldset defaults to min-width: min-content in browsers, which blocks SUI's
 * `.fields { margin: 0 -0.5em }` from canceling `.fields > .field` side padding.
 * min-width: 0 restores those gutters for Segment-based FormSections. */
.invenio-page-body .ui.form fieldset.ui.segment {
  min-width: 0;

  legend {
    display: block;
    width: 100%;
    padding: 0;
    margin: 0;
  }
}

#deposit-form .ui.form .invenio-accordion-field.basic {
  margin-bottom: 1rem;

  > .title {
    border-bottom: none;
    line-height: 1.5em;
  }

  > .content {
    padding: 1rem;
    padding-top: 0.5rem;
  }

  .additional-descriptions .ui.grid .row,
  .invenio-group-field.fields {
    padding: 0;
  }

  .invenio-group-field.fields {
    margin: 0 -0.5em 1em;
  }

  > .content > .invenio-group-field:last-child,
  > .content > .invenio-group-field.fields:last-child,
  > .content > .invenio-field-wrapper:last-child .invenio-group-field.fields {
    margin-bottom: 0;
  }

  > .content > .invenio-group-field:last-child .field,
  > .content > .invenio-field-wrapper:last-child .field {
    margin-bottom: 0 !important;
  }
}

/*
 * Remap Invenio-theme's 5px-step spacing helpers onto the 16px / 8px rem grid.
 * Upstream generates .mt-5 { margin-top: 5px !important; } etc.; here we snap
 * those class names to nearby rem sizes so deposit-form layout aligns with
 * @emSize: 16px. Scoped to #rdm-deposit-form only (experiment).
 *
 *   5  → 0.25rem (4px)   10 → 0.5rem (8px)   12 → 0.75rem (12px)
 *   15 → 1rem (16px)     20 → 1.5rem (24px)   25 → 1.75rem (28px)
 *   30 → 2rem (32px)
 *
 * Step 12: invenio-modular-deposit-form ships `*-12` at 10px (stock 5px grid).
 * Here we override to 0.75rem (12px) for the rem grid — a half-rem between
 * remapped `*-10` (8px) and `*-15` (16px).
 */
.remap-invenio-spacing-helpers(@n, @value) {
  .m-@{n} {
    margin: @value !important;
  }
  .mt-@{n} {
    margin-top: @value !important;
  }
  .mb-@{n} {
    margin-bottom: @value !important;
  }
  .ml-@{n} {
    margin-left: @value !important;
  }
  .mr-@{n} {
    margin-right: @value !important;
  }
  .p-@{n} {
    padding: @value !important;
  }
  .pt-@{n} {
    padding-top: @value !important;
  }
  .pb-@{n} {
    padding-bottom: @value !important;
  }
  .pl-@{n} {
    padding-left: @value !important;
  }
  .pr-@{n} {
    padding-right: @value !important;
  }
}

#rdm-deposit-form {
  #rdm-deposit-form-footer {
    > div {
      width: 100%;
    }

    .sticky-footer-fixed,
    .sticky-footer-static {
      .ui.segment {
        background-color: @ivy !important;
        .nav-bar-message {
          color: @cream;
        }
      }
    }
  }

  /* Package LESS uses @primaryColor / @invertedTextColor; restore brand tokens. */
  .upload-form-pager-mobile-title.ui.dropdown {
    background: @ivy;

    > .text {
      color: @ivory;
    }

    > .dropdown.icon {
      color: @ivory;
    }
  }

  .community-field .ui.items > .item > .community-item-actions {
    flex: 0 0 auto;
    align-self: center;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-left: auto;
  }

  .access-field > #visibility-section {
    background-color: transparent;
    border: none !important;
    box-shadow: none;
    .content {
      border-top: none;
    }
  }

  .remap-invenio-spacing-helpers(5, 0.25rem);
  .remap-invenio-spacing-helpers(10, 0.5rem);
  .remap-invenio-spacing-helpers(12, 0.75rem);
  .remap-invenio-spacing-helpers(15, 1rem);
  .remap-invenio-spacing-helpers(20, 1.5rem);
  .remap-invenio-spacing-helpers(25, 1.75rem);
  .remap-invenio-spacing-helpers(30, 2rem);

  .files-field {
    .file-uploader > .row:first-child {
      padding-top: 0;
      & > .column:first-child:has(.disabled) {
        display: none;
        & + .column {
          margin-top: 0;
          padding-top: 0;
          width: 100% !important;
          .horizontal.list {
            flex-grow: 1;
          }
        }
      }
      & > .column:nth-child(2) {
        .list {
          @media (max-width: @largestMobileScreen) {
            width: 100%;
            .item:nth-child(2) {
              float: right;
            }
          }
        }
      }
    }
    .table {
      @media (max-width: @largestMobileScreen) {
        background: @sidebarBackgroundColor;
        margin-bottom: 0.5rem;
        tr td {
          background: transparent;
        }
      }
      td[data-label="Filename"] {
        a.text-break {
          word-break: break-all;
        }
        @media (max-width: @largestMobileScreen) {
          padding-bottom: 0 !important;
        }
      }
      td[data-label="Size"] {
        @media (max-width: @largestMobileScreen) {
          padding-bottom: 0 !important;
        }
      }
      td[data-label="Progress"] {
        @media (max-width: @largestMobileScreen) {
          &::before {
            content: "";
            display: none;
          }
        }
      }
    }
    .uppy-Root {
      font-family: @fontName;
      color: @ivy;
      .uppy-Dashboard-innerWrap {
        background-color: @sidebarBackgroundColor;
      }
      @media (max-width: @largestMobileScreen) {
        .uppy-Dashboard-innerWrap {
          min-height: 8rem;
          height: unset;
          .uppy-Dashboard-dropFilesHereHint {
            padding-top: 0;
          }
          .uppy-Dashboard-AddFiles {
            padding: 0;
            .uppy-Dashboard-AddFiles-info {
              padding-top: 0;
            }
          }
          .uppy-Dashboard-note {
            padding-top: 0;
          }
        }
      }
    }
  }

}

// Fade + height collapse for ephemeral sidebar toasts (FadeCollapse / FadeCollapseStack).
// Prefer the package copy in deposit_form.less; keep in sync if both load.
.fade-collapse {
  overflow: hidden;
  max-height: 16rem;
  opacity: 1;
  transition-property: max-height, opacity, margin;
  transition-timing-function: ease;

  &.hiding {
    max-height: 0;
    opacity: 0;
    margin-top: 0 !important;
    margin-bottom: 0 !important;
  }

  .fade-collapse-inner > .ui.message.flashed {
    margin-bottom: 0;
  }
}

