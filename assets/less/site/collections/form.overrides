// General form typography

button,
input,
optgroup,
select,
textarea {
  font-family: @fontName;
}

.invenio-page-body .ui.form fieldset.ui.segment {
  min-width: 0;

  legend {
    display: block;
    width: 100%;
    padding: 0;
    margin: 0;
  }
}


#rdm-deposit-form {
  #rdm-deposit-form-footer {
    > div {
      width: 100%; 
    }

    .sticky-footer-fixed,
    .sticky-footer-static {
      .ui.segment {
        background-color: @ivy !important;
        .nav-bar-message {
          color: @cream;
        }
      }
    }
  }
}

