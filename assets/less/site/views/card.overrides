/* Card theme overrides */

.ui.card {
  .meta {
    color: @darkGray;
  }
  .extra {
    a {
      color: @ivy;
    }
  }
  &.attached {
    &.top  {
      border-bottom-right-radius: 0;
      border-bottom-left-radius: 0;
      margin-bottom: -2px;
    }
    &.bottom {
      border-top-left-radius: 0;
      border-top-right-radius: 0;
      margin-top: -2px;
    }
  }
  &.transparent {
    background-color: transparent;
  }


}

.card-set-wrapper {
  display: flex;
  height: 100%;

  &.carousel-item {
    position: relative;
    flex: 0 0 var(--carousel-item-width);
    width: var(--carousel-item-width);
    // Logo square + fixed 2-line title band (+ card content padding).
    min-height: calc(var(--carousel-item-width) + 2.6em + 2rem);
    margin: 0;
    align-items: stretch;
    scroll-snap-align: center;
    scroll-snap-stop: always;

    &::scroll-marker {
      content: "";
      width: 0.75rem;
      height: 0.75rem;
      border-radius: 50%;
      border: 2px solid @ivy;
      background: transparent;
      cursor: pointer;
    }
    &::scroll-marker:target-current {
      background: @ivy;
    }

    // Extra width on hover — just enough for the description overhang.
    --carousel-card-overhang: 2.5rem;

    // Loading skeleton: fill the logo square; no scroll markers or hover morph.
    &.loading-placeholder {
      &::scroll-marker {
        display: none;
      }

      .community-card-top {
        .ui.placeholder {
          height: 100%;
          max-width: none;

          .image {
            height: 100%;
            padding-top: 0;
          }
        }
      }

      .ui.card.community {
        pointer-events: none;
      }
    }

    .ui.card.community {
      display: flex;
      flex-direction: column;
      width: 100% !important;
      max-width: none;
      height: 100%;
      margin: 0;
      // Animate width + transform together; do not animate `left` (auto→50% jumps).
      transition:
        width 0.35s ease,
        height 0.35s ease,
        top 0.35s ease,
        box-shadow 0.35s ease,
        transform 0.35s ease;
      transform: translateX(0);
      z-index: 0;
      overflow: hidden;
      box-shadow: 0 0.1rem 0.35rem rgba(0, 0, 0, 0.08);

      .community-card-top {
        position: relative;
        flex: 0 0 auto;
        width: 100%;
        height: var(--carousel-item-width);
        min-height: var(--carousel-item-width);
      }

      .community-card-logo {
        // Fixed to slot size at rest and on expand — must not scale with card width.
        // Right-aligned so the description overlay overhangs to the left.
        position: absolute;
        top: 0;
        right: 0;
        width: var(--carousel-item-width);
        max-width: var(--carousel-item-width);
        height: var(--carousel-item-width);
        max-height: var(--carousel-item-width);
        flex: 0 0 var(--carousel-item-width);

        > a {
          display: block;
          width: 100%;
          height: 100%;
        }

        .image {
          aspect-ratio: 1;
          width: 100% !important;
          height: 100% !important;
          max-width: var(--carousel-item-width);
          max-height: var(--carousel-item-width);
          overflow: hidden;

          img {
            object-fit: cover;
            width: 100%;
            height: 100%;
          }
        }
      }

      .community-card-overlay {
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0;
        right: 0;
        z-index: 1;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        padding: 0.75rem 1rem;
        opacity: 0;
        pointer-events: none;
        overflow: auto;
        color: var(--community-header-fg, #fff);
        background: linear-gradient(
          to left,
          rgb(from var(--community-header-bg, @ivy) r g b / 0.45) 0,
          var(--community-header-bg, @ivy) var(--carousel-item-width),
          var(--community-header-bg, @ivy) 100%
        );
        backdrop-filter: blur(0.35rem);
        -webkit-backdrop-filter: blur(0.35rem);
        transition: opacity 0.3s ease;

        .desc-full {
          font-size: @small;
          line-height: 1.4;
          opacity: 0;
          // Keep transition props stable; only delay changes on hover (avoids cancel).
          transition-property: opacity;
          transition-duration: 0.3s;
          transition-timing-function: ease;
          transition-delay: 0s;
        }
      }

      .community-card-footer {
        flex: 0 0 auto;
        position: relative;

        .header {
          display: -webkit-box;
          -webkit-box-orient: vertical;
          -webkit-line-clamp: 2;
          overflow: hidden;
          margin-bottom: 0;
          line-height: 1.3;
          height: 2.6em;
          min-height: 2.6em;
          max-height: 2.6em;
          opacity: 1;
        }
      }

      .community-card-footer-swap {
        height: 0;
        margin: 0;
        padding: 0;
        overflow: hidden;
        pointer-events: none;

        .parents {
          opacity: 0;
          font-size: @small;
          line-height: 1.35;
          overflow: hidden;
          transition: opacity 0.3s ease;

          a {
            color: @ivy;
          }
        }
      }

      &:hover,
      &:focus-within {
        position: absolute;
        left: 0;
        top: -0.95rem;
        z-index: 2;
        width: calc(
          var(--carousel-item-width) + var(--carousel-card-overhang)
        ) !important;
        min-height: calc(100% + 1.9rem);
        height: auto;
        transform: translateX(calc(var(--carousel-card-overhang) / -2));
        box-shadow: 0 0 1.25rem rgba(0, 0, 0, 0.18);

        .community-card-overlay {
          opacity: 1;
          pointer-events: auto;

          .desc-full {
            opacity: 1;
            transition-delay: 0.35s;
          }
        }

        .community-card-footer {
          padding-bottom: 1rem;

          .header {
            animation: carousel-card-title-fade 0.7s ease forwards;
          }
        }

        .community-card-footer-swap {
          height: auto;
          overflow: visible;
          pointer-events: auto;
          margin-top: 0.4rem;

          .parents {
            opacity: 1;
            transition-delay: 0.4s;
          }
        }
      }
    }

    // Track ends: grow inward only so the overhang isn't clipped by overflow-x.
    &:first-of-type .ui.card.community:hover,
    &:first-of-type .ui.card.community:focus-within {
      transform: translateX(0);
    }

    &:last-of-type:not(:first-of-type) .ui.card.community:hover,
    &:last-of-type:not(:first-of-type) .ui.card.community:focus-within {
      transform: translateX(calc(var(--carousel-card-overhang) * -1));
    }
  }
}

@keyframes carousel-card-title-fade {
  0% {
    opacity: 1;
  }
  15% {
    opacity: 0;
  }
  55% {
    opacity: 0;
  }
  100% {
    opacity: 1;
  }
}

#Contributors-tab-section {
  .ui.card {
    .description {
      span, small {
        &::after {
          content: " · "
        }
        &:last-child {
          &::after {
            content: ""
          }
        }
      }
    }
    .extra {
      a:not(.ui),
      img {
        small {
          display: inline-block;
          vertical-align: middle;
        }
      }
      a:not(.ui) {
        padding-right: 1rem;
      }
    }
  }
}

.deposit-right-sidebar .ui.card:not(.transparent),
.ui.card.borderless.facet {
  background-color: @sidebarBackgroundColor;
  padding: 1rem;
  margin-bottom: 1rem;
  border-radius: @defaultBorderRadius;
  width: auto;
  border: 1px solid @sidebarBorderColor !important; // @verdigris30 !important;
  box-shadow: 0px 0px 15px 0px transparent;

  > .content {
    margin-bottom: 0;
    .header {
      color: @sidebarHeaderColor;
      margin-left: 0.5rem;
    }
    .ui.list {
      margin-left: -0.5rem;
      > .item > a {
        margin-left: 1rem;
      }
    }
    .ui.checkbox {
      padding-top: 0;
      &.content {
        padding-left: 0.5rem;
      }
      label {
        font-size: @small;
      }
    }
    > .ui.checkbox {
      padding-top: 1rem;
      padding-left: 0.75rem;
    }
  }
  .item {
    padding: 0;
    .accordion.ui {
      .facet-wrapper.parent {
        padding: 0;
        .facet-wrapper {
          .button {
            margin-right: 2px;
          }
        }
      }
      .content.active {
        padding-bottom: 1rem;
      }
    }
    .facet-wrapper.content:not(.parent) {
      padding-top: 0;
    }
  }
}

.deposit-right-sidebar .ui.card {
  padding-top: 0;
}
