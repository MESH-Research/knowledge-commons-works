.communities-settings,
.communities-members {
  .accordion.ui.inverted.invenio-accordion-field {
    .title {
      background-color: transparent;
      font-size: @big;
      font-weight: bold;
      color: @textColor;
      padding-left: 0.75rem;
      border-bottom: none;
      padding-bottom: 0;
      margin-bottom: 0;
    }
    &[data-label="Linked Commons Group"] {
      .content.active {
        padding-left: 1rem;
      }
    }
  }
}


