.ui.header {
  // h1& → h1.ui.header (not &h1 → .ui.headerh1)
  h1& {
    color: @ivy;
    margin-top: 2rem;
  }
  &.tiny {
    font-size: @tiny;
    font-weight: bold;
  }

  // Semantic colors (align with button.overrides tokens)
  &.primary {
    color: @ivy80;
  }
  &.secondary {
    color: @redDark;
  }
  &.positive {
    color: @positiveTextColor;
  }
  &.negative {
    color: @redDark;
  }
  &.warning {
    color: @warningTextColor;
  }
  &.info,
  &.blue {
    color: @blue;
  }
}

.deposit-form-title {
  h1.ui.header {
    margin-bottom: 0;
  }
}
.page-subheader {
  @media all and (max-width: @largestMobileScreen) {
    text-align: center;
  }
  h1.ui.header,
  h1.ui.huge.header {
    margin-top: 1rem;
    font-size: 3rem;
    @media all and (max-width: @largestMobileScreen) {
      font-size: 2rem;
      margin-top: 2rem;
    }
  }
}


h2.ui.header {
  color: @ivy;
  &.preselected-community-header {
    color: @secondaryColor;
    margin-top: 0;
  }
  @media (max-width: @largestMobileScreen) {
    font-size: 1.5rem;
  }
}

dl.details-list {
  dt.ui.tiny.header {
    margin-bottom: 0.25rem;
    margin-top: 1rem;
  }
  dd {
    overflow-wrap: break-word;
  }
}

.carousel h2.ui.header,
#records-list h2.ui.header {
  font-size: 2.5rem;
  color: @ivy;
  @media (max-width: @largestMobileScreen) {
    font-size: 2rem;
    text-align: center;
  }
  @media all and (min-width: @largestMobileScreen) and (max-width: @largestTabletScreen) {
    text-align: center;
  }
}


.communities-settings h2.ui.small.header {
  font-size: @big;
  font-weight: bold;

  &:first-of-type {
    margin-top: 0.25em;
  }

  .sub.header {
    font-style: italic;
  }
}

#detail-main-content {
  h1.ui.header {
    margin-top: 0;
    color: @ivy80;
  }

  .main-record-content {
    #record-title-section {
      @media only screen and (max-width: @largestMobileScreen) {
        h1 {
          font-size: 1.5rem;
          padding-top: 1rem;
        }
      }
    }

    h2 {
      font-size: @large;
    }
    @media only screen and (max-width: @largestMobileScreen) {
      h2 {
        font-size: @large;
        margin-bottom: 0.5rem;
      }
    }

    #detail-main-tabs {
      .record-details-tab {
        &.Subjects {
          h2.tiny.header {
            margin-bottom: 1rem;
          }
          h3.tiny.header.mt-10 {
            margin-top: 1.5rem !important;
            font-size: @medium;
          }
        }
      }
    }
  }


  .sidebar-container {
    h2.ui.header {
      color: @sidebarHeaderColor;
    }
    .segment {
      h3.ui.header {
        color: @sidebarHeaderColor;
      }
    }
  }
}

.sidebar-container {
  .ui.attached.header {
    border-color: @sidebarBorderColor;
    &.top {
      border-bottom: 0;
      padding-bottom: 0.5rem;
      background-color: @sidebarBackgroundColor;
    }
  }
  .ui.segment.rdm-sidebar > h2.ui.small.header,
  .ui.segment.rdm-sidebar > .header {
    border-bottom: 0;
    margin-bottom: 0;
  }
  .ui.tiny.header {
    color: @sidebarHeaderColor;
  }
  &#record-versions {
    .ui.header.version-label {
      flex-grow: 1;
      line-height: 1em;
      min-height: 1em;
      padding: @inputPadding;
      padding-left: 0;
      position: relative;
      border: 1px solid transparent;

      &.preview {
        color: @infoTextColor;
      }
    }
  }
}

.communities-frontpage {
  .ui.grid {
    .ui.row {
      .ui.header {
        display: inline-block;
      }
    }
  }
}


.request-detail-page > .computer-flex-header.rel-mt-2 {
  margin-top: 1rem !important;
}
.request-detail-page > .flex.wrap.space-between:first-child {
  margin-top: 1rem !important;
}

.ui.form {
  h2 {
    font-weight: normal;
  }
}
