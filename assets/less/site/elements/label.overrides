/* Label theme overrides */

@positive-colors: {
    background-color: @positiveColor;
    border: 1px solid;
    color: @white;
  };

@negative-colors: {
  border-color: @negativeColor;
  background-color: @negativeColor;
  color: @white;
};

@positive-basic-colors: {
  background-color: @white;
  border-color: lighten(@greenLight, 20%);
  color: @positiveColor;
}

.ui.label.basic,
.ui.label,
.ui.small.labels .label,
.ui.list .item .label,
.ui.menu.secondary.pointing > .item > .label {
  background-color: @sidebarBackgroundColor;
  border: 1px solid @sidebarBorderColor; // @verdigris40;
  color: @ivy80;

  &.transparent {
    background-color: transparent;
    border-color: transparent;
  }

  &.neutral {
    background-color: @ivory;
    border-color: darken(@ivory, 2%);
    color: @ivy60;
  }

  font-size: @fontSizeSmall;
  &.small {
    font-size: @fontSizeSmall;
    margin-bottom: 0.25rem;
    margin-top: 0.25rem;
  }
  &.image {
    background-color: @sidebarBackgroundColor !important;
  }

  // Access status labels

  &.access-status.open {
    @positive-colors();

    &.basic {
      @positive-basic-colors();
    }
  }

  &.access-status.metadata-only {
    background-color: @white;
    border-color: @formInputBorderColor;
    color: @ivy70;
  }

  &.access-status.restricted {
    @negative-colors();
  }

  // Semantic color labels

  &.positive {
     @positive-colors();

    &.basic {
      @positive-basic-colors();
    }
  }

  &.negative {
    @negative-colors();
  }

  // Theme color labels

  &.primary {
    background-color: @sidebarBackgroundColor;
    border-color: @mint40;
    color: @primaryColor;

    .detail {
      background-color: @mint50;
      opacity: 1;
    }

    &.basic {
      background-color: transparent;
      border: 1px solid @verdigris40;
    }
  }

  &.secondary {
    background-color: @gold20;
    border: 1px solid @gold40;
    color: @darkerGold;

    &.basic {
      background-color: @white;
      border-color: @formInputBorderColor;
      color: @ivy70;
    }
  }


  // Special label types

  &.sticker {
    border: 1px solid #fff;
    box-shadow: 0 0 5px 0 rgba(0, 0, 0, 0.2);
  }


  &.floating {

    // notifications

    &.unread-notifications-badge {
      top: 0.7rem;
      left: 87%;
      min-width: 1.5rem;
      min-height: 1.5rem;
      padding: 0.25rem !important;
      line-height: 1rem;
      text-align: center;
      border-radius: 0;
    }

    &.request-search-filter-unread {
      padding: 0.25em 0.5em;
      font-size: 0.8em;
      font-weight: bold;
      border-radius: 0;
      top: -0.5rem;
      left: 95%;
    }
  }
}



.ui.form,
.ui.modal {
  .field {
    .ui.label.prompt {
      font-size: 1rem;
    }

    &.error {
      > label {
        color: @errorColor;
      }
      .prompt.label {
        background-color: @errorColor !important;
        border-color: @errorColor !important;
        color: #fff !important;
      }
    }

    .field:not(.error),
    .fields:not(.error) {
        & > label,
        & .checkbox:not(.toggle):not(.slider) label {
          color: @textColor;
      }
    }
  }
}

// FIXME: This is a temporary fix for the search sort labels
#invenio-search-config .row .column label:first-child {
  display: none;
}

#community-detail-header .ui.label.access-status.restricted {
    position: absolute;
    left: -100%;
    top: -50%;
}
