/* List theme overrides */
.ui.list > .deposit-drag-listitem {
  i.icon.drag-anchor {
    padding-top: 0.35em;
  }
  .header {
    line-height: 1.8em;
  }
}

#licenses ul.details-list li.has-popup {
    background-color: transparent;
    &:hover {
        background-color: transparent;
    }
}

.details-list {
    dd {
        overflow-wrap: break-word;
    }
}

.simple-list {
  list-style-type: none;
  padding-left: 0;
}
