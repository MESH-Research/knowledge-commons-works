/* Icon theme overrides */

.inline-id-icon {
  display: inline-block;
  vertical-align: middle;
  &.hc_username {
    margin-bottom: 2px;
  }
}

.identifier-icon-link {
  display: inline-flex;
  align-items: center;
  vertical-align: middle;
  &.email-icon-link {
    i {
      margin: 0;
      height: auto;
    }
  }
}

// Short-list only: drop trailing icon margin before .separated semicolon
// (!important to override Invenio .mr-5 spacing helper)
#creatibutors-list-section {
  .creatibutor-wrap a.identifier-icon-link:last-child .inline-id-icon,
  .creatibutor-wrap a[class$="-icon-link"]:last-child .inline-id-icon {
    margin-right: 0 !important;
  }
}

.sidebar-container {
  &#record-versions {
    .ui.header.version-label {
      .icon.loading.tiny {
        font-size: @tiny;
      }
      &.preview {
        > .icon {
          display: inline-block;
          font-size: 1em;
          margin: 0em;
          margin-right: 0.28em;
          position: absolute;
          right: 0em;
          text-align: center;
        }
      }
    }
  }
}

#deposit-form .ui.form .field.error > .ui.list > .item.error > .drag-anchor {
  color: @errorTextColor;
}

#rdm-footer-element .footer-top {
  .icon {
    svg {
      fill: #fff;
      position: relative;
      top: 0.25rem;
    }
  }
}

.error-page {
  .icon.huge {
    color: @gold50;
  }
}

.creatibutors-list {
  .icon.mail {
    margin-bottom: 2px;
    padding-left: 1px;
    display: inline-block;
  }
}
