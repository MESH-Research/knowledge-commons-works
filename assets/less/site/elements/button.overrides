// re-declare variables that for some reason aren't picked up
@negativeTextColor: @redDark;

// ---------------------------------------------------------------------------
// Button ring colors (CSS custom properties)
// Defaults on .ui.button; variants override --button-ring-* so .borderless
// and shared box-shadow formulas compose without re-declaring shadows.
// ---------------------------------------------------------------------------
.ui.button {
  --button-ring-color: @ivy20;
  --button-ring-color-hover: darken(@ivy20, 3%);
  --button-ring-color-disabled: @ivy30;
}

.ui.button.icon {
  &.fluid.labeled.centered {
    padding-right: 3.25em !important;
  }
  &.right.labeled {
    padding-right: @labeledIconWidth + @horizontalPadding !important
  }
}

// Text alignment (SUI has left/right/center.aligned for headers/grid, not buttons).
.ui.button.left.aligned {
  text-align: left;
}

.ui.buttons.basic,
.ui.buttons:has(.ui.button.basic) {
  border-color: transparent;
  .ui.button {
    position: relative;
  }

  .ui.button:last-child {
    margin-left: 3px;
    border-left: none;
  }
  > .ui.button.active:not(.positive):not(.negative) {
    --button-ring-color: @ivy20;
    --button-ring-color-hover: darken(@ivy40, 3%);
    background-color: @mint30 !important;
    color: @ivy;
    box-shadow: 0px 0px 0px 1px var(--button-ring-color) inset,
      0px 0em 0px 0px @ivyRgba10 inset;

    &:hover,
    &:active,
    &:focus {
      background-color: @mint50 !important;
      color: @ivy;
      box-shadow: 0px 0px 0px 1px var(--button-ring-color-hover) inset,
        0px 0em 0px 0px @ivyRgba10 inset;
    }
  }
}

// Basic styles

.ui.buttons > .ui.button:not(.basic):not(.inverted),
.ui.buttons:not(.basic):not(.inverted) > .ui.button,
.ui.button:not(.basic),
.ui.info.message .button:not(.basic),
.ui.info.message .ui.button.icon:not(.basic) {
  background-color: @white;
  color: @ivy90;
  box-shadow: 0px 0px 0px 1px var(--button-ring-color) inset;

  &:hover,
  &:active,
  &:focus {
    background-color: @mint30 !important;
    color: @ivy;
    box-shadow: 0px 0px 0px 1px var(--button-ring-color-hover) inset;
    cursor: pointer;
  }

  &.labeled.icon > .icon {
    background-color: @ivy20;
  }

  &:disabled,
  &.disabled {
    box-shadow: 0px 0px 0px 1px var(--button-ring-color-disabled) inset !important;
  }

  &.search {
    --button-ring-color: darken(@secondaryColor, 3%);
    --button-ring-color-hover: darken(@secondaryColor, 10%);
    background-color: @secondaryColor;
    color: @white;
    box-shadow: 0px 0px 0px 1px var(--button-ring-color) inset,
      0px 0em 0px 0px var(--button-ring-color) inset !important;
    &:hover,
    &:active,
    &:focus {
      background-color: darken(@secondaryColor, 10%) !important;
      box-shadow: 0px 0px 0px 1px var(--button-ring-color-hover) inset,
        0px 0em 0px 0px var(--button-ring-color-hover) inset !important;
    }
  }

  &.primary:not(.basic):not(.inverted),
  &.primary {
    --button-ring-color: @ivy;
    --button-ring-color-hover: @ivy90;
    background-color: @ivy80; // @verdigrisDark;
    color: @white;
    box-shadow: 0px 0px 0px 1px var(--button-ring-color) inset;
    &:hover,
    &:active,
    &:focus {
      background-color: @ivy !important;
      box-shadow: 0px 0px 0px 1px var(--button-ring-color-hover) inset;
    }
    &.labeled.icon > .icon {
      background-color: transparent;
    }
  }

  &.secondary:not(.basic):not(.inverted),
  &.secondary {
    --button-ring-color-hover: darken(@secondaryColor, 10%);
    &:hover,
    &:active,
    &:focus {
      background-color: darken(@secondaryColor, 10%) !important;
      box-shadow: 0px 0px 0px 1px var(--button-ring-color-hover) inset;
    }
  }

  &.negative {
    --button-ring-color: @redDark;
    background-color: @negativeTextColor !important;
    color: @white;
    box-shadow: 0px 0px 0px 1px var(--button-ring-color) inset,
      0px 0em 0px 0px rgba(0, 0, 0, 0.15) inset;

    &:hover,
    &:active,
    &:focus {
      background-color: @negativeTextColorDarker !important;
    }
  }

  &.positive {
    --button-ring-color: @positiveColor;
    --button-ring-color-hover: @positiveColorDown;
    color: @white;
    background-color: @positiveColor !important;
    box-shadow: 0px 0px 0px 1px var(--button-ring-color) inset;

    &:hover,
    &:active,
    &:focus {
      background-color: @positiveColorDown !important;
      box-shadow: 0px 0px 0px 1px var(--button-ring-color-hover) inset;
    }

    .icon {
      color: @white;
    }
  }

  &.warning {
    --button-ring-color-hover: @warningColorDown;
    background-color: @warningTextColor !important;
    color: @white;

    &:hover,
    &:active,
    &:focus {
      background-color: @warningColorDown !important;
      box-shadow: 0px 0px 0px 1px var(--button-ring-color-hover) inset;
    }
  }

  &.blue {
    background-color: @blue;
    color: @white;
    &:hover,
    &:active,
    &:focus {
      background-color: darken(@blue, 5%) !important;
    }
  }

  &.icon {
    &.close-btn {
      --button-ring-color: #b54f1e;
      margin-top: 0;
      float: right;
      background-color: @redDark !important;
      color: @white;
      box-shadow: 0px 0px 0px 1px var(--button-ring-color) inset,
        0px 0em 0px 0px rgba(0, 0, 0, 0.15) inset;

      &:hover,
      &:active,
      &:focus {
        background-color: darken(@redDark, 5%) !important;
      }
    }
    &.massive.left.fluid.labeled {
      padding-left: 3em !important;
    }
  }
}

.ui.form {
  .ui.buttons > .ui.button:not(.basic):not(.inverted),
  .ui.buttons:not(.basic):not(.inverted) > .ui.button,
  .ui.button:not(.basic),
  .ui.info.message .button:not(.basic),
  .ui.info.message .ui.button.icon:not(.basic) {
    &.icon.close-btn:not(:has(+ label)) {
        margin-top: 1.7rem;
    }
  }
}


// Basic

.ui.buttons > .ui.button.basic:not(.inverted),
.ui.buttons.basic:not(.inverted) > .ui.button,
.ui.button.basic {
  --button-ring-color-hover: @ivy30;
  background-color: @white;
  color: @ivy !important;
  box-shadow: 0px 0px 0px 1px var(--button-ring-color) inset;
  &:hover,
  &:active,
  &:focus {
    background-color: @mint30 !important;
    color: @ivy !important;
    box-shadow: 0px 0px 0px 1px var(--button-ring-color-hover) inset;
    cursor: pointer;
  }

  &.positive {
    --button-ring-color: @positiveBorderColor;
    --button-ring-color-hover: @positiveBorderColor;
    color: @positiveTextColor;
    background-color: @white !important;
    box-shadow: 0px 0px 0px 1px var(--button-ring-color) inset !important;

    &:hover,
    &:active,
    &:focus {
      background-color: @positiveBackgroundColor !important;
      color: @positiveTextColorDarker !important;
      box-shadow: 0px 0px 0px 1px var(--button-ring-color-hover) inset !important;
    }
    &.active {
      background-color: @positiveTextColor !important;
      color: @positiveBackgroundColor !important;
      box-shadow: 0px 0px 0px 1px var(--button-ring-color) inset;
    }

    .icon {
      color: @white;
    }
  }

  &.negative {
    --button-ring-color: @negativeBorderColor;
    --button-ring-color-hover: @negativeBorderColor;
    color: @redDark !important;
    background-color: @white !important;
    box-shadow: 0px 0px 0px 1px var(--button-ring-color) inset,
      0px 0em 0px 0px rgba(0, 0, 0, 0) inset !important;
    &:hover,
    &:active,
    &:focus {
      background-color: @negativeBackgroundColor !important;
      color: @negativeTextColorDarker !important;
    }
    &.active {
      --button-ring-color: @negativeTextColor;
      background-color: @negativeTextColor !important;
      color: @negativeBackgroundColor !important;
      box-shadow: 0px 0px 0px 1px var(--button-ring-color) inset,
        0px 0em 0px 0px rgba(0, 0, 0, 0) inset !important;
      }
  }

  &.primary {
    --button-ring-color: @verdigris60;
    --button-ring-color-hover: @verdigris70;
    color: @ivy80; //@verdigrisDark;
    background-color: @white;
    box-shadow: 0px 0px 0px 1px var(--button-ring-color) inset,
      0px 0em 0px 0px rgba(0, 0, 0, 0.15) inset;
    &:hover,
    &:active,
    &:focus {
      color: @ivy80 !important;
      background-color: @seafoam !important;
      box-shadow: 0px 0px 0px 1px var(--button-ring-color-hover) inset,
        0px 0em 0px 0px rgba(0, 0, 0, 0.15) inset;
    }
  }

  &.secondary {
    --button-ring-color: @secondaryColor;
    --button-ring-color-hover: @secondaryColor;
    color: @verdigrisDark !important;
    background-color: @white !important;
    box-shadow: 0px 0px 0px 1px var(--button-ring-color) inset;
    &:hover,
    &:active,
    &:focus {
      color: @ivy80 !important;
      background-color: @white !important;
      box-shadow: 0px 0px 0px 1px var(--button-ring-color-hover) inset,
        0px 0em 0px 0px rgba(0, 0, 0, 0.15) inset;
    }

  }

}

// affecting both basic and regular

.ui.button,
.ui.basic {
  &.transparent {
    background-color: transparent !important;
    &:hover,
    &:active,
    &:focus {
      background-color: transparent !important;
      color: @ivy;
    }
  }

  &.borderless {
    box-shadow: none !important;
    border: 0 !important;

    // Resting only: allow theme hover chrome unless also .borderless-hover
    &:not(.borderless-hover):hover,
    &:not(.borderless-hover):active,
    &:not(.borderless-hover):focus {
      // Geometry fixed; color from --button-ring-color-hover (variants compose)
      box-shadow: 0px 0px 0px 1px var(--button-ring-color-hover) inset !important;
      border: 0 !important;
    }

    &.borderless-hover,
    &.borderless-hover:hover,
    &.borderless-hover:active,
    &.borderless-hover:focus {
      box-shadow: none !important;
      border: 0 !important;
    }
  }

  &.link-button {
    background: transparent;
    border: 0;
    box-shadow: none;
    color: @linkColor;
    font-weight: normal;
    padding: 0;
    vertical-align: baseline;
    text-decoration: underline;
    text-decoration-color: transparent;

    &:hover,
    &:focus,
    &:active {
      background: transparent;
      background-color: transparent !important;
      box-shadow: none;
      color: @linkHoverColor;
      text-decoration-color: currentColor;
    }
  }
}

.invenio-fieldset.resource_type {
    .menu .button.item {
        color: @verdigrisDark;
        box-shadow: none;
        &:active,
        &:focus,
        &:hover {
            background-color: @mint50 !important;
        }
        &.active {
          &:active,
          &:focus,
          &:hover {
              background-color: darken(@verdigrisDark, 5%) !important;
          }
        }
    }
}


.sidebar-container .button.ui.fluid.labeled.icon.primary,
.sidebar-container .button.ui.fluid.icon.primary {
  padding-left: 1rem !important;
}

.sidebar-container .button.ui.fluid.labeled.icon:not(.primary),
.sidebar-container .button.ui.fluid.icon:not(.primary) {
  --button-ring-color: @sidebarBorderColor;
  background-color: @sidebarBackgroundColor !important;
  padding-left: 1rem !important;
  font-weight: bold;
  color: @sidebarHeaderColor !important;
  box-shadow: 0px 0px 0px 1px var(--button-ring-color) inset;
  margin-right: 0;

  &.secondary {
    --button-ring-color: @warningBorderColor;
    background-color: @secondaryBackgroundColor !important;
    color: @warningTextColor !important;
    box-shadow: 0px 0px 0px 1px var(--button-ring-color) inset !important;
  }
  &.secondary.basic {
    background-color: transparent !important;
    color: darken(@warningTextColor, 10%) !important;
    .icon {
      background-color: @warningBackgroundColor !important;
      color: @warningTextColor !important;
    }
    &:hover,
    &:active,
    &:focus {
      background-color: @warningBackgroundColor !important;
      .icon {
        background-color: darken(@warningBackgroundColor, 5%) !important;
      }
    }
  }
}

#record-export {
  .ui.basic.button {
    background-color: @sidebarBackgroundColor !important;
    padding-left: 1rem !important;
    font-weight: bold;
    color: @sidebarHeaderColor !important;
    box-shadow: 0px 0px 0px 1px @sidebarBorderColor inset, 0px 0em 0px 0px @sidebarBorderColor inset !important;
  }
  .menu button {
    width: 100%;
    background-color: transparent;
  }
}

#record-details {
  .header {
    .icon {
      font-size: 1rem;
    }
  }
  .doi-copy-button {
    top: -1rem;
    position: relative;
  }
}

#detail-main-content .button.tiny.show-less {
  margin-bottom: 1rem;
}

#frontpage-search-bar {
  .ui.form .ui.input button[type="submit"] {
      outline: 3px solid @gold;
    }
  .ui.icon.primary.button {
    outline: 3px solid @verdigrisDark;
    @media all and (max-width: 1260px) {
      padding-left: 3.6rem !important;
      padding-right: 1.5rem !important;
    }
  }
}

// Strip UA button chrome so a <button> can inherit surrounding nav/menu styles.
button.unstyled {
  -webkit-appearance: none;
  appearance: none;
  background: transparent;
  border: 0;
  border-radius: 0;
  box-shadow: none;
  color: inherit;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  font: inherit;
  line-height: inherit;
  margin: 0;
  padding: 0;
  text-align: inherit;
  text-decoration: none;
  vertical-align: middle;

  &:hover,
  &:focus,
  &:active {
    background: transparent;
    box-shadow: none;
    color: inherit;
    outline: none;
  }

  &:focus-visible {
    outline: 1px dotted currentColor;
    outline-offset: 2px;
  }
}

.community-admin-cog-button {
  display: block;
}
