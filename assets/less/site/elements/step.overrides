@stepBorderColor: @sidebarBorderColor;
@stepBackgroundColor: @sidebarBackgroundColor;
@stepTextColor: @sidebarHeaderColor;
@requiredBackgroundColor: darken(@sidebarBackgroundColor, 5%);
@requiredBorderColor: darken(@sidebarBackgroundColor, 18%);
@activeBackgroundColor: @ivy80;
@activeBorderColor: @ivy80;
@activeTextColor: @white;
@borderRadius: 0.25rem;

#rdm-deposit-form-header .ui.steps {
    margin-top: 1rem;
    // border-color: @sidebarBorderColor;
    border-color: transparent;
    .step.link {
      // Steps render as Buttons (`as={Button}`); kill the button inset ring so
      // it doesn't fight the real borders the chevron `:after` needs.
      box-shadow: none;
      transition: all 0.3s ease;
      line-height: 1.15rem;
      padding-top: @small;
      padding-bottom: @small;
      padding-right: @small;
      padding-left: @small;
      background-color: @stepBackgroundColor;
      border-color: @stepBorderColor;
      border-top: 1px solid @stepBorderColor;
      border-bottom: 1px solid @stepBorderColor;
      border-left: 0;
      @media all and (min-width: @largeMonitorBreakpoint) {
        padding-right: 2rem;
        padding-left: 2rem;
      }
      .title {
        font-size: @small;
        color: @stepTextColor;
      }
      &:first-child {
        border-left: 1px solid @stepBorderColor;
      }
      &:last-child {
        border-right: 1px solid @stepBorderColor;
      }
      &:after {
        transition: all 0.3s ease;
        background-color: @stepBackgroundColor;
        border-color: @stepBorderColor;
        right: -1px;
      }
      &:hover,
      &:focus,
      &:active {
        background-color: darken(@stepBackgroundColor, 5%) !important;
        box-shadow: none;
        &::after {
          background-color: darken(@stepBackgroundColor, 5%);
        }
      }
      &:nth-child(-n+3) {
        background-color: @requiredBackgroundColor;
        border-left: 0;
        border-right: 1px solid @requiredBorderColor;
        border-top: 1px solid @requiredBorderColor;
        border-bottom: 1px solid @requiredBorderColor;
        &:first-child {
          border-left: 1px solid @requiredBorderColor;
        }
        &:after {
          transition: all 0.3s ease;
          background-color: @requiredBackgroundColor;
          border-color: @requiredBorderColor;
        }
        &:before {
          content: " ";
          position: absolute;
          top: -2.1rem;
          height: 2rem;
          line-height: 2rem;
          background-color: @positiveBackgroundColor;
          border-top: 1px solid @positiveBorderColor;
          border-left: 1px solid @positiveBorderColor;
          border-right: 1px solid @positiveBorderColor;
          color: @positiveColor; //@stepTextColor;
          display: block;
          width: 97%;
        }
        &:hover,
        &:focus,
        &:active {
          background-color: darken(@requiredBackgroundColor, 8%) !important;
          box-shadow: none;
          color: @ivy;
          &::after {
            background-color: darken(@requiredBackgroundColor, 8%) !important;
          }
        }
      }
      &:nth-child(1) {
        &:before {
          border-right: 0px;
          border-radius: @borderRadius 0 0 0;
        }
      }
      &:nth-child(2) {
        &:before {
          content: "Required";
          width: 120%;
          border-right: 0px;
          border-left: 0px;
        }
      }
      &:nth-child(3) {
        &:before {
          border-left: 0px;
          border-radius: 0 @borderRadius 0 0;
        }
      }
      & + .has-error.active {
        border-right: 1px solid @errorTextColor;
      }
      &:focus-visible {
        outline: none !important;
        border-top: 3px solid red;
      }
      &.active {
        background-color: @activeBackgroundColor;
        color: @activeTextColor;
        border-color: @activeBorderColor;
        .title {
          color: @activeTextColor;
        }
        &::after {
          color: @activeTextColor;
          background-color: @activeBackgroundColor;
          border-color: @activeBorderColor;
        }
        &:hover,
        &:focus,
        &:active {
          background-color: @ivy !important;
          box-shadow: none;
          &::after {
            background-color: @ivy !important;
          }
        }
      }
      &:has(+ .active) {
        border-right-color: @activeBorderColor;
        &::after {
          border-color: @activeBorderColor;
        }
      }
      &.has-error {
        color: @errorColor; // was @errorTextColor
        background-color: @negativeBackgroundColor;
        border: 1px solid @negativeBorderColor;
        border-left: 0;
        .title {
          color: @errorTextColor;
        }
        &:first-child {
          border-left: 1px solid #f8e4e4;
        }
        &:last-child {
          border-right: 1px solid #f8e4e4;
        }
        &:hover,
        &:focus,
        &:active {
          background-color: darken(@negativeBackgroundColor, 3%) !important;
          &::after {
            background-color: darken(@negativeBackgroundColor, 3%) !important;
          }
        }
        &.active {
          color: @errorColor;
          background-color: @errorTextColor;
          border-color: @errorTextColor;
          .title {
            color: @errorBackgroundColor;
          }
          &::after {
            color: @negativeBackgroundColor;
            background-color: @errorTextColor;
            border-color: @errorTextColor;
          }
          &:hover,
          &:focus,
          &:active {
            background-color: @errorColor !important;
            border-color: @errorColor !important;
            &::after {
              background-color: @errorColor !important;
              border-color: @errorColor !important;
            }
          }
        }
        &:after {
          background-color: @negativeBackgroundColor;
          border-color: #e0b4b4;
        }
        // &:before {
        //   content: "\f06a";
        //   font-family: Icons;
        //   font-size: @huge;
        //   position: absolute;
        //   bottom: -1.5rem;
        // }
      }
    }
  }
