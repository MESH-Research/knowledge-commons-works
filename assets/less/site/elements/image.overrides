/* Image theme overrides */

.ui.image.dashboard-header-avatar {
  max-width: 64px;
  @media all and (max-width: @largestMobileScreen) {
    margin-bottom: 2rem;
  }
}

.ui.image.community-image {
  margin-top: 0;
  img {
    object-fit: cover;
    min-height: 5rem;
    min-width: 5rem;
    max-height: 5rem;
    max-width: 5rem;
    border-radius: @defaultBorderRadius;
    box-shadow: 0 0 0.5rem rgb(0 0 0 / 5%);
    border: 1px solid @sidebarBorderColor;
  }

  &.mini {
    img {
      object-fit: cover;
      min-height: 3rem;
      min-width: 3rem;
      max-height: 3rem;
      max-width: 3rem;
    }
  }

  &.micro {
      img {
        min-height: 2.5rem;
        min-width: 2.5rem;
        max-width: 2.5rem;  
        max-height: 2.5rem;
      }
  }
}
.community-header .ui.image.community-image.community-header-logo {
  margin-top: 1rem;
  width: 100%;
  max-width: 100%;

  @media (max-width: @largestMobileScreen) {
    width: 5rem;
    max-width: 5rem;
  }

  img {
    width: 100%;
    max-width: none;
    max-height: none;
  }
}
// preview in the community settings form
.form.communities-profile .ui.image.community-logo img {
  height: auto !important;
  object-fit: fill;
}
.communities-frontpage {
  .ui.icon.message > .icon:not(.close) {
    font-size: 2rem;
  }
  .community-frontpage-cards .ui.card .image img {
    object-fit: cover;
  }
}
#communities.sidebar-container {
  .row.default-community
  .community-image
  img {
    min-width: 0px;
    max-width: 70px;
    min-height: 0px;
  }
  .row:not(.default-community)
  .community-image
  img {
  object-fit: cover;
  max-width: 40px;
  max-height: 40px;
  min-height: 40px;
  min-width: 40px;
  box-shadow: 0 0 0.5rem rgb(0 0 0 / 5%);
  border: 1px solid @sidebarBorderColor;
  }
}

#communities-carousel .carousel .ui.items .item img {
  object-fit: cover;
  border-radius: @defaultBorderRadius;
  max-width: 150px;
  max-height: 150px;
  min-height: 150px;
  min-width: 150px;
  box-shadow: 0 0 0.5rem rgb(0 0 0 / 5%);
  border: 1px solid @sidebarBorderColor;
}
