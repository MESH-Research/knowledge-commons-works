/* Segment theme overrides */

.ui.segment {
    border-color: @sidebarBorderColor;
    &.rdm-sidebar {
        border-color: @sidebarBorderColor;

        &:first-child,
        &:last-child {
            background-color: @sidebarBackgroundColor;
            margin-bottom: 1rem;
        }
    }
}
.sidebar-container {
    &#record-versions {
        .ui.segment {
          display: flex;
          align-items: center;
          &.preview {
            color: @infoTextColor;
            background-color: @infoBackgroundColor;
            border-color: @infoBorderColor;
            div.dropdown {
              border-left: 1px solid @infoBorderColor;
            }
          }
        }
    }
    &#communities {
        .ui.segment {
          background-color: transparent;
          border: none;
          padding: 0;
          .ui.header {
            margin-top: 0;
          }
        }
      }
}

#detail-main-content {
  .main-record-content {
    #communities {
      .segment {
        margin-left: 0 !important;
        margin-right: 0 !important;
        @media screen and (max-width: @largestMobileScreen) {
          padding-top: 0.5rem;
          padding-bottom: 0.5rem;
        }
      }
    }

    #detail-main-tabs {
      .record-details-tab {
        &.ui.attached.segment {
          border: none;
          padding-left: 0;
          padding-right: 0;
          padding-top: 0;
        }
        @media screen and (max-width: @largestMobileScreen) {
          &.segment {
            padding-top: 0;
          }
        }
      }
    }
  }
}
