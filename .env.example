# for opensearch
INVENIO_SEARCH_DOMAIN='search:9200'
# OpenSearch Configuration (for faster machines with indexing issues)
# defaults in docker-services.yml
OPENSEARCH_HEAP_SIZE=1g
OPENSEARCH_MEMORY_LIMIT=6g
OPENSEARCH_CPUS=8.0
APP_CPUS=4.0
# APP_MEMORY_LIMIT=12g

# for redis
REDIS_DOMAIN='cache:6379'

# for postgresql
POSTGRES_USER=kcworks
POSTGRES_PASSWORD=kcworks
POSTGRES_DB=kcworks
INVENIO_SQLALCHEMY_DATABASE_URI="postgresql+psycopg2://kcworks:kcworks@db/kcworks"

# for InvenioRDM rest api authorization
API_TOKEN=GPml70IeJU8UqZM8WKXpOLWx7yX5cTusEC6fvCNYUxcBhC7sFR9RDtqwoeZE

# directory on the local file system
INVENIO_RECORD_IMPORTER_LOCAL_DATA_DIR='/opt/invenio/var/import_data'
INVENIO_RECORD_IMPORTER_DATA_DIR='/opt/invenio/var/import_data'

FLASK_DEBUG=1
INVENIO_LOGGING_CONSOLE_LEVEL=DEBUG

KCWORKS_ALLOWED_HOSTS="localhost,localhost:8443,127.0.0.1,127.0.0.1:8443,host.docker.internal,*.hcommons-dev.org,*.hcommons-staging.org,*.hcommons.org,*.kcommons.org"

# Legacy MacOS variable for system Python (under 3.12)
# SYSTEM_VERSION_COMPAT=0

KCWORKS_CONTAINERS_BASE_NAME=kcworks-next

INVENIO_INSTANCE_PATH=/opt/invenio/var/instance

