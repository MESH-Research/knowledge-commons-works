INVENIO_SECURITY_PASSWORD_SALT="CjJFKUPTyQbFQE4drcfusnPz7ziXDydPqFNueMiPVrhVdtQ3YRkQKQb9wk4emriy"
INVENIO_SECURITY_CONFIRM_SALT="AriAgGeAX7qvtfDL7WRmucx99nXLiE46K3creJLbouV9XVxgUdkPYkYGedJU7pt9"
