# Example private environment variables for docker services
#
# Variables that are instance-specific and overrides of values in invenio.cfg.
#
# These values are not actually secrets and may be copied into your local .env file as a 
# starting point. They provide enough default settings to run a KCWorks instance in, e.g.,
# the containerized development environment.
# 
# You may modify these values to suit your local context. Genuinely secret values should never be stored here in plain text. Nevertheless, .env
# is also .gitignored to prevent accidental exposure of secrets via version control.
#
# NOTE: MOST OF THESE VALUES *WOULD* BE GENUINE SECRETS OUTSIDE OF A STRICTLY DEVELOPMENT
# ENVIRONMENT! NEVER COMMIT NON-DEVELOPMENT VALUES TO VERSION CONTROL OR SAVE THEM IN A
# PLAIN TEXT .ENV FILE.

# uncomment to use test stats data
INVENIO_STATS_DASHBOARD_USE_TEST_DATA=False

# uncomment for staging/production
# INVENIO_FILES_REST_STORAGE_FACTORY = 'invenio_s3.s3fs_storage_factory'

INVENIO_ADMIN_EMAIL="hello@hcommons.org"

INVENIO_SITE_UI_URL="https://localhost:8443"
INVENIO_SITE_API_URL="https://localhost:8443/api"
INVENIO_KC_WORDPRESS_DOMAIN="hcommons-dev.org"

# for mail
INVENIO_MAIL_SUPPRESS_SEND="True"

# for invenio
INVENIO_SECRET_KEY='CHANGE_ME'
INVENIO_SECURITY_LOGIN_SALT='56df9ae0ee9f534dd9ee83bb8b4788ece0a52a4083427d4ee64dbb23f5d67082'
