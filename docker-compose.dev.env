# Dev host port defaults for docker compose (no secrets).
# Loaded by kcworks-startup.sh / kcworks-shutdown.sh before ./.env so local
# overrides in .env win. Manual dev up:
#   docker compose --env-file docker-compose.dev.env --env-file .env \
#     --file docker-compose.yml --file docker-compose.dev.yml up -d
#
# Offset from docker-services.yml defaults so this clone can run alongside a
# primary KCWorks instance (docker-services-cli ports).

KCWORKS_NGINX_HTTP_HOST_PORT=8080
KCWORKS_NGINX_HTTPS_HOST_PORT=8443
KCWORKS_REDIS_HOST_PORT=6380
KCWORKS_POSTGRES_HOST_PORT=5433
KCWORKS_PGADMIN_HOST_PORT=5051
KCWORKS_RABBITMQ_AMQP_HOST_PORT=5673
KCWORKS_RABBITMQ_MANAGEMENT_HOST_PORT=15673
KCWORKS_OPENSEARCH_HTTP_HOST_PORT=9201
KCWORKS_OPENSEARCH_PERF_ANALYZER_HOST_PORT=9601
KCWORKS_OPENSEARCH_DASHBOARDS_HOST_PORT=5602
