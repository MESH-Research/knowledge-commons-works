r"}],"skos:altLabel":[{"@language":"es","@value":"Juego con fuego"},{"@language":"de","@value":"Fireplay"},{"@language":"de","@value":"Feuerspiel"},{"@language":"sv","@value":"Fire play"}],"rdfs:comment":[{"@language":"en","@value":"The use of fire or flame in a sexual or erotic context."},{"@language":"es","@value":"El uso de fuego o llamas en un contexto sexual o erótico."},{"@language":"de","@value":"Verwendung von Feuer oder Flammen in einem sexuellen oder erotischen Kontext."},{"@language":"nl","@value":"Het gebruik van vuur of vlammen in een seksuele of erotische context."},{"@language":"sv","@value":"Användning av eld i sexuella eller erotiska sammanhang."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0003054"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0003049"},{"@id":"https://homosaurus.org/v5/homoit0003056"},{"@id":"https://homosaurus.org/v5/homoit0003136"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000404"},"dc:issued":{"@type":"xsd:date","@value":"2023-12-15"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003056","dc:identifier":"homoit0003056","skos:prefLabel":[{"@language":"en","@value":"Ice play"},{"@language":"es","@value":"Juego de hielo"},{"@language":"nl","@value":"IJsspel"},{"@language":"sv","@value":"Islekar"}],"skos:altLabel":[{"@language":"es","@value":"Juego con hielo"},{"@language":"sv","@value":"Ice play"}],"rdfs:comment":[{"@language":"en","@value":"A type of sensual or sexual play in which ice or similar cold substances are applied to the body."},{"@language":"es","@value":"Un tipo de juego sensual o sexual en el que se aplica sobre el cuerpo hielo o sustancias frías similares."},{"@language":"nl","@value":"Een soort sensueel of seksueel spel waarbij ijs of soortgelijke koude stoffen op het lichaam worden aangebracht."},{"@language":"s