fied":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003357","dc:identifier":"homoit0003357","skos:prefLabel":[{"@language":"en","@value":"Greyromantic Unitarian Universalists"},{"@language":"es","@value":"Unitarios universalistas grisrománticos"},{"@language":"nl","@value":"Grijsromantische Unitarische Universalisten"},{"@language":"sv","@value":"Gråromantiska unitariska universalister"}],"skos:altLabel":[{"@language":"en","@value":"Unitarian Universalist greyromantic people"},{"@language":"es","@value":"Personas unitarias universalistas grisrománticas"},{"@language":"es","@value":"Unitarias universalistas grisrománticas"},{"@language":"sv","@value":"unitariska universalister som är greyromantic-personer"}],"rdfs:comment":[{"@language":"en","@value":"Greyromantic people who are members of the Unitarian Universalist church."},{"@language":"es","@value":"Personas grisrománticas que son miembros de la Iglesia Unitaria Universalista."},{"@language":"nl","@value":"Grijsromantische personen die lid zijn van de Unitarian Universalist Church."},{"@language":"sv","@value":"Gråromantiska som är medlemmar i den främst amerikanska Unitarian Universalist-kyrkan."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0003347"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000928"},"dc:issued":{"@type":"xsd:date","@value":"2024-06-19"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003358","dc:identifier":"homoit0003358","skos:prefLabel":[{"@language":"en","@value":"Non-binary Unitarian Universalists"},{"@language":"es","@value":"Unitarixs universalistas no binarixs"},{"@language":"nl","@value":"Non-binaire Unitarische Universalisten"},{"@language":"sv","@value":"Ickebinära unitariska universalister"}],"skos:altLabel":[{"@language":"en","@value":"Nonbinary Unitarian Universalists"},{"@language":"en","@value":"Unitarian Universalist non-binary people"},{"@language":"en","@value":"Unitarian Universalist nonbinary people"},{"@language":"es","@value":"Personas unitarias universalistas no binarias"}],"rdfs:comment":[{"@language":"en","@value":"Non-binary people who are members of the Unitarian Universalist church."},{"@language":"es","@value":"Personas no binarias que son miembros de la Iglesia Unitaria Universalista."},{"@language":"nl","@value":"Non-binaire personen die lid zijn van de Unitarian Universalist Church."},{"@language":"sv","@value":"Ickebinära personer som är medlemmar i den främst amerikanska Unitarian Universalist-kyrkan."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0003347"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000928"},"dc:issued":{"@type":"xsd:date","@value":"2024-06-19"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003362","dc:identifier":"homoit0003362","skos:prefLabel":[{"@language":"en","@value":"Reproductive health care for non-binary people"},{"@language":"es","@value":"Salud reproductiva para personas no binarias"},{"@language":"nl","@value":"Reproductieve gezondheidszorg voor non-binaire personen"},{"@language":"sv","@value":"Reproduktiv hälsovård för ickebinära"}],"skos:altLabel":[{"@language":"en","@value":"Non-binary reproductive health care"},{"@language":"en","@value":"Reproductive health care for nonbinary people"},{"@language":"en","@value":"Reproductive healthcare for non-binary people"},{"@language":"es","@value":"Atención médica reproductiva para personas no binarias"},{"@language":"es","@value":"Cuidado médico reproductivo para personas no binarias"}],"rdfs:comment":[{"@language":"en","@value":"Access to and experiences with reproductive health care for non-binary people. Reproductive health care includes birth control, abortion, assisted reproduction, and prenatal and obstetric care."},{"@language":"es","@value":"Acceso y experiencias de las personas no binarias en materia de salud reproductiva. La atención médica reproductiva incluye el control de la natalidad, el aborto, la reproducción asistida y la atención prenatal y obstétrica."},{"@language":"nl","@value":"Toegang tot en ervaringen met reproductieve gezondheidszorg voor non-binaire personen. Reproductieve gezondheidszorg omvat geboortebeperking, abortus, geassisteerde reproductie en prenatale en verloskundige zorg."},{"@language":"sv","@value":"Tillgång till och erfarenheter av reproduktiv hälsovård för ickebinära personer. Reproduktiv hälsovård omfattar preventivmedel, abort, assisterad befruktning samt mödra- och förlossningsvård."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0003361"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000614"},"dc:issued":{"@type":"xsd:date","@value":"2024-06-19"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003363","dc:identifier":"homoit0003363","skos:prefLabel":[{"@language":"en","@value":"Reproductive health care for transgender people"},{"@language":"es","@value":"Salud reproductiva para personas transgénero"},{"@language":"nl","@value":"Reproductieve gezondheidszorg voor transgender personen"},{"@language":"sv","@value":"Reproduktiv hälsovård för transpersoner"}],"skos:altLabel":[{"@language":"en","@value":"Reproductive health care for trans people"},{"@language":"en","@value":"Reproductive healthcare for transgender people"},{"@language":"en","@value":"Trans reproductive health care"},{"@language":"en","@value":"Transgender reproductive health care"},{"@language":"es","@value":"Atención médica reproductiva para personas transgénero"},{"@language":"es","@value":"Cuidado médico reproductivo para personas transgénero"},{"@language":"es","@value":"Atención médica reproductiva para personas trans"},{"@language":"es","@value":"Cuidado médico reproductivo para personas trans"},{"@language":"es","@value":"Salud reproductiva para personas trans"},{"@language":"nl","@value":"Transgender reproductieve gezondheidszorg"}],"rdfs:comment":[{"@language":"en","@value":"Access to and experiences with reproductive health care for transgender people. Reproductive health care includes birth control, abortion, assisted reproduction, and prenatal and obstetric care."},{"@language":"es","@value":"Acceso y experiencias de las personas transgénero en materia de salud reproductiva. La atención médica reproductiva incluye el control de la natalidad, el aborto, la reproducción asistida y la atención prenatal y obstétrica."},{"@language":"nl","@value":"Toegang tot en ervaringen met reproductieve gezondheidszorg voor transgender personen. Reproductieve gezondheidszorg omvat geboortebeperking, abortus, geassisteerde reproductie en prenatale en verloskundige zorg."},{"@language":"sv","@value":"Tillgång till och erfarenheter av reproduktiv hälsovård för transpersoner. Reproduktiv hälsovård omfattar preventivmedel, abort, assisterad befruktning samt mödra- och förlossningsvård."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0003361"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000614"},"dc:issued":{"@type":"xsd:date","@value":"2024-06-19"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003365","dc:identifier":"homoit0003365","skos:prefLabel":[{"@language":"en","@value":"Abortion"},{"@language":"de","@value":"Schwangerschaftsabbruch"},{"@language":"es","@value":"Aborto"},{"@language":"nl","@value":"Abortus"},{"@language":"sv","@value":"Abort"}],"skos:altLabel":[{"@language":"en","@value":"Pregnancy termination"},{"@language":"en","@value":"Termination of pregnancy"},{"@language":"de","@value":"Abtreibung"},{"@language":"de","@value":"Schwangerschaftsunterbrechung"},{"@language":"es","@value":"Término del embarazo"},{"@language":"nl","@value":"Zwangerschapsbeëindiging"}],"rdfs:comment":[{"@language":"en","@value":"The termination of a pregnancy by removal or expulsion of an embryo or fetus. Generally refers to induced abortion or deliberate actions to end a pregnancy. Most common forms are in-clinic abortion (also known as a surgical abortion) and medication abortion (also referred to as the abortion pill, which uses two different medicines called mifepristone and misoprostol). Abortion occurring without intervention is known as spontaneous abortion or \"miscarriage\"."},{"@language":"de","@value":"Die vorzeitige Beendigung einer Schwangerschaft."},{"@language":"es","@value":"La terminación de un embarazo."},{"@language":"nl","@value":"Het beëindigen van een zwangerschap door het verwijderen of uitstoten van een embryo of foetus. Over het algemeen verwijst dit naar een opzettelijke abortus of een bewuste poging om een ​​zwangerschap te beëindigen. De meest voorkomende vormen zijn een abortus in een kliniek (ook wel chirurgische abortus genoemd) en een medicamenteuze abortus (ook wel de abortuspil genoemd, die twee verschillende geneesmiddelen bevat, namelijk mifepriston en misoprostol). Een abortus die zonder ingrijpen plaatsvindt, staat bekend als een spontane abortus of \"miskraam\"."},{"@language":"sv","@value":"Avbrytande av graviditet."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0003361"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0003366"},{"@id":"https://homosaurus.org/v5/homoit0003369"},{"@id":"https://homosaurus.org/v5/homoit0004429"},{"@id":"https://homosaurus.org/v5/homoit0004486"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85000196"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000614"},"dc:issued":{"@type":"xsd:date","@value":"2024-06-19"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003366","dc:identifier":"homoit0003366","skos:prefLabel":[{"@language":"en","@value":"Abortion access for LGBTQ+ people"},{"@language":"de","@value":"Zugang zu Schwangerschaftsabbrüchen für LGBTQ+ Menschen"},{"@language":"es","@value":"Acceso al aborto para personas LGBTQ+"},{"@language":"nl","@value":"Toegang tot abortus voor LHBTQ+-personen"},{"@language":"sv","@value":"Tillgång till abort för hbtq+-personer"}],"skos:altLabel":[{"@language":"es","@value":"Aborto accesible para personas LGBTQ+"},{"@language":"sv","@value":"Aborttillgång för HBTQ+-personer"}],"rdfs:comment":[{"@language":"en","@value":"Term used to describe the various aspects determining whether abortions are accessible to LGBTQ+ people in a given location. Factors determining accessibility include legality, safety, privacy, financial cost, freedom of travel, etc."},{"@language":"de","@value":"Der Begriff wird verwendet, um die verschiedenen Aspekte zu beschreiben, die bestimmen, ob Abtreibungen für LGBTQ+ Menschen an einem bestimmten Ort zugänglich sind. Zu den Faktoren, die die Zugänglichkeit bestimmen, gehören Legalität, Sicherheit, Privatsphäre, finanzielle Kosten, Reisefreiheit usw."},{"@language":"es","@value":"Término utilizado para describir los diversos aspectos que determinan si los abortos son accesibles para las personas LGBTQ+ en un lugar determinado. Los factores que determinan la accesibilidad incluyen la legalidad, la seguridad, la privacidad, el coste financiero, la libertad de viajar, etc."},{"@language":"nl","@value":"Term die wordt gebruikt om de verschillende aspecten te beschrijven die bepalen of abortussen toegankelijk zijn voor LHBTQ+-personen op een bepaalde locatie. Factoren die de toegankelijkheid bepalen, zijn onder andere legaliteit, veiligheid, privacy, financiële kosten, vrijheid van reizen, etc."},{"@language":"sv","@value":"Term som används för att beskriva olika faktorer som påverkar hbtq+-personers tillgång till abort i en viss kontext eller på en viss plats. Faktorer som påverkar tillgängligheten kan omfatta juridiska förutsättningar, säkerhet, integritet, ekonomiska kostnader och rörelsefrihet."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0003361"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0003361"},{"@id":"https://homosaurus.org/v5/homoit0003365"},{"@id":"https://homosaurus.org/v5/homoit0003367"},{"@id":"https://homosaurus.org/v5/homoit0003368"},{"@id":"https://homosaurus.org/v5/homoit0004429"},{"@id":"https://homosaurus.org/v5/homoit0004486"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000614"},"dc:issued":{"@type":"xsd:date","@value":"2024-06-19"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003844","dc:identifier":"homoit0003844","skos:prefLabel":[{"@language":"en","@value":"Reproductive health care for intersex people"},{"@language":"nl","@value":"Reproductieve gezondheidszorg voor intersekse personen"},{"@language":"sv","@value":"Reproduktiv hälsovård för intersexpersoner"}],"skos:altLabel":{"@language":"en","@value":"Reproductive healthcare for intersex people"},"rdfs:comment":[{"@language":"en","@value":"Access to and experiences with reproductive health care for intersex people. Reproductive health care includes contraception, abortion, STD testing and treatment, and fertility care."},{"@language":"sv","@value":"Tillgång till och erfarenheter av reproduktiv vård för intersexpersoner. Reproduktiv hälsovård omfattar preventivmedel, abort, testning och behandling av könssjukdomar samt fertilitetsvård."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0003361"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000614"},"dc:issued":{"@type":"xsd:date","@value":"2024-12-12"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004413","dc:identifier":"homoit0004413","skos:prefLabel":[{"@language":"en","@value":"Abortion counseling for LGBTQ+ people"},{"@language":"nl","@value":"Abortusbegeleiding voor LHBTQ+-personen"},{"@language":"sv","@value":"Abortrådgivning för hbtq+-personer"}],"rdfs:comment":[{"@language":"en","@value":"Various forms of counseling that provides information and support regarding abortion procedures to LGBTQ+ people."},{"@language":"nl","@value":"Verschillende vormen van begeleiding die informatie en ondersteuning bieden over abortusprocedures aan LHBTQ+-personen."},{"@language":"sv","@value":"Olika former av rådgivning till hbtq+-personer med syfte att ge information och stöd gällande abort."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0003361"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0003368"},{"@id":"https://homosaurus.org/v5/homoit0004486"}],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85000209"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000614"},"dc:issued":{"@type":"xsd:date","@value":"2026-02-24"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004428","dc:identifier":"homoit0004428","skos:prefLabel":[{"@language":"en","@value":"Abortion services for LGBTQ+ people"},{"@language":"nl","@value":"Abortusdiensten voor LHBTQ+-personen"},{"@language":"sv","@value":"Abort för hbtq+-personer"}],"skos:altLabel":{"@language":"sv","@value":"Abort och hbtq+-personer"},"rdfs:comment":[{"@language":"en","@value":"Various forms of abortion services for LGBTQ+ people, including both in-clinic abortion (also known as a surgical abortion) and medication abortion (also referred to as the abortion pill)."},{"@language":"nl","@value":"Verschillende vormen van abortusdiensten die beschikbaar zijn voor LHBTQ+-personen, waaronder zowel abortus in een kliniek (ook wel chirurgische abortus genoemd) als abortus met medicijnen (ook wel de abortuspil genoemd)."},{"@language":"sv","@value":"Olika former av abortmetoder för hbtq+-personer, inklusive kirurgisk abort och medicinsk abort."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0003361"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0003368"},{"@id":"https://homosaurus.org/v5/homoit0004486"}],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85000211"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000614"},"dc:issued":{"@type":"xsd:date","@value":"2026-02-24"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003368","dc:identifier":"homoit0003368","skos:prefLabel":[{"@language":"en","@value":"Reproductive health care for Two-Spirit people"},{"@language":"es","@value":"Salud reproductiva para personas dos espíritus"},{"@language":"nl","@value":"Reproductieve gezondheidszorg voor Two-Spirit people"},{"@language":"sv","@value":"Reproduktiv hälsovård för two spirit-personer"}],"skos:altLabel":[{"@language":"en","@value":"2S reproductive health care"},{"@language":"en","@value":"Reproductive health care for 2S people"},{"@language":"en","@value":"Reproductive health care for Two Spirit people"},{"@language":"en","@value":"Reproductive health care for Two Spirited people"},{"@language":"en","@value":"Reproductive health care for Two-Spirited people"},{"@language":"en","@value":"Two Spirit reproductive health care"},{"@language":"en","@value":"Two Spirited reproductive health care"},{"@language":"en","@value":"Two-Spirited reproductive health care"},{"@language":"es","@value":"Atención médica reproductiva para personas dos espíritus"},{"@language":"es","@value":"Cuidado médico reproductivo para personas dos espíritus"},{"@language":"nl","@value":"Reproductieve gezondheidszorg voor 2S personen"},{"@language":"nl","@value":"Reproductieve gezondheidszorg voor Two Spirit people"},{"@language":"nl","@value":"Reproductieve gezondheidszorg voor Two Spirited people"},{"@language":"nl","@value":"Reproductieve gezondheidszorg voor Two-Spirited people"},{"@language":"nl","@value":"Two Spirit reproductieve gezondheidszorg"},{"@language":"nl","@value":"Two Spirited reproductieve gezondheidszorg"},{"@language":"nl","@value":"Two-Spirit reproductieve gezondheidszorg"},{"@language":"nl","@value":"Two-Spirited reproductieve gezondheidszorg"}],"rdfs:comment":[{"@language":"en","@value":"Access to and experiences with reproductive health care for Two-Spirit people. Reproductive health care includes birth control, abortion, assisted reproduction, and prenatal and obstetric care."},{"@language":"es","@value":"Acceso y experiencias de las personas dos espíritus en materia de salud reproductiva. La atención médica reproductiva incluye el control de la natalidad, el aborto, la reproducción asistida y la atención prenatal y obstétrica."},{"@language":"nl","@value":"Toegang tot en ervaringen met reproductieve gezondheidszorg voor Two-Spirit-people. Reproductieve gezondheidszorg omvat geboortebeperking, abortus, geassisteerde reproductie en prenatale en verloskundige zorg."},{"@language":"sv","@value":"Tillgång till och erfarenheter av reproduktiv hälsovård för Two-spirit-personer. Reproduktiv hälsovård omfattar preventivmedel, abort, assisterad befruktning samt mödra- och förlossningsvård."}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0003361"},{"@id":"https://homosaurus.org/v5/homoit0003366"},{"@id":"https://homosaurus.org/v5/homoit0004413"},{"@id":"https://homosaurus.org/v5/homoit0004428"},{"@id":"https://homosaurus.org/v5/homoit0004429"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0003368"},"dc:issued":{"@type":"xsd:date","@value":"2024-06-19"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003369","dc:identifier":"homoit0003369","skos:prefLabel":[{"@language":"en","@value":"Reproductive rights"},{"@language":"es","@value":"Derechos reproductivos"},{"@language":"nl","@value":"Reproductieve rechten"},{"@language":"sv","@value":"Reproduktiva rättigheter"}],"rdfs:comment":[{"@language":"en","@value":"Legal, social, or ethical principles of freedom around reproductive healthcare and decision-making. Often used to refer to an individual's right to bodily autonomy and access to legal and safe birth control, abortion, assisted reproduction, and prenatal and obstetric care."},{"@language":"es","@value":"Principios jurídicos, sociales o éticos de libertad en torno a la salud reproductiva y la toma de decisiones. A menudo, se utiliza para referirse al derecho de una persona a su autonomía corporal y al acceso a métodos anticonceptivos legales y seguros, al aborto, a la reproducción asistida y a la atención prenatal y obstétrica."},{"@language":"nl","@value":"Juridische, sociale of ethische principes van vrijheid rondom reproductieve gezondheidszorg en besluitvorming. Wordt vaak gebruikt om te verwijzen naar het recht van een individu op lichamelijke autonomie en toegang tot legale en veilige geboortebeperking, abortus, geassisteerde reproductie en prenatale en verloskundige zorg."},{"@language":"sv","@value":"Juridiska, sociala och etiska principer som rör frihet i beslut om reproduktiv hälsa och vård. Begreppet används ofta för att hänvisa till individens rätt till kroppslig autonomi och tillgång till laglig och säker preventivmedelsanvändning, abort, assisterad befruktning och mödravård."}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0003361"},{"@id":"https://homosaurus.org/v5/homoit0003365"},{"@id":"https://homosaurus.org/v5/homoit0003367"},{"@id":"https://homosaurus.org/v5/homoit0003593"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2008005212"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0003369"},"dc:issued":{"@type":"xsd:date","@value":"2024-07-11"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003593","dc:identifier":"homoit0003593","skos:prefLabel":[{"@language":"en","@value":"Reproductive justice"},{"@language":"nl","@value":"Reproductieve rechtvaardigheid"},{"@language":"sv","@value":"Reproduktiv rättvisa"}],"rdfs:comment":[{"@language":"en","@value":"Organized efforts to secure reproductive rights, including the legal, social, and ethical principles of freedom around reproductive healthcare and decision-making."},{"@language":"nl","@value":"Georganiseerde inspanningen om reproductieve rechten te waarborgen, inclusief de juridische, sociale en ethische principes van vrijheid rondom reproductieve gezondheidszorg en besluitvorming."},{"@language":"sv","@value":"Organiserade insatser för att säkra reproduktiva rättigheter, inklusive juridiska, sociala och etiska principer kring frihet i beslut om reproduktiv hälsa och vård."}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0003369"},{"@id":"https://homosaurus.org/v5/homoit0003361"},{"@id":"https://homosaurus.org/v5/homoit0003367"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0003593"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-22"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003367","dc:identifier":"homoit0003367","skos:prefLabel":[{"@language":"en","@value":"Bodily autonomy"},{"@language":"de","@value":"Körperliche Selbstbestimmung"},{"@language":"es","@value":"Autonomía corporal"},{"@language":"nl","@value":"Lichamelijke autonomie"},{"@language":"sv","@value":"Kroppslig autonomi"}],"skos:altLabel":[{"@language":"en","@value":"Right to bodily autonomy"},{"@language":"de","@value":"Körperliche Autonomie"},{"@language":"de","@value":"Recht auf körperliche Selbstbestimmung"},{"@language":"de","@value":"Recht auf körperliche Autonomie"},{"@language":"es","@value":"Derecho a la autonomía corporal"}],"rdfs:comment":[{"@language":"en","@value":"An individual's right to make informed decisions about their own body without external influence or coercion."},{"@language":"de","@value":"Das Recht einer Person, ohne Einflussnahme oder Zwang von außen fundierte Entscheidungen über den eigenen Körper zu treffen."},{"@language":"es","@value":"El derecho de una persona a tomar decisiones informadas sobre su propio cuerpo sin influencias externas ni coerciones."},{"@language":"nl","@value":"Het recht van een individu om weloverwogen beslissingen te nemen over het eigen lichaam, zonder externe invloed of dwang."},{"@language":"sv","@value":"En individs rätt att fatta informerade beslut om sin egen kropp utan yttre påverkan eller tvång."}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0003366"},{"@id":"https://homosaurus.org/v5/homoit0003369"},{"@id":"https://homosaurus.org/v5/homoit0003593"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2022006327"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0003367"},"dc:issued":{"@type":"xsd:date","@value":"2024-06-19"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003371","dc:identifier":"homoit0003371","skos:prefLabel":[{"@language":"en","@value":"Rural lesbians"},{"@language":"es","@value":"Lesbianas rurales"},{"@language":"nl","@value":"Lesbische vrouwen in landelijke gebieden"},{"@language":"sv","@value":"Lesbiska på landsbygden"}],"skos:altLabel":{"@language":"sv","@value":"Lesbiska i glesbygden"},"rdfs:comment":[{"@language":"en","@value":"Lesbians who are currently living in or consider themselves to be from agricultural or forested areas with low population densities."},{"@language":"es","@value":"Lesbianas que viven o se consideran originarias de zonas agrícolas o forestales con baja densidad de población."},{"@language":"nl","@value":"Lesbische vrouwen die momenteel in landbouw- of bosgebieden met een lage bevolkingsdichtheid wonen of zichzelf hiertoe rekenen."},{"@language":"sv","@value":"Lesbiska som bor på landsbygden eller glesbygd, eller har anknytning till landsbygd eller glesbygd."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0003370"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh97006642"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2024-07-11"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003372","dc:identifier":"homoit0003372","skos:prefLabel":[{"@language":"en","@value":"Rural gay men"},{"@language":"es","@value":"Hombres gay rurales"},{"@language":"nl","@value":"Homomannen in landelijke gebieden"},{"@language":"sv","@value":"Bögar på landsbygden"}],"skos:altLabel":[{"@language":"en","@value":"Gay rural men"},{"@language":"es","@value":"Hombres rurales gay"},{"@language":"sv","@value":"Bögar i glesbygden"},{"@language":"sv","@value":"Homosexuella män på landsbygden"},{"@language":"sv","@value":"Homosexuella män i glesbygden"}],"rdfs:comment":[{"@language":"en","@value":"Gay men who are currently living in or consider themselves to be from agricultural or forested areas with low population densities."},{"@language":"es","@value":"Hombres gay que viven o se consideran originarias de zonas agrícolas o forestales con baja densidad de población."},{"@language":"nl","@value":"Homomannen die momenteel in landbouw- of bosgebieden met een lage bevolkingsdichtheid wonen of zichzelf hiertoe rekenen."},{"@language":"sv","@value":"Bögar som bor på landsbygden eller glesbygd, eller har anknytning till landsbygd eller glesbygd."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0003370"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh97006641"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2024-07-11"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003373","dc:identifier":"homoit0003373","skos:prefLabel":[{"@language":"en","@value":"Rural bisexual people"},{"@language":"es","@value":"Personas bisexuales rurales"},{"@language":"nl","@value":"Biseksuele personen in landelijke gebieden"},{"@language":"sv","@value":"Bisexuella på landsbygden"}],"skos:altLabel":[{"@language":"en","@value":"Bisexual rural people"},{"@language":"es","@value":"Personas rurales bisexuales"},{"@language":"sv","@value":"Bisexuella i glesbygden"}],"rdfs:comment":[{"@language":"en","@value":"Bisexual people who are currently living in or consider themselves to be from agricultural or forested areas with low population densities."},{"@language":"es","@value":"Personas bisexuales que viven o se consideran originarias de zonas agrícolas o forestales con baja densidad de población."},{"@language":"nl","@value":"Biseksuele personen die momenteel in landbouw- of bosgebieden met een lage bevolkingsdichtheid wonen of zichzelf hiertoe rekenen."},{"@language":"sv","@value":"Bisexuella personer som bor på landsbygden eller glesbygd, eller har anknytning till landsbygd eller glesbygd."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0003370"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2024-07-11"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003374","dc:identifier":"homoit0003374","skos:prefLabel":[{"@language":"en","@value":"Rural transgender people"},{"@language":"es","@value":"Personas transgénero rurales"},{"@language":"nl","@value":"Transgender personen in landelijke gebieden"},{"@language":"sv","@value":"Transpersoner på landsbygden"}],"skos:altLabel":[{"@language":"en","@value":"Rural trans people"},{"@language":"en","@value":"Trans rural people"},{"@language":"en","@value":"Transgender rural people"},{"@language":"es","@value":"Personas trans rurales"},{"@language":"es","@value":"Personas rurales trans"},{"@language":"es","@value":"Personas rurales transgénero"},{"@language":"sv","@value":"Transpersoner i glesbygden"}],"rdfs:comment":[{"@language":"en","@value":"Transgender people who are currently living in or consider themselves to be from agricultural or forested areas with low population densities."},{"@language":"es","@value":"Personas transgénero que viven o se consideran originarias de zonas agrícolas o forestales con baja densidad de población."},{"@language":"nl","@value":"Transgender personen die momenteel in landbouw- of bosgebieden met een lage bevolkingsdichtheid wonen of zichzelf hiertoe rekenen."},{"@language":"sv","@value":"Transpersoner som bo