e":"Chicanos (LGBTQ)"},{"@language":"en","@value":"Chicanx LGBTQ+ people"},{"@language":"en","@value":"Chicanx people (LGBTQ)"},{"@language":"en","@value":"Chicanxs (LGBTQ)"},{"@language":"en","@value":"LGBTQ+ Chicanas"},{"@language":"en","@value":"LGBTQ+ Chicanos"},{"@language":"en","@value":"LGBTQ+ Chicanx people"},{"@language":"en","@value":"LGBTQ+ Chicanxs"},{"@language":"es","@value":"Personas chicanas LGBTQ+"},{"@language":"es","@value":"Personas chicanas (LGBTQ)"},{"@language":"es","@value":"Chicanos LGBTQ+"},{"@language":"es","@value":"Chicanas LGBTQ+"},{"@language":"es","@value":"Chicanxs LGBTQ+"},{"@language":"es","@value":"Chicanos (LGBTQ)"},{"@language":"es","@value":"Chicanas (LGBTQ)"},{"@language":"es","@value":"Chicanxs (LGBTQ)||"},{"@language":"de","@value":"Chicanx LGBTQ+-Personen"},{"@language":"de","@value":"LGBTQ+-Chicanas"},{"@language":"de","@value":"LGBTQ+-Chicanos"},{"@language":"nl","@value":"Chicanas (LHBTQ+)"},{"@language":"nl","@value":"Chicano LHBTQ+-personen"},{"@language":"nl","@value":"Chicanos (LHBTQ+)"},{"@language":"nl","@value":"Chicanx LHBTQ+-personen"},{"@language":"nl","@value":"Chicanx personen (LHBTQ+)"},{"@language":"nl","@value":"Chicanxs (LHBTQ+)"},{"@language":"nl","@value":"LHBTQ+ Chicanxs"},{"@language":"nl","@value":"LHBTQ+-Chicanas"},{"@language":"nl","@value":"LHBTQ+-Chicanos"},{"@language":"nl","@value":"LHBTQ+-Chicanx personen"}],"rdfs:comment":[{"@language":"en","@value":"LGBTQ+ people of Mexican descent born in the United States; only use to describe people who self-identify as Chicano, Chicana, or Chicanx. Do not conflate with Latino/a/x or Hispanic people."},{"@language":"es","@value":"personas LGBTQ+ de ascendencia mexicana nacidas en Estados Unidos; utilícese únicamente para describir a personas que se autoidentifiquen como chicanas. No se debe confundir con latinos/a/x o hispanos."},{"@language":"de","@value":"LGBTQ+-Personen mexikanischer Abstammung, die in den Vereinigten Staaten geboren sind; nur zur Beschreibung von Personen verwenden, die sich selbst als Chicano, Chicana oder Chicanx bezeichnen. Nicht mit Latino, Latina, Latinx oder Hispanoamerikaner:innen gleichsetzen."},{"@language":"nl","@value":"LHBTQ+-personen van Mexicaanse afkomst geboren in de Verenigde Staten; alleen gebruiken om mensen te beschrijven die zichzelf identificeren als Chicano, Chicana of Chicanx. Niet samen gebruiken met Latino/a/x of Hispanic."},{"@language":"sv","@value":"Hbtq+-personer av mexikanskt ursprung födda i USA. Används endast för personer som själva identifierar sig som chicano, chicana eller chicanx. Ska inte förväxlas med latino/a/x eller spansktalande personer."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000860"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0002008"},{"@id":"https://homosaurus.org/v5/homoit0002017"},{"@id":"https://homosaurus.org/v5/homoit0002018"},{"@id":"https://homosaurus.org/v5/homoit0002019"},{"@id":"https://homosaurus.org/v5/homoit0002020"},{"@id":"https://homosaurus.org/v5/homoit0002021"},{"@id":"https://homosaurus.org/v5/homoit0003402"},{"@id":"https://homosaurus.org/v5/homoit0003820"}],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh91001712"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-05-11"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002009","dc:identifier":"homoit0002009","skos:prefLabel":[{"@language":"en","@value":"Arab LGBTQ+ people"},{"@language":"es","@value":"Personas LGBTQ+ árabes"},{"@language":"de","@value":"Arabische LGBTQ+-Personen"},{"@language":"nl","@value":"Arabische LHBTQ+-personen"},{"@language":"sv","@value":"Arabiska hbtq+-personer"}],"skos:altLabel":[{"@language":"en","@value":"Arab people (LGBTQ)"},{"@language":"en","@value":"Arabs (LGBTQ)"},{"@language":"en","@value":"LGBTQ+ Arab people"},{"@language":"en","@value":"LGBTQ+ Arabs"},{"@language":"es","@value":"Personas árabes (LGBTQ)"},{"@language":"es","@value":"Árabes (LGBTQ)"},{"@language":"es","@value":"Árabes LGBTQ+"},{"@language":"es","@value":"Personas árabes LGBTQ+"},{"@language":"de","@value":"LGBTQ+-arabische Personen"},{"@language":"nl","@value":"Arabische personen (LHBTQ+)"},{"@language":"nl","@value":"LHBTQ+-Arabieren"},{"@language":"nl","@value":"LHBTQ+-Arabische personen"}],"rdfs:comment":[{"@language":"en","@value":"LGBTQ+ people who are from Arab countries and/or are descended from Arab peoples. Do not conflate with Muslim people."},{"@language":"es","@value":"Personas LGBTQ+ que son de países árabes, hablan árabe y/o son descendientes de pueblos árabes. No se debe confundir con personas musulmanas."},{"@language":"de","@value":"LGBTQ+-Personen, die aus arabischen Ländern kommen und/oder von arabischen Völkern abstammen. Nicht mit muslimischen Menschen gleichsetzen."},{"@language":"nl","@value":"LHBTQ+-personen die uit Arabische landen komen, Arabisch spreken en/of afstammen van Arabische volkeren. Niet verwarren met moslimidentiteit"},{"@language":"sv","@value":"Hbtq+-personer som kommer från arabvärlden och/eller har arabiskt ursprung. Ska inte förväxlas med muslimer."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000860"},{"@id":"https://homosaurus.org/v5/homoit0001101"}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0002010"},{"@id":"https://homosaurus.org/v5/homoit0002011"},{"@id":"https://homosaurus.org/v5/homoit0002012"},{"@id":"https://homosaurus.org/v5/homoit0002013"},{"@id":"https://homosaurus.org/v5/homoit0002014"},{"@id":"https://homosaurus.org/v5/homoit0002015"},{"@id":"https://homosaurus.org/v5/homoit0002016"},{"@id":"https://homosaurus.org/v5/homoit0003232"},{"@id":"https://homosaurus.org/v5/homoit0003277"},{"@id":"https://homosaurus.org/v5/homoit0003382"},{"@id":"https://homosaurus.org/v5/homoit0003392