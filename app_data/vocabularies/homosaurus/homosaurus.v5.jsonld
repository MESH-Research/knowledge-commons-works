-Awadhi's"}],"rdfs:comment":[{"@language":"en","@value":"LGBTQ+ people who speak the Awadhi dialect and reside in or are descended from those who resided in the Awadh region of Uttar Pradesh."},{"@language":"es","@value":"Personas LGBTQ+ que hablan el dialecto awadi, residen o descienden de quienes residieron en la región awadi de Uttar Pradesh, en el norte de India."},{"@language":"nl","@value":"LHBTQ+-personen die het Awadhi-dialect spreken en wonen in de Awadh-regio van Uttar Pradesh of daarvan afstammen"},{"@language":"sv","@value":"Hbtq+-personer som talar awadhi och bor i eller härstammar från personer som bodde i Awadh-regionen i Uttar Pradesh."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000860"},{"@id":"https://homosaurus.org/v5/homoit0001101"}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0002071"},{"@id":"https://homosaurus.org/v5/homoit0002072"},{"@id":"https://homosaurus.org/v5/homoit0002073"},{"@id":"https://homosaurus.org/v5/homoit0002074"},{"@id":"https://homosaurus.org/v5/homoit0002075"},{"@id":"https://homosaurus.org/v5/homoit0002076"},{"@id":"https://homosaurus.org/v5/homoit0002077"},{"@id":"https://homosaurus.org/v5/homoit0003395"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-06-27"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002078","dc:identifier":"homoit0002078","skos:prefLabel":[{"@language":"en","@value":"Bhojpuri LGBTQ+ people"},{"@language":"es","@value":"Personas LGBTQ+ bhojpuri"},{"@language":"nl","@value":"Bhojpuri LHBTQ+-personen"},{"@language":"sv","@value":"Bhojpuriska hbtq+-personer"}],"skos:altLabel":[{"@language":"en","@value":"Bhojpuri people (LGBTQ)"},{"@language":"en","@value":"Bhojpuriyas (LGBTQ)"},{"@language":"en","@value":"LGBTQ+ Bhojpuri people"},{"@language":"en","@value":"LGBTQ+ Bhojpuriyas"},{"@language":"es","@value":"Personas bhojpuri (LGBTQ)"},{"@language":"es","@value":"Bhojpuriyas (LGBTQ)"},{"@language":"es","@value":"Personas bhojpuriyas LGBTQ+"},{"@language":"es","@value":"Bhojpuriyas LGBTQ+"},{"@language":"nl","@value":"LHBTQ+ Bhojpuriya's"}],"rdfs:comment":[{"@language":"en","@value":"LGBTQ+ people who speak the Bhojpuri language and live in or are descended from those who inhabited the Bhojpuri-Purvanchal region of India and Nepal."},{"@language":"es","@value":"Personas LGBTQ+ que hablan el idioma bhojpuri y viven, pertenecen o son descendientes de quienes habitaron la región de Bhojpuri-Purvanchal de India y Nepal."},{"@language":"nl","@value":"LHBTQ+-personen die de Bhojpuri-taal spreken en wonen in of afstammen van degenen die de Bhojpuri-Purvanchal-regio van India en Nepal bewoonden"},{"@language":"sv","@value":"Hbtq+-personer som talar bhojpuri och bor i eller härstammar från personer som levde i Bhojpuri-Purvanchal-regionen i Indien och Nepal."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000860"},{"@id":"https://homosaurus.org/v5/homoit0001101"}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0002079"},{"@id":"https://homosaurus.org/v5/homoit0002080"},{"@id":"https://homosaurus.org/v5/homoit0002081"},{"@id":"https://homosaurus.org/v5/homoit0002082"},{"@id":"https://homosaurus.org/v5/homoit0002083"},{"@id":"https://homosaurus.org/v5/homoit0002084"},{"@id":"https://homosaurus.org/v5/homoit0002085"},{"@id":"https://homosaurus.org/v5/homoit0003398"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-06-27"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002086","dc:identifier":"homoit0002086","skos:prefLabel":[{"@language":"en","@value":"Bengali LGBTQ+ people"},{"@language":"es","@value":"Personas LGBTQ+ bengalíes"},{"@language":"de","@value":"Bengalische LGBTQ+-Personen"},{"@language":"nl","@value":"Bengaalse LHBTQ+-personen"},{"@language":"sv","@value":"Bengaliska hbtq+-personer"}],"skos:altLabel":[{"@language":"en","@value":"Bengali people (LGBTQ)"},{"@language":"en","@value":"Bengalis (LGBTQ)"},{"@language":"en","@value":"LGBTQ+ Bengali people"},{"@language":"en","@value":"LGBTQ+ Bengalis"},{"@language":"es","@value":"Personas bengalíes (LGBTQ)"},{"@language":"es","@value":"Bengalíes (LGBTQ)"},{"@language":"es","@value":"Personas bengalíes LGBTQ+"},{"@language":"es","@value":"Bengalíes LGBTQ+"},{"@language":"de","@value":"LGBTQ+-Bengalis"},{"@language":"nl","@value":"LHBTQ+ Bengalezen"}],"rdfs:comment":[{"@language":"en","@value":"LGBTQ+ people who speak the Bengali language or are of Bengali descent."},{"@language":"es","@value":"Personas LGBTQ+ que hablan el idioma bengalí o son de ascendencia bengalí. Correferenciar con personas LGBTQ+ de Bangladesh cuando una persona es tanto de etnia bengalí como de nacionalidad bangladesí."},{"@language":"de","@value":"LGBTQ+-Personen, die die bengalische Sprache sprechen oder bengalischer Abstammung sind."},{"@language":"nl","@value":"LHBTQ+-personen die de Bengaalse taal spreken of van Bengaalse afkomst zijn. Tevens verwijzing naar Bengaalse LHBTQ+-personen wanneer een persoon zowel de Bengaalse etniciteit als de Bengaalse nationaliteit heeft"},{"@language":"sv","@value":"Hbtq+-personer som talar bengali eller är av bengalisk härkomst."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000860"},{"@id":"https://homosaurus.org/v5/homoit0001101"}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0002087"},{"@id":"https://homosaurus.org/v5/homoit0002088"},{"@id":"https://homosaurus.org/v5/homoit0002089"},{"@id":"https://homosaurus.org/v5/homoit0002090"},{"@id":"https://homosaurus.org/v5/homoit0002091"},{"@id":"https://homosaurus.org/v5/homoit0002092"},{"@id":"ht