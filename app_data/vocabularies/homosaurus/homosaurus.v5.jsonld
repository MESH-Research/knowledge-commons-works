"@language":"de","@value":"Ungeoutete asexuelle Personen"},{"@language":"es","@value":"Personas asexuales en el clóset"},{"@language":"nl","@value":"Aseksuele personen in de kast"},{"@language":"sv","@value":"Garderobsasexuella"}],"skos:altLabel":[{"@language":"de","@value":"Nicht geoutete asexuelle Personen"},{"@language":"es","@value":"Personas en el clóset asexuales"}],"rdfs:comment":[{"@language":"en","@value":"Asexual people who do not identify as such to others."},{"@language":"de","@value":"Asexuelle Personen, die diese Identität vor anderen nicht preisgeben."},{"@language":"es","@value":"Personas asexuales que no se autoidentifican como tales ante los demás."},{"@language":"nl","@value":"Aseksuele personen die zich niet als zodanig identificeren voor anderen."},{"@language":"sv","@value":"Asexuella personer som inte identifierar sig som sådana inför andra."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000071"},{"@id":"https://homosaurus.org/v5/homoit0001783"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000285"},{"@id":"https://homosaurus.org/v5/homoit0000286"},{"@id":"https://homosaurus.org/v5/homoit0000287"},{"@id":"https://homosaurus.org/v5/homoit0000295"},{"@id":"https://homosaurus.org/v5/homoit0001065"},{"@id":"https://homosaurus.org/v5/homoit0001261"},{"@id":"https://homosaurus.org/v5/homoit0001784"},{"@id":"https://homosaurus.org/v5/homoit0001785"},{"@id":"https://homosaurus.org/v5/homoit0001786"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001297"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-29"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003034","dc:identifier":"homoit0003034","skos:prefLabel":[{"@language":"en","@value":"Asexual college students"},{"@language":"de","@value":"Asexuelle Hochschulstudiernde"},{"@language":"es","@value":"Estudiantes universitarios asexuales"},{"@language":"nl","@value":"Aseksuele studenten"},{"@language":"sv","@value":"Asexuella collegestudenter"}],"skos:altLabel":[{"@language":"de","@value":"Ace Hochschulstudierende"},{"@language":"de","@value":"Ace Hochschulstudent:innen"},{"@language":"de","@value":"Asexuelle Hochschulstudent:innen"},{"@language":"es","@value":"Universitarios asexuales"},{"@language":"es","@value":"Universitarias asexuales"}],"rdfs:comment":[{"@language":"en","@value":"Asexual people who are attending college."},{"@language":"de","@value":"Asexuelle Personen, die eine Hochschule besuchen. Achtung: Das US-amerikanische College entspricht nicht exakt der Hochschule im deutschen Sprachraum, wird aber häufig als Hochschule übersetzt."},{"@language":"es","@value":"Personas asexuales que asisten a la universidad."},{"@language":"nl","@value":"Aseksuele personen die naar de universiteit gaan."},{"@language":"sv","@value":"Asexuella personer som studerar vid college."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000071"},{"@id":"https://homosaurus.org/v5/homoit0003041"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0003032"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001297"},"dc:issued":{"@type":"xsd:date","@value":"2023-12-05"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004637","dc:identifier":"homoit0004637","skos:prefLabel":{"@language":"en","@value":"Asexual women"},"skos:altLabel":{"@language":"en","@value":"Ace women"},"rdfs:comment":{"@language":"en","@value":"Women who are asexual. "},"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001509"},{"@id":"https://homosaurus.org/v5/homoit0000071"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2026-06-10"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-10"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004642","dc:identifier":"homoit0004642","skos:prefLabel":{"@language":"en","@value":"Asexual men"},"skos:altLabel":{"@language":"en","@value":"Ace men"},"rdfs:comment":{"@language":"en","@value":"Men who are asexual."},"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001008"},{"@id":"https://homosaurus.org/v5/homoit0000071"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2026-06-10"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-10"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000244","dc:identifier":"homoit0000244","skos:prefLabel":[{"@language":"en","@value":"Celibacy"},{"@language":"es","@value":"Celibato"},{"@language":"de","@value":"Zölibat"},{"@language":"nl","@value":"Celibaat"},{"@language":"sv","@value":"Celibat"}],"rdfs:comment":[{"@language":"en","@value":"Conscious abstinence from sexual activity, often associated with religious beliefs. Celibacy is distinct from asexuality; only use to describe asexual people if they are also choosing to practice conscious abstinence."},{"@language":"es","@value":"Abstinencia consciente de la actividad sexual, a menudo asociada con creencias religiosas. El celibato es distinto de la asexualidad; utilícese únicamente para describir a personas asexuales si también eligen practicar la abstinencia consciente."},{"@language":"de","@value":"Bewusste Enthaltsamkeit von sexuellen Aktivitäten, oft in Verbindung mit religiösen Überzeugungen. Das Zölibat unterscheidet sich von der Asexualität; der Begriff sollte nur verwendet werden, um asexuelle Menschen zu beschreiben, wenn sie sich ebenfalls für eine bewusste Enthaltsamkeit entscheiden."},{"@language":"nl","@value":"Bewuste onthouding van seksuele activiteit, vaak geassocieerd met religieuze overtuigingen. Het celibaat verschilt van aseksualiteit; alleen gebruiken om aseksuele mensen te beschrijven als ze er ook voor kiezen om bewuste onthouding te beoefenen"},{"@language":"sv","@value":"Medveten avhållsamhet från sexuella aktiviteter, ofta kopplad till religiösa övertygelser. Celibat skiljer sig från asexualitet och ska endast användas för att beskriva asexuella personer om de också väljer att praktisera avsiktlig avhållsamhet."}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000071"},{"@id":"https://homosaurus.org/v5/homoit0000142"},{"@id":"https://homosaurus.org/v5/homoit0000484"},{"@id":"https://homosaurus.org/v5/homoit0000732"},{"@id":"https://homosaurus.org/v5/homoit0001169"},{"@id":"https://homosaurus.org/v5/homoit0001282"},{"@id":"https://homosaurus.org/v5/homoit0001402"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85021634"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000244"},"dc:replaces":{"@id":"http://homosaurus.org/v2/celibacy"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001633","dc:identifier":"homoit0001633","skos:prefLabel":[{"@language":"en","@value":"Megasexual people"},{"@language":"es","@value":"Personas megasexuales"},{"@language":"nl","@value":"Megaseksuele personen"},{"@language":"sv","@value":"Megasexuella personer"}],"rdfs:comment":[{"@language":"en","@value":"People who do not experience strong emotional connections to other people unless they form strong sexual connections with them first."},{"@language":"es","@value":"Personas que no experimentan fuertes conexiones emocionales con otras personas a menos que primero formen fuertes conexiones sexuales con ellas."},{"@language":"nl","@value":"Mensen die geen sterke emotionele banden met andere mensen ervaren, tenzij ze eerst sterke seksuele banden met hen aangaan"},{"@language":"sv","@value":"Personer som inte upplever starka känslomässiga band till andra människor om de inte först har utvecklat starka sexuella band."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001297"},"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0003042"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000071"},{"@id":"https://homosaurus.org/v5/homoit0001302"},{"@id":"https://homosaurus.org/v5/homoit0001632"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001297"},"dc:replaces":{"@id":"http://homosaurus.org/v2/megasexualPeople"},"dc:issued":{"@type":"xsd:date","@value":"2020-12-11"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001758","dc:identifier":"homoit0001758","skos:prefLabel":[{"@language":"en","@value":"Asexual families"},{"@language":"es","@value":"Familias asexuales"},{"@language":"de","@value":"Asexuelle Familien"},{"@language":"fr","@value":"Familles asexuelles"},{"@language":"nl","@value":"Aseksuele gezinnen"},{"@language":"sv","@value":"Asexuella familjer"}],"skos:altLabel":[{"@language":"en","@value":"Ace families"},{"@language":"es","@value":"Familias ace"},{"@language":"de","@value":"Ace Familien"},{"@language":"sv","@value":"Ace-familjer"}],"rdfs:comment":[{"@language":"en","@value":"Families, whether biological, adoptive, or chosen, in which one or more individuals identify as asexual."},{"@language":"es","@value":"Familias, ya sean biológicas, adoptivas o elegidas, en las que una o más personas se autoidentifican como asexuales."},{"@language":"de","@value":"Biologische, Adoptiv- oder Wahlfamilien, in denen sich eine oder mehrere Personen als asexuell identifizieren."},{"@language":"fr","@value":"Familles biologiques, adoptives ou choisies, dans lesquelles une ou plusieurs personnes s'identifient comme asexuelles."},{"@language":"nl","@value":"Gezinnen, biologisch, adoptief of gekozen, waarin een of meer individuen zich identificeren als aseksueel."},{"@language":"sv","@value":"Familjer – biologiska, adoptiva eller valda – där en eller flera personer identifierar sig som asexuella."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000420"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000071"},{"@id":"https://homosaurus.org/v5/homoit0001762"},{"@id":"https://homosaurus.org/v5/homoit0001766"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000420"},"dc:issued":{"@type":"xsd:date","@value":"2021-11-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001762","dc:identifier":"homoit0001762","skos:prefLabel":[{"@language":"en","@value":"Asexual parents"},{"@language":"es","@value":"Madres y padres asexuales"},{"@language":"de","@value":"Asexuelle Eltern"},{"@language":"nl","@value":"Aseksuele ouders"},{"@language":"sv","@value":"Asexuella föräldrar"}],"skos:altLabel":[{"@language":"en","@value":"Ace parents"},{"@language":"es","@value":"Padres ace"},{"@language":"es","@value":"Madres ace"},{"@language":"es","@value":"Padres asexuales"},{"@language":"es","@value":"Madres asexuales"},{"@language":"de","@value":"Ace Eltern"}],"rdfs:comment":[{"@language":"en","@value":"Parents who are asexual."},{"@language":"es","@value":"Padres y/o madres que son asexuales. "},{"@language":"de","@value":"Eltern, die asexuell sind."},{"@language":"nl","@value":"Ouders die aseksueel zijn"},{"@language":"sv","@value":"Föräldrar som är asexuella."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001075"},"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0002795"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000071"},{"@id":"https://homosaurus.org/v5/homoit0001758"},{"@id":"https://homosaurus.org/v5/homoit0001766"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000420"},"dc:issued":{"@type":"xsd:date","@value":"2021-11-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001766","dc:identifier":"homoit0001766","skos:prefLabel":[{"@language":"en","@value":"Children of asexual people"},{"@language":"de","@value":"Kinder von asexuellen Personen"},{"@language":"es","@value":"Hijxs de personas asexuales"},{"@language":"fr","@value":"Enfants de personnes asexuelles"},{"@language":"nl","@value":"Kinderen van aseksuele_personen"},{"@language":"sv","@value":"Barn till asexuella personer"}],"skos:altLabel":[{"@language":"en","@value":"Children of ace people"},{"@language":"de","@value":"Kinder von ace Personen"},{"@language":"es","@value":"Hijos de personas ace"},{"@language":"es","@value":"Hijas de personas ace"},{"@language":"es","@value":"Hijas de personas asexuales"},{"@language":"es","@value":"Hijos e hijas de personas asexuales"}],"rdfs:comment":[{"@language":"en","@value":"Children who have one or more asexual parent."},{"@language":"de","@value":"Kinder, die einen oder mehrere asexuelle Elternteile haben."},{"@language":"es","@value":"Hijos o hijas que tienen uno o más madres o padres asexuales."},{"@language":"fr","@value":"Enfants dont un ou plusieurs parents sont asexuel·les."},{"@language":"nl","@value":"Kinderen die een of meer aseksuele ouders hebben"},{"@language":"sv","@value":"Barn som har en eller flera asexuella föräldrar."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000260"},"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0002914"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000071"},{"@id":"https://homosaurus.org/v5/homoit0001758"},{"@id":"https://homosaurus.org/v5/homoit0001762"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000421"},"dc:issued":{"@type":"xsd:date","@value":"2021-11-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002146","dc:identifier":"homoit0002146","skos:prefLabel":[{"@language":"en","@value":"Asexual people in fandom"},{"@language":"es","@value":"Personas asexuales en fandom"},{"@language":"de","@value":"Asexuelle Personen im Fandom"},{"@language":"nl","@value":"Aseksuele personen in fandom"},{"@language":"sv","@value":"Asexuella personer inom fandom"}],"skos:altLabel":[{"@language":"en","@value":"Asexuals in fandom"},{"@language":"es","@value":"Asexuales en fandom"},{"@language":"de","@value":"Asexuelle Personen im Fantum"},{"@language":"de","@value":"Ace Personen im Fandom"},{"@language":"de","@value":"Ace Personen im Fantum"},{"@language":"de","@value":"Aces im Fandom"},{"@language":"de","@value":"Aces im Fantum"}],"rdfs:comment":[{"@language":"en","@value":"The participation and inclusion of asexual people in fan communities."},{"@language":"es","@value":"La participación e inclusión de las personas asexuales en las comunidades de aficionados."},{"@language":"de","@value":"Die Teilnahme und Einbeziehung asexueller Personen in Fan-Communitys."},{"@language":"nl","@value":"De participatie en inclusie van aseksuele personen in fan-gemeenschappen"},{"@language":"sv","@value":"Asexuella personers deltagande och inkludering i fangemenskaper."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002181"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000071"},{"@id":"https://homosaurus.org/v5/homoit0001747"},{"@id":"https://homosaurus.org/v5/homoit0001754"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002912","dc:identifier":"homoit0002912","skos:prefLabel":[{"@language":"en","@value":"Persecution of asexual people"},{"@language":"es","@value":"Persecución de personas asexuales"},{"@language":"nl","@value":"Vervolging van aseksuele personen"},{"@language":"sv","@value":"Förföljelse av asexuella"}],"rdfs:comment":[{"@language":"en","@value":"Systematic mistreatment of asexual people on the basis of their sexual identity."},{"@language":"es","@value":"Maltrato sistemático a personas asexuales por su identidad sexual."},{"@language":"nl","@value":"Systematische mishandeling van aseksuele personen op basis van hun seksuele identiteit."},{"@language":"sv","@value":"Systematisk förföljelse av asexuella personer på grund av deras sexuella identitet."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001108"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000071"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001108"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-29"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000072","dc:identifier":"homoit0000072","skos:prefLabel":[{"@language":"mdy","@value":"Ashtime"},{"@language":"es","@value":"Ashtime"},{"@language":"de","@value":"Ashtime"},{"@language":"nl","@value":"Ashtime"},{"@language":"sv","@value":"Ashtime"}],"rdfs:comment":[{"@language":"en","@value":"Term used by the Maale people in Ethiopia for people assigned male at birth who exhibit feminine characteristics; there is some question over the legitimacy of term."},{"@language":"es","@value":"Término utilizado por el pueblo Maale de Etiopía para las personas asignadas al sexo masculino al nacer que presentan características femeninas; hay cuestionamientos sobre la legitimidad del término."},{"@language":"de","@value":"Begriff, der vom Volk der Maale in Äthiopien für Menschen verwendet wird, die bei der Geburt als männlich zugeordnet wurden, aber weibliche Merkmale aufweisen; die Legitimität des Begriffs ist umstritten."},{"@language":"nl","@value":"Term die door het Maale-volk in Ethiopië wordt gebruikt voor mensen bij de geboorte als man toegewezen en vrouwelijke kenmerken vertonen; er is enige twijfel over de legitimiteit van de term"},{"@language":"sv","@value":"Term som används av Maale-folket i Etiopien för personer som tilldelats manligt kön vid födseln och som uppvisar feminina egenskaper. Det finns viss osäkerhet kring termens legitimitet."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000322"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/ashtime"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000073","dc:identifier":"homoit0000073","skos:prefLabel":[{"@language":"en","@value":"Asian American LGBTQ+ people"},{"@language":"es","@value":"Personas LGBTQ+ asiático-americanas"},{"@language":"de","@value":"Asiatisch-amerikanische LGBTQ+-Personen"},{"@language":"nl","@value":"Aziatisch-Amerikaanse LHBTQ+-personen"},{"@language":"sv","@value":"Asiat-amerikaner (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"Asian American people (LGBTQ)"},{"@language":"en","@value":"Asian Americans (LGBTQ)"},{"@language":"en","@value":"LGBTQ+ Asian American people"},{"@language":"en","@value":"LGBTQ+ Asian Americans"},{"@language":"es","@value":"Personas asiático-americanas (LGBTQ)"},{"@language":"es","@value":"Asiático-americanos LGBTQ"},{"@language":"es","@value":"Asiático-americanos LGBTQ+"},{"@language":"es","@value":"Asiático-americanos (LGBTQ)"},{"@language":"es","@value":"Asiático-americanas LGBTQ"},{"@language":"es","@value":"Asiático-americanas LGBTQ+"},{"@language":"es","@value":"Asiático-americanas (LGBTQ)"},{"@language":"de","@value":"Asiatische LGBTQ+-Amerikaner:innen"},{"@language":"nl","@value":"Aziatisch-Amerikanen (LHBTQ+)"},{"@language":"nl","@value":"LHBTQ+ Aziatisch-Amerikaanse personen"},{"@language":"nl","@value":"LHBTQ+ Aziatisch-Amerikanen"},{"@language":"sv","@value":"Asiatisk-amerikanska hbtq+-personer"}],"rdfs:comment":[{"@language":"en","@value":"LGBTQ+ people of Asian heritage or descent born in the United States or born in Asian countries who live in or have a strong connection to the United States. Only use for individuals who self-identify as Asian American."},{"@language":"es","@value":"Personas LGBTQ+ de ascendencia asiática nacidas en Estados Unidos o personas LGBTQ+ nacidas en países asiáticos que viven en o tienen una conexión fuerte con los Estados Unidos. Utilícese para personas que se autoidentifiquen como asiático-americanas."},{"@language":"de","@value":"LGBTQ+-Personen asiatischer Herkunft oder Abstammung, die in den Vereinigten Staaten oder asiatischen Ländern geboren wurden und in den Vereinigten Staaten leben oder eine starke Verbindung zu den Vereinigten Staaten haben. Nur für Personen verwenden, die sich selbst als asiatisch-amerikanisch bezeichnen."},{"@language":"nl","@value":"LHBTQ+-personen van Aziatische afkomst geboren in de Verenigde Staten of LHBTQ+ mensen geboren in Aziatische landen die wonen in of een sterke band hebben met de Verenigde Staten; gebruiken voor personen die zichzelf identificeren als Aziatisch-Amerikaans"},{"@language":"sv","@value":"Hbtq+-personer av asiatisk härkomst, födda i USA eller i asiatiska länder, som bor i eller har en stark koppling till USA. Används endast för individer som själva identifierar sig som asiatisk-amerikaner."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000074"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000130"},{"@id":"https://homosaurus.org/v5/homoit0000471"},{"@id":"https://homosaurus.org/v5/homoit0000721"},{"@id":"https://homosaurus.org/v5/homoit0001158"},{"@id":"https://homosaurus.org/v5/homoit0001391"},{"@id":"https://homosaurus.org/v5/homoit0002756"},{"@id":"https://homosaurus.org/v5/homoit0002902"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2005007013"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/asianAmericansLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000074","dc:identifier":"homoit0000074","skos:prefLabel":[{"@language":"en","@value":"Asian LGBTQ+ people"},{"@language":"es","@value":"Personas LGBTQ+ asiáticas"},{"@language":"de","@value":"Asiatische LGBTQ+-Personen"},{"@language":"nl","@value":"Aziatische LHBTQ+-personen"},{"@language":"sv","@value":"Asiater (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"Asian people (LGBTQ)"},{"@language":"en","@value":"Asians (LGBTQ)"},{"@language":"en","@value":"LGBTQ+ Asian people"},{"@language":"en","@value":"LGBTQ+ Asians"},{"@language":"es","@value":"Personas asiáticas (LGBTQ)"},{"@language":"es","@value":"Asiáticos (LGBTQ)"},{"@language":"es","@value":"Personas asiáticas LGBTQ+"},{"@language":"es","@value":"Asiáticos LGBTQ+ Asiáticas (LGBTQ)"},{"@language":"es","@value":"Asiáticas LGBTQ+"},{"@language":"de","@value":"LGBTQ+-asiatische Personen"},{"@language":"nl","@value":"Aziatische personen (LHBTQ+)"},{"@language":"nl","@value":"LHBTQ+-Aziaten"},{"@language":"nl","@value":"LHBTQ+-Aziatische personen"},{"@language":"sv","@va