nas que se autoidentifican como latinos, latinas o latinxs. No debe confundirse con chicano/a/x o hispano/a/x."},{"@language":"nl","@value":"Latijns-Amerikaanse personen die aseksueel zijn; alleen gebruiken om personen te beschrijven die zichzelf identificeren als Latino, Latina of Latinx. Niet verwarren met Chicano/a/x of Hispanic."},{"@language":"sv","@value":"Asexuella personer som är latinamerikaner och som själva identifierar sig som latines (latino, latina eller latinx). Blanda inte ihop med chicano/a/x eller hispanic."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000253"},"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0002898"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-29"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003419","dc:identifier":"homoit0003419","skos:prefLabel":[{"@language":"en","@value":"Latino/a/x non-binary people"},{"@language":"de","@value":"Nichtbinäre Latino/-a/-x-Personen"},{"@language":"es","@value":"Personas no binarixs Latinx"},{"@language":"nl","@value":"Latino/a/x non-binaire personen"},{"@language":"sv","@value":"Ickebinära latines"}],"skos:altLabel":[{"@language":"en","@value":"Latina non-binary people"},{"@language":"en","@value":"Latina nonbinary people"},{"@language":"en","@value":"Latino non-binary people"},{"@language":"en","@value":"Latino nonbinary people"},{"@language":"en","@value":"Latino/a/x nonbinary people"},{"@language":"en","@value":"Latinx non-binary people"},{"@language":"en","@value":"Latinx nonbinary people"},{"@language":"en","@value":"Non-binary Latinas"},{"@language":"en","@value":"Non-binary Latino/a/x people"},{"@language":"en","@value":"Non-binary Latinos"},{"@language":"en","@value":"Non-binary Latinx"},{"@language":"en","@value":"Nonbinary Latinas"},{"@language":"en","@value":"Nonbinary Latino/a/x people"},{"@language":"en","@value":"Nonbinary Latinos"},{"@language":"en","@value":"Nonbinary Latinx"},{"@language":"de","@value":"Nichtbinäre Latinos"},{"@language":"de","@value":"Nichtbinäre Latinas"},{"@language":"de","@value":"Nichtbinäre Latinx"},{"@language":"de","@value":"Nonbinäre Latinos"},{"@language":"de","@value":"Nonbinäre Latinas"},{"@language":"de","@value":"Nonbinäre Latinx"},{"@language":"es","@value":"Personas latinas no binarias"},{"@language":"es","@value":"Latines no binaries"},{"@language":"es","@value":"Latinxs no binarixs"},{"@language":"es","@value":"Latinos no binarios"},{"@language":"nl","@value":"Latina nonbinaire personen"},{"@language":"nl","@value":"Latino non-binaire personen"},{"@language":"nl","@value":"Latino nonbinaire personen"},{"@language":"nl","@value":"Latino/a/x nonbinaire personen"},{"@language":"nl","@value":"Latinx non-binaire personen"},{"@language":"nl","@value":"Latinx nonbinaire personen"},{"@language":"nl","@value":"Non-binaire Latina's"},{"@language":"nl","@value":"Non-binaire Latino's"},{"@language":"nl","@value":"Non-binaire Latino/a/x personen"},{"@language":"nl","@value":"Non-binaire Latinx"},{"@language":"nl","@value":"Nonbinaire Latina's"},{"@language":"nl","@value":"Nonbinaire Latino's"},{"@language":"nl","@value":"Nonbinaire Latino/a/x personen"},{"@language":"nl","@value":"Nonbinaire Latinx"},{"@language":"sv","@value":"Latino/a/x ickebinära"}],"rdfs:comment":[{"@language":"en","@value":"Latin American people who are non-binary; only use to describe individuals who self-identify as Latino, Latina, or Latinx. Do not conflate with Chicano/a/x or Hispanic."},{"@language":"de","@value":"Nichbinäre Personen lateinamerikanischer Herkunft; dieser Begriff bezieht sich ausschließlich auf Personen, die sich selbst als Latino, Latina oder Latinx bezeichnen. Nicht mit Chicano/a/x oder Hispanic zu verwechseln."},{"@language":"es","@value":"Personas latinoamericanas que son no binarias; utilícese únicamente para describir a personas que se autoidentifican como latinos, latinas o latinxs. No debe confundirse con chicano/a/x o hispano/a/x."},{"@language":"nl","@value":"Latijns-Amerikaanse personen die non-binair zijn; alleen gebruiken om individuen te beschrijven die zichzelf identificeren als Latino, Latina of Latinx. Niet verwarren met Chicano/a/x of Hispanic."},{"@language":"sv","@value":"Ickebinära personer som är latinamerikaner och som själva identifierar sig som latines (latino, latina eller latinx). Blanda inte ihop med chicano/a/x eller hispanic."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000253"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2024-07-11"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000254","dc:identifier":"homoit0000254","skos:prefLabel":[{"@language":"en","@value":"Child custody"},{"@language":"es","@value":"Custodia de niños"},{"@language":"de","@value":"Sorgerecht für Kinder"},{"@language":"nl","@value":"Voogdij"},{"@language":"sv","@value":"Vårdnad av barn"}],"skos:altLabel":[{"@language":"en","@value":"Guardianship"},{"@language":"en","@value":"Parental custody"},{"@language":"en","@value":"Tutelage"},{"@language":"es","@value":"Tutela"},{"@language":"es","@value":"Custodia parental"},{"@language":"de","@value":"Vormundschaft für Kinder"},{"@language":"nl","@value":"Voogdij over kinderen"},{"@language":"nl","@value":"Voogdijschap"},{"@language":"sv","@value":"Barnförmynderskap"}],"rdfs:comment":[{"@language":"en","@value":"Legal term for the guardianship of a child, or the legal and practical relationship between a parent and a child in their care. Typically used to describe legal custody, which is the right to make decisions about the child, as well as physical custody, which is the right and duty to house, provide, and care for the child."},{"@language":"es","@value":"Término legal para la tutela de un niño, o la relación legal y práctica entre un padre y un niño bajo su cuidado. Normalmente se utiliza para describir la custodia legal, que es el derecho a tomar decisiones sobre el niño, así como la custodia física, que es el derecho y el deber de albergar, proveer y cuidar del niño."},{"@language":"de","@value":"Rechtsbegriff für die Vormundschaft für ein Kind oder die rechtliche und praktische Beziehung zwischen einem Elternteil und einem Kind in dessen Obhut. Wird in der Regel verwendet, um das Sorgerecht für ein Kind zu beschreiben, also das Recht, Entscheidungen über das Kind zu treffen, sowie die Obhut, also das Recht und die Pflicht, das Kind zu unterzubringen, zu versorgen und zu betreuen."},{"@language":"nl","@value":"Wettelijke term voor de voogdij over een kind, of de juridische en praktische relatie tussen een ouder en een kind onder hun hoede. Meestal gebruikt om de wettelijke voogdij te beschrijven, wat het recht is om beslissingen te nemen over het kind, en fysieke voogdij, wat het recht en de plicht is om het kind te huisvesten, te verzorgen en te verzorgen."},{"@language":"sv","@value":"Juridisk term för vårdnaden av ett barn, eller den juridiska och praktiska relationen mellan en förälder och ett barn i deras omsorg. Används vanligtvis för att beskriva juridisk vårdnad, vilket innefattar rätten att fatta beslut om barnet, samt fysisk vårdnad, vilket innebär rätten och skyldigheten att hysa, försörja och ta hand om barnet."}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000255"},{"@id":"https://homosaurus.org/v5/homoit0000809"},{"@id":"https://homosaurus.org/v5/homoit0000854"},{"@id":"https://homosaurus.org/v5/homoit0000870"},{"@id":"https://homosaurus.org/v5/homoit0000918"},{"@id":"https://homosaurus.org/v5/homoit0000937"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85034952"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000254"},"dc:replaces":{"@id":"http://homosaurus.org/v2/childCustody"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000854","dc:identifier":"homoit0000854","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ divorce"},{"@language":"es","@value":"Divorcio LGBTQ+"},{"@language":"ja","@value":"LGBTQ+の離婚"},{"@language":"nl","@value":"LHBTQ+-echtscheiding"},{"@language":"sv","@value":"Skilsmässor (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"LGBTQ divorce"},{"@language":"ja","@value":"LGBTQの離婚"}],"rdfs:comment":[{"@language":"en","@value":"Legal dissolution of marriages involving one or more LGBTQ+ people. "},{"@language":"es","@value":"Disolución legal de matrimonios que involucran a una o más personas LGBTQ+."},{"@language":"ja","@value":"LGBTQ+の人々が関与する婚姻の法的解消。"},{"@language":"nl","@value":"Juridische ontbinding van huwelijken waarbij een of meer LHBTQ+-personen betrokken zijn."},{"@language":"sv","@value":"En rättsprocess för att upplösa ett äktenskap mellan två hbtq+-personer."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000937"},{"@id":"https://homosaurus.org/v5/homoit0000990"}],"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0001255"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000254"},{"@id":"https://homosaurus.org/v5/homoit0000359"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000973"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQDivorce"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000870","dc:identifier":"homoit0000870","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ foster families"},{"@language":"es","@value":"Familas de acogida LGBTQ+"},{"@language":"nl","@value":"LHBTQ+-pleeggezinnen"},{"@language":"sv","@value":"Fosterfamiljer (hbtq+)"}],"skos:altLabel":{"@language":"en","@value":"LGBTQ foster families"},"rdfs:comment":[{"@language":"en","@value":"Families including foster children in which one or more individuals identify as LGBTQ+."},{"@language":"es","@value":"Familias que incluyen niños de acogida en las que una o más personas se autoidentifican como LGBTQ+."},{"@language":"nl","@value":"Gezinnen met pleegkinderen waarin één of meer personen zich identificeren als LHBTQ+."},{"@language":"sv","@value":"Familjer med fosterbarn där en eller flera personer identifierar sig som hbtq+."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000420"},"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0000872"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000254"},{"@id":"https://homosaurus.org/v5/homoit0000809"},{"@id":"https://homosaurus.org/v5/homoit0000811"},{"@id":"https://homosaurus.org/v5/homoit0000914"},{"@id":"https://homosaurus.org/v5/homoit0001075"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000420"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQFosterFamilies"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000937","dc:identifier":"homoit0000937","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ separation"},{"@language":"es","@value":"Separación LGBTQ+"},{"@language":"nl","@value":"LHBTQ+-relatiebeëindiging"},{"@language":"sv","@value":"Juridisk separation (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"Marital separation (LGBTQ)"},{"@language":"en","@value":"LGBTQ separation"},{"@language":"es","@value":"Separación LGBTQ"}],"rdfs:comment":[{"@language":"en","@value":"Arrangement mutually agreed upon or ordered by a judge for married LGBTQ+ people to live apart while remaining legally married. "},{"@language":"es","@value":"Arreglo mutuamente acordado u ordenado por un juez para que las personas LGBTQ+ casadas vivan separadas mientras permanecen legalmente casadas."},{"@language":"nl","@value":"Onderling overeengekomen of door een rechter bevolen regeling voor getrouwde LHBTQ+-personen om gescheiden te leven terwijl ze wettelijk getrouwd blijven."},{"@language":"sv","@value":"En överenskommelse, frivillig eller beslutad av domstol, där gifta hbtq+-personer lever åtskilda men förblir juridiskt gifta."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000990"},"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0000854"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000254"},{"@id":"https://homosaurus.org/v5/homoit0000989"},{"@id":"https://homosaurus.org/v5/homoit0001237"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000973"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQSeparation"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000260","dc:identifier":"homoit0000260","skos:prefLabel":[{"@language":"en","@value":"Children of LGBTQ+ people"},{"@language":"de","@value":"Kinder von LGBTQ+-Personen"},{"@language":"es","@value":"Hijxs de personas LGBTQ+"},{"@language":"nl","@value":"Kinderen van LHBTQ+-personen"},{"@language":"sv","@value":"Barn till hbtq+-personer"}],"skos:altLabel":[{"@language":"en","@value":"Children of LGBTQ people"},{"@language":"es","@value":"Hijas de personas LGBTQ+"},{"@language":"es","@value":"Hijos de personas LGBTQ+"},{"@language":"es","@value":"Hijos e hijas de personas LGBTQ+"}],"rdfs:comment":[{"@language":"en","@value":"Children who have one or more LGBTQ+ parent."},{"@language":"de","@value":"Kinder, die einen oder mehrere LGBTQ+-Elternteile haben."},{"@language":"es","@value":"Hijos o hijas que tienen uno o más madres o padres LGBTQ+."},{"@language":"nl","@value":"Kinderen die een of meer LHBTQ+-ouders hebben."},{"@language":"sv","@value":"Barn som har en eller flera hbtq+-föräldrar."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000255"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000257"},{"@id":"https://homosaurus.org/v5/homoit0000258"},{"@id":"https://homosaurus.org/v5/homoit0000259"},{"@id":"https://homosaurus.org/v5/homoit0000261"},{"@id":"https://homosaurus.org/v5/homoit0000262"},{"@id":"https://homosaurus.org/v5/homoit0001765"},{"@id":"https://homosaurus.org/v5/homoit0001766"},{"@id":"https://homosaurus.org/v5/homoit0001767"},{"@id":"https://homosaurus.org/v5/homoit0002583"},{"@id":"https://homosaurus.org/v5/homoit0002584"},{"@id":"https://homosaurus.org/v5/homoit0002585"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000809"},{"@id":"https://homosaurus.org/v5/homoit0002586"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000421"},"dc:replaces":{"@id":"http://homosaurus.org/v2/childrenOfLGBTQPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001768","dc:identifier":"homoit0001768","skos:prefLabel":[{"@language":"en","@value":"Children of Two-Spirit people"},{"@language":"de","@value":"Kinder von Two-Spirit-Personen"},{"@language":"es","@value":"Hijxs de personas dos espíritus"},{"@language":"fr","@value":"Enfants de personnes bispirituelles"},{"@language":"nl","@value":"Kinderen van Two-Spirit people"},{"@language":"sv