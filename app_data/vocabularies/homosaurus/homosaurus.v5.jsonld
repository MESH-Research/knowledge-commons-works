s://homosaurus.org/v5/homoit0002710"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001750"},{"@id":"https://homosaurus.org/v5/homoit0003866"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0002710"},"dc:issued":{"@type":"xsd:date","@value":"2025-03-13"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003188","dc:identifier":"homoit0003188","skos:prefLabel":[{"@language":"en","@value":"Two-Spirit urban fantasy fiction"},{"@language":"es","@value":"Ficción fantástica urbana dos espiritus"},{"@language":"nl","@value":"Two-Spirit urban fantasy"},{"@language":"sv","@value":"Two-spirit-urban fantasy"},{"@language":"en","@value":"2S urban fantasy fiction"},{"@language":"en","@value":"Two Spirit urban fantasy fiction"},{"@language":"en","@value":"Two Spirited urban fantasy fiction"},{"@language":"en","@value":"Two-Spirited urban fantasy fiction"}],"rdfs:comment":[{"@language":"en","@value":"Subgenre of fantasy fiction, written works that depicts magical, fantastical, and/or supernatural elements in contemporary urban settings. Use for urban fantasy fiction focusing on Two-Spirit characters or themes."},{"@language":"es","@value":"Un subgénero de la ficción fantástica que presenta a criaturas mágicas y sobrenaturales en entornos urbanos contemporáneos; utilícese para la fantasía urbana centrada en personajes o temas dos espíritus."},{"@language":"nl","@value":"Een subgenre van fantasy met magische en bovennatuurlijke wezens in een hedendaagse stedelijke omgeving; gebruik voor urban fantasy gericht op Two-Spirit-personages of thema's."},{"@language":"sv","@value":"En subgenre inom fantasy med magi och övernaturliga varelser i nutida urbana miljöer. Används för urban fantasy med Two-spirit-karaktärer eller Two-spirit-teman."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001751"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0003179"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0002710"},"dc:issued":{"@type":"xsd:date","@value":"2024-01-18"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004297","dc:identifier":"homoit0004297","skos:prefLabel":[{"@language":"en","@value":"Two-Spirit historical fiction"},{"@language":"nl","@value":"Two-Spirit historische literatuur"},{"@language":"sv","@value":"Historiska skildringar om two-spirit-personer"}],"skos:altLabel":[{"@language":"en","@value":"2S historical fiction"},{"@language":"en","@value":"Two Spirit historical fiction"},{"@language":"en","@value":"Two Spirited historical fiction"},{"@language":"en","@value":"Two-Spirited historical fiction"},{"@language":"sv","@value":"Historiska romaner om two-spirit-personer"}],"rdfs:comment":[{"@language":"en","@value":"Genre of written works that depicts events set during particular real historical events. Use for historical fiction focusing on Two-Spirit characters or themes."},{"@language":"nl","@value":"Geschreven fictieve werken waarin het verhaal zich afspeelt tegen de achtergrond van specifieke, waargebeurde historische gebeurtenissen; gebruik in verwijzing naar historische fictie met de focus op Two-Spirit personages of thema's."},{"@language":"sv","@value":"Skönlitterära verk som utspelar sig i historisk tid, med verkliga händelser och miljöer. Används för historiska skildringar med fokus på two-spirit-karaktärer eller teman."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001751"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0004295"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0002710"},"dc:issued":{"@type":"xsd:date","@value":"2026-02-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004301","dc:identifier":"homoit0004301","skos:prefLabel":[{"@language":"en","@value":"Intersex historical fiction"},{"@language":"nl","@value":"Intersekse historische literatuur"},{"@language":"sv","@value":"Historiska skildringar om intersexpersoner"}],"skos:altLabel":{"@language":"sv","@value":"Historiska romaner om intersexpersoner"},"rdfs:comment":[{"@language":"en","@value":"Genre of written works that depicts events set during particular real historical events. Use for historical fiction focusing on intersex characters or themes."},{"@language":"nl","@value":"Geschreven fictieve werken waarin het verhaal zich afspeelt tegen de achtergrond van specifieke, waargebeurde historische gebeurtenissen; gebruik in verwijzing naar historische fictie met intersekse personages of thema's."},{"@language":"sv","@value":"Skönlitterära verk som utspelar sig i historisk tid, med verkliga händelser och miljöer. Används för historiska skildringar med fokus på intersex-karaktärer eller teman."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001752"},{"@id":"https://homosaurus.org/v5/homoit0004295"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2026-02-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004298","dc:identifier":"homoit0004298","skos:prefLabel":[{"@language":"en","@value":"Asexual historical fiction"},{"@language":"nl","@value":"Aseksuele historische literatuur"},{"@language":"sv","@value":"Asexuella historiska skildringar"}],"skos:altLabel":[{"@language":"en","@value":"Ace historical fiction"},{"@language":"sv","@value":"Asexuella historiska romaner"}],"rdfs:comment":[{"@language":"en","@value":"Genre of written works that depicts events set during particular real historical events. Use for historical fiction focusing on asexual characters or themes."},{"@language":"nl","@value":"Geschreven fictieve werken waarin het verhaal zich afspeelt tegen de achtergrond van specifieke, waargebeurde historische gebeurtenissen; gebruik in verwijzing naar historische fictie met aseksuele personages of thema's."},{"@language":"sv","@value":"Skönlitterära verk som utspelar sig i historisk tid, med verkliga händelser och miljöer. Används för historiska skildringar med fokus på asexuella karaktärer eller teman."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001754"},{"@id":"https://homosaurus.org/v5/homoit0004295"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2026-02-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002741","dc:identifier":"homoit0002741","skos:prefLabel":[{"@language":"en","@value":"Intersex fathers"},{"@language":"es","@value":"Padres intersexuales"},{"@language":"nl","@value":"Intersekse vaders"},{"@language":"sv","@value":"Intersexpappor"}],"skos:altLabel":[{"@language":"es","@value":"Papás intersex"},{"@language":"es","@value":"Padres intersex"},{"@language":"sv","@value":"Intersexfäder"}],"rdfs:comment":[{"@language":"en","@value":"Intersex people who are fathers. Only use for people who identify as fathers."},{"@language":"es","@value":"Personas intersex que son padres. Utilícese únicamente para personas que se autoidentifiquen como padres."},{"@language":"nl","@value":"Intersekse personen die vader zijn. Alleen gebruiken voor mensen die zich identificeren als vader."},{"@language":"sv","@value":"Intersexpersoner som är pappor. Används endast för personer som själva identifierar sig som pappor."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002337"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001763"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000421"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-27"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002914","dc:identifier":"homoit0002914","skos:prefLabel":[{"@language":"en","@value":"Sons of asexual people"},{"@language":"es","@value":"Hijos de personas asexuales"},{"@language":"nl","@value":"Zonen van aseksuele personen"},{"@language":"sv","@value":"Söner till asexuella personer"}],"rdfs:comment":[{"@language":"en","@value":"Sons who have one or more asexual parent. For sons who are themselves asexual, use the term \"Asexual sons.\""},{"@language":"es","@value":"Hijos que tienen uno o más padres asexuales. Para los hijos que son asexuales, utilice el término \"hijos asexuales\"."},{"@language":"nl","@value":"Zonen die één of meer aseksuele ouders hebben. Voor zonen die zelf aseksueel zijn, dient de term 'aseksuele zonen' gebruikt te worden."},{"@language":"sv","@value":"Söner som har en eller flera asexuella föräldrar. För söner som själva är asexuella används termen ”Asexuella söner”."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001766"},{"@id":"https://homosaurus.org/v5/homoit0002355"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000421"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-29"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002745","dc:identifier":"homoit0002745","skos:prefLabel":[{"@language":"en","@value":"Sons of intersex people"},{"@language":"es","@value":"Hijos de personas intersexuales"},{"@language":"nl","@value":"Zonen van intersekse personen"},{"@language":"sv","@value":"Söner till intersexpersoner"}],"skos:altLabel":{"@language":"es","@value":"Hijos de personas intersex"},"rdfs:comment":[{"@language":"en","@value":"Sons who have one or more intersex parent. For sons who are themselves intersex, use the term \"Intersex sons.\""},{"@language":"es","@value":"Hijos que tienen uno o más padres intersexuales. Para los hijos que son intersexuales, utilice el término \"hijos intersexuales\"."},{"@language":"nl","@value":"Zonen die één of meer intersekse ouders hebben. Voor zonen die zelf intersekse zijn, dientde term 'intersekse zonen' gebruikt te worden."},{"@language":"sv","@value":"Söner som har en eller flera intersexföräldrar. För söner som själva är intersexpersoner används termen ”Intersexsöner”."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002355"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001767"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000421"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-27"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004620","dc:identifier":"homoit0004620","skos:prefLabel":{"@language":"en","@value":"Missing or Murdered Indigenous Women, Girls, and Two-Spirit People (MMIWG2S)"},"skos:altLabel":{"@language":"en","@value":"MMIWG2S"},"rdfs:comment":{"@language":"en","@value":"A term used to describe the movement to raise awareness and seek justice regarding the disproportionate violence experienced by Indigenous women, girls, and Two-Spirit people. Settler colonialism, anti-Indigenous racism, sex trafficking, and structural violence (including jurisdiction disputes and ineffective collaboration between federal, state, county, and tribal authorities) all contribute to these disproportionate rates of violence, murder, and disappearances. While this term is mostly used in Canadian and U.S. contexts, it is also used in Australia and New Zealand."},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001769"},{"@id":"https://homosaurus.org/v5/homoit0002397"},{"@id":"https://homosaurus.org/v5/homoit0003752"},{"@id":"https://homosaurus.org/v5/homoit0002377"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0004620"},"dc:issued":{"@type":"xsd:date","@value":"2026-06-08"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-08"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001777","dc:identifier":"homoit0001777","skos:prefLabel":[{"@language":"en","@value":"Intersex chefs"},{"@language":"es","@value":"Cocinerxs intersexuales"},{"@language":"nl","@value":"Intersekse chefkoks"},{"@language":"sv","@value":"Intersexkökschefer"}],"skos:altLabel":[{"@language":"es","@value":"Chefs intersexuales"},{"@language":"es","@value":"Chefs intersex"},{"@language":"es","@value":"Cocineros intersex"},{"@language":"es","@value":"Cocineros intersexuales"},{"@language":"sv","@value":"Intersexperson som är kökschefer"}],"rdfs:comment":[{"@language":"en","@value":"Intersex people who are trained, professional cooks, typically holding a leadership role in the kitchen in which they are employed."},{"@language":"es","@value":"Personas intersex que son cocineras profesionales y capacitadas, que normalmente desempeñan un papel de liderazgo en la cocina en la que trabajan."},{"@language":"nl","@value":"Intersekse personen die zijn opgeleid tot professionele koks, en doorgaans een leidende rol vervullen in de keuken waarin ze werken"},{"@language":"sv","@value":"Intersexpersoner som är utbildade, professionella kockar och som vanligtvis har en ledande roll i köket där de arbetar."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001771"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001772"},{"@id":"https://homosaurus.org/v5/homoit0001773"},{"@id":"https://homosaurus.org/v5/homoit0001774"},{"@id":"https://homosaurus.org/v5/homoit0001775"},{"@id":"https://homosaurus.org/v5/homoit0001776"},{"@id":"https://homosaurus.org/v5/homoit0002771"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2021-12-07"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002771","dc:identifier":"homoit0002771","skos:prefLabel":[{"@language":"en","@value":"Asexual chefs"},{"@language":"de","@value":"Asexuelle Chefköch:innen"},{"@language":"es","@value":"Cocinerxs asexuales"},{"@language":"nl","@value":"Aseksuele chefkoks"},{"@language":"sv","@value":"Asexuella kökschefer"}],"skos:altLabel":[{"@language":"de","@value":"Ace Chefköch:innen"},{"@language":"de","@value":"Asexuelle Chefköche"},{"@language":"de","@value":"Ace Chefköche"},{"@language":"de","@value":"Ace Chefköchinnen"},{"@language":"de","@value":"Asexuelle Chefköchinnen"},{"@language":"es","@value":"Chefs asexuales"},{"@language":"es","@value":"Cocineros asexuales"}],"rdfs:comment":[{"@language":"en","@value":"Asexual people who are trained, professional cooks, typically holding a leadership role in the kitchen in which they are employed."},{"@language":"de","@value":"Asexuelle Personen, die ausgebildete, professionelle Köch:innen sind und in der Regel eine Führungsrolle in ihrer Küche innehaben."},{"@language":"es","@value":"Personas asexuales que son cocineros profesionales con entrenamiento, que suelen desempeñar un papel de liderazgo en la cocina en la que trabajan."},{"@language":"nl","@value":"Aseksuele personen die zijn opgeleid tot professionele koks, en doorgaans een leidende rol vervullen in de keuken waarin ze werken"},{"@language":"sv","@value":"Asexuella personer som är utbildade, professionella kockar, vanligtvis i ledande positioner i köket där de arbetar."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001771"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001772"},{"@id":"https://homosaurus.org/v5/homoit0001773"},{"@id":"https://homosaurus.org/v5/homoit0001774"},{"@id":"https://homosaurus.org/v5/homoit0001775"},{"@id":"https://homosaurus.org/v5/homoit0001776"},{"@id":"https://homosaurus.org/v5/homoit0001777"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-27"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003403","dc:identifier":"homoit0003403","skos:prefLabel":[{"@language":"en","@value":"Closeted non-binary people"},{"@language":"de","@value":"Ungeoutete nichtbinäre Personen"},{"@language":"es","@value":"Personas no binarixs en el clóset"},{"@language":"nl","@value":"Non-binaire personen in de kast"},{"@language":"sv","@value":"Garderobsickebinära"}],"skos:altLabel":[{"@language":"en","@value":"Closeted nonbinary people"},{"@language":"de","@value":"Nicht geoutete nicht-binäre Personen"},{"@language":"de","@value":"Nicht geoutete non-binäre Personen"},{"@language":"es","@value":"Personas no binarias en el clóset"},{"@language":"es","@value":"No binarios en el clóset"},{"@language":"es","@value":"No binarixs en el clóset"}],"rdfs:comment":[{"@language":"en","@value":"Non-binary people who do not identify as such to others."},{"@language":"de","@value":"Nichtbinäre Personen, die diese Identität vor anderen nicht preisgeben."},{"@language":"es","@value":"Personas no binarias que no se autoidentifican como tales ante los demás."},{"@language":"nl","@value":"Non-binaire personen die zich als zodanig identificeren tegenover anderen."},{"@language":"sv","@value":"Ickebinära personer som inte identifierar sig som sådana inför andra."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001783"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2024-07-11"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001792","dc:identifier":"homoit0001792","skos:prefLabel":[{"@language":"en","@value":"Biromanticism"},{"@language":"es","@value":"Birromanticismo"},{"@language":"de","@value":"Biromantik"},{"@language":"fr","@value":"Biromantisme"},{"@language":"nl","@value":"Biromanticisme"},{"@language":"sv","@value":"Biromantik"}],"rdfs:comment":[{"@language":"en","@value":"A romantic orientation characterized by the occurrence of romantic attraction or desire in a frequent and consistent manner toward more than one sex or gender."},{"@language":"es","@value":"Orientación romántica caracterizada por la atracción o el deseo romántico de forma frecuente y constante hacia más de un sexo o género."},{"@language":"de","@value":"Eine romantische Orientierung, die sich dadurch auszeichnet, dass häufig und beständig eine romantische Anziehung oder ein romantisches Verlangen zu mehr als einem biologischen oder sozialen Geschlecht besteht."},{"@language":"fr","@value":"Orientation romantique caractérisée par une attirance sentimentale envers plus d'un genre."},{"@language":"sv","@value":"En romantisk läggning som kännetecknas av förekomsten av romantisk attraktion eller längtan efter romantiska relationer regelbundet och återkommande gentemot mer än ett kön eller en könsidentitet."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001791"},{"@id":"https://homosaurus.org/v5/homoit0001828"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001824"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001828"},"dc:issued":{"@type":"xsd:date","@value":"2021-12-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001793","dc:identifier":"homoit0001793","skos:prefLabel":[{"@language":"en","@value":"Homoromanticism"},{"@language":"es","@value":"Homoromanticismo"},{"@language":"de","@value":"Homoromantik"},{"@language":"fr","@value":"Homoromantisme"},{"@language":"nl","@value":"Homoromanticisme"},{"@language":"sv","@value":"Homoromantik"}],"rdfs:comment":[{"@language":"en","@value":"A romantic orientation characterized by the occurrence of romantic attraction or desire in a frequent and consistent manner toward members of the same sex or gender."},{"@language":"es","@value":"Una orientación romántica caracterizada por la ocurrencia de atracción o deseo romántico de manera frecuente y consistente hacia miembros del mismo sexo o género."},{"@language":"de","@value":"Eine romantische Orientierung, die sich durch das häufige und beständige Auftreten romantischer Anziehung oder Begierde gegenüber Personen desselben biologischen oder sozialen Geschlechts auszeichnet."},{"@language":"fr","@value":"Orientation romantique caractérisée par une attirance ou un désir romantique fréquent et constant envers les personnes du même sexe ou du même genre."},{"@language":"nl","@value":"Een romantische oriëntatie die wordt gekenmerkt door het optreden van een romantische aantrekking of een romantisch verlangen op een frequente en consistente manier jegens leden van hetzelfde geslacht of gender"},{"@language":"sv","@value":"En romantisk läggning som kännetecknas av att romantisk attraktion eller längtan uppstår ofta och konsekvent gentemot personer av samma kön."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001791"},{"@id":"https://homosaurus.org/v5/homoit0001828"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001825"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001828"},"dc:issued":{"@type":"xsd:date","@value":"2021-12-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001794","dc:identifier":"homoit0001794","skos:prefLabel":[{"@language":"en","@value":"Heteroromanticism"},{"@language":"es","@value":"Heteroromanticismo"},{"@language":"de","@value":"Heteroromantik"},{"@language":"fr","@value":"Hétéroromantisme"},{"@language":"nl","@value":"Heteroromanticisme"},{"@language":"sv","@value":"Heterotomantisk"}],"skos:altLabel":{"@language":"fr","@value":"Hétéro-romantisme"},"rdfs:comment":[{"@language":"en","@value":"A romantic orientation characterized by the occurrence of romantic attraction or romantic desire in a frequent and consistent manner toward members of the opposite sex or gender."},{"@language":"es","@value":"Una orientación romántica caracterizada por la ocurrencia de atracción romántica o deseo romántico de manera frecuente y consistente hacia miembros del sexo o género opuesto."},{"@language":"de","@value":"Eine romantische Orientierung, die sich durch das häufige und beständige Auftreten romantischer Anziehung oder romantischen Verlangens gegenüber Angehörigen des anderen Geschlechts charakterisiert."},{"@language":"fr","@value":"Orientation romantique caractérisée par une attirance ou un désir romantiques fréquents et constants à l'égard des personnes de sexe ou de genre opposé."},{"@language":"nl","@value":"Een romantische oriëntatie die wordt gekenmerkt door het optreden van een romantische aantrekking of een romantisch verlangen op een frequente en consistente manier jegens leden van het andere geslacht of gender"},{"@language":"sv","@value":"En romantisk läggning som kännetecknas av att romantisk attraktion eller romantisk längtan uppstår ofta och konsekvent gentemot personer av motsatt kön."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001791"},{"@id":"https://homosaurus.org/v5/homoit0001828"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001826"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001828"},"dc:issued":{"@type":"xsd:date","@value":"2021-12-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001795","dc:identifier":"homoit0001795","skos:prefLabel":[{"@language":"en","@value":"Panromanticism"},{"@language":"es","@value":"Panromanticismo"},{"@language":"fr","@value":"Panromantisme"},{"@language":"nl","@value":"Panromanticisme"},{"@language":"sv","@value":"Panromantik"}],"rdfs:comment":[{"@language":"en","@value":"A romantic orientation characterized by the occurrence of romantic attraction or romantic desire in a frequent and consistent manner irrespective of sex or gender."},{"@language":"es","@value":"Una orientación romántica caracterizada por la ocurrencia de atracción romántica o deseo romántico de manera frecuente y consistente, independientemente del sexo o género."},{"@language":"fr","@value":"Orientation romantique caractérisée par une attirance ou un désir romantique, indépendamment du sexe ou du genre."},{"@language":"nl","@value":"Een romantische oriëntatie die wordt gekenmerkt door het optreden van een romantische aantrekkingskracht of een romantisch verlangen op een frequente en consistente manier, ongeacht geslacht of gender"},{"@language":"sv","@value":"En romantisk läggning som innebär att en person känner romantisk attraktion eller längtan till andra oavsett deras kön eller könsidentitet, ofta på ett frekvent och konsekvent sätt."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001791"},{"@id":"https://homosaurus.org/v5/homoit0001828"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001827"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001828"},"dc:issued":{"@type":"xsd:date","@value":"2021-12-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001807","dc:identifier":"homoit0001807","skos:prefLabel":[{"@language":"en","@value":"Content warnings"},{"@language":"es","@value":"Advertencias de contenido"},{"@language":"de","@value":"Inhaltswarnung"},{"@language":"nl","@value":"Inhoudswaarschuwingen"},{"@language":"sv","@value":"Innehållsvarningar"}],"skos:altLabel":[{"@language":"en","@value":"Trigger warnings"},{"@language":"es","@value":"Advertencias"},{"@language":"de","@value":"Triggerwarnung"},{"@language":"sv","@value":"Content warnings"}],"rdfs:comment":[{"@language":"en","@value":"Statements used to caution individuals that materials may be disturbing or offensive. Includes warnings assigned to fanworks (usually by the creator) that give information about possibly upsetting, triggering, or controversial elements within a work."},{"@language":"es","@value":"Declaraciones utilizadas para advertir a personas que los materiales pueden ser perturbadores u ofensivos. Incluye advertencias asignadas a obras de fanwork (generalmente por el creador) que brindan información sobre elementos posiblemente perturbadores, desencadenantes o controversiales dentro de una obra."},{"@language":"de","@value":"Hinweise, die Personen darauf aufmerksam machen, dass Inhalte verstörend oder anstößig sein können. Dazu gehören auch Warnhinweise zu Fanwerken (in der Regel von den Urheber:innen), die über möglicherweise verstörende, auslösende oder kontroverse Elemente innerhalb eines Werks informieren."},{"@language":"nl","@value":"Verklaringen die worden gebruikt om personen te waarschuwen dat materialen verontrustend of aanstootgevend kunnen zijn"},{"@language":"sv","@value":"Uttalanden som används för att varna individer om att material kan vara störande eller stötande. Inkluderar varningar som tilldelas fanverk (vanligtvis av skaparen) för att ge information om potentiellt upprörande, triggande eller kontroversiella inslag i ett verk."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002161"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0002195"},{"@id":"https://homosaurus.org/v5/homoit0002215"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2017003111"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-01-18"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002161","dc:identifier":"homoit0002161","skos:prefLabel":[{"@language":"en","@value":"Fanworks"},{"@language":"es","@value":"Fanworks"},{"@language":"de","@value":"Fan-Werke"},{"@language":"nl","@value":"Fanwerken"},{"@language":"sv","@value":"Fanverk"}],"skos:altLabel":[{"@language":"en","@value":"Fan works"},{"@language":"es","@value":"Fanworks"},{"@language":"de","@value":"Fanwerke"},{"@language":"nl","@value":"Fan-werken"},{"@language":"sv","@value":"Fanworks"}],"rdfs:comment":[{"@language":"en","@value":"Works, such as fanfiction or fanart, created by fans using characters, settings, and/or plots of other media properties."},{"@language":"es","@value":"Obras, como fanfiction o fanart, creadas por fanáticos utilizando personajes, escenarios y/o tramas de otras propiedades mediáticas."},{"@language":"de","@value":"Werke wie Fanfiction oder Fanart, die von Fans unter Verwendung von Figuren, Schauplätzen und/oder Handlungen anderer Medien erstellt werden."},{"@language":"nl","@value":"Werken, zoals fanfictie of fanart, gemaakt door fans met behulp van personages, instellingen en/of plots van andere media-uitingen"},{"@language":"sv","@value":"Verk, som fanfiction eller fanart, skapade av fans och som använder karaktärer, miljöer och/eller handlingar från andra medieverk."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002156"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0001807"},{"@id":"https://homosaurus.org/v5/homoit0002155"},{"@id":"https://homosaurus.org/v5/homoit0002159"},{"@id":"https://homosaurus.org/v5/homoit0002204"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001937","dc:identifier":"homoit0001937","skos:prefLabel":[{"@language":"en","@value":"Pacific Islander American lesbians"},{"@language":"es","@value":"Lesbianas del Pacífico estadounidenses"},{"@language":"nl","@value":"Pacific Islander Amerikaanse lesbische vrouwen"},{"@language":"sv","@value":"Lesbiska pacifikamerikaner"}],"skos:altLabel":[{"@language":"en","@value":"Lesbian Pacific Islander Americans"},{"@language":"es","@value":"Personas del Pacífico estadounidenses lesbianas"},{"@language":"sv","@value":"Lesbiska med stillahavsöbakgrund som identifierar sig som amerikanska"}],"rdfs:comment":[{"@language":"en","@value":"Lesbians who identify as both Pacific Islanders (or of Pacific Islander ancestry) and American."},{"@language":"es","@value":"Lesbianas que se identifican a la vez como isleñas del Pacífico (o de ascendencia isleña del Pacífico) y estadounidenses."},{"@language":"nl","@value":"Lesbische vrouwen die zich identificeren als zowel Pacific Islanders (of van Pacific Islander-afkomst) als Amerikaans"},{"@language":"sv","@value":"Lesbiska personer som identifierar sig som både amerikanska och som personer med ursprung i Stillahavsöarna."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001812"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh98006583"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-05-10"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001938","dc:identifier":"homoit0001938","skos:prefLabel":[{"@language":"en","@value":"Pacific Islander American gay men"},{"@language":"es","@value":"Hombres gay del Pacífico estadounidenses"},{"@language":"nl","@value":"Pacific Islander Amerikaanse homomannen"},{"@language":"sv","@value":"Pacifikamerikanska bögar"}],"skos:altLabel":[{"@language":"en","@value":"Gay Pacific Islander American men"},{"@language":"en","@value":"Gay Pacific Islander Americans"},{"@language":"es","@value":"Hombres del Pacífico estadounidenses gay"},{"@language":"sv","@value":"Bögar med stillahavsöbakgrund som identifierar sig som amerikanska"}],"rdfs:comment":[{"@language":"en","@value":"Gay men who identify as both Pacific Islanders (or of Pacific Islander ancestry) and American."},{"@language":"es","@value":"Hombres gay que se identifican a la vez como isleños del Pacífico (o de ascendencia isleña del Pacífico) y estadounidenses."},{"@language":"nl","@value":"Homomannen die zich identificeren als zowel Pacific Islanders (of van Pacific Islander-afkomst) als Amerikaans"},{"@language":"sv","@value":"Bögar som identifierar sig som både amerikanska och som personer med ursprung i Stillahavsöarna."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001812"},"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh96001124"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-05-10"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001939","dc:identifier":"homoit0001939","skos:prefLabel":[{"@language":"en","@value":"Pacific Islander American bisexual people"},{"@language":"es","@value":"Personas bisexuales del Pacífico estadounidenses"},{"@language":"nl","@value":"Pacific Islander Amerikaanse biseksuele personen"},{"@language":"sv","@value":"Bisexuella pacifikamerikaner"}],"skos:altLabel":[{"@language":"en","@value":"Bisexual Pacific Islander American people"},{"@language":"en","@value":"Bisexual Pacific Islander Americans"},{"@language":"es","@value":"Personas del Pacífico estadounidenses bisexuales"},{"@language":"nl","@value":"Pacific Islander Amerikaanse biseksuelen"},{"@language":"sv","@value":"Bisexuella personer med stillahavsöbakgrund som identifierar sig som amerikanska"}],"rdfs:comment":[{"@language":"en","@value":"Bisexual people who identify as both Pacific Islanders (or of Pacific Islander ancestry) and American."},{"@language":"es","@value":"Personas bisexuales que se identifican a la vez como isleñas del Pacífico (o de ascendencia isleña del Pacífico) y estadounidenses."},{"@language":"sv","@value":"Bisexuella personer som identifierar sig som både amerikanska och som personer med ursprung i Stillahavsöarna."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001812"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh98006062"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-05-10"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001940","dc:identifier":"homoit0001940","skos:prefLabel":[{"@language":"en","@value":"Pacific Islander American transgender people"},{"@language":"es","@value":"Personas transgénero del Pacífico estadounidense"},{"@language":"nl","@value":"Pacific Islander Amerikaanse transgend