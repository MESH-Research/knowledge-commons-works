.org/v5/homoit0002501"},{"@id":"https://homosaurus.org/v5/homoit0002505"},{"@id":"https://homosaurus.org/v5/homoit0002506"},{"@id":"https://homosaurus.org/v5/homoit0002508"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-11"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002537","dc:identifier":"homoit0002537","skos:prefLabel":[{"@language":"en","@value":"Greyromantic literature"},{"@language":"es","@value":"Literatura grisromántica"},{"@language":"nl","@value":"Grijsromantische literatuur"},{"@language":"sv","@value":"Gråromantisk litteratur"}],"skos:altLabel":{"@language":"sv","@value":"Greyromantic-litteratur"},"rdfs:comment":[{"@language":"en","@value":"Written literary works about greyromanticism, greyromantic characters, or greyromantic themes.\t\t\t\t"},{"@language":"es","@value":"Obras literarias escritas sobre el grisromanticismo, personajes grisrománticos o temas grisrománticos."},{"@language":"nl","@value":"Geschreven literaire werken over grijsromanticisme, grijsromantische personages of grijsromantische thema's."},{"@language":"sv","@value":"Skrivna litterära verk om gråromantik, gråromantiska karaktärer eller gråromantiska teman."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000972"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0002522"},{"@id":"https://homosaurus.org/v5/homoit0002534"},{"@id":"https://homosaurus.org/v5/homoit0002535"},{"@id":"https://homosaurus.org/v5/homoit0002536"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-11"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002750","dc:identifier":"homoit0002750","skos:prefLabel":[{"@language":"en","@value":"Intersex literature"},{"@language":"es","@value":"Literatura intersexual"},{"@language":"nl","@value":"Intersekse literatuur"},{"@language":"sv","@value":"Intersexlitteratur"}],"skos:altLabel":{"@language":"es","@value":"Literatura intersex"},"rdfs:comment":[{"@language":"en","@value":"Written literary works about intersex characters or themes."},{"@language":"es","@value":"Obras literarias escritas sobre personajes o temas intersex."},{"@language":"nl","@value":"Geschreven literaire werken over intersekse personages of thema's."},{"@language":"sv","@value":"Skrivna litterära verk om intersexpersoner eller intersexteman."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000972"},"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0002953"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001749"},{"@id":"https://homosaurus.org/v5/homoit0004024"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-27"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003488","dc:identifier":"homoit0003488","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ children's literature"},{"@language":"ja","@value":"LGBTQ+の児童文学"},{"@language":"es","@value":"Literatura infantil LGBTQ+"},{"@language":"nl","@value":"LHBTQ+-kinderliteratuur"},{"@language":"sv","@value":"Hbtq+-barnlitteratur"}],"skos:altLabel":[{"@language":"en","@value":"Children's literature (LGBTQ+)"},{"@language":"en","@value":"LGBTQ+ juvenile literature"},{"@language":"en","@value":"LGBTQ+ kid lit"},{"@language":"ja","@value":"児童文学 (LGBTQ+)"},{"@language":"ja","@value":"LGBTQ+を題材とした児童文学"},{"@language":"es","@value":"Literatura LGBTQ+ infantil"},{"@language":"es","@value":"Literatura infantil (LGBTQ)"},{"@language":"nl","@value":"LHBTQ+-kid lit"}],"rdfs:comment":[{"@language":"en","@value":"Written literary works for an audience of readers up to 12 years of age, also known as kid lit or juvenile literature. Use in reference to children's literature focusing on LGBTQ+ characters or themes."},{"@language":"ja","@value":"12歳以下の読者を対象とした文学作品。キッズ・リット（kid lit）や児童文学とも呼ばれる。LGBTQ+の登場人物やテーマに焦点を当てた児童文学を指す場合に用いる。"},{"@language":"es","@value":"Obras literarias escritas para un público de lectores de hasta 12 años de edad, también conocidas como literatura infantil. Se utiliza en referencia a la literatura infantil centrada en personajes o temas LGBTQ+."},{"@language":"nl","@value":"Geschreven literaire werken voor lezers tot 12 jaar, ook wel bekend als kid lit. Gebruik voor kinderliteratuur die zich richt op LGBTQ+-personages of -thema's."},{"@language":"sv","@value":"Litterära verk för läsare upp till 12 års ålder. Används för barnlitteratur med hbtq+-karaktärer eller teman."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000972"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0003489"},{"@id":"https://homosaurus.org/v5/homoit0003490"},{"@id":"https://homosaurus.org/v5/homoit0003491"},{"@id":"https://homosaurus.org/v5/homoit0003492"},{"@id":"https://homosaurus.org/v5/homoit0003493"},{"@id":"https://homosaurus.org/v5/homoit0003494"},{"@id":"https://homosaurus.org/v5/homoit0003495"},{"@id":"https://homosaurus.org/v5/homoit0003496"},{"@id":"https://homosaurus.org/v5/homoit0003497"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0003498"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2024-07-31"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003822","dc:identifier":"homoit0003822","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ essays"},{"@language":"ja","@value":"LGBTQ+に関するエッセイ"},{"@language":"nl","@value":"LHBTQ+-essays"},{"@language":"sv","@value":"Hbtq+-essäer"}],"skos:altLabel":[{"@language":"en","@value":"Essays (LGBTQ)"},{"@language":"en","@value":"LGBTQ+ papers"},{"@language":"en","@value":"Papers (LGBTQ)"},{"@language":"ja","@value":"エッセイ (LGBTQ)"}],"rdfs:comment":[{"@language":"en","@value":"Short pieces of prose writing, typically analytical or interpretive, from an LGBTQ+ perspective or addressing LGBTQ+ issues."},{"@language":"ja","@value":"LGBTQ+の視点から書かれた、あるいはLGBTQ+の問題を取り上げた、主に分析的または解釈的な短編の散文。"},{"@language":"nl","@value":"Korte stukken proza, meestal analytisch of interpretatief, vanuit een LHBTQ+-perspectief of waarin LHBTQ+-kwesties aan bod komen."},{"@language":"sv","@value":"Korta prosatexter, vanligtvis analytiska eller tolkande, ur ett hbtq+-perspektiv eller som behandlar hbtq+-frågor."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000972"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2024-12-12"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003866","dc:identifier":"homoit0003866","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ people's writings"},{"@language":"nl","@value":"Geschriften van LHBTQ+-personen"},{"@language":"sv","@value":"Hbtq+-personers texter"}],"skos:altLabel":{"@language":"en","@value":"Writings of LGBTQ+ people"},"rdfs:comment":[{"@language":"en","@value":"Written works created by LGBTQ+ people."},{"@language":"nl","@value":"Geschreven werken gemaakt door LHBTQ+-personen."},{"@language":"sv","@value":"Texter skapade av hbtq+-personer."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000972"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0003867"},{"@id":"https://homosaurus.org/v5/homoit0003868"},{"@id":"https://homosaurus.org/v5/homoit0003869"},{"@id":"https://homosaurus.org/v5/homoit0003870"},{"@id":"https://homosaurus.org/v5/homoit0003871"},{"@id":"https://homosaurus.org/v5/homoit0003872"},{"@id":"https://homosaurus.org/v5/homoit0003873"},{"@id":"https://homosaurus.org/v5/homoit0003874"},{"@id":"https://homosaurus.org/v5/homoit0003875"},{"@id":"https://homosaurus.org/v5/homoit0003877"},{"@id":"https://homosaurus.org/v5/homoit0003878"},{"@id":"https://homosaurus.org/v5/homoit0003879"},{"@id":"https://homosaurus.org/v5/homoit0004633"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001723"},{"@id":"https://homosaurus.org/v5/homoit0003876"}],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2008006442"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2025-03-13"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001602","dc:identifier":"homoit0001602","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ literary criticism"},{"@language":"es","@value":"Crítica literaria LGBTQ+"},{"@language":"nl","@value":"LHBTQ+-literaire kritiek"},{"@language":"sv","@value":"Litteraturstudier (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"Literary criticism (LGBTQ)"},{"@language":"es","@value":"Crítica literaria LGBTQ"}],"rdfs:comment":[{"@language":"en","@value":"The study, evaluation, and interpretation of literary works focusing on LGBTQ+ characters or themes; can also include interpretation of literature through the lens and frameworks associated with LGBTQ+ studies."},{"@language":"es","@value":"El estudio, la evaluación y la interpretación de obras literarias centradas en personajes o temas LGBTQ+; también puede incluir la interpretación de la literatura a través del lente y los marcos teóricos asociados con los estudios LGBTQ+."},{"@language":"nl","@value":"De studie, evaluatie en interpretatie van literaire werken gericht op LHBTQ+-personages of thema's; kan ook de interpretatie van literatuur door de lens en kaders van LHBTQ+-studies omvatten."},{"@language":"sv","@value":"Studier, analyser och tolkningar av litterära verk med hbtq+-karaktärer eller teman. Kan även innefatta tolkning av litteratur utifrån teorier inom hbtq+-studier."}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0001603"},{"@id":"https://homosaurus.org/v5/homoit0001604"},{"@id":"https://homosaurus.org/v5/homoit0001605"},{"@id":"https://homosaurus.org/v5/homoit0001606"},{"@id":"https://homosaurus.org/v5/homoit0001607"},{"@id":"https://homosaurus.org/v5/homoit0002466"},{"@id":"https://homosaurus.org/v5/homoit0002483"},{"@id":"https://homosaurus.org/v5/homoit0002493"},{"@id":"https://homosaurus.org/v5/homoit0002513"},{"@id":"https://homosaurus.org/v5/homoit0002542"},{"@id":"https://homosaurus.org/v5/homoit0002749"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000972"},{"@id":"https://homosaurus.org/v5/homoit0001723"},{"@id":"https://homosaurus.org/v5/homoit0002698"},{"@id":"https://homosaurus.org/v5/homoit0003700"},{"@id":"https://homosaurus.org/v5/homoit0003706"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001602"},"dc:replaces":{"@id":"http://homosaurus.org/v2/literaryCriticismLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-03"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002710","dc:identifier":"homoit0002710","skos:prefLabel":[{"@language":"en","@value":"Two-Spirit literature"},{"@language":"es","@value":"Literatura dos espíritus"},{"@language":"nl","@value":"Two-Spirit literatuur"},{"@language":"sv","@value":"Two-spirit-litteratur"}],"skos:altLabel":[{"@language":"en","@value":"2S literature"},{"@language":"en","@value":"Two Spirit literature"},{"@language":"en","@value":"Two Spirited literature"},{"@language":"en","@value":"Two-Spirited literature"},{"@language":"nl","@value":"Two Spirit literatuur"},{"@language":"nl","@value":"Two Spirited literatuur"},{"@language":"nl","@value":"Two-Spirited literatuur"}],"rdfs:comment":[{"@language":"en","@value":"Written literary works about Two-Spirit characters or themes."},{"@language":"es","@value":"Obras literarias escritas sobre la identidad dos espíritus, personajes dos espíritus o temas dos espíritus."},{"@language":"nl","@value":"Geschreven literaire werken over Two-Spirit-personages of -thema's."},{"@language":"sv","@value":"Skrivna litterära verk om Two-spirit-personer eller Two-spirit-teman."}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0001751"},{"@id":"https://homosaurus.org/v5/homoit0002712"},{"@id":"https://homosaurus.org/v5/homoit0003498"},{"@id":"https://homosaurus.org/v5/homoit0003876"},{"@id":"https://homosaurus.org/v5/homoit0003919"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000972"},{"@id":"https://homosaurus.org/v5/homoit0001750"},{"@id":"https://homosaurus.org/v5/homoit0004026"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0002710"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-27"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004018","dc:identifier":"homoit0004018","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ people in literature"},{"@language":"nl","@value":"LHBTQ+-personen in de literatuur"},{"@language":"sv","@value":"Hbtq+-personer i litteraturen"}],"rdfs:comment":[{"@language":"en","@value":"The depiction of LGBTQ+ people in literature."},{"@language":"nl","@value":"Het weergeven van LGBTQ+-personen in de literatuur."},{"@language":"sv","@value":"Skildringen av hbtq+-personer i litteraturen."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0003991"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0004019"},{"@id":"https://homosaurus.org/v5/homoit0004020"},{"@id":"https://homosaurus.org/v5/homoit0004021"},{"@id":"https://homosaurus.org/v5/homoit0004022"},{"@id":"https://homosaurus.org/v5/homoit0004023"},{"@id":"https://homosaurus.org/v5/homoit0004024"},{"@id":"https://homosaurus.org/v5/homoit0004025"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000972"},{"@id":"https://homosaurus.org/v5/homoit0004026"}],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2006003915"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2025-04-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000975","dc:identifier":"homoit0000975","skos:prefLabel":[{"@language":"en","@value":"Locker rooms"},{"@language":"es","@value":"Salas de vestuario"},{"@language":"nl","@value":"Kleedruimtes"},{"@language":"sv","@value":"Omklädningsrum"}],"skos:altLabel":[{"@language":"es","@value":"Salas de lockers"},{"@language":"es","@value":"Salas de casilleros"},{"@language":"es","@value":"Salas de taquillas"}],"rdfs:comment":[{"@language":"en","@value":"Rooms or areas in public or commercial spaces where people change clothes, bathe, and store items or personal belongings. LGBTQ+ people, particularly trans people, are often restricted from using locker rooms under the pretense of public safety."},{"@language":"es","@value":"Habitaciones o áreas en espacios públicos o comerciales donde las personas se cambian de ropa, se bañan y guardan artículos o efectos personales. A las personas LGBTQ+, en particular a las personas trans, a menudo se les restringe el uso de los vestuarios con el pretexto de seguridad pública."},{"@language":"nl","@value":"Kamers of ruimtes in openbare of commerciële ruimtes waar mensen zich omkleden, baden en spullen of persoonlijke bezittingen opbergen. LHBTQ+'ers, met name transgenders, mogen vaak geen gebruik maken van kleedruimtes onder het mom van openbare veiligheid."},{"@language":"sv","@value":"Omklädningsrum i offentliga eller kommersiella miljöer där personer byter om, duschar och förvarar personliga tillhörigheter. Hbtq+-personer, särskilt transpersoner, nekas ofta tillgång till dessa utrymmen med hänvisning till ”säkerhet”."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001141"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001139"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001141"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lockerRooms"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000976","dc:identifier":"homoit0000976","skos:prefLabel":[{"@language":"en","@value":"Love triangles"},{"@language":"es","@value":"Triángulos amorosos"},{"@language":"nl","@value":"Driehoeksverhoudingen"},{"@language":"sv","@value":"Kärlekstrio"}],"skos:altLabel":{"@language":"sv","@value":"Kärlekstriader"},"rdfs:comment":[{"@language":"en","@value":"A scenario in which two people are pursuing or are romantically involved with one person, or in which one person is in a romantic relationship while pursuing or becoming involved with another. Often, the two individuals dating, pursuing, or being pursued by the same person are depicted as rivals competing for a monogamous romantic relationship. Love triangles should not be confused with triads, throuples, or other forms of polyamorous relationships."},{"@language":"es","@value":"Relaciones poliamorosas que involucran a tres personas en diversos arreglos."},{"@language":"nl","@value":"Een situatie waarin twee mensen een relatie hebben met één persoon, of waarin één persoon een romantische relatie heeft terwijl hij of zij een relatie probeert aan te gaan met een ander. Vaak worden de twee personen die met dezelfde persoon daten, hem of haar proberen te veroveren, of door dezelfde persoon worden begeerd, afgebeeld als rivalen die strijden om een ​​monogame relatie. Driehoeksverhoudingen moeten niet worden verward met triades, throuples of andere vormen van poly-amoreuze relaties."},{"@language":"sv","@value":"Polyamorösa relationer som involverar tre personer i olika konstellationer."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001302"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh96008285"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001237"},"dc:replaces":{"@id":"http://homosaurus.org/v2/loveTriangles"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000977","dc:identifier":"homoit0000977","skos:prefLabel":[{"@language":"en","@value":"Lubricants"},{"@language":"es","@value":"Lubricantes"},{"@language":"nl","@value":"Glijmiddelen"},{"@language":"sv","@value":"Glidmedel"}],"rdfs:comment":[{"@language":"en","@value":"Liquids or gels used during sexual activity, typically to ease the act of penetration by a penis or a sex toy."},{"@language":"es","@value":"Líquidos o geles utilizados durante la actividad sexual, generalmente para facilitar el acto de penetración de un pene o un juguete sexual."},{"@language":"nl","@value":"Vloeistoffen of gels die worden gebruikt tijdens seksuele activiteit, meestal met als doel de penetratie door een penis of een seksspeeltje te vergemakkelijken."},{"@language":"sv","@value":"Vätskor eller geler som används vid sexuell aktivitet, vanligtvis för att underlätta penetration med penis eller sexleksak."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001266"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85078720"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001266"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lubricants"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002654","dc:identifier":"homoit0002654","skos:prefLabel":[{"@language":"haw","@value":"Māhūkāne"},{"@language":"es","@value":"Māhūkāne"},{"@language":"nl","@value":"Māhūkāne"},{"@language":"sv","@value":"Māhūkāne"}],"skos:altLabel":[{"@language":"haw","@value":"Mahukane"},{"@language":"es","@value":"Mahukane"}],"rdfs:comment":[{"@language":"en","@value":"A term coined by the Kānaka Maoli (Native Hawaiian) queer community in the early 2000s that blends the term Māhū (for third gender indigenous people of Hawai'i and Tahiti who blend genders and often hold spiritual roles) and kāne (man)."},{"@language":"es","@value":"Término acuñado por la comunidad queer kānaka maoli (nativos hawaianos) a principios de la década del 2000 que mezcla el término \"māhū\" (para las personas indígenas del tercer género de Hawái y Tahití que mezclan géneros y a menudo desempeñan funciones espirituales) y \"kāne\" (hombre)."},{"@language":"nl","@value":"Een term die begin jaren 2000 werd bedacht door de Kānaka Maoli (Native Hawaiian) queer gemeenschap, waarin de term Māhū (voor de inheemse bevolking van het derde geslacht van Hawai'i en Tahiti, waarbij genders vermengd worden en die vaak een spirituele rol bekleedt) en kāne (man) wordt gecombineerd."},{"@language":"sv","@value":"Term som myntades av queera Kānaka Maoli (ur-hawaiianer) i början av 2000-talet. Den kombinerar Māhū (för tredje kön-urfolkspersoner i Hawai‘i och Tahiti) med kāne (man)."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000979"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-26"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002655","dc:identifier":"homoit0002655","skos:prefLabel":[{"@language":"haw","@value":"Māhūwahine"},{"@language":"es","@value":"Māhūwahine"},{"@language":"nl","@value":"Māhūwahine"},{"@language":"sv","@value":"Māhūwahine"}],"skos:altLabel":[{"@language":"haw","@value":"Mahuwahine"},{"@language":"es","@value":"Mahuwahine"}],"rdfs:comment":[{"@language":"en","@value":"A term coined by the Kānaka Maoli (Native Hawaiian) queer community in the early 2000s that blends the term Māhū (for third gender indigenous people of Hawai'i and Tahiti who blend genders and often hold spiritual roles) and wahine (woman)."},{"@language":"es","@value":"Término acuñado por la comunidad queer kānaka maoli (nativos hawaianos) a principios de la década del 2000 que mezcla el término \"māhū\" (para las personas indígenas del tercer género de Hawái y Tahití que mezclan géneros y a menudo desempeñan funciones espirituales) y \"wahine\" (mujer)."},{"@language":"nl","@value":"Een term die begin jaren 2000 werd bedacht door de Kānaka Maoli (Native Hawaiian) queer gemeenschap, waarin de term Māhū (voor de inheemse bevolking van het derde geslacht van Hawai'i en Tahiti, waarbij genders worden vermengd en die vaak een spirituele rol bekleedt) en wahine (vrouw) wordt gecombineerd."},{"@language":"sv","@value":"Term som myntades av queera Kānaka Maoli (ur-hawaiianer) i början av 2000-talet. Den kombinerar Māhū (för tredje kön-urfolkspersoner i Hawai‘i och Tahiti) med wahine (kvinna)."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000979"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-26"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003231","dc:identifier":"homoit0003231","skos:prefLabel":[{"@language":"en","@value":"Pregnant māhū"},{"@language":"es","@value":"Māhū embarazados"},{"@language":"nl","@value":"Zwangere māhū"},{"@language":"sv","@value":"Gravida māhū"}],"skos:altLabel":[{"@language":"en","@value":"Pregnant mahu"},{"@language":"es","@value":"Māhū embarazadas"}],"rdfs:comment":[{"@language":"en","@value":"Pregnant people who are māhū."},{"@language":"es","@value":"Personas embarazadas que son māhū."},{"@language":"nl","@value":"Zwangere personen die māhū zijn."},{"@language":"sv","@value":"Gravida personer som är māhū."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000979"},{"@id":"https://homosaurus.org/v5/homoit0003364"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2024-05-24"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003256","dc:identifier":"homoit0003256","skos:prefLabel":[{"@language":"en","@value":"Māhū teachers"},{"@language":"es","@value":"Docentes mahu"},{"@language":"nl","@value":"Māhū leraren"},{"@language":"sv","@value":"Māhū-lärare"}],"skos:altLabel":[{"@language":"en","@value":"Mahu teachers"},{"@language":"es","@value":"Profesoras mahu"},{"@language":"es","@value":"Profesores mahu"}],"rdfs:comment":[{"@language":"en","@value":"Teachers who are Māhū."},{"@language":"es","@value":"Docentes o profesores que son mahu."},{"@language":"nl","@value":"Leraren die Māhū zijn."},{"@language":"sv","@value":"Lärare som identifierar sig som Māhū."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000979"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0003247"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2024-05-24"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003762","dc:identifier":"homoit0003762","skos:prefLabel":[{"@language":"en","@value":"Māhū sex workers"},{"@language":"nl","@value":"Māhū sekswerkers"},{"@language":"sv","@value":"Māhū-sexarbetare"}],"skos:altLabel":[{"@language":"en","@value":"Mahu sex workers"},{"@language":"en","@value":"Māhū prostitutes"},{"@language":"en","@value":"Mahu prostitutes"},{"@language":"en","@value":"Māhū prostitution"},{"@language":"en","@value":"Mahu prostitution"},{"@language":"en","@value":"Māhū sex work"},{"@language":"en","@value":"Mahu sex work"},{"@language":"nl","@value":"Mahu prostitué(e)s"},{"@language":"nl","@value":"Mahu sekswerk"},{"@language":"nl","@value":"Mahu sekswerkers"},{"@language":"nl","@value":"Māhū prostitutie"},{"@language":"nl","@value":"Māhū prostitué(e)s"},{"@language":"nl","@value":"Māhū sekswerk"}],"rdfs:comment":[{"@language":"en","@value":"Māhū who receive money or goods in exchange for sexual services, performances, or companionship. Use to describe Māhū working across the broad spectrum of sex work."},{"@language":"nl","@value":"Māhū die geld of goederen ontvangen in ruil voor seksuele diensten, optredens of gezelschap. Wordt gebruikt om Māhū te beschrijven die werkzaam zijn in het brede spectrum van sekswerk."},{"@language":"sv","@value":"Māhū-personer som tar emot pengar eller varor i utbyte mot sexuella handlingar, framträdanden eller sällskap. Används för att beskriva māhū-personer som är verksamma inom det breda spektrumet av sexarbete. Vissa anser termen sexarbetare som kränkade och politiserad, medan andra identifierar sig med den. Se även \"Māhū-personer i prostitution\"."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000979"},{"@id":"https://homosaurus.org/v5/homoit0003758"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001277"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-30"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001959","dc:identifier":"homoit0001959","skos:prefLabel":[{"@language":"en","@value":"Kānaka Maoli transgender people"},{"@language":"es","@value":"Personas transgénero kānaka maoli"},{"@language":"nl","@value":"Kānaka Maoli transgender personen"},{"@language":"sv","@value":"Transpersoner som är Kānaka Maoli"}],"skos:altLabel":[{"@language":"en","@value":"Indigenous Hawaiian transgender people"},{"@language":"en","@value":"Native Hawaiian transgender people"},{"@language":"en","@value":"Transgender Indigenous Hawaiians"},{"@language":"en","@value":"Transgender Kānaka Maoli"},{"@language":"en","@value":"Transgender Kānaka ʻŌiwi"},{"@language":"en","@value":"Transgender Native Hawaiians"},{"@language":"es","@value":"Personas kānaka maoli transgénero"},{"@language":"nl","@value":"Transgender Kānaka Maoli"}],"rdfs:comment":[{"@language":"en","@value":"Transgender people who are part of the Indigenous people of Mokupuni o Hawai‘i, or the Hawaiian Islands; only use to refer to people who identify as Kanaka Maoli and transgender."},{"@language":"es","@value":"Personas transgénero que pertenecen al pueblo indígena mokupuni o hawai‘i, o a las islas hawaianas. Utilícese únicamente para describir a las personas que se identifiquen como kānaka maoli."},{"@language":"nl","@value":"Transgender personen die deel uitmaken van de inheemse bevolking van Mokupuni o Hawai'i of de Hawaiiaanse eilanden; alleen gebruiken om te verwijzen naar mensen die zich identificeren als Kānaka Maoli"},{"@language":"sv","@value":"Transpersoner som tillhör det ursprungliga folket på Hawai‘i (Mokupuni o Hawai‘i). Används endast för personer som identifierar sig som Kānaka Maoli och som är transpersoner."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001955"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000979"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-05-11"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001498","dc:identifier":"homoit0001498","skos:prefLabel":[{"@language":"en","@value":"Wacking off"},{"@language":"es","@value":"Wacking off"},{"@language":"nl","@value":"Afrukken"},{"@language":"sv","@value":"Wacking off"}],"skos:altLabel":[{"@language":"es","@value":"Haciendo una paja"},{"@language":"es","@value":"Hacerse una puñeta"}],"rdfs:comment":[{"@language":"en","@value":"Slang term for masturbation that is commonly used in the United States."},{"@language":"es","@value":"Término de la jerga para la masturbación, que se usa comúnmente en los Estados Unidos."},{"@language":"nl","@value":"Straattaal voor masturbatie"},{"@language":"sv","@value":"Slangterm för onani som är vanlig i USA."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000988"},{"@id":"https://homosaurus.org/v5/homoit0001000"},{"@id":"https://homosaurus.org/v5/homoit0001109"}],"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0001500"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001267"},"dc:replaces":{"@id":"http://homosaurus.org/v2/wackingOff"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001500","dc:identifier":"homoit0001500","skos:prefLabel":[{"@language":"en","@value":"Wanking"},{"@language":"es","@value":"Wanking"},{"@language":"nl","@value":"Aftrekken"},{"@language":"sv","@value":"Wanking"}],"skos:altLabel":[{"@language":"es","@value":"Haciendo una paja"},{"@language":"es","@value":"Hacerse una puñeta"}],"rdfs:comment":[{"@language":"en","@value":"Slang term for masturbation commonly used in the United Kingdom and Ireland; typically refers to the manual stimulation of the penis. "},{"@language":"es","@value":"Término de la jerga para la masturbación, comúnmente utilizado en el Reino Unido e Irlanda; normalmente se refiere a la estimulación manual del pene."},{"@language":"nl","@value":"Straattaal voor masturbatie; verwijst meestal naar de handmatige stimulatie van de penis."},{"@language":"sv","@value":"Slangterm för onani som är vanlig i Storbritannien och Irland. Avser oftast manuell stimulering av penis."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000988"},{"@id":"https://homosaurus.org/v5/homoit0001109"},{"@id":"https://homosaurus.org/v5/homoit0001498"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001267"},"dc:replaces":{"@id":"http://homosaurus.org/v2/wanking"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000994","dc:identifier":"homoit0000994","skos:prefLabel":[{"@language":"en","@value":"Married people"},{"@language":"es","@value":"Personas casadas"},{"@language":"nl","@value":"Gehuwde personen"},{"@language":"sv","@value":"Gifta personer"}],"rdfs:comment":[{"@language":"en","@value":"Individuals who are currently married, or part of a legal union involving two or more people in a personal relationship that may or may not grant certain economic, legal, and social rights."},{"@language":"es","@value":"Personas que actualmente están casadas o forman parte de una unión legal entre dos o más personas en una relación personal que puede o no otorgar ciertos derechos económicos, legales y sociales."},{"@language":"nl","@value":"Personen die momenteel getrouwd zijn, of deel uitmaken van een wettelijke verbintenis waarbij twee of meer mensen een persoonlijke relatie hebben die al dan niet bepaalde economische, wettelijke en sociale rechten verleent."},{"@language":"sv","@value":"Personer som är gifta eller som ingår i en juridisk samlevnad med två eller fler personer, där vissa ekonomiska, juridiska eller sociala rättigheter kan vara knutna till relationen."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000989"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85081522"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000973"},"dc:replaces":{"@id":"http://homosaurus.org/v2/marriedPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001483","dc:identifier":"homoit0001483","skos:prefLabel":[{"@language":"en","@value":"Unmarried couples"},{"@language":"es","@value":"Parejas no casadas"},{"@language":"nl","@value":"Niet-gehuwde paren"},{"@language":"sv","@value":"Ogifta par"}],"rdfs:comment":[{"@language":"en","@value":"Romantic and/or sexual partnerships of two people who are unmarried."},{"@language":"es","@value":"Parejas románticas y/o sexuales de dos personas que no están casadas."},{"@language":"nl","@value":"Romantische en/of seksuele partnerschappen van ongehuwde personen."},{"@language":"sv","@value":"Romantiska och/eller sexuella relationer mellan två personer som inte är gifta."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000989"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85141186"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000973"},"dc:replaces":{"@id":"http://homosaurus.org/v2/unmarriedCouples"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001504","dc:identifier":"homoit0001504","skos:prefLabel":[{"@language":"en","@value":"Widowed people"},{"@language":"es","@value":"Personas enviudadas"},{"@language":"nl","@value":"Weduwen en weduwnaars"},{"@language":"sv","@value":"Änkor och änklingar"}],"skos:altLabel":[{"@language":"en","@value":"Widowers"},{"@language":"en","@value":"Widows"},{"@language":"es","@value":"Viudas"},{"@language":"es","@value":"Viudos"},{"@language":"nl","@value":"Weduwnaars"},{"@language":"sv","@value":"Efterlevande partners"},{"@language":"sv","@value":"Änkefolk"},{"@language":"sv","@value":"Änklingar"},{"@language":"sv","@value":"Änkor"}],"rdfs:comment":[{"@language":"en","@value":"People whose spouses or partners have died."},{"@language":"es","@value":"Personas cuyos cónyuges o parejas hayan fallecido."},{"@language":"nl","@value":"Personen wiens echtgenoten of partners zijn overleden."},{"@language":"sv","@value":"Personer vars makar eller partners har avlidit."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000989"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000973"},"dc:replaces":{"@id":"http://homosaurus.org/v2/widowedPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000991","dc:identifier":"homoit0000991","skos:prefLabel":[{"@language":"en","@value":"Marriage certificates"},{"@language":"es","@value":"Certificados de matrimonio"},{"@language":"fr","@value":"Certificats de mariage"},{"@language":"nl","@value":"Huwelijksakten"},{"@language":"sv","@value":"Vigselbevis"}],"rdfs:comment":[{"@language":"en","@value":"Government-issued documents that serve as official records of marriages; can be used in reference to LGBTQ+ people's marriage certificates or their efforts to acquire marriage certificates."},{"@language":"es","@value":"Documentos emitidos por el gobierno que sirven como registros oficiales de matrimonios; se puede utilizar en referencia a los certificados de matrimonio de personas LGBTQ+ o sus esfuerzos por adquirir certificados de matrimonio."},{"@language":"fr","@value":"Documents délivrés par le gouvernement qui servent d'enregistrement officiel des mariages; peut être utilisé en référence aux certificats de mariage des personnes LGBTQ+ ou à leurs efforts pour obtenir des certificats de mariage."},{"@language":"nl","@value":"Door de overheid uitgegeven documenten die dienen als officiële registers van huwelijken; kan worden gebruikt met betrekking tot de huwelijksakten van LHBTQ+-ers of hun pogingen om huwelijksakten te verkrijgen"},{"@language":"sv","@value":"Myndighetsutfärdade dokument som fungerar som officiella bevis på giftermål. Används för att beskriva hbtq+-personers vigselbevis eller deras kamp för att få sådana erkända."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000990"},{"@id":"https://homosaurus.org/v5/homoit0001053"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000992"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000973"},"dc:replaces":{"@id":"http://homosaurus.org/v2/marriageCertificates"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000993","dc:identifier":"homoit0000993","skos:prefLabel":[{"@language":"en","@value":"Marriage licenses"},{"@language":"es","@value":"Licencias de matrimonio"},{"@language":"nl","@value":"Huwelijkslicenties"},{"@language":"sv","@value":"Äktenskapslicens"}],"rdfs:comment":[{"@language":"en","@value":"Legal documents issued by a religious organization or local authority that authorizes marriage. In some jurisdictions a license is necessary to legalize a union, but this varies by locale."},{"@language":"es","@value":"Documentos legales emitidos por una organización religiosa o autoridad local que autoriza el matrimonio. En algunas jurisdicciones es necesaria una licencia para legalizar una unión, pero esto varía según la localidad."},{"@language":"nl","@value":"Juridisch document uitgegeven door een religieuze organisatie of lokale overheid die het huwelijk autoriseert."},{"@language":"sv","@value":"Juridiska dokument som utfärdas av trossamfund eller myndigheter och som ger tillstånd att ingå äktenskap. I vissa jurisdiktioner krävs ett sådant tillstånd för att äktenskapet ska vara giltigt. Äktenskapslicenser förekommer inte i Sverige."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000990"},{"@id":"https://homosaurus.org/v5/homoit0001053"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000992"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85081510"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000973"},"dc:replaces":{"@id":"http://homosaurus.org/v2/marriageLicenses"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004411","dc:identifier":"homoit0004411","skos:prefLabel":[{"@language":"en","@value":"Interracial LGBTQ+ marriage"},{"@language":"nl","@value":"Interraciaal LHBTQ+-huwelijk"},{"@language":"sv","@value":"Interrasiala hbtq+-äktenskap"}],"skos:altLabel":{"@language":"en","@value":"Mixed-race LGBTQ+ marriage"},"rdfs:comment":[{"@language":"en","@value":"Marriages between LGBTQ+ people who do not identify with the same race or racialized ethnicity. Only use for marriages in which the individuals identify as being in an interracial LGBTQ+ marriage."},{"@language":"nl","@value":"Huwelijken tussen LHBTQ+-personen die zich niet identificeren met hetzelfde ras of dezelfde geracialiseerde etniciteit. Uitsluitend te gebruiken voor huwelijken waarbij de partners zich identificeren als onderdeel van een interraciaal LHBTQ+-huwelijk."},{"@language":"sv","@value":"Äktenskap mellan hbtq+-personer som inte identifierar sig med samma rasiala tillhörighet eller etnicitet. Används endast för äktenskap där personerna identifierar sig som att vara i ett interrasialt hbtq+-äktenskap."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000990"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000973"},"dc:issued":{"@type":"xsd:date","@value":"2026-02-24"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001184","dc:identifier":"homoit0001184","skos:prefLabel":[{"@language":"en","@value":"Queer dominants"},{"@language":"es","@value":"Dominantes queer"},{"@language":"nl","@value":"Queer dominanten"},{"@language":"sv","@value":"Dominanta queera personer"}],"skos:altLabel":[{"@language":"en","@value":"Queer masters"},{"@language":"es","@value":"Amos queer"}],"rdfs:comment":[{"@language":"en","@value":"Queer people who are part of the BDSM scene and assume the dominant role in sexual relationships with a dominant/submissive dynamic."},{"@language":"es","@va