:"https://homosaurus.org/v5/homoit0000208"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000123"},{"@id":"https://homosaurus.org/v5/homoit0000365"},{"@id":"https://homosaurus.org/v5/homoit0000463"},{"@id":"https://homosaurus.org/v5/homoit0000714"},{"@id":"https://homosaurus.org/v5/homoit0001151"},{"@id":"https://homosaurus.org/v5/homoit0001384"},{"@id":"https://homosaurus.org/v5/homoit0002335"},{"@id":"https://homosaurus.org/v5/homoit0002935"},{"@id":"https://homosaurus.org/v5/homoit0003558"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000095"},{"@id":"https://homosaurus.org/v5/homoit0001254"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2016000681"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/africanAmericansLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000208","dc:identifier":"homoit0000208","skos:prefLabel":[{"@language":"en","@value":"Black LGBTQ+ people"},{"@language":"es","@value":"Personas LGBTQ+ negras"},{"@language":"de","@value":"Schwarze LGBTQ+-Personen"},{"@language":"nl","@value":"Zwarte LHBTQ+-personen"},{"@language":"sv","@value":"Svarta hbtq+-personer"}],"skos:altLabel":[{"@language":"en","@value":"Black people (LGBTQ)"},{"@language":"en","@value":"LGBTQ+ Black people"},{"@language":"es","@value":"Personas negras LGBTQ+"},{"@language":"es","@value":"Personas negras (LGBTQ)"},{"@language":"nl","@value":"Zwarte personen (LHBTQ+)"}],"rdfs:comment":[{"@language":"en","@value":"Black people who are also LGBTQ+; do not use for people of color broadly; follow the individual's preference for Black or African American whenever possible."},{"@language":"es","@value":"Personas negras que son LGBTQ+. Utilícese únicamente para personas que seautoidentificancomo negras. Siga la preferencia del individuo para el uso de afroamericanos o negros siempre que sea posible."},{"@language":"de","@value":"Schwarze Menschen, die auch LGBTQ+ sind. Nicht generell für People of Color zu verwenden. Nach Möglichkeit der Präferenz der Person für \"Afroamerikanisch\" oder \"Schwarz\" folgen."},{"@language":"nl","@value":"Zwarte mensen die ook LHBTQ+ zijn; niet algemeen gebruiken voor personen van kleur. Volg waar mogelijk de voorkeur van de persoon voor een Afrikaanse diaspora-identiteit of een zwarte identiteit."},{"@language":"sv","@value":"Svarta personer som också är hbtq+. Används inte för icke-vita generellt. Följ individens preferens för att använda svart eller diasporaidentitet som t.ex. afroeuropé när det är möjligt."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001101"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000015"},{"@id":"https://homosaurus.org/v5/homoit0000016"},{"@id":"https://homosaurus.org/v5/homoit0000017"},{"@id":"https://homosaurus.org/v5/homoit0000018"},{"@id":"https://homosaurus.org/v5/homoit0000019"},{"@id":"https://homosaurus.org/v5/homoit0000135"},{"@id":"https://homosaurus.org/v5/homoit0000477"},{"@id":"https://homosaurus.org/v5/homoit0000726"},{"@id":"https://homosaurus.org/v5/homoit0001163"},{"@id":"https://homosaurus.org/v5/homoit0001396"},{"@id":"https://homosaurus.org/v5/homoit0001782"},{"@id":"https://homosaurus.org/v5/homoit0002334"},{"@id":"https://homosaurus.org/v5/homoit0002764"},{"@id":"https://homosaurus.org/v5/homoit0003400"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001928"},{"@id":"https://homosaurus.org/v5/homoit0002376"},{"@id":"https://homosaurus.org/v5/homoit0002398"},{"@id":"https://homosaurus.org/v5/homoit0002399"}],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2013002417"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/blackPeopleLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000123","dc:identifier":"homoit0000123","skos:prefLabel":[{"@language":"en","@value":"African American bisexual people"},{"@language":"es","@value":"Personas bisexuales afroamericanas"},{"@language":"de","@value":"Afroamerikanische bisexuelle Personen"},{"@language":"nl","@value":"Afrikaans-Amerikaanse biseksuele personen"},{"@language":"sv","@value":"Bisexuella afroamerikaner"}],"skos:altLabel":[{"@language":"en","@value":"Bisexual African American people"},{"@language":"en","@value":"Bisexual African Americans"},{"@language":"es","@value":"Afroamericanos bisexuales"},{"@language":"es","@value":"Bisexuales afroamericanos"},{"@language":"es","@value":"Afroamericanas bisexuales"},{"@language":"es","@value":"Bisexuales afroamericanas"},{"@language":"de","@value":"Bisexuelle afroamerikanische Personen"},{"@language":"de","@value":"Bisexuelle Afroamerikaner:innen"}],"rdfs:comment":[{"@language":"en","@value":"Bisexual people of African descent born in the United States or bisexual people born in African countries who live in or have a strong connection to the United States. Use for individuals who self-identity as African American. Follow the individual’s preference for African American or Black whenever possible."},{"@language":"es","@value":"Personas bisexuales de ascendencia africana nacidas en los Estados Unidos o personas bisexuales nacidas en países africanos que viven o tienen una conexión fuerte con los Estados Unidos. Utilícese para personas que se autoidentifiquen como afroamericanas."},{"@language":"de","@value":"Bisexuelle Personen afrikanischer Abstammung, die in den Vereinigten Staaten geboren sind, oder bisexuelle Menschen, die in afrikanischen Ländern geboren sind und in den Vereinigten Staaten leben oder eine starke Verbindung zu ihnen haben. Verwendung für Personen, die sich selbst als Afroamerikaner bezeichnen. Befolgen Sie die Präferenz der Person für Afroamerikaner oder Schwarze, wann immer möglich."},{"@language":"nl","@value":"Biseksuele personen van Afrikaanse afkomst geboren in de Verenigde Staten of biseksuele personen geboren in Afrikaanse landen die wonen in of een sterke band hebben met de Verenigde Staten. Gebruik voor personen die zichzelf identificeren als Afro-Amerikaan. Volg waar mogelijk de voorkeur van de persoon voor Afro-Amerikaans of zwart."},{"@language":"sv","@value":"Bisexuella personer av afrikansk härkomst födda i USA eller bisexuella personer födda i afrikanska länder som bor i eller har en stark anknytning till USA. Används för individer som identifierar sig som afroamerikaner. Följ individens preferens för afroamerikan eller svart när det är möjligt."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000015"},{"@id":"https://homosaurus.org/v5/homoit0000135"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000365"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2003006883"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualAfricanAmericans"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000365","dc:identifier":"homoit0000365","skos:prefLabel":[{"@language":"en","@value":"Down-low"},{"@language":"de","@value":"Down-Low"},{"@language":"es","@value":"Down-low (Cultura gay)"},{"@language":"nl","@value":"Down-low"},{"@language":"sv","@value":"Down-low"}],"skos:altLabel":[{"@language":"es","@value":"Down-low"},{"@language":"es","@value":"DL"},{"@language":"es","@value":"Down low"},{"@language":"sv","@value":"DL"}],"rdfs:comment":[{"@language":"en","@value":"African American slang term that describes a subculture of Black men who identify as heterosexual but have sex with men."},{"@language":"de","@value":"Afroamerikanischer Slangbegriff, der eine Subkultur beschreibt, in der sich schwarze Männer als heterosexuell identifizieren, aber Sex mit anderen Männern haben."},{"@language":"es","@value":"Término de la jerga afroamericana que describe una subcultura de hombres negros que se autoidentifican como heterosexuales pero tienen relaciones sexuales con hombres."},{"@language":"nl","@value":"Afro-Amerikaanse argot-term die verwijst naar een subcultuur van zwarte mannen die zich meestal identificeren als heteroseksueel, maar die seks hebben met mannen"},{"@language":"sv","@value":"Afroamerikansk slangterm som beskriver en subkultur av svarta män som identifierar sig som heterosexuella men har sex med män."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000015"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000123"},{"@id":"https://homosaurus.org/v5/homoit0000285"},{"@id":"https://homosaurus.org/v5/homoit0000286"},{"@id":"https://homosaurus.org/v5/homoit0000463"},{"@id":"https://homosaurus.org/v5/homoit0001009"},{"@id":"https://homosaurus.org/v5/homoit0001261"},{"@id":"https://homosaurus.org/v5/homoit0001783"},{"@id":"https://homosaurus.org/v5/homoit0001785"},{"@id":"https://homosaurus.org/v5/homoit0001786"},{"@id":"https://homosaurus.org/v5/homoit0001787"},{"@id":"https://homosaurus.org/v5/homoit0001788"},{"@id":"https://homosaurus.org/v5/homoit0002278"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/downLow"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000463","dc:identifier":"homoit0000463","skos:prefLabel":[{"@language":"en","@value":"African American gay men"},{"@language":"es","@value":"Hombres gay afroamericanos"},{"@language":"de","@value":"Afroamerikanische schwule Männer"},{"@language":"nl","@value":"Afrikaans-Amerikaanse homomannen"},{"@language":"sv","@value":"Afroamerikanska bögar"}],"skos:altLabel":[{"@language":"en","@value":"Gay African American people"},{"@language":"en","@value":"Gay African Americans"},{"@language":"es","@value":"Afroamericanos gay||"},{"@language":"de","@value":"Schwule afroamerikanische Männer"},{"@language":"de","@value":"Schwule Afroamerikaner"}],"rdfs:comment":[{"@language":"en","@value":"Gay men of African descent born in the United States or gay men born in African countries who live in or have a strong connection to the United States. Use for individuals who self-identity as African American. Follow the individual’s preference for African American or Black whenever possible."},{"@language":"es","@value":"Hombres gay de ascendencia africana nacidos en los Estados Unidos o hombres gay nacidos en países africanos que viven o tienen una conexión fuerte con los Estados Unidos. Utilícese para personas que se autoidentifiquen como afroamericanas."},{"@language":"de","@value":"Schwule Männer afrikanischer Abstammung, die in den Vereinigten Staaten geboren sind, oder schwule Männer, die in afrikanischen Ländern geboren sind und in den Vereinigten Staaten leben oder eine starke Verbindung zu dem Land haben. Nur für Personen verwenden, die sich selbst als afroamerikanisch bezeichnen."},{"@language":"nl","@value":"Homomannen van Afrikaanse afkomst, geboren in de Verenigde Staten of homomannen geboren in Afrikaanse landen die wonen in of een sterke band hebben met de Verenigde Staten. Gebruik voor personen die zichzelf identificeren als Afrikaans-Amerikaan. Volg waar mogelijk de voorkeur van het individu voor Afrikaans-Amerikaans of zwart."},{"@language":"sv","@value":"Bögar av afrikansk härkomst födda i USA eller bögar födda i afrikanska länder som bor i eller har en stark anknytning till USA. Används för individer som identifierar sig som afroamerikaner. Följ individens preferens för afroamerikan eller svart när det är möjligt."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000015"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000365"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2003003398"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayAfricanAmericans"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000714","dc:identifier":"homoit0000714","skos:prefLabel":[{"@language":"en","@value":"African American lesbians"},{"@language":"es","@value":"Lesbianas afroamericanas"},{"@language":"de","@value":"Afroamerikanische Lesben"},{"@language":"nl","@value":"Afrikaans-Amerikaanse lesbische vrouwen"},{"@language":"sv","@value":"Lesbiska afroamerikaner"}],"skos:altLabel":[{"@language":"en","@value":"Lesbian African Americans"},{"@language":"es","@value":"Afroamericanas lesbianas"},{"@language":"de","@value":"Lesbische Afroamerikaner:innen"}],"rdfs:comment":[{"@language":"en","@value":"Lesbians of African descent born in the United States or lesbians born in African countries who live in or have a strong connection to the United States. Use for individuals who self-identity as African American. Follow the individual’s preference for African American or Black whenever possible."},{"@language":"es","@value":"Lesbianas de ascendencia africana nacidas en los Estados Unidos o nacidas en países africanos que viven o tienen una fuerte conexión con los Estados Unidos. Utilícese para personas que se autoidentifiquen como afroamericanas."},{"@language":"de","@value":"Lesben afrikanischer Abstammung, die in den Vereinigten Staaten geboren sind, oder Lesben, die in afrikanischen Ländern geboren sind und in den Vereinigten Staaten leben oder eine starke Verbindung zu dem Land haben. Nur für Personen verwenden, die sich selbst als afroamerikanisch bezeichnen."},{"@language":"nl","@value":"Lesbische vrouwen van Afrikaanse afkomst, geboren in de Verenigde Staten of lesbische vrouwen geboren in Afrikaanse landen die wonen in of een sterke band hebben met de Verenigde Staten. Gebruik voor personen die zichzelf identificeren als Afrikaans-Amerikaan. Volg waar mogelijk de voorkeur van het individu voor Afrikaans-Amerikaans of zwart."},{"@language":"sv","@value":"Lesbiska av afrikansk härkomst födda i USA eller lesbiska födda i afrikanska länder som bor i eller har en stark anknytning till USA. Används för individer som identifierar sig som afroamerikaner. Följ individens preferens för afroamerikan eller svart när det är möjligt."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000015"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85001859"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianAfricanAmericans"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001151","dc:identifier":"homoit0001151","skos:prefLabel":[{"@language":"en","@value":"African American queer people"},{"@language":"es","@value":"Personas queer afroamericanas"},{"@language":"de","@value":"Afroamerikanische queere Personen"},{"@language":"nl","@value":"Afrikaans-Amerikaanse queer personen"},{"@language":"sv","@value":"Queera afroamerikaner"}],"skos:altLabel":[{"@language":"en","@value":"Queer African American people"},{"@language":"en","@value":"Queer African Americans"},{"@language":"es","@value":"Afroamericanos queer"},{"@language":"es","@value":"Queers afroamericanos"},{"@language":"es","@value":"Afroamericanas queer"},{"@language":"es","@value":"Queers afroamericanas"},{"@language":"de","@value":"Queere afroamerikanische Personen"},{"@language":"de","@value":"Queere Afroamerikaner:innen"}],"rdfs:comment":[{"@language":"en","@value":"Queer people of African descent born in the United States or queer people born in African countries who live in or have a strong connection to the United States. Use for individuals who self-identity as African American. Follow the individual’s preference for African American or Black whenever possible."},{"@language":"es","@value":"Personas queer de ascendencia africana nacidas en los Estados Unidos o personas queer nacidas en países africanos que viven o tienen una conexión fuerte con los Estados Unidos. Utilícese para personas que se autoidentifiquen como afroamericanas."},{"@language":"de","@value":"Queere Personen afrikanischer Abstammung, die in den Vereinigten Staaten geboren sind, oder queere Personen, die in afrikanischen Ländern geboren sind und in den Vereinigten Staaten leben oder eine starke Verbindung zu dem Land haben. Nur für Personen verwenden, die sich selbst als afroamerikanisch bezeichnen."},{"@language":"nl","@value":"Queer personen van Afrikaanse afkomst, geboren in de Verenigde Staten of queer personen geboren in Afrikaanse landen die wonen in of een sterke band hebben met de Verenigde Staten. Gebruik voor personen die zichzelf identificeren als Afrikaans-Amerikaan. Volg waar mogelijk de voorkeur van het individu voor Afrikaans-Amerikaans of zwart."},{"@language":"sv","@value":"Queera personer av afrikansk härkomst födda i USA eller queera personer födda i afrikanska länder som bor i eller har en stark anknytning till USA. Används för individer som identifierar sig som afroamerikaner. Följ individens preferens för afroamerikan eller svart när det är möjligt."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000015"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerAfricanAmericans"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001384","dc:identifier":"homoit0001384","skos:prefLabel":[{"@language":"en","@value":"African American transgender people"},{"@language":"es","@value":"Personas transgénero afroamericanas"},{"@language":"de","@value":"Afroamerikanische trans Personen"},{"@language":"nl","@value":"Afrikaans-Amerikaanse transgender personen"},{"@language":"sv","@value":"Afroamerikanska transpersoner"}],"skos:altLabel":[{"@language":"en","@value":"Transgender African American people"},{"@language":"en","@value":"Transgender African Americans"},{"@language":"es","@value":"Afroamericanos transgénero"},{"@language":"es","@value":"Afroamericanas transgénero"},{"@language":"de","@value":"Trans afroamerikanische Personen"},{"@language":"de","@value":"Trans Afroamerikaner:innen"}],"rdfs:comment":[{"@language":"en","@value":"Transgender people of African descent born in the United States or transgender people born in African countries who live in or have a strong connection to the United States. Use for individuals who self-identity as African American. Follow the individual’s preference for African American or Black whenever possible."},{"@language":"es","@value":"Personas transgénero de ascendencia africana nacidas en los Estados Unidos o personas transgénero nacidas en países africanos que viven o tienen una conexión fuerte con los Estados Unidos. Utilícese para personas que se autoidentifiquen como afroamericanas."},{"@language":"de","@value":"Trans Personen afrikanischer Abstammung, die in den Vereinigten Staaten geboren sind, oder trans Personen, die in afrikanischen Ländern geboren sind und in den Vereinigten Staaten leben oder eine starke Verbindung zu dem Land haben. Nur für Personen verwenden, die sich selbst als afroamerikanisch bezeichnen."},{"@language":"nl","@value":"Transgender personen van Afrikaanse afkomst, geboren in de Verenigde Staten of transgender personen geboren in Afrikaanse landen die wonen in of een sterke band hebben met de Verenigde Staten. Gebruik voor personen die zichzelf identificeren als Afrikaans-Amerikaan. Volg waar mogelijk de voorkeur van het individu voor Afrikaans-Amerikaans of zwart."},{"@language":"sv","@value":"Transpersoner av afrikansk härkomst födda i USA eller transpersoner födda i afrikanska länder som bor i eller har en stark anknytning till USA. Används för individer som identifierar sig som afroamerikaner. Följ individens preferens för afroamerikan eller svart när det är möjligt."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000015"},{"@id":"https://homosaurus.org/v5/homoit0001396"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2012000714"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transgenderAfricanAmericans"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002335","dc:identifier":"homoit0002335","skos:prefLabel":[{"@language":"en","@value":"African American asexual people"},{"@language":"es","@value":"Personas asexuales afroamericanas"},{"@language":"de","@value":"Afroamerikanische asexuelle Personen"},{"@language":"nl","@value":"Afrikaans-Amerikaanse aseksuele personen"},{"@language":"sv","@value":"Asexuella afroamerikaner"}],"skos:altLabel":[{"@language":"en","@value":"African American ace people"},{"@language":"en","@value":"Asexual African American people"},{"@language":"en","@value":"Asexual African Americans"},{"@language":"es","@value":"Afroamericanos asexuales"},{"@language":"es","@value":"Afroamericanos ace"},{"@language":"es","@value":"Afroamericanas asexuales"},{"@language":"es","@value":"Afroamericanas ace"},{"@language":"es","@value":"Personas ace afroamericanas"},{"@language":"es","@value":"Personas afroamericanas asexuales"},{"@language":"de","@value":"Afroamerikanische ace Personen"},{"@language":"de","@value":"Asexuelle Afroamerikaner:innen"},{"@language":"nl","@value":"Aseksuele Afrikaans-Amerikanen"}],"rdfs:comment":[{"@language":"en","@value":"Asexual people of African descent born in the United States or asexual people born in African countries who live in or have a strong connection to the United States. Use for individuals who self-identity as African American. Follow the individual’s preference for African American or Black whenever possible."},{"@language":"es","@value":"Personas asexuales de ascendencia africana nacidas en los Estados Unidos o personas asexuales nacidas en países africanos que viven o tienen una conexión fuerte con los Estados Unidos. Utilícese para personas que se autoidentifiquen como afroamericanas."},{"@language":"de","@value":"Asexuelle Personen afrikanischer Abstammung, die in den Vereinigten Staaten geboren sind, oder asexuelle Menschen, die in afrikanischen Ländern geboren sind und in den Vereinigten Staaten leben oder eine starke Verbindung zu ihnen haben. Verwendung für Personen, die sich selbst als Afroamerikaner bezeichnen. Befolgen Sie die Präferenz der Person für Afroamerikaner oder Schwarze, wann immer möglich."},{"@language":"nl","@value":"Aseksuele personen van Afrikaanse afkomst geboren in de Verenigde Staten of aseksuele personen geboren in Afrikaanse landen die wonen in of een sterke band hebben met de Verenigde Staten. Gebruik voor personen die zichzelf identificeren als Afrikaans-Amerikaans. Volg waar mogelijk de voorkeur van het individu voor Afrikaans-Amerikaans of zwart."},{"@language":"sv","@value":"Asexuella personer av afrikansk härkomst födda i USA eller asexuella personer födda i afrikanska länder som bor i eller har en stark anknytning till USA. Används för individer som identifierar sig som afroamerikaner. Följ individens preferens för afroamerikan eller svart när det är möjligt."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000015"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-12-13"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002935","dc:identifier":"homoit0002935","skos:prefLabel":[{"@language":"en","@value":"African American intersex people"},{"@language":"es","@value":"Personas intersexuales afroamericanas"},{"@language":"de","@value":"Afroamerikanische inter* Personen"},{"@language":"nl","@value":"Afrikaans-Amerikaanse intersekse personen"},{"@language":"sv","@value":"Afroamerikanska intersexpersoner"}],"skos:altLabel":[{"@language":"en","@value":"Intersex African American people"},{"@language":"en","@value":"Intersex African Americans"},{"@language":"es","@value":"Afroamericanos intersex"},{"@language":"es","@value":"Intersex afroamericanos"},{"@language":"es","@value":"Afroamericanas intersex"},{"@language":"es","@value":"Intersex afroamericanas"},{"@language":"es","@value":"Personas intersex afroamericanas"},{"@language":"de","@value":"Inter* afroamerikanische Personen"},{"@language":"de","@value":"Afroamerikanische inter* Personen"}],"rdfs:comment":[{"@language":"en","@value":"Intersex people of African descent born in the United States or intersex people born in African countries who live in or have a strong connection to the United States. Use for individuals who self-identity as African American. Follow the individual’s preference for African American or Black whenever possible."},{"@language":"es","@value":"Personas intersexuales de ascendencia africana nacidas en los Estados Unidos o personas intersex nacidas en países africanos que viven o tienen una conexión fuerte con los Estados Unidos. Utilícese para personas que se autoidentifiquen como afroamericanas."},{"@language":"de","@value":"Inter* Personen afrikanischer Abstammung, die in den Vereinigten Staaten geboren sind, oder inter* Personen, die in afrikanischen Ländern geboren sind und in den Vereinigten Staaten leben oder eine starke Verbindung zu dem Land haben. Nur für Personen verwenden, die sich selbst als afroamerikanisch bezeichnen."},{"@language":"nl","@value":"Intersekse personen van Afrikaanse afkomst geboren in de Verenigde Staten of intersekse personen geboren in Afrikaanse landen die in de Verenigde Staten wonen of daar een sterke band mee hebben. Gebruik voor personen die zichzelf identificeren als Afrikaans-Amerikaan. Volg waar mogelijk de voorkeur van de persoon voor Afrikaans-Amerikaans of Zwart."},{"@language":"sv","@value":"Intersexpersoner av afrikansk härkomst födda i USA eller intersexpersoner födda i afrikanska länder som bor i eller har en stark anknytning till USA. Används för individer som identifierar sig som afroamerikaner. Följ individens preferens för afroamerikan eller svart när det är möjligt."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000015"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-30"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003558","dc:identifier":"homoit0003558","skos:prefLabel":[{"@language":"en","@value":"African American non-binary people"},{"@language":"es","@value":"Personas no binarias afroamericanas"},{"@language":"nl","@value":"Afrikaans-Amerikaanse non-binaire personen"},{"@language":"sv","@value":"Ickebinära afroamerikaner"}],"skos:altLabel":[{"@language":"en","@value":"Non-binary African Americans"},{"@language":"en","@value":"Non-binary African American people"},{"@language":"en","@value":"African American nonbinary people"},{"@language":"en","@value":"Nonbinary African American people"},{"@language":"en","@value":"Nonbinary African Americans"},{"@language":"es","@value":"Afroamericanxs"},{"@language":"es","@value":"Personas no binarias afroamericanas"},{"@language":"es","@value":"Personas afroamericanas no binarias"},{"@language":"es","@value":"Afroamericanxs no binarixs"},{"@language":"nl","@value":"Non-binaire Afrikaans-Amerikaanse personen"},{"@language":"nl","@value":"Nonbinaire Afrikaans-Amerikaanse personen"}],"rdfs:comment":[{"@language":"en","@value":"Non-binary people of African descent born in the United States or non-binary people born in African countries who live in or have a strong connection to the United States. Use for individuals who self-identity as African American. Follow the individual’s preference for African American or Black whenever possible."},{"@language":"es","@value":"Personas no binarias de ascendencia africana nacidas en los Estados Unidos o personas no binarias nacidas en países africanos que viven o tienen una conexión fuerte con los Estados Unidos. Utilícese para personas que se autoidentifiquen como afroamericanas."},{"@language":"nl","@value":"Non-binaire personen van Afrikaanse afkomst geboren in de Verenigde Staten of non-binaire personen geboren in Afrikaanse landen die in de Verenigde Staten wonen of daar een sterke band mee hebben. Gebruik voor personen die zichzelf identificeren als Afrikaans-Amerikaan. Volg waar mogelijk de voorkeur van de persoon voor Afrikaans-Amerikaans of Zwart."},{"@language":"sv","@value":"Ickebinära personer av afrikanskt ursprung som är födda i USA eller ickebinära personer födda i afrikanska länder som bor i, eller har en stark koppling till, USA. Används för individer som identifierar sig som afroamerikaner. Följ individens preferens för afroamerikan eller svart när det är möjligt."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000015"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-22"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000095","dc:identifier":"homoit0000095","skos:prefLabel":[{"@language":"en","@value":"Banjees"},{"@language":"es","@value":"Banjees"},{"@language":"de","@value":"Banjees"},{"@language":"nl","@value":"Banjees"},{"@language":"sv","@value":"Banjier"}],"skos:altLabel":[{"@language":"de","@value":"Banjee"},{"@language":"sv","@value":"Banjees"}],"rdfs:comment":[{"@language":"en","@value":"Term from the 1980s (or earlier) that describes a certain type of young Latin American or African American man who has sex with men and who dresses in stereotypical masculine urban fashion."},{"@language":"es","@value":"Término de la década de 1980 (o anterior) que describe a un determinado tipo de joven latino o afroamericano que mantiene relaciones sexuales con hombres y que viste de forma estereotipada masculina y urbana."},{"@language":"de","@value":"Begriff aus den 1980er-Jahren (oder früher), der einen bestimmten Typus junger lateinamerikanischer oder afroamerikanischer Männer beschreibt, die Sex mit Männern haben und sich in stereotyper, männlicher urbaner Mode kleiden."},{"@language":"sv","@value":"Term från 1980-talet (eller tidigare) som beskriver en viss typ av ung latinamerikansk eller afroamerikansk man som har sex med män och klär sig i en stereotyp maskulin urban stil."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000878"},{"@id":"https://homosaurus.org/v5/homoit0001295"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000015"},{"@id":"https://homosaurus.org/v5/homoit0000092"},{"@id":"https://homosaurus.org/v5/homoit0000253"},{"@id":"https://homosaurus.org/v5/homoit0000978"},{"@id":"https://homosaurus.org/v5/homoit0001009"},{"@id":"https://homosaurus.org/v5/homoit0002017"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000878"},"dc:replaces":{"@id":"http://homosaurus.org/v2/banjees"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001254","dc:identifier":"homoit0001254","skos:prefLabel":[{"@language":"en","@value":"Same-gender-loving"},{"@language":"es","@value":"Amor del mismo género"},{"@language":"nl","@value":"Same-gender-loving"},{"@language":"sv","@value":"Same-gender-loving"}],"skos:altLabel":[{"@language":"en","@value":"SGL"},{"@language":"es","@value":"Same-gender-loving"},{"@language":"es","@value":"SGL"},{"@language":"sv","@value":"Samkönsälskande"}],"rdfs:comment":[{"@language":"en","@value":"Culturally affirming term for sexual identity that is often used to describe African American homosexual people."},{"@language":"es","@value":"Término culturalmente afirmativo para la identidad sexual que se utiliza a menudo para describir a las personas homosexuales afroamericanas."},{"@language":"sv","@value":"En kulturellt bekräftande term för sexuell identitet som ofta används för att beskriva homosexuella afroamerikanska personer."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001295"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000015"},{"@id":"https://homosaurus.org/v5/homoit0001009"},{"@id":"https://homosaurus.org/v5/homoit0001510"},{"@id":"https://homosaurus.org/v5/homoit0002278"},{"@id":"https://homosaurus.org/v5/homoit0002279"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001295"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sameGenderLoving"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000016","dc:identifier":"homoit0000016","skos:prefLabel":[{"@language":"en","@value":"Afro-Canadian LGBTQ+ people"},{"@language":"de","@value":"Afrokanadische LGBTQ+-Personen"},{"@language":"es","@value":"Personas LGBTQ+ afrocanadienses"},{"@language":"nl","@value":"Afro-Canadese LHBTQ+-personen"},{"@language":"sv","@value":"Afrokanadensiska hbtq+-personer"}],"skos:altLabel":[{"@language":"en","@value":"Afro-Canadian people (LGBTQ)"},{"@language":"en","@value":"Afro-Canadians (LGBTQ)"},{"@language":"en","@value":"LGBTQ+ Afro-Canadian people"},{"@language":"en","@value":"LGBTQ+ Afro-Canadians"},{"@language":"de","@value":"LGBTQ+-afrokanadische Personen"},{"@language":"de","@value":"LGBTQ+-Afrokanadier:innen"},{"@language":"es","@value":"Afrocanadienses LGBTQ+"},{"@language":"es","@value":"Personas afrocanadienses LGBTQ+"},{"@language":"es","@value":"Afrocanadienses (LGBTQ)"},{"@language":"es","@value":"Personas LGBTQ+ afrocanadiensxs"},{"@language":"nl","@value":"Afro-Canadezen (LHBTQ+)"},{"@language":"nl","@value":"LHBTQ+ Afro-Canadese personen"},{"@language":"nl","@value":"LHBTQ+ Afro-Canadezen"}],"rdfs:comment":[{"@language":"en","@value":"LGBTQ+ people of African descent born in Canada or LGBTQ+ people born in African countries who live in or have a strong connection to Canada; use for individuals who self-identity as Afro-Canadian."},{"@language":"de","@value":"LGBTQ+-Personen afrikanischer Abstammung, die in Kanada geboren sind, oder LGBTQ+-Personen, die in afrikanischen Ländern geboren sind und in Kanada leben oder eine starke Verbindung zu dem Land haben. Nur für Personen verwenden, die sich selbst als afrokanadisch bezeichnen."},{"@language":"es","@value":"Personas LGBTQ+ de ascendencia africana nacidas en Canadá o personas LGBTQ+ nacidas en países africanos que viven o tienen una conexión fuerte con Canadá. Utilícese para personas que se identifiquen como afrocanadienses."},{"@language":"nl","@value":"LHBTQ+-personen van Afrikaanse afkomst geboren in Canada of LHBTQ+-personen geboren in Afrikaanse landen die wonen in of een sterke band hebben met Canada; gebruik voor personen die zichzelf identificeren als Afro-Canadees"},{"@language":"sv","@value":"Hbtq+-personer av afrikansk härkomst födda i Kanada eller hbtq+-personer födda i afrikanska länder som bor i eller har en stark anknytning till Kanada. Används för individer som identifierar sig som afrokanadensare."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000208"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000124"},{"@id":"https://homosaurus.org/v5/homoit0000464"},{"@id":"https://homosaurus.org/v5/homoit0000715"},{"@id":"https://homosaurus.org/v5/homoit0001152"},{"@id":"https://homosaurus.org/v5/homoit0001385"},{"@id":"https://homosaurus.org/v5/homoit0002893"},{"@id":"https://homosaurus.org/v5/homoit0002957"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/afroCanadiansLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000124","dc:identifier":"homoit0000124","skos:prefLabel":[{"@language":"en","@value":"Afro-Canadian bisexual people"},{"@language":"es","@value":"Personas bisexuales afrocanadienses"},{"@language":"de","@value":"Afrokanadische bisexuelle Personen"},{"@language":"nl","@value":"Afro-Canadese biseksuele personen"},{"@language":"sv","@value":"Bisexuella afrokanadensare"}],"skos:altLabel":[{"@language":"en","@value":"Bisexual Afro-Canadian people"},{"@language":"en","@value":"Bisexual Afro-Canadians"},{"@language":"es","@value":"Afrocanadienses bisexuales"},{"@language":"es","@value":"Bisexuales afrocanadienses"},{"@language":"de","@value":"Bisexuelle afroamerikanische Personen"},{"@language":"de","@value":"Bisexuelle Afrokanadier:innen"}],"rdfs:comment":[{"@language":"en","@value":"Bisexual people of African descent born in Canada or bisexual people born in African countries who live in or have a strong connection to Canada. Use for individuals who self-identify as Afro-Canadian."},{"@language":"es","@value":"Personas bisexuales de ascendencia africana nacidas en Canadá o personas bisexuales nacidas en países africanos que viven o tienen una conexión fuerte con Canadá. Utilícese para  personas que se autoidentifiquen como afrocanadienses."},{"@language":"de","@value":"Bisexuelle Personen afrikanischer Abstammung, die in Kanada geboren sind, oder bisexuelle Personen, die in afrikanischen Ländern geboren sind und in Kanada leben oder eine starke Verbindung zu dem Land haben. Nur für Personen verwenden, die sich selbst als afrokanadisch bezeichnen."},{"@language":"nl","@value":"Biseksuele personen van Afrikaanse afkomst geboren in Canada of biseksuele personen geboren in Afrikaanse landen die wonen in of een sterke band hebben met Canada. Gebruik voor personen die zichzelf identificeren als Afro-Canadees"},{"@language":"sv","@value":"Bisexuella personer av afrikansk härkomst födda i Kanada eller bisexuella personer födda i afrikanska länder som bor i eller har en stark anknytning till Kanada. Används för individer som identifierar sig som afrokanadensare."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000016"},{"@id":"https://homosaurus.org/v5/homoit0000135"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualAfroCanadians"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000464","dc:identifier":"homoit0000464","skos:prefLabel":[{"@language":"en","@value":"Afro-Canadian gay men"},{"@language":"es","@value":"Hombres gay afrocanadienses"},{"@language":"de","@value":"Afrokanadische schwule Männer"},{"@language":"nl","@value":"Afro-Canadese homomannen"},{"@language":"sv","@value":"Afrokanadensiska bögar"}],"skos:altLabel":[{"@language":"en","@value":"Gay Afro-Canadian people"},{"@language":"en","@value":"Gay Afro-Canadians"},{"@language":"es","@value":"Afrocanadienses gay"},{"@language":"de","@value":"Schwule afrokanadische Männer"},{"@language":"de","@value":"Schwule Afrokanadier"}],"rdfs:comment":[{"@language":"en","@value":"Gay men of African descent born in Canada or gay men born in African countries who live in or have a strong connection to Canada. Use for individuals who self-identify as Afro-Canadian."},{"@language":"es","@value":"Hombres gay de ascendencia africana nacidos en Canadá u hombres gay nacidos en países africanos que viven o tienen una conexión fuerte con Canadá. Utilícese para personas que se autoidentifiquen como afrocanadienses."},{"@language":"de","@value":"Schwule Männer afrikanischer Abstammung, die in Kanada geboren sind, oder schwule Männer, die in afrikanischen Ländern geboren sind und in Kanada leben oder eine starke Verbindung zu dem Land haben. Nur für Personen verwenden, die sich selbst als afrokanadisch bezeichnen."},{"@language":"nl","@value":"Homomannen van Afrikaanse afkomst geboren in Canada of homomannen geboren in Afrikaanse landen die wonen in of een sterke band hebben met Canada. Gebruik voor personen die zichzelf identificeren als Afro-Canadees."},{"@language":"sv","@value":"Bögar av afrikansk härkomst födda i Kanada eller bögar födda i afrikanska länder som bor i eller har en stark anknytning till Kanada. Används för individer som identifierar sig som afrokanadensare."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000016"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayAfroCanadians"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000715","dc:identifier":"homoit0000715","skos:prefLabel":[{"@language":"en","@value":"Afro-Canadian lesbians"},{"@language":"es","@value":"Lesbianas afrocanadienses"},{"@language":"de","@value":"Afrokanadische Lesben"},{"@language":"nl","@value":"Afro-Canadese lesbische vrouwen"},{"@language":"sv","@value":"Lesbiska afrokanadensare"}],"skos:altLabel":[{"@language":"en","@value":"Lesbian Afro-Canadians"},{"@language":"es","@value":"Afrocanadienses lesbianas"},{"@language":"de","@value":"Lesbische Afrokanadier:innen"}],"rdfs:comment":[{"@language":"en","@value":"Lesbians of African descent born in Canada or lesbians born in African countries who live in or have a strong connection to Canada. Use for individuals who self-identify as Afro-Canadian."},{"@language":"es","@value":"Lesbianas de ascendencia africana nacidas en Canadá o lesbianas nacidas en países africanos que viven o tienen una conexión fuerte con Canadá. Utilícese para personas que se identifiquen como afrocanadienses."},{"@language":"de","@value":"Lesben afrikanischer Abstammung, die in Kanada geboren sind, oder Lesben, die in afrikanischen Ländern geboren sind und in Kanada leben oder eine starke Verbindung zu dem Land haben. Nur für Personen verwenden, die sich selbst als afrokanadisch bezeichnen."},{"@language":"nl","@value":"Lesbische vrouwen van Afrikaanse afkomst geboren in Canada of lesbische vrouwen geboren in Afrikaanse landen die wonen in of een sterke band hebben met Canada. Gebruik voor personen die zichzelf identificeren als Afro-Canadees."},{"@language":"sv","@value":"Lesbiska av afrikansk härkomst födda i Kanada eller lesbiska födda i afrikanska länder som bor i eller har en stark anknytning till Kanada. Används för individer som identifierar sig som afrokanadensare."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000016"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianAfroCanadians"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001152","dc:identifier":"homoit0001152","skos:prefLabel":[{"@language":"en","@value":"Afro-Canadian queer people"},{"@language":"es","@value":"Personas queer afrocanadienses"},{"@language":"de","@value":"Afrokanadische queere Personen"},{"@language":"nl","@value":"Afro-Canadese queer personen"},{"@language":"sv","@value":"Queera afrokanadensare"}],"skos:altLabel":[{"@language":"en","@value":"Queer Afro-Canadian people"},{"@language":"en","@value":"Queer Afro-Canadians"},{"@language":"es","@value":"Personas afrocanadienses queer"},{"@language":"es","@value":"Afrocanadienses queer"},{"@language":"de","@value":"Queere afrokanadische Personen"},{"@language":"de","@value":"Queere Afrokanadier:innen"}],"rdfs:comment":[{"@language":"en","@value":"Queer people of African descent born in Canada or queer people born in African countries who live in or have a strong connection to Canada. Use for individuals who self-identify as Afro-Canadian."},{"@language":"es","@value":"Personas queer de ascendencia africana nacidas en Canadá o personas queer nacidas en países africanos que viven o tienen una conexión fuerte con Canadá. Utilícese para persona