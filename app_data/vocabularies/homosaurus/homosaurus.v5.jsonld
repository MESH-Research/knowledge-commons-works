{"@id":"https://homosaurus.org/v5/homoit0003065","dc:identifier":"homoit0003065","skos:prefLabel":[{"@language":"en","@value":"Leather fetish"},{"@language":"de","@value":"Lederfetisch"},{"@language":"es","@value":"Fetiche leather"},{"@language":"nl","@value":"Leerfetisj"},{"@language":"sv","@value":"Läderfetischism"}],"skos:altLabel":{"@language":"es","@value":"Leather fetish"},"rdfs:comment":[{"@language":"en","@value":"Eroticization of leather, especially leather garments and accessories associated with the leather and kink communities."},{"@language":"de","@value":"Die Erotisierung von Leder, insbesondere von Lederbekleidung und -accessoires, die mit der Leder- und Kinkszene in Verbindung gebracht werden."},{"@language":"es","@value":"La erotización del cuero, especialmente de prendas y accesorios de cuero asociados a las comunidades leather y kink."},{"@language":"nl","@value":"Erotisering van leer, vooral leren kleding en accessoires die geassocieerd worden met leer- en kinkgemeenschappen."},{"@language":"sv","@value":"Erotisering av läder, särskilt läderplagg och accessoarer som är kopplade till läder- och kinkgemenskaperna."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000442"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000217"},{"@id":"https://homosaurus.org/v5/homoit0000705"},{"@id":"https://homosaurus.org/v5/homoit0003063"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000404"},"dc:issued":{"@type":"xsd:date","@value":"2023-12-18"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003102","dc:identifier":"homoit0003102","skos:prefLabel":[{"@language":"en","@value":"Shoe fetish"},{"@language":"es","@value":"Retifismo"},{"@language":"nl","@value":"Schoenenfetisj"},{"@language":"sv","@value":"Skofetishism"}],"skos:altLabel":[{"@language":"en","@value":"Shoe kink"},{"@language":"es","@value":"Fetiche de zapatos"},{"@language":"sv","@value":"Shoe fetish"}],"rdfs:comment":[{"@language":"en","@value":"Eroticization of shoes such as high heels and boots."},{"@language":"es","@value":"Erotización de zapatos, tales como tacones y botas."},{"@language":"nl","@value":"Erotisering van schoenen zoals hoge hakken en laarzen."},{"@language":"sv","@value":"Erotisering av skor, till exempel högklackade och stövlar."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000442"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0003064"},{"@id":"https://homosaurus.org/v5/homoit0003103"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000217"},{"@id":"https://homosaurus.org/v5/homoit0003063"},{"@id":"https://homosaurus.org/v5/homoit0003122"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000404"},"dc:issued":{"@type":"xsd:date","@value":"2023-12-20"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003105","dc:identifier":"homoit0003105","skos:prefLabel":[{"@language":"en","@value":"Bootblacks"},{"@language":"de","@value":"Bootblack"},{"@language":"es","@value":"Lustrabotas"},{"@language":"nl","@value":"Bootblacks"},{"@language":"sv","@value":"Bootblacks"}],"skos:altLabel":[{"@language":"de","@value":"Stiefelputzer"},{"@language":"es","@value":"Limpiabotas"},{"@language":"es","@value":"Bootblacker"}],"rdfs:comment":[{"@language":"en","@value":"In the leather and kink communities, an individual who cleans and conditions someone’s leather boots, shoes or garments."},{"@language":"de","@value":"In der Leder- und Kink-Community eine Person, die jemandes Lederstiefel, -schuhe oder -kleidung reinigt und pflegt."},{"@language":"es","@value":"En las comunidades del cuero y kink, un individuo que limpia y acondiciona las botas, los zapatos o las prendas de cuero de alguien."},{"@language":"nl","@value":"In de leer- en kinkgemeenschap is dit een persoon die iemands leren laarzen, schoenen of kleding reinigt en verzorgt."},{"@language":"sv","@value":"Inom läder- och kinkgemenskaper, en person som rengör och vårdar någon annans läderkängor, skor eller plagg."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0003086"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000217"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000297"},"dc:issued":{"@type":"xsd:date","@value":"2023-12-20"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003122","dc:identifier":"homoit0003122","skos:prefLabel":[{"@language":"en","@value":"Foot fetish"},{"@language":"es","@value":"Fetiche de pies"},{"@language":"de","@value":"Fußfetisch"},{"@language":"nl","@value":"Voetfetisj"},{"@language":"sv","@value":"Fotfetischismer"}],"skos:altLabel":[{"@language":"en","@value":"Aretifism"},{"@language":"en","@value":"Foot fetishism"},{"@language":"en","@value":"Foot kink"},{"@language":"en","@value":"Foot partialism"},{"@language":"en","@value":"Podophilia"},{"@language":"en","@value":"Retifitism"},{"@language":"es","@value":"Aretifismo"},{"@language":"es","@value":"Fetichismo de pies"},{"@language":"es","@value":"Kink de pies"},{"@language":"es","@value":"Parcialismo de pies"},{"@language":"es","@value":"Podofilia"},{"@language":"es","@value":"Retifismo"},{"@language":"de","@value":"Fußfetischismus"},{"@language":"de","@value":"Podophilie"},{"@language":"nl","@value":"Podofilie"},{"@language":"nl","@value":"Retifisme"},{"@language":"nl","@value":"Voetenfetisjisme"},{"@language":"nl","@value":"Voetkink"},{"@language":"nl","@value":"Voetpartialisme"}],"rdfs:comment":[{"@language":"en","@value":"Eroticization of the feet."},{"@language":"es","@value":"Erotización de los pies."},{"@language":"de","@value":"Erotisierung der Füße."},{"@language":"nl","@value":"Erotisering van de voeten."},{"@language":"sv","@value":"Sexuell upphetsning och attraktion kopplad till fötter."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000442"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000217"},{"@id":"https://homosaurus.org/v5/homoit0003102"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000404"},"dc:issued":{"@type":"xsd:date","@value":"2023-12-20"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000218","dc:identifier":"homoit0000218","skos:prefLabel":[{"@language":"en","@value":"Boston marriages"},{"@language":"es","@value":"Matrimonios de Boston"},{"@language":"de","@value":"Boston Marriage"},{"@language":"nl","@value":"Boston marriages"},{"@language":"sv","@value":"Bostonäktenskap"}],"skos:altLabel":[{"@language":"es","@value":"Matrimonios bostonianos"},{"@language":"es","@value":"Boston marriages"}],"rdfs:comment":[{"@language":"en","@value":"The cohabitation of two women (often in a romantic relationship) without the financial support of a man. Originated in New England (USA) in the late 19th century."},{"@language":"es","@value":"La convivencia de dos mujeres (a menudo en una relación romántica) sin el apoyo económico de un hombre. Se originó en Nueva Inglaterra (EE.UU.) a finales del siglo XIX."},{"@language":"de","@value":"Das Zusammenleben zweier Frauen (oft in einer romantischen Beziehung) ohne die finanzielle Unterstützung eines Mannes. Entstanden in Neuengland (USA) im späten 19. Jahrhundert."},{"@language":"sv","@value":"Samboende kvinnor (ofta i en romantisk relation) utan ekonomiskt stöd från en man. Termen uppstod i New England (USA) i slutet av 1800-talet."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000310"},{"@id":"https://homosaurus.org/v5/homoit0000878"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000735"},{"@id":"https://homosaurus.org/v5/homoit0004332"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001237"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bostonMarriages"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000735","dc:identifier":"homoit0000735","skos:prefLabel":[{"@language":"en","@value":"Lesbian couples"},{"@language":"es","@value":"Parejas lésbicas"},{"@language":"nl","@value":"Lesbische paren"},{"@language":"sv","@value":"Lesbiska par"}],"skos:altLabel":[{"@language":"es","@value":"Parejas de lesbianas"},{"@language":"sv","@value":"Flatpar"}],"rdfs:comment":[{"@language":"en","@value":"Partnerships in which both people are lesbians."},{"@language":"es","@value":"Parejas en las que ambas personas son lesbianas."},{"@language":"nl","@value":"Partnerschappen waarin beide personen lesbisch zijn."},{"@language":"sv","@value":"Parrelationer där båda personerna är lesbiska."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000310"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000218"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85076154"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001237"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianCouples"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000219","dc:identifier":"homoit0000219","skos:prefLabel":[{"@language":"en","@value":"Bottoms (Sex)"},{"@language":"de","@value":"Bottoms (Sex)"},{"@language":"es","@value":"Pasivos (sexo)"},{"@language":"nl","@value":"Bottoms (Seks)"},{"@language":"sv","@value":"Bottoms (sex)"}],"skos:altLabel":[{"@language":"en","@value":"Bottoms"},{"@language":"en","@value":"Catchers (Sex)"},{"@language":"en","@value":"Catchers"},{"@language":"de","@value":"Bottoms"},{"@language":"es","@value":"Pasivos"},{"@language":"es","@value":"Asumisar"},{"@language":"es","@value":"Bottoms"},{"@language":"sv","@value":"Passiv (sex)"}],"rdfs:comment":[{"@language":"en","@value":"The receptive partner during sex or kink activities."},{"@language":"de","@value":"Der:Die rezeptive Partner:in beim Sex oder bei sexuellen Praktiken."},{"@language":"es","@value":"Término de la jerga para personas que se asumen como pareja receptora en encuentros sexuales."},{"@language":"nl","@value":"Argot term voor personen die optreden als de onderdanige partner in seksuele praktijken"},{"@language":"sv","@value":"Den mottagande parten vid kinkaktiviteter. Vanlig term i bögsammanhang för en person som vill inta den ”passiva” rollen vid sex, vilket förväntas bestå av att få penetration och ge oralsex."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001295"},{"@id":"https://homosaurus.org/v5/homoit0001304"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001318"},{"@id":"https://homosaurus.org/v5/homoit0001353"},{"@id":"https://homosaurus.org/v5/homoit0001376"},{"@id":"https://homosaurus.org/v5/homoit0001779"},{"@id":"https://homosaurus.org/v5/homoit0003052"},{"@id":"https://homosaurus.org/v5/homoit0003084"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001295"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bottoms"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001304","dc:identifier":"homoit0001304","skos:prefLabel":[{"@language":"en","@value":"Sexual roles"},{"@language":"es","@value":"Roles sexuales"},{"@language":"nl","@value":"Seksuele rollen"},{"@language":"sv","@value":"Sexuella roller"}],"rdfs:comment":[{"@language":"en","@value":"An erotic identity an individual assumes during sexual play with one or more people; this identity can either be restricted to the bedroom or extended into day-to-day life."},{"@language":"es","@value":"Una identidad erótica que asume una persona durante el juego sexual con una o más personas; esta identidad puede restringirse al ámbito del dormitorio o extenderse a la vida cotidiana."},{"@language":"sv","@value":"En erotisk identitet som en person antar vid sexuell lek med en eller flera andra. Identiteten kan vara begränsad till sovrummet eller ingå i vardagen."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001241"},{"@id":"https://homosaurus.org/v5/homoit0001300"}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000219"},{"@id":"https://homosaurus.org/v5/homoit0000231"},{"@id":"https://homosaurus.org/v5/homoit0000440"},{"@id":"https://homosaurus.org/v5/homoit0000999"},{"@id":"https://homosaurus.org/v5/homoit0001018"},{"@id":"https://homosaurus.org/v5/homoit0001353"},{"@id":"https://homosaurus.org/v5/homoit0001376"},{"@id":"https://homosaurus.org/v5/homoit0001779"},{"@id":"https://homosaurus.org/v5/homoit0003052"},{"@id":"https://homosaurus.org/v5/homoit0003506"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000609"},{"@id":"https://homosaurus.org/v5/homoit0001242"},{"@id":"https://homosaurus.org/v5/homoit0001295"},{"@id":"https://homosaurus.org/v5/homoit0001306"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001241"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sexualRoles"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001779","dc:identifier":"homoit0001779","skos:prefLabel":[{"@language":"en","@value":"Vers (Sex)"},{"@language":"es","@value":"Vers"},{"@language":"nl","@value":"Versatiel (Seks)"},{"@language":"sv","@value":"Vers (sex)"}],"skos:altLabel":[{"@language":"en","@value":"Vers"},{"@language":"en","@value":"Versatile"},{"@language":"es","@value":"Versátil"}],"rdfs:comment":[{"@language":"en","@value":"Slang term for individuals who alternate between being the giving partner and the receiving partner in sexual encounters; typically used as an adjective (e.g., \"They're vers.\")."},{"@language":"es","@value":"Término de la jerga para personas que alternan entre ser la pareja que da y la que recibe en encuentros sexuales; normalmente se utiliza como adjetivo (por ejemplo, \"Ella es vers\")."},{"@language":"nl","@value":"Argot term voor personen die afwisselend de gevende partner en de ontvangende partner zijn in seksuele ontmoetingen; meestal gebruikt als een bijvoeglijk naamwoord (bijvoorbeeld \"Ze zijn versatiel\")"},{"@language":"sv","@value":"Slangterm för personer som växlar mellan att vara den givande och den mottagande parten vid sex. Används vanligtvis som adjektiv, till exempel: ”De är vers”."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001295"},{"@id":"https://homosaurus.org/v5/homoit0001304"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000219"},{"@id":"https://homosaurus.org/v5/homoit0001353"},{"@id":"https://homosaurus.org/v5/homoit0001376"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001295"},"dc:issued":{"@type":"xsd:date","@value":"2021-12-07"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000255","dc:identifier":"homoit0000255","skos:prefLabel":[{"@language":"en","@value":"Children"},{"@language":"de","@value":"Kinder"},{"@language":"es","@value":"Niños y niñas"},{"@language":"fr","@value":"Enfants"},{"@language":"nl","@value":"Kinderen"},{"@language":"sv","@value":"Barn"}],"skos:altLabel":[{"@language":"en","@value":"Kids"},{"@language":"es","@value":"Infancias"}],"rdfs:comment":[{"@language":"en","@value":"People who have not yet reached the age of adolescence."},{"@language":"de","@value":"Menschen, die das Erwachsenenalter noch nicht erreicht haben."},{"@language":"es","@value":"Personas entre las edades del nacimiento y la pubertad."},{"@language":"fr","@value":"Personnes entre l'âge de la naissance et l'âge de la puberté."},{"@language":"nl","@value":"Personen die de adolescentieleeftijd nog niet bereikt hebben."},{"@language":"sv","@value":"Personer som ännu inte har nått tonåren."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000421"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000220"},{"@id":"https://homosaurus.org/v5/homoit0000256"},{"@id":"https://homosaurus.org/v5/homoit0000260"},{"@id":"https://homosaurus.org/v5/homoit0000590"},{"@id":"https://homosaurus.org/v5/homoit0001768"},{"@id":"https://homosaurus.org/v5/homoit0002282"},{"@id":"https://homosaurus.org/v5/homoit0002285"},{"@id":"https://homosaurus.org/v5/homoit0002628"},{"@id":"https://homosaurus.org/v5/homoit0002629"},{"@id":"https://homosaurus.org/v5/homoit0002772"},{"@id":"https://homosaurus.org/v5/homoit0003501"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000254"},{"@id":"https://homosaurus.org/v5/homoit0000263"},{"@id":"https://homosaurus.org/v5/homoit0000347"},{"@id":"https://homosaurus.org/v5/homoit0001520"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85023418"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000421"},"dc:replaces":{"@id":"http://homosaurus.org/v2/children"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","