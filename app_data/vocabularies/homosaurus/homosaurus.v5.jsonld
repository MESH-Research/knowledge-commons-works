ische autistische personen"},{"@language":"sv","@value":"Lesbiska med autism"}],"skos:altLabel":[{"@language":"en","@value":"Lesbians with autism"},{"@language":"es","@value":"Lesbianas con autismo"},{"@language":"es","@value":"Autistas lesbianas"},{"@language":"de","@value":"Autistische Lesben"},{"@language":"sv","@value":"Lesbiska autister"}],"rdfs:comment":[{"@language":"en","@value":"Lesbians who are autistic."},{"@language":"es","@value":"Lesbianas que son autistas."},{"@language":"de","@value":"Lesben, die autistisch sind."},{"@language":"nl","@value":"Lesbische vrouwen die autistisch zijn."},{"@language":"sv","@value":"Lesbiska som är autistiska."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002667"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-26"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002671","dc:identifier":"homoit0002671","skos:prefLabel":[{"@language":"en","@value":"Transgender autistic people"},{"@language":"es","@value":"Personas transgénero autistas"},{"@language":"nl","@value":"Transgender autistische personen"},{"@language":"sv","@value":"Transpersoner med autism"}],"skos:altLabel":[{"@language":"en","@value":"Transgender people with autism"},{"@language":"es","@value":"Personas autistas transgénero"},{"@language":"es","@value":"Personas transgénero con autismo"},{"@language":"sv","@value":"Transautister"}],"rdfs:comment":[{"@language":"en","@value":"Transgender people who are autistic."},{"@language":"es","@value":"Personas transgénero que son autistas."},{"@language":"nl","@value":"Transgender personen die autistisch zijn"},{"@language":"sv","@value":"Transpersoner som är autistiska."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002667"},"skos:related":{"@id":"https://homosaurus.o