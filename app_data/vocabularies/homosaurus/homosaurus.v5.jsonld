ire personen met een beperking"},{"@language":"sv","@value":"Funktionshindrade ickebinära personer"}],"rdfs:comment":[{"@language":"en","@value":"Non-binary people who are disabled."},{"@language":"es","@value":"Personas no binarias con discapacidad."},{"@language":"nl","@value":"Non-binaire personen die gehandicapt zijn."},{"@language":"sv","@value":"Ickebinära personer med funktionsnedsättning/funktionsnedsättningar."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001854"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0003005"},{"@id":"https://homosaurus.org/v5/homoit0003011"},{"@id":"https://homosaurus.org/v5/homoit0003016"},{"@id":"https://homosaurus.org/v5/homoit0003021"},{"@id":"https://homosaurus.org/v5/homoit0003027"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0003026"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-26"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002658","dc:identifier":"homoit0002658","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ neurodivergent people"},{"@language":"es","@value":"Personas LGBTQ+ neurodivergentes"},{"@language":"nl","@value":"LHBTQ+-neurodivergente personen"},{"@language":"sv","@value":"Neurodivergenta hbtq+-personer"}],"skos:altLabel":[{"@language":"en","@value":"LGBTQ+ neuroatypical people"},{"@language":"en","@value":"Neurodivergent LGBTQ+ people"},{"@language":"en","@value":"Neuroatypical LGBTQ+ people"},{"@language":"es","@value":"Personas neurodivergentes LGBTQ+"},{"@language":"nl","@value":"Neuro-atypische LHBTQ+-personen"},{"@language":"nl","@value":"Neurodivergente LHBTQ+-personen"}],"rdfs:comment":[{"@language":"en","@value":"LGBTQ+ people with neurodevelopmental differences in areas such as cognition, sensory processing, emotionality, and sociality"},{"@language":"es","@value":"Personas LGBTQ+ cuyos cerebros procesan, aprenden y/o se comportan de manera diferente a lo que la sociedad considera típico. Algunas de estas diferencias neurológicas pueden presentarse como problemas de aprendizaje, trastornos médicos y otras condiciones."},{"@language":"nl","@value":"LHBTQ+-personen met neurodevelopmentale verschillen op gebieden zoals cognitie, zintuiglijke verwerking, emotionaliteit en sociale vaardigheden."},{"@language":"sv","@value":"Hbtq+-personer vars kognition, sensoriska bearbetning, emotionalitet eller sociala förmåga skiljer sig från normen. Dessa variationer kan för vissa innebära funktionsnedsättningar eller medicinska tillstånd, medan de för andra är egenskaper som ingår i deras identitet."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001854"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0002659"},{"@id":"https://homosaurus.org/v5/homoit0002660"},{"@id":"https://homosaurus.org/v5/homoit0002661"},{"@id":"https://homosaurus.org/v5/homoit0002662"},{"@id":"https://homosaurus.org/v5/homoit0002663"},{"@id":"https://homosaurus.org/v5/homoit0002664"},{"@id":"https://homosaurus.org/v5/homoit0002665"},{"@id":"https://homosaurus.org/v5/homoit0002667"},{"@id":"https://homosaurus.org/v5/homoit0004337"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0002666"},{"@id":"https://homosaurus.org/v5/homoit0003824"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-26"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002782","dc:identifier":"homoit0002782","skos:prefLabel":[{"@language":"en","@value":"Asexual disabled people"},{"@language":"es","@value":"Personas asexuales discapacitadas"},{"@language":"de","@value":"Asexuelle Personen mit Behinderung"},{"@language":"nl","@value":"Gehandicapte aseksuele personen"},{"@language":"sv","@value":"Funktionedsatta asexuella personer"}],"skos:altLabel":[{"@language":"en","@value":"Asexual people with disabilities"},{"@language":"en","@value":"Disabled asexual people"},{"@language":"es","@value":"Personas asexuales con discapacidades"},{"@language":"es","@value":"Discapacitados asexuales"},{"@language":"es","@value":"Discapacitadas asexuales"},{"@language":"es","@value":"Personas discapacitadas asexuales"},{"@language":"de","@value":"Behinderte asexuelle Personen"},{"@language":"de","@value":"Ace Personen mit Behinderung"},{"@language":"de","@value":"Behinderte ace Personen"},{"@language":"nl","@value":"Aseksuelen met een handicap"}],"rdfs:comment":[{"@language":"en","@value":"Asexual people who are disabled."},{"@language":"es","@value":"Personas asexuales con discapacidad."},{"@language":"de","@value":"Asexuelle Personen mit Behinderung."},{"@language":"nl","@value":"Aseksuelen die gehandicapt zijn"},{"@language":"sv","@value":"Asexuella personer med funktionsnedsättning/funktionsnedsättningar."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001854"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0002664"},{"@id":"https://homosaurus.org/v5/homoit0002783"},{"@id":"https://homosaurus.org/v5/homoit0002784"},{"@id":"https://homosaurus.org/v5/homoit0002785"},{"@id":"https://homosaurus.org/v5/homoit0002787"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0002786"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002929","dc:identifier":"homoit0002929","skos:prefLabel":[{"@language":"en","@value":"Intersex disabled people"},{"@language":"es","@value":"Personas inters