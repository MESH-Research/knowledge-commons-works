os:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002759","dc:identifier":"homoit0002759","skos:prefLabel":[{"@language":"en","@value":"Asexual archives"},{"@language":"es","@value":"Archivos asexuales"},{"@language":"de","@value":"Axexuelle Archive"},{"@language":"nl","@value":"Aseksuele archieven"},{"@language":"sv","@value":"Asexuella arkiv"}],"skos:altLabel":[{"@language":"de","@value":"Ace Archive"},{"@language":"sv","@value":"Ace-arkiv"}],"rdfs:comment":[{"@language":"en","@value":"Collections of records and materials relating to asexual people or asexual communities; can include a variety of organizations and institutions from community to government archives."},{"@language":"es","@value":"Colecciones de registros y materiales relacionados con personas asexuales o comunidades asexuales; puede incluir a una variedad de organizaciones e instituciones, desde archivos comunitarios hasta gubernamentales."},{"@language":"de","@value":"Sammlungen von Aufzeichnungen und Materialien zu asexuellen Menschen oder asexuellen Gemeinschaften; können eine Vielzahl von Organisationen und Institutionen umfassen, von Communityarchiven bis hin zu staatlichen Archiven."},{"@language":"nl","@value":"Verzamelingen van dossiers en materialen met betrekking tot aseksuele personen of aseksuele gemeenschappen; kan een verscheidenheid aan organisaties en instellingen omvatten, van gemeenschapsarchieven tot overheidsarchieven."},{"@language":"sv","@value":"Samlingar av arkivmaterial och dokument relaterade till asexuella personer eller asexuella gemenskaper. Kan omfatta arkiv hos allt från lokala gemenskaper till statliga institutioner."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000066"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001755"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-27"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002776","dc:identifier":"homoit0002776","skos:prefLabel":[{"@language":"en","@value":"Intersex archives"},{"@language":"es","@value":"Archivos intersex"},{"@language":"nl","@value":"Intersekse archieven"},{"@language":"sv","@value":"Intersexarkiv"}],"rdfs:comment":[{"@language":"en","@value":"Collections of records and materials relating to intersex people or intersex communities; can include a variety of organizations and institutions from community to government archives."},{"@language":"es","@value":"Colecciones de registros y materiales relacionados con personas intersex o comunidades intersex; puede incluir una variedad de organizaciones e instituciones, desde archivos comunitarios hasta gubernamentales."},{"@language":"nl","@value":"Verzamelingen van documenten en materialen met betrekking tot intersekse personen of intersekse gemeenschappen; kan een verscheidenheid aan organisaties en instellingen omvatten, van gemeenschaps- tot overheidsarchieven."},{"@language":"sv","@value":"Samlingar av arkivmaterial och dokument relaterade till intersexpersoner eller intersexgemenskaper. Kan omfatta arkiv hos allt från lokala gemenskaper till statliga institutioner."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000066"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001755"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-27"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003608","dc:identifier":"homoit0003608","skos:prefLabel":[{"@language":"en","@value":"Black queer archives"},{"@language":"nl","@value":"Zwarte queer archieven"},{"@language":"sv","@value":"Svarta queera arkiv"}],"skos:altLabel":{"@language":"en","@value":"Queer Black archives"},"rdfs:comment":[{"@language":"en","@value":"Collections of records and materials relating to Black queer people and communities, or collections of records and materials relating to Black people and communities that are curated, organized, and presented from a queer perspective. Can include a variety of organizations and institutions from community to government archives."},{"@language":"nl","@value":"Collecties van documenten en materialen met betrekking tot zwarte queer personen en gemeenschappen, of collecties van documenten en materialen met betrekking tot zwarte personen en gemeenschappen die zijn samengesteld, georganiseerd en gepresenteerd vanuit een queer perspectief. Kan een verscheidenheid aan organisaties en instellingen omvatten, van gemeenschaps- tot overheidsarchieven."},{"@language":"sv","@value":"Samlingar av arkivmaterial och dokument relaterade till svarta queera personer och gemenskaper, eller samlingar av arkivmaterial och dokument relaterade till svarta personer och gemenskaper som kurateras, organiseras och presenteras ur ett queert perspektiv. Kan omfatta arkiv hos allt från lokala gemenskaper till statliga institutioner."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000066"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001163"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001755"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-22"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000968","dc:identifier":"homoit0000968","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ libraries"},{"@language":"es","@value":"Bibliotecas LGBTQ+"},{"@language":"de","@value":"LGBTQ+-Bibliotheken"},{"@language":"nl","@value":"LHBTQ+-bibliotheken"},{"@language":"sv","@value":"Hbtq+-bibliotek"}],"skos:altLabel":[{"@language":"en","@value":"Libraries (LGBTQ)"},{"@language":"es","@value":"Bibliotecas (LGBTQ)"},{"@language":"de","@value":"Bibliotheken für LGBTQ+-Personen"},{"@language":"sv","@value":"Bibliotek (hbtq+)"}],"rdfs:comment":[{"@language":"en","@value":"Libraries that hold materials primarily pertaining to LGBTQ+ people or intended for use by LGBTQ+ people."},{"@language":"es","@value":"Bibliotecas que contienen materiales principalmente relacionados con personas LGBTQ+ o destinados a personas LGBTQ+."},{"@language":"de","@value":"Bibliotheken, die in erster Linie Materialien zu LGBTQ+-Personen und -Themen oder für die Nutzung durch LGBTQ+-Personen bereithalten."},{"@language":"nl","@value":"Bibliotheken met materiaal dat voornamelijk betrekking heeft op LHBTQ+-personen of bedoeld is voor gebruik door LHBTQ+-personen."},{"@language":"sv","@value":"Bibliotek som samlar material som främst rör hbtq+-personer eller som är avsett att användas av hbtq+-personer."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001755"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000156"},{"@id":"https://homosaurus.org/v5/homoit0000501"},{"@id":"https://homosaurus.org/v5/homoit0000749"},{"@id":"https://homosaurus.org/v5/homoit0001182"},{"@id":"https://homosaurus.org/v5/homoit0001418"},{"@id":"https://homosaurus.org/v5/homoit0001513"},{"@id":"https://homosaurus.org/v5/homoit0002748"},{"@id":"https://homosaurus.org/v5/homoit0002794"},{"@id":"https://homosaurus.org/v5/homoit0004425"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000066"},{"@id":"https://homosaurus.org/v5/homoit0000827"},{"@id":"https://homosaurus.org/v5/homoit0001813"},{"@id":"https://homosaurus.org/v5/homoit0002697"},{"@id":"https://homosaurus.org/v5/homoit0003547"},{"@id":"https://homosaurus.org/v5/homoit0003618"},{"@id":"https://homosaurus.org/v5/homoit0004328"},{"@id":"https://homosaurus.org/v5/homoit0004335"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001755"},"dc:replaces":{"@id":"http://homosaurus.org/v2/librariesLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002677","dc:identifier":"homoit0002677","skos:prefLabel":[{"@language":"en","@value":"Two-Spirit archives"},{"@language":"es","@value":"Archivos dos espíritus"},{"@language":"nl","@value":"Two-Spirit archieven"},{"@language":"sv","@value":"Two-spirit-arkiv"}],"skos:altLabel":[{"@language":"en","@value":"2S archives"},{"@language":"en","@value":"Two Spirit archives"},{"@language":"en","@value":"Two Spirited archives"},{"@language":"en","@value":"Two-Spirited archives"}],"rdfs:comment":[{"@language":"en","@value":"Collections of records and materials relating to Two-Spirit people or Two-Spirit communities; can include a variety of organizations and institutions from community to government archives."},{"@language":"es","@value":"Colecciones de registros y materiales relacionados con personas dos espíritus o comunidades dos espíritus; pueden incluir una variedad de organizaciones e instituciones, desde archivos comunitarios hasta gubernamentales."},{"@language":"nl","@value":"Verzamelingen van dossiers en materialen met betrekking tot Two-Spirit people of Two-Spirit gemeenschappen; kan een verscheidenheid aan organisaties en instellingen omvatten, van gemeenschapsarchieven tot overheidsarchieven."},{"@language":"sv","@value":"Samlingar av arkivmaterial och dokument relaterade till Two-spirit-personer eller Two-spirit-gemenskaper. Kan omfatta arkiv hos allt från lokala gemenskaper till statliga institutioner."}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000066"},{"@id":"https://homosaurus.org/v5/homoit0004331"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0002677"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-26"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.or