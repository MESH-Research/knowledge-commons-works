happen"},{"@language":"sv","@value":"Two-spirit-personers deltagande och inkludering i fangemenskaper."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002171"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001480"},{"@id":"https://homosaurus.org/v5/homoit0002181"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001485","dc:identifier":"homoit0001485","skos:prefLabel":[{"@language":"en","@value":"Vaginal dilation"},{"@language":"es","@value":"Dilatación vaginal"},{"@language":"nl","@value":"Vaginaverwijding"},{"@language":"sv","@value":"Vaginal dilatering"}],"skos:altLabel":[{"@language":"sv","@value":"Dilatation av vagina"},{"@language":"sv","@value":"Stavträning"}],"rdfs:comment":[{"@language":"en","@value":"The process of gently and incrementally stretching the vagina using vaginal dilators."},{"@language":"es","@value":"El proceso de estirar suave y progresivamente la vagina utilizando dilatadores vaginales."},{"@language":"nl","@value":"Het proces van het voorzichtig en stapsgewijs strekken van de vagina met behulp van vaginale dilatatoren."},{"@language":"sv","@value":"Processen att varsamt och gradvis tänja ut slidan med hjälp av dilateringsstavar."}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001485"},"dc:replaces":{"@id":"http://homosaurus.org/v2/vaginalDilation"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002858","dc:identifier":"homoit0002858","skos:prefLabel":[{"@language":"en","@value":"Asexual victims' rights"},{"@language":"es","@value":"Derechos de víctimas asexuales"},{"@language":"de","@value":"Asexuelle Opferrechte"},{"@language":"nl","@value":"Slachtofferrechten voor aseksuelen"},{"@language":"sv","@value":"Asexuella brottsoffers rättigheter"}],"skos:altLabel":[{"@language":"de","@value":"Ace Opferrechte"},{"@language":"de","@value":"Rechte asexueller Opfer"}],"rdfs:comment":[{"@language":"en","@value":"Asexual people’s legal rights to be informed, present, and heard within the criminal justice system after having been harmed or injured as the result of a crime, accident, or other event."},{"@language":"es","@value":"Los derechos legales de las personas asexuales a estar informadas, estar presentes y ser escuchadas dentro del sistema de justicia penal después de haber sido perjudicadas o lesionadas como resultado de un delito, una accidente u otro evento."},{"@language":"de","@value":"Das Recht asexueller Personen auf Information, Anwesenheit und Anhörung im Rahmen des Strafrechtssystems, wenn sie infolge eines Verbrechens, eines Unfalls oder eines anderen Ereignisses geschädigt oder verletzt worden sind."},{"@language":"nl","@value":"De wettelijke rechten van aseksuele personen om te worden geïnformeerd, aanwezig te zijn en gehoord te worden binnen het strafrechtsysteem nadat ze zijn geschaad of gewond zijn geraakt als gevolg van een misdrijf, ongeval of andere gebeurtenis."},{"@language":"sv","@value":"Asexuella personers juridiska rättigheter som brottsoffer att få information, närvara och komma till tals inom rättsväsendet efter att ha utsatts för brott, olycka eller annan händelse som orsakat skada."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001492"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000702"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"http