vos"},{"@language":"es","@value":"Gomas"},{"@language":"es","@value":"Profilácticos"},{"@language":"es","@value":"Forros"},{"@language":"nl","@value":"Profylactische middelen"}],"rdfs:comment":[{"@language":"en","@value":"Latex contraceptives used to cover penises during sexual activity for the purposes of preventing STIs and/or pregnancy."},{"@language":"de","@value":"Verhütungsmittel aus Latex, die während des Geschlechtsverkehrs zum Schutz vor sexuell übertragbaren Krankheiten und/oder einer Schwangerschaft über den Penis gezogen werden."},{"@language":"es","@value":"Anticonceptivos de látex utilizados para cubrir penes durante actividad sexual con el fin de prevenir ITS y/o embarazo."},{"@language":"nl","@value":"Latex anticonceptiva gebruikt om penissen te bedekken tijdens seksuele activiteit om soa's en/of zwangerschap te voorkomen"},{"@language":"sv","@value":"Oftast latexbaserade preventivmedel som används för att täcka penis under sexuell aktivitet i syfte att förebygga sexuellt överförbara infektioner och/eller graviditet."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001266"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001251"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85030795"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001266"},"dc:replaces":{"@id":"http://homosaurus.org/v2/condoms"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000300","dc:identifier":"homoit0000300","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ Confucianists"},{"@language":"es","@value":"Confucionistas LGBTQ+"},{"@language":"ja","@value":"LGBTQ+の儒教者"},{"@language":"nl","@value":"LHBTQ+-confucianisten"},{"@language":"sv","@value":"Konfucianister (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"Confucianists (LGBTQ)"},{"@language":"en","@value":"LGBTQ Confucianists"},{"@language":"es","@value":"Confucionistas LGBTQ"},{"@language":"es","@value":"Confucionistas (LGBTQ)"}],"rdfs:comment":[{"@language":"en","@value":"LGBTQ+ people who are Confucianists."},{"@language":"es","@value":"Personas LGBTQ+ que son confucionistas."},{"@language":"ja","@value":"儒教を重んじるLGBTQ+の人々。"},{"@language":"nl","@value":"LHBTQ+-personen die confucianistisch zijn"},{"@language":"sv","@value":"Hbtq+-personer som är konfucianister."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000928"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000928"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQConfucianists"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000301","dc:identifier":"homoit0000301","skos:prefLabel":[{"@language":"en","@value":"Congenital adrenal hyperplasia"},{"@language":"es","@value":"Hiperplasia suprarrenal congénita"},{"@language":"de","@value":"Kongenitale Nebennierenhyperplasie"},{"@language":"nl","@value":"Congenitale adrenale hyperplasie"},{"@language":"sv","@value":"Binjurebarkshyperplasi, medfödd"}],"skos:altLabel":[{"@language":"en","@value":"CAH"},{"@language":"es","@value":"HSC"},{"@language":"de","@value":"Angeborene Nebennierenhyperplasie"},{"@language":"de","@value":"Kongenitale adrenale Hyperplasie"},{"@language":"de","@value":"CAH"},{"@language":"nl","@value":"Congenitale bijnierhyperplasie"},{"@language":"sv","@value":"Medfödd binjurebarkshyperplasi (MBH)"}],"rdfs:comment":[{"@language":"en","@value":"Congenital adrenal hyperplasia (CAH) is a group of different but related genetic variations that affect the enzymes that allow the adrenal glands to make hormones that regulate the body’s functions. People with CAH do not consistently produce the amount of cortisol or aldosterone they need, but they may naturally produce higher-than-typical levels of androgens such as testosterone to help the body compensate. Someone with CAH can be born with XX or XY chromosomes. People with CAH and XY chromosomes are usually not considered to have a variation in sex characteristics since an increased amount of androgens will not cause the development of any characteristics that are not considered typical for people assigned male at birth. In people with XX chromosomes and CAH, the increase in androgen production can result in genital differences such as a larger-than-typical clitoris, fused labia, and the fusion of the urethra and vaginal canal to form a single opening. They may also develop some characteristics like body and facial hair or increased muscle mass during childhood or puberty."},{"@language":"es","@value":"La hiperplasia suprarrenal congénita (HSC) es un grupo de variaciones genéticas diferentes pero relacionadas que afectan las enzimas que permiten a las glándulas suprarrenales producir hormonas que regulan las funciones del cuerpo. Las personas con HSC no producen consistentemente la cantidad de cortisol o aldosterona que necesitan, pero puede que naturalmente produzcan niveles más altos de lo usual de andrógenos, como la testosterona, para ayudar al cuerpo a compensar. Alguien con HSC puede nacer con cromosomas XX o XY. Por lo general, no se considera que las personas con HSC y cromosomas XY tengan una variación en características sexuales, ya que una mayor cantidad de andrógenos no provocará el desarrollo de ninguna característica que no se considere típica de las personas asignadas al sexo masculino al nacer. En personas con HSC y cromosomas XX, el aumento en la producción de andrógenos puede resultar en diferencias genitales, como un clítoris más grande de lo usual, labios fusionados y la fusión de la uretra y el canal vaginal para formar una única apertura. También pueden desarrollar algunas características como vello corporal y facial o aumento de masa muscular durante la infancia o la pubertad."},{"@language":"de","@value":"Die kongenitale Nebennierenhyperplasie (CAH) ist eine Gruppe verschiedener, aber miteinander verbundener genetischer Variationen, die die Enzyme beeinflussen, mit denen die Nebennieren Hormone produzieren, die die Körperfunktionen regulieren. Menschen mit CAH produzieren nicht immer die benötigte Menge an Cortisol oder Aldosteron, aber sie können auf natürliche Weise überdurchschnittlich hohe Mengen an Androgenen wie Testosteron produzieren, um den Körper beim Ausgleich zu unterstützen. Menschen mit CAH können mit XX- oder XY-Chromosomen geboren werden. Bei Menschen mit CAH und XY-Chromosomen wird in der Regel keine Veränderung der Geschlechtsmerkmale angenommen, da eine erhöhte Androgenproduktion nicht zur Entwicklung von Merkmalen führt, die für Menschen, denen bei der Geburt das männliche Geschlecht zugewiesen wurde, nicht als typisch gelten. Bei Menschen mit XX-Chromosomen und CAH kann die erhöhte Androgenproduktion zu genitalen Unterschieden führen, wie z. B. einer überdurchschnittlich großen Klitoris, verwachsenen Schamlippen und einer Verwachsung von Harnröhre und Scheidenkanal zu einer einzigen Öffnung. Sie können auch einige Merkmale wie Körper- und Gesichtsbehaarung oder eine erhöhte Muskelmasse während der Kindheit oder Pubertät entwickeln."},{"@language":"nl","@value":"Congenitale adrenale hyperplasie (CAH) is een groep verschillende, maar verwante genetische variaties die de enzymen beïnvloeden die ervoor zorgen dat de bijnieren hormonen kunnen maken die de lichaamsfuncties reguleren. Mensen met CAH produceren niet consistent de hoeveelheid cortisol of aldosteron die ze nodig hebben, maar ze kunnen van nature hogere niveaus van androgenen zoals testosteron produceren om het lichaam te helpen compenseren. Iemand met CAH kan geboren worden met XX- of XY-chromosomen. Van mensen met CAH- en XY-chromosomen wordt doorgaans niet aangenomen dat ze een variatie in geslachtskenmerken hebben, aangezien een verhoogde hoeveelheid androgenen niet zal leiden tot de ontwikkeling van kenmerken die niet als typisch worden beschouwd voor mensen die bij de geboorte als man zijn toegewezen. Bij mensen met XX chromosomen en CAH kan de toename van de androgeenproductie resulteren in genitale verschillen, zoals een groter dan typische clitoris, gefuseerde schaamlippen en de versmelting van de urethra en het vaginale kanaal om één enkele opening te vormen. Ze kunnen tijdens de kindertijd of de puberteit ook bepaalde kenmerken ontwikkelen, zoals lichaams- en gezichtsbeharing of een grotere spiermassa."},{"@language":"sv","@value":"Kongenital binjurehyperplasi (CAH) är en grupp av genetiska variationer som påverkar de enzymer som gör det möjligt för binjurarna att producera hormoner som reglerar kroppens funktioner. Personer med CAH producerar inte konsekvent den mängd kortisol eller aldosteron de behöver, men de kan naturligt producera högre nivåer av androgener som testosteron för att kompensera. En person med CAH kan födas med två X-kromosomer (46XX) eller en X- och en Y-kromosom (46XY). Personer med CAH och en X- och en Y-kromosom (46XY) betraktas vanligtvis inte som personer med en variation i könskaraktäristika, eftersom den ökade androgenproduktionen inte leder till utveckling av några drag som anses vara atypiska för personer tilldelade manligt kön vid födseln. Hos personer med två X-kromosomer (46XX) och CAH kan den ökade androgenproduktionen däremot leda till genitala variationer såsom en större klitoris än genomsnittet, sammanvuxna blygdläppar och en sammansmältning av urinrör och vaginalkanal till en enda öppning. De kan också utveckla vissa drag som kroppshår, ansiktsbehåring eller ökad muskelmassa under barndom eller pubertet."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000669"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0002827"},{"@id":"https://homosaurus.org/v5/homoit0002869"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85001014"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001269"},"dc:replaces":{"@id":"http://homosaurus.org/v2/congenitalAdrenalHyperplasia"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002827","dc:identifier":"homoit0002827","skos:prefLabel":[{"@language":"en","@value":"Classical congenital adrenal hyperplasia"},{"@language":"es","@value":"Hiperplasia suprarrenal congénita clásica"},{"@language":"de","@value":"Klassische kongenitale Nebennierenhyperplasie"},{"@language":"nl","@value":"Klassieke congenitale adrenale hyperplasie"},{"@language":"sv","@value":"Binjurebarkshyperplasi, medfödd"}],"skos:altLabel":{"@language":"sv","@value":"Adrenal hyperplasi"},"rdfs:comment":[{"@language":"en","@value":"People who have classical congenital adrenal hyperplasia (CAH), a subtype of CAH, have more pronounced issues with cortisol and/or aldosterone production. This variation is likely to be noticed at birth or shortly after."},{"@language":"es","@value":"Las personas que tienen hiperplasia suprarrenal congénita clásica (HSC), un subtipo de HSC, tienen problemas más pronunciados con la producción de cortisol y/o aldosterona. Es probable que esta variación se note al nacer o poco después."},{"@language":"de","@value":"Menschen mit klassischer kongenitaler Nebennierenhyperplasie, einer Unterform der kongenitalen Nebennierenhyperplasie (CAH), haben ausgeprägtere Probleme mit der Cortisol- und/oder Aldosteronproduktion. Diese Abweichung wird meist bei der Geburt oder kurz danach festgestellt."},{"@language":"nl","@value":"Personen met klassieke congenitale adrenale hyperplasie (CAH), een subtype van CAH, hebben meer uitgesproken problemen met de productie van cortisol en/of aldosteron. Deze variatie zal waarschijnlijk bij de geboorte of kort daarna worden opgemerkt."},{"@language":"sv","@value":"Personer med klassisk medfödd binjurehyperplasi (CAH), en undertyp av CAH, har mer uttalade problem med produktionen av kortisol och/eller aldosteron. Denna variation brukar upptäckas vid födseln eller kort därefter."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000301"},"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0002874"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001269"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002869","dc:identifier":"homoit0002869","skos:prefLabel":[{"@language":"en","@value":"Non-classical congenital adrenal hyperplasia"},{"@language":"es","@value":"Hiperplasia suprarrenal congénita tardía"},{"@language":"nl","@value":"Niet-klassieke congenitale adrenale hyperplasie"},{"@language":"sv","@value":"Atypisk kongenital adrenal hyperplasi"}],"skos:altLabel":[{"@language":"en","@value":"Late-onset congenital adrenal hyperplasia"},{"@language":"sv","@value":"Icke klassisk kongenital adrenal hyperplasi"},{"@language":"sv","@value":"NCAH"}],"rdfs:comment":[{"@language":"en","@value":"Non-classical congenital adrenal hyperplasia (CAH), a subtype of CAH, does not usually become apparent until later in childhood, adolescence, or even young adulthood."},{"@language":"es","@value":"La hiperplasia suprarrenal congénita no clásica (CAH, por sus siglas en inglés), un subtipo de CAH, generalmente no se hace evidente hasta más tarde en la infancia, la adolescencia o incluso en la edad adulta."},{"@language":"nl","@value":"Niet-klassieke congenitale adrenale hyperplasie (CAH), een subtype van CAH, wordt gewoonlijk pas later in de kindertijd, de adolescentie of zelfs de jonge volwassenheid duidelijk."},{"@language":"sv","@value":"Atypisk kongenital adrenal hyperplasi är en undergrupp av adrenogenitalt syndrom (CAH). Till skillnad från CAH är enzymproduktionen nedsatt men inte obefintlig vilket resulterar i att symtomen blir framträdande senare i barndomen, tonåren eller i ung vuxen ålder. Symtomen beror på ett överskott av androgener."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000301"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001269"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002844","dc:identifier":"homoit0002844","skos:prefLabel":[{"@language":"en","@value":"Informed consent"},{"@language":"es","@value":"Consentimiento informado"},{"@language":"nl","@value":"Informed consent"},{"@language":"sv","@value":"Informerat samtycke"}],"rdfs:comment":[{"@language":"en","@value":"The practice of weighing all options and considering evidence, alternatives, and potential risks in order to make a truly informed medical decision. Such decisions are best made over a period of time rather than under pressure."},{"@language":"es","@value":"La práctica de sopesar todas las opciones y considerar evidencia, alternativas y riesgos potenciales para tomar una decisión médica verdaderamente informada. Se dan mejor esas tomas de decisiones durante un período de tiempo en lugar de bajo presión."},{"@language":"nl","@value":"De praktijk van het afwegen van alle opties en het overwegen van bewijsmateriaal, alternatieven en potentiële risico's om een echt geïnformeerde medische beslissing te nemen. Dergelijke beslissingen kunnen het beste over een bepaalde periode worden genomen, in plaats van onder druk."},{"@language":"sv","@value":"Praxis där alla alternativ vägs in och där evidens, alternativ och möjliga risker beaktas för att möjliggöra ett verkligt informerat medicinskt beslut. Sådana beslut fattas bäst över tid snarare än under press."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000302"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001004"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000302"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000938","dc:identifier":"homoit0000938","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ sexual abuse"},{"@language":"es","@value":"Abuso sexual LGBTQ+"},{"@language":"nl","@value":"LHBTQ+-seksueel misbruik"},{"@language":"sv","@value":"Sexuella övergrepp (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"LGBTQ sexual abuse"},{"@language":"es","@value":"Abuso sexual LGBTQ"}],"rdfs:comment":[{"@language":"en","@value":"Acts of sexual abuse and violence directed towards LGBTQ+ people."},{"@language":"es","@value":"Actos de abuso y violencia sexual dirigidos a personas LGBTQ+."},{"@language":"nl","@value":"Daden van seksueel misbruik en geweld gericht tegen LHBTQ+-personen."},{"@language":"sv","@value":"Sexuella övergrepp och våldshandlingar riktade mot hbtq+-personer."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001305"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000302"},{"@id":"https://homosaurus.org/v5/homoit0000855"},{"@id":"https://homosaurus.org/v5/homoit0000959"},{"@id":"https://homosaurus.org/v5/homoit0001351"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001305"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQSexualAbuse"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001123","dc:identifier":"homoit0001123","skos:prefLabel":[{"@language":"en","@value":"Polyamory"},{"@language":"es","@value":"Poliamor"},{"@language":"nl","@value":"Polyamory"},{"@language":"sv","@value":"Polyamori"}],"rdfs:comment":[{"@language":"en","@value":"Practice of engaging in romantic, sexual, or play relationships with more than one person simultaneously, with the knowledge and consent of all parties involved."},{"@language":"es","@value":"Práctica de entablar relaciones románticas, sexuales o de juego con más de una persona simultáneamente, con el conocimiento y consentimiento de todas las partes involucradas."},{"@language":"nl","@value":"Praktijk van het aangaan van romantische relaties met meer dan één persoon tegelijk met medeweten en toestemming van alle betrokken partijen"},{"@language":"sv","@value":"Praktiken att ha romantiska, sexuella eller kinkrelaterade relationer med flera personer samtidigt, med samtycke från alla inblandade."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001651"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0001554"},{"@id":"https://homosaurus.org/v5/homoit0001629"},{"@id":"https://homosaurus.org/v5/homoit0001662"},{"@id":"https://homosaurus.org/v5/homoit0004441"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000302"},{"@id":"https://homosaurus.org/v5/homoit0000603"},{"@id":"https://homosaurus.org/v5/homoit0001124"},{"@id":"https://homosaurus.org/v5/homoit0001295"},{"@id":"https://homosaurus.org/v5/homoit0001558"},{"@id":"https://homosaurus.org/v5/homoit0001645"},{"@id":"https://homosaurus.org/v5/homoit0001649"},{"@id":"https://homosaurus.org/v5/homoit0001657"},{"@id":"https://homosaurus.org/v5/homoit0001661"},{"@id":"https://homosaurus.org/v5/homoit0001663"},{"@id":"https://homosaurus.org/v5/homoit0001664"},{"@id":"https://homosaurus.org/v5/homoit0002255"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001636"},"dc:replaces":{"@id":"http://homosaurus.org/v2/polyamory"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001124","dc:identifier":"homoit0001124","skos:prefLabel":[{"@language":"en","@value":"Polygamy"},{"@language":"es","@value":"Poligamia"},{"@language":"nl","@value":"Polygamie"},{"@language":"sv","@value":"Polygami"}],"rdfs:comment":[{"@language":"en","@value":"The practice of engaging in romantic, sexual, or play relationships where the dominant partner has multiple spouses, though these marriages are not always recognized by law or within society."},{"@language":"es","@value":"La práctica de entablar relaciones románticas, sexuales o de juego en las que la pareja dominante tiene varios cónyuges, aunque estos matrimonios no siempre son reconocidos por la ley o dentro de la sociedad."},{"@language":"nl","@value":"het gelijktijdig gehuwd zijn met twee of meer partners"},{"@language":"sv","@value":"Praktiken att ingå i romantiska, sexuella eller kinkrelaterade relationer där den dominerande partnern har flera makar, även om dessa äktenskap inte alltid erkänns juridiskt eller socialt."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001081"},{"@id":"https://homosaurus.org/v5/homoit0001302"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000302"},{"@id":"https://homosaurus.org/v5/homoit0000603"},{"@id":"https://homosaurus.org/v5/homoit0001123"},{"@id":"https://homosaurus.org/v5/homoit0001295"},{"@id":"https://homosaurus.org/v5/homoit0002255"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85104627"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001300"},"dc:replaces":{"@id":"http://homosaurus.org/v2/polygamy"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002195","dc:identifier":"homoit0002195","skos:prefLabel":[{"@language":"en","@value":"Rape/non-con (Content warning)"},{"@language":"es","@value":"Violación/No consentimento (Advertencia de contenido)"},{"@language":"nl","@value":"Verkrachting/non-con (Inhoudswaarschuwing)"},{"@language":"sv","@value":"Våldtäkt/övergrepp (innehållsvarning)"}],"skos:altLabel":[{"@language":"en","@value":"Non-consensual (Content warning)"},{"@language":"en","@value":"Rape (Content warning)"},{"@language":"es","@value":"No consensual (advertencia de contenido)"},{"@language":"es","@value":"Violación (advertencia de contenido)"},{"@language":"nl","@value":"Verkrachting (Inhoudswaarschuwing)"},{"@language":"sv","@value":"Rape/non-con (Content warning)"}],"rdfs:comment":[{"@language":"en","@value":"A content warning applied to fanworks to signal the presence of rape, non-consensual sexual encounters, or dubiously consensual sexual encounters."},{"@language":"es","@value":"Una advertencia de contenido aplicada a obras de fans para señalar la presencia de la violación, encuentros sexuales no consensuales o encuentros sexuales dudosamente consensuados."},{"@language":"nl","@value":"Een inhoudswaarschuwing toegepast op fanwerken om de aanwezigheid van verkrachting, seksuele ontmoetingen zonder wederzijds goedvinden of twijfelachtige seksuele ontmoetingen met wederzijds goedvinden aan te geven"},{"@language":"sv","@value":"Innehållsvarning som används för fanverk som innehåller våldtäkt, icke-samtyckande sex eller situationer där samtycke är tveksamt."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001807"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000302"},{"@id":"https://homosaurus.org/v5/homoit0000958"},{"@id":"https://homosaurus.org/v5/homoit0000959"},{"@id":"https://homosaurus.org/v5/homoit0001305"},{"@id":"https://homosaurus.org/v5/homoit0001350"},{"@id":"https://homosaurus.org/v5/homoit0001351"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003512","dc:identifier":"homoit0003512","skos:prefLabel":[{"@language":"en","@value":"Gender conversion therapy"},{"@language":"de","@value":"Gender-Konversionstherapie"},{"@language":"es","@value":"Terapia de conversión de género"},{"@language":"nl","@value":"Gender conversietherapie"},{"@language":"sv","@value":"Könsidentitetsomvändelseterapi"}],"skos:altLabel":[{"@language":"en","@value":"Conversion therapy for gender"},{"@language":"en","@value":"Conversion therapy for trans people"},{"@language":"en","@value":"Conversion therapy for transgender people"},{"@language":"en","@value":"Gender reorientation therapy"},{"@language":"en","@value":"Trans conversion therapy"},{"@language":"en","@value":"Transgender conversion therapy"},{"@language":"de","@value":"Geschlechtskonversionstherapie"},{"@language":"es","@value":"Terapia de conversion de género"},{"@language":"es","@value":"Terapia de conversión para personas trans"},{"@language":"es","@value":"Terapia de conversación para personas transgénero"},{"@language":"es","@value":"Terapia de reorientacion de género"},{"@language":"es","@value":"Terapia de conversión trans"},{"@language":"es","@value":"Terapia de conversión transgénero"},{"@language":"nl","@value":"Conversietherapie voor trans personen"},{"@language":"nl","@value":"Conversietherapie voor transgender personen"},{"@language":"nl","@value":"Gender heroriëntatie therapie"},{"@language":"nl","@value":"Trans conversietherapie"},{"@language":"nl","@value":"Transgender conversietherapie"},{"@language":"sv","@value":"Gender conversion therapy"}],"rdfs:comment":[{"@language":"en","@value":"Efforts to change the gender identity of a transgender or non-binary person to meet cisgender norms, typically under the belief that their identity is dangerous and/or the result of mental illness or trauma. The processes involved in conversion therapy include visualization training, spiritual interventions, and other aversion treatments. "},{"@language":"de","@value":"Bemühungen, die Geschlechtsidentität einer trans oder nichtbinären Person zu ändern, um sie den cis Normen anzupassen, typischerweise in der Überzeugung, dass ihre Identität gefährlich und/oder das Ergebnis einer psychischen Erkrankung oder eines Traumas ist. Zu den Verfahren der Konversionstherapie gehören Visualisierungstraining, spirituelle Interventionen und andere Aversionsbehandlungen."},{"@language":"es","@value":"Esfuerzos por cambiar la identidad de género de una persona transgénero o no binaria para que se ajuste a las normas cisgénero, normalmente bajo la creencia de que su identidad es peligrosa y/o el resultado de una enfermedad mental o un trauma. Los procesos implicados en la terapia de conversión incluyen entrenamiento de visualización, intervenciones espirituales y otros tratamientos de aversión."},{"@language":"nl","@value":"Pogingen om de genderidentiteit van een transgender of non-binair persoon te veranderen om te voldoen aan cisgendernormen, meestal in de veronderstelling dat hun identiteit gevaarlijk is en/of het resultaat van een psychische aandoening of trauma. De processen die betrokken zijn bij conversietherapie omvatten visualisatietraining, spirituele interventies en andere aversiebehandelingen."},{"@language":"sv","@value":"Försök att förändra könsidentiteten hos en transperson eller ickebinär person för att anpassa den till ciskönade normer, ofta grundade i föreställningen att personens identitet är farlig och/eller ett resultat av psykisk ohälsa eller trauma. De processer som ingår i omvändelseterapi omfattar styrda visualiseringsövningar, andliga interventioner och andra metoder som syftar till att framkalla obehag eller bestraffning."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000303"},"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2006004076"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001004"},"dc:issued":{"@type":"xsd:date","@value":"2024-07-31"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000304","dc:identifier":"homoit0000304","skos:prefLabel":[{"@language":"en","@value":"Second parent adoption"},{"@language":"es","@value":"Adopción por segundo padrx"},{"@language":"nl","@value":"Tweede-ouderadoptie"},{"@language":"sv","@value":"Närståendeadoption"}],"skos:altLabel":[{"@language":"en","@value":"Co-parent adoption"},{"@language":"es","@value":"Adopción co-parental"},{"@language":"es","@value":"Adopción por segundo padre"}],"rdfs:comment":[{"@language":"en","@value":"An adoption process by which a legal child-parent relationship is established by granting the “second” parent the same rights as the “first” parent without the “first” or legal parent relinquishing any parental rights. A second or co-parent adoption can be important for LGBTQ+ parents to protect their parental rights as the relationship of the non-biological parent may not be recognized in some jurisdictions without such an adoption."},{"@language":"es","@value":"Un proceso de adopción mediante el cual se establece una relación legal entre padres y/o madres e hijos otorgando al “segundo” padre los mismos derechos que al “primer” padre y/o madre sin que el “primer” padre y/o madre o padre y/o madre legal renuncie a ningún derecho de paternidad. Una segunda adopción o una adopción conjunta puede ser importante para que los padres LGBTQ+ protejan sus derechos de paternidad, ya que la relación del padre y/o madre no biológico puede no ser reconocida en algunas jurisdicciones sin dicha adopción."},{"@language":"nl","@value":"Een adoptieproces waarbij een wettelijke kind-ouderrelatie tot stand komt door de \"tweede\" ouder dezelfde rechten te verlenen als de \"eerste\" ouder zonder dat de \"eerste\" of wettelijke ouder afstand doet van ouderlijke rechten. Een adoptie door een tweede of co-ouder kan belangrijk zijn voor LHBTQ+-ouders om hun ouderlijke rechten te beschermen, aangezien de relatie van de niet-biologische ouder in sommige rechtsgebieden mogelijk niet wordt erkend zonder een dergelijke adoptie."},{"@language":"sv","@value":"En adoptionsprocess där ett juridiskt barn-förälder-förhållande etableras genom att den ”andra” föräldern får samma juridiska rättigheter som den ”första”, utan att den förstnämnda förlorar sina föräldrarättigheter. Detta kan vara särskilt viktigt för hbtq+-föräldrar för att skydda den icke-biologiska förälderns rättigheter."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000809"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000918"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000864"},"dc:replaces":{"@id":"http://homosaurus.org/v2/secondParentAdoption"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000597","dc:identifier":"homoit0000597","skos:prefLabel":[{"@language":"en","@value":"Urine play"},{"@language":"es","@value":"Juego de orina"},{"@language":"nl","@value":"Urinespel"},{"@language":"sv","@value":"Urinsex"}],"skos:altLabel":[{"@language":"en","@value":"Golden showers"},{"@language":"en","@value":"Pissing sex"},{"@language":"en","@value":"Undinism"},{"@language":"en","@value":"Urolagnia"},{"@language":"en","@value":"Clothes wetting"},{"@language":"en","@value":"Omorashi"},{"@language":"en","@value":"Piss play"},{"@language":"en","@value":"Urophilia"},{"@language":"en","@value":"Water sports"},{"@language":"en","@value":"Watersports"},{"@language":"es","@value":"Golden showers"},{"@language":"es","@value":"Watersports"},{"@language":"es","@value":"Juego con orina"},{"@language":"nl","@value":"Omorashi"},{"@language":"nl","@value":"Pisseks"},{"@language":"nl","@value":"Plasseks"},{"@language":"nl","@value":"Urofilie"},{"@language":"nl","@value":"Urolagnie"},{"@language":"sv","@value":"Golden showers"},{"@language":"sv","@value":"Undinism"},{"@language":"sv","@value":"Urolagni"},{"@language":"sv","@value":"Water sports"},{"@language":"sv","@value":"Wet (sex)"}],"rdfs:comment":[{"@language":"en","@value":"Use of urine and urination for sexual or erotic pleasure."},{"@language":"es","@value":"Uso de la orina y la micción para placer sexual o erótico."},{"@language":"nl","@value":"Gebruik van urine en urineren voor seksueel of erotisch genot."},{"@language":"sv","@value":"Användning av urin och urinering för sexuell eller erotisk njutning."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000442"},{"@id":"https://homosaurus.org/v5/homoit0001267"},{"@id":"https://homosaurus.org/v5/homoit0001299"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000305"},{"@id":"https://homosaurus.org/v5/homoit0003061"},{"@id":"https://homosaurus.org/v5/homoit0003062"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000404"},"dc:replaces":{"@id":"http://homosaurus.org/v2/waterSports"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000306","dc:identifier":"homoit0000306","skos:prefLabel":[{"@language":"en","@value":"Corrective rape"},{"@language":"es","@value":"Violación correctiva"},{"@language":"de","@value":"Korrigierende Vergewaltigung"},{"@language":"nl","@value":"Correctieve verkrachting"},{"@language":"sv","@value":"Korrigerande våldtäkt"}],"skos:altLabel":{"@language":"de","@value":"Korrekturvergewaltigung"},"rdfs:comment":[{"@language":"en","@value":"Criminal practice in which men rape lesbians, sometimes under the supervision of members of the women's families or local communities, with the purported purpose of \"curing\" them of homosexuality."},{"@language":"es","@value":"Práctica criminal en la que hombres violan a lesbianas, a veces bajo la supervisión de miembros de las familias de las mujeres o de las comunidades locales, con el supuesto propósito de \"curarlas\" de la homosexualidad."},{"@language":"de","@value":"Kriminelle Praxis, bei der Männer Lesben vergewaltigen, manchmal unter Aufsicht von Mitgliedern der Familien der Frauen oder lokaler Gemeinschaften, mit dem angeblichen Ziel, sie von ihrer Homosexualität zu „heilen“."},{"@language":"nl","@value":"verkrachting van lesbische vrouwen om hen te 'genezen' van hun homoseksualiteit"},{"@language":"sv","@value":"Kriminell praktik där män våldtar lesbiska, ibland under övervakning av medlemmar i kvinnornas familjer eller lokala gemenskaper, med det påstådda syftet att ”bota” dem från homosexualitet."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001305"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000783"},{"@id":"https://homosaurus.org/v5/homoit0000793"},{"@id":"https://homosaurus.org/v5/homoit0003444"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001305"},"dc:replaces":{"@id":"http://homosaurus.org/v2/correctiveRape"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000783","dc:identifier":"homoit0000783","skos:prefLabel":[{"@language":"en","@value":"Lesbian survivors of rape"},{"@language":"es","@value":"Sobrevivientes lesbianas de violación"},{"@language":"fr","@value":"Lesbiennes survivantes de viol"},{"@language":"nl","@value":"Lesbische overlevenden van verkrachting"},{"@language":"sv","@value":"Lesbiska våldtäktsöverlevare"}],"skos:altLabel":{"@language":"es","@value":"Lesbianas sobrevivientes de violación"},"rdfs:comment":[{"@language":"en","@value":"Lesbians who have experienced and survived rape; follow the individual's preference for \"victims\" or \"survivors\" whenever possible."},{"@language":"es","@value":"Lesbianas que han sufrido y sobrevivido una violación; siga la preferencia de la persona sobre el uso de \"víctimas\" o \"sobrevivientes\" siempre que sea posible."},{"@language":"nl","@value":"Lesbische vrouwen die verkrachting hebben meegemaakt en overleefd; volg waar mogelijk de voorkeur van het individu voor \"slachtoffers\" of \"overlevenden\"."},{"@language":"sv","@value":"Lesbiska som har upplevt och överlevt våldtäkt. Följ individens preferens för att använda ”offer” eller ”överlevare” när det är möjligt."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000793"},{"@id":"https://homosaurus.org/v5/homoit0001350"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000306"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianSurvivorsOfRape"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000793","dc:identifier":"homoit0000793","skos:prefLabel":[{"@language":"en","@value":"Lesbian victims of rape"},{"@language":"es","@value":"Víctimas lesbianas de violación"},{"@language":"fr","@value":"Lesbiennes victimes de viol"},{"@language":"nl","@value":"Lesbische slachtoffers van verkrachting"},{"@language":"sv","@value":"Lesbiska våldtäktsoffer"}],"skos:altLabel":{"@language":"es","@value":"Víctimas lésbicas de violación"},"rdfs:comment":[{"@language":"en","@value":"Lesbians who have experienced rape and may or may not have survived; follow the individual's preference for \"victims\" or \"survivors\" whenever possible."},{"@language":"es","@value":"Lesbianas que han sufrido una violación y que pueden o no haber sobrevivido; siga la preferencia de la persona sobre el uso de \"víctimas\" o \"sobrevivientes\" siempre que sea posible."},{"@language":"fr","@value":"Personnes lesbiennes qui ont été victimes de viol et qui peuvent ou non avoir survécu; respecter la préférence de la personne concernée entre les termes « victimes » ou « survivantes » dans la mesure du possible."},{"@language":"nl","@value":"Lesbische vrouwen die verkrachting hebben meegemaakt en het al dan niet hebben overleefd; volg waar mogelijk de voorkeur van het individu voor \"slachtoffers\" of \"overlevenden\""},{"@language":"sv","@value":"Lesbiska som har upplevt våldtäkt och som kan ha överlevt eller inte. Följ individens preferens för att använda ”offer” eller ”överlevare” när det är möjligt."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000958"},"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0000783"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000306"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianVictimsOfRape"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003444","dc:identifier":"homoit0003444","skos:prefLabel":[{"@language":"en","@value":"Rape culture"},{"@language":"nl","@value":"Verkrachtingscultuur"},{"@language":"sv","@value":"Våldtäktskultur"}],"skos:altLabel":[{"@language":"en","@value":"Rape-supportive culture"},{"@language":"nl","@value":"Rape culture"}],"rdfs:comment":[{"@language":"en","@value":"A term used in gender studies and feminist writing to describe a setting or culture in which sexual violence is pervasive and normalized due to attitudes about gender and sexuality."},{"@language":"nl","@value":"Een term die in genderstudies en feministische literatuur wordt gebruikt om een ​​situatie of cultuur te beschrijven waarin seksueel geweld wijdverbreid is en genormaliseerd wordt vanwege opvattingen over gender en seksualiteit."},{"@language":"sv","@value":"Begrepp som används inom genusvetenskap och feministisk teori för att beskriva kulturer där sexuellt våld är utbrett och normaliserat genom attityder kring kön och sexualitet."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002039"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000306"},{"@id":"https://homosaurus.org/v5/homoit0001285"},{"@id":"https://homosaurus.org/v5/homoit0001305"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2019103596"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001365"},"dc:issued":{"@type":"xsd:date","@value":"2024-07-31"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000307","dc:identifier":"homoit0000307","skos:prefLabel":[{"@language":"en","@value":"Corsets"},{"@language":"es","@value":"Corsés"},{"@language":"de","@value":"Korsett"},{"@language":"nl","@value":"Korsetten"},{"@language":"sv","@value":"Korsetter"}],"skos:altLabel":[{"@language":"en","@value":"Bondage corsets"},{"@language":"en","@value":"Tightlacing"},{"@language":"es","@value":"Corsets"},{"@language":"es","@value":"Fajas"},{"@language":"de","@value":"Mieder"},{"@language":"de","@value":"Schnürbrust"},{"@language":"de","@value":"Korsage"}],"rdfs:comment":[{"@language":"en","@value":"A garment worn to hold and train the torso into a desired shape, traditionally a smaller waist or larger bottom, for aesthetic purposes (either for the duration of wearing it or with a more lasting effect), or to support the breasts."},{"@language":"es","@value":"Vestiduras ajustadas que se utilizan sobre el pecho y/o el estómago, generalmente con fines estéticos o médicos."},{"@language":"de","@value":"Ein Kleidungsstück, um den Oberkörper in eine gewünschte Form zu bringen und zu halten, traditionell eine schmalere Taille oder ein größeres Gesäß, aus ästhetischen Gründen (entweder für die Dauer des Tragens oder mit einer länger anhaltenden Wirkung) oder um die Brüste zu stützen."},{"@language":"nl","@value":"Een kledingstuk dat wordt gedragen om de romp in de gewenste vorm te houden en te trainen, traditioneel een kleinere taille of een grotere onderkant, voor esthetische doeleinden (hetzij voor de duur van het dragen, hetzij met een langduriger effect), of om de borsten te ondersteunen."},{"@language":"sv","@value":"Ett plagg som bärs för att forma torson till en önskad form, traditionellt för att skapa en smalare midja eller större höfter, i estetiskt syfte (antingen under användning eller med mer varaktig effekt), eller för att ge stöd åt brösten."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0003059"},{"@id":"https://homosaurus.org/v5/homoit0003066"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0003076"},{"@id":"https://homosaurus.org/v5/homoit0003113"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85033068"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000404"},"dc:replaces":{"@id":"http://homosaurus.org/v2/corsets"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000308","dc:identifier":"homoit0000308","skos:prefLabel":[{"@language":"en","@value":"Cottages (Gay culture)"},{"@language":"es","@value":"Cottages (Cultura gay)"},{"@language":"de","@value":"Cottages (schwule Kontext)"},{"@language":"nl","@value":"Pisbakken"},{"@language":"sv","@value":"Cottages (bögkultur)"}],"skos:altLabel":[{"@language":"en","@value":"Public urinals"},{"@language":"en","@value":"Cottages"},{"@language":"es","@value":"Urinarios públicos"},{"@language":"es","@value":"Baños públicos"},{"@language":"de","@value":"Öffentliche Toiletten"},{"@language":"de","@value":"Klappen"}],"rdfs:comment":[{"@language":"en","@value":"UK slang term for public bathrooms used as locations for sexual encounters, particularly by gay men."},{"@language":"es","@value":"Término de la jerga británica para referirse a los baños públicos utilizados como lugares para encuentros sexuales, especialmente entre hombres gay."},{"@language":"de","@value":"Britischer Slangbegriff für öffentliche Toiletten, die als Orte für sexuelle Begegnungen genutzt werden, insbesondere von schwulen Männern."},{"@language":"sv","@value":"Brittisk slangterm för offentliga toaletter som används som platser för sexuella möten, särskilt av bögar."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000974"},"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0000595"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000309"},{"@id":"https://homosaurus.org/v5/homoit0001140"},{"@id":"https://homosaurus.org/v5/homoit0001358"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000974"},"dc:replaces":{"@id":"http://homosaurus.org/v2/cottages"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000595","dc:identifier":"homoit0000595","skos:prefLabel":[{"@language":"en","@value":"Glory holes"},{"@language":"es","@value":"Agujeros gloriosos"},{"@language":"de","@value":"Glory Holes"},{"@language":"nl","@value":"Glory holes"},{"@language":"sv","@value":"Glory hole"}],"skos:altLabel":[{"@language":"es","@value":"Gloriosos agujeros"},{"@language":"de","@value":"Gloryhole"}],"rdfs:comment":[{"@language":"en","@value":"Holes through walls or partitions, such as public bathroom stalls, that allow people to perform or observe sex acts, typically anonymously. Often associated with gay male culture due to the historical and ongoing use of glory holes by closeted gay men to facilitate oral or anal sex without the risk of identification or arrest."},{"@language":"es","@value":"Agujeros en paredes o tabiques, como en puestos de baños públicos, que permiten a las personas realizar u observar actos sexuales, generalmente de forma anónima. A menudo se asocian con la cultura masculina gay debido al uso histórico y continuo de agujeros gloriosos por parte de hombres gay en el clóset para facilitar el sexo oral o anal sin riesgo de identificación o arresto."},{"@language":"de","@value":"Löcher in Wänden oder Trennwänden, beispielsweise in öffentlichen Toilettenkabinen, durch die Personen anonym sexuelle Handlungen vornehmen oder beobachten können. Aufgrund der historischen und bis heute andauernden Nutzung von Glory Holes durch ungeoutete Homosexuelle, um Oral- oder Analsex ohne das Risiko einer Identifizierung oder Verhaftung zu ermöglichen, werden sie häufig mit der schwulen Kultur in Verbindung gebracht."},{"@language":"nl","@value":"Gaten door muren of scheidingswanden, zoals openbare toiletten, waardoor mensen seksuele handelingen kunnen verrichten of observeren, meestal anoniem. Vaak geassocieerd met homocultuur vanwege het historische en voortdurende gebruik van glory holes door homomannen in de kast om orale of anale seks mogelijk te maken zonder het risico van identificatie of arrestatie."},{"@language":"sv","@value":"Hål genom väggar eller avskärmningar, t.ex. i offentliga toalettbås, som möjliggör att personer kan utföra eller observera sexuella handlingar, ofta anonymt. Förknippas ofta med bögkultur på grund av glory holes historiska och pågående användning av icke-öppna bögar som ett sätt att ha oral- eller analsex utan risk för identifiering eller gripande."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000308"},{"@id":"https://homosaurus.org/v5/homoit0000475"},{"@id":"https://homosaurus.org/v5/homoit0001140"},{"@id":"https://homosaurus.org/v5/homoit0001358"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001299"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000974"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gloryHoles"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001358","dc:identifier":"homoit0001358","skos:prefLabel":[{"@language":"en","@value":"Tearooms (Gay culture)"},{"@language":"es","@value":"Tearooms (Cultura gay)"},{"@language":"nl","@value":"Urinoirs"},{"@language":"sv","@value":"Offentliga toaletter (bögkultur)"}],"skos:altLabel":[{"@language":"en","@value":"Tearooms"},{"@language":"es","@value":"Tearooms"},{"@language":"es","@value":"Salones de té"},{"@language":"sv","@value":"Mojar"},{"@language":"sv","@value":"Pisskurar"},{"@language":"sv","@value":"Pissmojar"},{"@language":"sv","@value":"Pissoarer"}],"rdfs:comment":[{"@language":"en","@value":"U.S. slang term for public bathrooms that are used as locations for sexual encounters."},{"@language":"es","@value":"Término de la jerga estadounidense para los baños públicos que se utilizan como lugar para encuentros sexuales."},{"@language":"sv","@value":"Offentliga toaletter som används som plats för sexuella möten."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000974"},"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0000595"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000308"},{"@id":"https://homosaurus.org/v5/homoit0001140"},{"@id":"https://homosaurus.org/v5/homoit0001357"}],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2008001734"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000974"},"dc:replaces":{"@id":"http://homosaurus.org/v2/tearooms"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001142","dc:identifier":"homoit0001142","skos:prefLabel":[{"@language":"en","@value":"Public sex"},{"@language":"es","@value":"Sexo en público"},{"@language":"nl","@value":"Publieke seks"},{"@language":"sv","@value":"Offentligt sex"}],"rdfs:comment":[{"@language":"en","@value":"Sex in public places such as beaches, parks, cottages, etc."},{"@language":"es","@value":"Sexo en lugares públicos, como playas, parques, cabañas, etc."},{"@language":"nl","@value":"het verrichten van seksuele handelingen buiten de privé-sfeer, eventueel in de openbare ruimte"},{"@language":"sv","@value":"Sexuella handlingar som sker på offentliga platser, såsom stränder, parker eller rastplatser."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001299"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000309"},{"@id":"https://homosaurus.org/v5/homoit0000319"},{"@id":"https://homosaurus.org/v5/homoit0000412"},{"@id":"https://homosaurus.org/v5/homoit0000475"},{"@id":"https://homosaurus.org/v5/homoit0000900"},{"@id":"https://homosaurus.org/v5/homoit0000974"},{"@id":"https://homosaurus.org/v5/homoit0001257"},{"@id":"https://homosaurus.org/v5/homoit0001306"},{"@id":"https://homosaurus.org/v5/homoit0001357"}],"skos:exactMatch":{"