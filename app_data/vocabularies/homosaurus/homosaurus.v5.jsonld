hers"},{"@language":"es","@value":"Madres intersexuales"},{"@language":"nl","@value":"Intersekse moeders"},{"@language":"sv","@value":"Intersexmammor"}],"skos:altLabel":[{"@language":"es","@value":"Madres intersex"},{"@language":"es","@value":"Mamás intersexuales"},{"@language":"sv","@value":"Intersexmödrar"}],"rdfs:comment":[{"@language":"en","@value":"Intersex people who are mothers. Only use to describe individuals who identify as mothers."},{"@language":"es","@value":"Personas intersex que son madres. Utilícese únicamente para describir a personas que se autoidentifiquen como madres."},{"@language":"nl","@value":"Intersekse personen die moeder zijn. Alleen gebruiken om personen te beschrijven die zich identificeren als moeders."},{"@language":"sv","@value":"Intersexpersoner som är mammor. Används endast för personer som själva identifierar sig som mammor."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001021"},{"@id":"https://homosaurus.org/v5/homoit0001763"},{"@id":"https://homosaurus.org/v5/homoit0002343"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000421"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-30"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003243","dc:identifier":"homoit0003243","skos:prefLabel":[{"@language":"en","@value":"Two-Spirit mothers"},{"@language":"es","@value":"Madres dos espíritus"},{"@language":"nl","@value":"Two-Spirit moeders"},{"@language":"sv","@value":"Two-spirit-mammor"}],"skos:altLabel":[{"@language":"en","@value":"2S mothers"},{"@language":"en","@value":"Two Spirit mothers"},{"@language":"en","@value":"Two Spirited mothers"},{"@language":"en","@value":"Two-Spirited mothers"},{"@language":"sv","@value":"Two-spirit-mödrar"}],"rdfs:comment":[{"@language":"en","@value":"Two-Spirit people who are mothers. Only use to describe individuals who identify as mothers."},{"@language":"es","@value":"Personas dos espíritus que son madres. Utilícese únicamente para describir a personas que se autoidentifican como madres."},{"@language":"nl","@value":"Two-Spirit mensen die moeders zijn. Alleen te gebruiken om individuen te beschrijven die zich identificeren als moeders."},{"@language":"sv","@value":"Two-spirit-personer som är mammor. Används endast för personer som själva identifierar sig som mammor."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001021"},{"@id":"https://homosaurus.org/v5/homoit0001764"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001760"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000421"},"dc:issued":{"@type":"xsd:date","@value":"2024-05-24"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001022","dc:identifier":"homoit0001022","skos:prefLabel":[{"@language":"en","@value":"Mothers of bisexual people"},{"@language":"es","@value":"Madres de personas bisexuales"},{"@language":"fr","@value":"Mères de personnes bisexuelles"},{"@language":"nl","@value":"Moeders van biseksuele personen"},{"@language":"sv","@value":"Mammor till bisexuella"}],"skos:altLabel":[{"@language":"es","@value":"Mamás de personas bisexuales"},{"@language":"sv","@value":"Mödrar till bisexuella"}],"rdfs:comment":[{"@language":"en","@value":"A person who assumes the role of mother to a bisexual person; use only for individuals who self-identify as mothers."},{"@language":"es","@value":"Una persona que asume el rol de madre de una persona bisexual; utilícese únicamente para personas que se autoidentifiquen como madres."},{"@language":"fr","@value":"Personnes qui jouent le rôle de mère auprès d'une personne bisexuelle; à utiliser uniquement pour les personnes qui s'identifient elles-mêmes comme mères."},{"@language":"nl","@val