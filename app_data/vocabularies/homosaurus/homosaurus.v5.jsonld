emoirs"},{"@language":"es","@value":"Memorias transgénero"},{"@language":"nl","@value":"Transgender memoires"}],"rdfs:comment":[{"@language":"en","@value":"Accounts of trans peoples' lives written by those people. For written accounts of trans people's lives that were not written by the subject, use \"Transgender biographies.\""},{"@language":"es","@value":"Relatos de vida de personas escritos por esas mismas personas; utilícese para autobiografías escritas por autores transgénero."},{"@language":"nl","@value":"Verslagen van het leven van transgender personen, geschreven door die personen. Voor geschreven verslagen van het leven van transgender personen die niet door het onderwerp zijn geschreven, gebruik \"Transgender biografieën.\""},{"@language":"sv","@value":"Skildringar av transpersoners liv skrivna av dem själva. För skildringar av transpersoners liv som skrivits av någon annan används termen ”Biografier om transpersoner”."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001729"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001618"},{"@id":"https://homosaurus.org/v5/homoit0001727"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001729"},"dc:issued":{"@type":"xsd:date","@value":"2021-11-02"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001734","dc:identifier":"homoit0001734","skos:prefLabel":[{"@language":"en","@value":"Queer autobiographies"},{"@language":"es","@value":"Autobiografías queer"},{"@language":"nl","@value":"Queer autobiografieën"},{"@language":"sv","@value":"Queera självbiografier"}],"skos:altLabel":[{"@language":"en","@value":"Queer autobios"},{"@language":"en","@value":"Queer memoirs"},{"@language":"es","@value":"Memorias queer"},{"@language":"nl","@value":"Queer memoires"}],"rdfs:comment":[{"@language":"en","@value":"Accounts of queer peoples' lives written by those people. For written accounts of queer people's lives that were not written by the subject, use \"Queer biographies.\""},{"@language":"es","@value":"Relatos de vida de personas escritos por esas mismas personas; utilícese para autobiografías escritas por autores queer."},{"@language":"nl","@value":"Verslagen van het leven van queer personen, geschreven door die personen. Voor geschreven verslagen van het leven van queer personen die niet door het onderwerp zijn geschreven, gebruik \"Queer biografieën.\""},{"@language":"sv","@value":"Skildringar av queera personers liv skrivna av dem själva. För skildringar skrivna av någon annan, använd termen ”Queera biografier”."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001729"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001619"},{"@id":"https://homosaurus.org/v5/homoit0001728"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001729"},"dc:issued":{"@type":"xsd:date","@value":"2021-11-02"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002975","dc:identifier":"homoit0002975","skos:prefLabel":[{"@language":"en","@value":"Intersex clergy"},{"@language":"es","@value":"Clero intersexual"},{"@language":"nl","@value":"Intersekse pastores"},{"@language":"sv","@value":"Religiösa ledare som är intersexpersoner"}],"skos:altLabel":[{"@language":"es","@value":"Clero intersex"},{"@language":"es","@value":"Pastores interesexuales"},{"@language":"sv","@value":"Intersexpersoner med religiösa ämbeten"}],"rdfs:comment":[{"@language":"en","@value":"Intersex people who are ordained for religious duties, particularly in the Christian Church."},{"@language":"es","@value":"Personas intersexuales que son ordenadas para deberes religiosos, particularmente en la Iglesia cristiana."},{"@language":"nl","@value":"Intersekse personen die zijn gewijd voor religieuze plichten, met name in de christelijke kerk."},{"@language":"sv","@value":"Intersexpersoner som är prästvigda eller innehar religiösa ämbeten, särskilt inom kristendomen."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001624"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001624"},"dc:issued":{"@type":"xsd:date","@value":"2023-09-29"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002981","dc:identifier":"homoit0002981","skos:prefLabel":[{"@language":"en","@value":"Asexual clergy"},{"@language":"de","@value":"Asexuelle Geistliche"},{"@language":"es","@value":"Clero asexual"},{"@language":"nl","@value":"Aseksuele pastores"},{"@language":"sv","@value":"Asexuella religiösa ledare"}],"skos:altLabel":[{"@language":"de","@value":"Ace Geistliche"},{"@language":"es","@value":"Pastores asexuales"},{"@language":"sv","@value":"Asexuella med religiösa ämbeten"}],"rdfs:comment":[{"@language":"en","@value":"Asexual people who are ordained for religious duties, particularly in the Christian Church."},{"@language":"de","@value":"Asexuelle Personen, die für religiöse Aufgaben ordiniert sind, insbesondere in der christlichen Kirche."},{"@language":"es","@value":"Personas asexuales que son ordenadas para deberes religiosos, particularmente en la iglesia cristiana."},{"@language":"nl","@value":"Aseksuele personen die zijn gewijd voor religieuze plichten, met name in de christelijke kerk."},{"@language":"sv","@value":"Asexuella personer som är prästvigda eller innehar religiösa ämbeten, särskilt inom kristendomen."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001624"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001624"},"dc:issued":{"@type":"xsd:date","@value":"2023-10-27"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001625","dc:identifier":"homoit0001625","skos:prefLabel":[{"@language":"en","@value":"DADT relationships"},{"@language":"es","@value":"Relaciones DADT"},{"@language":"de","@value":"DADT-Beziehungen"},{"@language":"nl","@value":"DADT relaties"},{"@language":"sv","@value":"DADT-relationer"}],"skos:altLabel":{"@language":"sv","@value":"Don't ask don't tell-relationer"},"rdfs:comment":[{"@language":"en","@value":"Abbreviation for \"don’t ask don’t tell relationships,\" where partners agree that they have each have multiple romantic and/or sexual relationships as long as they do not discuss it with their primary partner or let it interfere with their partner’s daily life."},{"@language":"es","@value":"Abreviatura de \"relaciones de no preguntar, no decir\" o \"don't ask, don't tell\" en inglés, donde las parejas acuerdan que cada una tiene múltiples relaciones románticas y/o sexuales, siempre y cuando no lo hablen con su pareja principal ni dejen que interfiera con la vida diaria de su pareja. ."},{"@language":"de","@value":"DADT ist die Abkürzung für „Don’t ask, don’t tell” (dt.: Frag nicht, sag nichts), DADT-Beziehungn sind entsprechend Beziehungen, bei denen die Partner:innen vereinbaren, dass jede:r von ihnen mehrere romantische und/oder sexuelle Beziehungen haben darf, solange sie diese nicht mit ihrer Hauptpartnerperson besprechen oder das tägliche Leben ihrer Partnerperson beeinträchtigen."},{"@language":"nl","@value":"Don't Ask Don't Tell-relaties, waarbij partners (in overleg) meerdere romantische en/of seksuele relaties mogen hebben, zolang ze het niet met hun primaire partner bespreken of het het dagelijks leven van hun partner laten belemmeren."},{"@language":"sv","@value":"Förkortning för ”don’t ask don’t tell”-relationer, där parterna kommer överens om att de båda har flera romantiska och/eller sexuella relationer, så länge de inte diskuterar det med sin primära partner eller låter det påverka partnerns vardagsliv."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001651"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001629"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001636"},"dc:replaces":{"@id":"http://homosaurus.org/v2/DADTRelationships"},"dc:issued":{"@type":"xsd:date","@value":"2020-12-11"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001988","dc:identifier":"homoit0001988","skos:prefLabel":[{"@language":"en","@value":"Greyromanticism"},{"@language":"es","@value":"Grisrománticismo"},{"@language":"fr","@value":"Grisromantisme"},{"@language":"nl","@value":"Grijsromanticisme"},{"@language":"sv","@value":"Gråromantik"}],"skos:altLabel":[{"@language":"en","@value":"Gray-romantic"},{"@language":"en","@value":"Grayromantic"},{"@language":"en","@value":"Grayromanticism"},{"@language":"en","@value":"Grey-romantic"},{"@language":"en","@value":"Greyromantic"},{"@language":"fr","@value":"Gris romantisme"},{"@language":"fr","@value":"Gris-romantisme"},{"@language":"fr","@value":"Greyromantisme"},{"@language":"fr","@value":"Grey-romantisme"},{"@language":"fr","@value":"Gray-romantisme"},{"@language":"nl","@value":"Grijsromantisch"},{"@language":"sv","@value":"Greyromanticism"}],"rdfs:comment":[{"@language":"en","@value":"An umbrella term for romantic orientations generally characterized by rare, infrequent, or low-intensity romantic attraction."},{"@language":"es","@value":"Término general que engloba las orientaciones románticas generalmente caracterizadas por una atracción romántica rara, infrecuente o de baja intensidad."},{"@language":"fr","@value":"Orientation romantique caractérisée par une attirance romantique rare, peu fréquente ou de faible intensité."},{"@language":"nl","@value":"Een overkoepelende term voor romantische oriëntaties die over het algemeen worden gekenmerkt door zeldzame, infrequente romantische aantrekkingskracht of romantische aantrekkingskracht met een lage intensiteit"},{"@language":"sv","@value":"Ett paraplybegrepp för romantiska läggningar som kännetecknas av sällsynt, lågintensiv eller mycket sällan förekommande romantisk attraktion."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001828"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001626"},{"@id":"https://homosaurus.org/v5/homoit0001987"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001828"},"dc:issued":{"@type":"xsd:date","@value":"2022-05-11"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001987","dc:identifier":"homoit0001987","skos:prefLabel":[{"@language":"en","@value":"Greyromantic people"},{"@language":"es","@value":"Personas grisrománticas"},{"@language":"fr","@value":"Personnes grisromantiques"},{"@language":"nl","@value":"Grijsromantische personen"},{"@language":"sv","@value":"Gråromantiker"}],"skos:altLabel":[{"@language":"en","@value":"Gray-romantic people"},{"@language":"en","@value":"Grayromantic people"},{"@language":"en","@value":"Grayromantics"},{"@language":"en","@value":"Grey-romantic people"},{"@language":"en","@value":"Greyromantics"},{"@language":"es","@value":"Personas gris-románticas"},{"@language":"es","@value":"Grisrománticos"},{"@language":"es","@value":"Personas gris románticas"},{"@language":"fr","@value":"Personnes gris romantiques"},{"@language":"fr","@value":"Personnes gris-romantiques"},{"@language":"fr","@value":"Personnes grey-romantiques"},{"@language":"nl","@value":"Grijsromantici"},{"@language":"sv","@value":"Gråromantiska personer"},{"@language":"sv","@value":"Greyromatic-personer"}],"rdfs:comment":[{"@language":"en","@value":"Individuals who experience rare, infrequent, or low-intensity romantic attraction."},{"@language":"es","@value":"Personas que experimentan una atracción romántica rara, poco frecuente o de baja intensidad."},{"@language":"fr","@value":"Personnes qui éprouvent une attirance romantique rare, peu fréquente ou de faible intensité."},{"@language":"nl","@value":"Personen die een zeldzame, infrequente of romantische aantrekkingskracht van lage intensiteit ervaren"},{"@language":"sv","@value":"Personer som upplever romantisk attraktion som är sällsynt, lågintensiv eller mycket sällan förekommande."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001829"},"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0003038"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001627"},{"@id":"https://homosaurus.org/v5/homoit0001988"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001829"},"dc:issued":{"@type":"xsd:date","@value":"2022-05-11"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001659","dc:identifier":"homoit0001659","skos:prefLabel":[{"@language":"en","@value":"Non-monogamy"},{"@language":"es","@value":"No monogamia"},{"@language":"nl","@value":"Non-monogamie"},{"@language":"sv","@value":"Ickemonogami"}],"skos:altLabel":[{"@language":"en","@value":"Nonmono"},{"@language":"en","@value":"Nonmonogamy"},{"@language":"es","@value":"Nomonogamia"}],"rdfs:comment":[{"@language":"en","@value":"Practice of engaging in romantic or sexual relationships with more than one person simultaneously. "},{"@language":"es","@value":"Práctica de entablar relaciones románticas o sexuales con más de una persona simultáneamente."},{"@language":"nl","@value":"Praktijk van romantische of seksuele relaties met meer dan één persoon tegelijk."},{"@language":"sv","@value":"Att ha romantiska eller sexuella relationer med flera personer samtidigt."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001636"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0001629"},{"@id":"https://homosaurus.org/v5/homoit0001651"},{"@id":"https://homosaurus.org/v5/homoit0001658"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0002255"},"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh00003586"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001636"},"dc:replaces":{"@id":"http://homosaurus.org/v2/nonMonogamy"},"dc:issued":{"@type":"xsd:date","@value":"2021-06-30"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001656","dc:identifier":"homoit0001656","skos:prefLabel":[{"@language":"en","@value":"Monogamish"},{"@language":"es","@value":"Monogamish"},{"@language":"fr","@value":"Quasi monogamie"},{"@language":"nl","@value":"Monogamisch"},{"@language":"sv","@value":"Monogamish"}],"skos:altLabel":[{"@language":"es","@value":"Relaciones casi monógamas"},{"@language":"fr","@value":"Monogamish"}],"rdfs:comment":[{"@language":"en","@value":"Term used to describe relationships that are mostly monogamous with occasional exceptions made for sexual play."},{"@language":"es","@value":"Término utilizado para describir relaciones que son, en su mayoría, monógamas con excepciones ocasionales para el juego sexual."},{"@language":"fr","@value":"Situation relationnelle de personnes principalement monogames, mais qui ont occasionnellement des relations sexuelles à l'extérieur du couple."},{"@language":"nl","@value":"Een relatie die meestal monogaam is, met af en toe uitzonderingen voor seksueel spel."},{"@language":"sv","@value":"Term som beskriver relationer som i huvudsak är monogama men där sporadiska undantag tillåts för sexuella kontakter."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001629"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001641"},{"@id":"https://homosaurus.org/v5/homoit0001916"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001636"},"dc:replaces":{"@id":"http://homosaurus.org/v2/monogamish"},"dc:issued":{"@type":"xsd:date","@value":"2021-06-30"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001635","dc:identifier":"homoit0001635","skos:prefLabel":[{"@language":"en","@value":"Primary partners"},{"@language":"es","@value":"Parejas primarias"},{"@language":"nl","@value":"Primaire partners"},{"@language":"sv","@value":"Primära partners"}],"rdfs:comment":[{"@language":"en","@value":"A term used in hierarchical polyamory to refer to the partner whose interests and desires come before those of any secondary partner(s)."},{"@language":"es","@value":"Un término utilizado en el poliamor jerárquico para referirse a la pareja cuyos intereses y deseos están por delante de los de cualquier pareja secundaria."},{"@language":"nl","@value":"Een term die in hiërarchische polyamory wordt gebruikt om te verwijzen naar de partner wiens interesses en verlangens voorrang hebben op secundaire partner(s)."},{"@language":"sv","@value":"Term som används inom hierarkiska polyamorösa sammanhang för att beskriva den partner vars behov och önskemål prioriteras framför eventuella sekundära partners."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002365"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001629"},{"@id":"https://homosaurus.org/v5/homoit0001638"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0002365"},"dc:replaces":{"@id":"http://homosaurus.org/v2/primaryPartners"},"dc:issued":{"@type":"xsd:date","@value":"2020-12-11"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003042","dc:identifier":"homoit0003042","skos:prefLabel":[{"@language":"en","@value":"Megasexual college students"},{"@language":"es","@value":"Estudiantes universitarios megasexuales"},{"@language":"de","@value":"Megasexuelle Hochschulstudierende"},{"@language":"nl","@value":"Megaseksuele studenten"},{"@language":"sv","@value":"Megasexuella collegestudenter"}],"rdfs:comment":[{"@language":"en","@value":"Megasexual people who are attending college."},{"@language":"es","@value":"Personas megasexuales que asisten a la universidad."},{"@language":"de","@value":"Megasexuelle Personen, die eine Hochschule besuchen. Achtung: Das US-amerikanische College entspricht nicht exakt der Hochschule im deutschen Sprachraum, wird aber häufig als Hochschule übersetzt."},{"@language":"nl","@value":"Megaseksuele personen die naar de universiteit gaan."},{"@language":"sv","@value":"Megasexuella personer som studerar vid college."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001633"},{"@id":"https://homosaurus.org/v5/homoit0003041"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0003032"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001297"},"dc:issued":{"@type":"xsd:date","@value":"2023-12-05"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003229","dc:identifier":"homoit0003229","skos:prefLabel":[{"@language":"en","@value":"Polycules"},{"@language":"es","@value":"Polículas"},{"@language":"nl","@value":"Polyculen"},{"@language":"sv","@value":"Polykyl"}],"skos:altLabel":{"@language":"sv","@value":"Polykluster"},"rdfs:comment":[{"@language":"en","@value":"Networks of polyamorous people who are connected by their or their partners' romantic and/or sexual relationships. Polycule members are not necessarily romantically and/or sexually involved with every member of the group. For example, Member A might be connected to Member B in that Member B is in a relationship with Member A's partner."},{"@language":"es","@value":"Redes de personas poliamorosas que están conectadas por sus relaciones románticas y/o sexuales o las de sus parejas. Los miembros de una polícula no están necesariamente involucrados romántica y/o sexualmente con todos los miembros del grupo. Por ejemplo, el Miembro A podría estar conectado con el Miembro B en el sentido de que el Miembro B mantiene una relación con la pareja del Miembro A."},{"@language":"nl","@value":"Netwerken van polyamoreuze personen die verbonden zijn door hun of hun partners romantische en/of seksuele relaties. Polycule leden zijn niet noodzakelijkerwijs romantisch en/of seksueel betrokken bij elk lid van de groep. Bijvoorbeeld, Lid A kan verbonden zijn met Lid B in die zin dat Lid B een relatie heeft met de partner van Lid A."},{"@language":"sv","@value":"Nätverk av polyamorösa personer som är sammankopplade genom sina egna eller sina partners romantiska och/eller sexuella relationer. Medlemmar i en polykyl är inte nödvändigtvis romantiskt eller sexuellt involverade med alla andra i nätverket. Till exempel kan person A vara kopplad till person B genom att person B är i en relation med person A:s partner."}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001636"},{"@id":"https://homosaurus.org/v5/homoit0001660"},{"@id":"https://homosaurus.org/v5/homoit0001663"},{"@id":"https://homosaurus.org/v5/homoit0003920"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0003229"},"dc:issued":{"@type":"xsd:date","@value":"2024-05-24"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001665","dc:identifier":"homoit0001665","skos:prefLabel":[{"@language":"en","@value":"Relationship anarchists"},{"@language":"es","@value":"Anarquistas relacionales"},{"@language":"nl","@value":"Relatie-anarchisten"},{"@language":"sv","@value":"Relationsanarkister"}],"skos:altLabel":{"@language":"es","@value":"Anarquistas de relación"},"rdfs:comment":[{"@language":"en","@value":"People who practice a type of non-monogamy characterized by application of anarchist principles (such as autonomy, anti-normativity, anti-hierarchical practices, refusal of state governance) to relationships. Often contrasted with hierarchical polyamory."},{"@language":"es","@value":"Personas que practican un tipo de no monogamia caracterizada por la aplicación de principios anarquistas (como la autonomía, la antinormatividad, las prácticas antijerárquicas, el rechazo de la gobernanza estatal) a las relaciones. A menudo, se contrasta con el poliamor jerárquico."},{"@language":"nl","@value":"Mensen die een vorm van niet-monogamie beoefenen die wordt gekenmerkt door toepassing van anarchistische principes (zoals autonomie, anti-normativiteit, anti-hiërarchische praktijken, weigering van staatsbestuur) op relaties. Vaak in tegenstelling tot hiërarchische polyamory."},{"@language":"sv","@value":"Personer som utövar en form av icke-monogami som bygger på anarkistiska principer, som självbestämmande, normkritik och motstånd mot auktoritet och statlig kontroll. Ofta använt i kontrast till hierarkisk polyamori."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001637"},{"@id":"https://homosaurus.org/v5/homoit0001651"},{"@id":"https://homosaurus.org/v5/homoit0001660"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001666"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001637"},"dc:replaces":{"@id":"http://homosaurus.org/v2/relationshipAnarchists"},"dc:issued":{"@type":"xsd:date","@value":"2021-06-30"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001791","dc:identifier":"homoit0001791","skos:prefLabel":[{"@language":"en","@value":"Alloromanticism"},{"@language":"es","@value":"Alorromanticismo"},{"@language":"de","@value":"Alloromantik"},{"@language":"fr","@value":"Alloromantisme"},{"@language":"nl","@value":"Alloromanticisme"},{"@language":"sv","@value":"Alloromantik"}],"skos:altLabel":[{"@language":"nl","@value":"Alloromantisch"},{"@language":"sv","@value":"Alloromantisism"}],"rdfs:comment":[{"@language":"en","@value":"A romantic orientation characterized by the occurrence of romantic attraction or desire in a frequent and consistent manner, often alongside sexual attraction."},{"@language":"es","@value":"Una orientación romántica caracterizada por la atracción o el deseo romántico de manera frecuente y constante, a menudo junto con la atracción sexual."},{"@language":"de","@value":"Eine romantische Orientierung, die durch das regelmäßige und beständige Auftreten romantischer Anziehung und Begierde charakterisiert wird, oft einhergehend mit sexueller Anziehung."},{"@language":"fr","@value":"Orientation romantique caractérisée par une attirance ou un désir romantique régulier et constant, généralement associés à une attirance sexuelle."},{"@language":"nl","@value":"Een romantische oriëntatie die wordt gekenmerkt door het optreden van een romantische aantrekkingskracht of een romantisch verlangen op een frequente en consistente manier, vaak naast seksuele aantrekking"},{"@language":"sv","@value":"En romantisk orientering kännetecknad av en frekvent och konsekvent förekomst av romantisk attraktion eller begär, ofta tillsammans med sexuell attraktion."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001828"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0001792"},{"@id":"https://homosaurus.org/v5/homoit0001793"},{"@id":"https://homosaurus.org/v5/homoit0001794"},{"@id":"https://homosaurus.org/v5/homoit0001795"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001644"},{"@id":"https://homosaurus.org/v5/homoit0001823"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001828"},"dc:issued":{"@type":"xsd:date","@value":"2021-12-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001666","dc:identifier":"homoit0001666","skos:prefLabel":[{"@language":"en","@value":"Relationship anarchy"},{"@language":"es","@value":"Anarquía relacional"},{"@language":"nl","@value":"Relatie-anarchie"},{"@language":"sv","@value":"Relationsanarki"}],"rdfs:comment":[{"@language":"en","@value":"A type of non-monogamy characterized by application of anarchist principles (such as autonomy, anti-normativity, anti-hierarchical practices, refusal of state governance) to relationships. Often contrasted with hierarchical polyamory."},{"@language":"es","@value":"Un tipo de no monogamia caracterizada por la aplicación de principios anarquistas (como la autonomía, la antinormatividad, las prácticas antijerárquicas, el rechazo de la gobernanza estatal) a las relaciones. A menudo, se contrasta con el poliamor jerárquico."},{"@language":"nl","@value":"Een type non-monogamie dat wordt gekenmerkt door toepassing van anarchistische principes (zoals autonomie, antinormativiteit, antihiërarchische praktijken, weigering van staatsbestuur) op relaties."},{"@language":"sv","@value":"En form av icke-monogami som bygger på anarkistiska principer, som självbestämmande, normkritik och motstånd mot auktoritet och statlig kontroll. Ofta använt i kontrast till hierarkisk polyamori."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001651"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001665"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001636"},"dc:replaces":{"@id":"http://homosaurus.org/v2/relationshipAnarchy"},"dc:issued":{"@type":"xsd:date","@value":"2021-06-30"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003278","dc:identifier":"homoit0003278","skos:prefLabel":[{"@language":"en","@value":"Open marriage"},{"@language":"es","@value":"Matrimonio abierto"},{"@language":"nl","@value":"Open huwelijk"},{"@language":"sv","@value":"Öppna äktenskap"}],"rdfs:comment":[{"@language":"en","@value":"A form of consensual non-monogamy in which spouses agree to engage in sexual and/or romantic relationships with individuals other than their marriage partner, without regarding this as infidelity."},{"@language":"es","@value":"Forma de no monogamia consentida en la que lxs cónyuges acuerdan mantener relaciones sexuales y/o románticas con personas distintas de su pareja matrimonial, sin considerarlo infidelidad."},{"@language":"nl","@value":"Een vorm van consensuele non-monogamie waarbij echtgenoten toestemmen om seksuele en/of romantische relaties te hebben met andere personen dan hun huwelijkspartner, zonder dit als ontrouw te beschouwen."},{"@language":"sv","@value":"En form av ömsesidigt överenskommen icke-monogami där makar kommer överens om att ha sexuella och/eller romantiska relationer med andra personer utan att detta betraktas som otrohet."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001651"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2003007086"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001636"},"dc:issued":{"@type":"xsd:date","@value":"2024-06-10"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001655","dc:identifier":"homoit0001655","skos:prefLabel":[{"@language":"en","@value":"Honeymooning"},{"@language":"es","@value":"Luna de miel"},{"@language":"de","@value":"Verliebtheitsphase"},{"@language":"nl","@value":"Wittebroodsweken"},{"@language":"sv","@value":"Smekmånadsfas"}],"skos:altLabel":{"@language":"de","@value":"Honeymoon-Phase"},"rdfs:comment":[{"@language":"en","@value":"A period of time in a relationship characterized by passionate love as well as intense feelings of attraction and ecstasy, sometimes accompanied by idealization of a partner or the shared relationship."},{"@language":"es","@value":"Un periodo de tiempo en una relación caracterizado por un amor apasionado al igual que por intensos sentimientos de atracción y éxtasis, a veces acompañados por la idealización de la pareja o de la relación compartida."},{"@language":"de","@value":"Eine Phase in einer Beziehung, die durch leidenschaftliche Liebe sowie intensive Gefühle von Anziehung und Ekstase gekennzeichnet ist und manchmal mit der Idealisierung der Partnerperson oder der Beziehung einhergeht."},{"@language":"nl","@value":"Een periode in een relatie die wordt gekenmerkt door hartstochtelijke liefde en intense gevoelens van aantrekking en extase, soms vergezeld van idealisering van een partner of de gedeelde relatie."},{"@language":"sv","@value":"En period i en relation som kännetecknas av passionerad kärlek och stark attraktion, ibland också idealisering av partnern eller relationen."}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001661"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001655"},"dc:replaces":{"@id":"http://homosaurus.org/v2/honeymooning"},"dc:issued":{"@type":"xsd:date","@value":"2021-06-30"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001658","dc:identifier":"homoit0001658","skos:prefLabel":[{"@language":"en","@value":"Non-consensual non-monogamy"},{"@language":"es","@value":"No monogamia no consensual"},{"@language":"nl","@value":"Non-consensuele non-monogamie"},{"@language":"sv","@value":"Ickemonogami utan samtycke"}],"rdfs:comment":[{"@language":"en","@value":"Practice of engaging in romantic or sexual relationships with more than one person simultaneously without each partner's consent."},{"@language":"es","@value":"Práctica de entablar relaciones románticas o sexuales con más de una persona simultáneamente sin el consentimiento de cada pareja."},{"@language":"nl","@value":"Praktijk van romantische of seksuele relaties met meer dan één persoon tegelijk, zonder toestemming."},{"@language":"sv","@value":"Att ha romantiska eller sexuella relationer med flera personer samtidigt utan samtliga partners samtycke."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001659"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001636"},"dc:replaces":{"@id":"http://homosaurus.org/v2/nonConsensualNonMonogamy"},"dc:issued":{"@type":"xsd:date","@value":"2021-06-30"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004333","dc:identifier":"homoit0004333","skos:prefLabel":[{"@language":"en","@value":"Neopronoun users"},{"@language":"nl","@value":"Neopronoun gebruikers"},{"@language":"sv","@value":"Användare av neopronomen"}],"rdfs:comment":[{"@language":"en","@value":"People who use personal pronouns that are not officially (i.e., in dictionaries, style guides, etc.) recognized by the language that they are used in."},{"@language":"nl","@value":"Mensen die persoonlijke voornaamwoorden/pronouns gebruiken die niet officieel (d.w.z. in woordenboeken, stijlgidsen, enz.) erkend worden door de taal waarin ze gebruikt worden."},{"@language":"sv","@value":"Personer som använder personliga pronomen som inte officiellt (i ordböcker etc.) erkänns av språket de används i."}],"skos:related":{"@id":"https://h