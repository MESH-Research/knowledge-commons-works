eman."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000865"},{"@id":"https://homosaurus.org/v5/homoit0002565"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-12"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003179","dc:identifier":"homoit0003179","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ urban fantasy fiction"},{"@language":"es","@value":"Ficción fantástica urbana LGBTQ+"},{"@language":"nl","@value":"LHBTQ+-urban fantasy"},{"@language":"sv","@value":"Hbtq+-urban fantasy"}],"skos:altLabel":{"@language":"sv","@value":"Urban fantasy (hbtq+)"},"rdfs:comment":[{"@language":"en","@value":"Subgenre of fantasy fiction, written works that depicts magical, fantastical, and/or supernatural elements in contemporary urban settings. Use for urban fantasy fiction focusing on LGBTQ+ characters or themes."},{"@language":"es","@value":"Un subgénero de la ficción fantástica que presenta a criaturas mágicas y sobrenaturales en entornos urbanos contemporáneos; utilícese para la ficción fantástica urbana centrada en personajes o temas LGBTQ+."},{"@language":"nl","@value":"Een subgenre van fantasy met magische en bovennatuurlijke wezens in hedendaagse stedelijke omgevingen; gebruik voor urban fantasy gericht op LHBTQ+-personages of thema's."},{"@language":"sv","@value":"En subgenre inom fantasy med magi och övernaturliga varelser i nutida urbana miljöer. Används för urban fantasy med hbtq+-karaktärer eller teman."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000865"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0003180"},{"@id":"https://homosaurus.org/v5/homoit0003181"},{"@id":"https://homosaurus.org/v5/homoit0003182"},{"@id":"https://homosaurus.org/v5/homoit0003183"},{"@id":"https://homosaurus.org/v5/homoit0003184"},{"@id":"https://homosaurus.org/v5/homoit0003185"},{"@id":"https://homosaurus.org/v5/homoit0003186"},{"@id":"https://homosaurus.org/v5/homoit0003187"},{"@id":"https://homosaurus.org/v5/homoit0003189"},{"@id":"https://homosaurus.org/v5/homoit0003190"},{"@id":"https://homosaurus.org/v5/homoit0003191"},{"@id":"https://homosaurus.org/v5/homoit0003192"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0003188"},{"@id":"https://homosaurus.org/v5/homoit0004653"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2024-01-17"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002636","dc:identifier":"homoit0002636","skos:prefLabel":[{"@language":"en","@value":"Māhū fantasy fiction"},{"@language":"es","@value":"Ficción fantástica māhū"},{"@language":"nl","@value":"Māhū fantasy"},{"@language":"sv","@value":"Māhū-fantasy"}],"skos:altLabel":{"@language":"haw","@value":"Mahu fantasy fiction"},"rdfs:comment":[{"@language":"en","@value":"Genre of written works that depicts magical, fantastical, and/or supernatural elements. Use for fantasy fiction focusing on māhū characters or themes."},{"@language":"es","@value":"Género que utiliza la magia y otros fenómenos sobrenaturales como elemento principal de la trama, el tema y/o el escenario; utilícese para la ficción fantástica centrada en personajes o temas māhū."},{"@language":"nl","@value":"Genre dat magie en andere bovennatuurlijke verschijnselen gebruikt als primair element van plot, thema en/of setting; gebruik om te verwijzen naar fantasy gericht op Mahu personages of thema's."},{"@language":"sv","@value":"Genre som använder magi och andra övernaturliga fenomen som centrala inslag i handling, tema och/eller miljö. Används för fantasy med māhū-karaktärer eller teman."}],"skos:broader":{"@id":"h