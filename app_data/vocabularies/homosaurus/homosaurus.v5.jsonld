tLabel":[{"@language":"en","@value":"Straight boys"},{"@language":"de","@value":"Hetero-Jungs"},{"@language":"de","@value":"Heterosexuelle Jungs"},{"@language":"de","@value":"Hetero-Jungen"}],"rdfs:comment":[{"@language":"en","@value":"Boys (typically children or youth younger than 18) who are heterosexual."},{"@language":"es","@value":"Niños (normalmente menores de 18 años) que son heterosexuales."},{"@language":"de","@value":"Jungen (in der Regel unter 18 Jahre), die heterosexuell sind."},{"@language":"nl","@value":"Jongens (meestal kinderen of jongeren jonger dan 18 jaar) die heteroseksueel zijn."},{"@language":"sv","@value":"Pojkar, vanligtvis barn eller ungdomar under 18 år, som är heterosexuella."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000220"},{"@id":"https://homosaurus.org/v5/homoit0000630"},{"@id":"https://homosaurus.org/v5/homoit0002285"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000421"},"dc:replaces":{"@id":"http://homosaurus.org/v2/heterosexualBoys"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001313","dc:identifier":"homoit0001313","skos:prefLabel":[{"@language":"en","@value":"Sissies"},{"@language":"es","@value":"Sissies"},{"@language":"nl","@value":"Sissies"},{"@language":"sv","@value":"Sissies"}],"skos:altLabel":[{"@language":"en","@value":"Sissy boys"},{"@language":"es","@value":"Sissy"},{"@language":"es","@value":"Cissy"}],"rdfs:comment":[{"@language":"en","@value":"Pejorative term applied to boys or men who are perceived to be effeminate or do not conform to traditional masculine roles."},{"@language":"es","@value":"Término peyorativo en Inglés, derivado de la palabra \"sister\" (hermana), que se aplica a niños u hombres que son percibidos como afeminados o que no se ajustan a los roles masculinos tradicionales."},{"@language":"nl","@value":"kleinerende term voor jongens of mannen die als verwijfd worden gezien en zich niet conformeren aan traditioneel mannelijke rollen"},{"@language":"sv","@value":"Engelsk nedsättande term som används om pojkar eller män som uppfattas som feminina eller inte uppfyller traditionella mansideal."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000220"},{"@id":"https://homosaurus.org/v5/homoit0000577"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001148"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000421"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sissies"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002283","dc:identifier":"homoit0002283","skos:prefLabel":[{"@language":"en","@value":"Cisgender boys"},{"@language":"de","@value":"Cis Jungen"},{"@language":"es","@value":"Niños cisgénero"},{"@language":"nl","@value":"Cisgender jongens"},{"@language":"sv","@value":"Cispojkar"}],"skos:altLabel":[{"@language":"en","@value":"Cis boys"},{"@language":"es","@value":"Niños cis"}],"rdfs:comment":[{"@language":"en","@value":"Boys (typically children or youth younger than 18) who are cisgender."},{"@language":"de","@value":"Jungen (in der Regel Kinder oder Jugendliche unter 18 Jahren), die cis sind."},{"@language":"es","@value":"Niños menores de 18 años que se autoidentifican como cisgénero."},{"@language":"nl","@value":"Jongens (meestal kinderen of jongeren jonger dan 18 jaar) die cisgender zijn."},{"@language":"sv","@value":"Pojkar, vanligtvis barn eller ungdomar under 18 år, som är cis-personer."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000220"},{"@id":"https://homosaurus.org/v5/homoit0002281"},{"@id":"https://homosaurus.org/v5/homoit0002282"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000421"},"dc:issued":{"@type":"xsd:date","@value":"2022-11-10"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000221","dc:identifier":"homoit0000221","skos:prefLabel":[{"@language":"en","@value":"Boys' friendships"},{"@language":"es","@value":"Amistades entre niños"},{"@language":"de","@value":"Jungenfreundschaft"},{"@language":"nl","@value":"Jongensvriendschappen"},{"@language":"sv","@value":"Pojkars vänskap"}],"skos:altLabel":{"@language":"es","@value":"Amistades de niños"},"rdfs:comment":[{"@language":"en","@value":"Connections based on affection and trust between two or more boys."},{"@language":"es","@value":"Conexiones basadas en el afecto y la confianza entre dos o más niños."},{"@language":"de","@value":"Verbindungen, die auf Zuneigung und Vertrauen zwischen zwei oder mehr Jungen basieren."},{"@language":"nl","@value":"Banden gebaseerd op affectie en vertrouwen tussen twee of meer jongens."},{"@language":"sv","@value":"Relationer baserade på tillgivenhet och förtroende mellan två eller flera pojkar."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000455"},{"@id":"https://homosaurus.org/v5/homoit0000649"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000220"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001237"},"dc:replaces":{"@id":"http://homosaurus.org/v2/boysFriendships"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000563","dc:identifier":"homoit0000563","skos:prefLabel":[{"@language":"en","@value":"Gender binaries"},{"@language":"es","@value":"Binarios de género"},{"@language":"de","@value":"Geschlechterbinarität"},{"@language":"nl","@value":"Genderbinair"},{"@language":"sv","@value":"Tvåkönsnormen"}],"skos:altLabel":[{"@language":"de","@value":"binäres Geschlechtersystem"},{"@language":"de","@value":"Zweigeschlechter-Ordnung"},{"@language":"de","@value":"Binäre Geschlechterordnung"},{"@language":"sv","@value":"Könsbinaritet"}],"rdfs:comment":[{"@language":"en","@value":"Cultural conceptions of gender as two distinct and opposing categories, typically man and woman or masculine and feminine."},{"@language":"es","@value":"Concepciones culturales del género como dos categorías distintas y opuestas, típicamente hombre y mujer o masculino y femenino."},{"@language":"de","@value":"Kulturelle Konzepte von Geschlecht als zwei unterschiedliche und gegensätzliche Kategorien, typischerweise Mann und Frau oder männlich und weiblich."},{"@language":"nl","@value":"Opvatting van gender als twee verschillende en tegengestelde categorieën, typisch man en vrouw of mannelijk en vrouwelijk"},{"@language":"sv","@value":"Kulturella föreställningar om kön som två tydliga och motsatta kategorier, vanligtvis man och kvinna eller maskulint och feminint."}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000220"},{"@id":"https://homosaurus.org/v5/homoit0000560"},{"@id":"https://homosaurus.org/v5/homoit0000571"},{"@id":"https://homosaurus.org/v5/homoit0000577"},{"@id":"https://homosaurus.org/v5/homoit0000578"},{"@id":"https://homosaurus.org/v5/homoit0000590"},{"@id":"https://homosaurus.org/v5/homoit0001008"},{"@id":"https://homosaurus.org/v5/homoit0001509"},{"@id":"https://homosaurus.org/v5/homoit0002589"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000563"},"dc:replaces":{"@id":"http://homosaurus.org/v2/genderBinary"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000455","dc:identifier":"homoit0000455","skos:prefLabel":[{"@language":"en","@value":"Friendships"},{"@language":"es","@value":"Amistades"},{"@language":"de","@value":"Freundschaften"},{"@language":"nl","@value":"Vriendschappen"},{"@language":"sv","@value":"Vänskap"}],"rdfs:comment":[{"@language":"en","@value":"Connections based on affection and trust between two or more people."},{"@language":"es","@value":"Conexiones basadas en el afecto y la confianza entre dos o más personas."},{"@language":"de","@value":"Verbindungen, die auf Zuneigung und Vertrauen zwischen zwei oder mehr Personen beruhen."},{"@language":"sv","@value":"Relationer som bygger på tillgivenhet och förtroende mellan två eller flera personer."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001237"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000221"},{"@id":"https://homosaurus.org/v5/homoit0000429"},{"@id":"https://homosaurus.org/v5/homoit0000591"},{"@id":"https://homosaurus.org/v5/homoit0000982"},{"@id":"https://homosaurus.org/v5/homoit0001245"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000381"},{"@id":"https://homosaurus.org/v5/homoit0000416"},{"@id":"https://homosaurus.org/v5/homoit0000417"},{"@id":"https://homosaurus.org/v5/homoit0000598"},{"@id":"https://homosaurus.org/v5/homoit0000649"},{"@id":"https://homosaurus.org/v5/homoit0003505"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85051992"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001237"},"dc:replaces":{"@id":"http://homosaurus.org/v2/friendships"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000649","dc:identifier":"homoit0000649","skos:prefLabel":[{"@language":"en","@value":"Homosociality"},{"@language":"es","@value":"Homosocialidad"},{"@language":"de","@value":"Homosozialität"},{"@language":"nl","@value":"Homosociale relaties"},{"@language":"sv","@value":"Homosocialitet"}],"skos:altLabel":[{"@language":"en","@value":"Homosocial bonds"},{"@language":"es","@value":"Lazos homosociales"},{"@language":"es","@value":"Vínculos homosociales"},{"@language":"de","@value":"Homosoziale Beziehungen"},{"@language":"de","@value":"Homosoziale Interaktion"},{"@language":"de","@value":"Homosoziale Bindung"}],"rdfs:comment":[{"@language":"en","@value":"A concept used to describe the social bonds that exist between members of the same sex or gender in a given culture."},{"@language":"es","@value":"Concepto utilizado para describir los vínculos sociales que existen entre miembros del mismo sexo o género en una cultura determinada."},{"@language":"de","@value":"Ein Konzept zur Beschreibung sozialer Bindungen zwischen Personen desselben biologischen oder sozialen Geschlechts in einer bestimmten Kultur."},{"@language":"nl","@value":"Een begrip dat wordt gebruikt om de sociale banden te beschrijven die bestaan tussen leden van hetzelfde geslacht of gender in een bepaalde cultuur"},{"@language":"sv","@value":"Ett begrepp som beskriver sociala band mellan personer av samma kön inom en viss kultur."}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000221"},{"@id":"https://homosaurus.org/v5/homoit0000429"},{"@id":"https://homosaurus.org/v5/homoit0000591"},{"@id":"https://homosaurus.org/v5/homoit0000982"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000455"},{"@id":"https://homosaurus.org/v5/homoit0000628"},{"@id":"https://homosaurus.org/v5/homoit0000981"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000649"},"dc:replaces":{"@id":"http://homosaurus.org/v2/homosociality"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000401","dc:identifier":"homoit0000401","skos:prefLabel":[{"@language":"en","@value":"Erogenous body parts"},{"@language":"es","@value":"Partes erógenas del cuerpo"},{"@language":"de","@value":"Erogene Körperteile"},{"@language":"nl","@value":"Erogene lichaamsdelen"},{"@language":"sv","@value":"Erogena zoner"}],"skos:altLabel":{"@language":"nl","@value":"Erogene zone"},"rdfs:comment":[{"@language":"en","@value":"Areas of the body that are sensitive to sexual stimulation."},{"@language":"es","@value":"Zonas del cuerpo sensibles a la estimulación sexual."},{"@language":"de","@value":"Körperbereiche, die empfindlich auf sexuelle Stimulation reagieren."},{"@language":"nl","@value":"Delen van het lichaam die gevoelig zijn voor seksuele stimulatie"},{"@language":"sv","@value":"Områden på kroppen som är känsliga för sexuell stimulans."}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000222"},{"@id":"https://homosaurus.org/v5/homoit0000232"},{"@id":"https://homosaurus.org/v5/homoit0000282"},{"@id":"https://homosaurus.org/v5/homoit0001099"},{"@id":"https://homosaurus.org/v5/homoit0001361"},{"@id":"https://homosaurus.org/v5/homoit0001488"},{"@id":"https://homosaurus.org/v5/homoit0001984"},{"@id":"https://homosaurus.org/v5/homoit0003118"},{"@id":"https://homosaurus.org/v5/homoit0003137"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000585"},{"@id":"https://homosaurus.org/v5/homoit0001634"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000401"},"dc:replaces":{"@id":"http://homosaurus.org/v2/erogenousBodyParts"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001259","dc:identifier":"homoit0001259","skos:prefLabel":[{"@language":"en","@value":"Secondary sex characteristics"},{"@language":"es","@value":"Características sexuales secundarias"},{"@language":"nl","@value":"Secundaire geslachtskenmerken"},{"@language":"sv","@value":"Sekundära könskarakteristika"}],"rdfs:comment":[{"@language":"en","@value":"Features that appear during puberty that are not directly related to reproduction, like changes in the voice and the development of body hair."},{"@language":"es","@value":"Características que aparecen durante la pubertad que no están directamente relacionadas con la reproducción, como cambios en la voz y el desarrollo del vello corporal."},{"@language":"nl","@value":"Kenmerken die optreden tijdens de puberteit die niet direct gerelateerd zijn aan de voortplanting, zoals veranderingen in de stem en de ontwikkeling van lichaamshaar."},{"@language":"sv","@value":"Egenskaper som uppträder under puberteten och som inte är direkt kopplade till reproduktion, såsom förändringar i rösten och utveckling av kroppsbehåring."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001269"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000222"},{"@id":"https://homosaurus.org/v5/homoit0000422"},{"@id":"https://homosaurus.org/v5/homoit0000605"},{"@id":"https://homosaurus.org/v5/homoit0001339"},{"@id":"https://homosaurus.org/v5/homoit0001495"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001269"},"dc:replaces":{"@id":"http://homosaurus.org/v2/secondarySexCharacteristics"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001620","dc:identifier":"homoit0001620","skos:prefLabel":[{"@language":"en","@value":"Breast augmentation"},{"@language":"es","@value":"Aumento de senos"},{"@language":"de","@value":"Brustvergrößerung"},{"@language":"nl","@value":"Borstvergroting"},{"@language":"sv","@value":"Bröstförstoring"}],"skos:altLabel":[{"@language":"en","@value":"Augmentation mammaplasty"},{"@language":"en","@value":"Augmentation mammoplasty"},{"@language":"en","@value":"Boob job"},{"@language":"es","@value":"Mamoplastia de aumento"},{"@language":"es","@value":"Aumento de mamas"},{"@language":"de","@value":"Mammaaugmentation"},{"@language":"nl","@value":"Vergrotingsmammoplastie"}],"rdfs:comment":[{"@language":"en","@value":"A surgical procedure aimed at increasing breast size using a prosthetic implant; often undergone by transgender women as a gender affirming surgery."},{"@language":"es","@value":"Un procedimiento quirúrgico para aumentar el tamaño de los senos mediante un implante protésico; a menudo realizado por mujeres transgénero como cirugía de afirmación de género."},{"@language":"de","@value":"Chirurgischer Eingriff zur Vergrößerung der Brust mithilfe eines Implantats; wird häufig von Transfrauen als geschlechtsangleichende Operation durchgeführt."},{"@language":"nl","@value":"Een chirurgische ingreep gericht op het vergroten van de borstomvang met behulp van een prothetisch implantaat; vaak ondergaan door transgender vrouwen als een geslachtsbevestigende operatie."},{"@language":"sv","@value":"Kirurgiskt ingrepp som syftar till att förstora bröst med hjälp av implantat. Genomgås ofta av transkvinnor som en könsbekräftande operation."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001840"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000222"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh90001764"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001004"},"dc:replaces":{"@id":"http://homosaurus.org/v2/breastAugmentation"},"dc:issued":{"@type":"xsd:date","@value":"2020-12-11"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001621","dc:identifier":"homoit0001621","skos:prefLabel":[{"@language":"en","@value":"Breast fetish"},{"@language":"es","@value":"Fetiche de senos"},{"@language":"de","@value":"Brustfetisch"},{"@language":"nl","@value":"Borstfetisj"},{"@language":"sv","@value":"Brösterotisiering"}],"skos:altLabel":[{"@language":"en","@value":"Mazophilia"},{"@language":"en","@value":"Breast partialism"},{"@language":"en","@value":"Mastofact"},{"@language":"en","@value":"Breast fetishism"},{"@language":"en","@value":"Breast kink"},{"@language":"es","@value":"Fetiche de mamas"},{"@language":"es","@value":"Fetichismo de mamas"},{"@language":"es","@value":"Fetiche de senos"},{"@language":"es","@value":"Fetichismo de senos"},{"@language":"es","@value":"Masofilia"},{"@language":"es","@value":"Mastofacto"},{"@language":"es","@value":"Kink de senos"},{"@language":"es","@value":"Kink de mamas"},{"@language":"de","@value":"Busenfetisch"},{"@language":"de","@value":"Tittenfetisch"},{"@language":"nl","@value":"Borstkink"},{"@language":"nl","@value":"Borstpartialisme"},{"@language":"nl","@value":"Mastofact"},{"@language":"nl","@value":"Mazofilie"}],"rdfs:comment":[{"@language":"en","@value":"Eroticization of the breasts. "},{"@language":"es","@value":"Erotización de los senos."},{"@language":"de","@value":"Erotisierung der Brüste"},{"@language":"sv","@value":"Erotisering av bröst."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001634"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000222"},{"@id":"https://homosaurus.org/v5/homoit0001046"},{"@id":"https://homosaurus.org/v5/homoit0003118"},{"@id":"https://homosaurus.org/v5/homoit0003130"},{"@id":"https://homosaurus.org/v5/homoit0003132"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000404"},"dc:replaces":{"@id":"http://homosaurus.org/v2/breastFetishism"},"dc:issued":{"@type":"xsd:date","@value":"2020-12-11"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001622","dc:identifier":"homoit0001622","skos:prefLabel":[{"@language":"en","@value":"Breast reduction"},{"@language":"es","@value":"Reducción de senos"},{"@language":"de","@value":"Brustverkleinerung"},{"@language":"nl","@value":"Borstverkleining"},{"@language":"sv","@value":"Mastektomi"}],"skos:altLabel":[{"@language":"en","@value":"Reduction mammaplasty"},{"@language":"en","@value":"Reduction mammoplasty"},{"@language":"es","@value":"Reducción de mamas"},{"@language":"es","@value":"Mamoplastia de reducción"},{"@language":"de","@value":"Mammareduktion"},{"@language":"nl","@value":"Verkleiningsmammoplastie"},{"@language":"sv","@value":"Bröstförminskning"},{"@language":"sv","@value":"Bröstborttagning"}],"rdfs:comment":[{"@language":"en","@value":"A surgical procedure to decrease breast size. Often undertaken by transgender men or non-binary people as a gender affirming surgery."},{"@language":"es","@value":"Un procedimiento quirúrgico para disminuir el tamaño de los senos. A menudo realizado por hombres transgénero como cirugía de afirmación de género."},{"@language":"de","@value":"Chirurgischer Eingriff zur Verkleinerung der Brust. Wird häufig von Transmännern oder nicht-binären Personen als geschlechtsangleichende Operation durchgeführt."},{"@language":"nl","@value":"Een chirurgische ingreep gericht op het verkleinen van de borstomvang."},{"@language":"sv","@value":"Kirurgiskt ingrepp för att minska bröststorleken. Genomgås ofta av transmän eller ickebinära personer som en könsbekräftande operation."}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000222"},{"@id":"https://homosaurus.org/v5/homoit0001631"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh90001763"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001622"},"dc:replaces":{"@id":"http://homosaurus.org/v2/breastReduction"},"dc:issued":{"@type":"xsd:date","@value":"2020-12-11"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001623","dc:identifier":"homoit0001623","skos:prefLabel":[{"@language":"en","@value":"Breast size"},{"@language":"es","@value":"Tamaño de los senos"},{"@language":"de","@value":"Brustgröße"},{"@language":"nl","@value":"Borstgrootte"},{"@language":"sv","@value":"Bröststorlek"}],"rdfs:comment":[{"@language":"en","@value":"The dimensions of an individual's breast tissue; can be used as an approximation (e.g., large breasts, small breasts) or to reference to standards of measurement for bras and other support garments."},{"@language":"es","@value":"Las dimensiones del tejido mamario de una persona; se puede utilizar como una aproximación (p. ej., senos grandes, senos pequeños) o como referencia a estándares de medidas para sujetadores y otras prendas de soporte."},{"@language":"de","@value":"Die Größe des Brustgewebes einer Person; kann als Annäherungswert (z.B. große Brüste, kleine Brüste) oder als Referenz für Messstandards für BHs und andere Stützkleidung verwendet werden."},{"@language":"nl","@value":"De afmetingen van het borstweefsel van een persoon; kan worden gebruikt als benadering (bijv. grote borsten, kleine borsten) of om te verwijzen naar maatstaven voor beha's en andere ondersteunende kledingstukken."},{"@language":"sv","@value":"Måtten på en individs bröstvävnad. Kan användas som en uppskattning (t.ex. stora bröst, små bröst) eller för att referera till måttstandarder för bh:ar och andra stödplagg."}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0001630"},{"@id":"https://homosaurus.org/v5/homoit0001639"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000222"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001623"},"dc:replaces":{"@id":"http://homosaurus.org/v2/breastSize"},"dc:issued":{"@type":"xsd:date","@value":"2020-12-11"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001630","dc:identifier":"homoit0001630","skos:prefLabel":[{"@language":"en","@value":"Large breasts"},{"@language":"es","@value":"Senos grandes"},{"@language":"de","@value":"Große Brüste"},{"@language":"nl","@value":"Grote borsten"},{"@language":"sv","@value":"Stora bröst"}],"skos:altLabel":[{"@language":"en","@value":"Gigantomastia"},{"@language":"en","@value":"Macromastia"},{"@language":"en","@value":"Breast hypertrophy"},{"@language":"de","@value":"Makromastie"},{"@language":"de","@value":"Megalomastie"},{"@language":"de","@value":"Mammahypertrophie"},{"@language":"de","@value":"Hypermastie"},{"@language":"de","@value":"Gigantomastie"},{"@language":"nl","@value":"Gigantomastie"},{"@language":"nl","@value":"Macromastie"}],"rdfs:comment":[{"@language":"en","@value":"Breasts considered large within a given cultural context. Note that large breasts have various health issues associated with them and may carry stigmatized medical associations (such as terms like gigantomastia and macromastia). These terms have more specific medical meanings but should not be used outside of those specific contexts."},{"@language":"es","@value":"Senos considerados grandes dentro de un contexto cultural determinado. Tenga en cuenta que los senos grandes implican varios problemas de salud asociados y pueden conllevar asociaciones médicas estigmatizadas (tales como términos como gigantomastia y macromastia). Estos términos tienen significados médicos más específicos, pero no deben utilizarse fuera de esos contextos específicos."},{"@language":"de","@value":"Brüste, die in einem bestimmten kulturellen Kontext als groß gelten. Es ist zu beachten, dass große Brüste mit verschiedenen gesundheitlichen Problemen verbunden sind und mit stigmatisierenden medizinischen Assoziationen behaftet sein können (beispielsweise Makromastie). Diese Begriffe haben spezifische medizinische Bedeutungen, sollten jedoch nicht außerhalb dieser spezifischen Kontexte verwendet werden."},{"@language":"nl","@value":"Borsten die als groot worden beschouwd binnen een bepaalde culturele context. Opmerking: Grote borsten kunnen verschillende gezondheidsproblemen met zich meebrengen en gestigmatiseerde medische associaties hebben (zoals termen als gigantomastia en macromastia). Deze termen hebben een specifiekere medische betekenis, maar mogen niet buiten die specifieke context worden gebruikt. Gigantomastie is borsthypertrofie waarbij weefsel dat als buitensporig wordt beschouwd meer dan 1,5 kilogram weegt; macromastia is hypertrofie waarbij het weefsel minder dan 1,5 kilogram weegt"},{"@language":"sv","@value":"Bröst som anses stora inom en viss kulturell kontext. Observera att stora bröst kan vara förenade med olika hälsoproblem och ibland kopplas till medicinska begrepp som gigantomasti och makromasti. Dessa medicinska termer har specifika användningsområden och bör undvikas utanför sådana sammanhang."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001623"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000222"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001623"},"dc:replaces":{"@id":"http://homosaurus.org/v2/largeBreasts"},"dc:issued":{"@type":"xsd:date","@value":"2020-12-11"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001631","dc:identifier":"homoit0001631","skos:prefLabel":[{"@language":"en","@value":"Mastectomy"},{"@language":"es","@value":"Mastectomía"},{"@language":"nl","@value":"Mastectomie"},{"@language":"sv","@value":"Mastektomi"}],"skos:altLabel":[{"@language":"en","@value":"Breast amputation"},{"@language":"es","@value":"Amputación de senos"},{"@language":"sv","@value":"Bröstborttagning"},{"@language":"sv","@value":"Bröstförminskning"}],"rdfs:comment":[{"@language":"en","@value":"A surgical procedure aimed at removing the breast or as much breast tissue as possible; often undergone as part of \"top surgery\" for transgender men or nonbinary people."},{"@language":"es","@value":"Un procedimiento quirúrgico destinado a extirpar la mama o la mayor cantidad de tejido mamario posible; a menudo se realiza como parte de una \"cirugía superior\" para hombres transgénero o personas no binarias."},{"@language":"nl","@value":"Een chirurgische ingreep gericht op het verwijderen van de borst of zoveel mogelijk borstweefsel; vaak ondergaan als onderdeel van \"topchirurgie\" voor transgender mannen of sommige niet-binaire mensen"},{"@language":"sv","@value":"Kirurgiskt ingrepp för att avlägsna bröst eller bröstvävnad. Utförs ofta som en del av ”toppkirurgi” (top surgery) för transmän eller ickebinära personer."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001840"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000222"},{"@id":"https://homosaurus.org/v5/homoit0001622"},{"@id":"https://homosaurus.org/v5/homoit0001841"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85081984"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001004"},"dc:replaces":{"@id":"http://homosaurus.org/v2/mastectomy"},"dc:issued":{"@type":"xsd:date","@value":"2020-12-11"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001639","dc:identifier":"homoit0001639","skos:prefLabel":[{"@language":"en","@value":"Small breasts"},{"@language":"es","@value":"Senos pequeños"},{"@language":"nl","@value":"Kleine borsten"},{"@language":"sv","@value":"Små bröst"}],"skos:altLabel":[{"@language":"en","@value":"Breast hypoplasia"},{"@language":"en","@value":"Underdeveloped breasts"},{"@language":"es","@value":"Hipoplasia de senos"},{"@language":"es","@value":"Senos subdesarrollados"},{"@language":"nl","@value":"Onderontwikkelde borsten"},{"@language":"sv","@value":"Hypoplastiska bröst"},{"@language":"sv","@value":"Underutvecklade bröst"}],"rdfs:comment":[{"@language":"en","@value":"Breasts considered small within a given cultural context. In certain situations, medical professionals may refer to such breasts as \"underdeveloped\" or \"hypoplastic.\" These terms can be considered offensive and should not be used outside of specific medical contexts. The alternate labels included here are intended to aid search tools only and should not be used in other contexts."},{"@language":"es","@value":"Senos considerados pequeños dentro de un contexto cultural determinado. En determinadas situaciones, profesionales médicos pueden referirse a estos senos como \"subdesarrollados\" o \"hipoplásicos\". Estos términos pueden considerarse ofensivos y no deben utilizarse fuera de contextos médicos específicos. Las etiquetas alternativas incluidas aquí están destinadas únicamente para ayudar a las herramientas de búsqueda y no deben utilizarase en otros contextos."},{"@language":"nl","@value":"Borsten die binnen een bepaalde culturele context als klein worden beschouwd. In bepaalde situaties kunnen medische professionals naar dergelijke borsten verwijzen als \"onderontwikkeld\" of \"hypoplastisch\". Deze termen kunnen als aanstootgevend worden beschouwd en mogen niet worden gebruikt buiten specifieke medische contexten. De alternatieve labels die hier zijn opgenomen, zijn alleen bedoeld om zoekhulpmiddelen te helpen en mogen niet in andere contexten worden gebruikt."},{"@language":"sv","@value":"Bröst som uppfattas som små i ett givet kulturellt sammanhang. Vissa läkare kan i specifika sammanhang använda termer som ”underutvecklade” eller ”hypoplastiska” men dessa uttryck kan vara kränkande och bör undvikas utanför medicinska sammanhang. Alternativa etiketter används här enbart för att underlätta sökning och ska inte användas i andra sammanhang."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001623"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000222"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001623"},"dc:replaces":{"@id":"http://homosaurus.org/v2/smallBreasts"},"dc:issued":{"@type":"xsd:date","@value":"2020-12-11"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003132","dc:identifier":"homoit0003132","skos:prefLabel":[{"@language":"en","@value":"Breast play"},{"@language":"es","@value":"Juego de senos"},{"@language":"de","@value":"Breast-Play"},{"@language":"nl","@value":"Borstspel"},{"@language":"sv","@value":"Breast play"}],"skos:altLabel":[{"@language":"es","@value":"Juego con senos"},{"@language":"de","@value":"Brustspiel"},{"@language":"sv","@value":"Bröstsex"}],"rdfs:comment":[{"@language":"en","@value":"Any sexual activity involving the breasts, including fondling/groping, kissing, licking, rubbing, pinching, or squeezing/constricting."},{"@language":"es","@value":"Cualquier actividad sexual que involucre los senos, incluyendo acariciar/manosear, besar, lamer, frotar, pellizcar o apretar/constreñir."},{"@language":"de","@value":"Sexuelle Handlung, die die Brüste betrifft, einschließlich Streicheln/Begrapschen, Küssen, Lecken, Reiben, Kneifen oder Drücken/Zusammendrücken."},{"@language":"nl","@value":"Elke seksuele activiteit waarbij borsten betrokken zijn, inclusief strelen/betasten, kussen, likken, wrijven, knijpen of vastbinden."},{"@language":"sv","@value":"Sexuella aktiviteter som involverar brösten, inklusive smekning eller beröring, kyssar, slickande, gnidning, nypande samt klämmande eller åtstramande beröring."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001267"},{"@id":"https://homosaurus.org/v5/homoit0001299"}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0001046"},{"@id":"https://homosaurus.org/v5/homoit0003130"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000222"},{"@id":"https://homosaurus.org/v5/homoit0001621"},{"@id":"https://homosaurus.org/v5/homoit0003118"},{"@id":"https://homosaurus.org/v5/homoit0003131"},{"@id":"https://homosaurus.org/v5/homoit0003133"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001267"},"dc:issued":{"@type":"xsd:date","@value":"2023-12-20"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003133","dc:identifier":"homoit0003133","skos:prefLabel":[{"@language":"en","@value":"Chest play"},{"@language":"es","@value":"Juego de pecho"},{"@language":"de","@value":"Bruststimulation"},{"@language":"nl","@value":"Borstkasspel"},{"@language":"sv","@value":"Chest play"}],"skos:altLabel":{"@language":"sv","@value":"Lek med bröstpartiet"},"rdfs:comment":[{"@language":"en","@value":"A gender-inclusive term for any sexual activity involving the the upper area of the torso, including fondling/groping, kissing, licking, rubbing, pinching, or squeezing/constricting."},{"@language":"es","@value":"Un término inclusivo de género para cualquier actividad sexual que involucre el área superior del torso, incluyendo acariciar/manosear, besar, lamer, frotar, pellizcar o apretar/constreñir."},{"@language":"de","@value":"Ein geschlechtsneutraler Begriff für jede sexuelle Aktivität, die den oberen Bereich des Oberkörpers betrifft, einschließlich Streicheln/Tasten, Küssen, Lecken, Reiben, Kneifen oder Quetschen/Einschnüren."},{"@language":"nl","@value":"Een genderinclusieve term voor elke seksuele activiteit waarbij het bovenlichaam betrokken is, inclusief strelen, kussen, likken, wrijven, knijpen of vastbinden."},{"@language":"sv","@value":"En könsneutral term för all sexuell aktivitet som involverar den övre delen av överkroppen, inklusive smekningar, kyssar, slickningar, gnidning, nypning eller åtsnörning."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001267"},{"@id":"https://homosaurus.org/v5/homoit0001299"}],"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0001046"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000222"},{"@id":"https://homosaurus.org/v5/homoit0003118"},{"@id":"https://homosaurus.org/v5/homoit0003132"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001267"},"dc:issued":{"@type":"xsd:date","@value":"2023-12-20"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000223","dc:identifier":"homoit0000223","skos:prefLabel":[{"@language":"en","@value":"Brothels"},{"@language":"es","@value":"Burdeles"},{"@language":"de","@value":"Bordelle"},{"@language":"nl","@value":"Bordelen"},{"@language":"sv","@value":"Bordeller"}],"skos:altLabel":[{"@language":"en","@value":"Bordellos"},{"@language":"de","@value":"Freudenhaus"},{"@language":"de","@value":"Puff"},{"@language":"de","@value":"Laufhaus"},{"@language":"de","@value":"Stundenhotel"}],"rdfs:comment":[{"@language":"en","@value":"Establishments where clients pay to engage in sexual activity with sex workers. Brothels may be illegal, decriminalized, or legal operations."},{"@language":"es","@value":"Establecimientos en los que los clientes pagan para tener relaciones sexuales con trabajadoras sexuales. Los burdeles pueden ser operaciones ilegales, despenalizadas o legales."},{"@language":"de","@value":"Einrichtung, in denen für sexuelle Handlungen mit Sexarbeiter:innen bezahlt wird. Bordelle können illegal, entkriminalisiert oder legal sein."},{"@language":"nl","@value":"Inrichtingen waar klanten betalen om seksuele activiteiten te ondernemen met sekswerkers. Bordelen kunnen illegale, gedecriminaliseerde of legale activiteiten zijn."},{"@language":"sv","@value":"Etablissemang där kunder betalar för att ha sex med sexarbetare/prostituerade. Bordeller kan vara olagliga, avkriminaliserade eller legala verksamheter."}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2005004145"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000223"},"dc:replaces":{"@id":"http://homosaurus.org/v2/brothels"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000224","dc:identifier":"homoit0000224","skos:prefLabel":[{"@language":"en","@value":"Brotherboys"},{"@language":"es","@value":"Brotherboys"},{"@language":"de","@value":"Brotherboy"},{"@language":"nl","@value":"Brotherboys"},{"@language":"sv","@value":"Brotherboys"}],"skos:altLabel":[{"@language":"en","@value":"Brothaboys"},{"@language":"es","@value":"Brothaboys"}],"rdfs:comment":[{"@language":"en","@value":"Indigenous Australian term for people who transition from female to male."},{"@language":"es","@value":"Término indígena australiano para personas que transicionan de mujer a hombre."},{"@language":"de","@value":"Indigener australischer Begriff für Menschen, die eine Geschlechtsumwandlung von weiblich zu männlich vornehmen."},{"@language":"nl","@value":"Inheemse Australische term voor mensen die transitioneren van vrouw naar man"},{"@language":"sv","@value":"Australiensisk urfolksterm för personer som genomgår en könsbekräftande transition från kvinna till man."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000322"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000436"},{"@id":"https://homosaurus.org/v5/homoit0001314"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/brotherboys"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000480","dc:identifier":"homoit0000480","skos:prefLabel":[{"@language":"en","@value":"Gay Buddhists"},{"@language":"es","@value":"Budistas gay"},{"@language":"de","@value":"Schwule Buddhisten"},{"@language":"nl","@value":"Homo-boeddhisten"},{"@language":"sv","@value":"Buddistiska bögar"}],"skos:altLabel":{"@language":"sv","@value":"Homosexuella manliga buddister"},"rdfs:comment":[{"@language":"en","@value":"Gay men who are Buddhist."},{"@language":"es","@value":"Hombres gay que son budistas."},{"@language":"de","@value":"Schwule Männer, die buddhistisch sind."},{"@language":"nl","@value":"Homomannen die boeddhist zijn."},{"@language":"sv","@value":"Bögar som är buddister."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000225"},"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2011004972"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000928"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayBuddhists"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000728","dc:identifier":"homoit0000728","skos:prefLabel":[{"@language":"en","@value":"Lesbian Buddhists"},{"@language":"es","@value":"Budistas lesbianas"},{"@language":"nl","@value":"Lesbische boeddhisten"},{"@language":"sv","@value":"Lesbiska buddister"}],"skos:altLabel":[{"@language":"es","@value":"Lesbianas budistas"},{"@language":"sv","@value":"Buddistiska lesbiska"}],"rdfs:comment":[{"@language":"en","@value":"Lesbians who are Buddhist."},{"@language":"es","@value":"Lesbianas que son budistas. "},{"@language":"nl","@value":"Lesbische vrouwen die boeddhist zijn."},{"@language":"sv","@value":"Lesbiska som är buddister."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000225"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000928"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianBuddhists"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001165","dc:identifier":"homoit0001165","skos:prefLabel":[{"@language":"en","@value":"Queer Buddhists"},{"@language":"es","@value":"Budistas queer"},{"@language":"nl","@value":"Queer boeddhisten"},{"@language":"sv","@value":"Queera buddister"}],"rdfs:comment":[{"@language":"en","@value":"Queer people who are Buddhist."},{"@language":"es","@value":"Personas queer que son budistas."},{"@language":"nl","@value":"Queer personen die boeddhist zijn."},{"@language":"sv","@value":"Queera personer som är buddister."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000225"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000928"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerBuddhists"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001398","dc:identifier":"homoit0001398","skos:prefLabel":[{"@language":"en","@value":"Transgender Buddhists"},{"@language":"es","@value":"Budistas transgénero"},{"@language":"nl","@value":"Transgender boeddhisten"},{"@language":"sv","@value":"Buddistiska transpersoner"}],"rdfs:comment":[{"@language":"en","@value":"Transgender people who are Buddhist."},{"@language":"es","@value":"Personas transgénero que son budistas."},{"@language":"nl","@value":"Transgender personen die boeddhist zijn."},{"@language":"sv","@value":"Transpersoner som är buddister."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000225"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000928"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transgenderBuddhists"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002988","dc:identifier":"homoit0002988","skos:prefLabel":[{"@language":"en","@value":"Asexual Buddhists"},{"@language":"es","@value":"Budistas asexuales"},{"@language":"de","@value":"Asexuelle Buddhist:innen"},{"@language":"nl","@value":"Aseksuele boeddhisten"},{"@language":"sv","@value":"Asexuella buddister"}],"skos:altLabel":[{"@language":"de","@value":"Ace Buddhist:innen"},{"@language":"de","@value":"Asexuelle buddhistische Personen"},{"@language":"de","@value":"Buddhistische asexuelle Personen"},{"@language":"de","@value":"Buddhistische ace Personen"},{"@language":"de","@value":"Ace buddhistische Personen"}],"rdfs:comment":[{"@language":"en","@value":"Asexual people who are Buddhist."},{"@language":"es","@value":"Personas asexuales que son budistas."},{"@language":"de","@value":"Asexuelle Personen, die buddhistisch sind."},{"@language":"nl","@value":"Aseksuele personen die boeddhist zijn."},{"@language":"sv","@value":"Asexuella personer som är buddister."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000225"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000928"},"dc:issued":{"@type":"xsd:date","@value":"2023-10-27"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002989","dc:identifier":"homoit0002989","skos:prefLabel":[{"@language":"en","@value":"Intersex Buddhists"},{"@language":"es","@value":"Budistas intersex"},{"@language":"nl","@value":"Intersekse boeddhisten"},{"@language":"sv","@value":"Intersexbuddister"}],"rdfs:comment":[{"@language":"en","@value":"Intersex people who are Buddhist."},{"@language":"es","@value":"Personas intersex que son budistas."},{"@language":"nl","@value":"Intersekse personen die boeddhist zijn."},{"@language":"sv","@value":"Intersexpersoner som är buddister."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000225"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000928"},"dc:issued":{"@type":"xsd:date","@value":"2023-10-27"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004486","dc:identifier":"homoit0004486","skos:prefLabel":[{"@language":"en","@value":"Abortion funds"},{"@language":"nl","@value":"Abortusfondsen"},{"@language":"sv","@value":"Abortfonder"}],"skos:altLabel":{"@language":"en","@value":"Reproductive freedom funds"},"rdfs:comment":[{"@language":"en","@value":"Financial and logistical assistance, often provided by a non-profit organization, to individuals seeking abortions. These funds may also support needs like travel, lodging, childcare, abortion doulas, translation services, and meals, but are not abortion providers. They may also advocate for changes in legislation that restrict access to abortion."},{"@language":"nl","@value":"Financiële en logistieke ondersteuning, vaak verstrekt door een non-profitorganisatie, aan personen die een abortus overwegen. Deze fondsen kunnen ook voorzien in behoeften zoals reizen, accommodatie, kinderopvang, abortusdoula's, vertaaldiensten en maaltijden, maar de fondsen bieden zelf geen abortus aan. Ze kunnen zich ook inzetten voor wetswijzigingen die de toegang tot abortus beperken."},{"@language":"sv","@value":"Ekonomiskt och logistiskt stöd, ofta tillhandahållet av en ideell organisation, till personer som söker abort. Dessa medel kan också stödja behov som resor, boende, barnomsorg, abortdoula, översättningstjänster och måltider, men tillhandahåller inte själva aborterna. De kan också förespråka lagändringar mot begränsningar av aborträtten."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0004346"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0003366"},{"@id":"https://homosaurus.org/v5/homoit0000226"},{"@id":"https://homosaurus.org/v5/homoit0004413"},{"@id":"https://homosaurus.org/v5/homoit0004428"},{"@id":"https://homosaurus.org/v5/homoit0004429"},{"@id":"https://homosaurus.org/v5/homoit0003365"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0004346"},"dc:issued":{"@type":"xsd:date","@value":"2026-03-03"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000227","dc:identifier":"homoit0000227","skos:prefLabel":[{"@language":"en","@value":"Sodomites"},{"@language":"es","@value":"Sodomitas"},{"@language":"nl","@value":"Sodomieten"},{"@language":"sv","@value":"Sodomiter"}],"skos:altLabel":{"@language":"en","@value":"Buggers"},"rdfs:comment":[{"@language":"en","@value":"Pejorative historical term for individuals who engage in sexual activities that are characterized as unnatural or immoral; commonly applied to gay men engaging in anal sex. Only use in historical contexts."},{"@language":"es","@value":"Término histórico peyorativo para personas que participan en actividades sexuales que se caracterizan como antinaturales o inmorales; comúnmente se aplica a hombres gay que practican sexo anal. Utilícese únicamente en contextos históricos."},{"@language":"nl","@value":"Pejoratieve historische term voor personen die zich bezighouden met seksuele activiteiten die worden gekenmerkt als onnatuurlijk of immoreel; vaak toegepast op homoseksuele mannen die zich bezighouden met anale seks; alleen gebruiken in historische contexten"},{"@language":"sv","@value":"Nedsättande historisk term för personer som ägnar sig åt sexuella handlingar som betraktas som onaturliga eller omoraliska. Termen användes ofta om bögar som utövade analsex. Bör endast användas i historiska sammanhang."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000878"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001297"},{"@id":"https://homosaurus.org/v5/homoit0001325"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000878"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sodomites"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001325","dc:identifier":"homoit0001325","skos:prefLabel":[{"@language":"en","@value":"Sodomy"},{"@language":"es","@value":"Sodomía"},{"@language":"nl","@value":"Sodomie"},{"@language":"sv","@value":"Sodomi"}],"rdfs:comment":[{"@language":"en","@value":"Historical term for \"unnatural\" sexual acts unrelated to procreation, including oral sex and anal sex."},{"@language":"es","@value":"Término histórico para actos sexuales \"antinaturales\" no relacionados con la procreación, incluido el sexo oral y el sexo anal."},{"@language":"nl","@value":"historische term voor \"tegennatuurlijke\" seksuele handelingen; naast seks met dieren werd onder sodomie ook zowel homoseksuele als heteroseksuele anale penetratie verstaan"},{"@language":"sv","@value":"Historisk term för ”onaturliga” sexuella handlingar som inte syftar till fortplantning, inklusive oralsex och analsex."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000878"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000227"},{"@id":"https://homosaurus.org/v5/homoit0001095"},{"@id":"https://homosaurus.org/v5/homoit0001267"},{"@id":"https://homosaurus.org/v5/homoit0001299"},{"@id":"https://homosaurus.org/v5/homoit0001326"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85124275"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000878"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sodomy"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000228","dc:identifier":"homoit0000228","skos:prefLabel":[{"@language":"en","@value":"Bullying"},{"@language":"de","@value":"Mobbing"},{"@language":"es","@value":"Bullying"},{"@language":"nl","@value":"Pesten"},{"@language":"sv","@value":"Mobbning"}],"skos:altLabel":{"@language":"de","@value":"Mobben"},"rdfs:comment":[{"@language":"en","@value":"A form of aggressive behavior that can include verbal harassment, physical assault, or coercion. Bullying is typically directed repeatedly towards particular victims, often on the grounds of race, gender, sexuality, or ability."},{"@language":"de","@value":"Eine Form aggressiven Verhaltens, die verbale Belästigung, körperliche Gewalt oder Nötigung umfassen kann. Mobbing richtet sich in der Regel wiederholt gegen bestimmte Opfer, häufig aufgrund ihrer ethnischen Herkunft, ihres Geschlechts, ihrer Sexualität oder ihrer Fähigkeiten."},{"@language":"es","@value":"Una forma de comportamiento agresivo que puede incluir el acoso verbal, la agresión física o la coerción. Por lo general, el acoso se dirige repetidamente hacia víctimas particulares, a menudo por motivos de raza, género, sexualidad o capacidad."},{"@language":"nl","@value":"een vorm van gedrag waarbij personen herhaaldelijk en gedurende langere tijd door één of meerdere anderen op agressieve wijze bejegend worden; het kan daarbij gaan om verbale intimidatie, fysiekgeweld of dwang en kan gericht zijn tegen specifiekeslachtoffers, mogelijk op grond van etniciteit, religie,gender of seksualiteit"},{"@language":"sv","@value":"En form av aggressivt beteende som kan inkludera verbala trakasserier, fysiska angrepp eller tvång. Mobbning riktas vanligtvis upprepade gånger mot specifika offer, ofta på grund av ras, kön, sexualitet eller funktionalitet."}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000611"},{"@id":"https://homosaurus.org/v5/homoit0000920"},{"@id":"https://homosaurus.org/v5/homoit0001989"},{"@id":"https://homosaurus.org/v5/homoit0001998"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh89006054"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000228"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bullying"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000611","dc:identifier":"homoit0000611","skos:prefLabel":[{"@language":"en","@value":"Harassment"},{"@language":"de","@value":"Belästigung"},{"@language":"es","@value":"Acoso"},{"@language":"nl","@value":"Intimidatie"},{"@language":"sv","@value":"Trakasserier"}],"skos:altLabel":[{"@language":"de","@value":"Diskriminierung"},{"@language":"es","@value":"Hostigamiento"}],"rdfs:comment":[{"@language":"en","@value":"Covers a wide range of behaviors that are intended to disturb or upset. Harassment is often repetitive or occurs across an extended period of time."},{"@language":"de","@value":"Umfasst eine Vielzahl von Verhaltensweisen, die darauf abzielen, zu stören oder zu verärgern. Belästigung tritt häufig wiederholt oder über einen längeren Zeitraum auf."},{"@language":"es","@value":"Cubre una amplia gama de comportamientos que tienen como objetivo perturbar o alterar. El acoso suele ser repetitivo u ocurrir durante un período prolongado."},{"@language":"nl","@value":"iemands gedrag beïnvloeden door hem angst aan te jagen door te dreigen met negatieve gevolgen"},{"@language":"sv","@value":"Omfattar olika beteenden som är avsedda att störa eller kränka. Trakasserier är ofta upprepade eller pågår under en längre tidsperiod."}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0001121"},{"@id":"https://homosaurus.org/v5/homoit0001293"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000228"},{"@id":"https://homosaurus.org/v5/homoit0000356"},{"@id":"https://homosaurus.org/v5/homoit0001560"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh97007082"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000611"},"dc:replaces":{"@id":"http://homosaurus.org/v2/harassment"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001989","dc:identifier":"homoit0001989","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ victims of bullying"},{"@language":"es","@value":"Víctimas LGBTQ+ de acoso"},{"@language":"fr","@value":"Personnes LGBTQ+ victimes d'intimidation"},{"@language":"nl","@value":"LHBTQ+-slachtoffers van pesten"},{"@language":"sv","@value":"Hbtq+-personer som är mobbningsoffer"}],"skos:altLabel":[{"@language":"en","@value":"Victims of bullying (LGBTQ)"},{"@language":"sv","@value":"Hbtq+-personer som utsatts för mobbning"}],"rdfs:comment":[{"@language":"en","@value":"LGBTQ+ people who have experienced bullying due to their gender or sexual identity and may or may not have survived; follow the individual's preference for \"victims\" or \"survivors\" whenever possible."},{"@language":"es","@value":"Personas LGBTQ+ que han sufrido acoso debido a su género o identidad sexual y pueden o no haber sobrevivido; siga la preferencia de la persona sobre el uso de \"víctimas\" o \"sobrevivientes\" siempre que sea posible."},{"@language":"fr","@value":"Personnes LGBT+ qui ont subi et survécu à de l'intimidation en raison de leur identité sexuelle ou de genre; respecter la préférence de la personne concernée entre les termes « victimes » ou « survivantes » dans la mesure du possible."},{"@language":"nl","@value":"LHBTQ+-personen die pesten hebben meegemaakt vanwege hun gender of seksuele identiteit en het al dan niet hebben overleefd; volg waar mogelijk de voorkeur van het individu voor \"slachtoffers\" of \"overlevenden\"."},{"@language":"sv","@value":"Hbtq+-personer som har upplevt mobbning på grund av sin sexuella identitet och som kan ha överlevt eller inte. Följ individens preferens för att använda ”offer” eller ”överlevare” när det är möjligt."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000915"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0001990"},{"@id":"https://homosaurus.org/v5/homoit0001991"},{"@id":"https://homosaurus.org/v5/homoit0001992"},{"@id":"https://homosaurus.org/v5/homoit0001993"},{"@id":"https://homosaurus.org/v5/homoit0001994"},{"@id":"https://homosaurus.org/v5/homoit0001995"},{"@id":"https://homosaurus.org/v5/homoit0001996"},{"@id":"https://homosaurus.org/v5/homoit0001998"},{"@id":"https://homosaurus.org/v5/homoit0003474"},{"@id":"https://homosaurus.org/v5/homoit0000324"},{"@id":"https://homosaurus.org/v5/homoit0004424"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000228"},{"@id":"https://homosaurus.org/v5/homoit0001997"},{"@id":"https://homosaurus.org/v5/homoit0003487"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-05-11"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001998","dc:identifier":"homoit0001998","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ survivors of bullying"},{"@language":"es","@value":"Sobrevivientes LGBTQ+ de acoso"},{"@language":"fr","@value":"Personnes LGBTQ+ survivantes d'intimidation"},{"@language":"nl","@value":"LHBTQ+-overlevenden van pesten"},{"@language":"sv","@value":"Hbtq+-personer som överlevt mobbning"}],"skos:altLabel":{"@language":"sv","@value":"Hbtq+-personer som är mobbningsöverlevare"},"rdfs:comment":[{"@language":"en","@value":"LGBTQ+ people who have experienced and survived bullying due to their gender or sexual identity; follow the individual's preference for \"victims\" or \"survivors\" whenever possible."},{"@language":"es","@value":"Personas LGBTQ+ que han sufrido y sobrevivido al acoso debido a su género o identidad sexual; siga la preferencia de la persona sobre el uso de \"víctimas\" o \"sobrevivientes\" siempre que sea posible."},{"@language":"fr","@value":"Personnes LGBTQ+ qui ont subi et survécu à de l'intimidation en raison de leurs identités sexuelles ou de genres; respecter la préférence de la personne concernée entre les termes « victimes » ou « survivantes » dans la mesure du possible."},{"@language":"nl","@value":"LHBTQ+-personen die pesten hebben meegemaakt en overleefd vanwege hun gender of seksuele identiteit; volg waar mogelijk de voorkeur van het individu voor \"slachtoffers\" of \"overlevenden\""},{"@language":"sv","@value":"Hbtq+-personer som har upplevt och överlevt mobbning på grund av sin könsidentitet eller sexuella identitet. Följ individens preferens för att använda ”offer” eller ”överlevare” när det är möjligt."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001989"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0001999"},{"@id":"https://homosaurus.org/v5/homoit0002000"},{"@id":"https://homosaurus.org/v5/homoit0002001"},{"@id":"https://homosaurus.org/v5/homoit0002002"},{"@id":"https://homosaurus.org/v5/homoit0002003"},{"@id":"https://homosaurus.org/v5/homoit0002004"},{"@id":"https://homosaurus.org/v5/homoit0002005"},{"@id":"https://homosaurus.org/v5/homoit0003460"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000228"},{"@id":"https://homosaurus.org/v5/homoit0002006"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-05-11"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000229","dc:identifier":"homoit0000229","skos:prefLabel":[{"@language":"sq","@value":"Burrnesha"},{"@language":"es","@value":"Burrnesha"},{"@language":"de","@value":"Schwurjungfrau"},{"@language":"nl","@value":"Burrnesha"},{"@language":"sv","@value":"Burrnesha"}],"skos:altLabel":[{"@language":"de","@value":"Burrnesha"},{"@language":"de","@value":"Eingeschworene Jungfrau"}],"rdfs:comment":[{"@language":"en","@value":"In the Balkans, people assigned female at birth who take a vow of chastity and live as men."},{"@language":"es","@value":"En los Balcanes, personas asignadas al sexo femenino al nacer que asumen un voto de castidad y viven como hombres."},{"@language":"de","@value":"Personen auf dem Balkan, die bei ihrer Geburt als weiblich zugewiesen wurden, ein Keuschheitsgelübde ablegen und als Männer leben."},{"@language":"nl","@value":"In de Balkan, mensen toegewezen als vrouw bij hun geboorte, die een gelofte van kuisheid afleggen en als mannen leven"},{"@language":"sv","@value":"På Balkan, personer som tilldelats kvinnligt kön vid födseln och som avlägger ett kyskhetslöfte och lever som män."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000322"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/burrnesha"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000230","dc:identifier":"homoit0000230","skos:prefLabel":[{"@language":"en","@value":"Butch-femme relationships"},{"@language":"de","@value":"Butch-Femme-Beziehungen"},{"@language":"es","@value":"Relaciones butch-femme"},{"@language":"nl","@value":"Butch-femme relaties"},{"@language":"sv","@value":"Butch-femme-relationer"}],"skos:altLabel":[{"@language":"es","@value":"Relaciones bucha-femme"},{"@language":"es","@value":"Relaciones butches-femmes"}],"rdfs:comment":[{"@language":"en","@value":"Romantic, sexual, or play relationships between a masculine-identifying or -presenting person and a feminine-identifying or -presenting person. Though the terms \"butch\" and \"femme\" are most commonly used in lesbian communities, they are also used by other LGBTQ+ people. Only use to describe relationships between individuals who self-identify as butch and femme."},{"@language":"de","@value":"Romantische, sexuelle oder spielerische Beziehungen zwischen einer sich als maskulin identifizierenden oder darstellenden Person und einer sich als feminin identifizierenden oder darstellenden Person. Obwohl die Begriffe „Butch“ und „Femme“ am häufigsten in lesbischen Gemeinschaften verwendet werden, werden sie auch von anderen LGBTQ+ Menschen verwendet. Nur zur Beschreibung von Beziehungen zwischen Personen verwenden, die sich selbst als Butch und Femme identifizieren."},{"@language":"es","@value":"Relaciones románticas, sexuales o de juego entre una persona que se autoidentifica o presenta como masculina y una persona que se autoidentifica o presenta como femenina. Aunque los términos \"butch\" y \"femme\" se utilizan con mayor frecuencia en las comunidades de lesbianas, también los utilizan otras personas LGBTQ+. Utilícese únicamente para describir relaciones entre personas que se autoidentifiquen como marimacho y mujer."},{"@language":"nl","@value":"Romantische, seksuele of spelrelaties tussen een masculien-identificerend of -presenterend persoon en een feminien-identificerend of -presenterend persoon. Hoewel de termen 'butch' en 'femme' het meest worden gebruikt in lesbische gemeenschappen, worden ze ook gebruikt door andere LHBTQ+-personen. Alleen gebruiken om relaties te beschrijven tussen individuen die zichzelf identificeren als butch en femme."},{"@language":"sv","@value":"Romantiska, sexuella eller kinkrelaterade relationer mellan en maskulint identifierande eller maskulint presenterande person och en feminint identifierande eller feminint presenterande person. Termerna butch och femme används oftast inom lesbiska gemenskaper men förekommer även bland andra hbtq+-personer. Används endast för relationer mellan personer som själva identifierar sig som butch och femme."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000382"},{"@id":"https://homosaurus.org/v5/homoit0001237"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000231"},{"@id":"https://homosaurus.org/v5/homoit0000440"},{"@id":"https://homosaurus.org/v5/homoit0001241"},{"@id":"https://homosaurus.org/v5/homoit0001295"},{"@id":"https://homosaurus.org/v5/homoit0001340"}],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2012003858"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/butchFemmeRelationships"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000382","dc:identifier":"homoit0000382","skos:prefLabel":[{"@language":"en","@value":"Lesbian culture"},{"@language":"es","@value":"Cultura lésbica"},{"@language":"de","@value":"Lesbische Kultur"},{"@language":"nl","@value":"Lesbische cultuur"},{"@language":"sv","@value":"Lesbisk kultur"}],"skos:altLabel":[{"@language":"en","@value":"Dyke culture"},{"@language":"de","@value":"Lesbenkultur"},{"@language":"de","@value":"Dyke-Kultur"},{"@language":"sv","@value":"Flatkultur"}],"rdfs:comment":[{"@language":"en","@value":"Use to describe cultural experiences shared by members of lesbian communities or products of lesbian culture (e.g., art and media created by and for lesbians, activism focused on lesbian issues, slang commonly used in lesbian communities, etc.)."},{"@language":"es","@value":"Utilícese para describir experiencias culturales compartidas por miembros de comunidades lésbicas o productos de la cultura lésbica (p. ej., arte y medios creados por y para lesbianas, activismo centrado en cuestiones lésbicas, jerga comúnmente utilizada en comunidades lésbicas, etc.)."},{"@language":"de","@value":"Bezieht sich auf kulturelle Erfahrungen, die Mitglieder der lesbischen Gemeinschaft teilen, oder auf Produkte der lesbischen Kultur (z. B. Kunst und Medien, die von und für Lesben geschaffen wurden, Aktivismus mit Schwerpunkt auf lesbische Themen, in lesbischen Gemeinschaften gebräuchliche Slangausdrücke usw.)."},{"@language":"nl","@value":"Gebruik om culturele ervaringen te beschrijven die worden gedeeld door leden van lesbische gemeenschappen of producten van lesbische cultuur (bijv. kunst en media gemaakt door en voor lesbische vrouwen, activisme gericht op lesbische kwesties, jargon dat veel wordt gebruikt in lesbische gemeenschappen, enz.)."},{"@language":"sv","@value":"Kulturella erfarenheter som delas av medlemmar i lesbiska gemenskaper eller produkter av lesbisk kultur, till exempel konst och medier skapade av och för lesbiska, aktivism med fokus på lesbiska frågor eller slang som används inom lesbiska gemenskaper."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001831"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000230"},{"@id":"https://homosaurus.org/v5/homoit0000385"},{"@id":"https://homosaurus.org/v5/homoit0000730"},{"@id":"https://homosaurus.org/v5/homoit0000755"},{"@id":"https://homosaurus.org/v5/homoit0000779"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001295"},{"@id":"https://homosaurus.org/v5/homoit0001832"},{"@id":"https://homosaurus.org/v5/homoit0001833"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2004003370"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianCulture"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000440","dc:identifier":"homoit0000440","skos:prefLabel":[{"@language":"en","@value":"Femmes"},{"@language":"es","@value":"Femmes"},{"@language":"de","@value":"Femmes"},{"@language":"nl","@value":"Femmes"},{"@language":"sv","@value":"Femmes"}],"skos:altLabel":{"@language":"sv","@value":"Läppstiftslesbiska"},"rdfs:comment":[{"@language":"en","@value":"Feminine people of any gender, though this term is commonly used in lesbian communities."},{"@language":"es","@value":"Personas femeninas de cualquier género, aunque este término se utiliza comúnmente en las comunidades lésbicas."},{"@language":"de","@value":"Sich weiblich verhaltende Person jeden Geschlechts, wird häufig in lesbischen Gemeinschaften verwendet."},{"@language":"sv","@value":"Feminina personer av alla kön, även om termen är vanligast inom lesbiska gemenskaper."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000577"},{"@id":"https://homosaurus.org/v5/homoit0001295"},{"@id":"https://homosaurus.org/v5/homoit0001304"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000230"},{"@id":"https://homosaurus.org/v5/homoit0000231"},{"@id":"https://homosaurus.org/v5/homoit0000384"},{"@id":"https://homosaurus.org/v5/homoit0000389"},{"@id":"https://homosaurus.org/v5/homoit0000568"},{"@id":"https://homosaurus.org/v5/homoit0000971"},{"@id":"https://homosaurus.org/v5/homoit0001327"},{"@id":"https://homosaurus.org/v5/homoit0001340"},{"@id":"https://homosaurus.org/v5/homoit0002043"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001241"},"dc:replaces":{"@id":"http://homosaurus.org/v2/femmes"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001241","dc:identifier":"homoit0001241","skos:prefLabel":[{"@language":"en-us","@value":"Role behavior"},{"@language":"es","@value":"Comportamiento de rol"},{"@language":"nl","@value":"Rolgedrag"},{"@language":"sv","@value":"Rollbeteende"},{"@language":"en-gb","@value":"Role behaviour"}],"rdfs:comment":[{"@language":"en","@value":"Behavior determining one's response to a social situation, as influenced by social norms; internal and external expectations; and social sanctions and rewards."},{"@language":"es","@value":"Comportamiento que determina la respuesta de cada persona a una situación social, influenciado por las normas sociales; expectativas internas y externas; y sanciones y recompensas sociales."},{"@language":"nl","@value":"sociaal gedrag dat in overeenstemming is met iemands veronderstelde rol"},{"@language":"sv","@value":"Beteenden som styrs av sociala normer, inre och yttre förväntningar samt sociala sanktioner och belöningar."}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000577"},{"@id":"https://homosaurus.org/v5/homoit0001304"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000230"},{"@id":"https://homosaurus.org/v5/homoit0001242"},{"@id":"https://homosaurus.org/v5/homoit0001295"},{"@id":"https://homosaurus.org/v5/homoit0001323"},{"@id":"https://homosaurus.org/v5/homoit0002165"},{"@id":"https://homosaurus.org/v5/homoit0002168"},{"@id":"https://homosaurus.org/v5/homoit0002169"},{"@id":"https://homosaurus.org/v5/homoit0002207"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001241"},"dc:replaces":{"@id":"http://homosaurus.org/v2/roleBehaviour"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001340","dc:identifier":"homoit0001340","skos:prefLabel":[{"@language":"en","@value":"Stone butches"},{"@language":"es","@value":"Marimachas fuertes"},{"@language":"nl","@value":"Stone butches"},{"@language":"sv","@value":"Stone butches"}],"rdfs:comment":[{"@language":"en","@value":"Individuals whose gender expression and/or identity is masculine-presenting and who usually do not like to be sexually touched, though they will still provide their partners with sexual pleasure; commonly used in lesbian communities."},{"@language":"es","@value":"Personas cuya expresión y/o identidad de género es de presentación masculina y a quienes generalmente no les gusta que les toquen sexualmente, aunque sí brindarán placer sexual a sus parejas; comúnmente utilizado en comunidades de lesbianas."},{"@language":"sv","@value":"Personer vars könsuttryck och/eller könsidentitet uppfattas som maskulint och som oftast inte vill bli berörda sexuellt men som ändå ger sina partners sexuell njutning. Används inom amerikanska lesbiska gemenskaper."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001295"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000230"},{"@id":"https://homosaurus.org/v5/homoit0000231"},{"@id":"https://homosaurus.org/v5/homoit0000440"},{"@id":"https://homosaurus.org/v5/homoit0000556"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001295"},"dc:replaces":{"@id":"http://homosaurus.org/v2/stoneButches"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000384","dc:identifier":"homoit0000384","skos:prefLabel":[{"@language":"en","@value":"Dykes"},{"@language":"de","@value":"Dykes"},{"@language":"es","@value":"Dykes"},{"@language":"nl","@value":"Potten"},{"@language":"sv","@value":"Flator"}],"rdfs:comment":[{"@language":"en","@value":"A largely reclaimed slur common in the U.S. that may be used to refer to lesbians who embrace a masculine style of presentation or lesbian political activists in general. Only use for individuals who self-identify as dykes."},{"@language":"de","@value":"In den meisten Fällen eine zurückeroberte Beleidigung, die in den USA häufig verwendet wird, um Lesben mit einem männlichen Stil von Selbstpräsentation oder lesbische politische Aktivist:innen insgesamt zu bezeichnen. Nur für Personen verwenden, die sich selbst als Dykes identifizieren."},{"@language":"es","@value":"Un insulto ampliamente reclamado y común en los EE. UU. que puede utilizarse para referirse a lesbianas que adoptan un estilo de presentación masculino o a activistas políticas lesbianas en general. Utilícese únicamente para personas que se autoidentifiquen como dykes."},{"@language":"nl","@value":"Geuzennaam die kan worden gebruikt om te verwijzen naar lesbische vrouwen of lesbische politieke activisten in het algemeen; alleen gebruiken voor personen die zichzelf identificeren als potten"},{"@language":"sv","@value":"En till stor del återvunnen nedsättande term som kan användas för att beskriva lesbiska som omfamnar en maskulin stil eller lesbiska med ett politiskt aktivt engagemang. Används endast för personer som själva identifierar sig som flator."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001559"},{"@id":"https://homosaurus.org/v5/homoit0001560"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000231"},{"@id":"https://homosaurus.org/v5/homoit0000440"},{"@id":"https://homosaurus.org/v5/homoit0000556"},{"@id":"https://homosaurus.org/v5/homoit0003719"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001317"},"dc:replaces":{"@id":"http://homosaurus.org/v2/dykes"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001327","dc:identifier":"homoit0001327","skos:prefLabel":[{"@language":"en","@value":"Soft butches"},{"@language":"es","@value":"Marimachas suaves"},{"@language":"nl","@value":"Soft butches"},{"@language":"sv","@value":"Soft butches"}],"rdfs:comment":[{"@language":"en","@value":"People who are somewhat or slightly masculine in their appearance; commonly used in lesbian communities."},{"@language":"es","@value":"Personas que tienen una apariencia algo o ligeramente masculina; comúnmente utilizado en comunidades de lesbianas."},{"@language":"sv","@value":"Personer som uppfattas som något eller lätt maskulina till utseendet. Används inom amerikanska lesbiska gemenskaper."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001295"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000231"},{"@id":"https://homosaurus.org/v5/homoit0000440"},{"@id":"https://homosaurus.org/v5/homoit0000556"},{"@id":"https://homosaurus.org/v5/homoit0002061"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001295"},"dc:replaces":{"@id":"http://homosaurus.org/v2/softButches"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001374","dc:identifier":"homoit0001374","skos:prefLabel":[{"@language":"en","@value":"Tomboys"},{"@language":"es","@value":"Tomboys"},{"@language":"fr","@value":"Tomboys"},{"@language":"nl","@value":"Tomboys"},{"@language":"sv","@value":"Pojkflickor"}],"skos:altLabel":[{"@language":"es","@value":"Tomboy"},{"@language":"fr","@value":"Garçons manqués"}],"rdfs:comment":[{"@language":"en","@value":"Girls who exhibit some characteristics associated with gender expectations for boys."},{"@language":"es","@value":"Termino en ingles que se refiere a niñas que exhiben algunas características asociadas con las expectativas de género para los niños."},{"@language":"fr","@value":"Filles qui présentent une expression de genre dite plus « masculine ». Ce terme peut avoir une connotation négative pour certaines personnes, alors que d'autres le revendiquent."},{"@language":"nl","@value":"meiden die sommige kenmerken van de genderrol van een jongen overnemen"},{"@language":"sv","@value":"Flickor som uppvisar vissa egenskaper som är förknippade med könsnormer för pojkar."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000577"},{"@id":"https://homosaurus.org/v5/homoit0000590"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000231"},{"@id":"https://homosaurus.org/v5/homoit0002061"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2011002322"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001241"},"dc:replaces":{"@id":"http://homosaurus.org/v2/tomboys"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001499","dc:identifier":"homoit0001499","skos:prefLabel":[{"@language":"es","@value":"Whakatane"},{"@language":"mi","@value":"Whakatāne"},{"@language":"nl","@value":"Whakatane"},{"@language":"sv","@value":"Whakatane"}],"skos:altLabel":[{"@language":"en","@value":"Whakatane"},{"@language":"mi","@value":"Wakatane"},{"@language":"es","@value":"Wakatane"}],"rdfs:comment":[{"@language":"en","@value":"In Māori culture in New Zealand, this term is used to describe people assigned female at birth who pursue traditionally male roles."},{"@language":"es","@value":"En la cultura maorí de Nueva Zelanda, este término se utiliza para describir a las personas asignadas al sexo femenino al nacer y que desempeñan roles tradicionalmente masculinos."},{"@language":"nl","@value":"In de Māori-cultuur in Nieuw-Zeeland, mensen die bij de geboorte als vrouw zijn toegewezen en traditioneel mannelijke rollen vervullen"},{"@language":"sv","@value":"I māorikulturen i Nya Zeeland används termen för personer som tilldelats kvinnligt kön vid födseln och som tar på sig traditionellt manliga roller."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000322"},{"@id":"https://homosaurus.org/v5/homoit0002653"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000231"},{"@id":"https://homosaurus.org/v5/homoit0001502"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/wakatane"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000234","dc:identifier":"homoit0000234","skos:prefLabel":[{"@language":"bug","@value":"Calabai"},{"@language":"es","@value":"Calabai"},{"@language":"de","@value":"Calabai"},{"@language":"nl","@value":"Calabai"},{"@language":"sv","@value":"Calabai"}],"rdfs:comment":[{"@language":"en","@value":"In Bugis culture, this term refers to people assigned male at birth who assume female roles."},{"@language":"es","@value":"En la cultura bugis, este término se refiere a personas asignadas al sexo masculino al nacer y que asumen roles femeninos."},{"@language":"de","@value":"In der Kultur der Bugis bezieht sich dieser Begriff auf Menschen, denen bei der Geburt ein männliches Geschlecht zugewiesen wurde und die eine weibliche Rolle übernehmen."},{"@language":"nl","@value":"In de Bugis-cultuur verwijst dit naar mensen die bij de geboorte als man zijn toegewezen en die vrouwelijke rollen aannemen"},{"@language":"sv","@value":"I Bugis-kulturen används denna term för personer som tilldelats manligt kön vid födseln och som antar kvinnliga roller."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000322"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/calabai"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000235","dc:identifier":"homoit0000235","skos:prefLabel":[{"@language":"bug","@value":"Calalai"},{"@language":"es","@value":"Calalai"},{"@language":"de","@value":"Calalai"},{"@language":"nl","@value":"Calalai"},{"@language":"sv","@value":"Calalai"}],"rdfs:comment":[{"@language":"en","@value":"In Bugis culture, this term refers to people assigned female at birth who assume male roles."},{"@language":"es","@value":"En la cultura bugis, este término se refiere a personas asignadas al sexo femenino al nacer y que asumen roles masculinos."},{"@language":"de","@value":"In der Kultur der Bugis bezieht sich dieser Begriff auf Menschen, denen bei der Geburt eine weibliche Rolle zugewiesen wurde, die aber männliche Rollen übernehmen."},{"@language":"nl","@value":"In de Bugis-cultuur verwijst dit naar mensen die bij de geboorte als vrouw zijn toegewezen en mannelijke rollen aannemen"},{"@language":"sv","@value":"I Bugis-kulturen används denna term för personer som tilldelats kvinnligt kön vid födseln och som antar manliga roller."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000322"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/calalai"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000236","dc:identifier":"homoit0000236","skos:prefLabel":[{"@language":"en","@value":"Men sex workers"},{"@language":"es","@value":"Trabajadores sexuales hombres"},{"@language":"nl","@value":"Mannelijke sekswerkers"},{"@language":"sv","@value":"Manliga sexarbetare"}],"skos:altLabel":[{"@language":"en","@value":"Call boys"},{"@language":"en","@value":"Gigolos"},{"@language":"en","@value":"Rent boys"},{"@language":"en","@value":"Taxi boys"},{"@language":"en","@value":"Male sex workers"},{"@language":"en","@value":"Male prostitutes"},{"@language":"en","@value":"Men prostitutes"},{"@language":"en","@value":"Male prostitution"},{"@language":"en","@value":"Men prostitution"},{"@language":"en","@value":"Male sex work"},{"@language":"en","@value":"Men sex work"},{"@language":"es","@value":"Prostitutos"},{"@language":"es","@value":"Trabajo sexual masculino"},{"@language":"nl","@value":"Mannelijke prostitutie"},{"@language":"nl","@value":"Mannelijke prostitués"},{"@language":"nl","@value":"Prostitutie door mannen"},{"@language":"nl","@value":"Prostitués"},{"@language":"nl","@value":"Sekswerk door mannen"}],"rdfs:comment":[{"@language":"en","@value":"Men who receive money or goods in exchange for sexual services, performances, or companionship. Use to describe men working across the broad spectrum of sex work."},{"@language":"es","@value":"Hombres que reciben dinero o bienes a cambio de servicios o actuaciones sexuales. Se debe utilizar para describir a los hombres que trabajan en el amplio espectro del trabajo sexual."},{"@language":"nl","@value":"Mannen die geld of goederen ontvangen in ruil voor seksuele diensten, optredens of gezelschap. Wordt gebruikt om mannen te beschrijven die werkzaam zijn in het brede spectrum van sekswerk."},{"@language":"sv","@value":"Män som tar emot pengar eller varor i utbyte mot sexuella handlingar, framträdanden eller sällskap. Används för att beskriva män som är verksamma inom det breda spektrumet av sexarbete. Vissa anser termen sexarbetare som kränkade och politiserad, medan andra identifierar sig med den. Se även \"Män i prostitution\"."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0003758"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh93007104"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0003758"},"dc:replaces":{"@id":"http://homosaurus.org/v2/maleProstitutes"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000237","dc:identifier":"homoit0000237","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ Calvinists"},{"@language":"es","@value":"Calvinistas LGBTQ+"},{"@language":"ja","@value":"LGBTQ+のカルヴァン派"},{"@language":"nl","@value":"LHBTQ+-calvinisten"},{"@language":"sv","@value":"Kalvinister (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"Calvinists (LGBTQ)"},{"@language":"en","@value":"LGBTQ Calvinists"},{"@language":"es","@value":"Calvinistas (LGBTQ)"},{"@language":"es","@value":"Calvinistas LGBTQ"}],"rdfs:comment":[{"@language":"en","@value":"LGBTQ+ people who are Calvinists."},{"@language":"es","@value":"Personas LGBTQ+ que son calvinistas."},{"@language":"ja","@value":"キリスト教カルヴァン派のLGBTQ+の人々。"},{"@language":"nl","@value":"LHBTQ+-personen die calvinistisch zijn."},{"@language":"sv","@value":"Hbtq+-personer som är kalvinister."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001137"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000928"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQCalvinists"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000238","dc:identifier":"homoit0000238","skos:prefLabel":[{"@language":"en","@value":"Camp (Gay culture)"},{"@language":"es","@value":"Camp (cultura gay)"},{"@language":"de","@value":"Camp"},{"@language":"nl","@value":"Camp"},{"@language":"sv","@value":"Camp"}],"skos:altLabel":[{"@language":"en","@value":"Camp"},{"@language":"es","@value":"Camp"}],"rdfs:comment":[{"@language":"en","@value":"An aesthetic style and sensibility that values irony and bad taste."},{"@language":"es","@value":"Un estilo y una sensibilidad estética que valora la ironía y el mal gusto."},{"@language":"de","@value":"Ein Stil und ein ästhetisches Empfinden in der queeren Kultur, das Ironie und schlechten Geschmack hochhält."},{"@language":"sv","@value":"En estetisk stil och ett sätt att uppskatta uttryck som präglas av ironi och avsiktligt dålig smak."}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000367"},{"@id":"https://homosaurus.org/v5/homoit0000487"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2006000805"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000238"},"dc:replaces":{"@id":"http://homosaurus.org/v2/camp"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000367","dc:identifier":"homoit0000367","skos:prefLabel":[{"@language":"en","@value":"Drag"},{"@language":"es","@value":"Drag"},{"@language":"de","@value":"Drag"},{"@language":"nl","@value":"Drag"},{"@language":"sv","@value":"Drag"}],"rdfs:comment":[{"@language":"en","@value":"A performance genre involving dressing and/or using makeup to produce, emphasize, and/or exaggerate traits associated with a certain gender, which typically (but not always) is not the gender the performer primarily identifies with."},{"@language":"es","@value":"Un tipo de actuación que implica vestirse y/o usar maquillaje para producir, enfatizar y/o exagerar rasgos asociados con un determinado género, que normalmente (pero no siempre) no es el género con el que el artista se identifica principalmente."},{"@language":"de","@value":"Ein darstellendes Genre, in dem Künstler:innen sich verkleiden und schminken, um Merkmale verbunden mit einem bestimmten Geschlecht zu schaffen, zu betonen oder zu übertreiben, oft (aber nicht immer) mit der Wirkung eines Geschlechts, mit dem sich der Performer nicht in erster Linie identifiziert."},{"@language":"nl","@value":"Een performance-genre waarbij kleding en/of make-up wordt gebruikt om eigenschappen van een bepaald gender te produceren, te benadrukken en/of te overdrijven, wat doorgaans (maar niet altijd) niet het gender is waarmee de artiest zich primair identificeert."},{"@language":"sv","@value":"En uppträdandegenre som innebär att klä sig och/eller använda smink för att skapa, framhäva och/eller överdriva drag som förknippas med ett visst kön, vilket vanligtvis men inte alltid inte är det kön som utövaren i första hand identifierar sig med."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000568"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000970"},{"@id":"https://homosaurus.org/v5/homoit0003160"},{"@id":"https://homosaurus.org/v5/homoit0003245"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000238"},{"@id":"https://homosaurus.org/v5/homoit0000289"},{"@id":"https://homosaurus.org/v5/homoit0000366"},{"@id":"https://homosaurus.org/v5/homoit0000368"},{"@id":"https://homosaurus.org/v5/homoit0000369"},{"@id":"https://homosaurus.org/v5/homoit0000370"},{"@id":"https://homosaurus.org/v5/homoit0000373"},{"@id":"https://homosaurus.org/v5/homoit0000375"},{"@id":"https://homosaurus.org/v5/homoit0000816"},{"@id":"https://homosaurus.org/v5/homoit0001494"},{"@id":"https://homosaurus.org/v5/homoit0001808"},{"@id":"https://homosaurus.org/v5/homoit0001895"},{"@id":"https://homosaurus.org/v5/homoit0001906"},{"@id":"https://homosaurus.org/v5/homoit0003359"},{"@id":"https://homosaurus.org/v5/homoit0003360"}],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2020011587"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/drag"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000239","dc:identifier":"homoit0000239","skos:prefLabel":[{"@language":"en","@value":"Cunnilingus"},{"@language":"es","@value":"Cunnilingus"},{"@language":"de","@value":"Cunnilingus"},{"@language":"nl","@value":"Cunnilingus"},{"@language":"sv","@value":"Cunnilingus"}],"skos:altLabel":[{"@language":"en","@value":"Carpet munching"},{"@language":"en","@value":"Cunt licking"},{"@language":"en","@value":"Eating pussy"},{"@language":"en","@value":"Muff diving"},{"@language":"es","@value":"Comer crica"},{"@language":"es","@value":"Comer chocha"},{"@language":"de","@value":"Oralverkehr"},{"@language":"de","@value":"Lecken"}],"rdfs:comment":[{"@language":"en","@value":"A sexual act involving the use of the mouth and tongue to stimulate the clitoris, labia, and vagina."},{"@language":"es","@value":"Un acto sexual que implica el uso de la boca y la lengua para estimular el clítoris, los labios y la vagina."},{"@language":"de","@value":"Eine sexuelle Handlung, bei der Mund und Zunge zur Stimulation der Klitoris, der Vulvalippen und der Vagina eingesetzt werden."},{"@language":"nl","@value":"Een seksuele handeling waarbij de mond en tong worden gebruikt om de clitoris, schaamlippen en vagina te stimuleren."},{"@language":"sv","@value":"En sexuell handling som innebär stimulering av klitoris, blygdläppar och vagina med mun och tunga."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000280"},{"@id":"https://homosaurus.org/v5/homoit0000593"},{"@id":"https://homosaurus.org/v5/homoit0000969"},{"@id":"https://homosaurus.org/v5/homoit0001267"},{"@id":"https://homosaurus.org/v5/homoit0001299"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001487"},{"@id":"https://homosaurus.org/v5/homoit0001488"},{"@id":"https://homosaurus.org/v5/homoit0002578"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001267"},"dc:replaces":{"@id":"http://homosaurus.org/v2/cunnilingus"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000280","dc:identifier":"homoit0000280","skos:prefLabel":[{"@language":"en","@value":"Clitoral sex"},{"@language":"es","@value":"Sexo clitoriano"},{"@language":"de","@value":"Klitoraler Sex"},{"@language":"nl","@value":"Clitorale seks"},{"@language":"sv","@value":"Klitorissex"}],"skos:altLabel":[{"@language":"de","@value":"Klitoris-Sex"},{"@language":"de","@value":"Klitoraler Geschlechtsverkehr"}],"rdfs:comment":[{"@language":"en","@value":"Sexual acts involving the clitoris."},{"@language":"es","@value":"Actos sexuales que involucran el clítoris."},{"@language":"de","@value":"Sexuelle Handlungen, die die Klitoris mit einbeziehen."},{"@language":"nl","@value":"Seksuele handelingen waarbij de clitoris betrokken is"},{"@language":"sv","@value":"Sexuella handlingar som involverar klitoris."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001267"},{"@id":"https://homosaurus.org/v5/homoit0001299"}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000239"},{"@id":"https://homosaurus.org/v5/homoit0000459"},{"@id":"https://homosaurus.org/v5/homoit0003736"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000282"},{"@id":"https://homosaurus.org/v5/homoit0001487"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001267"},"dc:replaces":{"@id":"http://homosaurus.org/v2/clitoralSex"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001487","dc:identifier":"homoit0001487","skos:prefLabel":[{"@language":"en","@value":"Vaginal sex"},{"@language":"es","@value":"Sexo vaginal"},{"@language":"nl","@value":"Vaginale seks"},{"@language":"sv","@value":"Vaginalsex"}],"skos:altLabel":{"@language":"sv","@value":"Vaginalt sex"},"rdfs:comment":[{"@language":"en","@value":"Sexual acts involving the vagina."},{"@language":"es","@value":"Actos sexuales que involucran la vagina."},{"@language":"nl","@value":"Seksuele handelingen met de vagina."},{"@language":"sv","@value":"Sexuella handlingar som involverar vaginan."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001267"},{"@id":"https://homosaurus.org/v5/homoit0001299"}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000446"},{"@id":"https://homosaurus.org/v5/homoit0000459"},{"@id":"https://homosaurus.org/v5/homoit0001486"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000239"},{"@id":"https://homosaurus.org/v5/homoit0000280"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001267"},"dc:replaces":{"@id":"http://homosaurus.org/v2/vaginalSex"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001488","dc:identifier":"homoit0001488","skos:prefLabel":[{"@language":"en","@value":"Vagina"},{"@language":"es","@value":"Vagina"},{"@language":"nl","@value":"Vagina"},{"@language":"sv","@value":"Vaginor"}],"skos:altLabel":[{"@language":"en","@value":"Cunt"},{"@language":"en","@value":"Pussy"},{"@language":"en","@value":"Snatch"},{"@language":"en","@value":"Twat"},{"@language":"en","@value":"Vag"},{"@language":"en","@value":"Vaginas"},{"@language":"es","@value":"Pepe"},{"@language":"es","@value":"Coño"},{"@language":"es","@value":"Chocho"},{"@language":"es","@value":"Chocha"},{"@language":"es","@value":"Borrego"},{"@language":"es","@value":"Crica"},{"@language":"es","@value":"Panocha"},{"@language":"nl","@value":"Flamoes"},{"@language":"nl","@value":"Kut"},{"@language":"nl","@value":"Schede"},{"@language":"nl","@value":"Vagina's"},{"@language":"sv","@value":"Slidor"}],"rdfs:comment":[{"@language":"en","@value":"Internal muscular channel connected to external genital organs."},{"@language":"es","@value":"Canal muscular interno conectado a los órganos genitales externos."},{"@language":"nl","@value":"Intern spierkanaal verbonden met uitwendige geslachtsorganen."},{"@language":"sv","@value":"Inre muskelkanal som är förbunden med de yttre könsorganen."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000401"},{"@id":"https://homosaurus.org/v5/homoit0000585"}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000460"},{"@id":"https://homosaurus.org/v5/homoit0001040"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000239"},{"@id":"https://homosaurus.org/v5/homoit0001268"},{"@id":"https://homosaurus.org/v5/homoit0001489"},{"@id":"https://homosaurus.org/v5/homoit0001845"},{"@id":"https://homosaurus.org/v5/homoit0001848"},{"@id":"https://homosaurus.org/v5/homoit0001851"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85141754"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000401"},"dc:replaces":{"@id":"http://homosaurus.org/v2/vaginas"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000240","dc:identifier":"homoit0000240","skos:prefLabel":[{"@language":"en","@value":"Eunuchs"},{"@language":"es","@value":"Eunucos"},{"@language":"de","@value":"Eunuchen"},{"@language":"nl","@value":"Eunuchen"},{"@language":"sv","@value":"Eunucker"}],"skos:altLabel":[{"@language":"en","@value":"Castrati"},{"@language":"es","@value":"Castrati"},{"@language":"de","@value":"Kastraten"},{"@language":"sv","@value":"Kastrater"}],"rdfs:comment":[{"@language":"en","@value":"Individuals assigned male at birth who have been castrated. Historically, eunuchs served in royal courts as slaves or servants; in some cases, individuals were castrated before puberty to retain childlike vocal qualities."},{"@language":"es","@value":"Personas asignadas al sexo masculino al nacer que han sido castradas. Históricamente, los eunucos sirvieron en las cortes reales como esclavos o sirvientes; en algunos casos, las personas fueron castradas antes de la pubertad para conservar sus cualidades vocales infantiles."},{"@language":"de","@value":"Personen, die bei der Geburt als männlich zugewiesen wurden und kastriert wurden. Historisch gesehen dienten Eunuchen an Königshöfen als Sklaven oder Diener; in einigen Fällen wurden Personen vor der Pubertät kastriert, um ihre kindliche Stimmlage zu bewahren."},{"@language":"nl","@value":"Een individu toegewezen als man bij de geboorte die is gecastreerd. Historisch gezien dienden eunuchen in koninklijke hoven als slaven of bedienden; in sommige gevallen werden individuen vóór de puberteit gecastreerd om kinderlijke vocale kwaliteiten te behouden"},{"@language":"sv","@value":"Personer som tilldelats manligt kön vid födseln och som har kastrerats. Historiskt tjänstgjorde eunucker i kungliga hov som slavar eller tjänare. I vissa fall kastrerades individer före puberteten för att behålla barnlika röstegenskaper."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000322"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000241"},{"@id":"https://homosaurus.org/v5/homoit0000632"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85045580"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/eunuchs"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000241","dc:identifier":"homoit0000241","skos:prefLabel":[{"@language":"en","@value":"Castration"},{"@language":"es","@value":"Castración"},{"@language":"de","@value":"Kastration"},{"@language":"nl","@value":"Castratie"},{"@language":"sv","@value":"Kastrering"}],"skos:altLabel":{"@language":"de","@value":"Kastrierung"},"rdfs:comment":[{"@language":"en","@value":"Removal of the testes or use of the testes, typically through surgical or chemical means. Includes castration voluntarily undertaken as a gender-affirming surgical procedure or as part of a religious rite. For involuntary castration enacted by legal authorities or as a hate crime, use the term \"Forced castration.\""},{"@language":"es","@value":"Extirpación de los testículos o del uso de los testículos, generalmente mediante medios quirúrgicos o químicos. Incluye la castración realizada voluntariamente como procedimiento quirúrgico de afirmación de género o como parte de un rito religioso. Para la castración involuntaria promulgada por autoridades legales o como delito de odio, utilícese el término \"castración forzada\"."},{"@language":"de","@value":"Entfernung der Hoden oder der Möglichkeit, die Hoden zu verwenden. In der Regel durch chirurgische oder chemische Mittel. Dazu gehört auch die freiwillige Kastration als geschlechtsangleichender chirurgischer Eingriff oder als Teil eines religiösen Rituals. Für unfreiwillige Kastrationen, die von gesetzlichen Behörden oder als Hassverbrechen angeordnet werden, ist der Begriff „Zwangskastration“ zu verwenden."},{"@language":"nl","@value":"Verwijdering van de testikels of het voorkomen van het gebruik van testikels, meestal door middel van chirurgische of chemische middelen. Inclusief castratie die vrijwillig wordt uitgevoerd als een genderbevestigende chirurgische ingreep of als onderdeel van een religieuze rite. Gebruik Gedwongen castratie voor onvrijwillige castratie door gerechtelijke autoriteiten of als een haatmisdrijf."},{"@language":"sv","@value":"Avlägsnande av testiklarna eller påverkan på testiklarnas funktion, vanligtvis genom kirurgiska eller kemiska metoder. Inkluderar kastrering som genomförs frivilligt som ett könsbekräftande kirurgiskt ingrepp eller som del av en religiös ritual. För ofrivillig kastrering som utförs av myndigheter eller som hatbrott, använd termen ”Tvångskastrering”."}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000449"},{"@id":"https://homosaurus.org/v5/homoit0001060"},{"@id":"https://homosaurus.org/v5/homoit0001097"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000240"},{"@id":"https://homosaurus.org/v5/homoit0000302"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85020752"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000241"},"dc:replaces":{"@id":"http://homosaurus.org/v2/castration"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001060","dc:identifier":"homoit0001060","skos:prefLabel":[{"@language":"en","@value":"Orchiectomy"},{"@language":"es","@value":"Orquiectomía"},{"@language":"nl","@value":"Orchiëctomie"},{"@language":"sv","@value":"Orkidektomi"}],"skos:altLabel":{"@language":"sv","@value":"Orchiechtomi"},"rdfs:comment":[{"@language":"en","@value":"Medical procedure to remove one or more testes; often part of gender affirming surgery, though it can be performed for other reasons."},{"@language":"es","@value":"Procedimiento médico para extirpar uno o más testículos; a menudo forma parte de la cirugía de afirmación de género, aunque se puede realizar por otras razones."},{"@language":"nl","@value":"Medische procedure om een of meer testikels te verwijderen; vaak onderdeel van genderbevestigende chirurgie, hoewel het ook om andere redenen kan worden uitgevoerd."},{"@language":"sv","@value":"Medicinsk procedur där en eller båda testiklar avlägsnas. Utförs ofta som en del av könsbekräftande kirurgi men kan också ha andra medicinska orsaker."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000241"},{"@id":"https://homosaurus.org/v5/homoit0000584"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000241"},"dc:replaces":{"@id":"http://homosaurus.org/v2/orchiectomy"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001097","dc:identifier":"homoit0001097","skos:prefLabel":[{"@language":"en","@value":"Penectomy"},{"@language":"es","@value":"Penectomía"},{"@language":"nl","@value":"Penectomie"},{"@language":"sv","@value":"Penektomi"}],"rdfs:comment":[{"@language":"en","@value":"Surgical removal of the penis."},{"@language":"es","@value":"Extirpación quirúrgica del pene."},{"@language":"nl","@value":"Chirurgische verwijdering van de penis."},{"@language":"sv","@value":"Kirurgiskt avlägsnande av penis som en del av könsbekräftande vård."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000241"},{"@id":"https://homosaurus.org/v5/homoit0000584"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000241"},"dc:replaces":{"@id":"http://homosaurus.org/v2/penectomy"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000603","dc:identifier":"homoit0000603","skos:prefLabel":[{"@language":"en","@value":"Group sex"},{"@language":"es","@value":"Sexo en grupo"},{"@language":"de","@value":"Gruppensex"},{"@language":"nl","@value":"Groepsseks"},{"@language":"sv","@value":"Gruppsex"}],"skos:altLabel":[{"@language":"en","@value":"Orgies"},{"@language":"es","@value":"Orgías"},{"@language":"de","@value":"Orgien"},{"@language":"nl","@value":"Orgiën"}],"rdfs:comment":[{"@language":"en","@value":"Sexual activities involving multiple people, usually understood to be more than three people."},{"@language":"es","@value":"Actividades sexuales en las que participan múltiples personas, dándose a entender que usualmente son más de tres personas."},{"@language":"de","@value":"Sexuelle Aktivitäten, an denen mehrere Personen beteiligt sind, in der Regel mehr als drei Personen."},{"@language":"nl","@value":"Seksuele activiteiten waarbij meerdere mensen betrokken zijn, meestal meer dan drie mensen."},{"@language":"sv","@value":"Sexuella aktiviteter som involverar flera personer, vanligtvis fler än tre."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001299"},"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0003128"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000242"},{"@id":"https://homosaurus.org/v5/homoit0001123"},{"@id":"https://homosaurus.org/v5/homoit0001124"},{"@id":"https://homosaurus.org/v5/homoit0001272"},{"@id":"https://homosaurus.org/v5/homoit0001306"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85057499"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001299"},"dc:replaces":{"@id":"http://homosaurus.org/v2/groupSex"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000555","dc:identifier":"homoit0000555","skos:prefLabel":[{"@language":"en","@value":"White gay men"},{"@language":"es","@value":"Hombres gay blancos"},{"@language":"nl","@value":"Witte homomannen"},{"@language":"sv","@value":"Vita bögar"}],"skos:altLabel":[{"@language":"en","@value":"Caucasian gay men"},{"@language":"en","@value":"Gay Caucasian men"},{"@language":"en","@value":"Gay white men"},{"@language":"es","@value":"Hombres gay caucásicos"},{"@language":"es","@value":"Hombres caucásicos gay"},{"@language":"es","@value":"Hombres blancos gay"}],"rdfs:comment":[{"@language":"en","@value":"Gay men who are white."},{"@language":"es","@value":"Hombres gay que son blancos."},{"@language":"nl","@value":"Homomannen die wit zijn"},{"@language":"sv","@value":"Bögar som är vita."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000243"},"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2005020516"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000243"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayWhitePeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000797","dc:identifier":"homoit0000797","skos:prefLabel":[{"@language":"en","@value":"White lesbians"},{"@language":"es","@value":"Lesbianas blancas"},{"@language":"nl","@value":"Witte lesbische vrouwen"},{"@language":"sv","@value":"Vita lesbiska personer"}],"skos:altLabel":[{"@language":"en","@value":"Caucasian lesbians"},{"@language":"es","@value":"Lesbianas caucásicas"}],"rdfs:comment":[{"@language":"en","@value":"Lesbians who are white."},{"@language":"es","@value":"Lesbianas que son blancas."},{"@language":"sv","@value":"Lesbiska som är vita."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000243"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000243"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianWhitePeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001226","dc:identifier":"homoit0001226","skos:prefLabel":[{"@language":"en","@value":"White queer people"},{"@language":"es","@value":"Personas queer blancas"},{"@language":"nl","@value":"Witte queer personen"},{"@language":"sv","@value":"Vita queera personer"}],"skos:altLabel":[{"@language":"en","@value":"Caucasian queer people"},{"@language":"en","@value":"Queer Caucasian people"},{"@language":"en","@value":"Queer white people"},{"@language":"es","@value":"Personas caucásicas queer"},{"@language":"es","@value":"Personas queer caucásicas"},{"@language":"es","@value":"Personas blancas queer"},{"@language":"nl","@value":"Queer blanke personen"},{"@language":"nl","@value":"Queer witte personen"}],"rdfs:comment":[{"@language":"en","@value":"Queer people who are white."},{"@language":"es","@value":"Personas queer que son blancas."},{"@language":"sv","@value":"Queera personer som är vita."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000243"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000243"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerWhitePeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001461","dc:identifier":"homoit0001461","skos:prefLabel":[{"@language":"en","@value":"White transgender people"},{"@language":"es","@value":"Personas transgénero blancas"},{"@language":"nl","@value":"Witte transgender personen"},{"@language":"sv","@value":"Vita transpersoner"}],"skos:altLabel":[{"@language":"en","@value":"Caucasian transgender people"},{"@language":"en","@value":"Transgender Caucasian people"},{"@language":"en","@value":"Transgender white people"},{"@language":"es","@value":"Personas trasngénero caucásicas"},{"@language":"es","@value":"Personas caucásicas transgénero"},{"@language":"es","@value":"Personas blancas transgénero"},{"@language":"nl","@value":"Transgender blanke personen"},{"@language":"nl","@value":"Transgender witte personen"}],"rdfs:comment":[{"@language":"en","@value":"Transgender people who are white."},{"@language":"es","@value":"Personas transgénero que son blancas."},{"@language":"nl","@value":"Transgender personen die wit zijn"},{"@language":"sv","@value":"Transpersoner som är vita."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000243"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000243"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transgenderWhitePeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002746","dc:identifier":"homoit0002746","skos:prefLabel":[{"@language":"en","@value":"White intersex people"},{"@language":"es","@value":"Personas intersexuales blancas"},{"@language":"nl","@value":"Witte intersekse personen"},{"@language":"sv","@value":"Vita intersexpersoner"}],"skos:altLabel":[{"@language":"en","@value":"Intersex Caucasian people"},{"@language":"en","@value":"Intersex white people"},{"@language":"es","@value":"Personas caucásicas intersex"},{"@language":"es","@value":"Personas intersex blancas"}],"rdfs:comment":[{"@language":"en","@value":"Intersex people who are white."},{"@language":"es","@value":"Personas intersexuales que son blancas."},{"@language":"nl","@value":"Intersekse personen die wit zijn."},{"@language":"sv","@value":"Intersexpersoner som är vita."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000243"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000243"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-27"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002915","dc:identifier":"homoit0002915","skos:prefLabel":[{"@language":"en","@value":"White asexual people"},{"@language":"es","@value":"Personas asexuales blancas"},{"@language":"nl","@value":"Witte aseksuele personen"},{"@language":"sv","@value":"Vita asexuella personer"}],"skos:altLabel":[{"@language":"en","@value":"Asexual Caucasian people"},{"@language":"en","@value":"Asexual white people"},{"@language":"es","@value":"Personas caucásicas asexuales"},{"@language":"es","@value":"Personas blancas asexuales"}],"rdfs:comment":[{"@language":"en","@value":"Asexual people who are white."},{"@language":"es","@value":"Personas asexuales que son blancas."},{"@language":"nl","@value":"Aseksuele personen die wit zijn."},{"@language":"sv","@value":"Asexuella personer som är vita."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000243"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000243"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-29"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003381","dc:identifier":"homoit0003381","skos:prefLabel":[{"@language":"en","@value":"White non-binary people"},{"@language":"es","@value":"Personas no binarias blancas"},{"@language":"nl","@value":"Witte non-binaire personen"},{"@language":"sv","@value":"Vita ickebinära personer"}],"skos:altLabel":[{"@language":"en","@value":"Non-binary Caucasian people"},{"@language":"en","@value":"Non-binary Caucasians"},{"@language":"en","@value":"Non-binary white people"},{"@language":"en","@value":"Nonbinary Caucasian people"},{"@language":"en","@value":"Nonbinary Caucasians"},{"@language":"en","@value":"Nonbinary white people"},{"@language":"en","@value":"White nonbinary people"},{"@language":"es","@value":"Personas caucásicas no binarias"},{"@language":"es","@value":"Personas blancas no binarias"},{"@language":"nl","@value":"Non-binaire blanken"},{"@language":"nl","@value":"Non-binaire witte personen"},{"@language":"nl","@value":"Nonbinaire blanke personen"},{"@language":"nl","@value":"Nonbinaire blanken"},{"@language":"nl","@value":"Nonbinaire witte personen"},{"@language":"nl","@value":"Witte nonbinaire personen"}],"rdfs:comment":[{"@language":"en","@value":"Non-binary people who are white."},{"@language":"es","@value":"Personas no binarias que son blancas."},{"@language":"nl","@value":"Non-binaire personen die wit zijn."},{"@language":"sv","@value":"Ickebinära personer som är vita."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000243"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000243"},"dc:issued":{"@type":"xsd:date","@value":"2024-07-11"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000245","dc:identifier":"homoit0000245","skos:prefLabel":[{"@language":"en","@value":"Censorship"},{"@language":"es","@value":"Censura"},{"@language":"de","@value":"Zensur"},{"@language":"nl","@value":"Censuur"},{"@language":"sv","@value":"Censur"}],"rdfs:comment":[{"@language":"en","@value":"Suppression of speech, public communication, images, ideas, or other information by institutions, authorities, or other controlling bodies, typically because the material has been deemed objectionable, harmful, or sensitive. "},{"@language":"es","@value":"Supresión de expresiones, comunicaciones públicas, imágenes, ideas u otra información por parte de instituciones, autoridades u otros organismos de control, generalmente porque el material se ha considerado objetable, dañino o sensible."},{"@language":"de","@value":"Unterdrückung von Sprache, öffentlicher Kommunikation, Bildern, Ideen oder anderen Informationen durch Institutionen, Behörden oder andere Kontrollorgane, in der Regel, weil das Material als anstößig, schädlich oder sensibel erachtet wird."},{"@language":"nl","@value":"Onderdrukking van spreken, openbare communicatie, afbeeldingen, ideeën of andere informatie door instellingen, autoriteiten of andere controlerende instanties, meestal omdat het materiaal aanstootgevend, schadelijk of gevoelig is."},{"@language":"sv","@value":"Begränsning eller undertryckande av yttrandefrihet, offentlig kommunikation, bilder, idéer eller annan information av institutioner, myndigheter eller andra kontrollerande aktörer, vanligtvis för att innehållet bedömts som stötande, skadligt eller känsligt."}],"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0000829"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85021828"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000245"},"dc:replaces":{"@id":"http://homosaurus.org/v2/censorship"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000829","dc:identifier":"homoit0000829","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ censorship"},{"@language":"es","@value":"Censura LGBTQ+"},{"@language":"ja","@value":"LGBTQ+に対する検閲"},{"@language":"nl","@value":"LHBTQ+-censuur"},{"@language":"sv","@value":"Hbtq+-censur"}],"skos:altLabel":[{"@language":"en","@value":"LGBTQ censorship"},{"@language":"es","@value":"Censura LGBTQ"},{"@language":"ja","@value":"LGBTQに対する検閲"},{"@language":"sv","@value":"Censur (hbtq+)"}],"rdfs:comment":[{"@language":"en","@value":"Suppression or prohibition of the discussion, education, or circulation of information related to LGBTQ+ people and identities in media, schools, and/or in the general public. "},{"@language":"es","@value":"Supresión o prohibición de la discusión, la educación o la circulación de información relacionada con personas e identidades LGBTQ+ en los medios, escuelas y/o en el público en general."},{"@language":"ja","@value":"メディア、学校、一般社会において、LGBTQ+の人々やアイデンティティに関する議論、教育、または情報の流通を抑制または禁止すること。"},{"@language":"nl","@value":"Onderdrukking of verbod van discussie, voorlichting of verspreiding van informatie met betrekking tot LHBTQ+-personen en -identiteiten in media, scholen en/of bij het grote publiek."},{"@language":"sv","@value":"Censur eller förbud mot diskussion, utbildning eller spridning av information om hbtq+-personer och identiteter i medier, skolor och/eller offentligheten."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000245"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000815"},{"@id":"https://homosaurus.org/v5/homoit0000825"},{"@id":"https://homosaurus.org/v5/homoit0000867"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000245"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQCensorship"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000246","dc:identifier":"homoit0000246","skos:prefLabel":[{"@language":"kn","@value":"Chakka"},{"@language":"es","@value":"Chakka"},{"@language":"de","@value":"Chakka"},{"@language":"nl","@value":"Chakka"},{"@language":"sv","@value":"Chakka"}],"rdfs:comment":[{"@language":"en","@value":"Derogatory term for a third gender person in Karnataka culture in India."},{"@language":"es","@value":"Término despectivo para una persona de tercer género en la cultura de Karnataka en India."},{"@language":"de","@value":"Abwertende Bezeichnung für eine Person des dritten Geschlechts in der Kultur von Karnataka in Indien."},{"@language":"nl","@value":"Denigrerende term voor een derde geslacht in de Karnataka-cultuur in India"},{"@language":"sv","@value":"Nedsättande term för en person med tredje kön i Karnataka-kulturen i Indien."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000322"},{"@id":"https://homosaurus.org/v5/homoit0001560"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000632"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/chakka"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000377","dc:identifier":"homoit0000377","skos:prefLabel":[{"@language":"en","@value":"Driver's licenses"},{"@language":"es","@value":"Licencias de conducir"},{"@language":"de","@value":"Führerscheine"},{"@language":"nl","@value":"Rijbewijzen"},{"@language":"sv","@value":"Körkort"}],"skos:altLabel":[{"@language":"es","@value":"Carnet de conducir"},{"@language":"es","@value":"Licencia de manejar"},{"@language":"es","@value":"Carnet de manejo"},{"@language":"es","@value":"Licencia de manejo Carné de conducir"},{"@language":"es","@value":"Carné de manejar"},{"@language":"es","@value":"Carné de manejo||"}],"rdfs:comment":[{"@language":"en","@value":"Legal documents authorizing individuals to operate motor vehicles; commonly used as legal proof of identity; can be used in reference to LGBTQ+ people seeking driver's licenses or changes to existing licenses (e.g., name, gender or sex marker, photo)."},{"@language":"es","@value":"Documentos legales que autorizan a personas a operar vehículos de motor; comúnmente utilizado como prueba legal de identidad; se puede utilizar en referencia a personas LGBTQ+ que buscan licencias de conducir o cambios en las licencias existentes (por ejemplo, nombre, género o marcador de sexo, foto)."},{"@language":"de","@value":"Amtliche Dokumente, die Personen zum Führen eines Kraftfahrzeugs berechtigen und häufig als gesetzlicher Identitätsnachweis verwendet werden. Kann in Bezug auf LGBTQ+ Personen verwendet werden, die einen Führerschein beantragen oder eine Änderung an einem bestehenden Führerschein vornehmen möchten (z. B. Namen, Geschlechtsangabe, Foto)."},{"@language":"nl","@value":"Juridische documenten die personen machtigen om motorvoertuigen te besturen; algemeen gebruikt als wettelijk identiteitsbewijs; kan worden gebruikt met betrekking tot LHBTQ+-ers die rijbewijzen willen halen of wijzigingen in bestaande rijbewijzen (bijv. naam, gender of geslachtsmarkering, foto) willen aanbrengen."},{"@language":"sv","@value":"Juridiska dokument som ger en person tillstånd att framföra motordrivna fordon. Används ofta som identitetshandling. Kan även avse hbtq+-personers tillgång till körkort eller ändringar i körkort (t.ex. namn, könsmarkör eller foto)."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001053"},"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0000573"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000247"},{"@id":"https://homosaurus.org/v5/homoit0000311"},{"@id":"https://homosaurus.org/v5/homoit0001005"},{"@id":"https://homosaurus.org/v5/homoit0001324"},{"@id":"https://homosaurus.org/v5/homoit0001465"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85010130"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000712"},"dc:replaces":{"@id":"http://homosaurus.org/v2/driversLicenses"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001092","dc:identifier":"homoit0001092","skos:prefLabel":[{"@language":"en","@value":"Passports"},{"@language":"es","@value":"Pasaportes"},{"@language":"fr","@value":"Passeport"},{"@language":"nl","@value":"Paspoorten"},{"@language":"sv","@value":"Pass"}],"rdfs:comment":[{"@language":"en","@value":"Official documentation issued by a government that certifies the holder’s identity and citizenship, entitling them to travel under to and from other countries."},{"@language":"es","@value":"Documentación oficial emitida por un gobierno que certifica la identidad y ciudadanía de la persona titular, dándole derecho a viajar hacia y desde otros países."},{"@language":"fr","@value":"Document officiel délivré par un gouvernement attestant l'identité et la citoyenneté du titulaire, et lui permettant de voyager vers et depuis d'autres pays."},{"@language":"nl","@value":"Officiële documentatie uitgegeven door een overheid die de identiteit en het staatsburgerschap van de houder certificeert, waardoor deze persoon het recht heeft om van en naar andere landen te reizen."},{"@language":"sv","@value":"Officiellt dokument utfärdat av staten som bekräftar innehavarens identitet och medborgarskap och ger rätt att resa mellan länder."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001053"},"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0000573"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000247"},{"@id":"https://homosaurus.org/v5/homoit0000883"},{"@id":"https://homosaurus.org/v5/homoit0001465"},{"@id":"https://homosaurus.org/v5/homoit0001815"},{"@id":"https://homosaurus.org/v5/homoit0001853"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85098541"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000712"},"dc:replaces":{"@id":"http://homosaurus.org/v2/passports"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003503","dc:identifier":"homoit0003503","skos:prefLabel":[{"@language":"en","@value":"Gender marker change bans"},{"@language":"de","@value":"Änderungsverbote des Geschlechtseintrags"},{"@language":"es","@value":"Prohibiciones de cambio de marcas de género"},{"@language":"nl","@value":"Verboden om gender-aanduidingen te veranderen"},{"@language":"sv","@value":"Förbud mot ändring av juridiskt kön"}],"skos:altLabel":[{"@language":"en","@value":"Legal documents change ban"},{"@language":"de","@value":"Verbote zur Änderung des Geschlechtseintrags"},{"@language":"es","@value":"Prohibiciones de cambio en documentos legales"}],"rdfs:comment":[{"@language":"en","@value":"Laws or policies instituted to prevent trans and non-binary people from changing the gender marker on their birth certificate, driver's license, passport, or other legal documents."},{"@language":"de","@value":"Gesetze oder Regelungen, die eingeführt wurden, um trans und nichtbinäre Personen daran zu hindern, den Geschlechtseintrag auf ihrer Geburtsurkunde, ihrem Führerschein, ihrem Pass oder anderen rechtlichen Dokumenten zu ändern."},{"@language":"es","@value":"Leyes o políticas instituidas para impedir que las personas trans y no binarias cambien la marca de género de su certificado de nacimiento, licencia de conducir, pasaporte u otros documentos legales."},{"@language":"nl","@value":"Wetten of beleidsmaatregelen die zijn ingesteld om te voorkomen dat transgender- en non-binaire personen hun gender-aanduiding op hun geboorteakte, rijbewijs, paspoort of andere wettelijke documenten wijzigen."},{"@language":"sv","@value":"Lagstiftning eller policyer som hindrar transpersoner och ickebinära personer från att ändra könsmarkören i födelseattester, körkort, pass eller andra juridiska dokument."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0003499"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000247"},{"@id":"https://homosaurus.org/v5/homoit0000573"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000702"},"dc:issued":{"@type":"xsd:date","@value":"2024-07-31"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000248","dc:identifier":"homoit0000248","skos:prefLabel":[{"@language":"en","@value":"Changing rooms"},{"@language":"de","@value":"Umkleidekabinen"},{"@language":"es","@value":"Salas de probadores"},{"@language":"nl","@value":"Kleedkamers"},{"@language":"sv","@value":"Omklädningsrum"}],"skos:altLabel":[{"@language":"de","@value":"Umkleiden"},{"@language":"de","@value":"Umkleideräume"},{"@language":"de","@value":"Umkleidezimmer"},{"@language":"es","@value":"Salas de cambio"},{"@language":"es","@value":"Salas de vestuarios"},{"@language":"es","@value":"Camerinos"},{"@language":"es","@value":"Salas de camerinos"}],"rdfs:comment":[{"@language":"en","@value":"Rooms or areas in public or commercial spaces where people can change their clothes with varying degrees of privacy.  "},{"@language":"de","@value":"Kabinen oder Bereiche in öffentlichen oder gewerblichen Räumen, in denen sich die Menschen mit unterschiedlichem Grad an Privatsphäre umziehen können."},{"@language":"es","@value":"Cuartos o áreas en espacios públicos o comerciales donde las personas pueden cambiarse de ropa con distintos grados de privacidad."},{"@language":"nl","@value":"Kamers of plekken in openbare of commerciële ruimtes waar mensen zich kunnen omkleden met verschillende mate van privacy."},{"@language":"sv","@value":"Rum eller områden i offentliga eller kommersiella miljöer där personer kan byta om, med varierande grad av integritet."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001141"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001139"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001141"},"dc:replaces":{"@id":"http://homosaurus.org/v2/changingRooms"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000481","dc:identifier":"homoit0000481","skos:prefLabel":[{"@language":"en","@value":"Gay characters"},{"@language":"es","@value":"Personajes gay"},{"@language":"de","@value":"Schwule Charaktere"},{"@language":"nl","@value":"Homopersonages"},{"@language":"sv","@value":"Bögkaraktärer"}],"skos:altLabel":{"@language":"sv","@value":"Homosexuella manliga karaktärer"},"rdfs:comment":[{"@language":"en","@value":"Characters in creative works who are gay men."},{"@language":"es","@value":"Personajes de obras creativas que son hombres gay."},{"@language":"de","@value":"Charaktere in künstlerischen Werken, die schwul sind."},{"@language":"nl","@value":"Personages in creatieve werken die homo zijn."},{"@language":"sv","@value":"Karaktärer i kreativa verk som är bögar."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000249"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000479"},{"@id":"https://homosaurus.org/v5/homoit0000506"},{"@id":"https://homosaurus.org/v5/homoit0000544"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000249"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayCharacters"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000729","dc:identifier":"homoit0000729","skos:prefLabel":[{"@language":"en","@value":"Lesbian characters"},{"@language":"es","@value":"Personajes lesbianas"},{"@language":"nl","@value":"Lesbische personages"},{"@language":"sv","@value":"Lesbiska karaktärer"}],"rdfs:comment":[{"@language":"en","@value":"Characters in creative works who are lesbians."},{"@language":"es","@value":"Personajes de obras creativas que son lesbianas."},{"@language":"nl","@value":"Personages in creatieve werken die lesbisch zijn."},{"@language":"sv","@value":"Karaktärer i kreativa verk som är lesbiska."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000249"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000556"},{"@id":"https://homosaurus.org/v5/homoit0000786"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000249"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianCharacters"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001166","dc:identifier":"homoit0001166","skos:prefLabel":[{"@language":"en","@value":"Queer characters"},{"@language":"es","@value":"Personajes queer"},{"@language":"nl","@value":"Queer personages"},{"@language":"sv","@value":"Queera karaktärer"}],"rdfs:comment":[{"@language":"en","@value":"Characters in creative works who are queer."},{"@language":"es","@value":"Personajes de obras creativas que son queer."},{"@language":"nl","@value":"Personages in creatieve werken die queer zijn."},{"@language":"sv","@value":"Karaktärer i kreativa verk som är queera."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000249"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001167"},{"@id":"https://homosaurus.org/v5/homoit0001195"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000249"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerCharacters"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001399","dc:identifier":"homoit0001399","skos:prefLabel":[{"@language":"en","@value":"Transgender characters"},{"@language":"es","@value":"Personajes transgénero"},{"@language":"nl","@value":"Transgender personages"},{"@language":"sv","@value":"Transkaraktärer"}],"rdfs:comment":[{"@language":"en","@value":"Characters in creative works who are transgender."},{"@language":"es","@value":"Personajes de obras creativas que son transgénero."},{"@language":"nl","@value":"Personages in creatieve werken die transgender zijn."},{"@language":"sv","@value":"Karaktärer i kreativa verk som är transpersoner."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000249"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001378"},{"@id":"https://homosaurus.org/v5/homoit0001400"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000249"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transgenderCharacters"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002770","dc:identifier":"homoit0002770","skos:prefLabel":[{"@language":"en","@value":"Asexual characters"},{"@language":"es","@value":"Personajes asexuales"},{"@language":"de","@value":"Asexuelle Charaktere"},{"@language":"nl","@value":"Aseksuele personages"},{"@language":"sv","@value":"Asexuella karaktärer"}],"skos:altLabel":[{"@language":"de","@value":"Ace Charaktere"},{"@language":"sv","@value":"Ace-karaktärer"}],"rdfs:comment":[{"@language":"en","@value":"Characters in creative works who are asexual."},{"@language":"es","@value":"Personajes asexuales en obras creativas."},{"@language":"de","@value":"Charaktere in künstlerischen Werken, die asexuell sind."},{"@language":"nl","@value":"Personages in creatieve werken die aseksueel zijn."},{"@language":"sv","@value":"Karaktärer i kreativa verk som är asexuella."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000249"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000249"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-27"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002967","dc:identifier":"homoit0002967","skos:prefLabel":[{"@language":"en","@value":"Intersex characters"},{"@language":"es","@value":"Personajes intersexuales"},{"@language":"nl","@value":"Intersekse personages"},{"@language":"sv","@value":"Intersexkaraktärer"}],"skos:altLabel":{"@language":"es","@value":"Personajes intersex"},"rdfs:comment":[{"@language":"en","@value":"Characters in creative works who are intersex."},{"@language":"es","@value":"Personajes de obras creativas que son intersex."},{"@language":"nl","@value":"Personages in creatieve werken die intersekse zijn."},{"@language":"sv","@value":"Karaktärer i kreativa verk som är intersexpersoner."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000249"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000249"},"dc:issued":{"@type":"xsd:date","@value":"2023-09-29"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003660","dc:identifier":"homoit0003660","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ superheroes"},{"@language":"nl","@value":"LHBTQ+-superhelden"},{"@language":"sv","@value":"Superhjältar (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"Superheroes (LGBTQ)"},{"@language":"en","@value":"LGBTQ+ super heroes"},{"@language":"en","@value":"LGBTQ+ comic book heroes"},{"@language":"en","@value":"Super heroes (LGBTQ)"},{"@language":"nl","@value":"Superhelden (LHBTQ+)"}],"rdfs:comment":[{"@language":"en","@value":"Benevolent fictional characters who possess superhuman powers or abilities beyond those of ordinary people which they use to fight evil and help the public. Use to refer to superheroes who are explicitly identified as LGBTQ+ within their source material."},{"@language":"nl","@value":"Welwillende fictieve personages die over bovenmenselijke krachten of vaardigheden beschikken die verder gaan dan die van gewone mensen, die ze gebruiken om het kwaad te bestrijden en het publiek te helpen. Wordt gebruikt om te verwijzen naar superhelden die expliciet worden geïdentificeerd als LHBTQ+ in hun bronmateriaal."},{"@language":"sv","@value":"Fiktiva karaktärer med övernaturliga krafter eller förmågor som används för att bekämpa ondska och hjälpa allmänheten. Används för superhjältar som är uttryckligen identifierade som hbtq+ i originalmaterialet."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000249"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000841"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000249"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-22"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003661","dc:identifier":"homoit0003661","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ supervillains"},{"@language":"nl","@value":"LHBTQ+-superschurken"},{"@language":"sv","@value":"Superskurkar (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"Supervillains (LGBTQ)"},{"@language":"en","@value":"LGBTQ+ super villains"},{"@language":"en","@value":"Super villains (LGBTQ)"},{"@language":"en","@value":"LGBTQ+ comic book villains"},{"@language":"nl","@value":"Superschurken (LHBTQ+)"}],"rdfs:comment":[{"@language":"en","@value":"Villainous fictional characters who possess superhuman powers or abilities beyond those of ordinary people which they use to do evil and harm the public. Use to refer to supervillains who are explicitly identified as LGBTQ+ within their source material."},{"@language":"nl","@value":"Schurkachtige fictieve personages die over bovenmenselijke krachten of vaardigheden beschikken die verder gaan dan die van gewone mensen, die ze gebruiken om kwaad te doen en het publiek te schaden. Wordt gebruikt om te verwijzen naar superschurken die expliciet worden geïdentificeerd als LHBTQ+ in hun bronmateriaal."},{"@language":"sv","@value":"Fiktiva skurkar med övernaturliga krafter eller förmågor som används för att skada allmänheten eller begå ondska. Används för superskurkar som är uttryckligen identifierade som hbtq+ i originalmaterialet."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000249"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000841"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000249"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-22"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002687","dc:identifier":"homoit0002687","skos:prefLabel":[{"@language":"en","@value":"Two-Spirit characters"},{"@language":"es","@value":"Personajes dos espíritus"},{"@language":"nl","@value":"Two-Spirit personages"},{"@language":"sv","@value":"Two-spirit-karaktärer"}],"skos:altLabel":[{"@language":"en","@value":"2S characters"},{"@language":"en","@value":"Two Spirit characters"},{"@language":"en","@value":"Two Spirited characters"},{"@language":"en","@value":"Two-Spirited characters"}],"rdfs:comment":[{"@language":"en","@value":"Characters in creative works who are Two-Spirit"},{"@language":"es","@value":"Personajes de obras creativas que son dos espíritus."},{"@language":"nl","@value":"Personages in creatieve werken die Two-Spirit zijn."},{"@language":"sv","@value":"Karaktärer i kreativa verk som är Two-spirit-personer."}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000249"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0002687"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-26"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003160","dc:identifier":"homoit0003160","skos:prefLabel":[{"@language":"en","@value":"Drag in film"},{"@language":"es","@value":"Drag en filmes"},{"@language":"de","@value":"Drag im Film"},{"@language":"nl","@value":"Drag in film"},{"@language":"sv","@value":"Drag i film"}],"skos:altLabel":[{"@language":"en","@value":"Drag in cinema"},{"@language":"en","@value":"Drag in movies"},{"@language":"es","@value":"Drag en el cine"},{"@language":"es","@value":"Drag en películas"}],"rdfs:comment":[{"@language":"en","@value":"Films with significant characters who appear in drag. Not to be confused with films where a principal actor plays a character who identifies as a gender other than what the actor identifies as."},{"@language":"es","@value":"Películas con personajes significativos que aparecen en drag. No debe confundirse con películas en las que un actor principal interpreta a un personaje que se identifica con un género distinto al género con el cual se identifica el actor."},{"@language":"de","@value":"Filmen, in denen bedeutende Figuren in Drag auftreten. Nicht zu verwechseln mit Filmen, in denen Schauspieler:innen eine Figur spielen, die sich einem Geschlecht anders als dem Geschlecht der Schauspieler:innen zugehörig fühlt."},{"@language":"nl","@value":"Films met belangrijke personages die in drag verschijnen. Niet te verwarren met films waarin een hoofdrolspeler een personage speelt die zich identificeert met een gender anders dan waarmee de acteur zich identificeert."},{"@language":"sv","@value":"Filmer med betydelsefulla karaktärer i drag. Ska inte förväxlas med filmer där en huvudrollsinnehavare spelar en karaktär som identifierar sig med ett annat kön än skådespelaren själv."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000367"},{"@id":"https://homosaurus.org/v5/homoit0002327"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000249"},{"@id":"https://homosaurus.org/v5/homoit0000318"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2024-01-09"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000252","dc:identifier":"homoit0000252","skos:prefLabel":[{"@language":"en","@value":"Chest harnesses"},{"@language":"de","@value":"Brust-Harness"},{"@language":"es","@value":"Arneses de pecho"},{"@language":"nl","@value":"Borstgordels"},{"@language":"sv","@value":"Bröstharness"}],"skos:altLabel":[{"@language":"de","@value":"Brustgurt"},{"@language":"de","@value":"Brustgeschirre"}],"rdfs:comment":[{"@language":"en","@value":"Wearable accessories, typically consisting of leather straps and metal rings or points of attachment, that fit around the chest and shoulders like a vest. May be worn as a fashion statement, to signal one's belonging to the leather or BDSM communities, or to restrict the wearer's movement during sex."},{"@language":"de","@value":"Tragbare Accessoires, die in der Regel aus Lederriemen und Metallringen oder Befestigungselementen bestehen und wie eine Weste um Brust und Schultern gelegt werden. Sie können als modisches Statement getragen werden, um die Zugehörigkeit zur Leder- oder BDSM-Gemeinschaft zu signalisieren, oder um die Bewegungsfreiheit der tragenden Person beim Sex einzuschränken."},{"@language":"es","@value":"Accesorios que se pueden llevar, normalmente compuestos por correas de cuero y anillas o puntos de sujeción metálicos, que se ajustan alrededor del pecho y los hombros como un chaleco. Pueden llevarse como una declaración de moda, para señalar la pertenencia a las comunidades del cuero o BDSM, o para restringir el movimiento del usuario durante las relaciones sexuales."},{"@language":"nl","@value":"Draagbare accessoires, meestal bestaande uit leren banden en metalen ringen of bevestigingspunten, die als een vest om de borst en schouders passen. Kunnen worden gedragen als een mode-statement, om te laten zien dat men tot de leer- of BDSM-gemeenschap behoort, of om de bewegingsvrijheid van de drager tijdens seks te beperken."},{"@language":"sv","@value":"Bärbara tillbehör, vanligtvis bestående av läderremmar och metallringar eller fästpunkter, som sitter runt bröstkorgen och axlarna som en väst. Kan bäras som en modeaccessoar, för att signalera tillhörighet till läder- eller BDSM-gemenskaper, eller för att begränsa bärarens rörelse under sex."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000612"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001266"},"dc:replaces":{"@id":"http://homosaurus.org/v2/chestHarnesses"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000612","dc:identifier":"homoit0000612","skos:prefLabel":[{"@language":"en","@value":"Harnesses"},{"@language":"de","@value":"Harness"},{"@language":"es","@value":"Arneses"},{"@language":"nl","@value":"Gordels"},{"@language":"sv","@value":"Harness"}],"rdfs:comment":[{"@language":"en","@value":"Wearable accessories, typically consisting of leather straps and metal rings or points of attachment. May be worn as a fashion statement, to signal one's belonging to the leather or BDSM communities, or during sex to restrict movement, increase pleasure, and/or to permit the attachment of a sex accessory, such as a dildo."},{"@language":"de","@value":"Tragbare Accessoires, die in der Regel aus Lederriemen und Metallringen oder Halterungen bestehen. Sie können als modisches Statement getragen werden, um die Zugehörigkeit zur Leder- oder BDSM-Community zu signalisieren, oder beim Sex, um die Bewegungsfreiheit einzuschränken, das Lustempfinden zu steigern und/oder die Befestigung eines Sex-Accessoires, wie beispielsweise eines Dildos, zu ermöglichen."},{"@language":"es","@value":"Accesorios que se pueden llevar puestos y que suelen consistir en correas de cuero y anillas o puntos de sujeción metálicos. Pueden llevarse como adorno de moda, para indicar la pertenencia a las comunidades de cuero o BDSM, o durante las relaciones sexuales para restringir el movimiento, aumentar el placer y/o permitir la fijación de un accesorio sexual, como un consolador."},{"@language":"nl","@value":"Draagbare accessoires, meestal bestaande uit leren banden en metalen ringen of bevestigingspunten. Kunnen worden gedragen als een mode-statement, om aan te geven dat men tot de leer- of BDSM-gemeenschap behoort, of tijdens seks om beweging te beperken, het genot te vergroten en/of om de bevestiging van een seksaccessoire, zoals een dildo, toe te staan."},{"@language":"sv","@value":"Selar använda inom BDSM som sex- eller mode-accessoar."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001266"},{"@id":"https://homosaurus.org/v5/homoit0003059"}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000252"},{"@id":"https://homosaurus.org/v5/homoit0000354"},{"@id":"https://homosaurus.org/v5/homoit0001367"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001266"},"dc:replaces":{"@id":"http://homosaurus.org/v2/harnesses"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000860","dc:identifier":"homoit0000860","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ people of shared ethnic or national identities"},{"@language":"es","@value":"Personas LGBTQ+ en grupos étnicos"},{"@language":"nl","@value":"LHBTQ+-personen met een gedeelde etnische of nationale identiteit"},{"@language":"sv","@value":"Etniska grupper (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"LGBTQ+ people in ethnic groups"},{"@language":"en","@value":"LGBTQ+ people by ethnicity"},{"@language":"en","@value":"LGBTQ+ people by nationality"},{"@language":"en","@value":"LGBTQ+ ethnic people"},{"@language":"en","@value":"Ethnic LGBTQ+ people"},{"@language":"en","@value":"Ethnic people (LGBTQ)"},{"@language":"nl","@value":"Etnische personen (LHBTQ+)"},{"@language":"nl","@value":"LHBTQ+-etnische personen"},{"@language":"nl","@value":"LHBTQ+-personen in etnische groepen"},{"@language":"nl","@value":"LHBTQ+-personen per etniciteit"},{"@language":"nl","@value":"LHBTQ+-personen per nationaliteit"}],"rdfs:comment":[{"@language":"en","@value":"Umbrella term for groups of LGBTQ+ people who share an ethnic or national identity, including a common nationality, country of citizenship, ancestry, culture, language, ethno-religion, etc. Use more specific terms whenever possible. Do not use to describe migrants or immigrants as a whole."},{"@language":"es","@value":"Grupos de personas que comparten una identidad basada en una nacionalidad, cultura, ascendencia, idioma, religión, etc. en común y que también se autoidentifican como LGBTQ+. No debe utilizarse para describir a personas migrantes."},{"@language":"nl","@value":"Overkoepelende term voor groepen LHBTQ+-personen die een etnische of nationale identiteit delen, waaronder een gemeenschappelijke nationaliteit, land van burgerschap, afkomst, cultuur, taal, etnoreligie, enz. Gebruik waar mogelijk specifiekere termen. Gebruik deze term niet om migranten of immigranten als geheel te beschrijven."},{"@language":"sv","@value":"Grupper av personer som delar en gemensam nationell, kulturell, etnisk, språklig eller religiös identitet och som också identifierar sig som hbtq+. Använd inte för att beskriva migranter."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000915"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000682"},{"@id":"https://homosaurus.org/v5/homoit0000875"},{"@id":"https://homosaurus.org/v5/homoit0001812"},{"@id":"https://homosaurus.org/v5/homoit0002007"},{"@id":"https://homosaurus.org/v5/homoit0002009"},{"@id":"https://homosaurus.org/v5/homoit0002044"},{"@id":"https://homosaurus.org/v5/homoit0002060"},{"@id":"https://homosaurus.org/v5/homoit0002070"},{"@id":"https://homosaurus.org/v5/homoit0002078"},{"@id":"https://homosaurus.org/v5/homoit0002086"},{"@id":"https://homosaurus.org/v5/homoit0002094"},{"@id":"https://homosaurus.org/v5/homoit0002102"},{"@id":"https://homosaurus.org/v5/homoit0002110"},{"@id":"https://homosaurus.org/v5/homoit0002118"},{"@id":"https://homosaurus.org/v5/homoit0002126"},{"@id":"https://homosaurus.org/v5/homoit0002134"},{"@id":"https://homosaurus.org/v5/homoit0002231"},{"@id":"https://homosaurus.org/v5/homoit0002239"},{"@id":"https://homosaurus.org/v5/homoit0002247"},{"@id":"https://homosaurus.org/v5/homoit0002295"},{"@id":"https://homosaurus.org/v5/homoit0002303"},{"@id":"https://homosaurus.org/v5/homoit0002311"},{"@id":"https://homosaurus.org/v5/homoit0002319"},{"@id":"https://homosaurus.org/v5/homoit0002526"},{"@id":"https://homosaurus.org/v5/homoit0003306"},{"@id":"https://homosaurus.org/v5/homoit0003319"},{"@id":"https://homosaurus.org/v5/homoit0003334"},{"@id":"https://homosaurus.org/v5/homoit0002022"},{"@id":"https://homosaurus.org/v5/homoit0000886"},{"@id":"https://homosaurus.org/v5/homoit0000253"},{"@id":"https://homosaurus.org/v5/homoit0004162"},{"@id":"https://homosaurus.org/v5/homoit0004349"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000667"},{"@id":"https://homosaurus.org/v5/homoit0000902"},{"@id":"https://homosaurus.org/v5/homoit0001133"},{"@id":"https://homosaurus.org/v5/homoit0001482"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQEthnicGroups"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000498","dc:identifier":"homoit0000498","skos:prefLabel":[{"@language":"en","@value":"Latino/a/x gay men"},{"@language":"de","@value":"Schwule Latino/-a/-x-Personen"},{"@language":"es","@value":"Hombres gay Latinxs"},{"@language":"nl","@value":"Latino/a/x homomannen"},{"@language":"sv","@value":"Bögar som är latines"}],"skos:altLabel":[{"@language":"en","@value":"Gay Latine"},{"@language":"en","@value":"Gay Latinos"},{"@language":"en","@value":"Gay Latinx"},{"@language":"en","@value":"Latine gay men"},{"@language":"en","@value":"Latino gay men"},{"@language":"en","@value":"Latinx gay men"},{"@language":"de","@value":"Schwule Latinos"},{"@language":"de","@value":"Schwule Latinas"},{"@language":"de","@value":"Schwule Latinx"},{"@language":"es","@value":"Latinos gay"},{"@language":"es","@value":"Hombres gay Latinos"},{"@language":"es","@value":"Gays Latinos"},{"@language":"es","@value":"Gays Latinx"},{"@language":"nl","@value":"Homo-Latinx"},{"@language":"nl","@value":"Latino homomannen"},{"@language":"nl","@value":"Latinx homomannen"},{"@language":"sv","@value":"Latino/a/x bögar"},{"@language":"sv","@value":"Homosexuella män som är latines"}],"rdfs:comment":[{"@language":"en","@value":"Latin American men who are gay; only use to describe individuals who self-identify as Latino, Latina, or Latinx. Do not conflate with Chicano/a/x or Hispanic."},{"@language":"de","@value":"Schwule Männer lateinamerikanischer Herkunft; dieser Begriff bezieht sich ausschließlich auf Personen, die sich selbst als Latino, Latina oder Latinx bezeichnen. Nicht mit Chicano/a/x oder Hispanic zu verwechseln."},{"@language":"es","@value":"Hombres latinoamericanos que son gay; utilícese únicamente para describir a personas que se autoidentifican como latinos, latinas o latinxs. No debe confundirse con chicano/a/x o hispano/a/x."},{"@language":"nl","@value":"Latijns-Amerikaanse homomannen; alleen gebruiken om personen te beschrijven die zichzelf identificeren als Latino, Latina of Latinx. Niet verwarren met Chicano/a/x of Hispanic"},{"@language":"sv","@value":"Bögar som är latinamerikaner och som själva identifierar sig som latines (latino, latina eller latinx). Blanda inte ihop med chicano/a/x eller hispanic."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000253"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayLatinos"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000747","dc:identifier":"homoit0000747","skos:prefLabel":[{"@language":"en","@value":"