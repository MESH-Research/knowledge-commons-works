rkitekter"}],"rdfs:comment":[{"@language":"en","@value":"Queer people who professionally design buildings and are qualified to plan and supervise their construction."},{"@language":"nl","@value":"Queer personen die professioneel gebouwen ontwerpen en gekwalificeerd zijn om de bouw ervan te plannen en te begeleiden."},{"@language":"sv","@value":"Queera personer som har som yrke att designa byggnader och är kvalificerade att planera och övervaka deras byggnation."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0004487"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2026-03-03"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004507","dc:identifier":"homoit0004507","skos:prefLabel":[{"@language":"en","@value":"Tachi (Yaoi)"},{"@language":"ja","@value":"Tachi (Yaoi)"}],"rdfs:comment":[{"@language":"en","@value":"Term used in yaoi and yaoi fan communities to describe the leading or active partner in a fictional male-male relationship."},{"@language":"ja","@value":"ヤオイおよびヤオイファンの間で、男性同士の関係において、主動的または能動的な立場にあるパートナーを指す用語。"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0004507"},"dc:issued":{"@type":"xsd:date","@value":"2026-03-22"},"dc:modified":{"@type":"xsd:date","@value":"2026-03-22"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004508","dc:identifier":"homoit0004508","skos:prefLabel":[{"@language":"ja","@value":"onee"},{"@language":"ja","@value":"オネエ"}],"rdfs:comment":[{"@language":"en","@value":"A man who speaks and acts like a woman, or a man who dresses as a woman. The word originates from \"oneesan,\" meaning older sister."},{"@language":"ja","@value":"女性のような言葉遣い、仕草をする男性、あるいは女装をする男性。姉を意味する「お姉さん」が語源である。"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0004508"},"dc:issued":{"@type":"xsd:date","@value":"2026-04-24"},"dc:modified":{"@type":"xsd:date","@value":"2026-04-24"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004519","dc:identifier":"homoit0004519","skos:prefLabel":{"@language":"en","@value":"LGBTQ+ internally displaced people"},"rdfs:comment":{"@language":"en","@value":"LGBTQ+ people who have been forced to flee their home or region due to war or armed conflict, persecution, violence, or natural disasters but remain within the borders of their country."},"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0004520"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0004520"},"dc:issued":{"@type":"xsd:date","@value":"2026-05-18"},"dc:modified":{"@type":"xsd:date","@value":"2026-05-18"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004614","dc:identifier":"homoit0004614","skos:prefLabel":{"@language":"en","@value":"LGBTQ+ themes in mythology"},"skos:altLabel":[{"@language":"en","@value":"LGBTQ themes in mythology"},{"@language":"en","@value":"Themes in mythology (LGBTQ+)"}],"rdfs:comment":{"@language":"en","@value":"Themes found in myths and folklore which include stories of romance and/or sex between individuals of the same gender, romance and/or sex between gender diverse individuals, and stories about gender identity including changes in an individual's gender. Use for applications of gender studies and queer theory looking at these stories through the lens of LGBTQ+ expression."},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0004634"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0004614"},"dc:issued":{"@type":"xsd:date","@value":"2026-06-08"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-10"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004634","dc:identifier":"homoit0004634","skos:prefLabel":{"@language":"en","@value":"Gender diverse deities"},"rdfs:comment":{"@language":"en","@value":"Deities whose behavior, mannerisms, and/or appearance does not match masculine or feminine gender norms."},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0004614"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0004634"},"dc:issued":{"@type":"xsd:date","@value":"2026-06-09"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-09"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004628","dc:identifier":"homoit0004628","skos:prefLabel":{"@language":"en","@value":"Non-binary personals"},"skos:altLabel":[{"@language":"en","@value":"Nonbinary personals"},{"@language":"en","@value":"Non-binary personal ads"},{"@language":"en","@value":"Nonbinary personal ads"},{"@language":"en","@value":"Nonbinary personal advertisements"},{"@language":"en","@value":"Non-binary personal advertisements"}],"rdfs:comment":{"@language":"en","@value":"A form of classified advertising for non-binary people interested in seeking connections around sex, romance, and/or community. The content of these ads focus largely on the type of arrangement sought and details or criteria about the writer and the type of person they are looking for (e.g. personality traits, physical looks, etc.). While non-binary personals are most commonly thought of as existing in print media, they also have existed online in spaces such as Craigslist."},"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0004621"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0004631"},{"@id":"https://homosaurus.org/v5/homoit0004632"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0004621"},"dc:issued":{"@type":"xsd:date","@value":"2026-06-09"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-09"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004647","dc:identifier":"homoit0004647","skos:prefLabel":{"@language":"en","@value":"Surveillance"},"rdfs:comment":{"@language":"en","@value":"The systematic observation, monitoring, and potential recording of a person, population, or location, with the purpose of information-gathering, influencing, managing, or directing. Surveillance can be done with the knowledge of the person being surveilled (overt surveillance) or without (covert surveillance). Most often refers to use by governments under the auspices of law enforcement, national security, and information awareness."},"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0004648"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0004647"},"dc:issued":{"@type":"xsd:date","@value":"2026-06-10"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-10"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004648","dc:identifier":"homoit0004648","skos:prefLabel":{"@language":"en","@value":"Surveillance of transgender people"},"skos:altLabel":{"@language":"en","@value":"Surveillance of trans people"},"rdfs:comment":{"@language":"en","@value":"The systematic observation, monitoring, and potential recording of a transgender person or groups, with the purpose of information-gathering, influencing, managing, or directing."},"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0004647"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0004647"},"dc:issued":{"@type":"xsd:date","@value":"2026-06-10"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-10"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"}]}