mosaurus.org/v5/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQFilms"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002544","dc:identifier":"homoit0002544","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ erotic films"},{"@language":"es","@value":"Películas eróticas LGBTQ+"},{"@language":"ja","@value":"LGBTQ+のエロティック映画"},{"@language":"de","@value":"LGBTQ+-erotische Filme"},{"@language":"nl","@value":"LHBTQ+-erotische films"},{"@language":"sv","@value":"Hbtq+-erotisk film"}],"skos:altLabel":[{"@language":"de","@value":"Erotische LGBTQ+-Filme"},{"@language":"sv","@value":"Erotisk film (hbtq+)"}],"rdfs:comment":[{"@language":"en","@value":"Erotic films or movies, created by LGBTQ+ directors, depicting LGBTQ+ people, or that are regarded as important within LGBTQ+ culture. Use a more specific narrower term where applicable."},{"@language":"es","@value":"Filmes o películas eróticas, creadas por directores LGBTQ+, que representan a personas LGBTQ+ o a personas consideradas importantes dentro de la cultura LGBTQ+.Utilicese un término más específico y restringido cuando corresponda."},{"@language":"ja","@value":"LGBTQ+の監督によって制作された、LGBTQ+の人々を描いた、あるいはLGBTQ+文化において重要と見なされているエロティックな映画や映像作品。該当する場合は、より具体的で範囲の狭い用語を使用してください。"},{"@language":"de","@value":"Erotische Filme von LGBTQ+-Künstler:innen, die LGBTQ+-Personen darstellen oder als wichtig innerhalb der LGBTQ+-Kultur angesehen werden."},{"@language":"nl","@value":"Erotische films, gemaakt door LHBTQ+ regisseurs, waarin LHBTQ+ personen voorkomen of personen die als belangrijk worden beschouwd binnen de LHBTQ+ cultuur. Gebruik een specifiekere term waar van toepassing."},{"@language":"sv","@value":"Erotiska filmer skapade av hbtq+-regissörer, som skildar hbtq+-personer eller som betraktas som betydelsefulla inom hbtq+-kultur. Använd mer specifik term vid behov."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000869"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0002546"},{"@id":"https://homosaurus.org/v5/homoit0002547"},{"@id":"https://homosaurus.org/v5/homoit0002548"},{"@id":"https://homosaurus.org/v5/homoit0002549"},{"@id":"https://homosaurus.org/v5/homoit0002550"},{"@id":"https://homosaurus.org/v5/homoit0002551"},{"@id":"https://homosaurus.org/v5/homoit0002552"},{"@id":"https://homosaurus.org/v5/homoit0002553"},{"@id":"https://homosaurus.org/v5/homoit0002554"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000013"},{"@id":"https://homosaurus.org/v5/homoit0002545"},{"@id":"https://homosaurus.org/v5/homoit0002579"}],"skos:closeMatch":[{"@id":"http://id.loc.gov/authorities/subjects/sh85044672"},{"@id":"http://id.loc.gov/authorities/subjects/sh99014452"},{"@id":"http://id.loc.gov/authorities/subjects/sh99014454"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-12"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002555","dc:identifier":"homoit0002555","skos:prefLabel":[{"@language":"en","@value":"Two-Spirit porn films"},{"@language":"es","@value":"Películas porno dos espíritus"},{"@language":"nl","@value":"Two-Spirit pornofilms"},{"@language":"sv","@value":"Two-spirit-porrfilm"}],"skos:altLabel":[{"@language":"en","@value":"2S porn films"},{"@language":"en","@value":"Two Spirit porn films"},{"@language":"en","@value":"Two spirited porn films"},{"@language":"es","@value":"Películas pornográficas dos espíritus"}],"rdfs:comment":[{"@language":"en","@value":"Erotic or sexually explicit films featuring Two-Spirit people."},{"@language":"es","@value":"Películas eróticas o sexualmente explícitas pro