lue":"Sexbranschen"}],"rdfs:comment":[{"@language":"en","@value":"Businesses that either directly or indirectly provide sexual services, sex-related products, and/or erotic entertainment."},{"@language":"es","@value":"Empresas que directa o indirectamente ofrecen servicios sexuales, productos relacionados con el sexo y/o entretenimiento erótico."},{"@language":"nl","@value":"Bedrijven die direct of indirect seksuele diensten, seksgerelateerde producten en/of erotisch entertainment aanbieden."},{"@language":"sv","@value":"De företag som direkt eller indirekt tillhandahåller sexuella handlingar, sexrelaterade produkter eller erotisk underhållning."}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000012"},{"@id":"https://homosaurus.org/v5/homoit0000014"},{"@id":"https://homosaurus.org/v5/homoit0000475"},{"@id":"https://homosaurus.org/v5/homoit0001096"},{"@id":"https://homosaurus.org/v5/homoit0001126"},{"@id":"https://homosaurus.org/v5/homoit0001270"},{"@id":"https://homosaurus.org/v5/homoit0001275"},{"@id":"https://homosaurus.org/v5/homoit0001276"},{"@id":"https://homosaurus.org/v5/homoit0003796"},{"@id":"https://homosaurus.org/v5/homoit0003799"},{"@id":"https://homosaurus.org/v5/homoit0001128"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85120657"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000011"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sexIndustry"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000012","dc:identifier":"homoit0000012","skos:prefLabel":[{"@language":"en","@value":"Sex shops"},{"@language":"es","@value":"Tiendas eróticas"},{"@language":"nl","@value":"Seksshops"},{"@language":"sv","@value":"Sexbutiker"}],"skos:altLabel":[{"@language":"en","@value":"Adult entertainment stores"},{"@language":"en","@value":"Adult shops"},{"@language":"en","@value":"Adult stores"},{"@language":"en","@value":"Erotic shops"},{"@language":"en","@value":"Erotic stores"},{"@language":"en","@value":"Porn stores"},{"@language":"en","@value":"Porn shops"},{"@language":"en","@value":"Sex stores"},{"@language":"en","@value":"Adult entertainment shops"},{"@language":"es","@value":"Boutiques eróticas"},{"@language":"es","@value":"Tiendas para adultos"},{"@language":"es","@value":"Sex shops"},{"@language":"es","@value":"Tiendas de entretenimiento adulto"},{"@language":"nl","@value":"Pornoshops"},{"@language":"nl","@value":"Pornowinkels"},{"@language":"nl","@value":"Sekswinkels"},{"@language":"sv","@value":"Sexshoppar"},{"@language":"sv","@value":"Porrbutiker"}],"rdfs:comment":[{"@language":"en","@value":"Retailers that sell products related to sex and sexual entertainment, including sex toys, lingerie, pornography, and other related products."},{"@language":"es","@value":"Comercios que venden productos relacionados con el sexo y el ocio sexual, incluidos juguetes sexuales, lencería, pornografía y otros productos relacionados."},{"@language":"nl","@value":"Detailhandelaren die producten verkopen die gerelateerd zijn aan seks en seksueel entertainment, waaronder seksspeeltjes, lingerie, pornografie en andere gerelateerde producten."},{"@language":"sv","@value":"Butiker som säljer produkter kopplade till sex och sexuell underhållning, inklusive sexleksaker, underkläder, pornografi och andra relaterade produkter."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000011"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001266"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000011"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sexShops"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000014","dc:identifier":"homoit0000014","skos:prefLabel":[{"@language":"en","@value":"Sex cinemas"},{"@language":"es","@value":"Cines de sexo"},{"@language":"nl","@value":"Seksbioscopen"},{"@language":"sv","@value":"Porrbiografer"}],"skos:altLabel":[{"@language":"en","@value":"Adult movie theatres"},{"@language":"en","@value":"Adult cinemas"},{"@language":"en","@value":"Adult movie theaters"},{"@language":"en","@value":"Erotic cinemas"},{"@language":"en","@value":"Erotic theaters"},{"@language":"en","@value":"Erotic theatres"},{"@language":"en","@value":"Sex theaters"},{"@language":"en","@value":"Sex theatres"},{"@language":"es","@value":"Cines de películas para adultos"},{"@language":"es","@value":"Cines porno"},{"@language":"sv","@value":"Sexbiografer"}],"rdfs:comment":[{"@language":"en","@value":"Movie theatres that primarily show pornographic films. Patrons engaging in nudity and public masturbation or sex may be explicitly permitted by the theatre or merely tolerated."},{"@language":"es","@value":"Cines que proyectan principalmente películas pornográficas. El teatro puede permitir explícitamente o simplemente tolerar que los espectadores se desnuden o se masturben o practiquen sexo en público."},{"@language":"nl","@value":"Bioscopen die voornamelijk pornografische films vertonen. Bezoekers die naakt zijn en openlijk masturberen of seks hebben kunnen expliciet worden toegestaan ​​door de bioscoop of worden getolereerd."},{"@language":"sv","@value":"Biografer som huvudsakligen visar pornografiska filmer. Det kan uttryckligen tillåtas eller informellt tolereras att besökare är nakna, onanerar eller har sex offentligt."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000011"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000013"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000011"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sexCinemas"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000475","dc:identifier":"homoit0000475","skos:prefLabel":[{"@language":"en","@value":"Gay saunas"},{"@language":"es","@value":"Saunas gay"},{"@language":"de","@value":"Schwulensaunen"},{"@language":"nl","@value":"Homosauna's"},{"@language":"sv","@value":"Bastuklubbar"}],"skos:altLabel":[{"@language":"en","@value":"Gay bathhouses"},{"@language":"en","@value":"Gay baths"},{"@language":"de","@value":"Schwule Saunen"},{"@language":"de","@value":"Badehäuser"},{"@language":"de","@value":"Schwule Badehäuser"}],"rdfs:comment":[{"@language":"en","@value":"Commercial saunas or bathhouses intended for gay men to meet and engage in sexual activities."},{"@language":"es","@value":"Saunas o baños comerciales destinados a que hombres gay se reúnan y realicen actividades sexuales."},{"@language":"de","@value":"Kommerzielle Saunen oder Badehäuser, die für schwule Männer zum Kennenlernen und für sexuelle Aktivitäten gedacht sind."},{"@language":"nl","@value":"Commerciële sauna's of badhuizen bedoeld voor homomannen om elkaar te ontmoeten en voor seksuele activiteiten"},{"@language":"sv","@value":"Kommersiella bastur eller badhus avsedda för bögar att mötas och ha sex."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000011"},{"@id":"https://homosaurus.org/v5/homoit0000909"},{"@id":"https://homosaurus.org/v5/homoit0000974"}],"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0000595"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001142"},{"@id":"https://homosaurus.org/v5/homoit0001270"},{"@id":"https://homosaurus.org/v5/homoit0002382"},{"@id":"https://homosaurus.org/v5/homoit0003079"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2005020503"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000011"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gaySaunas"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001096","dc:identifier":"homoit0001096","skos:prefLabel":[{"@language":"en","@value":"Peep shows"},{"@language":"es","@value":"Peep shows"},{"@language":"fr","@value":"Peep shows"},{"@language":"nl","@value":"Peepshows"},{"@language":"sv","@value":"Peepshow"}],"skos:altLabel":[{"@language":"en","@value":"Peepshows"},{"@language":"es","@value":"Peepshows"}],"rdfs:comment":[{"@language":"en","@value":"Live sex shows or pornographic movies viewed through a small opening or magnifying lens, typically from a coin-operated booth."},{"@language":"es","@value":"Espectáculos de sexo en vivo o películas pornográficas vistas a través de una pequeña apertura o lente de aumento, generalmente desde una cabina que funciona con monedas."},{"@language":"fr","@value":"Spectacles érotique ou films pornographique visionnés dans une cabine individuelle à travers une petite ouverture ou une lentille grossissante."},{"@language":"nl","@value":"Live seksshows of pornografische films bekeken door een kleine opening of vergrotende lens, meestal vanuit een op munten werkend hokje."},{"@language":"sv","@value":"Live-sexshower eller pornografiska filmer som ses genom en liten öppning eller ett förstoringsglas, ofta från ett myntstyrt bås."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000011"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh97005572"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000011"},"dc:replaces":{"@id":"http://homosaurus.org/v2/peepShows"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001126","dc:identifier":"homoit0001126","skos:prefLabel":[{"@language":"en","@value":"Porn industry"},{"@language":"es","@value":"Industria porno"},{"@language":"nl","@value":"Porno-industrie"},{"@language":"sv","@value":"Porrindustri"}],"skos:altLabel":[{"@language":"en","@value":"Porno industry"},{"@language":"en","@value":"Pornography industry"},{"@language":"es","@value":"Industria pornográfica"}],"rdfs:comment":[{"@language":"en","@value":"Businesses that sell pornography, or materials intended for sexual arousal, including images, videos, literature, etc."},{"@language":"es","@value":"Negocios que venden pornografía o materiales destinados a la excitación sexual, incluyendo imágenes, vídeos, literatura, etc."},{"@language":"nl","@value":"Bedrijven die pornografie of materiaal verkopen dat bedoeld is voor seksuele opwinding, waaronder afbeeldingen, video's, literatuur, enz."},{"@language":"sv","@value":"Företag som säljer pornografi eller material avsett för sexuell upphetsning, inklusive bilder, videor, litteratur med mera."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000011"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000013"},{"@id":"https://homosaurus.org/v5/homoit0000923"}],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2009006249"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000011"},"dc:replaces":{"@id":"http://homosaurus.org/v2/pornIndustry"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001270","dc:identifier":"homoit0001270","skos:prefLabel":[{"@language":"en","@value":"Sex clubs"},{"@language":"es","@value":"Clubs de sexo"},{"@language":"nl","@value":"Seksclubs"},{"@language":"sv","@value":"Sexklubbar"}],"skos:altLabel":[{"@language":"es","@value":"Clubes sexuales"},{"@language":"sv","@value":"Porrklubbar"}],"rdfs:comment":[{"@language":"en","@value":"Establishments where patrons can engage in sex with other patrons, as well as formal or informal groups that organize sex-related activities."},{"@language":"es","@value":"Establecimientos en los que los clientes pueden mantener relaciones sexuales con otros clientes, así como grupos formales o informales que organizan actividades relacionadas con el sexo."},{"@language":"nl","@value":"Gelegenheden waar gasten seks kunnen hebben met andere gasten, maar ook formele of informele groepen die seksuele activiteiten organiseren."},{"@language":"sv","@value":"Etablissemang där besökare kan ha sex med andra besökare, samt formella eller informella grupper som organiserar sexrelaterade aktiviteter."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000011"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000087"},{"@id":"https://homosaurus.org/v5/homoit0000475"},{"@id":"https://homosaurus.org/v5/homoit0001272"},{"@id":"https://homosaurus.org/v5/homoit0003079"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000011"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sexClubs"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001275","dc:identifier":"homoit0001275","skos:prefLabel":[{"@language":"en","@value":"Sex tourism"},{"@language":"es","@value":"Turismo sexual"},{"@language":"nl","@value":"Sekstoerisme"},{"@language":"sv","@value":"Sexturism"}],"rdfs:comment":[{"@language":"en","@value":"The practice of traveling with the intention of soliciting sex work, typically to countries where sex work is legal, decriminalized, or less stigmatized. Sex tourism often presents ethical concerns, such as the economic gap between tourists and residents, differences in age of consent laws globally, and the selective enforcement of anti-sex work laws by police."},{"@language":"es","@value":"La práctica de viajar con la intención de solicitar trabajo sexual, normalmente a países donde el trabajo sexual es legal, está despenalizado o menos estigmatizado. El turismo sexual suele plantear problemas éticos, como la brecha económica entre turistas y residentes, las diferencias en las leyes sobre la edad de consentimiento en todo el mundo y la aplicación selectiva de las leyes contra el trabajo sexual por parte de la policía."},{"@language":"nl","@value":"De praktijk van reizen met de intentie voor seks, meestal naar landen waar sekswerk legaal, gedecriminaliseerd of minder gestigmatiseerd is. Sekstoerisme brengt vaak ethische zorgen met zich mee, zoals de economische kloof tussen toeristen en inwoners, verschillen in wetten voor meerderjarigheid wereldwijd en de selectieve handhaving van wetten tegen sekswerk door de politie."},{"@language":"sv","@value":"Praktiken att resa med avsikten att köpa sexuella handlingar, vanligtvis till länder där sexarbete är lagligt, avkriminaliserat eller mindre stigmatiserat. Sexturism väcker ofta etiska frågor, såsom ekonomiska ojämlikheter mellan turister och lokalbefolkning, skillnader i lagstiftning kring samtyckesålder globalt samt selektiv tillämpning av lagar mot sexarbete från polisens sida."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000011"},"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0003262"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001276"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh96006838"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000011"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sexTourism"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001276","dc:identifier":"homoit0001276","skos:prefLabel":[{"@language":"en","@value":"Sex work"},{"@language":"es","@value":"Trabajo sexual"},{"@language":"nl","@value":"Sekswerk"},{"@language":"sv","@value":"Sexarbete"}],"skos:altLabel":{"@language":"en","@value":"Prostitution"},"rdfs:comment":[{"@language":"en","@value":"The exchange of sexual services, performances, or companionship for money or goods. Use to describe the broad spectrum of sex work, and use more specific terms if possible. For individuals who perform sex work, use \"Sex workers\" or narrower terms. For sex work undertaken by individuals who cannot or have not consented, use \"Sex trafficking.\""},{"@language":"es","@value":"El intercambio de servicios, actuaciones o productos sexuales a cambio de una compensación material; incluye actividades que implican contacto físico directo entre quienes compran y quienes venden, así como estimulación sexual indirecta."},{"@language":"nl","@value":"De uitwisseling van seksuele diensten, optredens of gezelschap voor geld of goederen. Gebruik om het brede spectrum van sekswerk te beschrijven en gebruik indien mogelijk specifiekere termen. Voor personen die sekswerk verrichten, gebruik \"Sekswerkers\" of NT's (narrower terms). Voor sekswerk dat wordt uitgevoerd door personen die niet kunnen of hebben hiermee ingestemd, gebruik \"Sekshandel.\""},{"@language":"sv","@value":"Utbyte av sexuella handlingar, framträdanden eller produkter mot materiell ersättning. Inkluderar både aktiviteter som innebär direkt fysisk kontakt mellan köpare och säljare och indirekt sexuell stimulans. Vissa anser termen sexarbete som kränkande och politiserad medan förespråkar den. Se även \"Prostitution\"."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000011"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000405"},{"@id":"https://homosaurus.org/v5/homoit0003763"},{"@id":"https://homosaurus.org/v5/homoit0003764"},{"@id":"https://homosaurus.org/v5/homoit0003768"},{"@id":"https://homosaurus.org/v5/homoit0003780"},{"@id":"https://homosaurus.org/v5/homoit0003781"},{"@id":"https://homosaurus.org/v5/homoit0003792"},{"@id":"https://homosaurus.org/v5/homoit0000494"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001275"},{"@id":"https://homosaurus.org/v5/homoit0003743"},{"@id":"https://homosaurus.org/v5/homoit0003758"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2022006936"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000011"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sexWork"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003796","dc:identifier":"homoit0003796","skos:prefLabel":[{"@language":"en","@value":"Erotic massage businesses"},{"@language":"nl","@value":"Erotische massagebedrijven"},{"@language":"sv","@value":"Massageföretag som erbjuder sexuella handlingar"}],"skos:altLabel":[{"@language":"en","@value":"Sexual massage parlors"},{"@language":"en","@value":"Rub and tug massage parlors"},{"@language":"en","@value":"Full service massage parlors"},{"@language":"en","@value":"Erotic massage parlors"},{"@language":"nl","@value":"Seksuele massage salons"}],"rdfs:comment":[{"@language":"en","@value":"Massage businesses that provide sexual services, either legally or under the table."},{"@language":"nl","@value":"Massagebedrijven die seksuele diensten aanbieden, legaal of onder de tafel."},{"@language":"sv","@value":"Massageverksamheter som erbjuder sexuella handlingar, antingen lagligt eller under täckmantel."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000011"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000402"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh95008240"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000011"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-30"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003799","dc:identifier":"homoit0003799","skos:prefLabel":[{"@language":"en","@value":"Red light districts"},{"@language":"nl","@value":"Rosse buurten"},{"@language":"sv","@value":"Red light districts"}],"skos:altLabel":[{"@language":"en","@value":"Red-light districts"},{"@language":"en","@value":"Pleasure districts"},{"@language":"nl","@value":"Red light districts"},{"@language":"nl","@value":"Roze buurten"}],"rdfs:comment":[{"@language":"en","@value":"Areas designated (often but not always legally) for the practice and solicitation of sex work."},{"@language":"nl","@value":"Gebieden die (vaak, maar niet altijd, wettelijk) zijn aangewezen voor het uitoefenen en werven van sekswerk."},{"@language":"sv","@value":"Områden som är avsedda (ibland men inte alltid juridiskt) för att möjliggöra eller utöva sexarbete."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000011"},"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0003800"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2008005691"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000011"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-30"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001128","dc:identifier":"homoit0001128","skos:prefLabel":[{"@language":"en","@value":"Pornography"},{"@language":"es","@value":"Pornografía"},{"@language":"nl","@value":"Pornografie"},{"@language"