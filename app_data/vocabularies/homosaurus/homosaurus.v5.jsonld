s:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004585","dc:identifier":"homoit0004585","skos:prefLabel":{"@language":"en","@value":"Asexual cyclists"},"skos:altLabel":[{"@language":"en","@value":"Ace cyclists"},{"@language":"en","@value":"Asexual bicyclists"}],"rdfs:comment":{"@language":"en","@value":"Asexual people who ride bicycles."},"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0002761"},{"@id":"https://homosaurus.org/v5/homoit0004581"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001297"},"dc:issued":{"@type":"xsd:date","@value":"2026-06-05"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-05"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004596","dc:identifier":"homoit0004596","skos:prefLabel":{"@language":"en","@value":"Asexual ice hockey players"},"skos:altLabel":{"@language":"en","@value":"Ace ice hockey players"},"rdfs:comment":{"@language":"en","@value":"Asexual people who play ice hockey."},"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0004591"},{"@id":"https://homosaurus.org/v5/homoit0002761"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2026-06-08"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-08"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002799","dc:identifier":"homoit0002799","skos:prefLabel":[{"@language":"en","@value":"Asexual museums"},{"@language":"es","@value":"Museos asexuales"},{"@language":"de","@value":"Asexuelle Museen"},{"@language":"nl","@value":"Aseksuele musea"},{"@language":"sv","@value":"Asexuella museum"}],"skos:altLabel":[{"@language":"de","@value":"Ace Museen"},{"@language":"sv","@value":"Ace-museum"}],"rdfs:comment":[{"@language":"en","@value":"Institutions dedicated to the storage, exhibition, conservation, and preservation of materials relating to asexual people and asexual history."},{"@language":"es","@value":"Instituciones dedicadas al almacenamiento, la exposición, la conservación y la preservación de materiales relacionados con las personas asexuales y la historia asexual."},{"@language":"de","@value":"Einrichtungen, die sich der Aufbewahrung, Ausstellung, Konservierung und Erhaltung von Materialien über asexuelle Menschen und die asexuelle Geschichte widmen."},{"@language":"nl","@value":"Instellingen die zich toeleggen op de opslag, tentoonstelling, conservering en bewaring van materialen met betrekking tot aseksuele personen en aseksuele geschiedenis"},{"@language":"sv","@value":"Institutioner som ägnar sig åt insamling, utställning, bevarande och konservering av material som rör asexualitet, asexuella personer eller asexuell historia."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000907"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001755"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004626","dc:identifier":"homoit0004626","skos:prefLabel":{"@language":"en","@value":"Asexual personals"},"skos:altLabel":[{"@language":"en","@value":"Asexual personal ads"},{"@language":"en","@value":"Asexual personal advertisements"},{"@language":"en","@value":"Ace personals"},{"@language":"en","@value":"Ace personal ads"},{"@language":"en","@value":"Ace personal advertisements"}],"rdfs:comment":{"@language":"en","@value":"A form of classified advertising for asexual people interested in seeking connections around sex, romance, and/or community. The text of these ads focus largely on the type of arrangement sought and details or criteria about the writer and the type of person they are looking for (e.g. personality traits, physical looks, etc.). While asexual personals are most commonly thought of as existing in print media, they also have existed online in spaces such as Craigslist."},"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0004621"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0002807"},{"@id":"https://homosaurus.org/v5/homoit0002804"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0004621"},"dc:issued":{"@type":"xsd:date","@value":"2026-06-08"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-08"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004324","dc:identifier":"homoit0004324","skos:prefLabel":[{"@language":"en","@value":"Asexual podcasts"},{"@language":"nl","@value":"Aseksuele podcasts"},{"@language":"sv","@value":"Asexuella poddar"}],"skos:altLabel":[{"@language":"en","@value":"Ace podcasts"},{"@language":"sv","@value":"Asexuella podcaster"}],"rdfs:comment":[{"@language":"en","@value":"A recorded series (primarily in audio, but sometimes with a video component) with recurring hosts that feature content about asexual people and/or asexual issues and that are available digitally for streaming or download. Podcasts are typically episodic and may feature different guests."},{"@language":"nl","@value":"Een opgenomen serie (voornamelijk audio, maar soms met een video-onderdeel) met terugkerende presentatoren die content presenteren over aseksuele personen en/of aseksuele thema's en die digitaal beschikbaar zijn om te streamen of te downloaden. Podcasts bestaan ​​doorgaans uit afleveringen en kunnen verschillende gasten hebben."},{"@language":"sv","@value":"Inspelade radioprogram (inslag av video kan förekomma) med återkommande programledare och innehåll om/för asexuella personer och/eller asexuella frågor som är digitalt tillgängliga genom streaming eller nedladdning. Poddar är vanligen uppdelade i episoder och kan ha olika gäster."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0004317"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0002806"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0004317"},"dc:issued":{"@type":"xsd:date","@value":"2026-02-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002809","dc:identifier":"homoit0002809","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ politicians"},{"@language":"es","@value":"Políticos LGBTQ+"},{"@language":"nl","@value":"LHBTQ+-politici"},{"@language":"sv","@value":"Hbtq+-politiker"}],"skos:altLabel":[{"@language":"en","@value":"LGBTQ+ public officials"},{"@language":"es","@value":"Políticos (LGBTQ)"},{"@language":"es","@value":"Oficiales publicos LGBTQ+"}],"rdfs:comment":[{"@language":"en","@value":"LGBTQ+ people who are candidates for public office, are currently holding public office, or have held political positions. Politicians can be elected by public election or otherwise appointed."},{"@language":"es","@value":"Personas LGBTQ+ que son candidatas a cargos públicos, que actualmente ocupan cargos públicos o que han ocupado cargos políticos. Los políticos pueden ser elegidos mediante elección pública o designados de otro modo."},{"@language":"nl","@value":"LHBTQ+-personen die kandidaat zijn voor een openbaar ambt, momenteel een openbaar ambt bekleden of een politieke functie hebben bekleed. Politici kunnen door middel van openbare verkiezingen worden gekozen of op een andere manier worden benoemd."},{"@language":"sv","@value":"Hbtq+-personer som är kandidater till politiska uppdrag, som innehar eller har innehaft politiska uppdrag. Politiker kan vara folkvalda eller utsedda genom andra former av tillsättning."}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0002810"},{"@id":"https://homosaurus.org/v5/homoit0002811"},{"@id":"https://homosaurus.org/v5/homoit0002812"},{"@id":"https://homosaurus.org/v5/homoit0002813"},{"@id":"https://homosaurus.org/v5/homoit0002814"},{"@id":"https://homosaurus.org/v5/homoit0002815"},{"@id":"https://homosaurus.org/v5/homoit0002816"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0002817"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2015000368"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0002809"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002810","dc:identifier":"homoit0002810","skos:prefLabel":[{"@language":"en","@value":"Gay politicians"},{"@language":"es","@value":"Políticos gay"},{"@language":"de","@value":"Schwule Politiker"},{"@language":"nl","@value":"Homopolitici"},{"@language":"sv","@value":"Bögpolitiker"}],"skos:altLabel":[{"@language":"en","@value":"Gay public officials"},{"@language":"es","@value":"Oficiales públicos gay"},{"@language":"de","@value":"Schwule Männer in öffentlichen Ämtern"},{"@language":"sv","@value":"Homosexuella manliga politiker"}],"rdfs:comment":[{"@language":"en","@value":"Gay men who are candidates for public office, are currently holding public office, or have held political positions. Politicians can be elected by public election or otherwise appointed."},{"@language":"es","@value":"Hombres o personas masc gay que son candidatos a cargos públicos, ejercen actualmente cargos públicos o han desempeñado cargos políticos. Los políticos pueden ser elegidos mediante elección pública o designados de otro modo."},{"@language":"de","@value":"Schwule Männer, die für ein öffentliches Amt kandidieren, derzeit ein öffentliches Amt innehaben oder politische Positionen innehatten. Politiker:innen können durch öffentliche Wahlen gewählt oder anderweitig ernannt werden."},{"@language":"nl","@value":"Homomannen die kandidaat zijn voor een openbaar ambt, momenteel een openbaar ambt bekleden of een politieke functie hebben bekleed. Politici kunnen door middel van openbare verkiezingen worden gekozen of op een andere manier worden benoemd."},{"@language":"sv","@value":"Bögar som är kandidater till politiska uppdrag, som innehar eller har innehaft politiska uppdrag. Politiker kan vara folkvalda eller utsedda genom andra former av tillsättning."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002809"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh91002560"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0002809"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002811","dc:identifier":"homoit0002811","skos:prefLabel":[{"@language":"en","@value":"Lesbian politicians"},{"@language":"es","@value":"Políticas lesbianas"},{"@language":"nl","@value":"Lesbische politici"},{"@language":"sv","@value":"Lesbiska politiker"}],"skos:altLabel":[{"@language":"en","@value":"Lesbian public officials"},{"@language":"es","@value":"Oficiales públicas lesbianas"}],"rdfs:comment":[{"@language":"en","@value":"Lesbians who are candidates for public office, are currently holding public office, or have held political positions. Politicians can be elected by public election or otherwise appointed."},{"@language":"es","@value":"Lesbianas que sean candidatas a cargos públicos, ejerzan actualmente cargos públicos o hayan desempeñado cargos políticos. Las políticas pueden ser elegidas mediante elección pública o designadas de otro modo."},{"@language":"nl","@value":"Lesbische vrouwen die kandidaat zijn voor een openbaar ambt, momenteel een openbaar ambt bekleden of een politieke functie hebben bekleed. Politici kunnen door middel van openbare verkiezingen worden gekozen of op een andere manier worden benoemd."},{"@language":"sv","@value":"Lesbiska som är kandidater till politiska uppdrag, som innehar eller har innehaft politiska uppdrag. Politiker kan vara folkvalda eller utsedda genom andra former av tillsättning."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002809"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0002809"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002812","dc:identifier":"homoit0002812","skos:prefLabel":[{"@language":"en","@value":"Bisexual politicians"},{"@language":"de","@value":"Bisexuelle Politiker:innen"},{"@language":"es","@value":"Políticos bisexuales"},{"@language":"nl","@value":"Biseksuele politici"},{"@language":"sv","@value":"Bisexuella politiker"}],"skos:altLabel":[{"@language":"en","@value":"Bisexual public officials"},{"@language":"de","@value":"Bisexuelle Personen in öffentlichen Ämtern"},{"@language":"es","@value":"Oficiales públicos bisexuales"},{"@language":"es","@value":"Oficiales públicas bisexuales"},{"@language":"es","@value":"Políticas bisexuales"}],"rdfs:comment":[{"@language":"en","@value":"Bisexual people who are candidates for public office, are currently holding public office, or have held political positions. Politicians can be elected by public election or otherwise appointed."},{"@language":"de","@value":"Bisexuelle Personen, die für ein öffentliches Amt kandidieren, derzeit ein öffentliches Amt innehaben oder politische Positionen innehatten. Politiker:innen können durch öffentliche Wahlen gewählt oder anderweitig ernannt werden."},{"@language":"es","@value":"Personas bisexuales que son candidatas a cargos públicos, que ejercen cargos públicos o que han desempeñado cargos políticos. Los políticos pueden ser elegidos mediante elección pública o designados de otro modo."},{"@language":"nl","@value":"Biseksuele personen die kandidaat zijn voor een openbaar ambt, momenteel een openbaar ambt bekleden of een politieke functie hebben bekleed. Politici kunnen door middel van openbare verkiezingen worden gekozen of op een andere manier worden benoemd."},{"@language":"sv","@value":"Bisexuella personer som är kandidater till politiska uppdrag, som innehar eller har innehaft politiska uppdrag. Politiker kan vara folkvalda eller utsedda genom andra former av tillsättning."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002809"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0002809"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002813","dc:identifier":"homoit0002813","skos:prefLabel":[{"@language":"en","@value":"Queer politicians"},{"@language":"es","@value":"Políticos queer"},{"@language":"nl","@value":"Queer politici"},{"@language":"sv","@value":"Queera politiker"}],"skos:altLabel":[{"@language":"en","@value":"Queer public officials"},{"@language":"es","@value":"Oficiales públicos queer"}],"rdfs:comment":[{"@language":"en","@value":"Queer people who are candidates for public office, are currently holding public office, or have held political positions. Politicians can be elected by public election or otherwise appointed."},{"@language":"es","@value":"Personas queer que son candidatas a cargos públicos, ocupan actualmente cargos públicos o han ocupado cargos políticos. Los políticos pueden ser elegidos mediante elección pública o designados de otro modo."},{"@language":"nl","@value":"Queer personen die kandidaat zijn voor een openbaar ambt, momenteel een openbaar ambt bekleden of een politieke functie hebben bekleed. Politici kunnen door middel van openbare verkiezingen worden gekozen of op een andere manier worden benoemd."},{"@language":"sv","@value":"Queera personer som är kandidater till politiska uppdrag, som innehar eller har innehaft politiska uppdrag. Politiker kan vara folkvalda eller utsedda genom andra former av tillsättning."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002809"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0002809"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002814","dc:identifier":"homoit0002814","skos:prefLabel":[{"@language":"en","@value":"Transgender politicians"},{"@language":"es","@value":"Políticos transgénero"},{"@language":"nl","@value":"Transgender politici"},{"@language":"sv","@value":"Politiker som är transpersoner"}],"skos:altLabel":[{"@language":"en","@value":"Transgender public officials"},{"@language":"es","@value":"Oficiales públicos transgénero"},{"@language":"sv","@value":"Transpolitiker"}],"rdfs:comment":[{"@language":"en","@value":"Transgender people who are candidates for public office, are currently holding public office, or have held political positions. Politicians can be elected by public election or otherwise appointed."},{"@language":"es","@value":"Personas transgénero que son candidatos a cargos públicos, ocupan actualmente cargos públicos o han ocupado cargos políticos. Los políticos pueden ser elegidos mediante elección pública o designados de otro modo."},{"@language":"nl","@value":"Transgender personen die kandidaat zijn voor een openbaar ambt, momenteel een openbaar ambt bekleden of een politieke functie hebben bekleed. Politici kunnen door middel van openbare verkiezingen worden gekozen of op een andere manier worden benoemd."},{"@language":"sv","@value":"Transpersoner som är kandidater till politiska uppdrag, som innehar eller har innehaft politiska uppdrag. Politiker kan vara folkvalda eller utsedda genom andra former av tillsättning."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002809"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0002809"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002815","dc:identifier":"homoit0002815","skos:prefLabel":[{"@language":"en","@value":"Intersex politicians"},{"@language":"de","@value":"Inter* Politiker:innen"},{"@language":"es","@value":"Políticos intersexuales"},{"@language":"nl","@value":"Intersekse politici"},{"@language":"sv","@value":"Intersexpolitiker"}],"skos:altLabel":[{"@language":"en","@value":"Intersex public officials"},{"@language":"de","@value":"Inter* Personen in öffentlichen Ämtern"},{"@language":"es","@value":"Oficiales públicos intersex"},{"@language":"es","@value":"Políticos intersex"}],"rdfs:comment":[{"@language":"en","@value":"Intersex people who are candidates for public office, are currently holding public office, or have held political positions. Politicians can be elected by public election or otherwise appointed."},{"@language":"de","@value":"Inter* Personen, die für ein öffentliches Amt kandidieren, derzeit ein öffentliches Amt innehaben oder politische Positionen innehatten. Politiker:innen können durch öffentliche Wahlen gewählt oder anderweitig ernannt werden."},{"@language":"es","@value":"Personas intersexuales que son candidatas a cargos públicos, que actualmente ocupan cargos públicos o han ocupado cargos políticos. Los políticos pueden ser elegidos mediante elección pública o designados de otro modo."},{"@language":"nl","@value":"Intersekse personen die kandidaat zijn voor een openbaar ambt, momenteel een openbaar ambt bekleden of een politieke functie hebben bekleed. Politici kunnen door middel van openbare verkiezingen worden gekozen of op een andere manier worden benoemd."},{"@language":"sv","@value":"Intersexpersoner som är kandidater till politiska uppdrag, som innehar eller har innehaft politiska uppdrag. Politiker kan vara folkvalda eller utsedda genom andra former av tillsättning."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002809"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0002809"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002816","dc:identifier":"homoit0002816","skos:prefLabel":[{"@language":"en","@value":"Asexual politicians"},{"@language":"es","@value":"Políticos asexuales"},{"@language":"de","@value":"Asexuelle Politiker:innen"},{"@language":"nl","@value":"Aseksuele politici"},{"@language":"sv","@value":"Asexuella politiker"}],"skos:altLabel":[{"@language":"en","@value":"Asexual public officials"},{"@language":"es","@value":"Oficiales públicos asexuales"},{"@language":"es","@value":"Oficiales públicas asexuales"},{"@language":"de","@value":"Asexuelle Personen in öffentlichen Ämtern"},{"@language":"de","@value":"Ace Politiker:innen"},{"@language":"sv","@value":"Ace-politiker"}],"rdfs:comment":[{"@language":"en","@value":"Asexual people who are candidates for public office, are currently holding public office, or have held political positions. Politicians can be elected by public election or otherwise appointed."},{"@language":"es","@value":"Personas asexuales que son candidatas a cargos públicos, ocupan actualmente cargos públicos o han ocupado cargos políticos. Los políticos pueden ser elegidos por sufragio público o designados de otro modo."},{"@language":"de","@value":"Asexuelle Personen, die für ein öffentliches Amt kandidieren, derzeit ein öffentliches Amt innehaben oder politische Positionen innehatten. Politiker:innen können durch öffentliche Wahlen gewählt oder anderweitig ernannt werden."},{"@language":"nl","@value":"Aseksuele personen die kandidaat zijn voor een openbaar ambt, momenteel een openbaar ambt bekleden of een politieke functie hebben bekleed. Politici kunnen door middel van openbare verkiezingen worden gekozen of op een andere manier worden benoemd."},{"@language":"sv","@value":"Asexuella personer som är kandidater till politiska uppdrag, som innehar eller har innehaft politiska uppdrag. Politiker kan vara folkvalda eller utsedda genom andra former av tillsättning."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002809"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0002809"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002874","dc:identifier":"homoit0002874","skos:prefLabel":[{"@language":"en","@value":"Salt-wasting congenital adrenal hyperplasia"},{"@language":"es","@value":"Hiperplasia adrenal congénita con pérdida de sal"},{"@language":"nl","@value":"Klassieke congenitale adrenale hyperplasie met zoutverlies"},{"@language":"sv","@value":"Medfödd binjureförstoring"}],"skos:altLabel":[{"@language":"sv","@value":"Kongenital binjurebarkshyperplasi"},{"@language":"sv","@value":"Adrenogenitalt syndrom"}],"rdfs:comment":[{"@language":"en","@value":"People who have salt-wasting congenital adrenal hyperplasia (CAH), a subtype of classical CAH, experience \"salt-wasting,\" a dangerous scenario a person's low levels of aldosterone cause their body to lose too much sodium. They may experience life-threatening adrenal crises, especially when their body is under stress."},{"@language":"es","@value":"Las personas que padecen hiperplasia suprarrenal congénita (HSC) con pérdida de sal, un subtipo de HSC clásica, sufren «pérdida de sal», una situación peligrosa en la que los bajos niveles de aldosterona hacen que el organismo pierda demasiado sodio. Pueden sufrir crisis suprarrenales potencialmente mortales, especialmente cuando su organismo está sometido a estrés."},{"@language":"nl","@value":"Personen met congenitale adrenale hyperplasie (CAH) met zoutverlies, een subtype van klassieke CAH, ervaren teveel zoutverlies, een gevaarlijk scenario. Het lage aldosterongehalte van een persoon zorgt ervoor dat hun lichaam te veel natrium verliest. Ze kunnen levensbedreigende bijniercrises ervaren, vooral als hun lichaam onder stress staat."},{"@language":"sv","@value":"Medfödd binjurebarkshyperplasi (CAH), en undergrupp av klassisk CAH innebär att binjuren inte producerar tillräckligt mycket av hormonet aldosteron. Personer med CAH kan drabbas av förlust av natrium och det kan medföra livshotande binjuresvikt, särskilt vid fysisk eller psykisk stress. Hormonbristen leder redan under fosterstadiet till ökad produktion av hormoner med androgen effekt vilket leder till virilisering av könsorganen och personens könstillhörighet kan vara svår att bestämma som manlig eller kvinnlig."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002827"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001269"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002879","dc:identifier":"homoit0002879","skos:prefLabel":[{"@language":"en","@value":"Type 1 Leydig cell hypoplasia"},{"@language":"es","@value":"Hipoplasia de células de Leydig tipo 1"},{"@language":"nl","@value":"Type 1 Leydigcelhypoplasie"},{"@language":"sv","@value":"Typ 1 Leydigcellshypoplasi"}],"skos:altLabel":[{"@language":"en","@value":"Type 1 LCH"},{"@language":"sv","@value":"Type 1 Leydig cell hypoplasia"}],"rdfs:comment":[{"@language":"en","@value":"People with Type 1 Leydig cell hypoplasia (LCH) produce almost no testosterone and will usually be born with a vulva and vagina and undescended testes. They are usually assigned female at birth, often without their variation being recognized until adolescence, at which point they generally will not develop any secondary sex characteristics or experience other changes typically associated with puberty."},{"@language":"es","@value":"Las personas con hipoplasia de células de Leydig (HCL) tipo 1 casi no producen testosterona y generalmente nacen con vulva y vagina y testículos no descendidos. Por lo general, se les asigna al sexo femenino al nacer, a menudo sin que se reconozca su variación hasta la adolescencia, momento en el que generalmente no desarrollan ninguna característica sexual secundaria ni experimentan otros cambios típicamente asociados con la pubertad."},{"@language":"nl","@value":"Personen met Type 1 Leydig-celhypoplasie (LCH) produceren vrijwel geen testosteron en worden meestal geboren met een vulva en vagina en niet-ingedaalde testikels. Ze worden gewoonlijk bij de geboorte als vrouw toegewezen, vaak zonder dat hun variatie wordt erkend tot de adolescentie, waarna ze over het algemeen geen secundaire geslachtskenmerken zullen ontwikkelen of andere veranderingen zullen ervaren die doorgaans verband houden met de puberteit."},{"@language":"sv","@value":"Personer med typ 1 Leydigcellshypoplasi (LCH typ 1) har en kraftigt nedsatt funktion i receptorerna för luteiniserande hormon (LH) och producerar därför nästan inget testosteron. Det drabbar genetiskt manliga personer (46XY) som vanligtvis föds med vulva och vagina samt testiklar som inte vandrat ned (kryptorkism). De tilldelas ofta kvinnligt kön vid födseln och variationen upptäcks först i puberteten, då de vanligtvis inte utvecklar några sekundära könskarakteristika eller andra pubertetsförändringar."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002863"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001269"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002881","dc:identifier":"homoit0002881","skos:prefLabel":[{"@language":"en","@value":"Type 2 Leydig cell hypoplasia"},{"@language":"es","@value":"Hipoplasia de células de Leydig tipo 2"},{"@language":"nl","@value":"Type 2 Leydigcelhypoplasie"},{"@language":"sv","@value":"Typ 2 Leydigcellshypoplasi"}],"skos:altLabel":[{"@language":"en","@value":"Type 2 LCH"},{"@language":"sv","@value":"Type 2 Leydig cell hypoplasia"},{"@language":"sv","@value":"LCH typ 2"}],"rdfs:comment":[{"@language":"en","@value":"People with Type 2 Leydig cell hypoplasia (LCH) have some response to luteinizing hormone and produce lower-than-typical amounts of testosterone, but more than people with Type 1 LCH. At birth, their testes may be descended or undescended, and they may have a smaller-than-typical penis, often with other noticeable differences such as hypospadias. In adolescence, they will often develop some characteristics associated with a typical testosterone puberty."},{"@language":"es","@value":"Las personas con hipoplasia de células de Leydig (HCL) tipo 2 tienen cierta respuesta a la hormona luteinizante y producen cantidades de testosterona inferiores a las típicas, pero más que las personas con HCL tipo 1. Al nacer, sus testículos pueden estar descendidos o no descendidos, y pueden tener un pene más pequeño de lo típico, a menudo con otras diferencias notables, como hipospadias. En la adolescencia, a menudo desarrollarán algunas características asociadas con una pubertad típica de testosterona."},{"@language":"nl","@value":"Personen met Type 2 Leydig-celhypoplasie (LCH) reageren enigszins op het luteïniserend hormoon en produceren lager dan normale hoeveelheden testosteron, maar meer dan mensen met Type 1 LCH. Bij de geboorte kunnen hun teelballen ingedaald of niet-ingedaald zijn, en ze kunnen een penis hebben die kleiner is dan normaal, vaak met andere opvallende verschillen, zoals hypospadie. In de adolescentie zullen ze vaak enkele kenmerken ontwikkelen die verband houden met een typische testosteron-puberteit."},{"@language":"sv","@value":"Personer med typ 2 Leydigcellshypoplasi (LCH typ 2) har viss respons på luteiniserande hormon och producerar mindre testosteron än vanligt, men mer än personer med typ 1 Leydigcellshypoplasi. Det drabbar genetiskt manliga personer (46XY) som vid födseln kan ha torkism (ej nedstigna testiklar), en penis som kan vara mindre än genomsnittet och ofta andra tydliga variationer såsom hypospadi. Under puberteten utvecklar de ofta vissa könskarakteristika kopplade till en testosteronstyrd pubertet."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002863"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001269"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002880","dc:identifier":"homoit0002880","skos:prefLabel":[{"@language":"en","@value":"Type 1 Mayer-Rokitansky-Küster-Hauser syndrome"},{"@language":"es","@value":"Síndrome de Mayer-Rokitansky-Küster-Hauser tipo 1"},{"@language":"nl","@value":"Type 1 Mayer-Rokitansky-Küster-Hauser syndroom"},{"@language":"sv","@value":"MRKH typ 1"}],"skos:altLabel":[{"@language":"en","@value":"Type 1 MRKH"},{"@language":"sv","@value":"Müllersk agenesi typ 1"}],"rdfs:comment":[{"@language":"en","@value":"People with Type 1 Mayer-Rokitansky-Küster-Hauser (MRKH) syndrome typically have only the differences associated with MRKH syndrome."},{"@language":"es","@value":"Las personas con síndrome de Mayer-Rokitansky-Küster-Hauser (MRKH) tipo 1 normalmente sólo tienen las diferencias asociadas con el síndrome de MRKH."},{"@language":"nl","@value":"Personen met het type 1 Mayer-Rokitansky-Küster-Hauser (MRKH)-syndroom hebben doorgaans alleen de verschillen die verband houden met het MRKH-syndroom."},{"@language":"sv","@value":"Mayer-Rokitansky-Küster-Hauser (MRKH)-syndrom delas upp i typ 1 och typ 2 och uppstår när en persons Müllerska gångar – som normalt utvecklas till livmoder och övre delen av slidan under fosterutvecklingen – inte utvecklas på ett typiskt sätt. Personer med MRKH typ 1 har XX-kromosomer och föds vanligtvis med vulva och en kort eller helt frånvarande vagina. De saknar ofta livmoderhals och har en ofullständig livmoder (livmoderstump) eller ingen livmoder alls. De menstruerar vanligtvis inte men kan ha cyklisk smärta om de har livmoderstump med livmoderslemhinna, och kan utveckla menstruationsrelaterade tillstånd som endometrios."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002865"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001269"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002882","dc:identifier":"homoit0002882","skos:prefLabel":[{"@language":"en","@value":"Type 2 Mayer-Rokitansky-Küster-Hauser syndrome"},{"@language":"es","@value":"Síndrome de Mayer-Rokitansky-Küster-Hauser tipo 2"},{"@language":"nl","@value":"Type 2 Mayer-Rokitansky-Küster-Hauser syndroom"},{"@language":"sv","@value":"MRKH typ 2"}],"skos:altLabel":[{"@language":"en","@value":"Type 2 MRKH"},{"@language":"es","@value":"MRKHS"},{"@language":"sv","@value":"Müllersk agenesi typ 2"}],"rdfs:comment":[{"@language":"en","@value":"People with Type 2 Mayer-Rokitansky-Küster-Hauser (MRKH) syndrome have both the differences associated with MRKH syndrome and additional differences in other parts of their body, such as their fallopian tubes, kidneys, spine, or heart. A specific example of Type 2 MRKH known as Müllerian agenesis, Renal agenesis, Cervicothoracic Somite (MURCS) association, occurs when someone’s kidneys do not develop typically. They may have scoliosis or fused vertebrae in addition to the usual features of MRKH. "},{"@language":"es","@value":"Las personas con síndrome de Mayer-Rokitansky-Küster-Hauser (MRKH) tipo 2 tienen tanto las diferencias asociadas con el síndrome de MRKH como diferencias adicionales en otras partes de su cuerpo, como las trompas de Falopio, los riñones, la columna vertebral o el corazón. Un ejemplo específico de MRKH tipo 2 conocido como agenesia mülleriana, agenesia renal, asociación somita cervicotorácica (MURCS, por sus siglas en inglés), ocurre cuando los riñones de una persona no se desarrollan normalmente. Pueden tener escoliosis o vértebras fusionadas además de las características habituales de MRKH."},{"@language":"nl","@value":"Personen met het Mayer-Rokitansky-Küster-Hauser (MRKH)-syndroom type 2 hebben zowel de verschillen die verband houden met het MRKH-syndroom als aanvullende verschillen in andere delen van hun lichaam, zoals hun eileiders, nieren, wervelkolom of hart. Een specifiek voorbeeld van Type 2 MRKH, bekend als Mülleriaanse agenese, Renale agenesis, Cervicothoracale Somite (MURCS) associatie, treedt op wanneer iemands nieren zich niet normaal ontwikkelen. Zij kunnen naast de gebruikelijke kenmerken van MRKH ook scoliose of gefuseerde wervels hebben."},{"@language":"sv","@value":"Personer med typ 2 Mayer-Rokitansky-Küster-Hauser (MRKH)-syndrom har både de anatomiska variationer som är typiska för MRKH och ytterligare avvikelser i andra delar av kroppen, till exempel äggledare, njurar, ryggrad eller hjärta. Ett specifikt exempel på MRKH typ 2 är Müllerian agenesis, Renal agenesis, Cervicothoracic Somite (MURCS)-association, där njurarna inte utvecklas som förväntat. Personen kan även ha skolios eller sammanväxta ryggkotor utöver de vanliga kännetecknen vid MRKH."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002865"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001269"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002887","dc:identifier":"homoit0002887","skos:prefLabel":[{"@language":"en","@value":"Gay operas"},{"@language":"de","@value":"Schwule Opern"},{"@language":"es","@value":"Óperas gay"},{"@language":"nl","@value":"Homo-opera's"},{"@language":"sv","@value":"Bögoperor"}],"skos:altLabel":[{"@language":"de","@value":"Schwulenopern"},{"@language":"sv","@value":"Gayoperor"},{"@language":"sv","@value":"Homosexuella manliga operor"}],"rdfs:comment":[{"@language":"en","@value":"Operas created by gay directors, depicting gay men, or that are regarded as important within gay culture."},{"@language":"de","@value":"Opern, die von schwulen Regisseuren geschaffen wurden, schwule Männer darstellen oder innerhalb der schwulen Kultur als wichtig angesehen werden."},{"@language":"es","@value":"Óperas creadas por directores gay, que representan a hombres gay o a personas consideradas importantes dentro de la cultura gay."},{"@language":"nl","@value":"Opera's gemaakt door homoregisseurs, waarin homomannen worden afgebeeld, of die binnen de homocultuur als belangrijk worden beschouwd."},{"@language":"sv","@value":"Operor skapade av homosexuella manliga regissörer, som skildrar bögar eller som betraktas som viktiga inom bögkultur."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002886"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002888","dc:identifier":"homoit0002888","skos:prefLabel":[{"@language":"en","@value":"Bisexual operas"},{"@language":"de","@value":"Bisexuelle Opern"},{"@language":"es","@value":"Óperas bisexuales"},{"@language":"nl","@value":"Biseksuele opera's"},{"@language":"sv","@value":"Bisexuella operor"}],"rdfs:comment":[{"@language":"en","@value":"Operas created by bisexual directors, depicting bisexual individuals, or that are regarded as important within bisexual culture."},{"@language":"de","@value":"Opern, die von bisexuellen Regisseur:innen geschaffen wurden, bisexuelle Personen darstellen oder die in der bisexuellen Kultur als wichtig angesehen werden."},{"@language":"es","@value":"Óperas creadas por directores bisexuales, que representan a personas bisexuales o a personas consideradas importantes dentro de la cultura bisexual."},{"@language":"nl","@value":"Opera's gemaakt door biseksuele regisseurs, waarin biseksuele personen worden afgebeeld, of die als belangrijk worden beschouwd binnen de biseksuele cultuur."},{"@language":"sv","@value":"Operor skapade av bisexuella regissörer, som skildrar bisexuella personer eller som anses vara viktiga inom bisexuell kultur."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002886"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002889","dc:identifier":"homoit0002889","skos:prefLabel":[{"@language":"en","@value":"Transgender operas"},{"@language":"es","@value":"Óperas transgénero"},{"@language":"nl","@value":"Transgender opera's"},{"@language":"sv","@value":"Transopera"}],"skos:altLabel":{"@language":"sv","@value":"Operor om transpersoner och transteman"},"rdfs:comment":[{"@language":"en","@value":"Operas created by transgender directors, depicting transgender individuals, or that are regarded as important within transgender culture."},{"@language":"es","@value":"Óperas creadas por directores transgénero, que representan a personas transgénero o que se consideran importantes dentro de la cultura transgénero."},{"@language":"nl","@value":"Opera's gemaakt door transgenderregisseurs, waarin transgenderpersonen worden afgebeeld, of die als belangrijk worden beschouwd binnen de transgendercultuur."},{"@language":"sv","@value":"Operor skapade av transregissörer, som skildrar transpersoner eller som betraktas som betydelsefulla inom transkulturen."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002886"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0003168"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002890","dc:identifier":"homoit0002890","skos:prefLabel":[{"@language":"en","@value":"Asexual operas"},{"@language":"es","@value":"Óperas asexuales"},{"@language":"de","@value":"Asexuelle Opern"},{"@language":"nl","@value":"Aseksuele opera's"},{"@language":"sv","@value":"Asexuella operor"}],"skos:altLabel":[{"@language":"de","@value":"Ace Opern"},{"@language":"sv","@value":"Ace-operor"}],"rdfs:comment":[{"@language":"en","@value":"Operas created by asexual directors, depicting asexual individuals, or that are regarded as important within asexual culture."},{"@language":"es","@value":"Óperas creadas por directores asexuales, que representan a personas asexuales, o que se consideran importantes dentro de la cultura asexual."},{"@language":"de","@value":"Opern, die von asexuellen Regisseur:innen geschaffen wurden, asexuelle Personen darstellen oder die in der asexuellen Kultur als wichtig angesehen werden."},{"@language":"nl","@value":"Opera's gemaakt door aseksuele regisseurs, waarin aseksuele personen worden afgebeeld, of die als belangrijk worden beschouwd binnen de aseksuele cultuur."},{"@language":"sv","@value":"Operor skapade av asexuella regissörer, som skildrar asexuella personer eller som anses vara viktiga inom asexuell kultur."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002886"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002891","dc:identifier":"homoit0002891","skos:prefLabel":[{"@language":"en","@value":"Intersex operas"},{"@language":"de","@value":"Inter* Opern"},{"@language":"es","@value":"Óperas intersexuales"},{"@language":"nl","@value":"Intersekse opera's"},{"@language":"sv","@value":"Intersexoperor"}],"skos:altLabel":{"@language":"es","@value":"Óperas intersex"},"rdfs:comment":[{"@language":"en","@value":"Operas created by intersex directors, depicting intersex individuals, or that are regarded as important within intersex culture."},{"@language":"de","@value":"Opern, die von inter* Regisseur:innen geschaffen wurden, inter* Personen darstellen oder die in der inter* Kultur als wichtig angesehen werden."},{"@language":"es","@value":"Óperas creadas por directores intersex, que representan a personas intersex o que se consideran importantes dentro de la cultura intersex."},{"@language":"nl","@value":"Opera's gemaakt door intersekse regisseurs, waarin intersekse personen worden afgebeeld, of die als belangrijk worden beschouwd binnen de intersekse cultuur."},{"@language":"sv","@value":"Operor skapade av intersexregissörer, som skildrar intersexpersoner eller som betraktas som viktiga inom intersexkulturen."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002886"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0003168"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003167","dc:identifier":"homoit0003167","skos:prefLabel":[{"@language":"en","@value":"Queer operas"},{"@language":"es","@value":"Óperas queer"},{"@language":"nl","@value":"Queer opera's"},{"@language":"sv","@value":"Queera operor"}],"rdfs:comment":[{"@language":"en","@value":"Operas created by queer directors, depicting queer individuals, or that are regarded as important within queer culture."},{"@language":"es","@value":"Óperas creadas por directores queer, que representan a personas queer, o personas consideradas importantes dentro de la cultura queer."},{"@language":"nl","@value":"Opera's gemaakt door queer regisseurs, waarin queer personen worden afgebeeld, of die als belangrijk worden beschouwd binnen de queer cultuur."},{"@language":"sv","@value":"Operor skapade av queera regissörer, som skildrar queera personer eller som anses viktiga inom queer kultur."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002886"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0003168"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2024-01-09"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003168","dc:identifier":"homoit0003168","skos:prefLabel":[{"@language":"en","@value":"Two-Spirit operas"},{"@language":"es","@value":"Óperas dos espíritus"},{"@language":"nl","@value":"Two-Spirit opera's"},{"@language":"sv","@value":"Two-spirit-operor"}],"skos:altLabel":[{"@language":"en","@value":"2S operas"},{"@language":"en","@value":"Two Spirit operas"},{"@language":"en","@value":"Two Spirited operas"},{"@language":"en","@value":"Two-Spirited operas"}],"rdfs:comment":[{"@language":"en","@value":"Operas created by Two-Spirit directors, depicting Two-Spirit individuals, or that are regarded as important within Two-Spirit culture."},{"@language":"es","@value":"Óperas creadas por directores dos espíritus, que representan a personas dos espíritus, o que se consideran importantes dentro de la cultura dos espíritus."},{"@language":"nl","@value":"Opera's gemaakt door Two-Spirit-regisseurs, waarin Two-Spirit-individuen worden afgebeeld, of die als belangrijk worden beschouwd binnen de Two-Spirit-cultuur. ​"},{"@language":"sv","@value":"Operor skapade av Two-spirit-regissörer, som skildrar Two-spirit-personer eller som betraktas som betydelsefulla inom Two-spirit-kulturen."}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0002886"},{"@id":"https://homosaurus.org/v5/homoit0002889"},{"@id":"https://homosaurus.org/v5/homoit0002891"},{"@id":"https://homosaurus.org/v5/homoit0003167"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0003168"},"dc:issued":{"@type":"xsd:date","@value":"2024-01-09"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002917","dc:identifier":"homoit0002917","skos:prefLabel":[{"@language":"en","@value":"Intersex museums"},{"@language":"de","@value":"Inter* Museen"},{"@language":"es","@value":"Museos intersexuales"},{"@language":"nl","@value":"Intersekse musea"},{"@language":"sv","@value":"Intersexmuseum"}],"skos:altLabel":{"@language":"es","@value":"Museos intersex"},"rdfs:comment":[{"@language":"en","@value":"Institutions dedicated to the storage, exhibition, conservation, and preservation of materials relating to intersex people and intersex history."},{"@language":"de","@value":"Einrichtungen, die sich der Aufbewahrung, Ausstellung, Konservierung und Erhaltung von Materialien über inter* Menschen und inter* Geschichte widmen."},{"@language":"es","@value":"Instituciones dedicadas al almacenamiento, la exhibición, la conservación y la preservación de materiales relacionados con las personas intersex y la historia intersex."},{"@language":"nl","@value":"Instellingen die zich bezighouden met de opslag, tentoonstellen, conservering en behoud van materiaal met betrekking tot intersekse personen en intersekse geschiedenis."},{"@language":"sv","@value":"Institutioner som ägnar sig åt insamling, utställning, bevarande och konservering av material som rör intersexpersoner eller intersexpersoners historia."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000907"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001755"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-30"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002930","dc:identifier":"homoit0002930","skos:prefLabel":[{"@language":"en","@value":"Intersex Deaf people"},{"@language":"es","@value":"Personas intersexuales sordas"},{"@language":"nl","@value":"Dove intersekse personen"},{"@language":"sv","@value":"Döva intersexpersoner"}],"skos:altLabel":[{"@language":"en","@value":"Deaf intersex people"},{"@language":"es","@value":"Personas sordas intersex"},{"@language":"es","@value":"Personas intersex sordas"}],"rdfs:comment":[{"@language":"en","@value":"Intersex people with significant or total hearing loss. Some but not all Deaf people prefer to capitalize Deaf in recognition of the cultural and linguistic identity they share with other Deaf people."},{"@language":"es","@value":"Personas intersex con pérdida auditiva significativa o total. Algunas personas sordas, pero no todas, prefieren escribir “Sorda/o” con mayúscula en reconocimiento de la identidad cultural y lingüística que comparten con otras personas sordas."},{"@language":"nl","@value":"Intersekse personen met aanzienlijk of totaal gehoorverlies. Sommige, maar niet alle, Dove personen geven er de voorkeur aan om Dove met een hoofdletter te schrijven, als erkenning van de culturele en taalkundige identiteit die zij delen met andere Dove personen."},{"@language":"sv","@value":"Intersexpersoner med betydande eller total hörselförlust."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000337"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000337"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-30"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004629","dc:identifier":"homoit0004629","skos:prefLabel":{"@language":"en","@value":"Intersex personals"},"skos:altLabel":[{"@language":"en","@value":"Intersex personal ads"},{"@language":"en","@value":"Intersex personal advertisements"}],"rdfs:comment":{"@language":"en","@value":"A form of classified advertising for intersex people interested in seeking connections around sex, romance, and/or community. The content of these ads focus largely on the type of arrangement sought and details or criteria about the writer and the type of person they are looking for (e.g. personality traits, physical looks, etc.). While intersex personals are most commonly thought of as existing in print media, they also have existed online in spaces such as Craigslist."},"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0004621"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0002939"},{"@id":"https://homosaurus.org/v5/homoit0002936"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0004621"},"dc:issued":{"@type":"xsd:date","@value":"2026-06-09"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-09"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003001","dc:identifier":"homoit0003001","skos:prefLabel":[{"@language":"en","@value":"Demisexual neurodivergent people"},{"@language":"es","@value":"Personas demisexuales neurodivergentes"},{"@language":"de","@value":"Demisexuelle neurodivergente Personen"},{"@language":"nl","@value":"Demiseksuele neurodivergente personen"},{"@language":"sv","@value":"Demisexuella neurodivergenta personer"}],"skos:altLabel":[{"@language":"en","@value":"Neurodivergent demisexual people"},{"@language":"es","@value":"Personas neurodivergentes demisexuales"},{"@language":"de","@value":"Neurodivergente demisexuelle Personen"}],"rdfs:comment":[{"@language":"en","@value":"Demisexual people whose brains process, learn, and/or behave differently from what is considered typical by society. Some of these neurological differences can present as learning disabilities, medical disorders, and other conditions."},{"@language":"es","@value":"Personas demisexuales cuyos cerebros procesan, aprenden y/o se comportan de manera diferente a lo que la sociedad considera típico. Algunas de estas diferencias neurológicas pueden presentarse como problemas de aprendizaje, trastornos médicos y otras condiciones."},{"@language":"de","@value":"Demisexuelle Menschen, deren Gehirn anders verarbeitet, lernt und/oder sich anders verhält als gesellschaftlich üblich. Einige dieser neurologischen Unterschiede können sich in Lernschwierigkeiten, medizinischen Störungen und anderen Erkrankungen äussern."},{"@language":"nl","@value":"Demiseksuele personen die verschillen van de norm op het gebied van cognitie, zintuiglijke verwerking, emotionaliteit en sociale vaardigheden. Voor sommigen kunnen deze lichamelijke verschillen zich uiten als beperkingen en/of medische aandoeningen; voor anderen zijn deze verschillen simpelweg eigenschappen die deel uitmaken van hun identiteit."},{"@language":"sv","@value":"Demisexuella personer vars kognition, sensoriska bearbetning, emotionalitet eller sociala förmåga skiljer sig från normen. Dessa variationer kan för vissa innebära funktionsnedsättningar eller medicinska tillstånd, medan de för andra är egenskaper som ingår i deras identitet."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002993"},"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0002997"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-10-27"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003007","dc:identifier":"homoit0003007","skos:prefLabel":[{"@language":"en","@value":"Demisexual blind people"},{"@language":"es","@value":"Personas demisexuales ciegas"},{"@language":"de","@value":"Demisexuelle blinde Personen"},{"@language":"nl","@value":"Blinde demiseksuele personen"},{"@language":"sv","@value":"Demisexuella blinda personer; Blinda Demisexuella"}],"skos:altLabel":[{"@language":"en","@value":"Blind demisexual people"},{"@language":"es","@value":"Personas ciegas demisexuales"},{"@language":"es","@value":"Ciegos demisexuales"},{"@language":"es","@value":"Ciegas demisexuales"},{"@language":"de","@value":"Blinde demisexuelle Personen"}],"rdfs:comment":[{"@language":"en","@value":"Demisexual people with significant or total loss of vision."},{"@language":"es","@value":"Personas demisexuales con pérdida significativa o total de la visión."},{"@language":"de","@value":"Demisexuelle Personen mit erheblichem oder vollständigem Sehverlust."},{"@language":"nl","@value":"Demiseksuele personen met een aanzienlijk of totaal verlies van gezichtsvermogen."},{"@language":"sv","@value":"Demisexuella personer med betydande eller total synnedsättning."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002993"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-10-27"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003012","dc:identifier":"homoit0003012","skos:prefLabel":[{"@language":"en","@value":"Demisexual hard of hearing people"},{"@language":"es","@value":"Personas demisexuales con problemas de audición"},{"@language":"nl","@value":"Hardhorende demiseksuele personen"},{"@language":"sv","@value":"Demisexuella hörselskadade personer"}],"skos:altLabel":[{"@language":"en","@value":"Demisexual HoH people"},{"@language":"en","@value":"Demisexual hearing impaired people"},{"@language":"en","@value":"Hearing impaired demisexual people"},{"@language":"en","@value":"HoH Demisexual people"},{"@language":"es","@value":"Personas demisexuales con dificultades de audición"},{"@language":"es","@value":"Personas demisexuales con dificultades auditivas"},{"@language":"nl","@value":"Demiseksuele slechthorende personen"},{"@language":"nl","@value":"Slechthorende demiseksuele personen"}],"rdfs:comment":[{"@language":"en","@value":"Demisexual people with significant or total hearing loss who may or may not consider themselves d/Deaf."},{"@language":"es","@value":"Personas demisexuales con pérdida auditiva significativa o total que pueden considerarse o no S/sordas."},{"@language":"nl","@value":"Demiseksuele personen met aanzienlijk of totaal gehoorverlies die zichzelf al dan niet als doof beschouwen"},{"@language":"sv","@value":"Demisexuella personer med betydande eller total hörselförlust."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002993"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0003017"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-10-27"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003017","dc:identifier":"homoit0003017","skos:prefLabel":[{"@language":"en","@value":"Demisexual Deaf people"},{"@language":"es","@value":"Personas demisexuales sordas"},{"@language":"de","@value":"Demisexuelle gehörlose Personen"},{"@language":"nl","@value":"Dove demiseksuele personen"},{"@language":"sv","@value":"Demisexuella döva"}],"skos:altLabel":[{"@language":"en","@value":"Deaf demisexual people"},{"@language":"es","@value":"Personas sordas demisexuales"},{"@language":"de","@value":"Gehörlose demisexuelle Personen"},{"@language":"de","@value":"Taube demisexuelle Personen"},{"@language":"de","@value":"Demisexuelle Taube Personen"}],"rdfs:comment":[{"@language":"en","@value":"Demisexual people with significant or total hearing loss. Some but not all Deaf people prefer to capitalize Deaf in recognition of the cultural and linguistic identity they share with other Deaf people."},{"@language":"es","@value":"Personas demisexuales con pérdida auditiva significativa o total. Algunas personas sordas, pero no todas, prefieren escribir “Sorda/o” con mayúscula  en reconocimiento de la identidad cultural y lingüística que comparten con otras personas sordas."},{"@language":"de","@value":"Demisexuelle Menschen mit signifikantem oder vollständigem Hörverlust, die sich als gehörlos/nicht gehörlos, taub/nicht taub oder Deaf/nicht Deaf betrachten können."},{"@language":"nl","@value":"Demiseksuele personen met aanzienlijk of totaal gehoorverlies."},{"@language":"sv","@value":"Demisexuella personer med betydande eller total hörselförlust."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002993"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0003012"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-10-27"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003028","dc:identifier":"homoit0003028","skos:prefLabel":[{"@language":"en","@value":"Demisexual wheelchair users"},{"@language":"es","@value":"Usuarios demisexuales de sillas de ruedas"},{"@language":"de","@value":"Demisexuelle Rollstuhlfahrer:innen"},{"@language":"nl","@value":"Demiseksuele rolstoelgebruikers"},{"@language":"sv","@value":"Rullstolsburna demisexuella personer"}],"rdfs:comment":[{"@language":"en","@value":"Demisexual people who use wheelchairs."},{"@language":"es","@value":"Personas demisexuales que utilizan sillas de ruedas."},{"@language":"de","@value":"Demisexuelle Personen, die einen Rollstuhl nutzen."},{"@language":"nl","@value":"Demiseksuele personen die een rolstoel gebruiken."},{"@language":"sv","@value":"Demisexuella personer som använder rullstol."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002993"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-10-27"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003022","dc:identifier":"homoit0003022","skos:prefLabel":[{"@language":"en","@value":"Demisexual people with chronic illnesses"},{"@language":"es","@value":"Personas demisexuales con enfermedades crónicas"},{"@language":"de","@value":"Demisexuelle Personen mit chronischen Krankheiten"},{"@language":"nl","@value":"Demiseksuele personen met chronische ziekten"},{"@language":"sv","@value":"Demisexuella personer med kronisk sjukdom"}],"skos:altLabel":[{"@language":"en","@value":"Chronically ill demisexual people"},{"@language":"es","@value":"Personas con enfermedades crónicas demisexuales"},{"@language":"es","@value":"Enfermos crónicos demisexuales"},{"@language":"es","@value":"Enfermas crónicas demisexuales"},{"@language":"de","@value":"Chronisch kranke demisexuelle Personen"},{"@language":"sv","@value":"Kroniskt sjuka demisexuella personer"}],"rdfs:comment":[{"@language":"en","@value":"Demisexual people who have long-term health conditions that require continued medical attention and/or significantly impact or limit daily life; some but not all people with chronic illnesses consider themselves disabled."},{"@language":"es","@value":"Personas demisexuales que tienen condiciones de salud a largo plazo que requieren atención médica continua y/o que impactan o limitan significativamente la vida diaria; algunas, pero no todas, las personas con enfermedades crónicas se consideran discapacitadas."},{"@language":"de","@value":"Demisexuelle Menschen mit langfristigen gesundheitlichen Problemen, die eine kontinuierliche medizinische Betreuung erfordern und/oder das tägliche Leben erheblich beeinträchtigen oder einschränken; einige, aber nicht alle Menschen mit chronischen Krankheiten betrachten sich als behindert."},{"@language":"nl","@value":"Demiseksuele personen met langdurige gezondheidsproblemen die voortdurende medische aandacht vereisen en/of het dagelijks leven aanzienlijk beïnvloeden of beperken; sommige, maar niet alle personen met chronische ziekten beschouwen zichzelf als gehandicapt"},{"@language":"sv","@value":"Demisexuella personer med långvariga hälsotillstånd som kräver kontinuerlig medicinsk behandling och/eller har en betydande påverkan på eller begränsar det dagliga livet. Vissa, men inte alla, personer med kroniska sjukdomar identifierar sig som personer med funktionsnedsättning."}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0002993"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0003022"},"dc:issued":{"@type":"xsd:date","@value":"2023-10-27"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003002","dc:identifier":"homoit0003002","skos:prefLabel":[{"@language":"en","@value":"Megasexual neurodivergent people"},{"@language":"es","@value":"Personas megasexuales neurodivergentes"},{"@language":"nl","@value":"Megaseksuele neurodivergente personen"},{"@language":"sv","@value":"Megasexuella neurodivergenta personer"}],"skos:altLabel":[{"@language":"en","@value":"Neurodivergent megasexual people"},{"@language":"es","@value":"Personas neurodivergentes megasexuales"}],"rdfs:comment":[{"@language":"en","@value":"Megasexual people whose brains process, learn, and/or behave differently from what is considered typical by society. Some of these neurological differences can present as learning disabilities, medical disorders, and other conditions."},{"@language":"es","@value":"Personas megasexuales cuyos cerebros procesan, aprenden y/o se comportan de manera diferente a lo que la sociedad considera típico. Algunas de estas diferencias neurológicas pueden presentarse como problemas de aprendizaje, trastornos médicos y otras condiciones."},{"@language":"nl","@value":"Megaseksuele personen die verschillen van de norm op het gebied van cognitie, zintuiglijke verwerking, emotionaliteit en sociale vaardigheden. Voor sommigen kunnen deze lichamelijke verschillen zich uiten als beperkingen en/of medische aandoeningen; voor anderen zijn deze verschillen simpelweg eigenschappen die deel uitmaken van hun identiteit."},{"@language":"sv","@value":"Megasexuella personer vars kognition, sensoriska bearbetning, emotionalitet eller sociala förmåga skiljer sig från normen. Dessa variationer kan för vissa innebära funktionsnedsättningar eller medicinska tillstånd, medan de för andra är egenskaper som ingår i deras identitet."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002994"},"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0002998"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-10-27"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003008","dc:identifier":"homoit0003008","skos:prefLabel":[{"@language":"en","@value":"Megasexual blind people"},{"@language":"es","@value":"Personas megasexuales ciegas"},{"@language":"nl","@value":"Blinde megaseksuele personen"},{"@language":"sv","@value":"Blinda megasexuella"}],"skos:altLabel":[{"@language":"en","@value":"Blind megasexual people"},{"@language":"es","@value":"Personas ciegas megasexuales"}],"rdfs:comment":[{"@language":"en","@value":"Megasexual people with significant or total loss of vision."},{"@language":"es","@value":"Personas megasexuales con pérdida significativa o total de la visión."},{"@language":"nl","@value":"Megaseksuele personen met een aanzienlijk of totaal verlies van gezichtsvermogen."},{"@language":"sv","@value":"Megasexuella personer med betydande eller total synnedsättning."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002994"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-10-27"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003013","dc:identifier":"homoit0003013","skos:prefLabel":[{"@language":"en","@value":"Megasexual hard of hearing people"},{"@language":"es","@value":"Personas megasexuales con problemas de audición"},{"@language":"nl","@value":"Hardhorende megaseksuele personen"},{"@language":"sv","@value":"Megasexuella hörselskadade personer"}],"skos:altLabel":[{"@language":"en","@value":"Hearing impaired megasexual people"},{"@language":"en","@value":"HoH Megasexual people"},{"@language":"en","@value":"Megasexual HoH people"},{"@language":"en","@value":"Megasexual hearing impaired people"},{"@language":"es","@value":"Personas megasexuales con dificultades de audición"},{"@language":"es","@value":"Personas megasexuales con dificultades auditivas"},{"@language":"nl","@value":"Megaseksuele slechthorenden"},{"@language":"nl","@value":"Slechthorende megaseksuele personen"}],"rdfs:comment":[{"@language":"en","@value":"Megasexual people with significant or total hearing loss who may or may not consider themselves d/Deaf."},{"@language":"es","@value":"Personas megasexuales con pérdida auditiva significativa o total, que pueden o no considerarse S/sordas."},{"@language":"nl","@value":"M"},{"@language":"sv","@value":"Megasexuella personer med betydande eller total hörselförlust."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002994"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0003018"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-10-27"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003018","dc:identifier":"homoit0003018","skos:prefLabel":[{"@language":"en","@value":"Megasexual Deaf people"},{"@language":"es","@value":"Personas megasexuales sordas"},{"@language":"de","@value":"Gehörlose megasexuelle Personen"},{"@language":"nl","@value":"Dove megaseksuele personen"},{"@language":"sv","@value":"Döva megasexuella"}],"skos:altLabel":[{"@language":"en","@value":"Deaf megasexual people"},{"@language":"es","@value":"Personas sordas megasexuales"},{"@language":"de","@value":"Megasexuelle Taube Personen"},{"@language":"de","@value":"Taube megasexuelle Personen"}],"rdfs:comment":[{"@language":"en","@value":"Megasexual people with significant or total hearing loss who may or may not consider themselves d/Deaf."},{"@language":"es","@value":"Personas megasexuales con pérdida auditiva significativa o total. Algunas personas sordas, pero no todas, prefieren escribir “Sorda/o” con mayúscula  en reconocimiento de la identidad cultural y lingüística que comparten con otras personas sordas."},{"@language":"de","@value":"Megasexuelle Personen mit signifikantem oder vollständigem Hörverlust, die sich als gehörlos/nicht gehörlos, taub/nicht taub oder Deaf/nicht Deaf betrachten können."},{"@language":"nl","@value":"Megaseksuele personen met aanzienlijk of totaal gehoorverlies."},{"@language":"sv","@value":"Megasexuella personer med betydande eller total hörselförlust."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002994"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0003013"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-10-27"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003029","dc:identifier":"homoit0003029","skos:prefLabel":[{"@language":"en","@value":"Megasexual wheelchair users"},{"@language":"es","@value":"Usuarios megasexuales de sillas de ruedas"},{"@language":"nl","@value":"Megaseksuele rolstoelgebruikers"},{"@language":"sv","@value":"Rullstolsburna megasexuella personer"}],"rdfs:comment":[{"@language":"en","@value":"Megasexual people who use wheelchairs."},{"@language":"es","@value":"Personas megasexuales que utilizan sillas de ruedas."},{"@language":"nl","@value":"Megaseksuele personen die een rolstoel gebruiken"},{"@language":"sv","@value":"Megasexuella personer som använder rullstol."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002994"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-10-27"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003023","dc:identifier":"homoit0003023","skos:prefLabel":[{"@language":"en","@value":"Megasexual people with chronic illnesses"},{"@language":"es","@value":"Personas megasexuales con enfermedades crónicas"},{"@language":"nl","@value":"Megaseksuele personen met chronische ziekten"},{"@language":"sv","@value":"Megasexuella personer med kronisk sjukdom"}],"skos:altLabel":[{"@language":"en","@value":"Chronically ill megasexual people"},{"@language":"es","@value":"Personas con enfermedades crónicas megasexuales"},{"@language":"es","@value":"Enfermos crónicos megasexuales"},{"@language":"sv","@value":"Kroniskt sjuka megasexuella personer"}],"rdfs:comment":[{"@language":"en","@value":"Megasexual people who have long-term health conditions that require continued medical attention and/or significantly impact or limit daily life; some but not all people with chronic illnesses consider themselves disabled."},{"@language":"es","@value":"Personas megasexuales que tienen condiciones de salud a largo plazo que requieren atención médica continua y/o impactan o limitan significativamente la vida diaria; algunas, pero no todas, las personas con enfermedades crónicas se consideran discapacitadas."},{"@language":"nl","@value":"Megaseksuele personen met langdurige gezondheidsproblemen die voortdurende medische aandacht vereisen en/of het dagelijks leven aanzienlijk beïnvloeden of beperken; sommige, maar niet alle personen met chronische ziekten beschouwen zichzelf als gehandicapt"},{"@language":"sv","@value":"Megasexuella personer med långvariga hälsotillstånd som kräver kontinuerlig medicinsk behandling och/eller har en betydande påverkan på eller begränsar det dagliga livet. Vissa, men inte alla, personer med kroniska sjukdomar identifierar sig som personer med funktionsnedsättning."}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0002994"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0003023"},"dc:issued":{"@type":"xsd:date","@value":"2023-10-27"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003003","dc:identifier":"homoit0003003","skos:prefLabel":[{"@language":"en","@value":"Aromantic neurodivergent people"},{"@language":"es","@value":"Personas arrománticas neurodivergentes"},{"@language":"de","@value":"Aromantische neurodivergente Personen"},{"@language":"nl","@value":"Aromantische neurodivergente personen"},{"@language":"sv","@value":"Aromantiska neurodivergenta personer"}],"skos:altLabel":[{"@language":"en","@value":"Neurodivergent aromantic people"},{"@language":"es","@value":"Personas neurodivergentes arrománticas"},{"@language":"de","@value":"Neurodivergente aromantische Personen"}],"rdfs:comment":[{"@language":"en","@value":"Aromantic people whose brains process, learn, and/or behave differently from what is considered typical by society. Some of these neurological differences can present as learning disabilities, medical disorders, and other conditions."},{"@language":"es","@value":"Personas arrománticas cuyos cerebros procesan, aprenden y/o se comportan de manera diferente a lo que la sociedad considera típico. Algunas de estas diferencias neurológicas pueden presentarse como problemas de aprendizaje, trastornos médicos y otras condiciones."},{"@language":"de","@value":"Aromantische Menschen, deren Gehirn anders verarbeitet, lernt und/oder sich anders verhält als gesellschaftlich üblich. Einige dieser neurologischen Unterschiede können sich in Lernschwierigkeiten, medizinischen Störungen und anderen Erkrankungen äussern."},{"@language":"nl","@value":"Aromantische personen die verschillen van de norm op het gebied van cognitie, zintuiglijke verwerking, emotionaliteit en sociale vaardigheden. Voor sommigen kunnen deze lichamelijke verschillen zich uiten als beperkingen en/of medische aandoeningen; voor anderen zijn deze verschillen simpelweg eigenschappen die deel uitmaken van hun identiteit."},{"@language":"sv","@value":"Aromantiska personer vars kognition, sensoriska bearbetning, emotionalitet eller sociala förmåga skiljer sig från normen. Dessa variationer kan för vissa innebära funktionsnedsättningar eller medicinska tillstånd, medan de för andra är egenskaper som ingår i deras identitet."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002995"},"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0002999"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-10-27"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003009","dc:identifier":"homoit0003009","skos:prefLabel":[{"@language":"en","@value":"Aromantic blind people"},{"@language":"es","@value":"Personas arrománticas ciegas"},{"@language":"de","@value":"Aromantische blinde Personen"},{"@language":"nl","@value":"Blinde aromantische personen"},{"@language":"sv","@value":"Blinda aromantiska"}],"skos:altLabel":[{"@language":"en","@value":"Blind aromantic people"},{"@language":"es","@value":"Personas ciegas arrománticas"},{"@language":"de","@value":"Blinde aromantische Personen"}],"rdfs:comment":[{"@language":"en","@value":"Aromantic people with significant or total loss of vision."},{"@language":"es","@value":"Personas aromáticas con pérdida significativa o total de la visión."},{"@language":"de","@value":"Aromantische Personen mit erheblichem oder vollständigem Sehverlust."},{"@language":"nl","@value":"Aromantische personen met een aanzienlijk of totaal verlies van gezichtsvermogen"},{"@language":"sv","@value":"Aromantiska personer med betydande eller total synnedsättning."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002995"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-10-27"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003014","dc:identifier":"homoit0003014","skos:prefLabel":[{"@language":"en","@value":"Aromantic hard of hearing people"},{"@language":"es","@value":"Personas arrománticas con problemas de audición"},{"@language":"nl","@value":"Hardhorende aromantische personen"},{"@language":"sv","@value":"Aromantiska hörselskadade personer"}],"skos:altLabel":[{"@language":"en","@value":"Aromantic HoH people"},{"@language":"en","@value":"Aromantic hearing impaired people"},{"@language":"en","@value":"Hearing impaired aromantic people"},{"@language":"en","@value":"HoH Aromantic people"},{"@language":"es","@value":"Personas arrománticas con dificultades de audición"},{"@language":"es","@value":"Personas arrománticas con dificultades auditivas"},{"@language":"nl","@value":"Aromantische slechthorende personen"},{"@language":"nl","@value":"Slechthorende Aromantische personen"}],"rdfs:comment":[{"@language":"en","@value":"Aromantic people who are hard of hearing."},{"@language":"es","@value":"Personas arrománticas con problemas de audición, que pueden o no considerarse S/sordas."},{"@language":"nl","@value":"Aromantische personen die hardhorend zijn."},{"@language":"sv","@value":"Aromantiska personer med betydande eller total hörselförlust."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002995"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0003019"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-10-27"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003019","dc:identifier":"homoit0003019","skos:prefLabel":[{"@language":"en","@value":"Aromantic Deaf people"},{"@language":"es","@value":"Personas arrománticas sordas"},{"@language":"de","@value":"Aromantische gehörlöse Personen"},{"@language":"nl","@value":"Dove aromantische personen"},{"@language":"sv","@value":"Aromantiska döva"}],"skos:altLabel":[{"@language":"en","@value":"Deaf aromantic people"},{"@language":"es","@value":"Personas sordas arrománticas"},{"@language":"de","@value":"Gehörlose aromantische Personen"},{"@language":"de","@value":"Taube aromantische PersonenAromantische"},{"@language":"de","@value":"Taube Personen"}],"rdfs:comment":[{"@language":"en","@value":"Aromantic people with significant or total hearing loss. Some but not all Deaf people prefer to capitalize Deaf in recognition of the cultural and linguistic identity they share with other Deaf people."},{"@language":"es","@value":"Personas arrománticas con pérdida auditiva significativa o total. Algunas personas sordas, pero no todas, prefieren escribir “Sorda/o” con mayúscula  en reconocimiento de la identidad cultural y lingüística que comparten con otras personas sordas."},{"@language":"de","@value":"Aromantische Personen mit signifikantem oder vollständigem Hörverlust, die sich als gehörlos/nicht gehörlos, taub/nicht taub oder Deaf/nicht Deaf betrachten können."},{"@language":"nl","@value":"Aromantische personen met aanzienlijk of totaal gehoorverlies."},{"@language":"sv","@value":"Aromantiska personer med betydande eller total hörselförlust."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002995"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0003014"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-10-27"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003030","dc:identifier":"homoit0003030","skos:prefLabel":[{"@language":"en","@value":"Aromantic wheelchair users"},{"@language":"es","@value":"Usuarios arrománticos de sillas de ruedas"},{"@language":"de","@value":"Aromantische Rollstuhlfahrer:innen"},{"@language":"nl","@value":"Aromantische rolstoelgebruikers"},{"@language":"sv","@value":"Rullstolsburna aromantiska personer"}],"rdfs:comment":[{"@language":"en","@value":"Aromantic people who use wheelchairs."},{"@language":"es","@value":"Personas arrománticas que utilizan sillas de ruedas."},{"@language":"de","@value":"Aromantische Menschen, die einen Rollstuhl nutzen."},{"@language":"nl","@value":"Aromantische personen die een rolstoel gebruiken"},{"@language":"sv","@value":"Aromantiska personer som använder rullstol."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002995"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-10-27"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003024","dc:identifier":"homoit0003024","skos:prefLabel":[{"@language":"en","@value":"Aromantic people with chronic illnesses"},{"@language":"de","@value":"Aromantische Personen mit chronischen Krankheiten"},{"@language":"es","@value":"Personas arrománticas con enfermedades crónicas"},{"@language":"nl","@value":"Aromantische personen met chronische ziekten"},{"@language":"sv","@value":"Aromantiska personer med kronisk sjukdom"}],"skos:altLabel":[{"@language":"en","@value":"Chronically ill aromantic people"},{"@language":"de","@value":"Chronisch kranke aromantische Personen"},{"@language":"es","@value":"Personas con enfermedades crónicas arrománticas"},{"@language":"es","@value":"Enfermos crónicos arrománticos"},{"@language":"es","@value":"Enfermas crónicas arrománticas"},{"@language":"sv","@value":"Kroniskt sjuka aromantiska personer"}],"rdfs:comment":[{"@language":"en","@value":"Aromantic people who have long-term health conditions that require continued medical attention and/or significantly impact or limit daily life; some but not all people with chronic illnesses consider themselves disabled."},{"@language":"de","@value":"Aromantische Menschen mit langfristigen gesundheitlichen Problemen, die eine kontinuierliche medizinische Betreuung erfordern und/oder das tägliche Leben erheblich beeinträchtigen oder einschränken; einige, aber nicht alle Menschen mit chronischen Krankheiten betrachten sich als behindert."},{"@language":"es","@value":"Personas arrománticas que tienen condiciones de salud a largo plazo que requieren atención médica continua y/o que impactan o limitan significativamente sus vidas diarias. Algunas, pero no todas, las personas con enfermedades crónicas se consideran discapacitadas."},{"@language":"nl","@value":"Aromantische personen met langdurige gezondheidsproblemen die voortdurende medische aandacht vereisen en/of een significante impact hebben op het dagelijks leven of deze beperken; sommige, maar niet alle personen met chronische ziekten beschouwen zichzelf als gehandicapt"},{"@language":"sv","@value":"Aromantiska personer med långvariga hälsotillstånd som kräver kontinuerlig medicinsk behandling och/eller har en betydande påverkan på eller begränsar det dagliga livet. Vissa, men inte alla, personer med kroniska sjukdomar identifierar sig som personer med funktionsnedsättning."}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0002995"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0003024"},"dc:issued":{"@type":"xsd:date","@value":"2023-10-27"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003004","dc:identifier":"homoit0003004","skos:prefLabel":[{"@language":"en","@value":"Greyromantic neurodivergent people"},{"@language":"es","@value":"Personas grisrománticas neurodivergentes"},{"@language":"nl","@value":"Grijsromantische neurodivergente personen"},{"@language":"sv","@value":"Gråromantiska neurodivergenta personer"}],"skos:altLabel":[{"@language":"en","@value":"Neurodivergent greyromantic people"},{"@language":"es","@value":"Personas neurodivergentes grisrománticas"},{"@language":"sv","@value":"Neurodivergenta greyromantic-personer"}],"rdfs:comment":[{"@language":"en","@value":"Greyromantic people whose brains process, learn, and/or behave differently from what is considered typical by society. Some of these neurological differences can present as learning disabilities, medical disorders, and other conditions."},{"@language":"es","@value":"Personas grisrománticas cuyos cerebros procesan, aprenden y/o se comportan de manera diferente a lo que la sociedad considera típico. Algunas de estas diferencias neurológicas pueden presentarse como problemas de aprendizaje, trastornos médicos y otras condiciones."},{"@language":"nl","@value":"Grijsromantische personen die verschillen van de norm op het gebied van cognitie, zintuiglijke verwerking, emotionaliteit en sociale vaardigheden. Voor sommigen kunnen deze lichamelijke verschillen zich uiten als beperkingen en/of medische aandoeningen; voor anderen zijn deze verschillen simpelweg eigenschappen die deel uitmaken van hun identiteit."},{"@language":"sv","@value":"Gråromantiska personer vars kognition, sensoriska bearbetning, emotionalitet eller sociala förmåga skiljer sig från normen. Dessa variationer kan för vissa innebära funktionsnedsättningar eller medicinska tillstånd, medan de för andra är egenskaper som ingår i deras identitet."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002996"},"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0003000"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-10-27"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003010","dc:identifier":"homoit0003010","skos:prefLabel":[{"@language":"en","@value":"Greyromantic blind people"},{"@language":"es","@value":"Personas grisrománticas ciegas"},{"@language":"nl","@value":"Blinde grijsromantische personen"},{"@language":"sv","@value":"Blinda gråromantiker"}],"skos:altLabel":[{"@language":"en","@value":"Blind greyromantic people"},{"@language":"es","@value":"Personas ciegas grisrománticas"},{"@language":"es","@value":"Ciegos grisrománticos"},{"@language":"sv","@value":"Blinda greyromantic-personer"}],"rdfs:comment":[{"@language":"en","@value":"Greyromantic people with significant or total loss of vision."},{"@language":"es","@value":"Personas grisrománticas con pérdida significativa o total de la visión."},{"@language":"nl","@value":"Grijsromantische personen met een aanzienlijk of totaal verlies van gezichtsvermogen"},{"@language":"sv","@value":"Gråromantiska personer med betydande eller total synnedsättning."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002996"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-10-27"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003015","dc:identifier":"homoit0003015","skos:prefLabel":[{"@language":"en","@value":"Greyromantic hard of hearing people"},{"@language":"es","@value":"Personas grisrománticas con problemas de audición"},{"@language":"nl","@value":"Hardhorende grijsromantische personen"},{"@language":"sv","@value":"Gråromantiska med hörselnedsättning"}],"skos:altLabel":[{"@language":"en","@value":" Greyromantic hearing impaired people"},{"@language":"en","@value":"Greyromantic HoH people"},{"@language":"en","@value":"Hearing impaired greyromantic people"},{"@language":"en","@value":"HoH Greyromantic people"},{"@language":"es","@value":"Personas grisrománticas con dificultades de audición"},{"@language":"es","@value":"Personas grisrománticas con dificultades auditivas"},{"@language":"nl","@value":"Grijsromantische slechthorenden"},{"@language":"nl","@value":"Slechthorende grijsromantische personen"},{"@language":"sv","@value":"Greyromatic-personer med hörselnedsättning"}],"rdfs:comment":[{"@language":"en","@value":"Greyromantic people with significant or total hearing loss who may or may not consider themselves d/Deaf."},{"@language":"es","@value":"Personas grisrománticas con pérdida auditiva significativa o total que pueden o no considerarse S/sordas."},{"@language":"nl","@value":"Grijsromantische personen met aanzienlijk of totaal gehoorverlies die zichzelf al dan niet als doof beschouwen"},{"@language":"sv","@value":"Gråromantiska personer med betydande eller total hörselförlust."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0002996"},{"@id":"https://homosaurus.org/v5/homoit0003020"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-10-27"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003020","dc:identifier":"homoit0003020","skos:prefLabel":[{"@language":"en","@value":"Greyromantic Deaf people"},{"@language":"es","@value":"Personas grisrománticas sordas"},{"@language":"nl","@value":"Dove grijsromantische personen"},{"@language":"sv","@value":"Döva gråromantiker"}],"skos:altLabel":[{"@language":"en","@value":"Deaf greyromantic people"},{"@language":"es","@value":"Personas sordas grisrománticas"},{"@language":"sv","@value":"Döva greyromantic-personer"}],"rdfs:comment":[{"@language":"en","@value":"Greyromantic people with significant or total hearing loss who may or may not consider themselves d/Deaf."},{"@language":"es","@value":"Personas grisrománticas con pérdida auditiva significativa o total. Algunas personas sordas, pero no todas, prefieren escribir “Sorda/o” con mayúscula  en reconocimiento de la identidad cultural y lingüística que comparten con otras personas sordas."},{"@language":"nl","@value":"Grijsromantische personen met aanzienlijk of totaal gehoorverlies."},{"@language":"sv","@value":"Gråromantiska personer med betydande eller total hörselförlust."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002996"},"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0003015"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-10-27"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003031","dc:identifier":"homoit0003031","skos:prefLabel":[{"@language":"en","@value":"Greyromantic wheelchair users"},{"@language":"es","@value":"Usuarios grisrománticos de sillas de ruedas"},{"@language":"nl","@value":"Grijsromantische rolstoelgebruikers"},{"@language":"sv","@value":"Rullstolsburna gråromantiker"}],"skos:altLabel":{"@language":"sv","@value":"Rullstolsburna greyromantic-personer"},"rdfs:comment":[{"@language":"en","@value":"Greyromantic people who use wheelchairs."},{"@language":"es","@value":"Personas grisrománticas que utilizan sillas de ruedas."},{"@language":"nl","@value":"Grijsromantische personen die een rolstoel gebruiken"},{"@language":"sv","@value":"Gråromantiska personer som använder rullstol."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002996"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-10-27"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003025","dc:identifier":"homoit0003025","skos:prefLabel":[{"@language":"en","@value":"Greyromantic people with chronic illnesses"},{"@language":"es","@value":"Personas grisrománticas con enfermedades crónicas"},{"@language":"nl","@value":"Grijsromantische personen met chronische ziekten"},{"@language":"sv","@value":"Gråromantiker med kronisk sjukdom"}],"skos:altLabel":[{"@language":"en","@value":"Chronically ill greyromantic people"},{"@language":"es","@value":"Personas con enfermedades crónicas grisrománticas"},{"@language":"es","@value":"Enfermos crónicos grisrománticos"},{"@language":"sv","@value":"Kronisk sjuka gråromantiker"},{"@language":"sv","@value":"Kroniskt sjuka greyromantic-personer"}],"rdfs:comment":[{"@language":"en","@value":"Greyromantic people who have long-term health conditions that require continued medical attention and/or significantly impact or limit daily life; some but not all people with chronic illnesses consider themselves disabled."},{"@language":"es","@value":"Personas grisrománticas que tienen condiciones de salud a largo plazo que requieren atención médica continua y/o impactan o limitan significativamente la vida diaria; algunas, pero no todas, las personas con enfermedades crónicas se consideran discapacitadas."},{"@language":"nl","@value":"Grijsromantische personen met langdurige gezondheidsproblemen die voortdurende medische aandacht vereisen en/of het dagelijks leven aanzienlijk beïnvloeden of beperken; sommige, maar niet alle personen met chronische ziekten beschouwen zichzelf als gehandicapt."},{"@language":"sv","@value":"Gråromantiska personer med långvariga hälsotillstånd som kräver kontinuerlig medicinsk behandling och/eller har en betydande påverkan på eller begränsar det dagliga livet. Vissa, men inte alla, personer med kroniska sjukdomar identifierar sig som personer med funktionsnedsättning."}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0002996"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0003025"},"dc:issued":{"@type":"xsd:date","@value":"2023-10-27"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002997","dc:identifier":"homoit0002997","skos:prefLabel":[{"@language":"en","@value":"Demisexual autistic people"},{"@language":"es","@value":"Personas demisexuales autistas"},{"@language":"de","@value":"Demisexuelle autistische Personen"},{"@language":"nl","@value":"Demiseksuele autistische personen"},{"@language":"sv","@value":"Demisexuella personer med autism"}],"skos:altLabel":[{"@language":"en","@value":"Autistic demisexual people"},{"@language":"es","@value":"Personas autistas demisexuales"},{"@language":"es","@value":"Personas demisexuales con autismo"},{"@language":"de","@value":"Autistische demisexuelle Personen"},{"@language":"sv","@value":"Demisexuella autister"}],"rdfs:comment":[{"@language":"en","@value":"Demisexual people who are autistic."},{"@language":"es","@value":"Personas demisexuales que son autistas."},{"@language":"de","@value":"Demisexuelle Personen, die autistisch sind."},{"@language":"nl","@value":"Demiseksuele personen die autistisch zijn."},{"@language":"sv","@value":"Demis