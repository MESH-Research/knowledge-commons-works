5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003557","dc:identifier":"homoit0003557","skos:prefLabel":[{"@language":"en","@value":"Non-binary people of color"},{"@language":"nl","@value":"Non-binaire personen van kleur"},{"@language":"sv","@value":"Ickevita ickebinära"},{"@language":"en-gb","@value":"Non-binary people of colour"}],"skos:altLabel":[{"@language":"en","@value":"Nonbinary people of color"},{"@language":"sv","@value":"Ickebinära POC"},{"@language":"sv","@value":"Ickebinära people of color"}],"rdfs:comment":[{"@language":"en","@value":"Primarily used in the United States, this term refers to non-binary people who are not white and who identify as people of color."},{"@language":"nl","@value":"Non-binaire personen die niet wit zijn en die zich identificeren als personen van kleur."},{"@language":"sv","@value":"Ickebinära som inte är vita och som identifierar sig som icke-vita/people of color."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001101"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-22"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002190","dc:identifier":"homoit0002190","skos:prefLabel":[{"@language":"en","@value":"People of color in fandom"},{"@language":"es","@value":"Personas de color en fandom"},{"@language":"nl","@value":"Personen van kleur in fandom"},{"@language":"sv","@value":"Icke-vita inom fandom"}],"skos:altLabel":[{"@language":"en","@value":"BIPOC in fandom"},{"@language":"sv","@value":"POC inom fandom"},{"@language":"sv","@value":"People of color inom fandom"}],"rdfs:comment":[{"@language":"en","@value":"The participation and inclusion of people of color in fan communities."},{"@language":"es","@value":"La participación e inclusión de personas de color en las comunidades de fans."},{"@language":"nl","@value":"De participatie en inclusie van personen van kleur in fan-gemeenschappen"},{"@language":"sv","@value":"Icke-vita personers delaktighet och representation i fancommunityn."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002156"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001101"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002273","dc:identifier":"homoit0002273","skos:prefLabel":[{"@language":"en","@value":"QTPOC"},{"@language":"es","@value":"QTPOC"},{"@language":"nl","@value":"QTPOC"},{"@language":"sv","@value":"QTPOC"}],"skos:altLabel":[{"@language":"en","@value":"Queer and trans people of color"},{"@language":"es","@value":"Personas queer y trans de color"}],"rdfs:comment":[{"@language":"en","@value":"Acronym used to refer to queer and trans people of color as a group. Typically used to acknowledge the particularities of queer and trans people of color's experiences and the intersections of queerphobia, transphobia, and racism as directed towards queer and trans people of color."},{"@language":"es","@value":"Acrónimo utilizado para referirse a personas de color queer y trans como grupo. Normalmente se utiliza para reconocer las particularidades de las experiencias de las personas queer y trans de color y las intersecciones de la queerfobia, la transfobia y el racismo dirigidas hacia las personas queer y trans de color."},{"@language":"nl","@value":"Acroniem dat wordt gebruikt om queer en trans personen van kleur als een groep aan te duiden. Meestal gebruikt om de bijzondere kenmerken van de ervaringen van queer en trans personen van kleur te erkennen en de intersecties van queerfobie, transfobie en racisme gericht tegen queer en trans personen van kleur."},{"@language":"sv","@value":"Akronym som används för att beteckna queera och transpersoner som people of color som grupp. Används för att synliggöra de särskilda erfarenheter som queera och transpersoner som people of color har, samt de sammanflätade formerna av queerfobi, transfobi och rasism som riktas mot dem."}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001892"},{"@id":"https://homosaurus.org/v5/homoit0001928"},{"@id":"https://homosaurus.org/v5/homoit0001101"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0002273"},"dc:issued":{"@type":"xsd:date","@value":"2022-11-08"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003801","dc:identifier":"homoit0003801","skos:prefLabel":[{"@language":"en","@value":"Sex workers of color"},{"@language":"nl","@value":"Sekswerkers van kleur"},{"@language":"sv","@value":"Ickevita sexarbetare"},{"@language":"en-gb","@value":"Sex workers of colour"}],"skos:altLabel":[{"@language":"en","@value":"People of color sex workers"},{"@language":"en","@value":"Racialized sex workers"},{"@language":"en","@value":"Non-white sex workers"},{"@language":"sv","@value":"Sexarbetare som är POC"},{"@language":"sv","@value":"Sexarbetare som är people of color"}],"rdfs:comment":[{"@language":"en","@value":"Sex workers who are not white and self-identify as people of color."},{"@language":"nl","@value":"Personen van kleur die geld of goederen ontvangen in ruil voor seksuele diensten, optredens of gezelschap. Wordt gebruikt om personen te beschrijven die werkzaam zijn in het brede spectrum van sekswerk en zichzelf identificeren als personen van kleur."},{"@language":"sv","@value":"Ickevita personer som tar emot pengar eller varor i utbyte mot sexuella handlingar, framträdanden eller sällskap. Används för att beskriva ickevita personer som är verksamma inom det breda spektrumet av sexarbete. Vissa anser termen sexarbetare som kränkade och politiserad, medan andra identifierar sig med den. Se även \"Ickevita personer i prostitution\"."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0003758"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001101"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0003758"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-30"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001102","dc:identifier":"homoit0001102","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ performance art"},{"@language":"es","@value":"Arte escénico"},{"@language":"nl","@value":"LHBTQ+-podiumkunsten"},{"@language":"sv","@value":"Performancekonst"}],"skos:altLabel":[{"@language":"en","@value":"Performance art (LGBTQ)"},{"@language":"en","@value":"LGBTQ+ live art"},{"@language":"en","@value":"Live art (LGBTQ)"}],"rdfs:comment":[{"@language":"en","@value":"Art created through actions performed by the artist or other participants, typically for a live audience. Use to refer to performance art created by LGBTQ+ artists and/or engaging with LGBTQ+ issues."},{"@language":"es","@value":"Arte creado a través de acciones realizadas por el artista u otros participantes, generalmente para una audiencia en vivo."},{"@language":"nl","@value":"Kunst die ontstaat door optredens van de artiesten of andere deelnemers, meestal voor een live publiek. Verwijst naar performancekunst gemaakt door LHBTQ+-artiesten en/of die zich bezighoudt met LHBTQ+-issues."},{"@language":"sv","@value":"Konst skapad genom kroppsliga handlingar, ofta inför publik. Utförs av konstnären själv eller av deltagare."}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85099809"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001102"},"dc:replaces":{"@id":"http://homosaurus.org/v2/performanceArt"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001106","dc:identifier":"homoit0001106","skos:prefLabel":[{"@language":"en","@value":"Persecution of queer people"},{"@language":"es","@value":"Persecución de personas queer"},{"@language":"nl","@value":"Vervolging van queer personen"},{"@language":"sv","@value":"Förföljelse av queera personer"}],"rdfs:comment":[{"@language":"en","@value":"Systematic mistreatment of queer people on the basis of their gender and/or sexual identities."},{"@language":"es","@value":"Maltrato sistemático a personas queer por su género y/o identidad sexual."},{"@language":"nl","@value":"Systematische mishandeling van queer personen op basis van hun gender- en/of seksuele identiteiten."},{"@language":"sv","@value":"Systematisk förföljelse av queera personer på grund av deras könsidentitet och/eller sexuella identitet."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001108"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001195"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001108"},"dc:replaces":{"@id":"http://homosaurus.org/v2/persecutionOfQueerPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001107","dc:identifier":"homoit0001107","skos:prefLabel":[{"@language":"en","@value":"Persecution of transgender people"},{"@language":"es","@value":"Persecución de personas transgénero"},{"@language":"nl","@value":"Vervolging van transgender personen"},{"@language":"sv","@value":"Förföljelse av transpersoner"}],"rdfs:comment":[{"@language":"en","@value":"Systematic mistreatment of transgender people on the basis of their gender identity."},{"@language":"es","@value":"Maltrato sistemático a personas transgénero por su identidad de género."},{"@language":"nl","@value":"Systematische mishandeling van transgender personen op basis van hun genderidentiteit."},{"@language":"sv","@value":"Systematisk förföljelse av transpersoner på grund av deras könsidentitet."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001108"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001378"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001108"},"dc:replaces":{"@id":"http://homosaurus.org/v2/persecutionOfTransgenderPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001110","dc:identifier":"homoit0001110","skos:prefLabel":[{"@language":"en","@value":"Phone sex"},{"@language":"es","@value":"Sexo por teléfono"},{"@language":"nl","@value":"Telefoonseks"},{"@language":"sv","@value":"Telefonsex"}],"skos:altLabel":[{"@language":"en","@value":"Telephone sex"},{"@language":"es","@value":"Sexo telefónico"}],"rdfs:comment":[{"@language":"en","@value":"Sexual encounters that take place over the phone, whether in a phone call or on a video call using a smartphone."},{"@language":"es","@value":"Encuentros sexuales que se desarrollan a través del teléfono, ya sea en una llamada telefónica o en una videollamada mediante un smartphone."},{"@language":"nl","@value":"Seksuele ontmoetingen die plaatsvinden via de telefoon, of het nu gaat om een telefoongesprek of een videogesprek met een smartphone."},{"@language":"sv","@value":"Sexuella möten som sker via telefon, genom telefonsamtal eller videosamtal med smartphone."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001267"},{"@id":"https://homosaurus.org/v5/homoit0001299"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh94005250"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001267"},"dc:replaces":{"@id":"http://homosaurus.org/v2/phoneSex"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001111","dc:identifier":"homoit0001111","skos:prefLabel":[{"@language":"en","@value":"Phone sex workers"},{"@language":"es","@value":"Trabajadores sexuales por telefono"},{"@language":"nl","@value":"Telefoonsekswerkers"},{"@language":"sv","@value":"Telefonsexarbetare"}],"skos:altLabel":[{"@language":"en","@value":"Phone sex operators"},{"@language":"en","@value":"Telephone sex workers"},{"@language":"en","@value":" Telephone sex operators"},{"@language":"es","@value":"Operadores de sexo por teléfono"},{"@language":"sv","@value":"Telefonsexsäljare"}],"rdfs:comment":[{"@language":"en","@value":"People who perform real-time sex work via phone calls, text messaging, or online voice calls. Use \"Cam models\" for individuals who perform real-time sex work via streaming video or video calls."},{"@language":"es","@value":""},{"@language":"nl","@value":"Personen die realtime sekswerk verrichten via telefoongesprekken, sms'jes of online spraakoproepen. Gebruik 'Cam-modellen' voor personen die realtime sekswerk verrichten via streaming video of videogesprekken."},{"@language":"sv","@value":"Personer som utför sexarbete i realtid via telefonsamtal, textmeddelanden eller röstsamtal online. Använd ”Cam-modeller” för personer som utför sexarbete i realtid via livestreamad video eller videosamtal."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0003758"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0003763"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0003758"},"dc:replaces":{"@id":"http://homosaurus.org/v2/phoneSexWorkers"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003763","dc:identifier":"homoit0003763","skos:prefLabel":[{"@language":"en","@value":"Phone sex work"},{"@language":"nl","@value":"Telefonisch sekswerk"},{"@language":"sv","@value":"Telefonsexarbete"}],"skos:altLabel":{"@language":"en","@value":"Telephone sex work"},"rdfs:comment":[{"@language":"en","@value":"Real-time sex work via phone calls, text messaging, or online voice calls. Use \"Cam modeling\" for real-time sex work via online video calls and livestreams."},{"@language":"nl","@value":"Realtime sekswerk via telefoongesprekken, sms'jes of online spraakoproepen. Gebruik 'Cam modeling' voor realtime sekswerk via online videogesprekken en livestreams."},{"@language":"sv","@value":"Sexarbete i realtid som sker via telefonsamtal, textmeddelanden eller röstsamtal online. Använd ”Cam-modellande” för sexarbete i realtid via videosamtal eller livestreamade videor."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001276"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001111"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000011"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-30"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001115","dc:identifier":"homoit0001115","skos:prefLabel":[{"@language":"en","@value":"Pinching (Erotic)"},{"@language":"es","@value":"Pellizcar"},{"@language":"nl","@value":"Knijpen (Erotisch)"},{"@language":"sv","@value":"Nypning (sexualitet)"}],"rdfs:comment":[{"@language":"en","@value":"Form of manual stimulation involving gripping, pulling, or putting tension on parts of one’s body or another person's body for sexual stimulation, arousal, or pleasure."},{"@language":"es","@value":"Forma de estimulación manual que implica agarrar, jalar, o poner tensión en partes del cuerpo de una misma persona o de otra persona para estimulación, excitación o placer sexual."},{"@language":"sv","@value":"Form av manuell stimulans som innebär att man greppar, drar eller skapar spänning i sin egen eller någon annans kropp i sexuellt syfte."}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001115"},"dc:replaces":{"@id":"http://homosaurus.org/v2/pinching"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001197","dc:identifier":"homoit0001197","skos:prefLabel":[{"@language":"en","@value":"Queer poetry"},{"@language":"es","@value":"Poesía queer"},{"@language":"nl","@value":"Queer poëzie"},{"@language":"sv","@value":"Queerpoesi"}],"skos:altLabel":[{"@language":"sv","@value":"Queer poesi"},{"@language":"sv","@value":"Queerlyrik"},{"@language":"sv","@value":"Queer lyrik"}],"rdfs:comment":[{"@language":"en","@value":"Literary works, typically written in verse, that focus on queer characters, themes, or identity."},{"@language":"es","@value":"Obras literarias, normalmente escritas en verso, que se centran en personajes, temas o identidades queer."},{"@language":"nl","@value":"Literair werk, meestal in verzen geschreven, dat zich richt op queer-personages, thema's of identiteit."},{"@language":"sv","@value":"Lyriska verk med fokus på queera karaktärer, teman eller identitet."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001118"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001728"},"skos:hasTopConcept":{"@id":"https://ho