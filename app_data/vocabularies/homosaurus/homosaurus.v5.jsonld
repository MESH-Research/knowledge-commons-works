:"Subculturas"},{"@language":"nl","@value":"Subculturen"},{"@language":"sv","@value":"Subkulturer"}],"rdfs:comment":[{"@language":"en","@value":"Groups of people belonging to cultures that differentiate them from the larger culture to which they belong. Subcultures develop their own norms and values regarding cultural, political, and sexual matters."},{"@language":"es","@value":"Grupos de personas pertenecientes a culturas que las diferencian de la cultura más amplia a la que pertenecen. Las subculturas desarrollan sus propias normas y valores en materia cultural, política y sexual."},{"@language":"sv","@value":"Grupper av människor som tillhör kulturer som skiljer sig från den större kultur de lever i. Subkulturer utvecklar egna normer och värderingar kring kulturella, politiska och sexuella frågor."}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000092"},{"@id":"https://homosaurus.org/v5/homoit0000327"},{"@id":"https://homosaurus.org/v5/homoit0000338"},{"@id":"https://homosaurus.org/v5/homoit0000705"},{"@id":"https://homosaurus.org/v5/homoit0001247"},{"@id":"https://homosaurus.org/v5/homoit0001654"},{"@id":"https://homosaurus.org/v5/homoit0001831"},{"@id":"https://homosaurus.org/v5/homoit0002156"},{"@id":"https://homosaurus.org/v5/homoit0003123"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85129417"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/subcultures"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000015","dc:identifier":"homoit0000015","skos:prefLabel":[{"@language":"en","@value":"African American LGBTQ+ people"},{"@language":"de","@value":"Afroamerikanische LGBTQ+-Personen"},{"@language":"es","@value":"Personas LGBTQ+ afroamericanas"},