en."},{"@language":"es","@value":"Hijas que tienen unx o más padrxs no binarixs."},{"@language":"nl","@value":"Dochters die één of meer non-binaire ouders hebben."},{"@language":"sv","@value":"Döttrar som har en eller flera ickebinära föräldrar."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002352"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000421"},"dc:issued":{"@type":"xsd:date","@value":"2024-07-11"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002743","dc:identifier":"homoit0002743","skos:prefLabel":[{"@language":"en","@value":"Partners of intersex people"},{"@language":"es","@value":"Parejas de personas intersexuales"},{"@language":"nl","@value":"Partners van intersekse personen"},{"@language":"sv","@value":"Partners till intersexpersoner"}],"skos:altLabel":{"@language":"es","@value":"Parejas de personas intersex"},"rdfs:comment":[{"@language":"en","@value":"People whose sexual, romantic, or play partner is intersex."},{"@language":"es","@value":"Personas cuya pareja sexual, romántica o de juego es intersexual."},{"@language":"nl","@value":"Personen wier seksuele, romantische of speelpartner intersekse is."},{"@language":"sv","@value":"Personer som har en romantisk, sexuell eller kinkbaserad relation med en intersexperson."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002366"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0002365"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-27"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002911","dc:identifier":"homoit0002911","skos:prefLabel":[{"@language":"en","@value":"Partners of asexual people"},{"@language":"es","@value":"Parejas de personas asexuales"},{"@language":"nl","@value":"Partners van aseksuele personen"},{"@language":"sv","@value":"Partners till asexuella"}],"rdfs:comment":[{"@language":"en","@value":"People whose sexual, romantic, or play partner is asexual."},{"@language":"es","@value":"Personas cuya pareja sexual, romántica o de juego es asexual."},{"@language":"nl","@value":"Personen wier seksuele, romantische of speelpartner aseksueel is."},{"@language":"sv","@value":"Personer som har en romantisk, sexuell eller kinkbaserad relation med en asexuell person."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002366"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0002365"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-29"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002395","dc:identifier":"homoit0002395","skos:prefLabel":[{"@language":"en","@value":"Shootings of LGBTQ+ people by police"},{"@language":"es","@value":"Disparos contra personas LGBTQ+ por parte de la policía"},{"@language":"nl","@value":"Neerschieten van LHBTQ+-personen door de politie"},{"@language":"sv","@value":"Polisskjutningar av hbtq+-personer"}],"skos:altLabel":{"@language":"es","@value":"Tiroteos contra personas LGBTQ+ por parte de la policía"},"rdfs:comment":[{"@language":"en","@value":"Shooting of LGBTQ+ individuals or individuals perceived as being LGBTQ+ by police officers."},{"@language":"es","@value":"Disparos contra personas LGBTQ+ o personas percibidas como LGBTQ+ por agentes de la policía."},{"@language":"nl","@value":"Het neerschieten van LHBTQ+-personen of personen die door politieagenten als LHBTQ+ worden beschouwd."},{"@language":"sv","@value":"Skjutningar av hbtq+-personer eller personer som uppfattas som hbtq+ utförda av polis."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002378"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000059"},"dc:issued":{"@type":"xsd:date","@value":"2023-01-13"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004291","dc:identifier":"homoit0004291","skos:prefLabel":[{"@language":"en","@value":"Paragraph 175"},{"@language":"nl","@value":"Paragraaf 175"},{"@language":"sv","@value":"Paragraf 175"}],"skos:altLabel":{"@language":"en","@value":"Section 175"},"rdfs:comment":[{"@language":"en","@value":"Paragraph 175, known formally as §175 StGB and also referred to as Section 175 in English, was a provision of the German Criminal Code adopted after the unification of Germany in 1871. It criminalized sexual acts between men - discussions about including sexual acts between women never made it to actual legislation. The provision served as a main target for the early German sexual rights movements, with petitions for its repeal being circulated from 1897 onwards. A repeal was attempted in 1929, but the unstable political situation, with uncertain parliamentary majorities and the rise of the Nazi Party, prevented implementation of the repeal. Nazi expansion of Paragraph 175 resulted in those convicted under the provision often being put in concentration camps. After WWII, the statute was used to keep those convicted imprisoned and denied reparations. East Germany abolished Paragraph 175 in 1968, after having made it functionally void in 1958. West Germany retained the expanded Nazi version, but after successive revisions only cases involving persons under the age of 18 were prosecuted after 1973. The section was eliminated during the reconciliation of East and West German legal codes in 1994."},{"@language":"nl","@value":"Paragraaf 175, formeel bekend als §175 StGB was een bepaling in het Duitse Wetboek van Strafrecht die na de Duitse eenwording in 1871 werd aangenomen. Het oorspronkelijke doel was om seksuele handelingen tussen mannen strafbaar te stellen, maar in 1907 werd het uitgebreid met seksuele handelingen tussen vrouwen. In 1929 werd een poging gedaan om dit wetsartikel in te trekken, maar de nazi-partij verhinderde dit. De uitbreiding van paragraaf 175 door de nazi's leidde ertoe dat veroordeelden op grond van dit wetsartikel in concentratiekampen werden opgesloten. Na de Tweede Wereldoorlog werd de wet gebruikt om LHBTQ+-personen in concentratiekampen gevangen te houden. Oost-Duitsland schafte paragraaf 175 in 1950 af, terwijl West-Duitsland de vervolging handhaafde en voortzette. Het wetsartikel werd definitief afgeschaft tijdens de samenvoeging van de Oost- en West-Duitse wetboeken in 1994."},{"@language":"sv","@value":"Paragraf 175, officiellt känd som § 175 StGB och även kallad Section 175 på engelska, var en bestämmelse i den tyska strafflag som antogs efter Tysklands enande 1871. Den kriminaliserade sexuella handlingar mellan män - förslag om att inkludera även sexuella handlingar mellan kvinnor infördes aldrig i lagstiftningen. Paragrafen utgjorde det främsta målet för de tidiga tyska sexualpolitiska rörelserna, med namninsamlingar för dess avskaffande i omlopp från 1897 och framåt. Ett avskaffningsförsök gjordes 1929, men den oroliga politiska situationen, med osäkra parlamentariska majoriteter och det växande nazipartiet, omöjligjorde genomförandet. Skärpningar i paragrafen införda av nazisterna ledde till att de som dömdes ofta internerades i koncentrationsläger. Efter andra världskriget användes paragrafen för fortsatt fängslande och förvägran av skadestånd till de som dömts. 1968 avskaffades paragrafen i Östtyskland, efter att i praktiken ha slutat tillämpas 1958. Västtyskland bibehöll de skärpta bestämmelserna från nazitiden, men efter successiva ändringar åtalades efter 1973 bara fall som involverade personer under 18 år. Paragrafen avskaffades slutligen 1994 i och med sammanslagningen av Öst- och Västtysklands lagstiftningar."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002380"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000702"},"dc:issued":{"@type":"xsd:date","@value":"2026-02-11"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002383","dc:identifier":"homoit0002383","skos:prefLabel":[{"@language":"en","@value":"Police raids on LGBTQ+ meeting places"},{"@language":"es","@value":"Redadas policiales en espacios de encuentro LGBTQ+"},{"@language":"nl","@value":"Politie-invallen op LHBTQ+-ontmoetingsplekken"},{"@language":"sv","@value":"Polisräder mot hbtq+-personers mötesplatser"}],"skos:altLabel":{"@language":"sv","@value":"Polisrazzior mot hbtq+-personers mötesplatser"},"rdfs:comment":[{"@language":"en","@value":"Unexpected and unannounced entry into and searches of meeting places owned or frequented by LGBTQ+ people, including individuals' residences, businesses, and other institutions, by law enforcement officers with the aim of using surprise to seize evidence or arrest suspects. Police raids may be undertaken legally using a search warrant or through exigent circumstances, such as probable cause, though the latter is highly subjective and civilians often have little resources to appeal illegal raids."},{"@language":"es","@value":"Redadas policiales en lugares de encuentro afiliados o relacionados con comunidades o identidades LGBTQ+, ya sea la residencia de una persona, un negocio u otra institución."},{"@language":"nl","@value":"Politie-invallen op LHBTQ+-gelieerde of -gerelateerde ontmoetingsplaatsen, of het nu gaat om de woning van een individu, een bedrijf of een andere instelling."},{"@language":"sv","@value":"Oannonserade och oväntade intrång i och genomsökningar av mötesplatser som ägs av eller frekventeras av hbtq+-personer, inklusive individers bostäder, verksamheter och andra institutioner, genomförda av poliser i syfte att överraska för att beslagta bevis eller gripa misstänkta. Polisräder kan genomföras lagligt med stöd av husrannsakan eller genom påstådda brådskande omständigheter, till exempel sannolika skäl, vilket är subjektivt och ofta ger begränsade möjligheter för civila att överklaga olagliga räder."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002381"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000611"},"dc:issued":{"@type":"xsd:date","@value":"2023-01-13"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002389","dc:identifier":"homoit0002389","skos:prefLabel":[{"@language":"en","@value":"Criminalization of cross-dressing"},{"@language":"es","@value":"Criminalización del transformismo"},{"@language":"de","@value":"Kriminalisierung von Crossdressing"},{"@language":"nl","@value":"Criminalisering van cross-dressing"},{"@language":"sv","@value":"Kriminalisering av crossdressing"}],"rdfs:comment":[{"@language":"en","@value":"Criminalization of any expression of gender considered to be cross-dressing in a given sociocultural context."},{"@language":"es","@value":"La criminalización de cualquier expresión de género considerada transformismo en un determinado contexto sociocultural."},{"@language":"de","@value":"Kriminalisierung jeglicher Ausdrucksform von Geschlecht, die in einem bestimmten soziokulturellen Kontext als Crossdressing angesehen wird."},{"@language":"nl","@value":"Strafbaarstelling van elke uiting van gender die in een bepaalde sociaal-culturele context als cross-dressing wordt beschouwd."},{"@language":"sv","@value":"Kriminalisering av alla former av könsuttryck som i en given sociokulturell kontext anses vara könsöverskridande klädsel."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002388"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000702"},"dc:issued":{"@type":"xsd:date","@value":"2023-01-13"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003877","dc:identifier":"homoit0003877","skos:prefLabel":[{"@language":"en","@value":"Demisexual people's writings"},{"@language":"nl","@value":"Geschriften van demiseksuele personen"},{"@language":"sv","@value":"Demisexuella personers texter"}],"skos:altLabel":[{"@language":"en","@value":"Writings of demisexual people"},{"@language":"sv","@value":"Texter av demisexuella"}],"rdfs:comment":[{"@language":"en","@value":"Written works created by demisexual people."},{"@language":"nl","@value":"Geschreven werken gemaakt door demiseksuele personen."},{"@language":"sv","@value":"Texter skapade av demisexuella personer."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0003866"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0002487"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2025-03-13"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003879","dc:identifier":"homoit0003879","skos:prefLabel":[{"@language":"en","@value":"Megasexual people's writings"},{"@language":"nl","@value":"Geschriften van megaseksuele personen"},{"@language":"sv","@value":"Megasexuella personers texter"}],"skos:altLabel":[{"@language":"en","@value":"Writings of megasexual people"},{"@language":"sv","@value":"Texter av megasexuella personer"}],"rdfs:comment":[{"@language":"en","@value":"Written works created by megasexual people."},{"@language":"nl","@value":"Geschreven werken gemaakt door megaseksuele personen."},{"@language":"sv","@value":"Texter skapade av megasexuella personer."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0003866"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0002505"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2025-03-13"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002527","dc:identifier":"homoit0002527","skos:prefLabel":[{"@language":"en","@value":"Armenian gay men "},{"@language":"es","@value":"Hombres gay armenios"},{"@language":"de","@value":"Armenische schwule Männer"},{"@language":"nl","@value":"Armeense homomannen"},{"@language":"sv","@value":"Armeniska bögar"}],"skos:altLabel":[{"@language":"en","@value":"Gay Armenians"},{"@language":"es","@value":"Armenios gay"},{"@language":"de","@value":"Schwule Armenier"},{"@language":"de","@value":"Schwule armenische Personen"}],"rdfs:comment":[{"@language":"en","@value":"Gay men who are ethnically Armenian."},{"@language":"es","@value":"Hombres gay de etnia armenia."},{"@language":"de","@value":"Schwule Männer, die ethnisch gesehen armenisch sind."},{"@language":"nl","@value":"Homomannen die etnisch Armeens zijn."},{"@language":"sv","@value":"Bögar med armeniskt ursprung."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002526"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-11"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002528","dc:identifier":"homoit0002528","skos:prefLabel":[{"@language":"en","@value":"Armenian lesbians "},{"@language":"es","@value":"Lesbianas armenias"},{"@language":"de","@value":"Armenische Lesben"},{"@language":"nl","@value":"Armeense lesbische vrouwen"},{"@language":"sv","@value":"Lesbiska armenier"}],"skos:altLabel":[{"@language":"en","@value":"Lesbian Armenians"},{"@language":"es","@value":"Armenias lesbianas"},{"@language":"de","@value":"Lesbische Armenier:innen"},{"@language":"de","@value":"Lesbische armenische Personen"}],"rdfs:comment":[{"@language":"en","@value":"Lesbians who are ethnically Armenian."},{"@language":"es","@value":"Lesbianas de etnia armenia. "},{"@language":"de","@value":"Lesben, die ethnisch gesehen armenisch sind."},{"@language":"nl","@value":"Lesbische vrouwen die etnisch Armeens zijn."},{"@language":"sv","@value":"Lesbiska med armeniskt ursprung."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002526"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-11"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002529","dc:identifier":"homoit0002529","skos:prefLabel":[{"@language":"en","@value":"Armenian bisexual people "},{"@language":"es","@value":"Personas bisexuales armenias"},{"@language":"de","@value":"Armenische bisexuelle Personen"},{"@language":"nl","@value":"Armeense biseksuele personen"},{"@language":"sv","@value":"Bisexuella armenier"}],"skos:altLabel":[{"@language":"en","@value":"Bisexual Armenians"},{"@language":"es","@value":"Armenios bisexuales"},{"@language":"es","@value":"Armenias bisexuales"},{"@language":"de","@value":"Bisexuelle Armenier:innen"},{"@language":"de","@value":"Bisexuelle armenische Personen"},{"@language":"nl","@value":"Biseksuele Armeniërs"}],"rdfs:comment":[{"@language":"en","@value":"Bisexual people who are ethnically Armenian."},{"@language":"es","@value":"Personas bisexuales de etnia armenia."},{"@language":"de","@value":"Bisexuelle Personen, die ethnisch gesehen armenisch sind."},{"@language":"nl","@value":"Biseksuele personen die etnisch Armeens zijn."},{"@language":"sv","@value":"Bisexuella personer med armeniskt ursprung."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002526"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-11"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002530","dc:identifier":"homoit0002530","skos:prefLabel":[{"@language":"en","@value":"Armenian queer people "},{"@language":"es","@value":"Personas queer armenias"},{"@language":"de","@value":"Armenische queere Personen"},{"@language":"nl","@value":"Armeense queer personen"},{"@language":"sv","@value":"Queera armenier"}],"skos:altLabel":[{"@language":"en","@value":"Queer Armenians"},{"@language":"es","@value":"Armenios queer"},{"@language":"es","@value":"Armenias queer"},{"@language":"de","@value":"Queere Armenier:innen"},{"@language":"de","@value":"Queere armenische Personen"}],"rdfs:comment":[{"@language":"en","@value":"Queer people who are ethnically Armenian."},{"@language":"es","@value":"Personas queer de etnia armenia."},{"@language":"de","@value":"Queere Personen, die ethnisch gesehen armenisch sind."},{"@language":"nl","@value":"Queer personen die etnisch Armeens zijn."},{"@language":"sv","@value":"Queera personer med armeniskt ursprung."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002526"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-11"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002531","dc:identifier":"homoit0002531","skos:prefLabel":[{"@language":"en","@value":"