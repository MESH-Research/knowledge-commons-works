.org/v5/homoit0000708"},{"@id":"https://homosaurus.org/v5/homoit0000710"},{"@id":"https://homosaurus.org/v5/homoit0003087"},{"@id":"https://homosaurus.org/v5/homoit0003088"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000297"},"dc:replaces":{"@id":"http://homosaurus.org/v2/leathermen"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000710","dc:identifier":"homoit0000710","skos:prefLabel":[{"@language":"en","@value":"Leatherwomen"},{"@language":"es","@value":"Mujeres leather"},{"@language":"de","@value":"Lederfrauen"},{"@language":"nl","@value":"Leervrouwen"},{"@language":"sv","@value":"Läderkvinnor"}],"skos:altLabel":[{"@language":"en","@value":"Leatherdykes"},{"@language":"es","@value":"Leatherwomen"},{"@language":"de","@value":"Lederdykes"},{"@language":"de","@value":"Leatherdykes"},{"@language":"de","@value":"Leatherwomen"},{"@language":"sv","@value":"Leatherwomen"}],"rdfs:comment":[{"@language":"en","@value":"People who participate in leather communities and identify as leatherwomen."},{"@language":"es","@value":"Mujeres que tienen fetiches o participan en actividades fetichistas relacionadas con el cuero y pertenecen a la comunidad de cuero; frecuentemente asociadas a subculturas LGBTQ+."},{"@language":"de","@value":"Personen, die in Leder-Communities aktiv sind und sich als „Leatherwomen“ bezeichnen."},{"@language":"nl","@value":"Personen die participeren in leer gemeenschappen en zich identificeren als leervrouwen."},{"@language":"sv","@value":"Personer som deltar i lädergemenskaper och identifierar sig som läderkvinnor."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000705"},{"@id":"https://homosaurus.org/v5/homoit0003086"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000706"},{"@id":"https://homosaurus.org/v5/homoit0000707"},{"@id":"https://homosaurus.org/v5/homoit0000708"},{"@id":"https://homosaurus.org/v5/homoit0000709"},{"@id":"https://homosaurus.org/v5/homoit0003087"},{"@id":"https://homosaurus.org/v5/homoit0003088"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000297"},"dc:replaces":{"@id":"http://homosaurus.org/v2/leatherwomen"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003083","dc:identifier":"homoit0003083","skos:prefLabel":[{"@language":"en","@value":"Pup play"},{"@language":"es","@value":"Juego de cachorros"},{"@language":"nl","@value":"Pup spel"},{"@language":"sv","@value":"Puppy play"}],"skos:altLabel":[{"@language":"en","@value":"Leatherpups"},{"@language":"es","@value":"Leatherpups"},{"@language":"sv","@value":"Pup play"}],"rdfs:comment":[{"@language":"en","@value":"The act of roleplaying as a canine, sometimes with someone acting as a trainer, handler or pet owner, for fun or erotic enjoyment."},{"@language":"es","@value":"El acto de jugar a un rol como un canino, a veces con una persona que actúa como entrenadora, cuidadora o dueña de una mascota, por diversión o disfrute erótico."},{"@language":"nl","@value":"Het spelen van een rollenspel als hond, soms met iemand die optreedt als trainer, begeleider of eigenaar van het dier, voor de lol of erotisch genot."},{"@language":"sv","@value":"Rollspel där en person, för nöje eller erotisk njutning, iklär sig rollen som hund, ofta tillsammans med en person som agerar tränare, ägare eller handler."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000705"},{"@id":"https://homosaurus.org/v5/homoit0003082"},{"@id":"https://homosaurus.org/v5/homoit0003086"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001145"},{"@id":"https://homosaurus.org/v5/homoit0003112"},{"@id":"https://homosaurus.org/v5/homoit0003178"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000297"},"dc:issued":{"@type":"xsd:date","@value":"2023-12-18"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003086","dc:identifier":"homoit0003086","skos:prefLabel":[{"@language":"en","@value":"Leather people"},{"@language":"es","@value":"Personas leather"},{"@language":"de","@value":"Lederpersonen"},{"@language":"nl","@value":"Leer personen"},{"@language":"sv","@value":"Läderpersoner"}],"skos:altLabel":[{"@language":"es","@value":"Leather people"},{"@language":"de","@value":"Lederleute"}],"rdfs:comment":[{"@language":"en","@value":"People who participate in or identify with leather communities."},{"@language":"es","@value":"Personas que participan en comunidades de cuero o se autoidentifican con ellas."},{"@language":"de","@value":"Personen, die Teil von Leder-Communities sind oder sich mit diesen identifizieren."},{"@language":"nl","@value":"Personen die deel uitmaken van of zich identificeren met leergemeenschappen."},{"@language":"sv","@value":"Personer som deltar i eller identifierar sig med lädergemenskaper."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000705"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000706"},{"@id":"https://homosaurus.org/v5/homoit0000707"},{"@id":"https://homosaurus.org/v5/homoit0000708"},{"@id":"https://homosaurus.org/v5/homoit0000709"},{"@id":"https://homosaurus.org/v5/homoit0000710"},{"@id":"https://homosaurus.org/v5/homoit0003083"},{"@id":"https://homosaurus.org/v5/homoit0003087"},{"@id":"https://homosaurus.org/v5/homoit0003088"},{"@id":"https://homosaurus.org/v5/homoit0003105"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001145"},{"@id":"https://homosaurus.org/v5/homoit0003084"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000297"},"dc:issued":{"@type":"xsd:date","@value":"2023-12-18"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003087","dc:identifier":"homoit0003087","skos:prefLabel":[{"@language":"en","@value":"Leatherboys"},{"@language":"es","@value":"Chicos leather"},{"@language":"de","@value":"Lederjungs"},{"@language":"nl","@value":"Leerjongens"},{"@language":"sv","@value":"Leatherboys"}],"skos:altLabel":[{"@language":"es","@value":"Leatherboys"},{"@language":"de","@value":"Leatherboys"},{"@language":"sv","@value":"Leatherboys"}],"rdfs:comment":[{"@language":"en","@value":"People who participate in leather communities and identify as leatherboy."},{"@language":"es","@value":"Personas que participan en comunidades de cuero y se autoidentifican como leatherboys."},{"@language":"de","@value":"Personen, die in Leder-Communities aktiv sind und sich als „Leatherboys“ bezeichnen."},{"@language":"nl","@value":"Mensen die deel uitmaken van leergemeenschappen en zich identificeren als leerjongen."},{"@language":"sv","@value":"Personer som deltar i lädergemenskaper och identifierar sig som leatherboys."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000705"},{"@id":"https://homosaurus.org/v5/homoit0003086"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000706"},{"@id":"https://homosaurus.org/v5/homoit0000707"},{"@id":"https://homosaurus.org/v5/homoit0000708"},{"@id":"https://homosaurus.org/v5/homoit0000709"},{"@id":"https://homosaurus.org/v5/homoit0000710"},{"@id":"https://homosaurus.org/v5/homoit0003088"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000297"},"dc:issued":{"@type":"xsd:date","@value":"2023-12-18"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003088","dc:identifier":"homoit0003088","skos:prefLabel":[{"@language":"en","@value":"Leathergirls"},{"@language":"es","@value":"Chicas leather"},{"@language":"nl","@value":"Leermeiden"},{"@language":"sv","@value":"Leathergirls"}],"skos:altLabel":[{"@language":"es","@value":"Leathergirls"},{"@language":"sv","@value":"Leathergirls"}],"rdfs:comment":[{"@language":"en","@value":"People who participate in leather communities and identify as leathergirls."},{"@language":"es","@value":"Personas que participan en comunidades de cuero y se autoidentifican como leathergirls."},{"@language":"nl","@value":"Mensen die deel uitmaken van leergemeenschappen en zich identificeren als leermeisjes."},{"@language":"sv","@value":"Personer som deltar i lädergemenskaper och identifierar sig som leathergirls."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000705"},{"@id":"https://homosaurus.org/v5/homoit0003086"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000706"},{"@id":"https://homosaurus.org/v5/homoit0000707"},{"@id":"https://homosaurus.org/v5/homoit0000708"},{"@id":"https://homosaurus.org/v5/homoit0000709"},{"@id":"https://homosaurus.org/v5/homoit0000710"},{"@id":"https://homosaurus.org/v5/homoit0003087"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000297"},"dc:issued":{"@type":"xsd:date","@value":"2023-12-18"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003080","dc:identifier":"homoit0003080","skos:prefLabel":[{"@language":"en","@value":"Leather and kink conventions"},{"@language":"de","@value":"Leder-und Kink-Conventions"},{"@language":"es","@value":"Convenciones leather y kink"},{"@language":"nl","@value":"Leer en kink conventies"},{"@language":"sv","@value":"Kinkkonvent"}],"skos:altLabel":[{"@language":"de","@value":"Leder- und Kink-Treffen"},{"@language":"es","@value":"Leather y kink cons"},{"@language":"sv","@value":"Läder- och kinkmässor"},{"@language":"sv","@value":"Läder- och kinkfestivaler"},{"@language":"sv","@value":"Lädermässor"},{"@language":"sv","@value":"Kinkmässor"},{"@language":"sv","@value":"Läderfestivaler"},{"@language":"sv","@value":"Kinkfestivaler"},{"@language":"sv","@value":"Läderkonvent"},{"@language":"sv","@value":"Läder- och kinkkonvent"},{"@language":"sv","@value":"BDSM-event"},{"@language":"sv","@value":"BDSM-konferenser"}],"rdfs:comment":[{"@language":"en","@value":"Leather and kink conventions typically take place annually at a hotel, resort, or other venue. They usually include parties, performances, title contests, vendors, play spaces, and classes and workshops on kink, sex, relationships, activism, and related topics."},{"@language":"de","@value":"Leder- und Kink-Conventions finden in der Regel einmal jährlich in einem Hotel, einem Resort oder an einem anderen Veranstaltungsort statt. Sie umfassen meist Partys, Vorführungen, Titelwettbewerbe, Verkaufsstände, Spielbereiche sowie Kurse und Workshops zu Kink, Sex, Beziehungen, Aktivismus und verwandten Themen."},{"@language":"es","@value":"Las convenciones de cuero y kink suelen celebrarse anualmente en un hotel, centro turístico u otro lugar. Suelen incluir fiestas, actuaciones, concursos de títulos, vendedores, espacios de juego y clases y talleres sobre kink, sexo, relaciones, activismo y temas relacionados."},{"@language":"nl","@value":"Leer- en kinkconventies vinden meestal jaarlijks plaats in een hotel, resort of andere locatie. Ze omvatten meestal feesten, optredens, titelwedstrijden, verkopers, speelruimtes en lessen en workshops over kink, seks, relaties, activisme en aanverwante onderwerpen."},{"@language":"sv","@value":"Läder- och kinkkonvent hålls vanligtvis årligen. De innehåller ofta fester, uppträdanden, tävlingar om titlar, försäljning, lekområden samt kurser och workshops om kink, sex, relationer, aktivism och relaterade ämnen."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000861"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000705"},{"@id":"https://homosaurus.org/v5/homoit0001272"},{"@id":"https://homosaurus.org/v5/homoit0003079"},{"@id":"https://homosaurus.org/v5/homoit0003106"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000861"},"dc:issued":{"@type":"xsd:date","@value":"2023-12-18"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003106","dc:identifier":"homoit0003106","skos:prefLabel":[{"@language":"en","@value":"Title contests"},{"@language":"es","@value":"Concurso de títulos"},{"@language":"nl","@value":"Titelwedstrijden"},{"@language":"sv","@value":"Titeltävlingar"}],"skos:altLabel":[{"@language":"en","@value":"Leather contests"},{"@language":"en","@value":"Leather pageants"},{"@language":"en","@value":"Titleholders"},{"@language":"es","@value":"Competencia de títulos"},{"@language":"nl","@value":"Titelhouders"}],"rdfs:comment":[{"@language":"en","@value":"An annual event in leather and kink communities where contestants compete for a title. Contestants are judged on qualities including their stage presence, appearance, charisma, and ability to be a leader and activist in the community for the length of their title year."},{"@language":"es","@value":"Un evento anual en comunidades de leather y kink donde quienes concursan compiten por un título. Se les juzga por cualidades que incluyen su presencia en el escenario, apariencia, carisma y capacidad para ser líder y activista en la comunidad durante el año del título."},{"@language":"nl","@value":"Een jaarlijks evenement in leer- en kinkgemeenschappen waar deelnemers strijden om een ​​titel. Deelnemers worden beoordeeld op kwaliteiten zoals hun podiumuitstraling, uiterlijk, charisma en het vermogen om een ​​leider en activist te zijn in de gemeenschap gedurende de lengte van hun titeljaar."},{"@language":"sv","@value":"Ett årligt evenemang inom läder- och kinkgemenskaper där deltagare tävlar om en titel. Deltagarna bedöms utifrån scenframträdande, utseende, karisma och förmåga att vara ledare och aktivist i gemenskapen under titelåret."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000818"},{"@id":"https://homosaurus.org/v5/homoit0000861"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000705"},{"@id":"https://homosaurus.org/v5/homoit0003080"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000818"},"dc:issued":{"@type":"xsd:date","@value":"2023-12-20"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001074","dc:identifier":"homoit0001074","skos:prefLabel":[{"@language":"en","@value":"Parental rights"},{"@language":"es","@value":"Derechos parentales"},{"@language":"nl","@value":"Ouderrechten"},{"@language":"sv","@value":"Föräldrarätt"}],"rdfs:comment":[{"@language":"en","@value":"The legal parent-child relationship that may be established by biological relations, at birth, or through adoption. These rights may include child custody and visitation, decision-making authority, and informational access. "},{"@language":"es","@value":"La relación legal padres-hijo que puede establecerse por relaciones biológicas, por nacimiento o por adopción. Estos derechos pueden incluir la custodia y el régimen de visitas, la toma de decisiones y el acceso a la información."},{"@language":"nl","@value":"De juridische ouder-kindrelatie die tot stand kan komen door biologische relaties, bij geboorte of door adoptie. Deze rechten kunnen betrekking hebben op voogdij over en bezoek aan kinderen, beslissingsbevoegdheid en toegang tot informatie."},{"@language":"sv","@value":"Den juridiska relationen mellan förälder och barn som kan uppstå genom biologiskt släktskap, vid födsel eller adoption. Rättigheterna kan inkludera vårdnad, umgänge, beslutanderätt och tillgång till information."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000712"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000914"},{"@id":"https://homosaurus.org/v5/homoit0000918"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000712"},"dc:replaces":{"@id":"http://homosaurus.org/v2/parentalRights"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001082","dc:identifier":"homoit0001082","skos:prefLabel":[{"@language":"en","@value":"Partner rights"},{"@language":"es","@value":"Derechos de pareja"},{"@language":"nl","@value":"Partnerrechten"},{"@language":"sv","@value":"Rättigheter för partners"}],"rdfs:comment":[{"@language":"en","@value":"Legal, economic, social, and cultural rights afforded to individuals who are in long-term partnerships (e.g., marriage, domestic partnership, civil union) that can include shared health insurance, life insurance benefits, adoption rights, and the authority to make medical and financial decisions on behalf of one's partner."},{"@language":"es","@value":"Derechos legales, económicos, sociales y culturales otorgados a personas que están en parejas a largo plazo (por ejemplo, matrimonio, pareja de hecho, unión civil) que pueden incluir seguro médico compartido, beneficios de seguro de vida, derechos de adopción y la autoridad para tomar decisiones médicas y financieras en nombre de la pareja."},{"@language":"nl","@value":"Juridische, economische, sociale en culturele rechten die worden verleend aan personen die een langdurig partnerschap hebben (bijv. huwelijk, geregistreerd partnerschap), waaronder gedeelde ziektekostenverzekeringen, uitkeringen voor levensverzekeringen, adoptierechten en de bevoegdheid om medische en financiële beslissingen namens iemands partner."},{"@language":"sv","@value":"Juridiska, ekonomiska, sociala och kulturella rättigheter som ges till personer i långvariga relationer, till exempel äktenskap, registrerat partnerskap eller samboförhållanden. Dessa rättigheter kan inkludera gemensam sjukförsäkring, arvsrätt, adoptionsrätt och rätt att fatta beslut för sin partner vid sjukdom eller i nödsituationer."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000712"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001311"},{"@id":"https://homosaurus.org/v5/homoit0002365"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000712"},"dc:replaces":{"@id":"http://homosaurus.org/v2/partnerRights"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000927","dc:identifier":"homoit0000927","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ refugees"},{"@language":"es","@value":"Refugiados LGBTQ+"},{"@language":"nl","@value":"LHBTQ+-vluchtelingen"},{"@language":"sv","@value":"Hbtq+-flyktingar"}],"skos:altLabel":[{"@language":"en","@value":"Refugees (LGBTQ)"},{"@language":"en","@value":"LGBTQ refugees"},{"@language":"es","@value":"Refugiados LGBTQ"},{"@language":"es","@value":"Refugiados (LGBTQ)"},{"@language":"sv","@value":"Flyktingar (hbtq+)"}],"rdfs:comment":[{"@language":"en","@value":"LGBTQ+ people who have fled their country due to war or armed conflict, persecution, violence, natural disasters, or other forms of conflict and are living in refugee contexts. This term is used in a sociological sense and does not require formal refugee status. For people in the process of seeking asylum, use LGBTQ+ asylum seekers."},{"@language":"es","@value":"Personas LGBTQ+ que han huido a otro país para escapar de la guerra, la persecución, los desastres naturales u otras formas de conflicto. Utilícese únicamente para personas legalmente reconocidas como refugiadas; en caso contrario, utilícese \"solicitantes de asilo LGBTQ+\"."},{"@language":"nl","@value":"LHBTQ+-personen die naar een ander land zijn gevlucht om oorlog, vervolging, natuurrampen of andere vormen van conflict te ontvluchten. Alleen gebruiken voor mensen die wettelijk erkend zijn als vluchteling; gebruik anders LHBTQ+-asielzoekers"},{"@language":"sv","@value":"Hbtq+-personer som har flytt till ett annat land för att undkomma krig, förföljelse, naturkatastrofer eller andra former av konflikt. Använd endast för personer som juridiskt erkänts som flyktingar annars använd ”Asylsökande hbtq+-personer”."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000915"},{"@id":"https://homosaurus.org/v5/homoit0004520"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000712"},{"@id":"https://homosaurus.org/v5/homoit0000883"},{"@id":"https://homosaurus.org/v5/homoit0000902"},{"@id":"https://homosaurus.org/v5/homoit0001108"},{"@id":"https://homosaurus.org/v5/homoit0001482"},{"@id":"https://homosaurus.org/v5/homoit0001815"},{"@id":"https://homosaurus.org/v5/homoit0001853"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQRefugees"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004649","dc:identifier":"homoit0004649","skos:prefLabel":{"@language":"en","@value":"Lesbian clubs (Nightlife)"},"skos:altLabel":[{"@language":"en","@value":"Lesbian discos"},{"@language":"en","@value":"Lesbian nighclubs"}],"rdfs:comment":{"@language":"en","@value":"Nightlife entertainment venues or clubs where people dance to recorded music; use in reference to venues that primarily cater to lesbians."},"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000909"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000724"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000909"},"dc:issued":{"@type":"xsd:date","@value":"2026-06-10"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-10"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001724","dc:identifier":"homoit0001724","skos:prefLabel":[{"@language":"en","@value":"Lesbian authors"},{"@language":"es","@value":"Autoras lesbianas"},{"@language":"de","@value":"Lesbische Autorinnen"},{"@language":"nl","@value":"Lesbische auteurs"},{"@language":"sv","@value":"Lesbiska författare"}],"skos:altLabel":{"@language":"de","@value":"Lesbische Schriftstellerinnen"},"rdfs:comment":[{"@language":"en","@value":"Lesbian creators of written works."},{"@language":"es","@value":"Creadoras de obras escritas conocidas por ser lesbianas."},{"@language":"de","@value":"Lesbische Verfasserinnen schriftlicher Werke."},{"@language":"nl","@value":"Lesbische makers van geschreven werken."},{"@language":"sv","@value":"Lesbiska skapare av skrivna verk."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001723"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000739"},{"@id":"https://homosaurus.org/v5/homoit0000742"},{"@id":"https://homosaurus.org/v5/homoit0000750"},{"@id":"https://homosaurus.org/v5/homoit0000762"},{"@id":"https://homosaurus.org/v5/homoit0001603"},{"@id":"https://homosaurus.org/v5/homoit0001730"},{"@id":"https://homosaurus.org/v5/homoit0002178"},{"@id":"https://homosaurus.org/v5/homoit0001615"},{"@id":"https://homosaurus.org/v5/homoit0003867"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh99014708"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2021-11-02"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004302","dc:identifier":"homoit0004302","skos:prefLabel":[{"@language":"en","@value":"Lesbian historical fiction"},{"@language":"nl","@value":"Lesbische historische literatuur"},{"@language":"sv","@value":"Lesbiska historiska skildringar"}],"skos:altLabel":{"@language":"sv","@value":"Lesbiska historiska romaner"},"rdfs:comment":[{"@language":"en","@value":"Genre of written works that depicts events set during particular real historical events. Use for historical fiction focusing on lesbian characters or themes."},{"@language":"nl","@value":"Geschreven fictieve werken waarin het verhaal zich afspeelt tegen de achtergrond van specifieke, waargebeurde historische gebeurtenissen; gebruik in verwijzing naar historische fictie met lesbische personages of thema's."},{"@language":"sv","@value":"Skönlitterära verk som utspelar sig i historisk tid, med verkliga händelser och miljöer. Används för historiska skildringar med fokus på lesbiska karaktärer eller teman."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000742"},{"@id":"https://homosaurus.org/v5/homoit0004295"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2026-02-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001581","dc:identifier":"homoit0001581","skos:prefLabel":[{"@language":"en","@value":"Lesbian horror fiction"},{"@language":"es","@value":"Ficción de horror lésbica"},{"@language":"de","@value":"Lesbische Horror-Fiction"},{"@language":"nl","@value":"Lesbische horrorverhalen"},{"@language":"sv","@value":"Lesbisk skräck"}],"skos:altLabel":{"@language":"es","@value":"Ficción lésbica de terror"},"rdfs:comment":[{"@language":"en","@value":"Genre of written works that intend to frighten, scare, or disgust. Use for horror fiction focusing on lesbian characters or themes."},{"@language":"es","@value":"Obras de ficción escritas con la intención de asustar, atemorizar o provocar disgusto; utilícese en referencia a la ficción de horror centrada en personajes o temas lésbicos."},{"@language":"de","@value":"Fiktionale Werke, die erschrecken, ängstigen oder abstoßen sollen; Verwendung in Bezug auf fiktionale Werke, die sich auf lesbische Charaktere oder Themen konzentrieren."},{"@language":"nl","@value":"Geschreven fictie bedoeld om angst aan te jagen, bang te maken of te walgen; gebruik in verwijzing naar horrorfictie gericht op lesbische personages of thema's."},{"@language":"sv","@value":"Skönlitterära verk skrivna för att skrämma, oroa eller äckla. Används för skräcklitteratur med lesbiska karaktärer eller teman."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001580"},{"@id":"https://homosaurus.org/v5/homoit0000742"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianHorrorFiction"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-03"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001565","dc:identifier":"homoit0001565","skos:prefLabel":[{"@language":"en","@value":"Lesbian fantasy fiction"},{"@language":"es","@value":"Ficción fantástica lésbica"},{"@language":"nl","@value":"Lesbische fantasy"},{"@language":"sv","@value":"Lesbisk fantasy"}],"rdfs:comment":[{"@language":"en","@value":"Genre of written works that depicts magical, fantastical, and/or supernatural elements. Use for fantasy fiction focusing on lesbian characters or themes."},{"@language":"es","@value":"Obras escritas que incluyan elementos mágicos o fantásticos; utilícese en referencia a la ficción fantástica centrada en personajes o temas lésbicos."},{"@language":"nl","@value":"Geschreven werken met magische of fantastische elementen; gebruik in verwijzing naar fantasy gericht op lesbische personages of thema's."},{"@language":"sv","@value":"Genre som använder magi och andra övernaturliga fenomen som centrala inslag i handling, tema och/eller miljö. Används för fantasy med lesbiska karaktärer eller teman."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000865"},{"@id":"https://homosaurus.org/v5/homoit0000742"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianFantasyFiction"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-03"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001570","dc:identifier":"homoit0001570","skos:prefLabel":[{"@language":"en","@value":"Lesbian science fiction"},{"@language":"es","@value":"Ciencia ficción lésbica"},{"@language":"de","@value":"Lesbische Science-Fiction"},{"@language":"nl","@value":"Lesbische science fiction"},{"@language":"sv","@value":"Lesbisk science fiction"}],"skos:altLabel":[{"@language":"sv","@value":"Lesbisk sci fi"},{"@language":"sv","@value":"Lesbisk sf"}],"rdfs:comment":[{"@language":"en","@value":"Genre of written works that depicts imaginative or futuristic concepts incorporating science, technology, space, time travel, and other speculative elements. Use for science fiction focusing on lesbian characters or themes."},{"@language":"es","@value":"Obras literarias escritas sobre conceptos imaginativos o futuristas que incorporen la ciencia, la tecnología, el espacio, los viajes en el tiempo y otros elementos especulativos; utilícese en referencia a la ciencia ficción centrada en personajes y temas lésbicos."},{"@language":"de","@value":"Werk über phantasievolle oder futuristische Konzepte, die Wissenschaft, Technologie, Raumfahrt, Zeitreisen und andere spekulative Elemente beinhalten; Verwendung in Bezug auf Science Fiction mit einem Schwerpunkt auf lesbischen Charakteren oder Themen."},{"@language":"nl","@value":"Geschreven literair werk over fantasierijke of futuristische concepten waarin wetenschap, technologie, ruimte, tijdreizen en andere speculatieve elementen zijn verwerkt; gebruik in verwijzing naar science fiction gericht op lesbische personages of thema's."},{"@language":"sv","@value":"Skönlitterära verk om imaginära eller futuristiska koncept som involverar vetenskap, teknologi, rymden, tidsresor och andra spekulativa element. Används för science fiction med lesbiska karaktärer eller teman."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000934"},{"@id":"https://homosaurus.org/v5/homoit0000742"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianScienceFiction"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-03"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001592","dc:identifier":"homoit0001592","skos:prefLabel":[{"@language":"en","@value":"Lesbian romance fiction"},{"@language":"es","@value":"Ficción romántica lésbica"},{"@language":"de","@value":"Lesbische Liebesromane"},{"@language":"nl","@value":"Lesbische liefdesverhalen"},{"@language":"sv","@value":"Lesbiska kärleksromaner"}],"skos:altLabel":[{"@language":"sv","@value":"Lesbiska kärleksskildringar"},{"@language":"sv","@value":"Lesbisk romance"}],"rdfs:comment":[{"@language":"en","@value":"Genre of written works that depicts romantic and/or sexual relationships between the main characters. Use for romance fiction focusing on lesbian characters or themes."},{"@language":"es","@value":"Obras literarias escritas centradas en las relaciones románticas y en el amor entre personas; utilícese en referencia a la ficción romántica centrada en personajes y temas lésbicos."},{"@language":"de","@value":"Werke der Belletristik, die sich um romantische und/oder sexuelle Beziehungen zwischen den Hauptfiguren drehen; Verwendung in Bezug auf Liebesromane, die sich auf lesbische Figuren und Themen konzentrieren."},{"@language":"nl","@value":"Geschreven literair werk gericht op romantische relaties en liefde tussen mensen; gebruik in verwijzing naar romantische fictie gericht op lesbische personages of thema's."},{"@language":"sv","@value":"Skönlitterära verk som kretsar kring romantiska och/eller sexuella relationer mellan huvudkaraktärerna. Används för kärleksromaner med lesbiska karaktärer."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001586"},{"@id":"https://homosaurus.org/v5/homoit0000742"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianRomanceFiction"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-03"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001575","dc:identifier":"homoit0001575","skos:prefLabel":[{"@language":"en","@value":"Lesbian mystery and detective fiction"},{"@language":"es","@value":"Ficción lésbica de misterio y de detectives"},{"@language":"nl","@value":"Lesbische detectiveverhalen"},{"@language":"sv","@value":"Lesbiska deckare"}],"skos:altLabel":{"@language":"es","@value":"Ficción de misterio y detectives lésbica"},"rdfs:comment":[{"@language":"en","@value":"Genre of written works that depicts the investigation of crime or the work of detectives. Use for mystery and detective fiction focusing on lesbian characters or themes."},{"@language":"es","@value":"Obras literarias escritas sobre la investigación de crímenes o el trabajo de detectives; utilícese en referencia a la ficción de misterio y de detectives centrada en personajes y temas lésbicos."},{"@language":"nl","@value":"Geschreven literaire werken over misdaadonderzoek of het werk van rechercheurs; gebruik in verwijzing naar mysterie en detective fictie gericht op lesbische personages en thema's."},{"@language":"sv","@value":"Skönlitterära verk om brottsutredningar eller detektivarbete. Används för deckare och mysterielitteratur med lesbiska karaktärer eller teman."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000852"},{"@id":"https://homosaurus.org/v5/homoit0000742"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianMysteryAndDectectiveFiction"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-03"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002220","dc:identifier":"homoit0002220","skos:prefLabel":[{"@language":"ja","@value":"Yuri"},{"@language":"es","@value":"Yuri"},{"@language":"nl","@value":"Yuri"},{"@language":"sv","@value":"Yuri"}],"rdfs:comment":[{"@language":"en","@value":"A genre focusing on the romantic or sexual relationships between female characters from anime and manga."},{"@language":"es","@value":"Un género del anime y manga que se centra en las relaciones románticas o sexuales entre personajes femeninos."},{"@language":"nl","@value":"Een genre dat zich richt op de romantische of seksuele relaties tussen vrouwelijke personages uit anime en manga"},{"@language":"sv","@value":"En genre som fokuserar på romantiska eller sexuella relationer mellan kvinnliga karaktärer i anime och manga."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002221"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000742"},{"@id":"https://homosaurus.org/v5/homoit0001597"},{"@id":"https://homosaurus.org/v5/homoit0002162"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003507","dc:identifier":"homoit0003507","skos:prefLabel":[{"@language":"en","@value":"Girls’ Love (Genre)"},{"@language":"de","@value":"Girl's Love"},{"@language":"es","@value":"Girls' Love (género)"},{"@language":"nl","@value":"Meisjesliefde (Genre)"},{"@language":"sv","@value":"Girls’ Love (genre)"}],"skos:altLabel":[{"@language":"en","@value":"GL (Genre)"},{"@language":"de","@value":"GL"},{"@language":"de","@value":"Yuri"},{"@language":"es","@value":"GL"},{"@language":"es","@value":"Girls' love"},{"@language":"es","@value":"Amor de chicas"},{"@language":"nl","@value":"GL (Genre)"}],"rdfs:comment":[{"@language":"en","@value":"A genre focusing on the romantic or sexual relationships between female characters in anime, dramas, comics, novels, and movies. The term is usually used to describe media originating from Asia."},{"@language":"de","@value":"Ein Genre, das sich auf die romantischen oder sexuellen Beziehungen zwischen weiblichen Figuren in Anime, Dramen, Comics, Romanen und Filmen konzentriert. Der Begriff wird in der Regel verwendet, um Medien aus Asien zu beschreiben."},{"@language":"es","@value":"Un género literario que se centra en las relaciones románticas o sexuales entre personajes femeninos en anime, dramas, cómics, novelas y películas. El término se utiliza habitualmente para describir los productos mediáticos procedentes de Asia."},{"@language":"nl","@value":"Een genre dat zich richt op de romantische of seksuele relaties tussen vrouwelijke personages in anime, drama's, strips, romans en films. De term wordt meestal gebruikt om media te beschrijven die afkomstig zijn uit Azië."},{"@language":"sv","@value":"En genre som fokuserar på romantiska eller sexuella relationer mellan kvinnliga karaktärer i anime, serier, romaner och filmer. Termen används oftast för media med ursprung i Asien."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002144"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0002221"},{"@id":"https://homosaurus.org/v5/homoit0003508"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000742"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2024-07-31"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003508","dc:identifier":"homoit0003508","skos:prefLabel":[{"@language":"en","@value":"Baihe"},{"@language":"de","@value":"Baihe"},{"@language":"es","@value":"Baihe"},{"@language":"nl","@value":"Baihe"},{"@language":"sv","@value":"Baihe"}],"skos:altLabel":[{"@language":"en","@value":"Bǎihé"},{"@language":"de","@value":"Bǎihé"},{"@language":"es","@value":"Bǎihé"}],"rdfs:comment":[{"@language":"en","@value":"A genre focusing on the romantic or sexual relationships between female characters in Chinese novels, comics, movies, animation, and dramas. "},{"@language":"de","@value":"Ein Genre, das sich auf die romantischen oder sexuellen Beziehungen zwischen weiblichen Figuren in chinesischen Romanen, Comics, Filmen, Animationen und Dramen fokussiert."},{"@language":"es","@value":"Género literario que se centra en las relaciones románticas o sexuales entre personajes femeninos en novelas, cómics, películas, animación y dramas chinos."},{"@language":"nl","@value":"Een genre dat zich richt op de romantische of seksuele relaties tussen vrouwelijke personages in Chinese romans, strips, films, animaties en drama's."},{"@language":"sv","@value":"Genre som fokuserar på romantiska eller sexuella relationer mellan kvinnliga karaktärer i kinesiska romaner, serier, filmer, animationer och pjäser."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0003507"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000742"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2024-07-31"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000746","dc:identifier":"homoit0000746","skos:prefLabel":[{"@language":"en","@value":"Lesbian land"},{"@language":"es","@value":"Tierra lesbiana"},{"@language":"nl","@value":"Lesbisch land"},{"@language":"sv","@value":"Lesbiskt land"}],"skos:altLabel":[{"@language":"es","@value":"Lesbianland"},{"@language":"sv","@value":"Lesbian land"},{"@language":"sv","@value":"Lesbisk landsbygd"}],"rdfs:comment":[{"@language":"en","@value":"Rural communities populated only by lesbians."},{"@language":"es","@value":"Comunidades rurales habitadas únicamente por lesbianas."},{"@language":"nl","@value":"plattelandsgemeenschappen uitsluitend bevolkt door lesbische vrouwen"},{"@language":"sv","@value":"Lesbiska landsbygdsgemenskaper eller småsamhällen på landsbygden."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000778"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000753"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000778"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianLand"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000749","dc:identifier":"homoit0000749","skos:prefLabel":[{"@language":"en","@value":"Lesbian libraries"},{"@language":"es","@value":"Bibliotecas lesbianas"},{"@language":"de","@value":"Lesbische Bibliotheken"},{"@language":"nl","@value":"Lesbische bibliotheken"},{"@language":"sv","@value":"Lesbiska bibliotek"}],"skos:altLabel":[{"@language":"es","@value":"Bibliotecas lésbicas"},{"@language":"de","@value":"Bibliotheken für Lesben"},{"@language":"de","@value":"Lesben-Bibliotheken"}],"rdfs:comment":[{"@language":"en","@value":"Libraries that hold materials primarily pertaining to lesbians or intended for use by lesbians."},{"@language":"es","@value":"Bibliotecas que contienen materiales relacionados principalmente con lesbianas o destinados a ser utilizados por lesbianas."},{"@language":"de","@value":"Bibliotheken, die in erster Linie Materialien zu Lesben und lesbischen Themen oder für die Nutzung durch Lesben bereithalten."},{"@language":"nl","@value":"Bibliotheken met materiaal dat voornamelijk betrekking heeft op lesbische vrouwen of bedoeld is voor gebruik door lesbische vrouwen."},{"@language":"sv","@value":"Bibliotek som samlar material som främst rör lesbiska eller är avsett att användas av lesbiska."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000968"},{"@id":"https://homosaurus.org/v5/homoit0001513"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh89000079"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001755"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianLibraries"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001513","dc:identifier":"homoit0001513","skos:prefLabel":[{"@language":"en","@value":"Women's libraries"},{"@language":"es","@value":"Bibliotecas de mujeres"},{"@language":"de","@value":"Frauenbibliotheken"},{"@language":"nl","@value":"Vrouwenbibliotheken"},{"@language":"sv","@value":"Kvinnobibliotek"}],"skos:altLabel":[{"@language":"es","@value":"Bibliotecas para mujeres"},{"@language":"de","@value":"Frauen-Bibliotheken"},{"@language":"de","@value":"Bibliotheken für Frauen"}],"rdfs:comment":[{"@language":"en","@value":"Libraries that hold materials primarily pertaining to women or intended for use by women."},{"@language":"es","@value":"Bibliotecas que contienen materiales principalmente relacionados con mujeres o para el uso de mujeres."},{"@language":"de","@value":"Bibliotheken, die in erster Linie Materialien zu Frauen oder für die Nutzung durch Frauen bereithalten."},{"@language":"nl","@value":"Bibliotheken die materialen bevatten die voornamelijk betrekking hebben op vrouwen of voor gebruik door vrouwen."},{"@language":"sv","@value":"Bibliotek som samlar material som främst rör kvinnor eller är avsett att användas av kvinnor."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000968"},"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0000749"},"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh88005244"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001755"},"dc:replaces":{"@id":"http://homosaurus.org/v2/womensLibraries"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000750","dc:identifier":"homoit0000750","skos:prefLabel":[{"@language":"en","@value":"Lesbian literature"},{"@language":"es","@value":"Literatura lésbica"},{"@language":"nl","@value":"Lesbische literatuur"},{"@language":"sv","@value":"Lesbisk litteratur"}],"skos:altLabel":{"@language":"es","@value":"Literatura lesbiana"},"rdfs:comment":[{"@language":"en","@value":"Written literary works about lesbian characters or themes."},{"@language":"es","@value":"Obras literarias escritas sobre personajes o temas lésbicos."},{"@language":"nl","@value":"Geschreven literaire werken over lesbische personages of thema's"},{"@language":"sv","@value":"Skrivna litterära verk om lesbiska karaktärer eller teman."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000972"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001724"},{"@id":"https://homosaurus.org/v5/homoit0004019"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianLiterature"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004019","dc:identifier":"homoit0004019","skos:prefLabel":[{"@language":"en","@value":"Lesbians in literature"},{"@language":"nl","@value":"Lesbische vrouwen in de literatuur"},{"@language":"sv","@value":"Lesbiska i litteraturen"}],"rdfs:comment":[{"@language":"en","@value":"The depiction of lesbians in literature."},{"@language":"nl","@value":"Het weergeven van lesbische vrouwen in de literatuur."},{"@language":"sv","@value":"Skildringen av lesbiska i litteraturen."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0004018"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000750"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh94006245"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2025-04-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000757","dc:identifier":"homoit0000757","skos:prefLabel":[{"@language":"en","@value":"Lesbian nation"},{"@language":"es","@value":"Nación lésbica"},{"@language":"nl","@value":"Lesbian nation"},{"@language":"sv","@value":"Lesbisk nation"}],"skos:altLabel":[{"@language":"es","@value":"Nación lesbiana"},{"@language":"es","@value":"Lesbian land"},{"@language":"sv","@value":"Lesbian nation"}],"rdfs:comment":[{"@language":"en","@value":"An imagined autonomous, international lesbian community that is set apart from men."},{"@language":"es","@value":"Una comunidad imaginada lésbica, internacional y autónoma, separada de los hombres."},{"@language":"nl","@value":"denkbeeldige, autonome, internationale lesbische gemeenschap, gescheiden van mannen"},{"@language":"sv","@value":"En tänkt autonom, internationell lesbisk gemenskap som är avskild från män."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000778"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000753"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000778"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianNation"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000766","dc:identifier":"homoit0000766","skos:prefLabel":[{"@language":"en","@value":"Lesbian press"},{"@language":"es","@value":"Prensa lésbica"},{"@language":"nl","@value":"Lesbische pers"},{"@language":"sv","@value":"Lesbisk press"}],"skos:altLabel":{"@language":"es","@value":"Diarios lésbica"},"rdfs:comment":[{"@language":"en","@value":"Newspapers, magazines, or other publishing outlets aimed at lesbian audiences and/or operated by lesbians."},{"@language":"es","@value":"Periódicos, revistas u otros medios editoriales dirigidos a audiencias lésbicas y/o operados por lesbianas."},{"@language":"nl","@value":"Kranten, tijdschriften of andere publicaties die gericht zijn op lesbische vrouwen en/of worden gerund door lesbische vrouwen"},{"@language":"sv","@value":"Tidningar, tidskrifter eller andra publikationer riktade till lesbiska och/eller drivna av lesbiska."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001132"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000759"},{"@id":"https://homosaurus.org/v5/homoit0000760"},{"@id":"https://homosaurus.org/v5/homoit0003155"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000753"},{"@id":"https://homosaurus.org/v5/homoit0004427"},{"@id":"https://homosaurus.org/v5/homoit0004623"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001132"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianPress"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000772","dc:identifier":"homoit0000772","skos:prefLabel":[{"@language":"en","@value":"Lesbian radio"},{"@language":"es","@value":"Radio lésbica"},{"@language":"nl","@value":"Lesbische radio"},{"@language":"sv","@value":"Lesbisk radio"}],"skos:altLabel":{"@language":"es","@value":"Radio lesbiana"},"rdfs:comment":[{"@language":"en","@value":"Auditory content broadcast on the radio (analog or digital) about lesbians and lesbian issues."},{"@language":"es","@value":"Contenido auditivo emitido en radio (analógica o digital) sobre lesbianas y asuntos lésbicos."},{"@language":"nl","@value":"Auditieve inhoud uitgezonden op de radio (analoog of digitaal) over lesbische vrouwen en lesbische kwesties."},{"@language":"sv","@value":"Ljudinnehåll som sänds i radio, analog eller digital, och som handlar om lesbiska eller lesbiska frågor."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001231"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000753"},{"@id":"https://homosaurus.org/v5/homoit0004318"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001231"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianRadio"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000787","dc:identifier":"homoit0000787","skos:prefLabel":[{"@language":"en","@value":"Lesbian television"},{"@language":"es","@value":"Televisión lésbica"},{"@language":"nl","@value":"Lesbische televisie"},{"@language":"sv","@value":"Lesbisk tv"}],"rdfs:comment":[{"@language":"en","@value":"Television shows featuring lesbian characters or themes."},{"@language":"es","@value":"Programas de televisión con personajes o temas lésbicos."},{"@language":"nl","@value":"Televisieprogramma's met lesbische vrouwen of lesbische thema's."},{"@language":"sv","@value":"Tv-program med lesbiska karaktärer eller teman som rör lesbiska."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001359"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000753"},"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2007002902"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001359"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianTelevision"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000754","dc:identifier":"homoit0000754","skos:prefLabel":[{"@language":"en","@value":"Lesbian museums"},{"@language":"es","@value":"Museos de lesbianas"},{"@language":"nl","@value":"Lesbische musea"},{"@language":"sv","@value":"Lesbiska museum"}],"skos:altLabel":{"@language":"es","@value":"Museos lésbicos"},"rdfs:comment":[{"@language":"en","@value":"Institutions dedicated to the storage, exhibition, conservation, and preservation of materials relating to lesbians and lesbian history."},{"@language":"es","@value":"Instituciones dedicadas al almacenamiento, la exhibición, la conservación y la preservación de materiales relacionados con las lesbianas y la historia lésbica."},{"@language":"nl","@value":"Instellingen die zich toeleggen op de opslag, tentoonstelling, conservering en bewaring van materialen met betrekking tot lesbische vrouwen en lesbische geschiedenis"},{"@language":"sv","@value":"Institutioner som ägnar sig åt insamling, utställning, bevarande och konservering av material som rör lesbiskhet, lesbiska personer eller lesbisk historia."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001030"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001755"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianMuseums"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001515","dc:identifier":"homoit0001515","skos:prefLabel":[{"@language":"en","@value":"Women's music festivals"},{"@language":"es","@value":"Festivales de música para mujeres"},{"@language":"de","@value":"Frauenmusikfestivals"},{"@language":"nl","@value":"Vrouwenmuziekfestivals"},{"@language":"sv","@value":"Kvinnomusikfestivaler"}],"skos:altLabel":{"@language":"es","@value":"Festivales de música de mujeres"},"rdfs:comment":[{"@language":"en","@value":"Organized events typically lasting more than one day that feature performances by women’s musical groups and performers. Though centered on music, women’s music festivals may also incorporate aspects of lesbian and feminist culture by offering workshops, arts and crafts, and community resources."},{"@language":"es","@value":"Eventos organizados que suelen durar más de un día y que cuentan con presentaciones de artistas y grupos musicales de mujeres. Aunque se centran en la música, los festivales de música para mujeres también pueden incorporar aspectos de la cultura lésbica y feminista al ofrecer talleres, artes y manualidades, y recursos comunitarios."},{"@language":"de","@value":"Organisierte Veranstaltungen, die in der Regel länger als einen Tag dauern und bei denen Musikgruppen und Künstlerinnen auftreten. Obwohl Musik im Mittelpunkt steht, können Frauenmusikfestivals auch Aspekte der lesbischen und feministischen Kultur einbeziehen, indem sie Workshops, Kunsthandwerk und Gemeinschaftsressourcen anbieten."},{"@language":"nl","@value":"Georganiseerde evenementen die meestal meer dan een dag duren en optredens bevatten van vrouwenmuziekgroepen en -artiesten. Hoewel muziek centraal staat, kunnen vrouwenmuziekfestivals ook aspecten van lesbische en feministische cultuur bevatten door workshops, kunstnijverheid etc. aan te bieden."},{"@language":"sv","@value":"Organiserade evenemang som vanligtvis pågår i flera dagar och där kvinnliga musikgrupper och artister uppträder. Även om musik står i centrum kan festivalerna innehålla inslag av lesbisk och feministisk kultur, såsom workshops, hantverk och aktiviteter med feministiskt eller lesbiskt fokus."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0003607"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000755"},{"@id":"https://homosaurus.org/v5/homoit0001516"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh99003279"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0003607"},"dc:replaces":{"@id":"http://homosaurus.org/v2/womensMusicFestivals"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003166","dc:identifier":"homoit0003166","skos:prefLabel":[{"@language":"en","@value":"Lesbian operas"},{"@language":"es","@value":"Óperas lesbiana"},{"@language":"nl","@value":"Lesbische opera's"},{"@language":"sv","@value":"Lesbisk opera"}],"skos:altLabel":{"@language":"es","@value":"Óperas lésbicas"},"rdfs:comment":[{"@language":"en","@value":"Operas created by lesbian directors, depicting lesbian individuals, or that are regarded as important within lesbian culture."},{"@language":"es","@value":"Óperas creadas por directoras lesbianas, que representan a personas lesbianas, o a personas consideradas importantes dentro de la cultura lésbica."},{"@language":"nl","@value":"Opera's gemaakt door lesbische regisseurs, waarin lesbische personen worden afgebeeld, of die binnen de lesbische cultuur als belangrijk worden beschouwd."},{"@language":"sv","@value":"Operor skapade av lesbiska regissörer, som skildrar lesbiska eller som betraktas som viktiga inom lesbisk kultur."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002886"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000755"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2024-01-09"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000756","dc:identifier":"homoit0000756","skos:prefLabel":[{"@language":"en","@value":"Lesbian Muslims"},{"@language":"es","@value":"Musulmanas lesbianas"},{"@language":"nl","@value":"Lesbische moslims"},{"@language":"sv","@value":"Lesbiska muslimer"}],"rdfs:comment":[{"@language":"en","@value":"Lesbians who are Muslim."},{"@language":"es","@value":"Lesbianas que son musulmanas."},{"@language":"nl","@value":"Lesbische vrouwen die moslim zijn."},{"@language":"sv","@value":"Lesbiska som är muslimer."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001032"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2018001970"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000928"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianMuslims"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000758","dc:identifier":"homoit0000758","skos:prefLabel":[{"@language":"en","@value":"Native American lesbians"},{"@language":"es","@value":"Lesbianas nativoamericanas"},{"@language":"nl","@value":"Indiaans-Amerikaanse lesbische vrouwen"},{"@language":"sv","@value":"Lesbiska ursprungsamerikaner"}],"skos:altLabel":[{"@language":"en","@value":"American Indian lesbians"},{"@language":"en","@value":"Lesbian Native Americans"},{"@language":"nl","@value":"Native American lesbische vrouwen"}],"rdfs:comment":[{"@language":"en","@value":"People who are part of the Native peoples of the continental United States and Canada (excluding Inuit people) and self-identity as lesbians. Use more specific terms when available."},{"@language":"es","@value":"Lesbianas que son nativoamericanas o parte de los pueblos indígenas de Norteamérica; utilícese únicamente para personas que se autoidentifiquen como nativoamericanas y lesbianas."},{"@language":"nl","@value":"Lesbische vrouwen die Native American zijn, of deel uitmaken van de inheemse volkeren van Noord-Amerika; alleen gebruiken voor personen die zichzelf identificeren als Native American en lesbische vrouw."},{"@language":"sv","@value":"Personer som tillhör ursprungsfolken i det kontinentala USA och Kanada (exklusive inuiter) och som identifierar sig som lesbiska. Använd mer specifika termer där det är möjligt."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001037"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianNativeAmericans"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000759","dc:identifier":"homoit0000759","skos:prefLabel":[{"@language":"en","@value":"Lesbian newsletters"},{"@language":"es","@value":"Boletines lésbicos"},{"@language":"nl","@value":"Lesbische nieuwsbrieven"},{"@language":"sv","@value":"Lesbiska nyhetsbrev"}],"rdfs:comment":[{"@language":"en","@value":"Serialized print or digital periodicals created by or for lesbians, often with the purpose of sharing news and information related to lesbian communities and lesbian issues."},{"@language":"es","@value":"Publicaciones impresas o digitales serializadas sobre lesbianas o temas lésbicos (y generalmente producidas por lesbianas u organizaciones de lesbianas) que contienen noticias, artículos, columnas, correspondencia y anuncios."},{"@language":"nl","@value":"Periodieke gedrukte of digitale tijdschriften gemaakt door of voor lesbische vrouwen, vaak met als doel het delen van nieuws en informatie met betrekking tot lesbische gemeenschappen en lesbische kwesties."},{"@language":"sv","@value":"Seriella tryckta eller digitala tidskrifter skapade av eller för lesbiska, ofta i syfte att dela nyheter och information relaterad till lesbiska frågor och lesbiska gemenskaper."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000766"},{"@id":"https://homosaurus.org/v5/homoit0001041"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000760"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001132"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianNewsletters"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000760","dc:identifier":"homoit0000760","skos:prefLabel":[{"@language":"en","@value":"Lesbian newspapers"},{"@language":"es","@value":"Periódicos lésbicos"},{"@language":"nl","@value":"Lesbische bladen"},{"@language":"sv","@value":"Lesbiska tidningar"}],"skos:altLabel":{"@language":"es","@value":"Diarios lésbicos"},"rdfs:comment":[{"@language":"en","@value":"Serialized print or digital publications about lesbians or lesbian issues (and typically produced by lesbians or lesbian organizations) that contain news, articles, columns, correspondence, and advertisements."},{"@language":"es","@value":"Publicaciones periódicas impresas o digitales serializadas creadas por o para lesbianas, a menudo con el propósito de compartir noticias e información relacionadas con cuestiones y comunidades lésbicas."},{"@language":"nl","@value":"Periodieke gedrukte of digitale publicaties over lesbische vrouwen en lesbische kwesties (meestal geproduceerd door lesbische vrouwen of lesbische organisaties) die nieuws, artikelen, columns, correspondentie en advertenties bevatten."},{"@language":"sv","@value":"Seriella tryckta eller digitala publikationer om lesbiska eller lesbiska frågor (vanligtvis producerade av lesbiska personer eller organisationer) som innehåller nyheter, artiklar, krönikor, korrespondens och annonser."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000766"},{"@id":"https://homosaurus.org/v5/homoit0001042"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000759"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001132"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianNewspapers"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000761","dc:identifier":"homoit0000761","skos:prefLabel":[{"@language":"en","@value":"Lesbian Pagans"},{"@language":"es","@value":"Paganas lesbianas"},{"@language":"nl","@value":"Lesbische paganisten"},{"@language":"sv","@value":"Lesbiska hedningar"}],"skos:altLabel":[{"@language":"es","@value":"Lesbianas paganas"},{"@language":"sv","@value":"Lesbiska nyhedningar"}],"rdfs:comment":[{"@language":"en","@value":"Lesbians who are members of polytheistic religions or other religions outside of the dominant culture that typically incorporate nature worship and/or the sacred feminine, such as Wicca, Druidry, Heathenry, etc. Use to describe lesbians who self-identify as Pagan."},{"@language":"es","@value":"Lesbianas que son miembros de religiones politeístas u otras religiones fuera de la cultura dominante que típicamente incorporan el culto a la naturaleza y/o lo sagrado femenino, como la Wicca, el druidismo, el paganismo, etc. Utilícese para describir a lesbianas que se autoidentifiquen como paganas."},{"@language":"sv","@value":"Lesbiska som tillhör polyteistiska religioner, eller andra religioner utanför den dominerande kulturen, som ofta innefattar naturdyrkan och/eller det heliga feminina, såsom wicca, druidism, hednisk tro m.m. Används för lesbiska som själva identifierar sig som hedningar."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001069"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001908"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000928"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianPagans"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000762","dc:identifier":"homoit0000762","skos:prefLabel":[{"@language":"en","@value":"Lesbian poetry"},{"@language":"es","@value":"Poesía lésbica"},{"@language":"nl","@value":"Lesbische poëzie"},{"@language":"sv","@value":"Lesbisk poesi"}],"skos:altLabel":[{"@language":"es","@value":"Poesía lesbiana"},{"@language":"sv","@value":"Lesbisk lyrik"}],"rdfs:comment":[{"@language":"en","@value":"Literary work, typically written in verse, that focuses on lesbian characters, lesbian themes, or lesbian identity."},{"@language":"es","@value":"Obras literarias, normalmente escritas en verso, que se centran en personajes lésbicos, temas lésbicos o identidad lésbica."},{"@language":"nl","@value":"Literair werk, meestal in verzen geschreven, dat zich richt op lesbische personages, thema's of identiteit."},{"@language":"sv","@value":"Lyriska verk med fokus på lesbiska karaktärer, teman eller identitet."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001118"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001724"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2008106915"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianPoetry"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000764","dc:identifier":"homoit0000764","skos:prefLabel":[{"@language":"en","@value":"Lesbian political groups"},{"@language":"es","@value":"Grupos politicos lésbicos"},{"@language":"nl","@value":"Lesbische politieke groepen"},{"@language":"sv","@value":"Lesbiska politiska grupper"}],"rdfs:comment":[{"@language":"en","@value":"Organized groups centered on political change and action for lesbian rights; may include advocating for lesbianism as a political and feminist choice against sexism."},{"@language":"es","@value":"Grupos organizados centrados en el cambio político y la acción por los derechos de las lesbianas; puede incluir la defensa del lesbianismo como una opción política y feminista contra el sexismo."},{"@language":"nl","@value":"Georganiseerde groepen gericht op politieke verandering en actie voor lesbische rechten; kan het pleiten voor lesbianisme als een politieke en feministische keuze tegen seksisme inhouden."},{"@language":"sv","@value":"Organiserade grupper med fokus på politisk förändring och aktivism för lesbiska rättigheter. Kan även inkludera förespråkande för lesbiskhet som ett feministiskt och politiskt val mot sexism."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0003521"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0003521"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianPoliticalGroups"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002329","dc:identifier":"homoit0002329","skos:prefLabel":[{"@language":"en","@value":"Lesbian films"},{"@language":"es","@value":"Películas lésbicas"},{"@language":"nl","@value":"Lesbische films"},{"@language":"sv","@value":"Lesbiska filmer"}],"skos:altLabel":[{"@language":"en","@value":"Lesbian movies"},{"@language":"sv","@value":"Flatfilmer"}],"rdfs:comment":[{"@language":"en","@value":"Motion pictures, or movies, created by lesbian directors, depicting lesbians, or that are regarded as important within lesbian culture."},{"@language":"es","@value":"Películas creadas por directoras lesbianas, que representan a lesbianas o a personas consideradas importantes dentro de la cultura lésbica."},{"@language":"nl","@value":"Bewegende beelden, of films, gemaakt door lesbische regisseurs, waarin lesbische vrouwen worden afgebeeld, of die als belangrijk worden beschouwd binnen de lesbische cultuur."},{"@language":"sv","@value":"Filmer skapade av lesbiska regissörer, som skildrar lesbiska eller som betraktas som betydelsefulla inom lesbisk kultur."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000869"},{"@id":"https://homosaurus.org/v5/homoit0002328"}],"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0000765"},"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh88001611"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-11-15"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002607","dc:identifier":"homoit0002607","skos:prefLabel":[{"@language":"en","@value":"Lesbian erotic art "},{"@language":"es","@value":"Arte erótico lésbico"},{"@language":"nl","@value":"Lesbische erotische kunst"},{"@language":"sv","@value":"Lesbisk erotisk konst"}],"rdfs:comment":[{"@language":"en","@value":"Erotic art, created by lesbian artists, depicting lesbian people, or that are regarded as important within lesbian culture."},{"@language":"es","@value":"Arte erótico, creado por artistas lesbianas, que representa a lesbianas o a personas consideradas importantes dentro de la cultura lésbica."},{"@language":"nl","@value":"Erotische kunst, gemaakt door lesbische kunstenaars, waarin lesbische personen worden afgebeeld, of die binnen de lesbische cultuur als belangrijk worden beschouwd."},{"@language":"sv","@value":"Erotisk konst skapad av konstnärer som är lesbiska, som avbildar lesbiska personer eller som anses betydelsefull inom lesbisk kultur."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002579"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000765"},{"@id":"https://homosaurus.org/v5/homoit0002546"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0002599"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh96007206"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002546","dc:identifier":"homoit0002546","skos:prefLabel":[{"@language":"en","@value":"Lesbian erotic films"},{"@language":"es","@value":"Películas eróticas lésbicas"},{"@language":"de","@value":"Lesbische erotische Filme"},{"@language":"nl","@value":"Lesbische erotische films"},{"@language":"sv","@value":"Lesbisk erotisk film"}],"skos:altLabel":{"@language":"de","@value":"Erotische Lesbenfilme"},"rdfs:comment":[{"@language":"en","@value":"Erotic films or movies, created by lesbian directors, depicting lesbian people, or that are regarded as important within lesbian culture."},{"@language":"es","@value":"Filmes o películas eróticas, creadas por directoras lesbianas, que representan a lesbianas o a personas consideradas importantes dentro de la cultura lésbica."},{"@language":"de","@value":"Erotische Filme von lesbischen Künstlerinnen, die Lesben darstellen oder als wichtig innerhalb der lesbischen Kultur angesehen werden."},{"@language":"nl","@value":"Erotische films, gemaakt door lesbische regisseurs, waarin lesbische personen worden afgebeeld, of die binnen de lesbische cultuur als belangrijk worden beschouwd."},{"@language":"sv","@value":"Erotiska filmer skapade av lesbiska regissörer, som skildrar lesbiska eller som betraktas som betydelsefulla inom lesbisk kultur."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0002544"},{"@id":"https://homosaurus.org/v5/homoit0002607"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000765"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2007001118"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-12"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003155","dc:identifier":"homoit0003155","skos:prefLabel":[{"@language":"en","@value":"Lesbian zines"},{"@language":"es","@value":"Zines lésbicos"},{"@language":"nl","@value":"Lesbische zines"},{"@language":"sv","@value":"Lesbiska fanzines"}],"skos:altLabel":[{"@language":"sv","@value":"Lesbiska fansin"},{"@language":"sv","@value":"Lesbiska zines"}],"rdfs:comment":[{"@language":"en","@value":"Independent, small-circulation publications usually reproduced via photocopier; use for zines created by lesbians and/or focusing on lesbian identity, issues, or culture."},{"@language":"es","@value":"Publicaciones independientes de pequeña tirada generalmente reproducidas mediante fotocopiadora; utilícese para revistas creadas por lesbianas y/o que se centran en la identidad, los problemas o la cultura lésbica."},{"@language":"nl","@value":"Onafhankelijke publicaties in kleine oplage, meestal gereproduceerd via een kopieerapparaat; te gebruiken voor zines gemaakt door lesbische vrouwen en/of gericht op lesbische identiteit, onderwerpen of cultuur."},{"@language":"sv","@value":"Små, självpublicerade tidskrifter med begränsad upplaga, ofta kopierade med kopiator. Används för fanzines skapade av lesbiska och/eller med fokus på lesbisk identitet, frågor eller kultur."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000766"},{"@id":"https://homosaurus.org/v5/homoit0000965"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001132"},"dc:issued":{"@type":"xsd:date","@value":"2024-01-02"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004623","dc:identifier":"homoit0004623","skos:prefLabel":{"@language":"en","@value":"Lesbian personals"},"skos:altLabel":[{"@language":"en","@value":"Lesbian personal ads"},{"@language":"en","@value":"Lesbian personal advertisements"}],"rdfs:comment":{"@language":"en","@value":"A form of classified advertising for lesbians interested in seeking connections around sex, romance, and/or community. The content of these ads focus largely on the type of arrangement sought and details or criteria about the writer and the type of person they are looking for (e.g. personality traits, physical looks, etc.). While lesbian personals are most commonly thought of as existing in print media, they also have existed online in spaces such as Craigslist."},"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0004621"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000773"},{"@id":"https://homosaurus.org/v5/homoit0000766"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0004621"},"dc:issued":{"@type":"xsd:date","@value":"2026-06-08"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-08"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000767","dc:identifier":"homoit0000767","skos:prefLabel":[{"@language":"en","@value":"Lesbian pride"},{"@language":"es","@value":"Orgullo lésbico"},{"@language":"nl","@value":"Lesbian pride"},{"@language":"sv","@value":"Lesbisk pride"}],"rdfs:comment":[{"@language":"en","@value":"The recognition and celebration of lesbians and lesbian culture, thereby affirming the visibility, dignity, and diversity of lesbian communities."},{"@language":"es","@value":"La celebración y el reconocimiento de la identidad lésbica, afirmando la visibilidad, dignidad y diversidad de las comunidades lésbicas."},{"@language":"nl","@value":"De viering en erkenning van de lesbische identiteit, die de zichtbaarheid, waardigheid en diversiteit van lesbische gemeenschappen bevestigt."},{"@language":"sv","@value":"Firande och synliggörande av lesbisk identitet, med fokus på lesbiska gemenskapers synlighet, värdighet och mångfald."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0003653"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0003653"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianPride"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000768","dc:identifier":"homoit0000768","skos:prefLabel":[{"@language":"en","@value":"Lesbian sex workers"},{"@language":"es","@value":"Trabajadoras sexuales lesbianas"},{"@language":"nl","@value":"Lesbische sekswerkers"}],"skos:altLabel":[{"@language":"en","@value":"Lesbian prostitutes"},{"@language":"en","@value":"Lesbian prostitution"},{"@language":"en","@value":"Lesbian sex work"},{"@language":"nl","@value":"Lesbische prostitutie"},{"@language":"nl","@value":"Lesbische prostituées"}],"rdfs:comment":[{"@language":"en","@value":"Lesbians who receive money or goods in exchange for sexual services, performances, or companionship. Use to describe lesbians working across the broad spectrum of sex work."},{"@language":"es","@value":""},{"@language":"nl","@value":"Lesbische vrouwen die geld of goederen ontvangen in ruil voor seksuele diensten, optredens of gezelschap. Wordt gebruikt om lesbische vrouwen te beschrijven die in het brede spectrum van sekswerk werken."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001277"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0003758"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianProstitutes"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000770","dc:identifier":"homoit0000770","skos:prefLabel":[{"@language":"en","@value":"Lesbian Protestants"},{"@language":"es","@value":"Protestantes lesbianas"},{"@language":"nl","@value":"Protestantse lesbische vrouwen"},{"@language":"sv","@value":"Lesbiska protestanter"}],"rdfs:comment":[{"@language":"en","@value":"Lesbians who are members of the Protestant Church."},{"@language":"es","@value":"Lesbianas que son miembros de la Iglesia protestante."},{"@language":"nl","@value":"Lesbische vrouwen die lid zijn van een Protestantse Kerk."},{"@language":"sv","@value":"Lesbiska som är medlemmar i protestantiska kyrkor."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001137"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000928"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianProtestants"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000771","dc:identifier":"homoit0000771","skos:prefLabel":[{"@language":"en","@value":"Lesbian publishers"},{"@language":"es","@value":"Editoriales lésbicas"},{"@language":"nl","@value":"Lesbische uitgeverijen"},{"@language":"sv","@value":"Lesbiska förlag"}],"rdfs:comment":[{"@language":"en","@value":"Companies and organizations that publish materials for lesbian communities or addressing lesbian issues."},{"@language":"es","@value":"Empresas y organizaciones que publican materiales para comunidades lésbicas o que abordan asuntos lésbicos."},{"@language":"nl","@value":"Bedrijven en organisaties die materiaal publiceren voor lesbische gemeenschappen of lesbische thema's aanspreken"},{"@language":"sv","@value":"Företag och organisationer som publicerar material för lesbiska gemenskaper eller som behandlar lesbiska frågor."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001144"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001144"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianPublishers"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004318","dc:identifier":"homoit0004318","skos:prefLabel":[{"@language":"en","@value":"Lesbian podcasts"},{"@language":"nl","@value":"Lesbische podcasts"},{"@language":"sv","@value":"Lesbiska poddar"}],"skos:altLabel":{"@language":"sv","@value":"Lesbiska podcaster"},"rdfs:comment":[{"@language":"en","@value":"A recorded series (primarily in audio, but sometimes with a video component) with recurring hosts that feature content about lesbians and/or lesbian issues and that are available digitally for streaming or download. Podcasts are typically episodic and may feature different guests."},{"@language":"nl","@value":"Een opgenomen serie (voornamelijk audio, maar soms met een video-onderdeel) met terugkerende presentatoren die content presenteren over lesbische vrouwen en/of lesbische thema's en die digitaal beschikbaar zijn om te streamen of te downloaden. Podcasts bestaan ​​doorgaans uit afleveringen en kunnen verschillende gasten hebben."},{"@language":"sv","@value":"Inspelade radioprogram (inslag av video kan förekomma) med återkommande programledare och innehåll om/för lesbiska och/eller lesbiska frågor som är digitalt tillgängliga genom streaming eller nedladdning. Poddar är vanligen uppdelade i episoder och kan ha olika gäster."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0004317"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000772"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0004317"},"dc:issued":{"@type":"xsd:date","@value":"2026-02-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000776","dc:identifier":"homoit0000776","skos:prefLabel":[{"@language":"en","@value":"Lesbian Roman Catholics"},{"@language":"es","@value":"Lesbianas católico romanas"},{"@language":"nl","@value":"Roomskatholieke lesbische vrouwen"},{"@language":"sv","@value":"Romersk-katolska lesbiska"}],"rdfs:comment":[{"@language":"en","@value":"Lesbians who are members of the Roman Catholic Church."},{"@language":"es","@value":"Lesbianas que son miembros de la Iglesia católica romana."},{"@language":"nl","@value":"Lesbische vrouwen die lid zijn van de rooms-katholieke kerk."},{"@language":"sv","@value":"Lesbiska som är medlemmar i den romersk-katolska kyrkan."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001244"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2018002746"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000928"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianRomanCatholics"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002288","dc:identifier":"homoit0002288","skos:prefLabel":[{"@language":"en","@value":"Cookie dusters"},{"@language":"de","@value":"Bärtchen"},{"@language":"es","@value":"Cookie dusters"},{"@language":"nl","@value":"Cookie dusters"},{"@language":"sv","@value":"Moppemusche"}],"skos:altLabel":[{"@language":"en","@value":"Muff ticklers"},{"@language":"en","@value":"Pussy dusters"},{"@language":"en","@value":"Womb brooms"},{"@language":"de","@value":"Oberlippenbart"},{"@language":"es","@value":"Pussy dusters"},{"@language":"sv","@value":"Cookie dusters"}],"rdfs:comment":[{"@language":"en","@value":"Slang term for mustaches or facial hair on the upper lip, particularly that of lesbians."},{"@language":"de","@value":"Slangbegriff für Schnurrbärte oder Gesichtsbehaarung an der Oberlippe, insbesondere bei Lesben."},{"@language":"es","@value":"Término del argot para designar bigotes o vello facial en el labio superior, particularmente el de las lesbianas."},{"@language":"nl","@value":"Argot-term voor snorren of gezichtshaar op de bovenlip, vooral bij lesbische vrouwen."},{"@language":"sv","@value":"Slangterm för mustasch eller ansiktsbehåring på överläppen, särskilt hos lesbiska."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002287"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000779"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001269"},"dc:issued":{"@type":"xsd:date","@value":"2022-11-10"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000780","dc:identifier":"homoit0000780","skos:prefLabel":[{"@language":"en","@value":"Lesbian sports clubs"},{"@language":"es","@value":"Clubs deportivos lésbicos"},{"@language":"nl","@value":"Lesbische sportclubs"},{"@language":"sv","@value":"Idrottsklubbar för lesbiska"}],"skos:altLabel":[{"@language":"es","@value":"Clubs de deportes lésbicos"},{"@language":"es","@value":"Clubes atléticos lésbicos"}],"rdfs:comment":[{"@language":"en","@value":"Groups of lesbians formed for the purpose of playing sports; includes professional and amateur sports clubs."},{"@language":"es","@value":"Grupos de lesbianas formados con el fin de practicar deportes; incluye clubes deportivos profesionales y amateurs."},{"@language":"nl","@value":"Groepen lesbische vrouwen gevormd om te sporten; omvat professionele en amateursportclubs."},{"@language":"sv","@value":"Idrottsklubbar för lesbiska, både professionella och amatörbaserade."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000950"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001930"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000836"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianSportsClubs"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001930","dc:identifier":"homoit0001930","skos:prefLabel":[{"@language":"en","@value":"Lesbian athletes"},{"@language":"es","@value":"Atletas lesbianas"},{"@language":"de","@value":"Lesbische Sportlerinnen"},{"@language":"nl","@value":"Lesbische sportbeoefenaars"},{"@language":"sv","@value":"Lesbiska idrottare"}],"skos:altLabel":[{"@language":"en","@value":"Lesbian sports players"},{"@language":"en","@value":"Lesbian sportspeople"},{"@language":"en","@value":"Lesbian sportspersons"},{"@language":"en","@value":"Lesbian sportswomen"},{"@language":"es","@value":"Jugadoras deportivas lesbianas"},{"@language":"es","@value":"Deportistas lesbianas"},{"@language":"de","@value":"Lesbische Athletinnen"},{"@language":"nl","@value":"Lesbische sportvrouwen"}],"rdfs:comment":[{"@language":"en","@value":"Professional or amateur/recreational sports players who self-identify as lesbians."},{"@language":"es","@value":"Jugadoras de deportes profesionales o amateurs/recreativas que se autoidentifican como lesbianas."},{"@language":"de","@value":"Profi- oder Amateur-/Freizeitsportlerinnen, die sich selbst als Lesben identifizieren."},{"@language":"nl","@value":"Professionele of amateur/recreatieve sporters die zichzelf identificeren als lesbische vrouwen"},{"@language":"sv","@value":"Lesbiska som ägnar sig åt professionell eller rekreationell idrott."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001929"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0004469"},{"@id":"https://homosaurus.org/v5/homoit0004511"},{"@id":"https://homosaurus.org/v5/homoit0004523"},{"@id":"https://homosaurus.org/v5/homoit0004533"},{"@id":"https://homosaurus.org/v5/homoit0004543"},{"@id":"https://homosaurus.org/v5/homoit0004553"},{"@id":"https://homosaurus.org/v5/homoit0004563"},{"@id":"https://homosaurus.org/v5/homoit0004573"},{"@id":"https://homosaurus.org/v5/homoit0004583"},{"@id":"https://homosaurus.org/v5/homoit0004593"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000780"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh91005359"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-05-03"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000782","dc:identifier":"homoit0000782","skos:prefLabel":[{"@language":"en","@value":"Lesbian survivors of hate crimes"},{"@language":"es","@value":"Sobrevivientes lesbianas de crímenes de odio"},{"@language":"fr","@value":"Lesbiennes survivantes de crimes haineux"},{"@language":"nl","@value":"Lesbische overlevenden van haatmisdrijven"},{"@language":"sv","@value":"Lesbiska hatbrottsöverlevare"}],"skos:altLabel":{"@language":"es","@value":"Lesbianas sobrevivientes de crímenes de odio"},"rdfs:comment":[{"@language":"en","@value":"Lesbians who have experienced and survived hate crimes; follow the individual's preference for \"victims\" or \"survivors\" whenever possible."},{"@language":"es","@value":"Lesbianas que han sufrido y sobrevivido crímenes de odio; siga la preferencia de la persona sobre el uso de \"víctimas\" o \"sobrevivientes\" siempre que sea posible."},{"@language":"fr","@value":"Lesbiennes qui ont été victimes de crimes haineux et qui ont survécu; respecter la préférence de la personne concernée entre les termes « victimes » ou « survivantes » dans la mesure du possible."},{"@language":"nl","@value":"Lesbische vrouwen die haatmisdrijven hebben meegemaakt en overleefd; volg waar mogelijk de voorkeur van het individu voor \"slachtoffers\" of \"overlevenden\"."},{"@language":"sv","@value":"Lesbiska som har upplevt och överlevt hatbrott. Följ individens preferens för att använda ”offer” eller ”överlevare” när det är möjligt."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000792"},{"@id":"https://homosaurus.org/v5/homoit0001349"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianSurvivorsOfHateCrimes"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000784","dc:identifier":"homoit0000784","skos:prefLabel":[{"@language":"en","@value":"Lesbian survivors of sexual abuse"},{"@language":"es","@value":"Sobrevivientes lesbianas de abuso sexual"},{"@language":"fr","@value":"Lesbiennes survivantes d'abus sexuels"},{"@language":"nl","@value":"Lesbische overlevenden van seksueel misbruik"},{"@language":"sv","@value":"Lesbiska som överlevt sexuella övergrepp"}],"skos:altLabel":[{"@language":"es","@value":"Lesbianas sobrevivientes de abuso sexual"},{"@language":"fr","@value":"Lesbiennes survivantes de violences sexuelles"},{"@language":"fr","@value":"Lesbiennes survivantes d'agressions sexuelles"}],"rdfs:comment":[{"@language":"en","@value":"Lesbians who have experienced and survived sexual abuse; follow the individual's preference for \"victims\" or \"survivors\" whenever possible."},{"@language":"es","@value":"Lesbianas que han sufrido y sobrevivido abusos sexuales; siga la preferencia de la persona sobre el uso de  \"víctimas\" o \"sobrevivientes\" siempre que sea posible."},{"@language":"fr","@value":"Lesbiennes ayant vécu de l'abus sexuel et qui ont survécu; respecter la préférence de la personne concernée entre les termes « victimes » ou « survivantes » dans la mesure du possible."},{"@language":"nl","@value":"Lesbische vrouwen die seksueel misbruik hebben meegemaakt en overleefd; volg waar mogelijk de voorkeur van het individu voor \"slachtoffers\" of \"overlevenden\"."},{"@language":"sv","@value":"Lesbiska som har utsatts för och överlevt sexuella övergrepp. Följ individens preferens för att använda ”offer” eller ”överlevare” när det är möjligt."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000794"},{"@id":"https://homosaurus.org/v5/homoit0001351"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianSurvivorsOfSexualAbuse"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000794","dc:identifier":"homoit0000794","skos:prefLabel":[{"@language":"en","@value":"Lesbian victims of sexual abuse"},{"@language":"es","@value":"Víctimas lesbianas de acoso sexual"},{"@language":"fr","@value":"Lesbiennes victimes d'abus sexuels"},{"@language":"nl","@value":"Lesbische slachtoffers van seksueel misbruik"},{"@language":"sv","@value":"Lesbiska offer för sexuella övergrepp"}],"skos:altLabel":[{"@language":"es","@value":"Víctimas lésbicas de acoso sexual"},{"@language":"fr","@value":"Lesbiennes victimes de violences sexuelles"},{"@language":"fr","@value":"Lesbiennes victimes d'agressions sexuelles"},{"@language":"sv","@value":"Lesbiska som utsatts för sexuella övergrepp"}],"rdfs:comment":[{"@language":"en","@value":"Lesbians who have experienced sexual abuse and may or may not have survived; follow the individual's preference for \"victims\" or \"survivors\" whenever possible."},{"@language":"es","@value":"Lesbianas que han sufrido abuso sexual y que pueden o no haber sobrevivido; siga la preferencia de la persona sobre el uso de \"víctimas\" o \"sobrevivientes\" siempre que sea posible."},{"@language":"fr","@value":"Lesbiennes ayant vécu de l'abus sexuel et qui peuvent ou non y avoir survécu; respecter la préférence de la personne concernée entre les termes « victimes » ou « survivantes » dans la mesure du possible."},{"@language":"nl","@value":"Lesbische vrouwen die seksueel misbruik hebben meegemaakt en het al dan niet hebben overleefd; volg waar mogelijk de voorkeur van het individu voor \"slachtoffers\" of \"overlevenden\""},{"@language":"sv","@value":"Lesbiska som har utsatts för sexuella övergrepp och som kan ha överlevt eller inte. Följ individens preferens för att använda ”offer” eller ”överlevare” när det är möjligt."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000959"},"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0000784"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianVictimsOfSexualAbuse"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000785","dc:identifier":"homoit0000785","skos:prefLabel":[{"@language":"en","@value":"Lesbian survivors of war"},{"@language":"es","@value":"Sobrevivientes lesbianas de guerra"},{"@language":"fr","@value":"Lesbiennes survivantes de guerre"},{"@language":"nl","@value":"Lesbische oorlogsoverlevenden"},{"@language":"sv","@value":"Lesbiska krigsöverlevare"}],"skos:altLabel":{"@language":"es","@value":"Lesbianas sobrevivientes de guerra"},"rdfs:comment":[{"@language":"en","@value":"Lesbians who have experienced and survived war; follow the individual's preference for \"victims\" or \"survivors\" whenever possible."},{"@language":"es","@value":"Lesbianas que han sufrido y sobrevivido la guerra; siga la preferencia de la persona sobre el uso de \"víctimas\" o \"sobrevivientes\" siempre que sea posible."},{"@language":"fr","@value":"Lesbiennes ayant vécu et survécu à la guerre; respecter la préférence de la personne concernée entre les termes « victimes » ou « survivantes » dans la mesure du possible."},{"@language":"nl","@value":"Lesbische vrouwen die oorlog hebben meegemaakt en overleefd; volg waar mogelijk de voorkeur van het individu voor \"slachtoffers\" of \"overlevenden\"."},{"@language":"sv","@value":"Lesbiska som har upplevt och överlevt krig. Följ individens preferens för att använda ”offer” eller ”överlevare” när det är möjligt."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000795"},{"@id":"https://homosaurus.org/v5/homoit0001352"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianSurvivorsOfWar"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000795","dc:identifier":"homoit0000795","skos:prefLabel":[{"@language":"en","@value":"Lesbian victims of war"},{"@language":"es","@value":"Víctimas lesbianas de guerra"},{"@language":"fr","@value":"Lesbiennes victimes de guerre"},{"@language":"nl","@value":"Lesbische oorlogsslachtoffers"},{"@language":"sv","@value":"Lesbiska krigsoffer"}],"skos:altLabel":[{"@language":"es","@value":"Víctimas lésbicas de guerra"},{"@language":"es","@value":"Víctimas lesbianas de guerra"}],"rdfs:comment":[{"@language":"en","@value":"Lesbians who have experienced war and may or may not have survived; follow the individual's preference for \"victims\" or \"survivors\" whenever possible."},{"@language":"es","@value":"Lesbianas que han sufrido la guerra y que pueden o no haber sobrevivido; siga la preferencia de la persona sobre el uso de \"víctimas\" o \"sobrevivientes\" siempre que sea posible."},{"@language":"fr","@value":"Lesbiennes ayant vécu la guerre et qui peuvent ou non avoir survécu; respecter la préférence de la personne concernée entre les termes « victimes » ou « survivantes » dans la mesure du possible."},{"@language":"nl","@value":"Lesbische vrouwen die oorlog hebben meegemaakt en al dan niet hebben overleefd; volg waar mogelijk de voorkeur van het individu voor \"slachtoffers\" of \"overlevenden\""},{"@language":"sv","@value":"Lesbiska som har upplevt krig och som kan ha överlevt eller inte. Följ individens preferens för att använda ”offer” eller ”överlevare” när det är möjligt."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000961"},"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0000785"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianVictimsOfWar"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000798","dc:identifier":"homoit0000798","skos:prefLabel":[{"@language":"en","@value":"Lesbian youth literature"},{"@language":"es","@value":"Literatura juvenil lésbica"},{"@language":"nl","@value":"Lesbische jeugdliteratuur"},{"@language":"sv","@value":"Lesbisk ungdomslitteratur"}],"rdfs:comment":[{"@language":"en","@value":"Written literary works for an audience of readers from 12-18 years of age, also known as young adult literature or YA; use in reference to youth literature focusing on lesbian characters or themes."},{"@language":"es","@value":"Obras literarias escritas para una audiencia de lectores de 12 a 18 años de edad, también conocida como literatura para adultos jóvenes o YA (por sus siglas en inglés); utilícese en referencia a la literatura juvenil centrada en personajes o temas lésbicos."},{"@language":"nl","@value":"Geschreven literaire werken voor een lezerspubliek van 12-18 jaar, ook wel young adult literatuur of YA genoemd; gebruik in verwijzing naar jeugdliteratuur gericht op lesbische personages of thema's."},{"@language":"sv","@value":"Litterära verk för läsare mellan 12 och 18 år, även kallat YA. Används för ungdomslitteratur med fokus på lesbiska karaktärer eller teman."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001522"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000786"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianYouthLiterature"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000788","dc:identifier":"homoit0000788","skos:prefLabel":[{"@language":"en-us","@value":"Lesbian theater"},{"@language":"es","@value":"Teatro lésbico"},{"@language":"nl","@value":"Lesbisch theater"},{"@language":"sv","@value":"Lesbisk teater"},{"@language":"en-gb","@value":"Lesbian theatre"}],"rdfs:comment":[{"@language":"en","@value":"Works in the performance arts that focus on lesbian characters, lesbian communities, or lesbian issues."},{"@language":"es","@value":"Obras en las artes escénicas que se centran en personajes lésbicos, comunidades lésbicas o cuestiones lésbicas."},{"@language":"nl","@value":"Uitvoeringen in de podiumkunsten die zich richten op lesbische personages, gemeenschappen of kwesties."},{"@language":"sv","@value":"Scenkonstverk som fokuserar på lesbiska karaktärer, gemenskaper eller frågor."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001363"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000789"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh94008034"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001363"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianTheatre"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000796","dc:identifier":"homoit0000796","skos:prefLabel":[{"@language":"en","@value":"Lesbian victims' rights"},{"@language":"es","@value":"Derechos de víctimas lesbianas"},{"@language":"nl","@value":"Slachtofferrechten voor lesbische vrouwen"},{"@language":"sv","@value":"Lesbiska brottsoffers rättigheter"}],"skos:altLabel":{"@language":"es","@value":"Derechos de víctimas lésbicas"},"rdfs:comment":[{"@language":"en","@value":"Lesbians' legal rights to be informed, present, and heard within the criminal justice system after having been harmed or injured as the result of of a crime, accident, or other event."},{"@language":"es","@value":"Los derechos legales de las lesbianas a estar informadas, estar presentes y ser escuchadas dentro del sistema de justicia penal después de haber sido perjudicadas o lesionadas como resultado de un delito, accidente u otro evento."},{"@language":"nl","@value":"De wettelijke rechten van lesbische vrouwen om te worden geïnformeerd, aanwezig te zijn en gehoord te worden binnen het strafrechtsysteem nadat ze zijn geschaad of gewond zijn geraakt als gevolg van een misdrijf, ongeval of andere gebeurtenis."},{"@language":"sv","@value":"Lesbiskas juridiska rättigheter som brottsoffer att få information, närvara och komma till tals inom rättsväsendet efter att ha utsatts för brott, olycka eller annan händelse som orsakat skada."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001492"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000702"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianVictimsRights"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001669","dc:identifier":"homoit0001669","skos:prefLabel":[{"@language":"en","@value":"Tribadism"},{"@language":"es","@value":"Tribadismo"},{"@language":"nl","@value":"Tribadisme"},{"@language":"sv","@value":"Tribadism"}],"skos:altLabel":[{"@language":"en","@value":"Tribbing"},{"@language":"es","@value":"Hacer la tijera"},{"@language":"es","@value":"Tijereando"},{"@language":"es","@value":"Hacer la tortilla"},{"@language":"es","@value":"Untar"},{"@language":"es","@value":"Raspar"},{"@language":"es","@value":"Rastillar"},{"@language":"es","@value":"Restregarse"}],"rdfs:comment":[{"@language":"en","@value":"A mostly antiquated term used either to refer to scissoring, to any sexual activity between women, or to the general concept of being a lesbian (\"lesbianism\")."},{"@language":"es","@value":"Un término mayoritariamente anticuado utilizado para referirse a hacer tijeras, a cualquier actividad sexual entre mujeres o al concepto general de ser lesbiana (\"lesbianismo\")."},{"@language":"nl","@value":"Een grotendeels verouderde term die wordt gebruikt om te verwijzen naar scharen, naar elke seksuele activiteit tussen vrouwen of naar het algemene concept van lesbisch zijn (\"lesbianisme\")."},{"@language":"sv","@value":"Föråldrad term som har använts för att antingen beskriva saxning, sex mellan kvinnor i allmänhet eller begreppet lesbiskhet i stort."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000878"},{"@id":"https://homosaurus.org/v5/homoit0001267"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000799"},{"@id":"https://homosaurus.org/v5/homoit0001472"},{"@id":"https://homosaurus.org/v5/homoit0001667"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000878"},"dc:replaces":{"@id":"http://homosaurus.org/v2/tribadism"},"dc:issued":{"@type":"xsd:date","@value":"2021-06-30"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000800","dc:identifier":"homoit0000800","skos:prefLabel":[{"@language":"en","@value":"Lesbians in the military"},{"@language":"es","@value":"Lesbianas en el ejército"},{"@language":"de","@value":"Lesbische Armeeangehörige"},{"@language":"nl","@value":"Lesbisch militair personeel"},{"@language":"sv","@value":"Lesbiska inom militären"}],"skos:altLabel":[{"@language":"es","@value":"Lesbianas en las fuerzas armadas"},{"@language":"de","@value":"Lesbische Militärangehörige"}],"rdfs:comment":[{"@language":"en","@value":"Lesbians serving in state and national armed forces."},{"@language":"es","@value":"Lesbianas que sirven en las fuerzas armadas estatales y nacionales."},{"@language":"de","@value":"Lesbische Personen, die in Streitkräften dienen."},{"@language":"nl","@value":"Lesbische vrouwen die dienen in staats- en nationale strijdkrachten."},{"@language":"sv","@value":"Lesbiska som tjänstgör inom nationella försvarsstyrkor."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001100"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000712"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbiansInTheMilitary"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000801","dc:identifier":"homoit0000801","skos:prefLabel":[{"@language":"en-us","@value":"Lesbians of color"},{"@language":"es","@value":"Lesbianas de color"},{"@language":"nl","@value":"Lesbische vrouwen van kleur"},{"@language":"sv","@value":"Ickevita lesbiska"},{"@language":"en-gb","@value":"Lesbians of colour"}],"skos:altLabel":[{"@language":"sv","@value":"Lesbiska POC"},{"@language":"sv","@value":"Lesbiska people of color"}],"rdfs:comment":[{"@language":"en","@value":"Primarily used in the United States, this term refers to lesbians who are not white and who identify as people of color."},{"@language":"es","@value":"Lesbianas que no son blancas y que se autoidentifican como personas de color."},{"@language":"nl","@value":"Lesbische vrouwen die niet wit zijn en die zich identificeren als personen van kleur."},{"@language":"sv","@value":"Lesbiska som inte är vita och som identifierar sig som icke-vita/people of color."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001101"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbiansOfColour"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002591","dc:identifier":"homoit0002591","skos:prefLabel":[{"@language":"en","@value":"Internalized lesbophobia"},{"@language":"es","@value":"Lesbofobia internalizada"},{"@language":"nl","@value":"Geïnternaliseerde lesbofobie"},{"@language":"sv","@value":"Internaliserad lesbofobi"}],"rdfs:comment":[{"@language":"en","@value":"The phenomenon in which lesbians internalize or adopt lesbophobic beliefs (i.e., negative perceptions of and intolerance toward lesbians and lesbianism) as a result of being raised or socialized within a lesbophobic environment or culture."},{"@language":"es","@value":"El fenómeno a través del cual las lesbianas internalizan o adoptan creencias lesbofóbicas (es decir, percepciones negativas e intolerancia hacia las lesbianas y el lesbianismo) como resultado de haber sido criadas o socializadas dentro de un entorno o una cultura lesbofóbica."},{"@language":"nl","@value":"Het fenomeen waarbij lesbische vrouwen lesbofobe overtuigingen internaliseren of overnemen (d.w.z. negatieve percepties van en intolerantie jegens lesbische vrouwen en lesbianisme) als gevolg van het feit dat ze zijn opgegroeid of gesocialiseerd in een lesbofobe omgeving of cultuur."},{"@language":"sv","@value":"Företeelsen att lesbiska internaliserar eller anammar lesbofobiska föreställningar – det vill säga negativa uppfattningar om och intolerans mot lesbiska och lesbiskhet – till följd av att ha vuxit upp eller socialiserats i en lesbofobisk miljö eller kultur."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000803"},{"@id":"https://homosaurus.org/v5/homoit0002590"}],"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0003092"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000920"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000808","dc:identifier":"homoit0000808","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ action campaigns"},{"@language":"es","@value":"Campañas de acción LGBTQ+"},{"@language":"ja","@value":"LGBTQ+関連のアクションキャンペーン"},{"@language":"nl","@value":"LHBTQ+-acties"},{"@language":"sv","@value":"Aktionskampanjer (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"LGBTQ action campaigns"},{"@language":"es","@value":"Campañas de acción LGBTQ"},{"@language":"ja","@value":"LGBTQ関連のアクションキャンペーン"}],"rdfs:comment":[{"@language":"en","@value":"A series of organized events or efforts centered around raising awareness or achieving a particular political, social, or cultural goal or action benefiting LGBTQ+ people and communities."},{"@language":"es","@value":"Una serie de eventos o esfuerzos organizados centrados en crear conciencia o lograr un objetivo o acción política, social o cultural particular que beneficie a las personas y comunidades LGBTQ+."},{"@language":"ja","@value":"LGBTQ+の人々やコミュニティの利益となる特定の政治的、社会的、あるいは文化的な目標や行動の実現、あるいはその認知度向上を目的とした組織的なイベントや取り組み。"},{"@language":"nl","@value":"Een reeks georganiseerde evenementen of inspanningen die gericht zijn op bewustmaking of het bereiken van een bepaald politiek, sociaal of cultureel doel of actie die LHBTQ+-personen en -gemeenschappen ten goede komt."},{"@language":"sv","@value":"En serie organiserade evenemang eller insatser som syftar till att väcka medvetenhet eller uppnå ett visst politiskt, socialt eller kulturellt mål till förmån för hbtq+-personer och gemenskaper."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000853"},"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0000851"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000006"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQActionCampaigns"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000851","dc:identifier":"homoit0000851","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ demonstrations"},{"@language":"es","@value":"Manifestaciones LGBTQ+"},{"@language":"ja","@value":"LGBTQ+のデモ"},{"@language":"nl","@value":"LHBTQ+-demonstraties"},{"@language":"sv","@value":"Demonstrationer (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"Marches (LGBTQ)"},{"@language":"en","@value":"LGBTQ+ rallies"},{"@language":"en","@value":"Rallies (LGBTQ)"},{"@language":"en","@value":"Demonstrations (LGBTQ)"},{"@language":"en","@value":"LGBTQ+ protests"},{"@language":"en","@value":"Protests (LGBTQ)"},{"@language":"es","@value":"Marchas políticas LGBTQ"},{"@language":"es","@value":"Protestas LGBTQ"},{"@language":"es","@value":"Concentraciones LGBTQ"},{"@language":"es","@value":"Demostraciones LGBTQ+"},{"@language":"ja","@value":"マーチ（LGBTQ）"},{"@language":"ja","@value":"LGBTQ+の集会"},{"@language":"ja","@value":"集会（LGBTQ）"},{"@language":"ja","@value":"デモンストレーション（LGBTQ）"},{"@language":"ja","@value":"LGBTQ+の抗議活動"},{"@language":"ja","@value":"抗議活動（LGBTQ）"},{"@language":"nl","@value":"LHBTQ+-betogingen"},{"@language":"nl","@value":"LHBTQ+-protestmarsen"},{"@language":"nl","@value":"Protestmarsen (LHBTQ+)"}],"rdfs:comment":[{"@language":"en","@value":"Marches, rallies, and other large, public gatherings organized to protest discrimination against LGBTQ+ people and advocate for LGBTQ+ visibility, rights, and issues. For street processions of people recognizing and celebrating LGBTQ+ people and culture, use the term \"Pride parades.\""},{"@language":"es","@value":"Acción tomada por grandes grupos de personas en protesta por la discriminación o en apoyo a personas, comunidades, temas o derechos LGBTQ+; típicamente incluye marchas y concentraciones con oradores."},{"@language":"ja","@value":"LGBTQ+の人々に対する差別に抗議し、LGBTQ+の可視化、権利、および課題を訴えるために組織されるデモ行進、集会、その他の大規模な公開集会。LGBTQ+の人々や文化を称え、祝うための街頭行進については、「プライドパレード」という用語を使用する。"},{"@language":"nl","@value":"Protestmarsen, manifestaties en andere grote, openbare bijeenkomsten die georganiseerd worden om te protesteren tegen discriminatie van LHBTQ+-personen en om te pleiten voor de zichtbaarheid, rechten, etc. van LHBTQ+-personen. Voor straatoptochten van mensen die LHBTQ+-personen en -cultuur erkennen en vieren, gebruik de term 'Pride Parades'."},{"@language":"sv","@value":"Kollektiva protest- och stödhandlingar där stora grupper samlas till stöd för hbtq+-personer, gemenskaper, frågor eller rättigheter, ofta i form av demonstrationståg och manifestationer med talare."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000808"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0001905"},{"@id":"https://homosaurus.org/v5/homoit0003934"},{"@id":"https://homosaurus.org/v5/homoit0003935"},{"@id":"https://homosaurus.org/v5/homoit0003936"},{"@id":"https://homosaurus.org/v5/homoit0001379"},{"@id":"https://homosaurus.org/v5/homoit0003937"},{"@id":"https://homosaurus.org/v5/homoit0003938"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000932"},{"@id":"https://homosaurus.org/v5/homoit0001026"},{"@id":"https://homosaurus.org/v5/homoit0003652"},{"@id":"https://homosaurus.org/v5/homoit0003939"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000006"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQDemonstrations"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000905","dc:identifier":"homoit0000905","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ motherhood"},{"@language":"es","@value":"Maternidad LGBTQ+"},{"@language":"nl","@value":"LHBTQ+-moederschap"},{"@language":"sv","@value":"Moderskap (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"LGBTQ motherhood"},{"@language":"en","@value":"Maternity (LGBTQ)"},{"@language":"en","@value":"Motherhood (LGBTQ)"},{"@language":"en","@value":"LGBTQ+ maternity"},{"@language":"es","@value":"Maternidad LGBTQ"},{"@language":"es","@value":"Maternidad (LGBTQ)"}],"rdfs:comment":[{"@language":"en","@value":"Motherhood experiences, as experienced by LGBTQ+ people."},{"@language":"es","@value":"Experiencias de maternidad, tal como las viven las personas LGBTQ+."},{"@language":"nl","@value":"Moederschapservaringen, zoals ervaren door LHBTQ+-personen."},{"@language":"sv","@value":"Mödraskapserfarenheter så som de upplevs av hbtq+-personer."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000810"},{"@id":"https://homosaurus.org/v5/homoit0000914"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001001"},{"@id":"https://homosaurus.org/v5/homoit0001021"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000420"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQMotherhood"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000815","dc:identifier":"homoit0000815","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ art censorship"},{"@language":"es","@value":"Censura de arte LGBTQ+"},{"@language":"ja","@value":"LGBTQ+アートの検閲"},{"@language":"nl","@value":"LHBTQ+-kunstcensuur"},{"@language":"sv","@value":"Censur av hbtq+-konst"}],"skos:altLabel":[{"@language":"en","@value":"LGBTQ art censorship"},{"@language":"es","@value":"Censura de arte LGBTQ"},{"@language":"ja","@value":"LGBTQアートの検閲"}],"rdfs:comment":[{"@language":"en","@value":"Suppression or prohibition of art by LGBTQ+ artists or about LGBTQ+ issues; includes censorship on the basis of religious, moral, political, and/or social objections."},{"@language":"es","@value":"Supresión o prohibición del arte por parte de artistas LGBTQ+ o sobre asuntos LGBTQ+; incluye la censura basada en objeciones religiosas, morales, políticas y/o sociales."},{"@language":"ja","@value":"LGBTQ+のアーティストによる、あるいはLGBTQ+の問題を扱った芸術作品の弾圧または禁止。これには、宗教的、道徳的、政治的、社会的な反対意見に基づく検閲が含まれる。"},{"@language":"nl","@value":"Onderdrukking of verbod van creatieve visuele, materiële of uitvoerende kunst door LHBTQ+-kunstenaars of over LHBTQ+-kwesties; omvat censuur op basis van religieuze, morele, politieke of sociale opvattingen."},{"@language":"sv","@value":"Förtryck, förbud eller censur av konst skapad av hbtq+-personer eller med hbtq+-tematik. Termen inkluderar censur grundad i religiösa, moraliska, politiska och/eller sociala invändningar."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000829"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000816"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000245"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQArtCensorship"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002327","dc:identifier":"homoit0002327","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ cinema"},{"@language":"es","@value":"Cine LGBTQ+"},{"@language":"ja","@value":"LGBTQ+映画"},{"@language":"nl","@value":"LHBTQ+-cinema"},{"@language":"sv","@value":"Hbtq+-film"}],"skos:altLabel":[{"@language":"en","@value":"Cinema (LGBTQ)"},{"@language":"en","@value":"Film (LGBTQ)"},{"@language":"en","@value":"LGBTQ+ film"},{"@language":"ja","@value":"映画 (LGBTQ)"},{"@language":"sv","@value":"Queerfilm"},{"@language":"sv","@value":"Film (hbtq+)"}],"rdfs:comment":[{"@language":"en","@value":"Term that encompasses LGBTQ+ filmmaking, the LGBTQ+ film industry, and film as an art form within LGBTQ+ culture. For specific movies created by or representing LGBTQ+ people, use the term \"LGBTQ+ films.\""},{"@language":"es","@value":"Término que abarca el cine LGBTQ+, la industria cinematográfica LGBTQ+ y el cine como forma de arte dentro de la cultura LGBTQ+. Para películas específicas creadas por personas LGBTQ+ o que las representen, utilice el término \"películas LGBTQ+\"."},{"@language":"ja","@value":"LGBTQ+の映画制作、LGBTQ+映画産業、およびLGBTQ+文化における芸術形式としての映画を包括する用語。LGBTQ+の人々によって制作された、あるいはLGBTQ+の人々を描いた特定の映画については、「LGBTQ+映画」という用語を使用する。"},{"@language":"nl","@value":"Term die het maken van LHBTQ+-films, de LHBTQ+-filmindustrie en film als kunstvorm binnen de LHBTQ+-cultuur omvat. Gebruik de term 'LHBTQ+-films' voor specifieke films die zijn gemaakt door of die LHBTQ+-personen representeren."},{"@language":"sv","@value":"Term som omfattar hbtq+-filmskapande, filmindustrin och filmen som konstform inom hbtq+-kultur. För specifika filmer skapade av eller som representerar hbtq+-personer, använd termen ”Hbtq+-filmer”."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000816"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000869"},{"@id":"https://homosaurus.org/v5/homoit0002328"},{"@id":"https://homosaurus.org/v5/homoit0002330"},{"@id":"https://homosaurus.org/v5/homoit0003160"},{"@id":"https://homosaurus.org/v5/homoit0003700"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000867"},{"@id":"https://homosaurus.org/v5/homoit0000868"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-11-15"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002596","dc:identifier":"homoit0002596","skos:prefLabel":[{"@language":"en","@value":"Transgender art "},{"@language":"es","@value":"Arte transgénero"},{"@language":"nl","@value":"Transgender kunst"},{"@language":"sv","@value":"Transkonst"}],"rdfs:comment":[{"@language":"en","@value":"Term for different forms of creative activity, including visual, material, and performing arts, by transgender artists or about transgender topics and communities. \r\n"},{"@language":"es","@value":"Término para diferentes formas de actividad creativa, incluidas las artes visuales, materiales y escénicas, realizadas por artistas transgénero o sobre temas y comunidades transgénero.\n"},{"@language":"nl","@value":"Term voor verschillende vormen van creatieve activiteit, waaronder visuele, materiële en podiumkunsten, door transgenderkunstenaars of over transgenderonderwerpen en -gemeenschappen."},{"@language":"sv","@value":"Olika former av konstnärligt skapande, inklusive bildkonst, materiell konst och scenkonst, skapade av transkonstnärer eller som skildrar transgemenskaper och teman."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000816"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0002610"},{"@id":"https://homosaurus.org/v5/homoit0004004"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002598","dc:identifier":"homoit0002598","skos:prefLabel":[{"@language":"en","@value":"Gay art "},{"@language":"es","@value":"Arte gay"},{"@language":"de","@value":"Schwule Kunst"},{"@language":"nl","@value":"Homokunst"},{"@language":"sv","@value":"Bögkonst"}],"skos:altLabel":[{"@language":"de","@value":"Schwulen-Kunst"},{"@language":"sv","@value":"Gaykonst"}],"rdfs:comment":[{"@language":"en","@value":"Umbrella term for different forms of creative activity, including visual, material, and performing arts, by gay artists or about gay topics and communities. Use a more specific term if possible.\r\n"},{"@language":"es","@value":"Término general para diferentes formas de actividad creativa, incluidas las artes visuales, materiales y escénicas, realizadas por artistas gay o sobre temas y comunidades gay. Utilícese un término más específico si es posible."},{"@language":"de","@value":"Bezeichnung für verschiedene Formen des kreativen Schaffens, einschließlich visueller, materieller und darstellender Kunst, von schwulen Künstlern oder über schwule Themen und Gemeinschaften."},{"@language":"nl","@value":"Overkoepelende term voor verschillende vormen van creatieve activiteit, waaronder visuele, materiële en podiumkunsten, door homokunstenaars of over homo-onderwerpen en gemeenschappen. Gebruik indien mogelijk een specifiekere term. ​"},{"@language":"sv","@value":"Paraplyterm för olika former av konstnärligt skapande, inklusive bildkonst, materiell konst och scenkonst, skapade av homosexuella manliga konstnärer eller som skildrar bögars gemenskaper och teman. Använd en mer specifik term om möjligt."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000816"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0002608"},{"@id":"https://homosaurus.org/v5/homoit0004002"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002599","dc:identifier":"homoit0002599","skos:prefLabel":[{"@language":"en","@value":"Lesbian art "},{"@language":"es","@value":"Arte lésbico"},{"@language":"de","@value":"Lesbische Kunst"},{"@language":"nl","@value":"Lesbische kunst"},{"@language":"sv","@value":"Lesbisk konst"}],"skos:altLabel":{"@language":"de","@value":"Lesbenkunst"},"rdfs:comment":[{"@language":"en","@value":"Term for different forms of creative activity, including visual, material, and performing arts, by lesbian artists or about lesbian topics and communities. \r\n"},{"@language":"es","@value":"Término para diferentes formas de actividad creativa, incluidas las artes visuales, materiales y escénicas, realizadas por artistas lesbianas o sobre temas y comunidades lésbicas.\n"},{"@language":"de","@value":"Bezeichnung für verschiedene Formen des kreativen Schaffens, einschließlich visueller, materieller und darstellender Kunst, von lesbischen Künstlerinnen oder über lesbische Themen und Gemeinschaften."},{"@language":"nl","@value":"Term voor verschillende vormen van creatieve activiteit, waaronder visuele, materiële en podiumkunsten, door lesbische kunstenaars of over lesbische onderwerpen en gemeenschappen."},{"@language":"sv","@value":"Olika former av konstnärligt skapande, inklusive bildkonst, materiell konst och scenkonst, skapade av lesbiska konstnärer eller som skildrar lesbiska gemenskaper och teman."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000816"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0002607"},{"@id":"https://homosaurus.org/v5/homoit0004001"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002600","dc:identifier":"homoit0002600","skos:prefLabel":[{"@language":"en","@value":"Bisexual art "},{"@language":"es","@value":"Arte bisexual"},{"@language":"de","@value":"Bisexuelle Kunst"},{"@language":"nl","@value":"Biseksuele kunst"},{"@language":"sv","@value":"Bisexuell konst"}],"skos:altLabel":{"@language":"de","@value":"Bisexuellen-Kunst"},"rdfs:comment":[{"@language":"en","@value":"Term for different forms of creative activity, including visual, material, and performing arts, by bisexual artists or about bisexual topics and communities. \r\n"},{"@language":"es","@value":"Término para diferentes formas de actividad creativa, incluidas las artes visuales, materiales y escénicas, de artistas bisexuales o sobre temas y comunidades bisexuales. \n"},{"@language":"de","@value":"Bezeichnung für verschiedene Formen des kreativen Schaffens, einschließlich visueller, materieller und darstellender Kunst, von bisexuellen Künstlern oder über bisexuelle Themen und Gemeinschaften."},{"@language":"nl","@value":"Overkoepelende term voor verschillende vormen van creatieve activiteit, waaronder visuele, materiële en podiumkunsten, door biseksuele artiesten of over biseksuele onderwerpen en -gemeenschappen."},{"@language":"sv","@value":"Olika former av konstnärligt skapande, inklusive bildkonst, materiell konst och scenkonst, skapade av bisexuella konstnärer eller som skildrar bisexuella gemenskaper och teman."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000816"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0002609"},{"@id":"https://homosaurus.org/v5/homoit0004003"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002601","dc:identifier":"homoit0002601","skos:prefLabel":[{"@language":"en","@value":"Queer art "},{"@language":"es","@value":"Arte queer"},{"@language":"nl","@value":"Queer kunst"},{"@language":"sv","@value":"Queer konst"}],"rdfs:comment":[{"@language":"en","@value":"Term for different forms of creative activity, including visual, material, and performing arts, by queer artists or about queer topics and communities. \r\n"},{"@language":"es","@value":"Término para diferentes formas de actividad creativa, incluidas las artes visuales, materiales y escénicas, realizadas por artistas queer o sobre temas y comunidades queer.\n"},{"@language":"nl","@value":"Term voor verschillende vormen van creatieve activiteit, waaronder visuele, materiële en podiumkunsten, door queer kunstenaars of over queer onderwerpen en gemeenschappen."},{"@language":"sv","@value":"Olika former av konstnärligt skapande, inklusive bildkonst, materiell konst och scenkonst, skapade av queera konstnärer eller som skildrar queera gemenskaper och teman."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000816"},"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0003614"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0002611"},{"@id":"https://homosaurus.org/v5/homoit0004005"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002602","dc:identifier":"homoit0002602","skos:prefLabel":[{"@language":"en","@value":"Intersex art"},{"@language":"es","@value":"Arte intersex"},{"@language":"nl","@value":"Intersekse kunst"},{"@language":"sv","@value":"Intersexkonst"}],"rdfs:comment":[{"@language":"en","@value":"Term for different forms of creative activity, including visual, material, and performing arts, by intersex artists or about intersex topics and communities. \r\n"},{"@language":"es","@value":"Término para diferentes formas de actividad creativa, incluidas las artes visuales, materiales y escénicas, realizadas por artistas intersex o sobre temas y comunidades intersex.\n"},{"@language":"sv","@value":"Olika former av konstnärligt skapande, inklusive bildkonst, materiell konst och scenkonst, skapade av intersexkonstnärer eller med teman och gemenskaper som rör intersexpersoner."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000816"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0002612"},{"@id":"https://homosaurus.org/v5/homoit0004006"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002603","dc:identifier":"homoit0002603","skos:prefLabel":[{"@language":"en","@value":"Aromantic art "},{"@language":"es","@value":"Arte arromántico"},{"@language":"de","@value":"Aromantische Kunst"},{"@language":"nl","@value":"Aromantische kunst"},{"@language":"sv","@value":"Aromantisk konst"}],"rdfs:comment":[{"@language":"en","@value":"Term for different forms of creative activity, including visual, material, and performing arts, by aromantic artists or about aromantic topics and communities. \r\n"},{"@language":"es","@value":"Término para diferentes formas de actividad creativa, incluidas las artes visuales, materiales y escénicas, realizadas por artistas arrománticos o sobre temas y comunidades arrománticos."},{"@language":"de","@value":"Bezeichnung für verschiedene Formen der kreativen Tätigkeit, einschließlich visueller, materieller und darstellender Kunst, von aromantischen Künstler:innen oder über aromantische Themen und Gemeinschaften."},{"@language":"nl","@value":"Overkoepelende term voor verschillende vormen van creatieve activiteit, waaronder visuele, materiële en podiumkunsten, door aromantische artiesten of over aromantische onderwerpen en -gemeenschappen."},{"@language":"sv","@value":"Olika former av konstnärligt skapande, inklusive bildkonst, materiell konst och scenkonst, skapade av aromantiska konstnärer eller som skildrar aromantiska gemenskaper och teman."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000816"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0002613"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002604","dc:identifier":"homoit0002604","skos:prefLabel":[{"@language":"en","@value":"Asexual art "},{"@language":"es","@value":"Arte asexual"},{"@language":"de","@value":"Axexuelle Kunst"},{"@language":"nl","@value":"Aseksuele kunst"},{"@language":"sv","@value":"Asexuell konst"}],"skos:altLabel":[{"@language":"de","@value":"Ace Kunst"},{"@language":"sv","@value":"Ace-konst"}],"rdfs:comment":[{"@language":"en","@value":"Term for different forms of creative activity, including visual, material, and performing arts, by asexual artists or about asexual topics and communities. \r\n"},{"@language":"es","@value":"Término para diferentes formas de actividad creativa, incluidas las artes visuales, materiales y escénicas, de artistas asexuales o sobre temas y comunidades asexuales."},{"@language":"de","@value":"Begriff für verschiedene Formen kreativer Tätigkeit, darunter visuelle, materielle und darstellende Kunst, von asexuellen Künstlern oder zu asexuellen Themen und Communitys."},{"@language":"nl","@value":"Overkoepelende term voor verschillende vormen van creatieve activiteit, waaronder visuele, materiële en podiumkunsten, door aseksuele artiesten of over aseksuele onderwerpen en -gemeenschappen."},{"@language":"sv","@value":"Olika former av konstnärligt skapande, inklusive bildkonst, materiell konst och scenkonst, skapade av asexuella konstnärer eller som skildrar asexuella gemenskaper och teman."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000816"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0002614"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002605","dc:identifier":"homoit0002605","skos:prefLabel":[{"@language":"en","@value":"Demisexual art "},{"@language":"es","@value":"Arte demisexual"},{"@language":"de","@value":"Demisexuelle Kunst"},{"@language":"nl","@value":"Demiseksuele kunst"},{"@language":"sv","@value":"Demisexuell konst"}],"skos:altLabel":{"@language":"de","@value":"Demisexuellen-Kunst"},"rdfs:comment":[{"@language":"en","@value":"Term for different forms of creative activity, including visual, material, and performing arts, by demisexual artists or about demisexual topics and communities. \r\n"},{"@language":"es","@value":"Término para diferentes formas de actividad creativa, incluidas las artes visuales, materiales y escénicas, por artistas demisexuales o sobre temas y comunidades demisexuales."},{"@language":"de","@value":"Bezeichnung für verschiedene Formen des kreativen Schaffens, einschließlich visueller, materieller und darstellender Kunst, von demisexuellen Künstler:innen oder über demisexuelle Themen und Gemeinschaften."},{"@language":"nl","@value":"Term voor verschillende vormen van creatieve activiteit, waaronder visuele, materiële en podiumkunsten, door demiseksuele kunstenaars of over demiseksuele onderwerpen en gemeenschappen."},{"@language":"sv","@value":"Olika former av konstnärligt skapande, inklusive bildkonst, materiell konst och scenkonst, skapade av demisexuella konstnärer eller som skildrar demisexuella gemenskaper och teman."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000816"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0002615"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002886","dc:identifier":"homoit0002886","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ operas "},{"@language":"es","@value":"Óperas LGBTQ+"},{"@language":"nl","@value":"LHBTQ+-opera's"},{"@language":"sv","@value":"Opera (hbtq+)"}],"rdfs:comment":[{"@language":"en","@value":"Long-form musical performances combining singing, orchestral music, and often ballet, typically set to a dramatic narrative or libretto and presented on a theater stage centered on LGBTQ+ characters or themes."},{"@language":"es","@value":"Presentaciones musicales de larga duración que combinan canto, música orquestal y, a menudo, ballet, generalmente ambientadas con una narrativa o libreto dramático y presentadas en un escenario teatral, centradas en personajes o temas LGBTQ+."},{"@language":"nl","@value":"Lange muziekuitvoeringen waarin zang, orkestmuziek en vaak ballet worden gecombineerd, meestal gebaseerd op een dramatisch verhaal of libretto en gepresenteerd op een theaterpodium waarin LHBTQ+-personages of -thema's centraal staan."},{"@language":"sv","@value":"Längre musikdramatiska verk som kombinerar sång, orkestermusik och ofta balett, vanligtvis baserade på en dramatisk berättelse eller ett libretto och framförda på teaterscen. Används för operor med hbtq+-karaktärer eller teman."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000816"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0002887"},{"@id":"https://homosaurus.org/v5/homoit0002888"},{"@id":"https://homosaurus.org/v5/homoit0002889"},{"@id":"https://homosaurus.org/v5/homoit0002890"},{"@id":"https://homosaurus.org/v5/homoit0002891"},{"@id":"https://homosaurus.org/v5/homoit0003166"},{"@id":"https://homosaurus.org/v5/homoit0003167"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0003168"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003610","dc:identifier":"homoit0003610","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ music"},{"@language":"nl","@value":"LHBTQ+-muziek"},{"@language":"sv","@value":"Hbtq+-musik"}],"skos:altLabel":[{"@language":"en","@value":"Music (LGBTQ)"},{"@language":"sv","@value":"Musik (hbtq+)"}],"rdfs:comment":[{"@language":"en","@value":"Music created by LGBTQ+ artists, for LGBTQ+ audiences, and/or that expresses an LGBTQ+ sensibility."},{"@language":"nl","@value":"Muziek gemaakt door LHBTQ+-artiesten, voor LHBTQ+-publiek en/of die een LHBTQ+-sensibiliteit uitdrukt."},{"@language":"sv","@value":"Musik skapad av hbtq+-artister, för hbtq+-publik och/eller med hbtq+-tematik eller uttryck."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000816"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0003159"},{"@id":"https://homosaurus.org/v5/homoit0003611"},{"@id":"https://homosaurus.org/v5/homoit0003612"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000908"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-22"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003662","dc:identifier":"homoit0003662","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ video games"},{"@language":"nl","@value":"LHBTQ+-videospellen"},{"@language":"sv","@value":"Tv- och datorspel (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"Video games (LGBTQ)"},{"@language":"en","@value":"LGBTQ+ computer games"},{"@language":"en","@value":"Computer games (LGBTQ)"},{"@language":"nl","@value":"LHBTQ+-computerspellen"},{"@language":"nl","@value":"LHBTQ+-video games"},{"@language":"nl","@value":"Video games (LHBTQ+)"},{"@language":"nl","@value":"Videospellen (LHBTQ+)"},{"@language":"nl","@value":"Mountainbiken"},{"@language":"nl","@value":"Veldrijden"},{"@language":"nl","@value":"Wielrennen"},{"@language":"sv","@value":"Tv-spel (hbtq+)"},{"@language":"sv","@value":"Datorspel (hbtq+)"}],"rdfs:comment":[{"@language":"en","@value":"Games played by electronically manipulating images produced by a computer program on a display screen. Use in reference to video games intended for LGBTQ+ audiences and/or focusing on LGBTQ+ characters or themes."},{"@language":"nl","@value":"Games die worden gespeeld door het elektronisch manipuleren van afbeeldingen die door een computerprogramma op een beeldscherm worden geproduceerd. Gebruik deze term voor videogames die bedoeld zijn voor LHBTQ+-publiek en/of die zich richten op LHBTQ+-personages of -thema's."},{"@language":"sv","@value":"Tv- och datorspel där bilder styrs elektroniskt via ett datorprogram på en skärm. Används för spel som riktar sig till hbtq+-publik eller har hbtq+-karaktärer och teman."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000816"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0002209"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-22"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000908","dc:identifier":"homoit0000908","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ musicians"},{"@language":"es","@value":"Músicos LGBTQ+"},{"@language":"nl","@value":"LHBTQ+-musici"},{"@language":"sv","@value":"Hbtq+-musiker"}],"skos:altLabel":[{"@language":"en","@value":"Musicians (LGBTQ)"},{"@language":"en","@value":"LGBTQ musicians"},{"@language":"es","@value":"Músicos LGBTQ"},{"@language":"es","@value":"Músicos (LGBTQ)"},{"@language":"sv","@value":"Musiker (hbtq+)"}],"rdfs:comment":[{"@language":"en","@value":"LGBTQ+ people who create and/or perform music."},{"@language":"es","@value":"Personas LGBTQ+ que crean y/o interpretan música."},{"@language":"nl","@value":"LHBTQ+-personen die muziek maken en/of uitvoeren."},{"@language":"sv","@value":"Hbtq+-personer som skapar och/eller framför musik."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000915"},"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0004444"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000816"},{"@id":"https://homosaurus.org/v5/homoit0000833"},{"@id":"https://homosaurus.org/v5/homoit0002147"},{"@id":"https://homosaurus.org/v5/homoit0003610"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQMusicians"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001051","dc:identifier":"homoit0001051","skos:prefLabel":[{"@language":"en","@value":"Nude photographs"},{"@language":"es","@value":"Fotos nudistas"},{"@language":"fr","@value":"Photographies de nu"},{"@language":"nl","@value":"Naaktfoto's"},{"@language":"sv","@value":"Nakenfoton"}],"skos:altLabel":[{"@language":"en","@value":"Nudes"},{"@language":"es","@value":"Fotos desnudas"},{"@language":"es","@value":"Desnudos"},{"@language":"es","@value":"Nudes"},{"@language":"es","@value":"Fotografías de desnudos"},{"@language":"es","@value":"Fotos de desnudos"},{"@language":"fr","@value":"Photographies de personnes nues"}],"rdfs:comment":[{"@language":"en","@value":"Images of naked individuals, including those taken by amateurs or professionals; may be produced for aesthetic or erotic purposes."},{"@language":"es","@value":"Imágenes de personas desnudas, incluidas las tomadas por aficionados o profesionales; pueden producirse con fines estéticos o eróticos."},{"@language":"fr","@value":"Photographies de personnes nues prises par des photographes professionnel·le·s ou amateur·trice·s réalisées à des fins esthétiques ou érotiques."},{"@language":"nl","@value":"Afbeeldingen van naakte personen, inclusief foto's gemaakt door amateurs en professionals; kan worden geproduceerd voor esthetische of erotische doeleinden"},{"@language":"sv","@value":"Bilder av nakna personer, tagna av amatörer eller yrkesfotografer. Kan vara skapade för estetiska eller erotiska ändamål."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001052"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000816"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001052"},"dc:replaces":{"@id":"http://homosaurus.org/v2/nudePhotographs"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001052","dc:identifier":"homoit0001052","skos:prefLabel":[{"@language":"en","@value":"Nude art"},{"@language":"es","@value":"Arte desnudo"},{"@language":"fr","@value":"Nu artistique"},{"@language":"nl","@value":"Naakten in de kunst"},{"@language":"sv","@value":"Nakenkonst"}],"skos:altLabel":[{"@language":"fr","@value":"Art du nu"},{"@language":"fr","@value":"Nu"},{"@language":"fr","@value":"Art nu"},{"@language":"sv","@value":"Nakna motiv"}],"rdfs:comment":[{"@language":"en","@value":"Works of art depicting naked individuals, either for aesthetic or erotic purposes; includes paintings, photographs, sculptures, etc."},{"@language":"es","@value":"Obras de arte que representan a personas desnudas, con fines estéticos o eróticos; incluye pinturas, fotografías, esculturas, etc."},{"@language":"fr","@value":"Genre artistique qui consiste en la représentation de personnes nues, à des fins esthétiques ou érotiques comprend les peintures, les photographies, les sculptures, etc."},{"@language":"nl","@value":"Kunstwerken met afbeeldingen van naakte individuen, hetzij voor esthetische of erotische doeleinden; omvat schilderijen, foto's, sculpturen, enz."},{"@language":"sv","@value":"Konstverk som avbildar nakna människor för estetiska eller erotiska syften. Inkluderar målningar, fotografier, skulpturer med mera."}],"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0001051"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000816"},{"@id":"https://homosaurus.org/v5/homoit0002579"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85093169"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001052"},"dc:replaces":{"@id":"http://homosaurus.org/v2/nudes"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002201","dc:identifier":"homoit0002201","skos:prefLabel":[{"@language":"en","@value":"Slash art"},{"@language":"es","@value":"Arte slash"},{"@language":"nl","@value":"Slash art"},{"@language":"sv","@value":"Slash-konst"}],"skos:altLabel":{"@language":"sv","@value":"Slash art"},"rdfs:comment":[{"@language":"en","@value":"Artwork depicting same-sex or same-gender couples that is usually erotic or pornographic in nature. Historically used for male-male couples only, but is now used more broadly; includes femslash art."},{"@language":"es","@value":"Obras de arte que representan parejas del mismo sexo o del mismo género y que suelen ser de naturaleza erótica o pornográfica. Históricamente se utilizaba únicamente para parejas de hombres, pero ahora se utiliza de forma más amplia; incluye arte femslash."},{"@language":"nl","@value":"Kunstwerk van koppels van hetzelfde geslacht of hetzelfde gender dat meestal erotisch of pornografisch van aard is. Van oudsher alleen gebruikt voor man-man koppels, maar wordt nu breder gebruikt; inclusief femslash-kunst"},{"@language":"sv","@value":"Konstverk som skildrar samkönade eller samkönsidentifierade par och som oftast är erotiska eller pornografiska. Termen användes ursprungligen för man/man-par men används numera i bredare bemärkelse och inkluderar även femslash-konst."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0002155"},{"@id":"https://homosaurus.org/v5/homoit0002204"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000816"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002597","dc:identifier":"homoit0002597","skos:prefLabel":[{"@language":"en","@value":"Two-Spirit art "},{"@language":"es","@value":"Arte dos espíritus"},{"@language":"nl","@value":"Two-Spirit kunst"},{"@language":"sv","@value":"Two-spirit-konst"}],"skos:altLabel":[{"@language":"en","@value":"2S art"},{"@language":"en","@value":"Two Spirit art"},{"@language":"en","@value":"Two Spirited art"},{"@language":"en","@value":"Two-Spirited art"}],"rdfs:comment":[{"@language":"en","@value":"Term for different forms of creative activity, including visual, material, and performing arts, by Two-Sprit artists or about Two-Spirit topics and communities. \r\n"},{"@language":"es","@value":"Término para diferentes formas de actividad creativa, incluidas las artes visuales, materiales y escénicas, realizadas por artistas dos espíritus o sobre temas y comunidades dos espíritus.\n"},{"@language":"nl","@value":"Term voor verschillende vormen van creatieve activiteit, waaronder beeldende, materiële en uitvoerende kunsten, door Two-Spirit-kunstenaars of over Two-Spirit-onderwerpen en -gemeenschappen."},{"@language":"sv","@value":"Olika former av konstnärligt skapande, inklusive bildkonst, materiell konst och scenkonst, skapade av Two-spirit-konstnärer eller som skildrar Two-spirit-gemenskaper och teman."}],"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0002606"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000816"},{"@id":"https://homosaurus.org/v5/homoit0004008"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0002597"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003991","dc:identifier":"homoit0003991","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ people in arts and media"},{"@language":"nl","@value":"LHBTQ+-personen in de kunsten en media"},{"@language":"sv","@value":"Konst och media (hbtq+)"}],"skos:altLabel":{"@language":"sv","@value":"Hbtq+-personer inom konst och media"},"rdfs:comment":[{"@language":"en","@value":"Umbrella term for the depiction of LGBTQ+ people and communities in different forms of creative activity and cultural production, including literature, visual art, and popular media. Use more specific terms if possible."},{"@language":"nl","@value":"Overkoepelende term voor LHBTQ+-personen en -gemeenschappen in verschillende vormen van creatieve activiteit en culturele productie, waaronder literatuur, beeldende kunst en populaire media. Gebruik indien mogelijk specifiekere termen."},{"@language":"sv","@value":"Paraplyterm för skildringen av hbtq+-personer och hbtq+-grupper inom olika former av kreativ aktivitet och kulturell produktion, inklusive litteratur, bildkonst och populärmedia. Använd mer specifika termer om möjligt."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000915"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0003992"},{"@id":"https://homosaurus.org/v5/homoit0003993"},{"@id":"https://homosaurus.org/v5/homoit0003994"},{"@id":"https://homosaurus.org/v5/homoit0003995"},{"@id":"https://homosaurus.org/v5/homoit0003996"},{"@id":"https://homosaurus.org/v5/homoit0003997"},{"@id":"https://homosaurus.org/v5/homoit0003998"},{"@id":"https://homosaurus.org/v5/homoit0004000"},{"@id":"https://homosaurus.org/v5/homoit0004009"},{"@id":"https://homosaurus.org/v5/homoit0004018"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000816"},{"@id":"https://homosaurus.org/v5/homoit0003999"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2025-04-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000818","dc:identifier":"homoit0000818","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ awards"},{"@language":"es","@value":"Premios LGBTQ+"},{"@language":"ja","@value":"LGBTQ+アワード"},{"@language":"nl","@value":"LHBTQ+-onderscheidingen"},{"@language":"sv","@value":"Priser (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"LGBTQ awards"},{"@language":"es","@value":"Premios LGBTQ"},{"@language":"ja","@value":"LGBTQアワード"},{"@language":"sv","@value":"Hbtq+-priser"}],"rdfs:comment":[{"@language":"en","@value":"Prizes or forms of recognition given in honor of achievements by LBGTQ+ individuals or in support of LGBTQ+ issues or communities."},{"@language":"es","@value":"Premios o formas de reconocimiento otorgados en honor a los logros de las personas LBGTQ+ o en apoyo a los asuntos o comunidades LGBTQ+."},{"@language":"ja","@value":"LGBTQ+の人々の功績を称えるため、あるいはLGBTQ+の課題やコミュニティを支援するために贈られる賞や表彰。"},{"@language":"nl","@value":"Prijzen of vormen van erkenning die worden gegeven ter ere van prestaties van LHBTQ+-personen of ter ondersteuning van LHBTQ+-kwesties of -gemeenschappen."},{"@language":"sv","@value":"Priser eller former av erkännande som ges till hbtq+-personer för prestationer, eller i stöd för hbtq+-frågor och hbtq+-gemenskaper."}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000891"},{"@id":"https://homosaurus.org/v5/homoit0003106"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000818"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQAwards"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000891","dc:identifier":"homoit0000891","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ literary awards"},{"@language":"es","@value":"Premios literarios LGBTQ+"},{"@language":"nl","@value":"LHBTQ+-literaire prijzen"},{"@language":"sv","@value":"Litteraturpriser (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"LGBTQ literary awards"},{"@language":"es","@value":"Premios literarios LGBTQ"}],"rdfs:comment":[{"@language":"en","@value":"Prizes or forms of recognition given in honor of influential LGBTQ+ writers or literary works featuring LGBTQ+ characters and themes."},{"@language":"es","@value":"Premios o formas de reconocimiento otorgados en honor a escritores o obras literarias LGBTQ+ influyentes que presenten personajes y temas LGBTQ+."},{"@language":"nl","@value":"Prijzen of vormen van erkenning die worden gegeven ter ere van invloedrijke LHBTQ+-schrijvers of literaire werken met LHBTQ+-personages en -thema's."},{"@language":"sv","@value":"Priser eller former av erkännande som ges till inflytelserika hbtq+-författare eller till litterära verk med hbtq+-karaktärer och teman."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000818"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000972"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000818"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQLiteraryAwards"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000820","dc:identifier":"homoit0000820","skos:prefLabel":[{"@language":"en","@value":"Biracial LGBTQ+ people"},{"@language":"es","@value":"Personas LGBTQ+ birraciales"},{"@language":"de","@value":"Biracial LGBTQ+-Personen"},{"@language":"nl","@value":"Biraciale LHBTQ+-personen"},{"@language":"sv","@value":"Mixade hbtq+-personer"}],"skos:altLabel":[{"@language":"en","@value":"Bi-racial people (LGBTQ)"},{"@language":"en","@value":"Biracial people (LGBTQ)"},{"@language":"en","@value":"Bi-racial LGBTQ+ people"},{"@language":"en","@value":"LGBTQ+ bi-racial people"},{"@language":"en","@value":"LGBTQ+ biracial people"},{"@language":"es","@value":"Personas LGBTQ+ bi-raciales"},{"@language":"es","@value":"Personas birraciales (LGBTQ)"},{"@language":"es","@value":"Personas bi-raciales LGBTQ+"},{"@language":"es","@value":"Personas birraciales LGBTQ+"},{"@language":"es","@value":"Personas bi-raciales (LGBTQ)||"},{"@language":"de","@value":"Bi-racial LGBTQ+-Personen"},{"@language":"nl","@value":"Bi-raciale personen (LHBTQ+)"},{"@language":"nl","@value":"Biraciale personen (LHBTQ+)"},{"@language":"nl","@value":"LHBTQ+-bi-raciale personen"},{"@language":"nl","@value":"LHBTQ+-biraciale personen"},{"@language":"sv","@value":"Blandade hbtq+-personer"}],"rdfs:comment":[{"@language":"en","@value":"LGBTQ+ people who belong to two or more racial groups. Only use to describe people who self-identify as biracial."},{"@language":"es","@value":"Personas LGBTQ+ que pertenecen a dos o más grupos raciales. Utilícese únicamente para personas que se autoidentifiquen como birraciales."},{"@language":"de","@value":"LGBTQ+-Personen, die zu zwei oder mehreren Volksgruppen gehören. Hinweis: Der englische Begriff «Race» ist nicht mit dem deutschen Begriff «Rasse» gleichzusetzen, da sie in zwei unterschiedlichen Diskursen stehen. Oft wird deshalb im Deutschen ebenfalls Race verwendet."},{"@language":"nl","@value":"LHBTQ+-personen die tot twee of meer raciale groepen behoren. Gebruik alleen voor personen die zich als biracial identificeren."},{"@language":"sv","@value":"Hbtq+-personer som tillhör två eller flera etniska grupper. Används endast för personer som själva identifierar sig som mixade."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001101"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0001796"},{"@id":"https://homosaurus.org/v5/homoit0001797"},{"@id":"https://homosaurus.org/v5/homoit0001798"},{"@id":"https://homosaurus.org/v5/homoit0001799"},{"@id":"https://homosaurus.org/v5/homoit0001800"},{"@id":"https://homosaurus.org/v5/homoit0002904"},{"@id":"https://homosaurus.org/v5/homoit0002961"},{"@id":"https://homosaurus.org/v5/homoit0003399"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQBiracialPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001796","dc:identifier":"homoit0001796","skos:prefLabel":[{"@language":"en","@value":"Biracial lesbians"},{"@language":"es","@value":"Lesbianas birraciales"},{"@language":"de","@value":"Biracial Lesben"},{"@language":"nl","@value":"Biraciale lesbische vrouwen"},{"@language":"sv","@value":"Mixade lesbiska"}],"skos:altLabel":[{"@language":"en","@value":"Bi-racial lesbians"},{"@language":"es","@value":"Lesbianas bi-raciales"},{"@language":"de","@value":"Bi-racial Lesben"},{"@language":"sv","@value":"Blandade lesbiska"}],"rdfs:comment":[{"@language":"en","@value":"Lesbians who belong to two or more racial groups. Only use to describe people who self-identify as biracial."},{"@language":"es","@value":"Lesbianas que pertenecen a dos o más grupos raciales. Utilícese únicamente para personas que se autoidentifiquen como birraciales."},{"@language":"de","@value":"Lesben, die zu zwei oder mehreren Volksgruppen gehören. Hinweis: Der englische Begriff «Race» ist nicht mit dem deutschen Begriff «Rasse» gleichzusetzen, da sie in zwei unterschiedlichen Diskursen stehen. Oft wird deshalb im Deutschen ebenfalls Race verwendet."},{"@language":"nl","@value":"Lesbische vrouwen die tot twee of meer raciale groepen behoren. Gebruik alleen voor personen die zich als biracial identificeren."},{"@language":"sv","@value":"Lesbiska som tillhör två eller flera etniska grupper. Används endast för personer som själva identifierar sig som mixade."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000820"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-01-18"}