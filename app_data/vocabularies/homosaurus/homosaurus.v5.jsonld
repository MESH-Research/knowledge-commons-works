"es","@value":"Niños y niñas hetero"},{"@language":"es","@value":"Niñxs hetero"}],"rdfs:comment":[{"@language":"en","@value":"Children younger than 18 years who identify as heterosexual."},{"@language":"de","@value":"Personen, die die Volljährigkeit noch nicht erreicht haben und sich als heterosexuell identifizieren."},{"@language":"es","@value":"Niños y niñas menores de 18 años que se autoidentifican como heterosexuales."},{"@language":"nl","@value":"Kinderen jonger dan 18 jaar die zich identificeren als heteroseksueel."},{"@language":"sv","@value":"Heterosexuella som ännu inte har nått tonåren."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000255"},{"@id":"https://homosaurus.org/v5/homoit0000627"},{"@id":"https://homosaurus.org/v5/homoit0000630"}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000621"},{"@id":"https://homosaurus.org/v5/homoit0000623"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000421"},"dc:issued":{"@type":"xsd:date","@value":"2022-11-10"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002628","dc:identifier":"homoit0002628","skos:prefLabel":[{"@language":"en","@value":"Surro babies "},{"@language":"es","@value":"Bebés de subrogacion"},{"@language":"nl","@value":"Draagmoederbaby's"},{"@language":"sv","@value":"Surrobarn"}],"skos:altLabel":[{"@language":"en","@value":"Surro baby"},{"@language":"en","@value":"Surrogate babies"},{"@language":"nl","@value":"Draagmoeder baby's"},{"@language":"sv","@value":"Surrobebisar"},{"@language":"sv","@value":"Surrbarn"}],"rdfs:comment":[{"@language":"en","@value":"People born through surrogacy."},{"@language":"es","@value":"Personas nacidas mediante la gestación subrogada."},{"@language":"nl","@value":"Personen geboren via draagmoederschap."},{"@language":"sv","@value":"Personer som fötts genom surrogatarrangemang."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000255"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000587"},{"@id":"https://homosaurus.org/v5/homoit0002627"}],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2020000096"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000421"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002629","dc:identifier":"homoit0002629","skos:prefLabel":[{"@language":"en","@value":"Test tube babies "},{"@language":"es","@value":"Bebés probeta"},{"@language":"nl","@value":"Reageerbuisbaby's"},{"@language":"sv","@value":"Provrörsbarn"}],"skos:altLabel":{"@language":"en","@value":"Test tube baby"},"rdfs:comment":[{"@language":"en","@value":"People who were conceived through IVF, or in vitro fertilization."},{"@language":"es","@value":"Personas que fueron concebidas mediante FIV o fertilización in vitro."},{"@language":"nl","@value":"Personen die zijn verwekt via IVF of in-vitrofertilisatie."},{"@language":"sv","@value":"Personer som blivit till genom IVF, det vill säga in vitro-fertilisering."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000255"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000659"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000421"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002772","dc:identifier":"homoit0002772","skos:prefLabel":[{"@language":"en","@value":"Asexual children"},{"@language":"de","@value":"Asexuelle Kinder"},{"@language":"es","@value":"Niños y niñas asexuales"},{"@language":"nl","@value":"Aseksuele kinderen"},{"@language":"sv","@value":"Asexuella barn"}],"skos:altLabel":[{"@language":"de","@value":"Ace Kinder"},{"@language":"es","@value":"Niñxs asexuales"},{"@language":"es","@value":"Niños ace"},{"@language":"es","@value":"Niñas ace"},{"@language":"es","@value":"Niñxs ace"},{"@language":"sv","@value":"Ace-barn"}],"rdfs:comment":[{"@language":"en","@value":"Asexual people who have not yet reached the age of adolescence."},{"@language":"de","@value":"Asexuelle Personen, die die Volljährigkeit noch nicht erreicht haben."},{"@language":"es","@value":"Niños menores de 18 años que se autoidentifican como asexuales."},{"@language":"nl","@value":"Aseksuele personen die de leeftijd van adolescentie nog niet hebben bereikt"},{"@language":"sv","@value":"Asexuella som ännu inte har nått tonåren."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000255"},{"@id":"https://homosaurus.org/v5/homoit0000256"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000421"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-27"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003501","dc:identifier":"homoit0003501","skos:prefLabel":[{"@language":"en","@value":"Turkey baster babies"},{"@language":"es","@value":"Bebés de jeringa"},{"@language":"nl","@value":"Turkey baster baby's"},{"@language":"sv","@value":"Barn som blivit till genom heminsemination"}],"skos:altLabel":{"@language":"sv","@value":"Barn som blivit till genom självinsemination"},"rdfs:comment":[{"@language":"en","@value":"Babies conceived through at-home artificial insemination, specifically by injecting semen into one's vagina using a turkey baster. There is an extensive history of at-home artificial insemination undertaken by LGBTQ+ people, including gay men contributing semen to aid lesbian couples in conceiving."},{"@language":"es","@value":"Bebés concebidos mediante inseminación artificial casera, específicamente inyectando semen en la vagina con una jeringa. Existe una amplia historia de inseminación artificial casera realizada por personas LGBTQ+, incluidos hombres gay que aportan semen para ayudar a parejas lesbianas a concebir."},{"@language":"nl","@value":"Baby's die zijn verwekt door kunstmatige inseminatie thuis, met name door sperma in de vagina te injecteren met behulp van een kalkoenbaster. Er is een uitgebreide geschiedenis van kunstmatige inseminatie thuis uitgevoerd door LHBTQ+-mensen, waaronder homomannen die sperma leveren om lesbische stellen te helpen bij het zwanger worden."},{"@language":"sv","@value":"Barn som blivit till genom heminsemination, i amerikansk kontext särskilt genom att injicera sperma i slidan med hjälp av en kalkonspruta. Det finns en omfattande historia av heminsemination inom hbtq+-gemenskaper, inklusive bögar som bidragit med sperma för att hjälpa lesbiska par att bli gravida."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000255"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0002617"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000421"},"dc:issued":{"@type":"xsd:date","@value":"2024-07-31"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000263","dc:identifier":"homoit0000263","skos:prefLabel":[{"@language":"en","@value":"Children's sexuality"},{"@language":"es","@value":"Sexualidad infantil"},{"@language":"de","@value":"Kindliche Sexualität"},{"@language":"nl","@value":"Kinderseksualiteit"},{"@language":"sv","@value":"Barns sexualitet"}],"skos:altLabel":[{"@language":"es","@value":"Sexualidad juvenil"},{"@language":"de","@value":"Sexualität von Kindern"}],"rdfs:comment":[{"@language":"en","@value":"The sexual behavior of children, include children's sense of their sexual orientation."},{"@language":"es","@value":"El comportamiento sexual de los niños, incluyendo el sentido de los niños sobre su orientación sexual."},{"@language":"de","@value":"Das Sexualverhalten von Kindern, einschließlich des Bewusstseins der Kinder für ihre sexuelle Orientierung."},{"@language":"nl","@value":"seksueel gedrag van kinderen"},{"@language":"sv","@value":"Barns sexuella beteende, inklusive barns uppfattning om sin sexuella läggning."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001306"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000255"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001306"},"dc:replaces":{"@id":"http://homosaurus.org/v2/childrensSexuality"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000347","dc:identifier":"homoit0000347","skos:prefLabel":[{"@language":"en","@value":"Desire to have children"},{"@language":"es","@value":"Deseo de tener hijos"},{"@language":"de","@value":"Kinderwunsch"},{"@language":"fr","@value":"Désir d'avoir des enfants"},{"@language":"nl","@value":"Kinderwens"},{"@language":"sv","@value":"Barnlängtan"}],"skos:altLabel":{"@language":"es","@value":"Deseo por tener hijos"},"rdfs:comment":[{"@language":"en","@value":"A person's drive or desire to have children."},{"@language":"es","@value":"El impulso o deseo de una persona de tener hijos."},{"@language":"de","@value":"Der Wunsch oder das Verlangen einer Person, Kinder zu haben."},{"@language":"fr","@value":"Volonté ou désir d'une personne d'avoir des enfants."},{"@language":"nl","@value":"Iemands drang of verlangen om kinderen te krijgen."},{"@language":"sv","@value":"En persons längtan eller önskan att få barn."}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000255"},{"@id":"https://homosaurus.org/v5/homoit0000843"},{"@id":"https://homosaurus.org/v5/homoit0000864"},{"@id":"https://homosaurus.org/v5/homoit0000914"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000347"},"dc:replaces":{"@id":"http://homosaurus.org/v2/desireToHaveChildren"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001520","dc:identifier":"homoit0001520","skos:prefLabel":[{"@language":"en","@value":"Youth"},{"@language":"es","@value":"Juventud"},{"@language":"nl","@value":"Jongeren"},{"@language":"sv","@value":"Ungdomar"}],"skos:altLabel":[{"@language":"nl","@value":"Pubers"},{"@language":"nl","@value":"Teenagers"},{"@language":"sv","@value":"Unga personer"}],"rdfs:comment":[{"@language":"en","@value":"The time period between childhood and adulthood."},{"@language":"es","@value":"El período de tiempo entre la niñez y la edad adulta."},{"@language":"nl","@value":"De periode tussen kindertijd en volwassenheid"},{"@language":"sv","@value":"Person i tidsperioden mellan barndom och vuxenliv."}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000630"},{"@id":"https://homosaurus.org/v5/homoit0000674"},{"@id":"https://homosaurus.org/v5/homoit0001521"},{"@id":"https://homosaurus.org/v5/homoit0002281"},{"@id":"https://homosaurus.org/v5/homoit0002711"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000255"},{"@id":"https://homosaurus.org/v5/homoit0002151"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85149310"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001520"},"dc:replaces":{"@id":"http://homosaurus.org/v2/youth"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homo