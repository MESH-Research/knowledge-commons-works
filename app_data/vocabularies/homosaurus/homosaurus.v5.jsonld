":"Nonbinary drama"},"rdfs:comment":{"@language":"en","@value":"Genre of written works to be performed on stage. Use for drama focusing on non-binary characters and themes. "},"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000376"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2026-06-09"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-10"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001723","dc:identifier":"homoit0001723","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ authors"},{"@language":"es","@value":"Autores LGBTQ+"},{"@language":"ja","@value":"LGBTQ+ の作家"},{"@language":"nl","@value":"LHBTQ+-auteurs"},{"@language":"sv","@value":"Hbtq+-författare"}],"skos:altLabel":[{"@language":"en","@value":"Authors (LGBTQ)"},{"@language":"es","@value":"Autores (LGBTQ)"},{"@language":"ja","@value":"作家(LGBTQ)"}],"rdfs:comment":[{"@language":"en","@value":"LGBTQ+ creators of written works."},{"@language":"es","@value":"Creadores de obras escritas que se conocen por ser personas LGBTQ+."},{"@language":"ja","@value":"LGBTQ+の作家・クリエイター。"},{"@language":"nl","@value":"LHBTQ+-makers van geschreven werken."},{"@language":"sv","@value":"Hbtq+-personer som är skapare av skrivna verk."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000915"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0001724"},{"@id":"https://homosaurus.org/v5/homoit0001725"},{"@id":"https://homosaurus.org/v5/homoit0001726"},{"@id":"https://homosaurus.org/v5/homoit0001727"},{"@id":"https://homosaurus.org/v5/homoit0001728"},{"@id":"https://homosaurus.org/v5/homoit0001747"},{"@id":"https://homosaurus.org/v5/homoit0001748"},{"@id":"https://homosaurus.org/v5/homoit0001749"},{"@id":"https://homosaurus.org/v5/homoit0002487"},{"@id":"https://homosaurus.org/v5/homoit0002505"},{"@id":"https://homosaurus.org/v5/homoit