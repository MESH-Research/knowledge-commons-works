/homosaurus.org/v5/homoit0001430"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2007005159"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000421"},"dc:replaces":{"@id":"http://homosaurus.org/v2/childrenOfTransgenderPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000262","dc:identifier":"homoit0000262","skos:prefLabel":[{"@language":"en","@value":"Children of queer people"},{"@language":"de","@value":"Kinder von queeren Personen"},{"@language":"es","@value":"Hijxs de personas queer"},{"@language":"fr","@value":"Enfants de personnes queers"},{"@language":"nl","@value":"Kinderen van queer personen"},{"@language":"sv","@value":"Barn till queera personer"}],"skos:altLabel":[{"@language":"es","@value":"Hijas de personas queer"},{"@language":"es","@value":"Hijos de personas queer"},{"@language":"es","@value":"Hijos e hijas de personas queer"}],"rdfs:comment":[{"@language":"en","@value":"Children who have one or more queer parent."},{"@language":"de","@value":"Kinder, die einen oder mehrere queere Elternteile haben."},{"@language":"es","@value":"Hijos o hijas que tienen uno o más madres o padres queer."},{"@language":"fr","@value":"Enfants dont un ou plusieurs parents sont queers."},{"@language":"nl","@value":"Kinderen die een of meer queer ouders hebben"},{"@language":"sv","@value":"Barn som har en eller flera queera föräldrar."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000260"},"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0001334"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001176"},{"@id":"https://homosaurus.org/v5/homoit0001194"},{"@id":"https://homosaurus.org/v5/homoit0002583"},{"@id":"https://homosaurus.org/v5/homoit0002588"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000421"},"dc:replaces":{"@id":"http://homosaurus.org/v2/childrenOfQueerPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001767","dc:identifier":"homoit0001767","skos:prefLabel":[{"@language":"en","@value":"Children of intersex people"},{"@language":"de","@value":"Kinder von inter* Personen"},{"@language":"es","@value":"Hijxs de personas intersexuales"},{"@language":"fr","@value":"Enfants de personnes intersexes"},{"@language":"nl","@value":"Kinderen van intersekse personen"},{"@language":"sv","@value":"Barn till intersexpersoner"}],"skos:altLabel":[{"@language":"es","@value":"Hijas de personas intersex"},{"@language":"es","@value":"Hijos de personas intersexuales"},{"@language":"es","@value":"Hijos e hijas de personas intersexuales"}],"rdfs:comment":[{"@language":"en","@value":"Children who have one or more intersex parent."},{"@language":"de","@value":"Kinder, die einen oder mehrere inter* Elternteile haben."},{"@language":"es","@value":"Hijos o hijas que tienen uno o más madres o padres intersexuales."},{"@language":"fr","@value":"Enfants dont un ou plusieurs parents sont intersexes."},{"@language":"nl","@value":"Kinderen die een of meer interseksuele ouders hebben"},{"@language":"sv","@value":"Barn som har en eller flera intersexföräldrar."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000260"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000618"},{"@id":"https://homosaurus.org/v5/homoit0001759"},{"@id":"https://homosaurus.org/v5/homoit0001763"},{"@id":"https://homosaurus.org/v5/homoit0002745"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000421"},"dc:issued":{"@type":"xsd:date","@value":"2021-11-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002583","dc:identifier":"homoit0002583","skos:prefLabel":[{"@language":"en","@value":"Queerspawn "},{"@language":"es","@value":"Queerspawn"},{"@language":"nl","@value":"Queerspawn"},{"@language":"sv","@value":"Queerspawn"}],"rdfs:comment":[{"@language":"en","@value":"People with one or more queer parent or caregiver, usually for self-identification. Queerspawn is believed to have been coined in 1995 or 1996 by Stefan Lynch for use in zine published by COLAGE, a U.S. based organization dedicated to supporting people with one or more LGBTQ+ caregiver."},{"@language":"es","@value":"Personas con uno o más padres o cuidadores queer, generalmente utilizado para autoidentificarse. Se cree que Queerspawn fue acuñado en 1995 o 1996 por Stefan Lynch para utilizarlo en un zine publicado por COLAGE, una organización con sede en EE. UU. dedicada a apoyar a las personas con uno o más cuidadores LGBTQ+."},{"@language":"nl","@value":"Term voor personen met één of meer queer ouders of verzorgers, meestal gebruikt voor zelfidentificatie. Queerspawn wordt vermoedelijk in 1995 of 1996 bedacht door Stefan Lynch voor gebruik in een zine uitgegeven door COLAGE, een in de VS gevestigde organisatie die zich inzet voor de ondersteuning van personen met één of meer LHBTQ+-verzorgers."},{"@language":"sv","@value":"Personer med en eller flera queera föräldrar eller vårdnadshavare. Används ofta som en självbeskrivning. Begreppet queerspawn myntades omkring 1995 av Stefan Lynch i ett zine från organisationen COLAGE."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000260"},{"@id":"https://homosaurus.org/v5/homoit0001317"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000262"},{"@id":"https://homosaurus.org/v5/homoit0001176"},{"@id":"https://homosaurus.org/v5/homoit0001194"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000421"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002584","dc:identifier":"homoit0002584","skos:prefLabel":[{"@language":"en","@value":"Bothies"},{"@language":"es","@value":"Bothies"},{"@language":"nl","@value":"Bothies"},{"@language":"sv","@value":"Bothies"}],"rdfs:comment":[{"@language":"en","@value":"People who have two or more LGBTQ+ parents or caregivers. Includes individuals born to or adopted by people in a heterosexual relationship who later came out as LGBTQ+, as well as individuals born to or adopted by LGBTQ+ people who came together to create their own families, such as lesbian couples who choose to conceive with friends who are gay men. For use in a Canadian and United States context."},{"@language":"es","@value":"Personas que tienen dos o más padres o cuidadores LGBTQ+. Incluye a personas nacidas o adoptadas por personas en una relación heterosexual que luego se declararon LGBTQ+, así como personas nacidas o adoptadas por personas LGBTQ+ que se unieron para crear sus propias familias, como parejas de lesbianas que eligen concebir con amigos que son hombres gay. Utilícese en contextos canadienses y estadounidenses."},{"@language":"nl","@value":"Personen die twee of meer LHBTQ+ ouders of verzorgers hebben. Omvat personen die zijn geboren uit of geadopteerd door mensen in een heteroseksuele relatie die later uit de kast kwamen als LHBTQ+, evenals personen die zijn geboren uit of geadopteerd door LHBTQ+ mensen die samen hun eigen gezin stichten, zoals lesbische stellen die ervoor kiezen zwanger te worden van mannelijke homoseksuele vrienden. Voor gebruik in Canada en de Verenigde Staten."},{"@language":"sv","@value":"Personer som har två eller flera hbtq+-föräldrar eller vårdnadshavare. Inkluderar individer som fötts eller adopterats av personer i en heterosexuell relation som senare kom ut som hbtq+, samt individer födda eller adopterade av hbtq+-personer som tillsammans skapade sina egna familjer, exempelvis lesbiska par som valt att skaffa barn med bögar. Används i en kanadensisk och amerikansk kontext."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000260"},{"@id":"https://homosaurus.org/v5/homoit0001317"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000420"},{"@id":"https://homosaurus.org/v5/homoit0001075"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000421"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002585","dc:identifier":"homoit0002585","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ children of LGBTQ+ parents"},{"@language":"es","@value":"Hijos LGBTQ+ de padres y madres LGBTQ+"},{"@language":"ja","@value":"LGBTQ+の親を持つLGBTQ+の子どもたち"},{"@language":"nl","@value":"LHBTQ+-kinderen van LHBTQ+-ouders"},{"@language":"sv","@value":"Hbtq+-barn med hbtq+-föräldrar"}],"skos:altLabel":[{"@language":"en","@value":"Second generation (LGBTQ+ families)"},{"@language":"es","@value":"Segunda generación (familias LGBTQ+)"},{"@language":"ja","@value":"第2世代（LGBTQ+の家族）"}],"rdfs:comment":[{"@language":"en","@value":"Term used to describe people who are LGBTQ+ and have at least one LGBTQ+ parent or caregiver."},{"@language":"es","@value":"Término utilizado para describir a las personas que son LGBTQ+ y que tienen al menos un padre o cuidador LGBTQ+."},{"@language":"ja","@value":"LGBTQ+であり、かつLGBTQ+の親または養育者が少なくとも1人いる人々を指す用語。"},{"@language":"nl","@value":"Term die wordt gebruikt om personen te beschrijven die LHBTQ+ zijn en ten minste één LHBTQ+-ouder of -verzorger hebben."},{"@language":"sv","@value":"Term som används för att beskriva hbtq+-personer som har minst en hbtq+-förälder eller vårdnadshavare."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000260"},{"@id":"https://homosaurus.org/v5/homoit0000915"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000420"},{"@id":"https://homosaurus.org/v5/homoit0000752"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000421"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002586","dc:identifier":"homoit0002586","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ family generations"},{"@language":"es","@value":"Generaciones familiares LGBTQ+"},{"@language":"ja","@value":"LGBTQ+の多世代家族"},{"@language":"nl","@value":"LHBTQ+-familiegeneraties"},{"@language":"sv","@value":"Familjegenerationer (hbtq+)"}],"rdfs:comment":[{"@language":"en","@value":"Refers to families with LGBTQ+ individuals in multiple generations."},{"@language":"es","@value":"Se refiere a familias con personas LGBTQ+ en varias generaciones."},{"@language":"ja","@value":"複数の世代にわたってLGBTQ+のメンバーがいる家族を指す。"},{"@language":"nl","@value":"Verwijst naar families met LGBTQ+-personen in meerdere generaties."},{"@language":"sv","@value":"Avser familjer där det finns hbtq+-personer i flera generationer."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000420"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000260"},{"@id":"https://homosaurus.org/v5/homoit0001075"},{"@id":"https://homosaurus.org/v5/homoit0001430"},{"@id":"https://homosaurus.org/v5/homoit0002358"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000420"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001333","dc:identifier":"homoit0001333","skos:prefLabel":[{"@language":"en","@value":"Sons of transgender people"},{"@language":"es","@value":"Hijos de personas transgénero"},{"@language":"fr","@value":"Fils de personnes trans"},{"@language":"nl","@value":"Zonen van transgender personen"},{"@language":"sv","@value":"Söner till transpersoner"}],"rdfs:comment":[{"@language":"en","@value":"Sons who have one or more transgender parent. For sons who are themselves transgender, use the term \"Transgender sons.\""},{"@language":"es","@value":"Hijos que tienen uno o más padres transgénero. Para los hijos que son transgénero, utilice el término \"hijos transgénero\"."},{"@language":"fr","@value":"Fils qui ont un ou plusieurs parents trans."},{"@language":"nl","@value":"Zonen die een of meer transgender ouders hebben. Gebruik voor zonen die zelf transgender zijn de term 'transgender zonen'."},{"@language":"sv","@value":"Söner som har en eller flera transföräldrar. För söner som själva är transpersoner används termen ”Transsöner”."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000261"},{"@id":"https://homosaurus.org/v5/homoit0002355"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000421"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sonsOfTransgenderPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002587","dc:identifier":"homoit0002587","skos:prefLabel":[{"@language":"en","@value":"People with transgender parents"},{"@language":"es","@value":"Personas con padres transgénero"},{"@language":"nl","@value":"Personen met transgender ouders"},{"@language":"sv","@value":"Barn till transpersoner"}],"skos:altLabel":[{"@language":"en","@value":"KOT (Kids of Trans)"},{"@language":"en","@value":"Kids of Trans"},{"@language":"en","@value":"PTP"},{"@language":"en","@value":"People with trans parents"},{"@language":"en","@value":"Transpawn"},{"@language":"es","@value":"Hijos de personas transgénero"},{"@language":"es","@value":"Hijas de personas transgénero"},{"@language":"es","@value":"Hijxs de personas transgénero"},{"@language":"es","@value":"Hijos de personas trans"},{"@language":"es","@value":"Hijas de personas trans"},{"@language":"es","@value":"Hijxs de personas trans"},{"@language":"es","@value":"Personas con padres trans"}],"rdfs:comment":[{"@language":"en","@value":"People who have one or more transgender parent or caregiver."},{"@language":"es","@value":"Personas que tienen uno o más padres o cuidadores transgénero."},{"@language":"nl","@value":"Mensen die één of meer transgender ouders of verzorgers hebben."},{"@language":"sv","@value":"Personer som har en eller flera transpersoner som föräldrar eller vårdnadshavare."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000261"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001412"},{"@id":"https://homosaurus.org/v5/homoit0001430"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000421"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001412","dc:identifier":"homoit0001412","skos:prefLabel":[{"@language":"en","@value":"Transgender families"},{"@language":"es","@value":"Familias transgénero"},{"@language":"fr","@value":"Familles trans"},{"@language":"nl","@value":"Transgender gezinnen"},{"@language":"sv","@value":"Transfamiljer"}],"rdfs:comment":[{"@language":"en","@value":"Families, whether biological, adoptive, or chosen, in which one or more individuals identify as transgender."},{"@language":"es","@value":"Familias, ya sean biológicas, adoptivas o elegidas, en las que una o más personas se autoidentifican como transgénero."},{"@language":"fr","@value":"Familles biologiques, adoptives ou choisies, dans lesquelles une ou plusieurs personnes s'identifient comme trans."},{"@language":"nl","@value":"Gezinnen, biologisch, adoptief of gekozen, waarin een of meer individuen zich identificeren als transgender."},{"@language":"sv","@value":"Familjer – biologiska, adoptiva eller valda – där en eller flera personer identifierar sig som transpersoner."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000420"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000261"},{"@id":"https://homosaurus.org/v5/homoit0001430"},{"@id":"https://homosaurus.org/v5/homoit0002587"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000420"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transgenderFamilies"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001430","dc:identifier":"homoit0001430","skos:prefLabel":[{"@language":"en","@value":"Transgender parents"},{"@language":"es","@value":"Madres y padres transgénero"},{"@language":"nl","@value":"Transgender ouders"},{"@language":"sv","@value":"Transföräldrar"}],"skos:altLabel":[{"@language":"es","@value":"Madres transgénero"},{"@language":"es","@value":"Padres transgénero"}],"rdfs:comment":[{"@language":"en","@value":"Transgender people who are parents."},{"@language":"es","@value":"Personas transgénero que son padres y/o madres."},{"@language":"nl","@value":"Transgender personen die ouders zijn"},{"@language":"sv","@value":"Transpersoner som är föräldrar."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001075"},{"@id":"https://homosaurus.org/v5/homoit0001378"}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0001413"},{"@id":"https://homosaurus.org/v5/homoit0001422"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000261"},{"@id":"https://homosaurus.org/v5/homoit0001412"},{"@id":"https://homosaurus.org/v5/homoit0002586"},{"@id":"https://homosaurus.org/v5/homoit0002587"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2007005144"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000420"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transgenderParents"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001334","dc:identifier":"homoit0001334","skos:prefLabel":[{"@language":"en","@value":"Sons of queer people"},{"@language":"es","@value":"Hijos de personas queer"},{"@language":"fr","@value":"Fils de personnes queers"},{"@language":"nl","@value":"Zonen van queer personen"},{"@language":"sv","@value":"Söner till queera personer"}],"rdfs:comment":[{"@language":"en","@value":"Sons who have one or more queer parent. For sons who are themselves queer, use the term \"Queer sons.\""},{"@language":"es","@value":"Hijos que tienen uno o más padres queer. Para los hijos que son queer, utilice el término \"hijos queer\"."},{"@language":"fr","@value":"Fils qui ont un ou plusieurs parents queers."},{"@language":"nl","@value":"Zonen die een of meer queer ouders hebben. Gebruik voor zonen die zelf queer zijn de term 'queer zonen'."},{"@language":"sv","@value":"Söner som har en eller flera queera föräldrar. För söner som själva är queera används termen ”Queera söner”."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000262"},{"@id":"https://homosaurus.org/v5/homoit0002355"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000421"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sonsOfQueerPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001176","dc:identifier":"homoit0001176","skos:prefLabel":[{"@language":"en","@value":"Queer families"},{"@language":"es","@value":"Familias queer"},{"@language":"fr","@value":"Familles queers"},{"@language":"nl","@value":"Queer gezinnen"},{"@language":"sv","@value":"Queera familjer"}],"rdfs:comment":[{"@language":"en","@value":"Families, whether biological, adoptive, or chosen, in which one or more individuals identify as queer."},{"@language":"es","@value":"Familias, ya sean biológicas, adoptivas o elegidas, en las que una o más personas se autoidentifican como queer."},{"@language":"fr","@value":"Familles de personnes queers"},{"@language":"nl","@value":"Gezinnen, biologisch, adoptief of gekozen, waarin een of meer individuen zich identificeren als queer."},{"@language":"sv","@value":"Familjer – biologiska, adoptiva eller valda – där en eller flera personer identifierar sig som queera."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000420"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000262"},{"@id":"https://homosaurus.org/v5/homoit0000914"},{"@id":"https://homosaurus.org/v5/homoit0001195"},{"@id":"https://homosaurus.org/v5/homoit0002583"},{"@id":"https://homosaurus.org/v5/homoit0002588"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000420"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerFamilies"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001194","dc:identifier":"homoit0001194","skos:prefLabel":[{"@language":"en","@value":"Queer parents"},{"@language":"es","@value":"Madres y padres queer"},{"@language":"nl","@value":"Queer ouders"},{"@language":"sv","@value":"Queera föräldrar"}],"skos:altLabel":[{"@language":"es","@value":"Madres queer"},{"@language":"es","@value":"Padres queer"}],"rdfs:comment":[{"@language":"en","@value":"Queer people who are parents."},{"@language":"es","@value":"Personas queer que son padres y/o madres."},{"@language":"nl","@value":"Queer personen die ouders zijn."},{"@language":"sv","@value":"Queera personer som är föräldrar."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001075"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000262"},{"@id":"https://homosaurus.org/v5/homoit0001195"},{"@id":"https://homosaurus.org/v5/homoit0002583"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000420"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerParents"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002588","dc:identifier":"homoit0002588","skos:prefLabel":[{"@language":"en","@value":"Culturally queer"},{"@language":"es","@value":"Culturalmente queer"},{"@language":"de","@value":"Queer-kulturell geprägt"},{"@language":"nl","@value":"Cultureel queer"},{"@language":"sv","@value":"Kulturellt queer"}],"skos:altLabel":[{"@language":"de","@value":"Culturally queer"},{"@language":"sv","@value":"Queersocialiserad"}],"rdfs:comment":[{"@language":"en","@value":"Term used to describe the feeling shared by many people with queer parents or caregivers that they grew up immersed in queer culture, including queer traditions, celebrations, media, and language."},{"@language":"es","@value":"Término utilizado para describir el sentimiento compartido por muchas personas con padres o cuidadores queer de que crecieron inmersos en una cultura queer, incluidas las tradiciones, las celebraciones, los medios y el lenguaje queer."},{"@language":"de","@value":"Begriff, der das Gefühl beschreibt, das viele Menschen mit queeren Eltern oder Betreuungspersonen teilen, die in einer queeren Kultur aufgewachsen sind, einschließlich queerer Traditionen, Feste, Medien und Sprache."},{"@language":"nl","@value":"Term die wordt gebruikt om het gevoel te beschrijven dat veel personen met queer-ouders of verzorgers delen, namelijk dat ze zijn opgegroeid ondergedompeld in de queer-cultuur, inclusief queer-tradities, vieringen, media en taal."},{"@language":"sv","@value":"Term som används för att beskriva den känsla som många personer med queera föräldrar eller vårdnadshavare delar av att ha vuxit upp omgiven av queer kultur, inklusive queera traditioner, högtider, media och språk."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001832"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000262"},{"@id":"https://homosaurus.org/v5/homoit0001176"},{"@id":"https://homosaurus.org/v5/homoit0001195"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000264","dc:identifier":"homoit0000264","skos:prefLabel":[{"@language":"en","@value":"Chosen names"},{"@language":"es","@value":"Nombre elegido"},{"@language":"de","@value":"Wahlname"},{"@language":"fr","@value":"Prénoms choisis"},{"@language":"nl","@value":"Gekozen namen"},{"@language":"sv","@value":"Valt namn"}],"skos:altLabel":[{"@language":"en","@value":"Preferred names"},{"@language":"de","@value":"Gewählter Name"},{"@language":"fr","@value":"Prénom de naissance"},{"@language":"fr","@value":"Prénom assigné à la naissance"},{"@language":"fr","@value":"Prénom natal"}],"rdfs:comment":[{"@language":"en","@value":"Names chosen by individuals that differ from their birth or legal names; often used to describe names chosen by LGBTQ+ people to better match their identities."},{"@language":"es","@value":"Un nombre elegido por una persona que difiere de su nombre de nacimiento o legal; a menudo utilizado para describir nombres elegidos por personas LGBTQ+ para que coincidan mejor con sus identidades."},{"@language":"de","@value":"Ein Name, der von einer Person gewählt wurde und sich von ihrem Geburtsnamen oder offiziellen Namen unterscheidet; wird oft verwendet, um Namen zu beschreiben, die von LGBTQ+-Personen gewählt wurden, um ihrer Identität besser zu entsprechen."},{"@language":"fr","@value":"Prénoms attribués à la naissance, généralement par les parents."},{"@language":"nl","@value":"Namen gekozen door personen, die afwijkt van hun geboorte- of wettelijke naam; vaak gebruikt om namen te beschrijven die door LHBTQ+-personen zijn gekozen om beter bij hun identiteit te passen."},{"@language":"sv","@value":"Ett namn som en individ väljer och som skiljer sig från deras födelse- eller juridiska namn. Används ofta för att beskriva namn valda av hbtq+-personer för att bättre överensstämma med deras identitet."}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000711"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000264"},"dc:replaces":{"@id":"http://homosaurus.org/v2/chosenName"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000711","dc:identifier":"homoit0000711","skos:prefLabel":[{"@language":"en","@value":"Legal names"},{"@language":"es","@value":"Nombre legal"},{"@language":"de","@value":"Offizieller Name"},{"@language":"nl","@value":"Wettelijke namen"},{"@language":"sv","@value":"Juridiskt namn"}],"rdfs:comment":[{"@language":"en","@value":"Use in reference to laws and regulations concerning the names assigned to individuals at birth."},{"@language":"en","@value":"The name or names that identify a person for legal, adminstrative, and other official purposes based on their legal documentation (such as a birth certificate, name change order, or other government identification document). Some individuals may have different names on different forms of legal documentation. In these instances, the most recent version of an individual's legal name generally takes precedence."},{"@language":"es","@value":"Utilícese en referencia a las leyes y regulaciones relativas al nombre asignado a una persona al nacer."},{"@language":"de","@value":"Bezieht sich auf Gesetze und Vorschriften bezüglich des Namens, der einer Person bei der Geburt zugewiesen wird."},{"@language":"nl","@value":"Persoons- en/of familienamen die wettelijk zijn vastgelegd in officiële documenten, zoals geboorteaktes."},{"@language":"sv","@value":"Används för att beskriva det namn som regleras i lag och erkänns av juridiska instanser. I en amerikansk kontext det namn som tilldelas en individ vid födseln."}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000264"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000711"},"dc:replaces":{"@id":"http://homosaurus.org/v2/legalName"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000386","dc:identifier":"homoit0000386","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ Eastern Orthodox Christians"},{"@language":"es","@value":"Personas cristianas ortodoxas LGBTQ+"},{"@language":"ja","@value":"LGBTQ+のキリスト教東方正教徒"},{"@language":"nl","@value":"LHBTQ+-Oosters-Orthodoxe Christenen"},{"@language":"sv","@value":"Ortodoxa kristna (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"Eastern Orthodox Christians (LGBTQ)"},{"@language":"en","@value":"LGBTQ Orthodox Eastern Christians"},{"@language":"en","@value":"LGBTQ Eastern Orthodox Christians"}],"rdfs:comment":[{"@language":"en","@value":"LGBTQ+ people who are members of the Eastern Orthodox Christian Church."},{"@language":"es","@value":"Personas LGBTQ+ que son miembros de la Iglesia cristiana ortodoxa oriental."},{"@language":"ja","@value":"キリスト教東方正教会の信徒であるLGBTQ+の人々。"},{"@language":"nl","@value":"LHBTQ+-personen die lid zijn van de Oosters-Orthodoxe Christelijke Kerk."},{"@language":"sv","@value":"Hbtq+-personer som är medlemmar i den Östortodoxa kyrkan."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000265"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000928"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQEasternOrthodoxChristians"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000483","dc:identifier":"homoit0000483","skos:prefLabel":[{"@language":"en","@value":"Gay Christians"},{"@language":"es","@value":"Cristianos gay"},{"@language":"de","@value":"Schwule Christen"},{"@language":"nl","@value":"Homo-christenen"},{"@language":"sv","@value":"Kristna bögar"}],"skos:altLabel":{"@language":"sv","@value":"Kristna homosexuella män"},"rdfs:comment":[{"@language":"en","@value":"Gay men who are Christian."},{"@language":"es","@value":"Hombres gay que son cristianos."},{"@language":"de","@value":"Schwule Männer, die christlich sind."},{"@language":"nl","@value":"Homomannen die christen zijn"},{"@language":"sv","@value":"Bögar som är kristna."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000265"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2005004588"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000928"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayChristians"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000680","dc:identifier":"homoit0000680","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ Jehovah's Witnesses"},{"@language":"es","@value":"Testigos de Jehová LGBTQ+"},{"@language":"ja","@value":"LGBTQ+のエホバの証人の信者"},{"@language":"nl","@value":"LHBTQ+-Jehova's getuigen"},{"@language":"sv","@value":"Jehovas vittnen (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"LGBTQ Jehova's Witnesses"},{"@language":"en","@value":"Jehova's Witnesses (LGBTQ)"},{"@language":"en","@value":"LGBTQ Jehovah's Witnesses"},{"@language":"es","@value":"Testigos de Jehová (LGBTQ)"}],"rdfs:comment":[{"@language":"en","@value":"LGBTQ+ people who are Jehovah’s Witnesses. "},{"@language":"en","@value":"エホバの証人であるLGBTQ+の人々。"},{"@language":"es","@value":"Personas LGBTQ+ que son testigos de Jehová."},{"@language":"nl","@value":"LHBTQ+-personen die Jehovah’s Getuigen zijn."},{"@language":"sv","@value":"Hbtq+-personer som är Jehovas vittnen."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000265"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000928"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQJehovahsWitnesses"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000731","dc:identifier":"homoit0000731","skos:prefLabel":[{"@language":"en","@value":"Lesbian Christians"},{"@language":"es","@value":"Cristianas lesbianas"},{"@language":"nl","@value":"Lesbische christenen"},{"@language":"sv","@value":"Lesbiska kristna"}],"skos:altLabel":{"@language":"sv","@value":"Kristna lesbiska"},"rdfs:comment":[{"@language":"en","@value":"Lesbians who are Christian."},{"@language":"es","@value":"Lesbianas que son cristianas."},{"@language":"nl","@value":"Lesbische vrouwen die christen zijn"},{"@language":"sv","@value":"Lesbiska som är kristna."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000265"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2006008772"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000928"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianChristians"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000904","dc:identifier":"homoit0000904","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ Mormons"},{"@language":"es","@value":"Mormones LGBTQ+"},{"@language":"ja","@value":"LGBTQ+のモルモン教徒"},{"@language":"nl","@value":"LHBTQ+-Mormonen"},{"@language":"sv","@value":"Mormoner (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"Mormons (LGBTQ)"},{"@language":"en","@value":"LGBTQ Mormons"},{"@language":"es","@value":"Mormones LGBTQ"},{"@language":"es","@value":"Mormones (LGBTQ)"},{"@language":"ja","@value":"モルモン教徒（LGBTQ）"},{"@language":"ja","@value":"LGBTQのモルモン教徒"}],"rdfs:comment":[{"@language":"en","@value":"LGBTQ+ people who are members of the Mormon Church."},{"@language":"es","@value":"Personas LGBTQ+ que son miembros de la Iglesia mormona."},{"@language":"ja","@value":"モルモン教の信徒であるLGBTQ+の人々。"},{"@language":"nl","@value":"LHBTQ+-personen die lid zijn van de Mormoonse kerk."},{"@language":"sv","@value":"Hbtq+-personer som är medlemmar i Jesu Kristi kyrka av sista dagars heliga."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000265"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000928"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQMormons"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000912","dc:identifier":"homoit0000912","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ Old Catholics"},{"@language":"es","@value":"Católicos antiguos LGBTQ+"},{"@language":"ja","@value":"LGBTQ+の復古カトリック教徒"},{"@language":"nl","@value":"LHBTQ+-oud-katholieken"},{"@language":"sv","@value":"Gammalkatoliker (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"LGBTQ+ Old Catholic Church"},{"@language":"es","@value":"Iglesia católica antigua LGBTQ+"},{"@language":"ja","@value":"LGBTQ+復古カトリック教会"}],"rdfs:comment":[{"@language":"en","@value":"LGBTQ+ members of the anti-papal-primacy Christian denomination that originated with groups that split from the Holy See because they disagreed with essential doctrines."},{"@language":"es","@value":"Miembros LGBTQ+ de la denominación cristiana antiprimacía papal que se originó con grupos que se separaron de la Santa Sede porque no estaban de acuerdo con doctrinas esenciales."},{"@language":"ja","@value":"教皇の首位権に反対するキリスト教教派に属するLGBTQ+の人々。この教派は、基本的な教義に同意できなかったためローマ教皇庁から分離したグループを起源としている。"},{"@language":"nl","@value":"afsplitsing van het roomskatholicisme, die het romeinse kerkcentralisme afwijst evenals het dogma van de pauselijke onfeilbaarheid en de onbevlekte ontvangenis"},{"@language":"sv","@value":"Hbtq+-personer som är medlemmar i kristna samfund som motsätter sig påvens överhöghet."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000265"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000928"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQOldCatholicChurch"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001168","dc:identifier":"homoit0001168","skos:prefLabel":[{"@language":"en","@value":"Queer Christians"},{"@language":"es","@value":"Cristianos queer"},{"@language":"nl","@value":"Queer christenen"},{"@language":"sv","@value":"Queera kristna"}],"rdfs:comment":[{"@language":"en","@value":"Queer people who are Christian."},{"@language":"es","@value":"Personas queer que son cristianas."},{"@language":"nl","@value":"Queer personen die christen zijn"},{"@language":"sv","@value":"Queera personer som är kristna."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000265"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000928"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerChristians"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001401","dc:identifier":"homoit0001401","skos:prefLabel":[{"@language":"en","@value":"Transgender Christians"},{"@language":"es","@value":"Cristianos transgénero"},{"@language":"nl","@value":"Transgender christenen"},{"@language":"sv","@value":"Kristna transpersoner"}],"rdfs:comment":[{"@language":"en","@value":"Transgender people who are Christian."},{"@language":"es","@value":"Personas transgénero que son cristianas."},{"@language":"nl","@value":"Transgender personen die christen zijn"},{"@language":"sv","@value":"Transpersoner som är kristna."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000265"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2007003726"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000928"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transgenderChristians"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002974","dc:identifier":"homoit0002974","skos:prefLabel":[{"@language":"en","@value":"Intersex Christians"},{"@language":"es","@value":"Cristianos intersexuales"},{"@language":"nl","@value":"Intersekse christenen"},{"@language":"sv","@value":"Kristna intersexpersoner"}],"skos:altLabel":[{"@language":"es","@value":"Cristianos intersex"},{"@language":"es","@value":"Cristianas intersex"},{"@language":"es","@value":"Cristianxs intersex"}],"rdfs:comment":[{"@language":"en","@value":"Intersex people who are Christian."},{"@language":"es","@value":"Personas intersex que son cristianas."},{"@language":"nl","@value":"Intersekse personen die christen zijn."},{"@language":"sv","@value":"Intersexpersoner som är kristna."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000265"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000928"},"dc:issued":{"@type":"xsd:date","@value":"2023-09-29"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002980","dc:identifier":"homoit0002980","skos:prefLabel":[{"@language":"en","@value":"Asexual Christians"},{"@language":"es","@value":"Cristianos asexuales"},{"@language":"de","@value":"Asexuelle Christ:innen"},{"@language":"nl","@value":"Aseksuele christenen"},{"@language":"sv","@value":"Asexuella kristna"}],"skos:altLabel":[{"@language":"de","@value":"Ace Christ:innen"},{"@language":"de","@value":"Asexuelle christliche Personen"},{"@language":"de","@value":"Christliche asexuelle Personen"},{"@language":"de","@value":"Christliche ace Personen"}],"rdfs:comment":[{"@language":"en","@value":"Asexual people who are Christian."},{"@language":"es","@value":"Personas asexuales que son cristianas."},{"@language":"de","@value":"Asexuelle Personen, die christlich sind."},{"@language":"nl","@value":"Aseksuele personen die christen zijn"},{"@language":"sv","@value":"Asexuella personer som är kristna."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000265"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000928"},"dc:issued":{"@type":"xsd:date","@value":"2023-10-27"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000268","dc:identifier":"homoit0000268","skos:prefLabel":[{"@language":"en","@value":"Cut men"},{"@language":"es","@value":"Hombres circuncidados"},{"@language":"de","@value":"Beschnittene Männer"},{"@language":"nl","@value":"Besneden mannen"},{"@language":"sv","@value":"Omskurna män"}],"skos:altLabel":[{"@language":"en","@value":"Circumcised men"},{"@language":"de","@value":"Beschnittene"}],"rdfs:comment":[{"@language":"en","@value":"Men whose penises are circumcised (i.e., the foreskin of the penis has been surgically removed)."},{"@language":"es","@value":"Hombres cuyos penes están circuncidados (es decir, el prepucio del pene ha sido extirpado quirúrgicamente)."},{"@language":"de","@value":"Männer, deren Penis beschnitte ist, das heisst, deren Vorhaut chirurgisch entfernt wurde."},{"@language":"nl","@value":"Mannen van wie de penis is besneden (d.w.z. de voorhuid van de penis is operatief verwijderd)."},{"@language":"sv","@value":"Män vars penisar är omskurna (att förhuden har avlägsnats kirurgiskt)."}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000269"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000268"},"dc:replaces":{"@id":"http://homosaurus.org/v2/cutMen"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000269","dc:identifier":"homoit0000269","skos:prefLabel":[{"@language":"en","@value":"Circumcision"},{"@language":"es","@value":"Circuncisión"},{"@language":"de","@value":"Beschneidung"},{"@language":"nl","@value":"Besnijdenis"},{"@language":"sv","@value":"Omskärelse"}],"rdfs:comment":[{"@language":"en","@value":"Surgical removal of the foreskin of the penis."},{"@language":"es","@value":"Extirpación quirúrgica del prepucio del pene."},{"@language":"de","@value":"Chirurgische Entfernung der Vorhaut des Penis."},{"@language":"sv","@value":"Kirurgiskt avlägsnande av förhuden på penis."}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000268"},{"@id":"https://homosaurus.org/v5/homoit0000281"},{"@id":"https://homosaurus.org/v5/homoit0000450"},{"@id":"https://homosaurus.org/v5/homoit0001481"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85026074"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000269"},"dc:replaces":{"@id":"http://homosaurus.org/v2/circumcision"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000281","dc:identifier":"homoit0000281","skos:prefLabel":[{"@language":"en","@value":"Clitoridectomy"},{"@language":"es","@value":"Clitoridectomía"},{"@language":"de","@value":"Klitoridektomie"},{"@language":"nl","@value":"Clitoridectomie"},{"@language":"sv","@value":"Klitoridektomi"}],"skos:altLabel":[{"@language":"en","@value":"Clitorectomy"},{"@language":"en","@value":"Female circumcision"},{"@language":"es","@value":"Clitorectomía"},{"@language":"es","@value":"Circuncisión femenina"},{"@language":"de","@value":"Weibliche Genitalverstümmelung"},{"@language":"nl","@value":"Nederlandse Antillen"},{"@language":"nl","@value":"Werk"}],"rdfs:comment":[{"@language":"en","@value":"Surgical procedure involving the removal or reduction of the clitoris."},{"@language":"es","@value":"Procedimiento quirúrgico que implica la extirpación o reducción del clítoris."},{"@language":"de","@value":"Chirurgischer Eingriff zur Entfernung oder Verkleinerung der Klitoris."},{"@language":"nl","@value":"Chirurgische ingreep waarbij de clitoris wordt verwijderd of verkleind"},{"@language":"sv","@value":"Kirurgiskt ingrepp som innebär borttagning eller förminskning av klitoris."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000430"},{"@id":"https://homosaurus.org/v5/homoit0000670"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000269"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85027085"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000430"},"dc:replaces":{"@id":"http://homosaurus.org/v2/clitoridectomy"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000450","dc:identifier":"homoit0000450","skos:prefLabel":[{"@language":"en","@value":"Foreskin restoration"},{"@language":"es","@value":"Restauración prepucial"},{"@language":"de","@value":"Wiederherstellen der Penisvorhaut"},{"@language":"nl","@value":"Voorhuidsreconstructie"},{"@language":"sv","@value":"Förhudsrekonstruktion"}],"skos:altLabel":{"@language":"en","@value":"Uncircumcision"},"rdfs:comment":[{"@language":"en","@value":"The process of altering a circumcised penis to reconstruct or restore the foreskin."},{"@language":"es","@value":"El proceso de alterar un pene circuncidado para reconstruir o restaurar el prepucio."},{"@language":"de","@value":"Der Eingriff zur Wiederherstellung oder Rekonstruktion der Vorhaut bei einem beschnittenen Penis."},{"@language":"nl","@value":"Het proces van het veranderen van een besneden penis om de voorhuid te reconstrueren of te herstellen."},{"@language":"sv","@value":"Processen att förändra en omskuren penis för att rekonstruera eller återställa förhuden."}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000269"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000450"},"dc:replaces":{"@id":"http://homosaurus.org/v2/foreskinRestoration"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001481","dc:identifier":"homoit0001481","skos:prefLabel":[{"@language":"en","@value":"Uncut men"},{"@language":"es","@value":"Hombres no circuncisos"},{"@language":"nl","@value":"Onbesneden mannen"},{"@language":"sv","@value":"Ej omskurna män"}],"skos:altLabel":[{"@language":"en","@value":"Uncircumcised men"},{"@language":"es","@value":"Hombres no circuncidados"},{"@language":"sv","@value":"Oomskurna män"},{"@language":"sv","@value":"Icke omskurna män"}],"rdfs:comment":[{"@language":"en","@value":"Men whose penises are uncircumcised (i.e., the foreskin of the penis has not been surgically removed)."},{"@language":"es","@value":"Hombres cuyos penes no están circuncidados (es decir, el prepucio del pene no ha sido extirpado quirúrgicamente)."},{"@language":"nl","@value":"Mannen van wie de penis onbesneden is (d.w.z. de voorhuid van de penis is niet operatief verwijderd)"},{"@language":"sv","@value":"Män vars penisar inte är omskurna. Det vill säga förhuden har inte opererats bort."}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000269"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2008004022"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001481"},"dc:replaces":{"@id":"http://homosaurus.org/v2/uncutMen"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001925","dc:identifier":"homoit0001925","skos:prefLabel":[{"@language":"en","@value":"Cisgender identity"},{"@language":"es","@value":"Identidad cisgénero"},{"@language":"de","@value":"Cisidentität"},{"@language":"fr","@value":"Identité cisgenre"},{"@language":"nl","@value":"Cisgender identiteit"},{"@language":"sv","@value":"Cisidentitet"}],"skos:altLabel":[{"@language":"en","@value":"Cis identity"},{"@language":"es","@value":"Identidad cis"},{"@language":"de","@value":"Cisgenderidentität"}],"rdfs:comment":[{"@language":"en","@value":"Term used to describe the identity of people who identify with the sex or gender they were assigned at birth."},{"@language":"es","@value":"Término utilizado para describir la identidad de las personas que se autoidentifican con el sexo o género que les fue asignado al nacer."},{"@language":"de","@value":"Bezeichnung für Menschen, die sich mit dem Geschlecht identifizieren, das ihnen bei der Geburt zugewiesen wurde."},{"@language":"fr","@value":"Identité de genre qui correspond au sexe ou au genre assigné à la naissance."},{"@language":"nl","@value":"Term die wordt gebruikt om de identiteit te beschrijven van mensen die zich identificeren met het gender dat hen bij de geboorte is toegewezen"},{"@language":"sv","@value":"Term som används för att beskriva identiteten hos personer som identifierar sig med det kön de tilldelades vid födseln."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000571"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000270"},{"@id":"https://homosaurus.org/v5/homoit0000271"},{"@id":"https://homosaurus.org/v5/homoit0000272"},{"@id":"https://homosaurus.org/v5/homoit0001924"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2022-03-31"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002281","dc:identifier":"homoit0002281","skos:prefLabel":[{"@language":"en","@value":"Cisgender youth"},{"@language":"es","@value":"Juventud cisgénero"},{"@language":"de","@value":"Cis Jugendliche"},{"@language":"nl","@value":"Cisgender jongeren"},{"@language":"sv","@value":"Cisungdomar"}],"skos:altLabel":[{"@language":"en","@value":"Cis youth"},{"@language":"en","@value":"Cisgender adolescents"},{"@language":"en","@value":"Cisgender teenagers"},{"@language":"en","@value":"Cisgender teens"},{"@language":"es","@value":"Juventud cis"},{"@language":"es","@value":"Adolescentes cisgénero"},{"@language":"es","@value":"Adolescentes cis"},{"@language":"es","@value":"Jóvenes cis"},{"@language":"de","@value":"Cis Teenager"},{"@language":"nl","@value":"Cisgender adolescenten"},{"@language":"nl","@value":"Cisgender teenagers"},{"@language":"nl","@value":"Cisgender tieners"}],"rdfs:comment":[{"@language":"en","@value":"Cisgender people who are between the ages of childhood and adulthood."},{"@language":"es","@value":"Personas cisgénero que se encuentran entre las edades de la niñez y la edad adulta."},{"@language":"de","@value":"Cis Personen im Alter zwischen Kindheit und Erwachsenenalter."},{"@language":"nl","@value":"Cisgender personen in de leeftijd tussen kindertijd en volwassenheid."},{"@language":"sv","@value":"Cispersoner i åldern mellan barndom och vuxenliv."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000271"},{"@id":"https://homosaurus.org/v5/homoit0001520"}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0002282"},{"@id":"https://homosaurus.org/v5/homoit0002283"},{"@id":"https://homosaurus.org/v5/homoit0002284"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000271"},"dc:issued":{"@type":"xsd:date","@value":"2022-11-10"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000273","dc:identifier":"homoit0000273","skos:prefLabel":[{"@language":"en","@value":"Cissexual people"},{"@language":"es","@value":"Personas cisexuales"},{"@language":"de","@value":"Cissexuelle Personen"},{"@language":"nl","@value":"Cisseksuele personen"},{"@language":"sv","@value":"Cissexuella personer"}],"rdfs:comment":[{"@language":"en","@value":"Individuals whose sex matches the sex or gender they were assigned at birth. Whereas cisgender refers to people who are not transgender, cissexual refers to people who are not transsexual."},{"@language":"es","@value":"Personas cuyo sexo coincide con el sexo o género que se les asignó al nacer. Mientras que \"cisgénero\" se refiere a personas que no son transgénero, \"cisexual\" se refiere a personas que no son transexuales."},{"@language":"de","@value":"Personen, deren biologisches Geschlecht mit dem Geschlecht übereinstimmt, das ihnen bei der Geburt zugewiesen wurde. Im Deutschen ein synonymer Begriff zu cisgeschlechtlich. Cissexuell fokussiert sich stärker auf den körperlichen und medizinischen Aspekt (Sex)."},{"@language":"nl","@value":"Personen wiens seksuele identiteit overeenkomt met hun geslacht of toegewezen bij de geboorte. Waar cisgender verwijst naar mensen die niet transgender zijn, verwijst cisseksueel naar mensen die niet transseksueel zijn."},{"@language":"sv","@value":"Individer vars biologiska kön överensstämmer med det kön de tilldelades vid födseln. Medan cisperson syftar på personer som inte är transpersoner, refererar cissexuell till personer som inte är transsexuella."}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000271"},{"@id":"https://homosaurus.org/v5/homoit0001381"},{"@id":"https://homosaurus.org/v5/homoit0001924"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000273"},"dc:replaces":{"@id":"http://homosaurus.org/v2/cissexualPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001652","dc:identifier":"homoit0001652","skos:prefLabel":[{"@language":"en","@value":"Demigirls"},{"@language":"es","@value":"Deminiñas"},{"@language":"de","@value":"Demigirls"},{"@language":"nl","@value":"Demigirls"},{"@language":"sv","@value":"Demitjejer"}],"skos:altLabel":[{"@language":"en","@value":"Demiwomen"},{"@language":"en","@value":"Demiwoman"},{"@language":"en","@value":"Demigirl"},{"@language":"en","@value":"Demilady"},{"@language":"en","@value":"Demiladies"},{"@language":"en","@value":"Demifemale people"},{"@language":"de","@value":"Demi-Frauen"},{"@language":"de","@value":"Demifrauen"},{"@language":"de","@value":"Demi-Girls"},{"@language":"sv","@value":"Demigirls"}],"rdfs:comment":[{"@language":"en","@value":"People who partially, but not fully, identify women or girls irrespective of their assigned genders. Used by cisgender, transgender, transfeminine, or nonbinary people who feel more strongly aligned with women physically or socially, but not strongly enough to identify solely as one."},{"@language":"es","@value":"Personas que se autoidentifican parcial, pero no completamente, como mujeres o niñas independientemente de su género asignado. Utilizado por personas cisgénero, transgénero, transfemeninas o no binarias que se sienten más alineadas con las mujeres física o socialmente, pero no lo suficiente como para identificarse únicamente como tal."},{"@language":"de","@value":"Personen, die sich teilweise, aber nicht vollständig mit Frauen oder Mädchen identifizieren, unabhängig von ihrem zugewiesenen Geschlecht. Wird von cisgeschlechtlichen, transgender, transfemininen oder nicht-binären Personen verwendet, die sich körperlich oder sozial stärker mit Frauen verbunden fühlen, jedoch nicht stark genug, um sich ausschließlich als solche zu identifizieren."},{"@language":"nl","@value":"Een genderidentiteit die iemand beschrijft die zich gedeeltelijk, maar niet volledig, identificeert als een vrouw of meisje, ongeacht de toegewezen gender. Gebruikt door cisgender, transgender, transvrouwelijke of niet-binaire mensen die zich fysiek of sociaal sterker geassocieerd voelen met vrouwen, maar niet sterk genoeg om zich als vrouw te willen identificeren."},{"@language":"sv","@value":"Personer som delvis, men inte helt, identifierar sig som kvinnor eller flickor, oavsett vilket kön de tilldelats vid födseln. Används av cispersoner, transpersoner, transfeminina eller ickebinära personer som känner en starkare koppling till kvinnor fysiskt eller socialt, men inte tillräckligt för att identifiera sig enbart som kvinna."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000342"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000271"},{"@id":"https://homosaurus.org/v5/homoit0001048"},{"@id":"https://homosaurus.org/v5/homoit0001382"},{"@id":"https://homosaurus.org/v5/homoit0001653"},{"@id":"https://homosaurus.org/v5/homoit0001821"},{"@id":"https://homosaurus.org/v5/homoit0001923"},{"@id":"https://homosaurus.org/v5/homoit0002043"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/demigirls"},"dc:issued":{"@type":"xsd:date","@value":"2021-06-30"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001653","dc:identifier":"homoit0001653","skos:prefLabel":[{"@language":"en","@value":"Demiboys"},{"@language":"es","@value":"Deminiños"},{"@language":"de","@value":"Demiboys"},{"@language":"fr","@value":"Demi-filles"},{"@language":"nl","@value":"Demiboys"},{"@language":"sv","@value":"Demikillar"}],"skos:altLabel":[{"@language":"en","@value":"Demiguy"},{"@language":"en","@value":"Demiguys"},{"@language":"en","@value":"Demimen"},{"@language":"en","@value":"Demimales"},{"@language":"en","@value":"Demimale people"},{"@language":"en","@value":"Demiboy"},{"@language":"de","@value":"Demi-Männer"},{"@language":"de","@value":"Demimänner"},{"@language":"de","@value":"Demi-Boys"},{"@language":"sv","@value":"Demiboys"}],"rdfs:comment":[{"@language":"en","@value":"People who partially, but not fully, identify as men or boys irrespective of their assigned genders. Used by cisgender, transgender, transmasculine, or nonbinary people who feel more aligned with men physically or socially, but not strongly enough to identify solely as one."},{"@language":"es","@value":"Personas que se autoidentifican parcial, pero no totalmente, como hombres o niños independientemente de su género asignado. Utilizado por personas cisgénero, transgénero, transmasculinas o no binarias que se sienten más alineadas física o socialmente con los hombres, pero no lo suficiente como para identificarse únicamente como tal."},{"@language":"de","@value":"Personen, die sich teilweise, aber nicht vollständig als Männer oder Jungen identifizieren, unabhängig von ihrem zugewiesenen Geschlecht. Wird von cisgeschlechtlichen, transgender, transmaskulinen oder nichtbinären Personen verwendet, die sich körperlich oder sozial eher mit Männern verbunden fühlen, jedoch nicht stark genug, um sich ausschließlich als solche zu identifizieren."},{"@language":"fr","@value":"Personnes qui s'identifient partiellement comme des femmes ou des filles, quel que soit le genre qui leur a été attribué. Utilisé par les personnes cisgenres, transgenres, transféminines ou non binaires qui se sentent plus proches des femmes physiquement ou socialement, mais pas suffisamment pour s'identifier uniquement comme telles."},{"@language":"nl","@value":"Een genderidentiteit die iemand beschrijft die zich gedeeltelijk, maar niet volledig, identificeert als een man of jongen, ongeacht de toegewezen gender. Gebruikt door cisgender, transgender, transmasculine of niet-binaire mensen die zich fysiek of sociaal sterker geassocieerd voelen met mannen, maar niet sterk genoeg om zich als man te willen identificeren."},{"@language":"sv","@value":"Personer som delvis, men inte helt, identifierar sig som män eller pojkar, oavsett vilket kön de tilldelats vid födseln. Används av cispersoner, transpersoner, transmaskulina eller ickebinära personer som känner en starkare koppling till män fysiskt eller socialt, men inte tillräckligt för att identifiera sig enbart som man."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000342"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000271"},{"@id":"https://homosaurus.org/v5/homoit0001048"},{"@id":"https://homosaurus.org/v5/homoit0001466"},{"@id":"https://homosaurus.org/v5/homoit0001652"},{"@id":"https://homosaurus.org/v5/homoit0001820"},{"@id":"https://homosaurus.org/v5/homoit0001923"},{"@id":"https://homosaurus.org/v5/homoit0002061"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/demiboys"},"dc:issued":{"@type":"xsd:date","@value":"2021-06-30"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001381","dc:identifier":"homoit0001381","skos:prefLabel":[{"@language":"en","@value":"Transsexual people"},{"@language":"es","@value":"Personas transexuales"},{"@language":"nl","@value":"Transseksuele personen"},{"@language":"sv","@value":"Transsexuella personer"}],"skos:altLabel":[{"@language":"en","@value":"Transexuals"},{"@language":"en","@value":"Transsexuals"},{"@language":"es","@value":"Transexuales"},{"@language":"nl","@value":"Transseksuelen"}],"rdfs:comment":[{"@language":"en","@value":"Individuals who transition from female to male or male to female. Generally refers to individuals who transition their physical bodies to align with their gender identities. Though this term was popular in the 20th century and is still in use today, it has been largely replaced by \"transgender people\" and \"trans people.\" Some but not all people regard this term as outdated and offensive. Only use to describe people who self-identify as transsexual."},{"@language":"es","@value":"Personas que hacen la transición de mujer a hombre o de hombre a mujer. Generalmente se refiere a personas que hacen la transición de sus cuerpos físicos para alinearse con sus identidades de género. Aunque este término fue popular en el siglo XX y todavía se utiliza hoy en día, ha sido reemplazado en gran medida por \"personas transgénero\" y \"personas trans\". Algunas personas, pero no todas, consideran este término obsoleto y ofensivo. Utilícese únicamente para describir a personas que se identifiquen como transexuales."},{"@language":"nl","@value":"Personen die overgaan van vrouw naar man of man naar vrouw. Verwijst over het algemeen naar personen die hun fysieke lichaam veranderen om zich aan te passen aan hun genderidentiteit. Hoewel deze term populair was in de 20e eeuw en nog steeds in gebruik is, is deze grotendeels vervangen door 'transgender personen' en 'trans personen'. Sommige maar niet alle personen beschouwen deze term als achterhaald en beledigend. Alleen gebruiken om personen te beschrijven die zichzelf identificeren als transseksueel."},{"@language":"sv","@value":"Personer som genomgår transition från kvinna till man eller från man till kvinna. Termen används oftast för att beskriva individer som förändrar sin kropp fysiskt för att stämma överens med sin könsidentitet. Även om termen var vanlig under 1900-talet och fortfarande används, har den i stor utsträckning ersatts av transperson eller trans. Vissa, men inte alla, uppfattar termen som föråldrad och stigmatiserande. Bör endast användas för personer som själva identifierar sig som transsexuella."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001378"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000436"},{"@id":"https://homosaurus.org/v5/homoit0000986"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000273"},{"@id":"https://homosaurus.org/v5/homoit0000561"},{"@id":"https://homosaurus.org/v5/homoit0000572"},{"@id":"https://homosaurus.org/v5/homoit0001047"},{"@id":"https://homosaurus.org/v5/homoit0001049"},{"@id":"https://homosaurus.org/v5/homoit0001073"},{"@id":"https://homosaurus.org/v5/homoit0001129"},{"@id":"https://homosaurus.org/v5/homoit0001131"},{"@id":"https://homosaurus.org/v5/homoit0001380"},{"@id":"https://homosaurus.org/v5/homoit0001464"},{"@id":"https://homosaurus.org/v5/homoit0001465"},{"@id":"https://homosaurus.org/v5/homoit0001468"},{"@id":"https://homosaurus.org/v5/homoit0001781"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85137086"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transsexualPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001924","dc:identifier":"homoit0001924","skos:prefLabel":[{"@language":"en","@value":"Cissexuality"},{"@language":"es","@value":"Cisexualidad"},{"@language":"de","@value":"Cissexualität"},{"@language":"nl","@value":"Cisseksualiteit"},{"@language":"sv","@value":"Cissexualitet"}],"skos:altLabel":{"@language":"de","@value":"Zissexualität"},"rdfs:comment":[{"@language":"en","@value":"Term used to describe people who identify with the sex they were assigned at birth."},{"@language":"es","@value":"Término utilizado para describir a las personas que se autoidentifican con el sexo que les fue asignado al nacer."},{"@language":"de","@value":"Bezeichnung für Menschen, die sich mit dem Geschlecht identifizieren, das ihnen bei der Geburt zugewiesen wurde. Im Deutschen ein synonymer Begriff zu Cisgeschlechtlichkeit. Fokussiert sich stärker auf die körperliche und biologische Ebene sowie das Begehren."},{"@language":"nl","@value":"Term die wordt gebruikt om mensen te beschrijven die zich identificeren met het geslacht dat hen bij de geboorte is toegewezen"},{"@language":"sv","@value":"Term som används för att beskriva personer som identifierar sig med det kön de tilldelades vid födseln."}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000273"},{"@id":"https://homosaurus.org/v5/homoit0001925"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001924"},"dc:issued":{"@type":"xsd:date","@value":"2022-03-31"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000274","dc:identifier":"homoit0000274","skos:prefLabel":[{"@language":"en","@value":"Civil unions"},{"@language":"es","@value":"Uniones civiles"},{"@language":"de","@value":"Eingetragene Partnerschaft"},{"@language":"nl","@value":"Geregistreerd partnerschap"},{"@language":"sv","@value":"Registrerade partnerskap"}],"skos:altLabel":[{"@language":"en","@value":"Civil partnership"},{"@language":"en","@value":"Registered partnership"},{"@language":"es","@value":"Unión civil"},{"@language":"es","@value":"Unión registrada"},{"@language":"de","@value":"Eingetragene Lebenspartnerschaft"},{"@language":"de","@value":"Lebenspartnerschaft"}],"rdfs:comment":[{"@language":"en","@value":"Legally recognized unions with rights similar (but often not identical or equal) to those of marriage, originally created for same-sex couples in jurisdictions where they were not legally allowed to marry."},{"@language":"es","@value":"Uniones legalmente reconocidas con derechos similares (pero a menudo no idénticos o iguales) a los del matrimonio, creadas originalmente para parejas del mismo sexo en jurisdicciones donde no se les permitía casarse legalmente."},{"@language":"de","@value":"Gesetzlich anerkannte Partnerschaften mit ähnlichen (aber oft nicht identischen oder gleichen) Rechten wie die Ehe, die ursprünglich für gleichgeschlechtliche Paare in Ländern geschaffen wurden, in denen ihnen die Eheschließung gesetzlich nicht gestattet war."},{"@language":"nl","@value":"Wettelijk erkende partnerschappen met rechten die vergelijkbaar zijn (maar vaak niet identiek of gelijk aan) die van het huwelijk, oorspronkelijk voor paren van hetzelfde geslacht in rechtsgebieden waar wettelijk trouwen niet mogelijk was."},{"@language":"sv","@value":"Lagligt erkända partnerskap med rättigheter som liknar (men ofta inte är identiska eller jämlika med) äktenskap. Dessa skapades ursprungligen för samkönade par i jurisdiktioner där de inte lagligen tilläts gifta sig."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000973"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000275"},{"@id":"https://homosaurus.org/v5/homoit0000277"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000362"},{"@id":"https://homosaurus.org/v5/homoit0000712"},{"@id":"https://homosaurus.org/v5/homoit0000918"},{"@id":"https://homosaurus.org/v5/homoit0000990"},{"@id":"https://homosaurus.org/v5/homoit0000992"},{"@id":"https://homosaurus.org/v5/homoit0001053"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2003003097"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000973"},"dc:replaces":{"@id":"http://homosaurus.org/v2/civilUnions"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000275","dc:identifier":"homoit0000275","skos:prefLabel":[{"@language":"en","@value":"Civil union documents"},{"@language":"es","@value":"Documentos de unión civil"},{"@language":"de","@value":"Lebenspartnerschaftsdokumente"},{"@language":"nl","@value":"Documenten van geregistreerd partnerschap"},{"@language":"sv","@value":"Dokument för civilrättsligt partnerskap"}],"rdfs:comment":[{"@language":"en","@value":"Legal documents certifying civil unions established in compliance with the laws of certain jurisdictions."},{"@language":"es","@value":"Documentos legales que certifican uniones civiles establecidas en conformidad con las leyes de determinadas jurisdicciones."},{"@language":"de","@value":"Offizielle Dokumente, die gemäß den Gesetzen bestimmter Gerichtsbarkeiten geschlossene Lebenspartnerschaften bescheinigen."},{"@language":"sv","@value":"Juridiska dokument som intygar civilrättsliga partnerskap som har etablerats i enlighet med lagarna i vissa jurisdiktioner. Fenomenet förekommer inte i svensk juridik."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000274"},{"@id":"https://homosaurus.org/v5/homoit0001053"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000973"},"dc:replaces":{"@id":"http://homosaurus.org/v2/civilUnionDocuments"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000277","dc:identifier":"homoit0000277","skos:prefLabel":[{"@language":"en","@value":"Civil union certificates"},{"@language":"es","@value":"Ceritificados de unión civil"},{"@language":"de","@value":"Lebenspartnerschaftsurkunden"},{"@language":"nl","@value":"Aktes van geregistreerd partnerschap"},{"@language":"sv","@value":"Intyg om civilrättsligt partnerskap"}],"rdfs:comment":[{"@language":"en","@value":"Official certificates certifying civil unions established in compliance with the laws of certain jurisdictions."},{"@language":"es","@value":"Certificados oficiales que acreditan uniones civiles establecidas en conformidad con las leyes de determinadas jurisdicciones."},{"@language":"de","@value":"Offizielle Urkunden, die gemäß den Gesetzen bestimmter Gerichtsbarkeiten geschlossene Lebenspartnerschaften bescheinigen."},{"@language":"nl","@value":"Juridische documenten die een geregistreerd partnerschap certificeren, in overeenstemming met de wetten van een bepaald rechtsgebied."},{"@language":"sv","@value":"Officiella certifikat som intygar registrerade partnerskap som har etablerats i enlighet med lagarna i vissa jurisdiktioner."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000274"},{"@id":"https://homosaurus.org/v5/homoit0001053"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000973"},"dc:replaces":{"@id":"http://homosaurus.org/v2/civilUnionCertificates"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000362","dc:identifier":"homoit0000362","skos:prefLabel":[{"@language":"en","@value":"Domestic partnerships"},{"@language":"es","@value":"Parejas de hecho"},{"@language":"de","@value":"Lebenspartnerschaften"},{"@language":"nl","@value":"Samenwonen"},{"@language":"sv","@value":"Samboskap"}],"skos:altLabel":[{"@language":"es","@value":"Uniones de hecho"},{"@language":"es","@value":"Emparejamiento doméstico"},{"@language":"es","@value":"Asociación libre"}],"rdfs:comment":[{"@language":"en","@value":"Legal or personal relationships between individuals who live together and share their lives but are not married or joined by civil union."},{"@language":"es","@value":"Relaciones jurídicas o personales entre personas que viven juntas y comparten sus vidas pero que no están casadas ni unidas por unión civil."},{"@language":"de","@value":"Rechtliche oder persönliche Beziehungen zwischen Personen, die zusammenleben und ihr Leben teilen, aber nicht verheiratet oder in einer eingetragenen Lebenspartnerschaft verbunden sind."},{"@language":"nl","@value":"ongehuwd samen een duurzame gemeenschappelijke huishouding voeren"},{"@language":"sv","@value":"Juridiska eller personliga relationer mellan personer som lever tillsammans och delar sina liv utan att vara gifta eller registrerade som partners."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000973"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000274"},{"@id":"https://homosaurus.org/v5/homoit0000360"},{"@id":"https://homosaurus.org/v5/homoit0000990"},{"@id":"https://homosaurus.org/v5/homoit0001053"},{"@id":"https://homosaurus.org/v5/homoit0001237"},{"@id":"https://homosaurus.org/v5/homoit0001311"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000973"},"dc:replaces":{"@id":"http://homosaurus.org/v2/domesticPartnerships"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000992","dc:identifier":"homoit0000992","skos:prefLabel":[{"@language":"en","@value":"Marriage law"},{"@language":"es","@value":"Derecho matrimonial"},{"@language":"nl","@value":"Huwelijksrecht"},{"@language":"sv","@value":"Äktenskapslagstiftning"}],"skos:altLabel":[{"@language":"en","@value":"Matrimonial law"},{"@language":"es","@value":"Ley matrimonial"},{"@language":"es","@value":"Ley de matrimonio"}],"rdfs:comment":[{"@language":"en","@value":"Legal regulations and laws dictating where, when, under what conditions, and who can be legally married in a certain jurisdiction."},{"@language":"es","@value":"Regulaciones legales y leyes que dictan dónde, cuándo, bajo qué condiciones y quiénes pueden casarse legalmente en una determinada jurisdicción."},{"@language":"nl","@value":"Wettelijke voorschriften en wetten die bepalen waar, wanneer, onder welke voorwaarden en wie in een bepaald rechtsgebied legaal kunnen trouwen."},{"@language":"sv","@value":"Lagar och regler som anger var, när, under vilka omständigheter och mellan vilka personer ett äktenskap kan ingås inom en viss jurisdiktion."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000918"},"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0000296"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000274"},{"@id":"https://homosaurus.org/v5/homoit0000989"},{"@id":"https://homosaurus.org/v5/homoit0000990"},{"@id":"https://homosaurus.org/v5/homoit0000991"},{"@id":"https://homosaurus.org/v5/homoit0000993"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85081508"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000702"},"dc:replaces":{"@id":"http://homosaurus.org/v2/marriageLaw"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000531","dc:identifier":"homoit0000531","skos:prefLabel":[{"@language":"en","@value":"Gay rights"},{"@language":"es","@value":"Derechos gay"},{"@language":"de","@value":"Schwulenrechte"},{"@language":"nl","@value":"Homorechten"},{"@language":"sv","@value":"Bögars rättigheter"}],"skos:altLabel":[{"@language":"de","@value":"Homosexuellenrechte"},{"@language":"de","@value":"Gay Rights"},{"@language":"sv","@value":"Homosexuella mäns rättigheter"}],"rdfs:comment":[{"@language":"en","@value":"Legal, social, or ethical principles of freedom or entitlement held by gay men."},{"@language":"es","@value":"Principios legales, sociales o éticos de libertad o derechos que tienen los hombres gay."},{"@language":"de","@value":"Rechtliche, soziale oder ethische Grundsätze der Freiheit oder Rechte von homosexuellen Männern."},{"@language":"nl","@value":"Wettelijke, sociale of ethische principes van vrijheid of rechten van homomannen"},{"@language":"sv","@value":"Juridiska, sociala eller etiska principer om frihet eller rättigheter för bögar."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000276"},"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh94009215"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000652"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayRights"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000775","dc:identifier":"homoit0000775","skos:prefLabel":[{"@language":"en","@value":"Lesbian rights"},{"@language":"es","@value":"Derechos lésbicos"},{"@language":"nl","@value":"Lesbische rechten"},{"@language":"sv","@value":"Lesbiskas rättigheter"}],"skos:altLabel":{"@language":"sv","@value":"Lesbisk rätt"},"rdfs:comment":[{"@language":"en","@value":"Legal, social, or ethical principles of freedom or entitlement held by lesbians."},{"@language":"es","@value":"Principios legales, sociales o éticos de libertad o derechos que tienen las lesbianas."},{"@language":"nl","@value":"Wettelijke, sociale of ethische principes van vrijheid of rechten van lesbische vrouwen"},{"@language":"sv","@value":"Juridiska, sociala eller etiska principer om frihet eller rättigheter för lesbiska."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000276"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000652"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianRights"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001206","dc:identifier":"homoit0001206","skos:prefLabel":[{"@language":"en","@value":"Queer rights"},{"@language":"es","@value":"Derechos queer"},{"@language":"nl","@value":"Queer rechten"},{"@language":"sv","@value":"Queera rättigheter"}],"rdfs:comment":[{"@language":"en","@value":"Legal, social, or ethical principles of freedom or entitlement held by queer people."},{"@language":"es","@value":"Principios legales, sociales o éticos de libertad o derechos que tienen las personas queer."},{"@language":"nl","@value":"Wettelijke, sociale of ethische principes van vrijheid of rechten van queer personen."},{"@language":"sv","@value":"Juridiska, sociala eller etiska principer om frihet eller rättigheter för queera personer."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000276"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000652"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerRights"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001443","dc:identifier":"homoit0001443","skos:prefLabel":[{"@language":"en","@value":"Transgender rights"},{"@language":"es","@value":"Derechos de personas transgénero"},{"@language":"nl","@value":"Transgenderrechten"},{"@language":"sv","@value":"Transpersoners rättigheter"}],"skos:altLabel":{"@language":"sv","@value":"Transrätt"},"rdfs:comment":[{"@language":"en","@value":"Legal, social, or ethical principles of freedom or entitlement held by transgender people."},{"@language":"es","@value":"Principios legales, sociales o éticos de libertad o derechos que tienen las personas transgénero."},{"@language":"nl","@value":"Wettelijke, sociale of ethische principes van vrijheid of rechten van transgender personen."},{"@language":"sv","@value":"Juridiska, sociala eller etiska principer om frihet eller rättigheter för transpersoner."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000276"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000652"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transgenderRights"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002808","dc:identifier":"homoit0002808","skos:prefLabel":[{"@language":"en","@value":"Asexual rights"},{"@language":"es","@value":"Derechos asexuales"},{"@language":"de","@value":"Asexuelle Rechte"},{"@language":"nl","@value":"Aseksuele rechten"},{"@language":"sv","@value":"Asexuellas rättigheter"}],"skos:altLabel":[{"@language":"de","@value":"Ace Rechte"},{"@language":"sv","@value":"Ace-rättigheter"}],"rdfs:comment":[{"@language":"en","@value":"Legal, social, or ethical principles of freedom or entitlement held by asexual people."},{"@language":"es","@value":"Principios legales, sociales o éticos de la libertad o del derecho que tienen las personas asexuales."},{"@language":"de","@value":"Rechtliche, soziale oder ethische Prinzipien der Freiheit oder des Anspruchs, die von asexuellen Personen vertreten werden."},{"@language":"nl","@value":"Wettelijke rechten van aseksueke personen op politieke en sociale vrijheid en gelijkheid."},{"@language":"sv","@value":"Juridiska, sociala eller etiska principer om frihet eller rättigheter för asexuella personer."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000276"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000652"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000339","dc:identifier":"homoit0000339","skos:prefLabel":[{"@language":"en-us","@value":"Decriminalization"},{"@language":"es","@value":"Despenalización"},{"@language":"de","@value":"Entkriminalisierung"},{"@language":"fr","@value":"Décriminalisation"},{"@language":"nl","@value":"Decriminalisering"},{"@language":"sv","@value":"Avkriminalisering"},{"@language":"en-gb","@value":"Decriminalisation"}],"skos:altLabel":[{"@language":"de","@value":"Dekriminalisierung"},{"@language":"sv","@value":"Dekriminalisering"}],"rdfs:comment":[{"@language":"en","@value":"The process of lessening or removing criminal penalties for certain acts."},{"@language":"es","@value":"El proceso de reducir o eliminar las sanciones penales por determinados actos."},{"@language":"de","@value":"Der Prozess der Milderung oder Aufhebung strafrechtlicher Sanktionen für bestimmte Handlungen."},{"@language":"fr","@value":"Processus d'atténuation ou de suppression des sanctions pénales pour certains actes."},{"@language":"nl","@value":"Het proces waarbij strafrechtelijke sancties voor bepaalde handelingen worden verminderd of opgeheven."},{"@language":"sv","@value":"Processen att minska eller avskaffa straffrättsliga påföljder för vissa handlingar."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000313"},"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0003774"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000276"},{"@id":"https://homosaurus.org/v5/homoit0000314"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85036356"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000702"},"dc:replaces":{"@id":"http://homosaurus.org/v2/decriminalisation"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000673","dc:identifier":"homoit0000673","skos:prefLabel":[{"@language":"en","@value":"Intersex rights"},{"@language":"de","@value":"Inter* Rechte"},{"@language":"es","@value":"Derechos intersexuales"},{"@language":"nl","@value":"Intersekse rechten"},{"@language":"sv","@value":"Intersexrättigheter"}],"skos:altLabel":[{"@language":"es","@value":"Derechos intersex"},{"@language":"sv","@value":"Intersexpersoners rättigheter"}],"rdfs:comment":[{"@language":"en","@value":"Legal, social, or ethical principles of freedom or entitlement held by intersex people. Often used to refer to intersex people's right to bodily autonomy and, specifically, their right to delay or decline unnecessary medical interventions."},{"@language":"de","@value":"Rechtliche, soziale oder ethische Grundsätze der Freiheit von inter* Personen; wird oft verwendet, um das Recht auf körperliche Selbstbestimmung von inter* Personen zu bezeichnen, insbesondere ihr Recht, unnötige medizinische Eingriffe aufzuschieben oder abzulehnen."},{"@language":"es","@value":"Principios legales, sociales o éticos de libertad o derechos que tienen las personas intersex. A menudo, se utiliza para referirse al derecho de las personas intersex a la autonomía corporal y, específicamente, a su derecho a retrasar o rechazar intervenciones médicas innecesarias."},{"@language":"nl","@value":"Wettelijke, sociale of ethische principes van vrijheid of rechten van intersekse personen. Vaak gebruikt om te verwijzen naar het recht van intersekse personen op lichamelijke autonomie en in het bijzonder hun recht om onnodige medische tussenkomst uit te stellen of te weigeren"},{"@language":"sv","@value":"Juridiska, sociala eller etiska principer om frihet eller rättigheter för intersexpersoner. Ofta används termen för att beskriva rätten till kroppslig autonomi och att ha möjlighet att vägra onödiga medicinska ingrepp."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000652"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000276"},{"@id":"https://homosaurus.org/v5/homoit0000618"},{"@id":"https://homosaurus.org/v5/homoit0000670"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000652"},"dc:replaces":{"@id":"http://homosaurus.org/v2/intersexRights"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002723","dc:identifier":"homoit0002723","skos:prefLabel":[{"@language":"en","@value":"Two-Spirit rights"},{"@language":"es","@value":"Derechos dos espíritus"},{"@language":"nl","@value":"Two-Spirit rechten"},{"@language":"sv","@value":"Two-spirit-rättigheter"}],"skos:altLabel":[{"@language":"en","@value":"2S rights"},{"@language":"en","@value":"Two Spirit rights"},{"@language":"en","@value":"Two Spirited rights"},{"@language":"en","@value":"Two-Spirited rights"}],"rdfs:comment":[{"@language":"en","@value":"Legal, social, or ethical principles of freedom or entitlement held by Two-Spirit people."},{"@language":"es","@value":"Principios legales, sociales o éticos de la libertad o del derecho que tienen las personas dos espíritus."},{"@language":"nl","@value":"Juridische, sociale of ethische principes van vrijheid of rechten van Two-Spirit-mensen."},{"@language":"sv","@value":"Juridiska, sociala eller etiska principer om frihet eller rättigheter för Two-spirit-personer."}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000276"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0002723"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-27"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000278","dc:identifier":"homoit0000278","skos:prefLabel":[{"@language":"en","@value":"Sex workers' clients"},{"@language":"es","@value":"Clientes de trabajadores sexuales"},{"@language":"nl","@value":"Klanten van sekswerkers"},{"@language":"sv","@value":"Sexköpare"}],"skos:altLabel":[{"@language":"en","@value":"Johns"},{"@language":"en","@value":"Tricks"},{"@language":"en","@value":"Prostitutes' clients"},{"@language":"en","@value":"Prostitutes' customers"},{"@language":"en","@value":"Sex workers' customers"},{"@language":"en","@value":"Sex-buyers"},{"@language":"en","@value":"Janes"},{"@language":"en","@value":"Curb crawlers"},{"@language":"en","@value":"Punters"},{"@language":"es","@value":"Clientes de prostitutxs"},{"@language":"es","@value":"Clientes de prostitutos"},{"@language":"es","@value":"Clientes de prostitutas"},{"@language":"es","@value":"Compradores de sexo"},{"@language":"es","@value":"Clientes de sexo"},{"@language":"nl","@value":"Klanten van prostitué(e)s"},{"@language":"nl","@value":"Prostituanten"},{"@language":"sv","@value":"Torskar"},{"@language":"sv","@value":"Laxar"}],"rdfs:comment":[{"@language":"en","@value":"People who provide money or goods to sex workers in exchange for sexual services, performances, or companionship."},{"@language":"es","@value":"Personas que ofrecen dinero o bienes a trabajadoras/es sexuales a cambio de servicios o actuaciones sexuales."},{"@language":"nl","@value":"Personen die sekswerkers geld of goederen geven in ruil voor seksuele diensten, optredens of gezelschap."},{"@language":"sv","@value":"Personer som ger pengar eller varor till sexarbetare i utbyte mot sexuella handlingar, framträdanden eller sällskap."}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0003794"},{"@id":"https://homosaurus.org/v5/homoit0003795"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0003778"},{"@id":"https://homosaurus.org/v5/homoit0003779"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh98005017"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000278"},"dc:replaces":{"@id":"http://homosaurus.org/v2/prostitutesClients"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003794","dc:identifier":"homoit0003794","skos:prefLabel":[{"@language":"en","@value":"Sugar daddies"},{"@language":"nl","@value":"Suikerpappa's"},{"@language":"sv","@value":"Sugardaddies"}],"rdfs:comment":[{"@language":"en","@value":"People who provide money, gifts, and other material benefits to sugar babies in exchange for companionship and sexual services. Follow the individual's preference for \"Sugar daddies\" or \"Sugar mamas\" whenever possible."},{"@language":"nl","@value":"Personen die geld, geschenken en andere materiële voordelen aan sugar babies geven in ruil voor gezelschap en seksuele diensten. Volg de voorkeur van het individu voor \"Sugar daddies\" of \"Sugar mamas\" waar mogelijk."},{"@language":"sv","@value":"Personer som erbjuder pengar, gåvor och andra materiella förmåner till sugar babies i utbyte mot sällskap och sexuella handlingar. Följ individens eget språkbruk om de föredrar ”sugardaddies” eller ”sugarmamas”."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000278"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0003793"},{"@id":"https://homosaurus.org/v5/homoit0003792"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000278"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-30"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003795","dc:identifier":"homoit0003795","skos:prefLabel":[{"@language":"en","@value":"Sugar mamas"},{"@language":"nl","@value":"Suikermama's"},{"@language":"sv","@value":"Sugarmamas"}],"skos:altLabel":[{"@language":"en","@value":"Sugar mommas"},{"@language":"en","@value":"Sugar mommies"}],"rdfs:comment":[{"@language":"en","@value":"People who provide money, gifts, and other material benefits to sugar babies in exchange for companionship and sexual services. Follow the individual's preference for \"Sugar mamas\" or \"Sugar daddies\" whenever possible."},{"@language":"nl","@value":"Personen die geld, geschenken en andere materiële voordelen aan sugar babies geven in ruil voor gezelschap en seksuele diensten. Volg de voorkeur van het individu voor \"Sugar mamas\" of \"Sugar daddies\" waar mogelijk."},{"@language":"sv","@value":"Personer som erbjuder pengar, gåvor och andra materiella förmåner till sugarbabies i utbyte mot sällskap och sexuella handlingar. Följ individens eget språkbruk om de föredrar ”sugarmamas” eller ”sugardaddies”."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000278"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0003793"},{"@id":"https://homosaurus.org/v5/homoit0003792"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000278"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-30"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003778","dc:identifier":"homoit0003778","skos:prefLabel":[{"@language":"en","@value":"Curb crawling"},{"@language":"nl","@value":"Curb crawling"},{"@language":"sv","@value":"Curb crawling"},{"@language":"en-gb","@value":"Kerb crawling"}],"rdfs:comment":[{"@language":"en","@value":"The practice of driving or idling in one's car around areas known for street sex work in order to solicit sex workers."},{"@language":"nl","@value":"Het rijden of stationair draaien van de auto in gebieden die bekend staan ​​om straatsekswerk, met als doel sekswerkers te werven."},{"@language":"sv","@value":"Amerikanskt begrepp för praktiken att köra eller stå stilla i bil i områden kända för gatubaserat sexarbete i syfte att kontakta sexarbetare/prostituerade."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0003779"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000278"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0003779"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-30"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003779","dc:identifier":"homoit0003779","skos:prefLabel":[{"@language":"en","@value":"Solicitation of sex work"},{"@language":"nl","@value":"Werven van sekswerk"},{"@language":"sv","@value":"Köp av sexuella handlingar"}],"skos:altLabel":{"@language":"en","@value":"Soliciting"},"rdfs:comment":[{"@language":"en","@value":"The act of offering or attempting to exchange money or goods for sexual services or performances."},{"@language":"nl","@value":"Het aanbieden of uitwisselen van geld of goederen voor seksuele diensten of optredens."},{"@language":"sv","@value":"Handling där en person erbjuder eller försöker erbjuda pengar eller varor i utbyte mot sexuella handlingar eller framträdanden."}],"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0003778"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000278"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0003779"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-30"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000279","dc:identifier":"homoit0000279","skos:prefLabel":[{"@language":"en","@value":"Clit rings"},{"@language":"de","@value":"Klitorispiercing"},{"@language":"es","@value":"Anillos de clítoris"},{"@language":"nl","@value":"Clit ringen"},{"@language":"sv","@value":"Klittringar"}],"skos:altLabel":[{"@language":"de","@value":"Klitorisring"},{"@language":"es","@value":"Anillos clitorideo"},{"@language":"es","@value":"Anillos clitoriano"},{"@language":"sv","@value":"Clit rings"}],"rdfs:comment":[{"@language":"en","@value":"Genital piercings placed directly through the hood of the clitoris, typically worn for aesthetic purposes or to enhance sexual arousal."},{"@language":"de","@value":"Genitalpiercings, die direkt durch die Klitorisvorhaut gestochen werden und in der Regel aus ästhetischen Gründen oder zur Steigerung der sexuellen Erregung getragen werden."},{"@language":"es","@value":"Perforaciones genitales colocadas directamente a través del capuchón del clítoris, generalmente usadas para fines estéticos o para aumentar la excitación sexual."},{"@language":"nl","@value":"Genitale piercing direct door de rand van de clitoris geplaatst, meestal gedragen voor esthetische doeleinden of als seksaccessoire om de opwinding te vergroten."},{"@language":"sv","@value":"Genitala piercingar som placeras direkt genom klitorishuvan, vanligtvis burna av estetiska skäl eller för att öka sexuell stimulans."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001266"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000282"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001266"},"dc:replaces":{"@id":"http://homosaurus.org/v2/clitRings"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000282","dc:identifier":"homoit0000282","skos:prefLabel":[{"@language":"en","@value":"Clitoris"},{"@language":"es","@value":"Clítoris"},{"@language":"de","@value":"Klitoris"},{"@language":"nl","@value":"Clitoris"},{"@language":"sv","@value":"Klitoris"}],"rdfs:comment":[{"@language":"en","@value":"Erogenous external organ that is capable of erection under sexual stimulation."},{"@language":"es","@value":"Órgano externo erógeno que es capaz de erección bajo estimulación sexual."},{"@language":"de","@value":"Erogenes äußeres Organ, das unter sexueller Stimulation eine Erektion entwickeln kann."},{"@language":"nl","@value":"Erogeen uitwendig orgaan dat in staat is tot erectie onder seksuele stimulatie."},{"@language":"sv","@value":"Erogen kroppsdel som kan erigeras vid sexuell stimulans."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000401"},{"@id":"https://homosaurus.org/v5/homoit0000585"}],"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0000460"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000279"},{"@id":"https://homosaurus.org/v5/homoit0000280"},{"@id":"https://homosaurus.org/v5/homoit0001844"},{"@id":"https://homosaurus.org/v5/homoit0001848"},{"@id":"https://homosaurus.org/v5/homoit0003736"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85027086"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000401"},"dc:replaces":{"@id":"http://homosaurus.org/v2/clitoris"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003736","dc:identifier":"homoit0003736","skos:prefLabel":[{"@language":"en","@value":"Clit twisting"},{"@language":"nl","@value":"Clit draaien"},{"@language":"sv","@value":"Klitvridning"}],"skos:altLabel":[{"@language":"en","@value":"Clitoris twisting"},{"@language":"nl","@value":"Clitoris draaien"}],"rdfs:comment":[{"@language":"en","@value":"Twisting or squeezing the clitoris to induce sexual pleasure."},{"@language":"nl","@value":"Het draaien of knijpen van de clitoris om seksueel genot op te wekken."},{"@language":"sv","@value":"Vridning eller klämning av klitoris för att framkalla sexuell njutning."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000280"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000282"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001267"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000430","dc:identifier":"homoit0000430","skos:prefLabel":[{"@language":"en","@value":"Female genital mutilation"},{"@language":"es","@value":"Mutilación genital femenina"},{"@language":"de","@value":"Weibliche Genitalverstümmelung"},{"@language":"nl","@value":"Vrouwelijke genitale verminking"},{"@language":"sv","@value":"Kvinnlig könsstympning"}],"skos:altLabel":[{"@language":"de","@value":"Weibliche Genitalbeschneidung"},{"@language":"sv","@value":"Kvinnlig omskärelse"}],"rdfs:comment":[{"@language":"en","@value":"The practice of cutting or removing the female genitals, sometimes to control sexual drive or punish lesbianism."},{"@language":"es","@value":"Práctica que consiste en cortar o extirpar los genitales femeninos, a veces, para controlar el impulso sexual o castigar el lesbianismo."},{"@language":"de","@value":"Die Praxis des Beschneidens oder Entfernens der weiblichen Genitalien, mitunter zur Kontrolle des Sexualtriebs oder zur Bestrafung von Homosexualität."},{"@language":"sv","@value":"Praktiken att skära eller avlägsna kvinnliga könsorgan, ibland i syfte att kontrollera sexdrift eller straffa lesbiskhet."}],"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0000281"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000653"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh93002781"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000430"},"dc:replaces":{"@id":"http://homosaurus.org/v2/femaleGenitalMutilation"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000670","dc:identifier":"homoit0000670","skos:prefLabel":[{"@language":"en","@value":"Intersex genital mutilation"},{"@language":"es","@value":"Mutilación genital intersex"},{"@language":"nl","@value":"Intersekse genitale verminking"},{"@language":"sv","@value":"Könsstympning av intersexpersoner"}],"skos:altLabel":[{"@language":"en","@value":"IGM"},{"@language":"es","@value":"Mutilación genital a personas intersex"}],"rdfs:comment":[{"@language":"en","@value":"Surgeries or other medical treatments performed, typically on newborn babies or children, to \"normalize\" the patient's reproductive or sexual anatomy and force their body to conform to medical or social expectations for what is male or female. IGM practices can be performed for cultural, social, or religious reasons. Though they are typically justified through a medical lens, IGM practices are medically unnecessary and non-consensual."},{"@language":"es","@value":"Cirugías u otros tratamientos médicos realizados, generalmente en  recién nacidos y niños, para \"normalizar\" la anatomía sexual o reproductiva del paciente y obligar a su cuerpo a acomodarse a las expectativas médicas o sociales de lo que es masculino o femenino. Las prácticas de MGI se pueden realizar por razones culturales, sociales o religiosas. Aunque normalmente se justifican desde una perspectiva médica, las prácticas de MGI son médicamente innecesarias y no consensuadas."},{"@language":"nl","@value":"Chirurgie of andere medische behandelingen, meestal uitgevoerd bij pasgeboren baby's of kinderen, om hun reproductieve of seksuele anatomie te \"normaliseren\" en het lichaam van het individu te dwingen zich aan te passen aan de medische of sociale verwachtingen van wat mannelijk of vrouwelijk is. Intersekse genitale verminking kan worden uitgevoerd om culturele, sociale of religieuze redenen. Hoewel ze doorgaans worden gerechtvaardigd door een medische lens, is intersekse genitale verminking medisch onnodig en niet-consensueel."},{"@language":"sv","@value":"Kirurgiska ingrepp eller annan medicinsk behandling som vanligen utförs på spädbarn eller barn i syfte att ”normalisera” könsorganen och tvinga kroppen att motsvara medicinska eller sociala förväntningar på vad som är manligt eller kvinnligt. Könsstympningen kan utföras av kulturella, sociala eller religiösa skäl. Även om de ofta rättfärdigas medicinskt, är dessa ingrepp medicinskt onödiga och sker utan samtycke."}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000281"},{"@id":"https://homosaurus.org/v5/homoit0002847"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000352"},{"@id":"https://homosaurus.org/v5/homoit0000618"},{"@id":"https://homosaurus.org/v5/homoit0000666"},{"@id":"https://homosaurus.org/v5/homoit0000673"},{"@id":"https://homosaurus.org/v5/homoit0001268"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000670"},"dc:replaces":{"@id":"http://homosaurus.org/v2/intersexGenitalMutilation"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000585","dc:identifier":"homoit0000585","skos:prefLabel":[{"@language":"en","@value":"Genitals"},{"@language":"es","@value":"Genitales"},{"@language":"de","@value":"Genitalien"},{"@language":"nl","@value":"Geslachtsorganen"},{"@language":"sv","@value":"Könsorgan"}],"skos:altLabel":[{"@language":"en","@value":"Genitalia"},{"@language":"es","@value":"Genitalia"}],"rdfs:comment":[{"@language":"en","@value":"General term for erogenous and/or reproductive organs (e.g., vagina, clitoris, penis)."},{"@language":"es","@value":"Término general para órganos erógenos y/o reproductivos (p. ej., vagina, clítoris, pene)."},{"@language":"de","@value":"Sammelbegriff für erogene und/oder reproduktive Organe (z. B. Vagina, Klitoris, Penis)."},{"@language":"nl","@value":"Algemene term voor erogene en/of voortplantingsorganen (bijv. vagina, clitoris, penis)."},{"@language":"sv","@value":"Allmän term för erogena och/eller reproduktiva organ (t.ex. vagina, klitoris, penis)."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001269"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000282"},{"@id":"https://homosaurus.org/v5/homoit0001099"},{"@id":"https://homosaurus.org/v5/homoit0001361"},{"@id":"https://homosaurus.org/v5/homoit0001488"},{"@id":"https://homosaurus.org/v5/homoit0001497"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000401"},{"@id":"https://homosaurus.org/v5/homoit0001268"},{"@id":"https://homosaurus.org/v5/homoit0003110"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85053822"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001269"},"dc:replaces":{"@id":"http://homosaurus.org/v2/genitals"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000460","dc:identifier":"homoit0000460","skos:prefLabel":[{"@language":"en","@value":"G-spot"},{"@language":"es","@value":"Punto G"},{"@language":"de","@value":"G-Punkt"},{"@language":"nl","@value":"G-spot"},{"@language":"sv","@value":"G-punkten"}],"rdfs:comment":[{"@language":"en","@value":"Commonly characterized as an erogenous area of the front anterior wall of the vagina that, when stimulated, can lead to sexual arousal, orgasms, and/or ejaculation."},{"@language":"es","@value":"Comúnmente se caracteriza como un área erógena de la pared anterior de la vagina que, cuando se estimula, puede provocar excitación sexual, orgasmos y/o eyaculación."},{"@language":"de","@value":"Üblicherweise beschrieben als eine erogene Zone der vorderen Vaginalwand, deren Stimulation zu sexueller Erregung, Orgasmen und/oder Ejakulation führen kann."},{"@language":"sv","@value":"Område på den främre väggen i slidan som ofta beskrivs som erogent och som vid stimulering kan leda till sexuell upphetsning, orgasm och/eller ejakulation."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000282"},{"@id":"https://homosaurus.org/v5/homoit0001488"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh93002802"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000401"},"dc:replaces":{"@id":"http://homosaurus.org/v2/g-spot"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001844","dc:identifier":"homoit0001844","skos:prefLabel":[{"@language":"en","@value":"Clitoroplasty"},{"@language":"de","@value":"Klitorisplastik"},{"@language":"es","@value":"Clitoroplastia"},{"@language":"nl","@value":"Clitoroplastie"},{"@language":"sv","@value":"Klitorisplastik"}],"skos:altLabel":[{"@language":"es","@value":"Reducción de clítoris"},{"@language":"es","@value":"Reducción del clítoris"}],"rdfs:comment":[{"@language":"en","@value":"Surgical construction of the clitoris, often undertaken as a form of gender affirming surgery."},{"@language":"de","@value":"Chirurgische Konstruktion der Klitoris, häufig als Form der geschlechtsangleichenden Operation durchgeführt."},{"@language":"es","@value":"Construcción quirúrgica del clítoris, a menudo realizada como una forma de cirugía de afirmación de género."},{"@language":"nl","@value":"Chirurgische constructie van de clitoris"},{"@language":"sv","@value":"Kirurgisk konstruktion av klitoris, ofta genomförd som en form av könsbekräftande kirurgi."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000584"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000282"},{"@id":"https://homosaurus.org/v5/homoit0001040"},{"@id":"https://homosaurus.org/v5/homoit0001465"},{"@id":"https://homosaurus.org/v5/homoit0001845"},{"@id":"https://homosaurus.org/v5/homoit0001851"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001004"},"dc:issued":{"@type":"xsd:date","@value":"2022-02-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001848","dc:identifier":"homoit0001848","skos:prefLabel":[{"@language":"en","@value":"Vaginectomy"},{"@language":"es","@value":"Vaginectomía"},{"@language":"nl","@value":"Vaginectomie"},{"@language":"sv","@value":"Vaginektomi"}],"rdfs:comment":[{"@language":"en","@value":"Surgical removal of the vagina."},{"@language":"es","@value":"Extirpación quirúrgica de la vagina."},{"@language":"nl","@value":"Chirurgische verwijdering van de vagina"},{"@language":"sv","@value":"Kirurgiskt avlägsnande av vaginan."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000584"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000282"},{"@id":"https://homosaurus.org/v5/homoit0001465"},{"@id":"https://homosaurus.org/v5/homoit0001488"},{"@id":"https://homosaurus.org/v5/homoit0001497"},{"@id":"https://homosaurus.org/v5/homoit0001846"},{"@id":"https://homosaurus.org/v5/homoit0001847"},{"@id":"https://homosaurus.org/v5/homoit0001850"},{"@id":"https://homosaurus.org/v5/homoit0001894"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001004"},"dc:issued":{"@type":"xsd:date","@value":"2022-02-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000283","dc:identifier":"homoit0000283","skos:prefLabel":[{"@language":"en","@value":"Clitoromegaly"},{"@language":"es","@value":"Clitoromegalia"},{"@language":"de","@value":"Klitorishypertrophie"},{"@language":"nl","@value":"Clitoromegalie"},{"@language":"sv","@value":"Klitoromegali"}],"skos:altLabel":[{"@language":"en","@value":"Enlarged clitoris"},{"@language":"es","@value":"Hipertrofia del clítoris"},{"@language":"de","@value":"Klitoromegalie"},{"@language":"de","@value":"Megaloklitoris"}],"rdfs:comment":[{"@language":"en","@value":"People born with clitoromegaly have a clitoris that is larger than what society considers to be typical. Clitoromegaly is a trait associated with several different intersex variations, including congenital adrenal hyperplasia and progestin-induced virilization."},{"@language":"es","@value":"Las personas que nacen con clitoromegalia tienen un clítoris más grande de lo que la sociedad considera típico. La clitoromegalia es un rasgo asociado con múltiples variaciones intersex diferentes, incluida la hiperplasia suprarrenal congénita y la virilización inducida por progestina."},{"@language":"de","@value":"Menschen, die mit einer Klitorishypertrophie geboren werden, haben eine Klitoris, die größer ist als die gesellschaftlich als typisch angesehene Größe. Klitorishypertrophie ist ein Merkmal, das mit verschiedenen intergeschlechtlichen Variationen in Verbindung gebracht wird, darunter angeborene Nebennierenhyperplasie und durch Progestin induzierte Virilisierung."},{"@language":"nl","@value":"Medische term die verwijst naar de vergroting van de clitoris, ofwel aanwezig bij de geboorte of verworven door opzettelijke lichaamsaanpassing."},{"@language":"sv","@value":"Personer som föds med klitoromegali har en klitoris som är större än vad samhället anser vara typiskt. Klitoromegali är en egenskap som är kopplad till flera olika intersexvariationer, inklusive kongenital binjurehyperplasi och virilisering orsakad av progestin."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000669"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001269"},"dc:replaces":{"@id":"http://homosaurus.org/v2/clitoromegaly"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000284","dc:identifier":"homoit0000284","skos:prefLabel":[{"@language":"en","@value":"Clones (Gay culture)"},{"@language":"es","@value":"Clones (cultura gay)"},{"@language":"de","@value":"Clones (schwuler Kontext)"},{"@language":"nl","@value":"Clones (homomannen)"},{"@language":"sv","@value":"Kloner (bögkultur)"}],"skos:altLabel":[{"@language":"en","@value":"Clones (Gay men)"},{"@language":"en","@value":"Clones"},{"@language":"es","@value":"Clones"},{"@language":"es","@value":"Clones gay"},{"@language":"de","@value":"Castro clones"},{"@language":"sv","@value":"Clones (bögkultur)"}],"rdfs:comment":[{"@language":"en","@value":"Historical term for gay men who dress in a particular masculine fashion; often used in the Castro District of San Francisco."},{"@language":"es","@value":"Término histórico para hombres gay que visten de una manera masculina particular; se utiliza a menudo en el distrito Castro de San Francisco."},{"@language":"de","@value":"Historischer Begriff für schwule Männer, die sich auf eine bestimmte maskuline Art kleiden; wird häufig im Stadtteil Castro in San Francisco verwendet."},{"@language":"nl","@value":"Historische term voor homoseksuele mannen die de neiging hadden zich op een gewone en mannelijke manier te kleden, vaak gebruikt in het Castro-district van San Francisco"},{"@language":"sv","@value":"Historisk term för bögar som klär sig på ett särskilt maskulint sätt. Användes ofta i Castro-distriktet i San Francisco."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000506"},{"@id":"https://homosaurus.org/v5/homoit0000878"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/clonesGayMen"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001783","dc:identifier":"homoit0001783","skos:prefLabel":[{"@language":"en","@value":"Closeted LGBTQ+ people"},{"@language":"es","@value":"Personas LGBTQ+ en el clóset"},{"@language":"de","@value":"Ungeoutete LGBTQ+-Personen"},{"@language":"nl","@value":"LHBTQ+-personen in de kast"},{"@language":"sv","@value":"Hbtq+-personer i garderoben"}],"skos:altLabel":[{"@language":"en","@value":"Closeted people (LGBTQ)"},{"@language":"es","@value":"Personas en el clóset (LGBTQ)"},{"@language":"de","@value":"Nicht geoutete LGBTQ+-Personen"}],"rdfs:comment":[{"@language":"en","@value":"LGBTQ+ people who do not identify as such to others."},{"@language":"es","@value":"Personas LGBTQ+ que no se autoidentifican como tales ante los demás."},{"@language":"de","@value":"LGBTQ+-Personen, die diese Identität vor anderen nicht preisgeben."},{"@language":"nl","@value":"LGBTQ+-ers die zich niet als zodanig identificeren bij anderen"},{"@language":"sv","@value":"Hbtq+-personer som inte identifierar sig som sådana inför andra."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000915"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000285"},{"@id":"https://homosaurus.org/v5/homoit0000286"},{"@id":"https://homosaurus.org/v5/homoit0000287"},{"@id":"https://homosaurus.org/v5/homoit0001784"},{"@id":"https://homosaurus.org/v5/homoit0001785"},{"@id":"https://homosaurus.org/v5/homoit0001786"},{"@id":"https://homosaurus.org/v5/homoit0002905"},{"@id":"https://homosaurus.org/v5/homoit0003403"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000288"},{"@id":"https://homosaurus.org/v5/homoit0000295"},{"@id":"https://homosaurus.org/v5/homoit0000365"},{"@id":"https://homosaurus.org/v5/homoit0001065"},{"@id":"https://homosaurus.org/v5/homoit0001261"},{"@id":"https://homosaurus.org/v5/homoit0001787"},{"@id":"https://homosaurus.org/v5/homoit0001788"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2021-12-08"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000286","dc:identifier":"homoit0000286","skos:prefLabel":[{"@language":"en","@value":"Closeted gay men"},{"@language":"de","@value":"Ungeoutete schwule Männer"},{"@language":"es","@value":"Hombres gay en el clóset"},{"@language":"nl","@value":"Homomannen in de kast"},{"@language":"sv","@value":"Garderobsbögar"}],"skos:altLabel":[{"@language":"de","@value":"Nicht geoutete schwule Männer"},{"@language":"es","@value":"Gays en el clóset"}],"rdfs:comment":[{"@language":"en","@value":"Gay men who do not identify as such to others."},{"@language":"de","@value":"Schwule Männer, die diese Identität vor anderen nicht preisgeben."},{"@language":"es","@value":"Hombres gay que no se autoidentifican como tales ante los demás."},{"@language":"nl","@value":"Homoseksuele mannen die zich niet als zodanig identificeren voor anderen."},{"@language":"sv","@value":"Bögar som inte identifierar sig som sådana inför andra."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000506"},{"@id":"https://homosaurus.org/v5/homoit0001783"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000285"},{"@id":"https://homosaurus.org/v5/homoit0000287"},{"@id":"https://homosaurus.org/v5/homoit0000295"},{"@id":"https://homosaurus.org/v5/homoit0000365"},{"@id":"https://homosaurus.org/v5/homoit0001065"},{"@id":"https://homosaurus.org/v5/homoit0001261"},{"@id":"https://homosaurus.org/v5/homoit0001784"},{"@id":"https://homosaurus.org/v5/homoit0001785"},{"@id":"https://homosaurus.org/v5/homoit0002905"}],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh93006732"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/closetedGayMen"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000287","dc:identifier":"homoit0000287","skos:prefLabel":[{"@language":"en","@value":"Closeted lesbians"},{"@language":"es","@value":"Lesbianas en el clóset"},{"@language":"de","@value":"Ungeoutete Lesben"},{"@language":"nl","@value":"Lesbische vrouwen in de kast"},{"@language":"sv","@value":"Garderobslesbiska"}],"skos:altLabel":[{"@language":"de","@value":"Nicht geoutete Lesben"},{"@language":"nl","@value":"Lesbiennes in de kast"}],"rdfs:comment":[{"@language":"en","@value":"Lesbians who do not identify as such to others."},{"@language":"es","@value":"Lesbianas que no se autoidentifican como tales ante los demás."},{"@language":"de","@value":"Lesben, die diese Identität vor anderen nicht preisgeben."},{"@language":"nl","@value":"Lesbische vrouwen die zich niet als zodanig identificeren aan anderen"},{"@language":"sv","@value":"Lesbiska som inte identifierar sig som sådana inför andra."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000556"},{"@id":"https://homosaurus.org/v5/homoit0001783"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000285"},{"@id":"https://homosaurus.org/v5/homoit0000286"},{"@id":"https://homosaurus.org/v5/homoit0000295"},{"@id":"https://homosaurus.org/v5/homoit0001065"},{"@id":"https://homosaurus.org/v5/homoit0001261"},{"@id":"https://homosaurus.org/v5/homoit0001784"},{"@id":"https://homosaurus.org/v5/homoit0001785"},{"@id":"https://homosaurus.org/v5/homoit0002905"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/closetedLesbians"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001261","dc:identifier":"homoit0001261","skos:prefLabel":[{"@language":"en","@value":"Secrecy"},{"@language":"es","@value":"Discreción"},{"@language":"nl","@value":"Geheimhouding"},{"@language":"sv","@value":"Diskretion (hbtq+)"}],"skos:altLabel":[{"@language":"es","@value":"Secretismo"},{"@language":"sv","@value":"Hemlighållande (hbtq+)"}],"rdfs:comment":[{"@language":"en","@value":"The state of being intentionally withheld, concealed, or kept secret; use in reference to LGBTQ+ individuals who conceal their (or others’) identities, whether out of preference or for safety reasons."},{"@language":"es","@value":"El estado retener(se), ocultar(se) o mantener(se) en secreto intencionalmente; utilícese en referencia a personas LGBTQ+ que ocultan sus identidades (o las de otras personas), ya sea por preferencia o por razones de seguridad."},{"@language":"nl","@value":"Het opzettelijk achtergehouden, verborgen of geheim houden; gebruik met betrekking tot LHBTQ+-personen die hun identiteit (of die van anderen) verbergen, hetzij uit voorkeur of om veiligheidsredenen."},{"@language":"sv","@value":"Ett tillstånd där något avsiktligt undanhålls, döljs eller hålls hemligt. Används för att beskriva hbtq+-personer som döljer sin (eller andras) identitet, antingen av personliga skäl eller för att skydda sig."}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000285"},{"@id":"https://homosaurus.org/v5/homoit0000286"},{"@id":"https://homosaurus.org/v5/homoit0000287"},{"@id":"https://homosaurus.org/v5/homoit0000288"},{"@id":"https://homosaurus.org/v5/homoit0000295"},{"@id":"https://homosaurus.org/v5/homoit0000365"},{"@id":"https://homosaurus.org/v5/homoit0001065"},{"@id":"https://homosaurus.org/v5/homoit0001783"},{"@id":"https://homosaurus.org/v5/homoit0001784"},{"@id":"https://homosaurus.org/v5/homoit0001785"},{"@id":"https://homosaurus.org/v5/homoit0001786"},{"@id":"https://homosaurus.org/v5/homoit0001787"},{"@id":"https://homosaurus.org/v5/homoit0001788"},{"@id":"https://homosaurus.org/v5/homoit0002905"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85119431"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001261"},"dc:replaces":{"@id":"http://homosaurus.org/v2/secrecy"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001784","dc:identifier":"homoit0001784","skos:prefLabel":[{"@language":"en","@value":"Closeted transgender people"},{"@language":"es","@value":"Personas transgénero en el clóset"},{"@language":"de","@value":"Ungeoutete trans Personen"},{"@language":"nl","@value":"Transgender personen in de kast"},{"@language":"sv","@value":"Garderobstranspersoner"}],"skos:altLabel":[{"@language":"en","@value":"Closeted trans people"},{"@language":"es","@value":"Personas trans en el clóset"},{"@language":"de","@value":"Nicht geoutete trans Personen"}],"rdfs:comment":[{"@language":"en","@value":"Transgender people who do not identify as such to others."},{"@language":"es","@value":"Personas transgénero que no se autoidentifican como tales ante los demás."},{"@language":"de","@value":"Trans Personen, die diese Identität vor anderen nicht preisgeben."},{"@language":"nl","@value":"Transgender personen die zich niet als zodanig identificeren bij anderen"},{"@language":"sv","@value":"Transpersoner som inte identifierar sig som sådana inför andra."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001378"},{"@id":"https://homosaurus.org/v5/homoit0001783"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000285"},{"@id":"https://homosaurus.org/v5/homoit0000286"},{"@id":"https://homosaurus.org/v5/homoit0000287"},{"@id":"https://homosaurus.org/v5/homoit0000288"},{"@id":"https://homosaurus.org/v5/homoit0000295"},{"@id":"https://homosaurus.org/v5/homoit0001065"},{"@id":"https://homosaurus.org/v5/homoit0001261"},{"@id":"https://homosaurus.org/v5/homoit0001785"},{"@id":"https://homosaurus.org/v5/homoit0002905"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2021-12-08"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001785","dc:identifier":"homoit0001785","skos:prefLabel":[{"@language":"en","@value":"Closeted queer people"},{"@language":"de","@value":"Ungeoutete queere Personen"},{"@language":"es","@value":"Personas queer en el clóset"},{"@language":"nl","@value":"Queer personen in de kast"},{"@language":"sv","@value":"Queera personer i garderoben"}],"skos:altLabel":[{"@language":"de","@value":"Nicht geoutete queere Personen"},{"@language":"es","@value":"Personas en el clóset queer"}],"rdfs:comment":[{"@language":"en","@value":"Queer people who do not identify as such to others."},{"@language":"de","@value":"Queere Personen, die diese Identität vor anderen nicht preisgeben."},{"@language":"es","@value":"Personas queer que no se autoidentifican como tales ante los demás."},{"@language":"nl","@value":"Queer personen die zich niet als zodanig identificeren bij anderen"},{"@language":"sv","@value":"Queera personer som inte identifierar sig som sådana inför andra."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001195"},{"@id":"https://homosaurus.org/v5/homoit0001783"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000285"},{"@id":"https://homosaurus.org/v5/homoit0000286"},{"@id":"https://homosaurus.org/v5/homoit0000287"},{"@id":"https://homosaurus.org/v5/homoit0000288"},{"@id":"https://homosaurus.org/v5/homoit0000295"},{"@id":"https://homosaurus.org/v5/homoit0000365"},{"@id":"https://homosaurus.org/v5/homoit0001065"},{"@id":"https://homosaurus.org/v5/homoit0001261"},{"@id":"https://homosaurus.org/v5/homoit0001784"},{"@id":"https://homosaurus.org/v5/homoit0002905"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2021-12-08"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001090","dc:identifier":"homoit0001090","skos:prefLabel":[{"@language":"en","@value":"Passing (Gender)"},{"@language":"es","@value":"Pasar (género)"},{"@language":"nl","@value":"Passing (Gender)"},{"@language":"sv","@value":"Passera (kön)"}],"skos:altLabel":[{"@language":"es","@value":"Pasando"},{"@language":"es","@value":"Pasar desapercibido"}],"rdfs:comment":[{"@language":"en","@value":"An individual's ability to \"pass,\" or be accepted or regarded as a member of the gender they identify with. \"Passing\" has historically been used to describe an individual's ability to \"pass\" as a certain race or ethnicity, though the term was later appropriated by the LGBTQ+ community."},{"@language":"es","@value":"La capacidad de una persona para \"pasar\", ser aceptada o considerada como miembro del género con el que se identifica. \"Pasar\" se ha utilizado históricamente para describir la capacidad de una persona de \"pasar\" como una determinada raza o etnia, aunque eventualmente la comunidad LGBTQ+ se apropió del término."},{"@language":"nl","@value":"Het vermogen van een individu om geaccepteerd of beschouwd te worden als lid van het gender waarmee zij zich identificeren"},{"@language":"sv","@value":"En individs förmåga att “passera”, det vill säga att bli uppfattad som tillhörande det kön hen identifierar sig som. Begreppet har historiskt också använts om ras och etnicitet men har senare använts inom hbtq+-sammanhang."}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000288"},{"@id":"https://homosaurus.org/v5/homoit0000316"},{"@id":"https://homosaurus.org/v5/homoit0000560"},{"@id":"https://homosaurus.org/v5/homoit0001140"},{"@id":"https://homosaurus.org/v5/homoit0001233"},{"@id":"https://homosaurus.org/v5/homoit0001378"},{"@id":"https://homosaurus.org/v5/homoit0001781"},{"@id":"https://homosaurus.org/v5/homoit0001901"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001090"},"dc:replaces":{"@id":"http://homosaurus.org/v2/passingGender"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001781","dc:identifier":"homoit0001781","skos:prefLabel":[{"@language":"en","@value":"Clocking (Gender)"},{"@language":"es","@value":"Fichaje (género)"},{"@language":"de","@value":"Clocking"},{"@language":"nl","@value":"Clocking (Gender)"},{"@language":"sv","@value":"Klocka (kön)"}],"skos:altLabel":[{"@language":"en","@value":"Clocking (Transgender)"},{"@language":"en","@value":"Clocking"},{"@language":"nl","@value":"Clocking (Transgender)"}],"rdfs:comment":[{"@language":"en","@value":"Slang term for the act of identifying (or clocking) someone in public as trans, crossdressing, or in drag when that person is intending to pass or be read by others as cisgender, typically for their personal safety. Clocking is often understood to be a threat (of violence or public outing) against the person being clocked. Use the term \"Reading (Gender)\" to refer to shared identification or recognized kinship between two individuals who are both gender minorities."},{"@language":"es","@value":"Término de la jerga para el acto de identificar (o fichar) a alguien en público como trans, trasformista o drag cuando esa persona tiene la intención de pasar o ser interpretada por otros como cisgénero, generalmente por su seguridad personal. A menudo se entiende que el fichaje es una amenaza (de violencia o salida pública) contra la persona que está siendo fichada. Utilícese el término \"Fichaje (Género)\" para referirse a la identificación compartida o el parentesco reconocido entre dos personas que pertenecen a minorías de género."},{"@language":"de","@value":"Slangbegriff für die Handlung, jemanden in der Öffentlichkeit als trans, Crossdresser oder Dragqueen zu identifizieren (oder zu entlarven), wenn diese Person beabsichtigt, von anderen als cisgender wahrgenommen zu werden, in der Regel aus Gründen der persönlichen Sicherheit. Clocking wird oft als Bedrohung (mit Gewalt oder öffentlicher Bloßstellung) gegenüber der identifizierten Person verstanden."},{"@language":"nl","@value":"Argotterm voor het het openbaar maken (of 'çlocking') van iemand als transgender, crossdresser of drag wanneer die persoon dat niet wil openbaren of door wil gaan als cisgender, meestal wegens hun persoonlijke veiligheid. Onder clocking wordt vaak verstaan een dreiging (met geweld of publieke outing) tegen de desbetreffende persoon. Gebruik de term \"Reading (Gender)\" om te verwijzen naar gedeelde identificatie of erkende verwantschap tussen twee personen die beide genderminderheden zijn."},{"@language":"sv","@value":"Slangterm för handlingen att identifiera (eller ”klocka”) någon offentligt som transperson, crossdresser eller dragartist när denna person försöker passera eller bli läst som cisperson, ofta för sin egen säkerhet. ”Klockning” uppfattas ofta som ett hot (om våld eller ofrivillig avslöjning) mot personen som blir ”klockad”. Använd termen Läsning (kön) för att beskriva ömsesidig identifiering eller igenkännande mellan två personer som båda är könsminoriteter."}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000288"},{"@id":"https://homosaurus.org/v5/homoit0000316"},{"@id":"https://homosaurus.org/v5/homoit0001090"},{"@id":"https://homosaurus.org/v5/homoit0001378"},{"@id":"https://homosaurus.org/v5/homoit0001381"},{"@id":"https://homosaurus.org/v5/homoit0001470"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001781"},"dc:issued":{"@type":"xsd:date","@value":"2021-12-07"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001786","dc:identifier":"homoit0001786","skos:prefLabel":[{"@language":"en","@value":"Closeted intersex people"},{"@language":"es","@value":"Personas intersexuales en el clóset"},{"@language":"de","@value":"Ungeoutete inter* Personen"},{"@language":"nl","@value":"Intersekse personen in de kast"},{"@language":"sv","@value":"Intersexpersoner i garderoben"}],"skos:altLabel":[{"@language":"es","@value":"Personas intersex en el clóset"},{"@language":"de","@value":"Nicht geoutete inter* Personen"}],"rdfs:comment":[{"@language":"en","@value":"Intersex people who do not disclose the fact that they are intersex to others."},{"@language":"es","@value":"Personas intersexuales que no revelan a los demás el hecho de que son intersex."},{"@language":"de","@value":"Inter* Personen, die diese Identität vor anderen nicht preisgeben."},{"@language":"nl","@value":"Intersekse personen die zich niet als zodanig identificeren bij anderen"},{"@language":"sv","@value":"Intersexpersoner som inte avslöjar att de är intersex inför andra."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001783"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000288"},{"@id":"https://homosaurus.org/v5/homoit0000295"},{"@id":"https://homosaurus.org/v5/homoit0000365"},{"@id":"https://homosaurus.org/v5/homoit0001065"},{"@id":"https://homosaurus.org/v5/homoit0001261"},{"@id":"https://homosaurus.org/v5/homoit0002905"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2021-12-08"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001787","dc:identifier":"homoit0001787","skos:prefLabel":[{"@language":"en","@value":"Closeted Two-Spirit people"},{"@language":"es","@value":"Personas dos espíritus en el clóset"},{"@language":"de","@value":"Ungeoutete Two-Spirit-Personen"},{"@language":"nl","@value":"Two-Spirit people in de kast"},{"@language":"sv","@value":"Two-spiritpersoner i garderoben"}],"skos:altLabel":[{"@language":"en","@value":"Closeted 2S people"},{"@language":"en","@value":"Closeted Two Spirit people"},{"@language":"en","@value":"Closeted Two Spirited people"},{"@language":"en","@value":"Closeted Two-Spirited people"},{"@language":"de","@value":"Nicht geoutete Two-Spirit-Personen"},{"@language":"de","@value":"Ungeoutete 2S-Personen"},{"@language":"de","@value":"Nicht geoutete 2S-Personen"}],"rdfs:comment":[{"@language":"en","@value":"Two-Spirit people who do not identify as such to others."},{"@language":"es","@value":"Personas de dos espíritus que no se autoidentifican como tales ante los demás."},{"@language":"de","@value":"Two-Spirit-Personen, die diese Identität vor anderen nicht preisgeben."},{"@language":"nl","@value":"Two-spirit people die zich niet als zodanig identificeren bij anderen"},{"@language":"sv","@value":"Two-spirit-personer som inte identifierar sig som sådana inför andra."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001480"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000288"},{"@id":"https://homosaurus.org/v5/homoit0000295"},{"@id":"https://homosaurus.org/v5/homoit0000365"},{"@id":"https://homosaurus.org/v5/homoit0001065"},{"@id":"https://homosaurus.org/v5/homoit0001261"},{"@id":"https://homosaurus.org/v5/homoit0001783"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2021-12-08"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000289","dc:identifier":"homoit0000289","skos:prefLabel":[{"@language":"en","@value":"Clothing"},{"@language":"es","@value":"Ropa"},{"@language":"de","@value":"Kleidung"},{"@language":"nl","@value":"Kleding"},{"@language":"sv","@value":"Kläder"}],"rdfs:comment":[{"@language":"en","@value":"Items worn on the body for protection, insulation, and self-expression; typically made of fabric or textiles."},{"@language":"es","@value":"Artículos utilizados en el cuerpo para protección, aislamiento y autoexpresión; típicamente hechos de tela o textiles."},{"@language":"de","@value":"Gegenstände, die zum Schutz, zur Isolierung und zur Selbstdarstellung am Körper getragen werden; in der Regel aus Stoff oder Textilien hergestellt."},{"@language":"nl","@value":"Items die op het lichaam worden gedragen voor bescherming, isolatie en zelfexpressie; meestal gemaakt van stof of textiel."},{"@language":"sv","@value":"Föremål som bärs på kroppen för skydd, isolering och personligt uttryck, vanligtvis tillverkade av textilier."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000568"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000970"},{"@id":"https://homosaurus.org/v5/homoit0001808"},{"@id":"https://homosaurus.org/v5/homoit0003815"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000316"},{"@id":"https://homosaurus.org/v5/homoit0000318"},{"@id":"https://homosaurus.org/v5/homoit0000366"},{"@id":"https://homosaurus.org/v5/homoit0000367"},{"@id":"https://homosaurus.org/v5/homoit0001895"},{"@id":"https://homosaurus.org/v5/homoit0002169"},{"@id":"https://homosaurus.org/v5/homoit0003063"},{"@id":"https://homosaurus.org/v5/homoit0003066"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh99005081"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/clothing"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000970","dc:identifier":"homoit0000970","skos:prefLabel":[{"@language":"en","@value":"Lingerie"},{"@language":"es","@value":"Lencería"},{"@language":"nl","@value":"Lingerie"},{"@language":"sv","@value":"Underkläder"}],"skos:altLabel":{"@language":"es","@value":"Ropa íntima"},"rdfs:comment":[{"@language":"en","@value":"Category of clothing that includes bras, underwear, hosiery, and robes; typically refers to undergarments and sleepwear designed to be sexually appealing and worn in erotic contexts."},{"@language":"es","@value":"Categoría de ropa que incluye sujetadores, ropa interior, medias y batas; típicamente, se refiere a ropa interior y ropa de dormir diseñada para ser sexualmente atractiva y usada en contextos eróticos."},{"@language":"nl","@value":"Kledingcategorie die beha's, ondergoed, kousen en badjassen omvat; verwijst doorgaans naar onderkleding en nachtkleding die is ontworpen om seksueel aantrekkelijk te zijn en die in erotische context wordt gedragen."},{"@language":"sv","@value":"Kategori av kläder som inkluderar behåar, underkläder, strumpor och morgonrockar. Syftar oftast på underkläder och nattplagg designade för att vara sexuellt tilltalande och bäras i erotiska sammanhang."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000289"},{"@id":"https://homosaurus.org/v5/homoit0000367"},{"@id":"https://homosaurus.org/v5/homoit0001266"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000316"},{"@id":"https://homosaurus.org/v5/homoit0000318"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85077205"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lingerie"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001808","dc:identifier":"homoit0001808","skos:prefLabel":[{"@language":"en","@value":"Costumes"},{"@language":"es","@value":"Disfraces"},{"@language":"de","@value":"Kostüm"},{"@language":"nl","@value":"Kostuums"},{"@language":"sv","@value":"Kostymer"}],"skos:altLabel":{"@language":"sv","@value":"Utklädnad"},"rdfs:comment":[{"@language":"en","@value":"Sets of clothing worn to emulate a particular person, place, thing, or time period."},{"@language":"es","@value":"Conjuntos de ropa que se usan para emular a una persona, lugar, cosa o período de tiempo particular."},{"@language":"de","@value":"Kleidung oder Verkleidung, um eine bestimmte Person, einen bestimmten Ort, eine bestimmte Sache oder eine bestimmte Zeitperiode nachzuahmen."},{"@language":"nl","@value":"Een set kleding die wordt gedragen om een bepaalde persoon, plaats, ding of tijd na te bootsen"},{"@language":"sv","@value":"Uppsättningar av kläder som bärs för att efterlikna en specifik person, plats, sak eller tidsperiod."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000289"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000367"},{"@id":"https://homosaurus.org/v5/homoit0000607"},{"@id":"https://homosaurus.org/v5/homoit0002169"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85033238"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2022-01-18"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000316","dc:identifier":"homoit0000316","skos:prefLabel":[{"@language":"en","@value":"Crossdressers"},{"@language":"es","@value":"Transformistas"},{"@language":"de","@value":"Crossdresser"},{"@language":"nl","@value":"Crossdressers"},{"@language":"sv","@value":"Crossdressers"}],"skos:altLabel":{"@language":"en","@value":"Cross-dressers"},"rdfs:comment":[{"@language":"en","@value":"Individuals who wear clothes stereotypical to or associated with a gender other than their predominantly-identified gender. Crossdressers often develop a persona while crossdressing. Only use to describe individuals who self-identify as crossdressers."},{"@language":"es","@value":"Personas que usan ropa estereotipada o asociada con un género distinto al género bajo el cual se autoidentifican predominantemente. Los transformistas a menudo desarrollan una personalidad en relación a la práctica. Utilícese únicamente para describir a personas que se autoidentifican como transformistas."},{"@language":"de","@value":"Personen, die Kleidung tragen, die nach gesellschaftlichen Geschlechternormen nicht mit dem Geschlecht assoziiert wird, mit dem sie sich identifizieren. Nur für Personen zu verwenden, die sich selbst als Crossdresser identifizieren."},{"@language":"nl","@value":"Personen die kleding dragen die stereotiep is voor of geassocieerd is met een ander gender dan hun overwegend geïdentificeerde gender. Crossdressers ontwikkelen vaak een persona tijdens crossdressing. Alleen gebruiken om personen te beschrijven die zichzelf identificeren als crossdressers."},{"@language":"sv","@value":"Personer som bär kläder som stereotypiskt förknippas med ett annat kön än det de i huvudsak identifierar sig som. Crossdressers utvecklar ofta en särskild persona när de klär sig på detta sätt. Används endast för personer som själva identifierar sig som crossdressers."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001817"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000289"},{"@id":"https://homosaurus.org/v5/homoit0000318"},{"@id":"https://homosaurus.org/v5/homoit0000373"},{"@id":"https://homosaurus.org/v5/homoit0000375"},{"@id":"https://homosaurus.org/v5/homoit0000396"},{"@id":"https://homosaurus.org/v5/homoit0000970"},{"@id":"https://homosaurus.org/v5/homoit0001076"},{"@id":"https://homosaurus.org/v5/homoit0001085"},{"@id":"https://homosaurus.org/v5/homoit0001090"},{"@id":"https://homosaurus.org/v5/homoit0001378"},{"@id":"https://homosaurus.org/v5/homoit0001470"},{"@id":"https://homosaurus.org/v5/homoit0001781"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh89002495"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001817"},"dc:replaces":{"@id":"http://homosaurus.org/v2/crossdressers"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000318","dc:identifier":"homoit0000318","skos:prefLabel":[{"@language":"en","@value":"Crossdressing"},{"@language":"es","@value":"Transformismo"},{"@language":"de","@value":"Crossdressing"},{"@language":"nl","@value":"Crossdressing"},{"@language":"sv","@value":"Crossdressing"}],"rdfs:comment":[{"@language":"en","@value":"The practice of wearing clothing stereotypical to a gender other than the individual's predominantly-identified gender."},{"@language":"es","@value":"La práctica de usar ropa estereotipada de un género distinto al género bajo el cual se identifica una persona predominantemente."},{"@language":"de","@value":"Das Tragen von Kleidung, die nach gesellschaftlichen Geschlechternormen nicht mit dem Geschlecht assoziiert wird, mit dem sich eine Person identifiziert."},{"@language":"nl","@value":"De praktijk van het dragen van kleding die stereotiep is voor een gender anders dan de genderidentiteit van het individu; sommige, maar niet alle individuen ontwikkelen persona's om te gebruiken tijdens crossdressing."},{"@language":"sv","@value":"Praktiken att bära kläder som stereotypiskt förknippas med ett annat kön än personens huvudsakliga könsidentitet."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000568"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000289"},{"@id":"https://homosaurus.org/v5/homoit0000316"},{"@id":"https://homosaurus.org/v5/homoit0000395"},{"@id":"https://homosaurus.org/v5/homoit0000685"},{"@id":"https://homosaurus.org/v5/homoit0000970"},{"@id":"https://homosaurus.org/v5/homoit0001233"},{"@id":"https://homosaurus.org/v5/homoit0001469"},{"@id":"https://homosaurus.org/v5/homoit0001895"},{"@id":"https://homosaurus.org/v5/homoit0003126"},{"@id":"https://homosaurus.org/v5/homoit0003160"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85137104"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/crossdressing"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000366","dc:identifier":"homoit0000366","skos:prefLabel":[{"@language":"en","@value":"Drab (LGBTQ+ culture)"},{"@language":"es","@value":"Drab (cultura LGBTQ+)"},{"@language":"de","@value":"Drab (LGBTQ+ Kultur)"},{"@language":"nl","@value":"Drab"},{"@language":"sv","@value":"Drab (hbtq+-kultur)"}],"skos:altLabel":[{"@language":"en","@value":"Drab"},{"@language":"es","@value":"Drab"},{"@language":"de","@value":"Drab"}],"rdfs:comment":[{"@language":"en","@value":"Slang term used to describe people wearing masculine clothing, typically drag queens or crossdressers who also sometimes wear feminine clothing. Drab is a shortened form of the phrase \"dressed as a boy\" or \"dress resembling a boy.\""},{"@language":"es","@value":"Término de la jerga utilizado para describir a personas que visten ropa masculina, generalmente drag queens o transformistas que a veces también visten ropa femenina. Drab es una forma abreviada de la frase en inglés \"dressed as a boy\" o \"dress resembling a boy\"."},{"@language":"de","@value":"Slangbegriff, der verwendet wird, um Personen in männlicher Kleidung zu beschreiben, die in der Regel Dragqueens oder Crossdresser sind und manchmal auch weibliche Kleidung tragen. “Drab” ist eine Abkürzung des englischen Begriffs “dressed as a boy” oder “dress resembling a boy.”"},{"@language":"nl","@value":"Argot-term die wordt gebruikt om een persoon te beschrijven die mannelijke kleding draagt, meestal een drag queen of crossdresser die soms ook vrouwelijke kleding draagt. Drab is een verkorte vorm van de uitdrukking \"dressed as a boy\" of \"dress resembling a boy\"."},{"@language":"sv","@value":"Slangterm som används för att beskriva personer i maskulina kläder, vanligtvis dragqueens eller crossdressers som ibland också bär feminina plagg. Drab är en förkortning av frasen ”dressed as a boy” eller ”dress resembling a boy”."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000568"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000289"},{"@id":"https://homosaurus.org/v5/homoit0000367"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/drab"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001895","dc:identifier":"homoit0001895","skos:prefLabel":[{"@language":"en","@value":"Masquerading"},{"@language":"es","@value":"Disfrazarte"},{"@language":"nl","@value":"Vermomming"},{"@language":"sv","@value":"Masquerading"}],"rdfs:comment":[{"@language":"en","@value":"Term used in the 18th and 19th centuries to describe the act of dressing in disguise, often to emulate another gender. Only use in historical contexts."},{"@language":"es","@value":"Término utilizado en los siglos XVIII y XIX para describir el acto de vestirse disfrazado, a menudo para emular a otro género. Utilícese únicamente en contextos históricos."},{"@language":"nl","@value":"Term die in de 18e en 19e eeuw werd gebruikt om de handeling van vermomming te beschrijven, vaak om een ander geslacht na te bootsen; alleen gebruiken in historische context"},{"@language":"sv","@value":"Term som användes under 1700- och 1800-talen för att beskriva förklädnad, ofta i syfte att efterlikna ett annat kön. Används endast i historiska sammanhang."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000878"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000289"},{"@id":"https://homosaurus.org/v5/homoit0000318"},{"@id":"https://homosaurus.org/v5/homoit0000367"},{"@id":"https://homosaurus.org/v5/homoit0001469"}],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh86000513"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000878"},"dc:issued":{"@type":"xsd:date","@value":"2022-02-28"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002169","dc:identifier":"homoit0002169","skos:prefLabel":[{"@language":"en","@value":"Fursuits"},{"@language":"de","@value":"Fursuits"},{"@language":"es","@value":"Trajes de furro"},{"@language":"nl","@value":"Fursuits"},{"@language":"sv","@value":"Fursuit"}],"skos:altLabel":[{"@language":"es","@value":"Traje de furry"},{"@language":"es","@value":"Fursuit"}],"rdfs:comment":[{"@language":"en","@value":"Costumes worn by furries that represent their fursonas (i.e., anthropomorphized animal versions of themselves)."},{"@language":"de","@value":"Von Furries getragene Kostüme, die ihre Fursonas darstellen (d. h. anthropomorphisierte tierische Versionen ihrer selbst)."},{"@language":"es","@value":"Disfraces utilizados por furros que representan sus fursonas (es decir, versiones animales antropomorfizadas de ellos mismos)"},{"@language":"nl","@value":"Kostuums gedragen door furries die hun fursona's vertegenwoordigen (d.w.z. antropomorfe dierlijke versies van zichzelf)"},{"@language":"sv","@value":"Kostymer som bärs av personer inom furry-gemenskapen och som representerar deras fursonor (det vill säga antropomorfa djurversioner av dem själva)."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002165"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000289"},{"@id":"https://homosaurus.org/v5/homoit0001241"},{"@id":"https://homosaurus.org/v5/homoit0001242"},{"@id":"https://homosaurus.org/v5/homoit0001808"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003066","dc:identifier":"homoit0003066","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ fashion"},{"@language":"ja","@value":"LGBTQ+のファッション"},{"@language":"es","@value":"Moda LGBTQ+"},{"@language":"nl","@value":"LHBTQ+-mode"},{"@language":"sv","@value":"Hbtq+-mode"}],"skos:altLabel":[{"@language":"es","@value":"Estilo LGBTQ+"},{"@language":"sv","@value":"Mode (hbtq+)"}],"rdfs:comment":[{"@language":"en","@value":"Fashion, clothing, and accessories associated with LGBTQ+ subcultures and expression."},{"@language":"ja","@value":"LGBTQ+のサブカルチャーや表現に関連するファッション、衣類、アクセサリー。"},{"@language":"es","@value":"Moda, ropa y accesorios asociados con las subculturas y expresiones LGBTQ+."},{"@language":"nl","@value":"Mode, kleding en accessoires geassocieerd met LHBTQ+-subculturen en -expressie."},{"@language":"sv","@value":"Mode, kläder och accessoarer förknippade med hbtq+-subkulturer och uttryck."}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000307"},{"@id":"https://homosaurus.org/v5/homoit0001246"},{"@id":"https://homosaurus.org/v5/homoit0003100"},{"@id":"https://homosaurus.org/v5/homoit0003111"},{"@id":"https://homosaurus.org/v5/homoit0003112"},{"@id":"https://homosaurus.org/v5/homoit0003117"},{"@id":"https://homosaurus.org/v5/homoit0003146"},{"@id":"https://homosaurus.org/v5/homoit0003178"},{"@id":"https://homosaurus.org/v5/homoit0003849"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000289"},{"@id":"https://homosaurus.org/v5/homoit0000568"},{"@id":"https://homosaurus.org/v5/homoit0001816"},{"@id":"https://homosaurus.org/v5/homoit0003059"},{"@id":"https://homosaurus.org/v5/homoit0003063"},{"@id":"https://homosaurus.org/v5/homoit0003955"},{"@id":"https://homosaurus.org/v5/homoit0003964"},{"@id":"https://homosaurus.org/v5/homoit0003965"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0003066"},"dc:issued":{"@type":"xsd:date","@value":"2023-12-18"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000292","dc:identifier":"homoit0000292","skos:prefLabel":[{"@language":"en","@value":"Cock rings"},{"@language":"es","@value":"Anillos para el pene"},{"@language":"de","@value":"Cockring"},{"@language":"nl","@value":"Cockringen"},{"@language":"sv","@value":"Penisringar"}],"skos:altLabel":{"@language":"de","@value":"Penisring"},"rdfs:comment":[{"@language":"en","@value":"Rings or circular sex toys worn on the penis to maintain an erection and prevent orgasm."},{"@language":"es","@value":"Anillos o juguetes sexuales circulares que se colocan en el pene para mantener la erección y prevenir el orgasmo."},{"@language":"de","@value":"Ringe oder ringförmige Sexspielzeuge, die am Penis getragen werden, um eine Erektion aufrechtzuerhalten und einen Orgasmus zu verhindern."},{"@language":"nl","@value":"Een ring of rond seksspeeltje dat rond de penis en balzak wordt gedragen om een erectie te behouden en een orgasme te voorkomen."},{"@language":"sv","@value":"Ringar eller cirkulära sexleksaker som bärs på penisen för att upprätthålla en erektion och förhindra orgasm."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001266"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001099"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001266"},"dc:replaces":{"@id":"http://homosaurus.org/v2/cockRings"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003509","dc:identifier":"homoit0003509","skos:prefLabel":[{"@language":"en","@value":"Questioning"},{"@language":"nl","@value":"Questioning"},{"@language":"sv","@value":"Utforskande (hbtq+)"}],"skos:altLabel":{"@language":"sv","@value":"Questioning"},"rdfs:comment":[{"@language":"en","@value":"A term used to describe individuals who are in the process of determining their sexual orientation and/or gender identity. "},{"@language":"nl","@value":"Een term die wordt gebruikt om personen te beschrijven die bezig zijn hun seksuele oriëntatie en/of genderidentiteit te bepalen."},{"@language":"sv","@value":"Term som beskriver personer som befinner sig i processen att utforska sin sexuella läggning och/eller könsidentitet."}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000295"},{"@id":"https://homosaurus.org/v5/homoit0003445"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0003509"},"dc:issued":{"@type":"xsd:date","@value":"2024-07-31"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000296","dc:identifier":"homoit0000296","skos:prefLabel":[{"@language":"en","@value":"Common law marriage"},{"@language":"es","@value":"Matrimonio de hecho"},{"@language":"de","@value":"Eheähnliche Gemeinschaft"},{"@language":"nl","@value":"Huwelijk naar gewoonterecht"},{"@language":"sv","@value":"Samboäktenskap"}],"skos:altLabel":[{"@language":"es","@value":"Pareja de hecho"},{"@language":"es","@value":"Unión de hecho"},{"@language":"de","@value":"Konkubinat"}],"rdfs:comment":[{"@language":"en","@value":"Legal framework in which two partners are considered married without having formally registered their relationship as a civil or religious marriage. Common law marriage grants certain economic rights and legal privileges. "},{"@language":"es","@value":"Marco jurídico en el que dos cónyuges se consideran casados ​​sin haber registrado formalmente su relación como matrimonio civil o religioso. El matrimonio de hecho otorga ciertos derechos económicos y privilegios legales."},{"@language":"de","@value":"Rechtlicher Rahmen, in dem zwei Partner:innen als verheiratet gelten, ohne ihre Beziehung formell als standesamtliche oder kirchliche Ehe registriert zu haben. Die eheähnliche Gemeinschaft gewährt bestimmte wirtschaftliche Rechte und rechtliche Privilegien. In der Schweiz wird die eheähnliche Gemeinschaft Konkubinat genannt."},{"@language":"nl","@value":"Juridisch kader waarin partners als gehuwd worden beschouwd zonder hun relatie formeel te hebben geregistreerd als een burgerlijk of religieus huwelijk dat bepaalde economische rechten en wettelijke privileges verleent."},{"@language":"sv","@value":"Juridiskt ramverk där två partners betraktas som gifta utan att ha registrerat sitt förhållande som ett civilrättsligt eller religiöst äktenskap. Samboäktenskap ger vissa ekonomiska rättigheter och juridiska privilegier. Företeelsen förekommer inte inom svensk juridik."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000990"},{"@id":"https://homosaurus.org/v5/homoit0000992"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85028995"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000973"},"dc:replaces":{"@id":"http://homosaurus.org/v2/commonLawMarriage"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000485","dc:identifier":"homoit0000485","skos:prefLabel":[{"@language":"en","@value":"Gay community"},{"@language":"es","@value":"Comunidad gay"},{"@language":"de","@value":"Schwule Gemeinschaft"},{"@language":"fr","@value":"Communauté gaie"},{"@language":"nl","@value":"Homogemeenschap"},{"@language":"sv","@value":"Böggemenskaper"}],"skos:altLabel":[{"@language":"de","@value":"Gay-Community"},{"@language":"fr","@value":"Communauté homosexuelle"},{"@language":"fr","@value":"Communauté gay"},{"@language":"sv","@value":"Bögcommunityn"},{"@language":"sv","@value":"Homosexuella manliga gemenskaper"}],"rdfs:comment":[{"@language":"en","@value":"Groups of people who share the experience of being gay men."},{"@language":"es","@value":"Grupos de personas que comparten la experiencia de ser hombres gay."},{"@language":"de","@value":"Gruppen von Personen, die die Erfahrung teilen, schwul zu sein."},{"@language":"fr","@value":"Groupes de personnes qui partagent l'expérience d'être des hommes gais."},{"@language":"nl","@value":"Groepen mensen die de ervaring van het homo-zijn delen."},{"@language":"sv","@value":"Grupper av personer som delar erfarenheten av att vara bögar."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000297"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000474"},{"@id":"https://homosaurus.org/v5/homoit0000486"},{"@id":"https://homosaurus.org/v5/homoit0000506"},{"@id":"https://homosaurus.org/v5/homoit0000594"},{"@id":"https://homosaurus.org/v5/homoit0000804"},{"@id":"https://homosaurus.org/v5/homoit0000805"},{"@id":"https://homosaurus.org/v5/homoit0000806"},{"@id":"https://homosaurus.org/v5/homoit0000807"},{"@id":"https://homosaurus.org/v5/homoit0000882"},{"@id":"https://homosaurus.org/v5/homoit0001789"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh91003435"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000297"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayCommunity"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000733","dc:identifier":"homoit0000733","skos:prefLabel":[{"@language":"en","@value":"Lesbian community"},{"@language":"es","@value":"Comunidad lésbica"},{"@language":"fr","@value":"Communauté lesbienne"},{"@language":"nl","@value":"Lesbische gemeenschap"},{"@language":"sv","@value":"Lesbiska gemenskaper"}],"skos:altLabel":[{"@language":"es","@value":"Comunidad lesbiana"},{"@language":"sv","@value":"Lesbiska communityn"}],"rdfs:comment":[{"@language":"en","@value":"Groups of people who share the experience of being lesbians."},{"@language":"es","@value":"Grupos de personas que comparten la experiencia de ser lesbianas."},{"@language":"fr","@value":"Groupes de personnes qui partagent l'expérience d'être lesbiennes."},{"@language":"nl","@value":"Groepen mensen die de ervaring van het lesbisch-zijn delen."},{"@language":"sv","@value":"Grupper av personer som delar erfarenheten av att vara lesbiska."}],