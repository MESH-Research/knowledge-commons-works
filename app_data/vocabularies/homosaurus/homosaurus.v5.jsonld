pe":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001203","dc:identifier":"homoit0001203","skos:prefLabel":[{"@language":"en","@value":"Queer publishers"},{"@language":"es","@value":"Editoriales queer"},{"@language":"nl","@value":"Queer uitgeverijen"},{"@language":"sv","@value":"Queera förlag"}],"rdfs:comment":[{"@language":"en","@value":"Companies and organizations that publish materials for queer communities or addressing queer issues."},{"@language":"es","@value":"Empresas y organizaciones que publican materiales para comunidades queer o que abordan asuntos queer."},{"@language":"nl","@value":"Bedrijven en organisaties die materiaal publiceren voor queer gemeenschappen of queer thema's aanspreken"},{"@language":"sv","@value":"Företag och organisationer som ger ut material för queera gemenskaper eller som behandlar queera frågor."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001144"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001144"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerPublishers"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001440","dc:identifier":"homoit0001440","skos:prefLabel":[{"@language":"en","@value":"Transgender publishers"},{"@language":"es","@value":"Editoriales transgénero"},{"@language":"nl","@value":"Transgender uitgeverijen"},{"@language":"sv","@value":"Transförlag"}],"skos:altLabel":{"@language":"es","@value":"Editoriales trans"},"rdfs:comment":[{"@language":"en","@value":"Companies and organizations that publish materials for transgender communities or addressing transgender issues."},{"@language":"es","@value":"Empresas y organizaciones que publican materiales para comunidades transgénero o que abordan asuntos transgénero."},{"@language":"nl","@value":"Bedrijven en organisaties die materiaal publiceren voor transgender gemeenschappen of transgender thema's aanspreken"},{"@language":"sv","@value":"Företag och organisationer som ger ut material för transgemenskaper eller som behandlar frågor som rör transpersoner."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001144"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001144"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transgenderPublishers"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002805","dc:identifier":"homoit0002805","skos:prefLabel":[{"@language":"en","@value":"Asexual publishers"},{"@language":"es","@value":"Editoriales asexuales"},{"@language":"de","@value":"Asexuelle Verlage"},{"@language":"nl","@value":"Aseksuele uitgeverijen"},{"@language":"sv","@value":"Asexuella förlag"}],"skos:altLabel":[{"@language":"de","@value":"Asexuelle Verleger:innen"},{"@language":"de","@value":"Ace Verleger:innen"},{"@language":"de","@value":"Ace Verlage"},{"@language":"sv","@value":"Ace-förlag"}],"rdfs:comment":[{"@language":"en","@value":"Companies and organizations that publish materials for asexual communities or addressing asexual issues."},{"@language":"es","@value":"Empresas y organizaciones que publican materiales para comunidades asexuales o que abordan asuntos asexuales."},{"@language":"de","@value":"Unternehmen und Organisationen, die Materialien für asexuelle Gemeinschaften veröffentlichen oder sich mit asexuellen Themen befassen."},{"@language":"nl","@value":"Bedrijven en organisaties die materiaal publiceren voor aseksuele gemeenschappen of aseksuele thema's aanspreken"},{"@language":"sv","@value":"Företag och organisationer som publicerar material för asexuella gemenskaper eller som behandlar asexuella frågor."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001144"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001144"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002937","dc:identifier":"homoit0002937","skos:prefLabel":[{"@language":"en","@value":"Intersex publishers"},{"@language":"de","@value":"Inter* Verlage"},{"@language":"es","@value":"Editoriales intersexual"},{"@language":"nl","@value":"Intersekse uitgeverijen"},{"@language":"sv","@value":"Intersexförlag"}],"skos:altLabel":[{"@language":"de","@value":"Inter* Verleger:innen"},{"@language":"es","@value":"Editoriales intersex"}],"rdfs:comment":[{"@language":"en","@value":"Companies and organizations that publish materials for intersex communities or addressing intersex issues."},{"@language":"de","@value":"Unternehmen und Organisationen, die Materialien für inter* Gemeinschaften veröffentlichen oder sich mit inter* Themen befassen."},{"@language":"es","@value":"Empresas y organizaciones que publican materiales para comunidades intersex o que abordan asuntos intersex."},{"@language":"nl","@value":"Bedrijven en organisaties die materiaal publiceren voor intersekse gemeenschappen of interseke thema's aanspreken."},{"@language":"sv","@value":"Företag och organisationer som publicerar material för intersexgemenskaper eller som behandlar intersexfrågor."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001144"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001144"},"dc:issued":{"@type":"xsd:date","@value":"2023-09-29"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002720","dc:identifier":"homoit0002720","skos:prefLabel":[{"@language":"en","@value":"Two-Spirit publishers"},{"@language":"es","@value":"Editoriales dos espíritus"},{"@language":"nl","@value":"Two-Spirit uitgeverijen"},{"@language":"sv","@value":"Two-spirit-förlag"}],"skos:altLabel":[{"@language":"en","@value":"2S publishers"},{"@language":"en","@value":"Two Spirit publishers"},{"@language":"en","@value":"Two Spirited publishers"},{"@language":"en","@value":"Two-Spirited publishers"}],"rdfs:comment":[{"@language":"en","@value":"Companies and organizations that publish materials for Two-Spirit communities or addressing Two-Spirit issues."},{"@language":"es","@value":"Empresas y organizaciones que publican materiales para comunidades dos espíritus o que abordan asuntos dos espíritus."},{"@language":"nl","@value":"Uitgevers die materiaal publiceren voor Two-Spirit gemeenschappen of materiaal dat betrekking heeft op Two-Spirit kwesties"},{"@language":"sv","@value":"Företag och organisationer som ger ut material för Two-spirit-gemenskaper eller som behandlar frågor som rör Two-spirit-personer."}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001144"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0002720"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-27"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001891","dc:identifier":"homoit0001891","skos:prefLabel":[{"@language":"en","@value":"Crip"},{"@language":"de","@value":"Crip"},{"@language":"es","@value":"Crip"},{"@language":"nl","@value":"Crip"},{"@language":"sv","@value":"Crip"}],"skos:altLabel":{"@language":"es","@value":"Disca"},"rdfs:comment":[{"@language":"en","@value":"A shortened form of the word \"cripple\" that has been reclaimed by disabled people to express pride and identify their political and community ties. Only use in reference to individuals or organizations that self-identify as crip. Because of the many intersections between crip theory/culture and queer theory/culture, the two are often but not always viewed as related."},{"@language":"de","@value":"Eine verkürzte Form des Wortes „cripple“ (Krüppel), die von Menschen mit Behinderung zurückerobert wurde, um Stolz auszudrücken und ihre politischen und gemeinschaftlichen Verbindungen zu verdeutlichen. Nur in Bezug auf Personen oder Organisationen zu verwenden, die sich selbst als „crip“ bezeichnen. Aufgrund der vielen Überschneidungen zwischen der Crip-Theorie/-Kultur und der Queertheorie/-kultur werden beide oft, aber nicht immer, als miteinander verbunden angesehen."},{"@language":"es","@value":"Forma abreviada de la palabra en inglés \"cripple\", lisiada/o, que ha sido recuperada por las personas con discapacidad para expresar su orgullo e identificar sus vínculos políticos y comunitarios. Se debe utilizar únicamente en referencia a personas u organizaciones que se autoidentifican como \"crip\". Debido a las numerosas intersecciones entre la teoría/cultura crip y la teoría/cultura queer, ambas suelen considerarse relacionadas, aunque no siempre."},{"@language":"nl","@value":"Een verkorte vorm van het woord \"kreupel\" (\"cripple\") dat is herclaimd door gehandicapten om trots te uiten en hun politieke en gemeenschapsbanden te identificeren; alleen gebruiken met betrekking tot individuen of organisaties die zichzelf identificeren als crip. Vanwege de vele raakvlakken tussen crip-theorie/cultuur en queer-theorie/cultuur, worden de twee vaak, maar niet altijd, als verwant gezien"},{"@language":"sv","@value":"En förkortning av ordet ”cripple” som återtagits av funktionsnedsatta för att kritisera de normer i samhället som skapar funktionshinder, samt för att identifiera sina politiska och gemenskapsmässiga kopplingar. Används endast i referens till individer eller organisationer som själva identifierar sig som crip. På grund av de många överlappningarna mellan cripteori/-kultur och queerteori/-kultur betraktas de ofta, men inte alltid, som relaterade."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001559"},"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0003986"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001149"},{"@id":"https://homosaurus.org/v5/homoit0001854"},{"@id":"https://homosaurus.org/v5/homoit0001878"},{"@id":"https://homosaurus.org/v5/homoit0001879"},{"@id":"https://homosaurus.org/v5/homoit0002577"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001317"},"dc:issued":{"@type":"xsd:date","@value":"2022-02-24"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002042","dc:identifier":"homoit0002042","skos:prefLabel":[{"@language":"en","@value":"Queer gaze"},{"@language":"es","@value":"Mirada queer"},{"@language":"nl","@value":"Queer blik"},{"@language":"sv","@value":"Den queera blicken"}],"rdfs:comment":[{"@language":"en","@value":"A term used to describe the ways LGBTQ+ people create and engage with media and art, in contrast to the male gaze, female gaze, or straight gaze."},{"@language":"es","@value":"Un término utilizado para describir las formas en que las personas LGBTQ+ crean e interactúan con los medios y el arte, en contraste a la mirada masculina, la mirada femenina o la mirada hetero."},{"@language":"nl","@value":"Een term die wordt gebruikt om de manieren te beschrijven waarop LHBTQ+-mensen media en kunst creëren en ermee omgaan, in tegenstelling tot de mannelijke blik, vrouwelijke blik of heteroblik"},{"@language":"sv","@value":"Ett begrepp som beskriver hur hbtq+-personer skapar och förhåller sig till media och konst, i kontrast till den manliga, kvinnliga eller heterosexuella blicken."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001219"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001149"},{"@id":"https://homosaurus.org/v5/homoit0002040"},{"@id":"https://homosaurus.org/v5/homoit0002041"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001365"},"dc:issued":{"@type":"xsd:date","@value":"2022-06-15"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002577","dc:identifier":"homoit0002577","skos:prefLabel":[{"@language":"en","@value":"Queercrip"},{"@language":"es","@value":"Queercrip"},{"@language":"nl","@value":"Queercrip"},{"@language":"sv","@value":"Queercrip"}],"skos:altLabel":[{"@language":"en","@value":"Cripqueer"},{"@language":"es","@value":"Cripqueer"},{"@language":"sv","@value":"Cripqueer"}],"rdfs:comment":[{"@language":"en","@value":"A portmanteau of two reclaimed terms (queer and crip) used to indicate that a person or a thing belongs to both queer and crip communities, often used to indicate unity or shared struggles. This term may also appear as \"cripqueer\" to emphasize the crip identity before the queer one.\t\t\t\t"},{"@language":"es","@value":"La unión de dos términos reclamados (\"queer\" y \"crip\") utilizados para indicar que una persona o cosa pertenece tanto a comunidades queer como crip, a menudo utilizado para indicar unidad o luchas compartidas. Este término también puede aparecer como \"cripqueer\" para enfatizar la identidad crip antes que la queer."},{"@language":"nl","@value":"Een samenvoeging van twee herwonnen termen (queer en crip) die worden gebruikt om aan te geven dat een persoon of iets tot zowel queer- als crip-gemeenschappen behoort, vaak gebruikt om eenheid of gedeelde strijd aan te duiden. Deze term kan ook voorkomen als \"cripqueer\" om de crip-identiteit vóór de queer-identiteit te benadrukken."},{"@language":"sv","@value":"Ett sammanslaget ord av queer och crip, använt för att beskriva personer eller fenomen som tillhör både queer- och funktionsnedsattas gemenskaper. Kan också skrivas som ”cripqueer” när funktionsnedsättningsidentiteten betonas först."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001559"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001149"},{"@id":"https://homosaurus.org/v5/homoit0001195"},{"@id":"https://homosaurus.org/v5/homoit0001854"},{"@id":"https://homosaurus.org/v5/homoit0001879"},{"@id":"https://homosaurus.org/v5/homoit0001891"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001317"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-12"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001215","dc:identifier":"homoit0001215","skos:prefLabel":[{"@language":"en","@value":"Queer youth"},{"@language":"es","@value":"Juventud queer"},{"@language":"nl","@value":"Queer jongeren"},{"@language":"sv","@value":"Unga queera personer"}],"skos:altLabel":[{"@language":"en","@value":"Queer teenagers"},{"@language":"en","@value":"Queer adolescents"},{"@language":"en","@value":"Queer teens"},{"@language":"es","@value":"Adolescentes queer"},{"@language":"es","@value":"Jóvenes queer"},{"@language":"nl","@value":"Queer teenagers"},{"@language":"nl","@value":"Queer tieners"},{"@language":"sv","@value":"Unga queers"}],"rdfs:comment":[{"@language":"en","@value":"Queer people who are between the ages of childhood and adulthood."},{"@language":"es","@value":"Personas queer que se encuentran entre las edades de la niñez y la edad adulta."},{"@language":"nl","@value":"Queer personen in de leeftijd tussen kindertijd en volwassenheid"},{"@language":"sv","@value":"Queera personer i fasen mellan barndom och vuxen ålder."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001195"},{"@id":"https://homosaurus.org/v5/homoit0001521"}],"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0001167"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001228"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerYouth"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001178","dc:identifier":"homoit0001178","skos:prefLabel":[{"@language":"en","@value":"Queer identity"},{"@language":"es","@value":"Identidad queer"},{"@language":"nl","@value":"Queer identiteit"},{"@language":"sv","@value":"Queer identitet"}],"rdfs:comment":[{"@language":"en","@value":"Identity term that can be used to describe several not-necessarily-mutually-exclusive understandings of queerness. Queerness can describe identities that exist outside of or between different identities, and also identities that actively resist normative understandings of sexuality and/or gender. This term should only be used for those who self-identify as queer."},{"@language":"es","@value":"Término identitario que se puede utilizar para describir varias interpretaciones de lo queer, no necesariamente mutuamente excluyentes. Lo queer puede describir identidades que existen fuera de o entre diferentes identidades, y también identidades que se resisten activamente a entendimientos normativos de la sexualidad y/o el género. Utilícese únicamente para quienes se autoidentifiquen como queer."},{"@language":"nl","@value":"Identiteitsterm die kan worden gebruikt om verschillende niet noodzakelijkerwijs wederzijds uitsluitende opvattingen over queerness te beschrijven. Queerness kan identiteiten beschrijven die buiten of tussen verschillende identiteiten bestaan, en ook identiteiten die zich actief verzetten tegen normatieve opvattingen over seksualiteit en/of gender. Deze term mag alleen worden gebruikt voor degenen die zichzelf identificeren als queer."},{"@language":"sv","@value":"Identitetsterm som kan beskriva flera olika, icke nödvändigtvis ömsesidigt uteslutande sätt att förstå queerhet. Begreppet kan beskriva identiteter som befinner sig utanför eller mellan etablerade identiteter, eller som aktivt motsätter sig normativa föreställningar om kön och/eller sexualitet. Använd endast för personer som själva identifierar sig som queera."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001295"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001167"},{"@id":"https://homosaurus.org/v5/homoit0001195"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001295"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerIdentity"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003193","dc:identifier":"homoit0003193","skos:prefLabel":[{"@language":"en","@value":"Queer joy"},{"@language":"es","@value":"Alegría queer"},{"@language":"nl","@value":"Queer vreugde"},{"@language":"sv","@value":"Queer glädje"}],"skos:altLabel":[{"@language":"es","@value":"Queer joy"},{"@language":"sv","@value":"Queer joy"}],"rdfs:comment":[{"@language":"en","@value":"A positive feeling connected to queer community, activism, and/or culture that counters the impact of living in a discriminatory society.  Note that queer is used as an umbrella term for the LGBTQ+ community within this phrase."},{"@language":"es","@value":"Un sentimiento positivo conectado con la comunidad, el activismo y/o la cultura queer que contrarresta el impacto de vivir en una sociedad discriminatoria. Tenga en cuenta que queer se utiliza como término general para la comunidad LGBTQ+ dentro de esta frase."},{"@language":"nl","@value":"Een positief gevoel verbonden aan de queer gemeenschap, activisme en/of cultuur dat de impact van het leven in een discriminerende samenleving tegengaat. Hier wordt queer gebruikt als overkoepelende term voor de LHBTQ+-gemeenschap."},{"@language":"sv","@value":"En positiv känsla kopplad till queer gemenskap, aktivism och/eller kultur som fungerar som motkraft till ett samhälle präglat av diskriminering. Observera att queer här används som paraplyterm för hbtq+-gemenskapen."}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001170"},{"@id":"https://homosaurus.org/v5/homoit0002256"},{"@id":"https://homosaurus.org/v5/homoit0003708"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0003193"},"dc:issued":{"@type":"xsd:date","@value":"2024-01-18"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001728","dc:identifier":"homoit0001728","skos:prefLabel":[{"@language":"en","@value":"Queer authors"},{"@language":"es","@value":"Autores queer"},{"@language":"nl","@value":"Queer auteurs"},{"@language":"sv","@value":"Queera författare"}],"rdfs:comment":[{"@language":"en","@value":"Queer creators of written works."},{"@language":"es","@value":"Creadores de obras escritas conocidos por ser queer."},{"@language":"nl","@value":"Queer makers van geschreven werken."},{"@language":"sv","@value":"Queera skapare av skrivna verk."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001723"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001174"},{"@id":"https://homosaurus.org/v5/homoit0001177"},{"@id":"https://homosaurus.org/v5/homoit0001183"},{"@id":"https://homosaurus.org/v5/homoit0001197"},{"@id":"https://homosaurus.org/v5/homoit0001607"},{"@id":"https://homosaurus.org/v5/homoit0001734"},{"@id":"https://homosaurus.org/v5/homoit0002193"},{"@id":"https://homosaurus.org/v5/homoit0001619"},{"@id":"https://homosaurus.org/v5/homoit0003871"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2021-11-02"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004304","dc:identifier":"homoit0004304","skos:prefLabel":[{"@language":"en","@value":"Queer historical fiction"},{"@language":"nl","@value":"Queer historische literatuur"},{"@language":"sv","@value":"Queera historiska skildringar"}],"skos:altLabel":{"@language":"sv","@value":"Queera historiska romaner"},"rdfs:comment":[{"@language":"en","@value":"Genre of written works that depicts events set during particular real historical events. Use for historical fiction focusing on queer characters or themes."},{"@language":"nl","@value":"Geschreven fictieve werken waarin het verhaal zich afspeelt tegen de achtergrond van specifieke, waargebeurde historische gebeurtenissen; gebruik in verwijzing naar historische fictie met queer personages of thema's."},{"@language":"sv","@value":"Skönlitterära verk som utspelar sig i historisk tid, med verkliga händelser och miljöer. Används för historiska skildringar med fokus på queera karaktärer eller teman."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001177"},{"@id":"https://homosaurus.org/v5/homoit0004295"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2026-02-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001585","dc:identifier":"homoit0001585","skos:prefLabel":[{"@language":"en","@value":"Queer horror fiction"},{"@language":"es","@value":"Ficción de horror queer"},{"@language":"de","@value":"Queere Horror-Fiction"},{"@language":"nl","@value":"Queer horrorverhalen"},{"@language":"sv","@value":"Queer skräck"}],"rdfs:comment":[{"@language":"en","@value":"Genre of written works that intend to frighten, scare, or disgust. Use for horror fiction focusing on queer characters or themes."},{"@language":"es","@value":"Obras de ficción escritas con la intención de asustar, atemorizar o provocar disgusto; utilícese en referencia a la ficción de horror centrada en personajes o temas queer."},{"@language":"de","@value":"Fiktionale Werke, die erschrecken, ängstigen oder abstoßen sollen; Verwendung in Bezug auf fiktionale Werke, die sich auf queere Charaktere oder Themen konzentrieren."},{"@language":"nl","@value":"Geschreven fictie bedoeld om angst aan te jagen, bang te maken of te walgen; gebruik in verwijzing naar horrorfictie gericht op queer personages of thema's."},{"@language":"sv","@value":"Skönlitterära verk skrivna för att skrämma, oroa eller äckla. Används för skräcklitteratur med queera karaktärer eller teman."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001580"},{"@id":"https://homosaurus.org/v5/homoit0001177"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerHorrorFiction"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-03"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001596","dc:identifier":"homoit0001596","skos:prefLabel":[{"@language":"en","@value":"Queer romance fiction"},{"@language":"es","@value":"Ficción romántica queer"},{"@language":"de","@value":"Queere Liebesromane"},{"@language":"nl","@value":"Queer liefdesverhalen"},{"@language":"sv","@value":"Queera kärleksromaner"}],"skos:altLabel":[{"@language":"sv","@value":"Queera kärleksskildringar"},{"@language":"sv","@value":"Queer romance"}],"rdfs:comment":[{"@language":"en","@value":"Genre of written works that depicts romantic and/or sexual relationships between the main characters. Use for romance fiction focusing on queer characters or themes."},{"@language":"es","@value":"Obras literarias escritas centradas en las relaciones románticas y el amor entre personas; utilícese en referencia a la ficción romántica que se centra en personajes o temas queer."},{"@language":"de","@value":"Werke der Belletristik, die sich um romantische und/oder sexuelle Beziehungen zwischen den Hauptfiguren drehen; Verwendung in Bezug auf Liebesromane, die sich auf queere Figuren und Themen konzentrieren."},{"@language":"nl","@value":"Geschreven literair werk gericht op romantische relaties en liefde tussen mensen; gebruik in verwijzing naar romantische fictie gericht op queer personages of thema's."},{"@language":"sv","@value":"Skönlitterära verk som kretsar kring romantiska och/eller sexuella relationer mellan huvudkaraktärerna. Används för kärleksromaner med queera karaktärer."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001586"},{"@id":"https://homosaurus.org/v5/homoit0001177"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerRomanceFiction"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-03"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002193","dc:identifier":"homoit0002193","skos:prefLabel":[{"@language":"en","@value":"Queer people in fandom"},{"@language":"es","@value":"Personas queer en fandom"},{"@language":"nl","@value":"Queer personen in fandom"},{"@language":"sv","@value":"Queera personer inom fandom"}],"rdfs:comment":[{"@language":"en","@value":"The participation and inclusion of queer people in fan communities."},{"@language":"es","@value":"La participación e inclusión de personas queer en las comunidades de fans."},{"@language":"nl","@value":"De participatie en inclusie van queer personen in fan-gemeenschappen"},{"@language":"sv","@value":"Queera personers deltagande i och inkludering i fangemenskaper."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002181"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001177"},{"@id":"https://homosaurus.org/v5/homoit0001195"},{"@id":"https://homosaurus.org/v5/homoit0001728"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004023","dc:identifier":"homoit0004023","skos:prefLabel":[{"@language":"en","@value":"Queer people in literature"},{"@language":"nl","@value":"Queer personen in de literatuur"},{"@language":"sv","@value":"Queera personer i litteraturen"}],"rdfs:comment":[{"@language":"en","@value":"The depiction of queer people in literature."},{"@language":"nl","@value":"Het weergeven van queer personen in de literatuur."},{"@language":"sv","@value":"Skildringen av queera personer i litteraturen."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0004018"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001183"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2025-04-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004610","dc:identifier":"homoit0004610","skos:prefLabel":{"@language":"en","@value":"Queer submissives"},"skos:altLabel":{"@language":"en","@value":"Queer subs"},"rdfs:comment":{"@language":"en","@value":"Queer people who are part of the BDSM scene and assume the submissive role in sexual relationships with a dominant/submissive dynamic."},"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001318"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001184"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001295"},"dc:issued":{"@type":"xsd:date","@value":"2026-06-08"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-10"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001220","dc:identifier":"homoit0001220","skos:prefLabel":[{"@language":"en","@value":"Queer transgender people"},{"@language":"es","@value":"Personas transgénero queer"},{"@language":"nl","@value":"Queer transgender personen"},{"@language":"sv","@value":"Queera transpersoner"}],"rdfs:comment":[{"@language":"en","@value":"Queer people who identify as transgender."},{"@language":"es","@value":"Personas queer que se identifican como transgénero."},{"@language":"nl","@value":"Queer personen die zich identificeren als transgender."},{"@language":"sv","@value":"Queera personer som identifierar sig som transpersoner."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001195"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerTransgenderPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003044","dc:identifier":"homoit0003044","skos:prefLabel":[{"@language":"en","@value":"Queer college students"},{"@language":"de","@value":"Queere Hochschulstudierende"},{"@language":"es","@value":"Estudiantes universitarios queer"},{"@language":"nl","@value":"Queer studenten"},{"@language":"sv","@value":"Queera collegestudenter"}],"skos:altLabel":{"@language":"es","@value":"Universitarios queer"},"rdfs:comment":[{"@language":"en","@value":"Queer people who are attending college."},{"@language":"de","@value":"Queere Personen, die eine Hochschule besuchen. Achtung: Das US-amerikanische College entspricht nicht exakt der Hochschule im deutschen Sprachraum, wird aber häufig als Hochschule übersetzt."},{"@language":"es","@value":"Personas queer que asisten a la universidad."},{"@language":"nl","@value":"Queer personen die naar de universiteit gaan."},{"@language":"sv","@value":"Queera personer som studerar vid college."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001195"},{"@id":"https://homosaurus.org/v5/homoit0003041"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0003032"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-12-05"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003823","dc:identifier":"homoit0003823","skos:prefLabel":[{"@language":"en","@value":"Queer bodies"},{"@language":"nl","@value":"Queer bodies"},{"@language":"sv","@value":"Queera kroppar"}],"skos:altLabel":{"@language":"en","@value":"Queered bodies"},"rdfs:comment":[{"@language":"en","@value":"Bodies that resist definition by defying social norms such as heteronormativity, cisnormativity, and other forms of essentialism, regardless of the individual's identity."},{"@language":"nl","@value":"Lichamen die zich weigeren te laten definiëren door het verwerpen van sociale normen zoals heteronormativiteit, cisnormativiteit en andere vormen van essentialisme, ongeacht de identiteit van het individu."},{"@language":"sv","@value":"Kroppar som undandrar sig definition genom att trotsa samhälleliga normer som heteronormativitet, cisnormativitet och annan essentialism – oavsett individens identitet."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001219"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001195"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001365"},"dc:issued":{"@type":"xsd:date","@value":"2024-12-12"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002611","dc:identifier":"homoit0002611","skos:prefLabel":[{"@language":"en","@value":"Queer erotic art "},{"@language":"es","@value":"Arte erótico queer"},{"@language":"nl","@value":"Queer erotische kunst"},{"@language":"sv","@value":"Queer erotisk konst"}],"rdfs:comment":[{"@language":"en","@value":"Erotic art, created by queer artists, depicting queer people, or that are regarded as important within queer culture."},{"@language":"es","@value":"Arte erótico, creado por artistas queer, que representa a personas queer, o personas consideradas importantes dentro de la cultura queer."},{"@language":"nl","@value":"Erotische kunst, gemaakt door queerkunstenaars, die queer personen uitbeeldt, of die binnen de queercultuur als belangrijk wordt beschouwd."},{"@language":"sv","@value":"Erotisk konst skapad av konstnärer som är queera, som avbildar queera personer eller som anses betydelsefull inom queerkulturen."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002579"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0001199"},{"@id":"https://homosaurus.org/v5/homoit0002550"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0002601"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002550","dc:identifier":"homoit0002550","skos:prefLabel":[{"@language":"en","@value":"Queer erotic films"},{"@language":"es","@value":"Películas eróticas queer"},{"@language":"de","@value":"Queere erotische Filme"},{"@language":"nl","@value":"Queer erotische films"},{"@language":"sv","@value":"Queer erotisk film"}],"skos:altLabel":{"@language":"de","@value":"Erotische queere Filme"},"rdfs:comment":[{"@language":"en","@value":"Erotic films or movies, created by queer directors, depicting queer people, or that are regarded as important within queer culture."},{"@language":"es","@value":"Filmes o películas eróticas, creadas por directores queer, que representan a personas queer o a personas consideradas importantes dentro de la cultura queer."},{"@language":"de","@value":"Erotische Filme von queeren Künstler:innen, die queere Personen darstellen oder als wichtig innerhalb der queeren Kultur angesehen werden."},{"@language":"nl","@value":"Erotische films, gemaakt door queer-regisseurs, waarin queer-personen worden afgebeeld, of die binnen de queer-cultuur als belangrijk worden beschouwd."},{"@language":"sv","@value":"Erotiska filmer, skapade av queera regissörer, som skildrar queera personer eller som betraktas som betydelsefulla inom queer kultur."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0002544"},{"@id":"https://homosaurus.org/v5/homoit0002611"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001199"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-12"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004627","dc:identifier":"homoit0004627","skos:prefLabel":{"@language":"en","@value":"Queer personals"},"skos:altLabel":[{"@language":"en","@value":"Queer personal ads"},{"@language":"en","@value":"Queer personal advertisements"}],"rdfs:comment":{"@language":"en","@value":"A form of classified advertising for queer people interested in seeking connections around sex, romance, and/or community. The content of these ads focus largely on the type of arrangement sought and details or criteria about the writer and the type of person they are looking for (e.g. personality traits, physical looks, etc.). While queer personals are most commonly thought of as existing in print media, they also have existed online in spaces such as Craigslist."},"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0004621"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001205"},{"@id":"https://homosaurus.org/v5/homoit0001200"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0004621"},"dc:issued":{"@type":"xsd:date","@value":"2026-06-08"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-08"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001201","dc:identifier":"homoit0001201","skos:prefLabel":[{"@language":"en","@value":"Queer sex workers"},{"@language":"es","@value":"Trabajadores sexuales queer"},{"@language":"nl","@value":"Queer sekswerkers"},{"@language":"sv","@value":"Queera sexarbetare"}],"skos:altLabel":[{"@language":"en","@value":"Queer prostitutes"},{"@language":"en","@value":"Queer prostitution"},{"@language":"en","@value":"Queer sex work"},{"@language":"es","@value":"Prostitutxs queer"},{"@language":"es","@value":"Prostitutos queer"},{"@language":"es","@value":"Prostitutas queer"},{"@language":"es","@value":"Trabajo sexual queer"},{"@language":"nl","@value":"Queer prostitué(e)s"},{"@language":"nl","@value":"Queer sekswerk"}],"rdfs:comment":[{"@language":"en","@value":"Queer people who receive money or goods in exchange for sexual services, performances, or companionship. Use to describe queer people working across the broad spectrum of sex work."},{"@language":"es","@value":"Personas queer que reciben dinero o bienes a cambio de servicios o actuaciones sexuales. Se utiliza para describir a las personas queer que trabajan en el amplio espectro del trabajo sexual."},{"@language":"nl","@value":"Queer personen die geld of goederen ontvangen in ruil voor seksuele diensten, optredens of gezelschap. Wordt gebruikt om queer personen te beschrijven die in het brede spectrum van sekswerk werken."},{"@language":"sv","@value":"Queera personer som tar emot pengar eller varor i utbyte mot sexuella handlingar, framträdanden eller sällskap. Vissa anser termen sexarbetare som kränkade och politiserad, medan andra identifierar sig med den. Se även \"Queera personer i prostitution"}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001277"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0003758"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerProstitutes"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001204","dc:identifier":"homoit0001204","skos:prefLabel":[{"@language":"en","@value":"Queer radio"},{"@language":"es","@value":"Radio queer"},{"@language":"nl","@value":"Queer radio"},{"@language":"sv","@value":"Queer radio"}],"rdfs:comment":[{"@language":"en","@value":"Auditory content broadcast on the radio (analog or digital) about queer people and queer issues."},{"@language":"es","@value":"Contenido auditivos difundido por radio (analógica o digital) sobre personas y asuntos queer."},{"@language":"nl","@value":"Auditieve inhoud uitgezonden op de radio (analoog of digitaal) over queer personen en queer kwesties."},{"@language":"sv","@value":"Ljudinnehåll som sänds i radio, analog eller digital, och som handlar om queera personer eller queera frågor"}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001231"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0004322"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001231"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerRadio"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004322","dc:identifier":"homoit0004322","skos:prefLabel":[{"@language":"en","@value":"Queer podcasts"},{"@language":"nl","@value":"Queer podcasts"},{"@language":"sv","@value":"Queera poddar"}],"skos:altLabel":{"@language":"sv","@value":"Queera podcaster"},"rdfs:comment":[{"@language":"en","@value":"A recorded series (primarily in audio, but sometimes with a video component) with recurring hosts that feature content about queer people and/or queer issues and that are available digitally for streaming or download. Podcasts are typically episodic and may feature different guests."},{"@language":"nl","@value":"Een opgenomen serie (voornamelijk audio, maar soms met een video-onderdeel) met terugkerende presentatoren die content presenteren over queer personen en/of queer thema's en die digitaal beschikbaar zijn om te streamen of te downloaden. Podcasts bestaan ​​doorgaans uit afleveringen en kunnen verschillende gasten hebben."},{"@language":"sv","@value":"Inspelade radioprogram (inslag av video kan förekomma) med återkommande programledare och innehåll om/för queera personer och/eller queera frågor som är digitalt tillgängliga genom streaming eller nedladdning. Poddar är vanligen uppdelade i episoder och kan ha olika gäster."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0004317"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001204"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0004317"},"dc:issued":{"@type":"xsd:date","@value":"2026-02-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001207","dc:identifier":"homoit0001207","skos:prefLabel":[{"@language":"en","@value":"Queer Roman Catholics"},{"@language":"es","@value":"Personas católico romanas queer"},{"@language":"nl","@value":"Roomskatholieke queer personen"},{"@language":"sv","@value":"Romersk-katolska queera personer"}],"skos:altLabel":{"@language":"es","@value":"Católicos romanos queer"},"rdfs:comment":[{"@language":"en","@value":"Queer people who are members of the Roman Catholic Church."},{"@language":"es","@value":"Personas queer que son miembros de la Iglesia católica romana."},{"@language":"nl","@value":"Queer personen die lid zijn van de rooms-katholieke kerk."},{"@language":"sv","@value":"Queera personer som är medlemmar i den romersk-katolska kyrkan."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001244"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000928"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerRomanCatholics"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001208","dc:identifier":"homoit0001208","skos:prefLabel":[{"@language":"en","@value":"Queer slang"},{"@language":"es","@value":"Jerga queer"},{"@language":"nl","@value":"Queer taal"},{"@language":"sv","@value":"Queer slang"}],"skos:altLabel":{"@language":"es","@value":"Argot queer"},"rdfs:comment":[{"@language":"en","@value":"Colloquial or informal language related to queer people or used by queer people."},{"@language":"es","@value":"Lenguaje coloquial o informal relacionado con personas queer o utilizado por personas queer."},{"@language":"nl","@value":"Omgangstaal of informele taal met betrekking tot of gebruikt door queer personen."},{"@language":"sv","@value":"Vardagligt eller informellt språkbruk relaterat till queerhet eller som används av queera personer."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001317"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001559"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001317"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerSlang"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001209","dc:identifier":"homoit0001209","skos:prefLabel":[{"@language":"en","@value":"Queer sons"},{"@language":"es","@value":"Hijos queer"},{"@language":"fr","@value":"Fils queers"},{"@language":"nl","@value":"Queer zonen"},{"@language":"sv","@value":"Queera söner"}],"rdfs:comment":[{"@language":"en","@value":"Sons who identify as queer."},{"@language":"es","@value":"Hijos que se identifican como queer."},{"@language":"fr","@value":"Fils qui s'identifient comme queers."},{"@language":"nl","@value":"Zonen die zich identificeren als queer."},{"@language":"sv","@value":"Söner som identifierar sig som queera."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001329"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerSons"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002849","dc:identifier":"homoit0002849","skos:prefLabel":[{"@language":"en","@value":"Asexual studies"},{"@language":"es","@value":"Estudios asexuales"},{"@language":"de","@value":"Asexual Studies"},{"@language":"nl","@value":"Aseksuele studies"},{"@language":"sv","@value":"Asexualitetsstudier"}],"skos:altLabel":[{"@language":"de","@value":"Ace Studien"},{"@language":"de","@value":"Asexualitätsstudien"},{"@language":"de","@value":"Asexeuelle Forschung"},{"@language":"de","@value":"Asexualitätsforschung"},{"@language":"sv","@value":"Ace-studier"}],"rdfs:comment":[{"@language":"en","@value":"Academic field of research and study about asexual people, asexual identity, and asexual communities."},{"@language":"es","@value":"Campo académico de investigación y estudio sobre las personas asexuales, la identidad asexual y las comunidades asexuales."},{"@language":"de","@value":"Akademischer Forschungs- und Studienbereich über asexuelle Personen, asexuelle Identität und asexuelle Gemeinschaften."},{"@language":"nl","@value":"Academisch onderzoeks- en studiegebied over aseksuele personen, aseksuele identiteit en aseksuele gemeenschappen. ​"},{"@language":"sv","@value":"Akademiskt forskningsfält om asexuella personer, asexuell identitet och asexuella gemenskaper."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0004430"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001210"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0004430"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001211","dc:identifier":"homoit0001211","skos:prefLabel":[{"@language":"en","@value":"Queer survivors of hate crimes"},{"@language":"es","@value":"Sobrevivientes queer de crímenes de odio"},{"@language":"fr","@value":"Personnes queers survivantes de crimes haineux"},{"@language":"nl","@value":"Queer overlevenden van haatmisdrijven"},{"@language":"sv","@value":"Queera hatbrottöverlevare"}],"rdfs:comment":[{"@language":"en","@value":"Queer people who have experienced and survived hate crimes; follow the individual's preference for \"victims\" or \"survivors\" whenever possible."},{"@language":"es","@value":"Personas queer que han sufrido y sobrevivido crímenes de odio; siga la preferencia de la persona sobre el uso de \"víctimas\" o \"sobrevivientes\" siempre que sea posible."},{"@language":"fr","@value":"Personnes queers qui ont été victimes de crimes haineux et qui ont survécu; respecter la préférence de la personne concernée entre les termes « victimes » ou « survivantes » dans la mesure du possible."},{"@language":"nl","@value":"Queer personen die haatmisdrijven hebben meegemaakt en overleefd; volg waar mogelijk de voorkeur van het individu voor \"slachtoffers\" of \"overlevenden\"."},{"@language":"sv","@value":"Queera personer som har upplevt hatbrott och som har överlevt. Följ individens preferens för att använda ”offer” eller ”överlevare” när det är möjligt."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001221"},{"@id":"https://homosaurus.org/v5/homoit0001349"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerSurvivorsOfHateCrimes"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001212","dc:identifier":"homoit0001212","skos:prefLabel":[{"@language":"en","@value":"Queer survivors of rape"},{"@language":"es","@value":"Sobrevivientes queer de violación"},{"@language":"fr","@value":"Personnes queers survivantes de viol"},{"@language":"nl","@value":"Queer overlevenden van verkrachting"},{"@language":"sv","@value":"Queera våldtäktsöverlevare"}],"rdfs:comment":[{"@language":"en","@value":"Queer people who have experienced and survived rape; follow the individual's preference for \"victims\" or \"survivors\" whenever possible."},{"@language":"es","@value":"Personas queer que han sufrido y sobrevivido una violación; siga la preferencia de la persona sobre el uso de \"víctimas\" o \"sobrevivientes\" siempre que sea posible."},{"@language":"fr","@value":"Personnes queers qui ont été victimes de viol et qui ont survécu; respecter la préférence de la personne concernée entre les termes « victimes » ou « survivantes » dans la mesure du possible."},{"@language":"nl","@value":"Queer personen die verkrachting hebben meegemaakt en overleefd; volg waar mogelijk de voorkeur van het individu voor \"slachtoffers\" of \"overlevenden\"."},{"@language":"sv","@value":"Queera personer som har upplevt våldtäkt och som har överlevt. Följ individens preferens för att använda ”offer” eller ”överlevare” när det är möjligt."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001222"},{"@id":"https://homosaurus.org/v5/homoit0001350"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerSurvivorsOfRape"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001213","dc:identifier":"homoit0001213","skos:prefLabel":[{"@language":"en","@value":"Queer survivors of sexual abuse"},{"@language":"es","@value":"Sobrevivientes queer de abuso sexual"},{"@language":"fr","@value":"Personnes queers survivantes d'abus sexuels"},{"@language":"nl","@value":"Queer overlevenden van seksueel misbruik"},{"@language":"sv","@value":"Queera personer som överlevt sexuella övergrepp"}],"skos:altLabel":[{"@language":"fr","@value":"Personnes queers survivantes de violences sexuelles"},{"@language":"fr","@value":"Personnes queers survivantes d'agressions sexuelles"}],"rdfs:comment":[{"@language":"en","@value":"Queer people who have experienced and survived sexual abuse; follow the individual's preference for \"victims\" or \"survivors\" whenever possible."},{"@language":"es","@value":"Personas queer que han sufrido y sobrevivido abuso sexual; siga la preferencia de la persona sobre el uso de \"víctimas\" o \"sobrevivientes\" siempre que sea posible."},{"@language":"fr","@value":"Personnes queers ayant vécu de l'abus sexuel et qui ont survécu; respecter la préférence de la personne concernée entre les termes « victimes » ou « survivantes » dans la mesure du possible."},{"@language":"nl","@value":"Queer personen die seksueel misbruik hebben meegemaakt en overleefd; volg waar mogelijk de voorkeur van het individu voor \"slachtoffers\" of \"overlevenden\"."},{"@language":"sv","@value":"Queera personer som har utsatts för och överlevt sexuella övergrepp. Följ individens preferens för att använda ”offer” eller ”överlevare” när det är möjligt."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001223"},{"@id":"https://homosaurus.org/v5/homoit0001351"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerSurvivorsOfSexualAbuse"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001214","dc:identifier":"homoit0001214","skos:prefLabel":[{"@language":"en","@value":"Queer survivors of war"},{"@language":"es","@value":"Sobrevivientes queer de guerra"},{"@language":"fr","@value":"Personnes queers survivantes de guerre"},{"@language":"nl","@value":"Queer oorlogsoverlevenden"},{"@language":"sv","@value":"Queera krigsöverlevare"}],"rdfs:comment":[{"@language":"en","@value":"Queer people who have experienced and survived war; follow the individual's preference for \"victims\" or \"survivors\" whenever possible."},{"@language":"es","@value":"Personas queer que han sufrido y sobrevivido la guerra; siga la preferencia de la persona sobre el uso de \"víctimas\" o \"sobrevivientes\" siempre que sea posible."},{"@language":"fr","@value":"Personnes queers ayant vécu et survécu à la guerre; respecter la préférence de la personne concernée entre les termes « victimes » ou « survivantes » dans la mesure du possible."},{"@language":"nl","@value":"Queer personen die oorlog hebben meegemaakt en overleefd; volg waar mogelijk de voorkeur van het individu voor \"slachtoffers\" of \"overlevenden\"."},{"@language":"sv","@value":"Queera personer som har upplevt krig och som har överlevt. Följ individens preferens för att använda ”offer” eller ”överlevare” när det är möjligt."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001224"},{"@id":"https://homosaurus.org/v5/homoit0001352"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerSurvivorsOfWar"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001228","dc:identifier":"homoit0001228","skos:prefLabel":[{"@language":"en","@value":"Queer youth literature"},{"@language":"es","@value":"Literatura juvenil queer"},{"@language":"nl","@value":"Queer jeugdliteratuur"},{"@language":"sv","@value":"Queer ungdomslitteratur"}],"rdfs:comment":[{"@language":"en","@value":"Written literary works for an audience of readers from 12-18 years of age, also known as young adult literature or YA; use in reference to youth literature focusing on queer characters or themes."},{"@language":"es","@value":"Obras literarias escritas para una audiencia de lectores de 12 a 18 años de edad, también conocidas como literatura para adultos jóvenes o YA (por sus siglas en inglés); utilícese en referencia a la literatura juvenil que se centra en personajes o temas queer."},{"@language":"nl","@value":"Geschreven literaire werken voor een lezerspubliek van 12-18 jaar, ook wel young adult literatuur of YA genoemd; gebruik in verwijzing naar jeugdliteratuur gericht op queer personages of thema's."},{"@language":"sv","@value":"Litterära verk för läsare mellan 12 och 18 år, även kallat YA. Används för ungdomslitteratur med fokus på queera karaktärer eller teman."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001522"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001215"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerYouthLiterature"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001216","dc:identifier":"homoit0001216","skos:prefLabel":[{"@language":"en","@value":"Queer television"},{"@language":"es","@value":"Televisión queer"},{"@language":"nl","@value":"Queer televisie"},{"@language":"sv","@value":"Queera tv-program"}],"rdfs:comment":[{"@language":"en","@value":"Television shows featuring queer people or queer themes."},{"@language":"es","@value":"Programas de televisión que presentan a personas queer o temas queer."},{"@language":"nl","@value":"Televisieprogramma's met queer personen of queer thema's."},{"@language":"sv","@value":"Tv-program med queera personer eller queera teman."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001359"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001359"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerTelevision"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001217","dc:identifier":"homoit0001217","skos:prefLabel":[{"@language":"en-us","@value":"Queer theater"},{"@language":"es","@value":"Teatro queer"},{"@language":"nl","@value":"Queer theater"},{"@language":"sv","@value":"Queer teater"},{"@language":"en-gb","@value":"Queer theatre"}],"skos:altLabel":{"@language":"es","@value":"Drama queer"},"rdfs:comment":[{"@language":"en","@value":"Works in the performance arts that focus on queer characters, communities, or issues."},{"@language":"es","@value":"Obras en las artes escénicas que se centran en personajes, comunidades o cuestiones queer."},{"@language":"nl","@value":"Uitvoeringen in de podiumkunsten die zich richten op queer personages, gemeenschappen of kwesties."},{"@language":"sv","@value":"Scenkonstverk som fokuserar på queera karaktärer, gemenskaper eller frågor."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001363"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001363"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerTheatre"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003614","dc:identifier":"homoit0003614","skos:prefLabel":[{"@language":"en","@value":"Queer architecture"},{"@language":"nl","@value":"Queer architectuur"},{"@language":"sv","@value":"Queer arkitektur"}],"skos:altLabel":{"@language":"en","@value":"Queer design"},"rdfs:comment":[{"@language":"en","@value":"A school of architecture that seeks to create spaces that critique normative conceptions of gender and sexuality."},{"@language":"nl","@value":"Een architectuurschool die ruimtes wil creëren die kritiek leveren op normatieve opvattingen over gender en seksualiteit."},{"@language":"sv","@value":"En arkitekturteoriinriktning som strävar efter att skapa rum som ifrågasätter normativa föreställningar om kön och sexualitet."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0002601"},{"@id":"https://homosaurus.org/v5/homoit0001219"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0004487"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-22"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003615","dc:identifier":"homoit0003615","skos:prefLabel":[{"@language":"en","@value":"Queer ecology"},{"@language":"nl","@value":"Queer ecologie"},{"@language":"sv","@value":"Queerekologi"}],"skos:altLabel":{"@language":"en","@value":"Queer ecologies"},"rdfs:comment":[{"@language":"en","@value":"A school of ecology that seeks to understand nature, biology, and sexuality through the framing of queer theory. Queer ecology rejects the presumption of heterosexuality and cisgenderedness as natural, as well as notions of human exceptionalism and anthropocentrism."},{"@language":"nl","@value":"Een ecologische school die probeert de natuur, biologie en seksualiteit te begrijpen door middel van het kader van queer theory. Queer ecologie verwerpt de veronderstelling van heteroseksualiteit en cisgenderheid als natuurlijk, evenals noties van menselijk exceptionalisme en antropocentrisme."},{"@language":"sv","@value":"Teoretisk inriktning inom ekologin som tolkar natur, biologi och sexualitet genom queer teori. Queer ekologi förkastar föreställningar om heterosexualitet och cisnormativitet som naturliga samt idéer om mänsklig exceptionalism och antropocentrism."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001219"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001365"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-22"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003707","dc:identifier":"homoit0003707","skos:prefLabel":[{"@language":"en","@value":"Decolonial queer theory"},{"@language":"nl","@value":"Dekoloniale queer theory"},{"@language":"sv","@value":"Dekolonial queerteori"}],"skos:altLabel":[{"@language":"en","@value":"Queer decoloniality"},{"@language":"en","@value":"Postcolonial queer theory"},{"@language":"en","@value":"Queer decolonial theory"},{"@language":"en","@value":"Queer postcolonial theory"},{"@language":"nl","@value":"Queer dekoloniale theorie"},{"@language":"nl","@value":"Queer postkoloniale theorie"}],"rdfs:comment":[{"@language":"en","@value":"The intersection of decolonial and queer theory, which critiques Eurocentric conceptions of gender and sexuality as a tool of colonization."},{"@language":"nl","@value":"Het snijpunt van dekoloniale en queer theory, die kritiek levert op eurocentrische opvattingen over gender en seksualiteit als instrument van kolonisatie."},{"@language":"sv","@value":"Skärningspunkten mellan dekolonial teori och queerteori, som kritiserar eurocentriska uppfattningar om kön och sexualitet som ett kolonialt verktyg."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001219"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001365"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003987","dc:identifier":"homoit0003987","skos:prefLabel":[{"@language":"en","@value":"Queer time"},{"@language":"nl","@value":"Queer tijd"},{"@language":"sv","@value":"Queer-tid"}],"skos:altLabel":[{"@language":"en","@value":"Queer temporality"},{"@language":"nl","@value":"Queer time"},{"@language":"sv","@value":"Queer tid"}],"rdfs:comment":[{"@language":"en","@value":"Term used to describe the ways in which queer people experience and relate to time differently than is socially expected. This may include delayed or non-linear development before coming out, disrupted life trajectories, and a sense of impending mortality, particularly during the AIDS epidemic. "},{"@language":"nl","@value":"Term die gebruikt wordt om de manieren te beschrijven waarop queer personen tijd anders ervaren en ermee omgaan dan sociaal verwacht. Dit kan onder meer een vertraagde of niet-lineaire ontwikkeling vóór hun coming-out, verstoorde levenspaden en een gevoel van naderende sterfelijkheid omvatten, met name tijdens de aidsepidemie."},{"@language":"sv","@value":"Term som används för att beskriva hur queera personer upplever och förhåller sig till tid på ett annat sätt än vad som förväntas enligt sociala normer. Detta kan inkludera försenad eller icke-linjär utveckling innan de kommer ut, splittrade livsbanor och en känsla av förestående dödlighet, särskilt under aidsepidemin."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001219"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0003985"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001365"},"dc:issued":{"@type":"xsd:date","@value":"2025-04-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001225","dc:identifier":"homoit0001225","skos:prefLabel":[{"@language":"en","@value":"Queer victims' rights"},{"@language":"es","@value":"Derechos de víctimas queer"},{"@language":"nl","@value":"Slachtofferrechten voor queer personen"},{"@language":"sv","@value":"Queera brottsoffers rättigheter"}],"rdfs:comment":[{"@language":"en","@value":"Queer people’s legal rights to be informed, present, and heard within the criminal justice system after having been harmed or injured as the result of a crime, accident, or other event."},{"@language":"es","@value":"Los derechos legales de las personas queer a estar informadas, estar presentes y ser escuchadas dentro del sistema de justicia penal después de haber sido perjudicadas o lesionadas como resultado de un delito, accidente u otro evento."},{"@language":"nl","@value":"De wettelijke rechten van queer personen om te worden geïnformeerd, aanwezig te zijn en gehoord te worden binnen het strafrechtsysteem nadat ze zijn geschaad of gewond zijn geraakt als gevolg van een misdrijf, ongeval of andere gebeurtenis."},{"@language":"sv","@value":"Queera personers juridiska rättigheter som brottsoffer att få information, närvara och komma till tals inom rättsväsendet efter att ha utsatts för brott, olycka eller annan händelse som orsakat skada."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001492"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000702"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerVictimsRights"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002594","dc:identifier":"homoit0002594","skos:prefLabel":[{"@language":"en","@value":"Internalized queerphobia"},{"@language":"es","@value":"Queerfobia internalizada"},{"@language":"nl","@value":"Geïnternaliseerde queerfobie"},{"@language":"sv","@value":"Internaliserad queerfobi"}],"rdfs:comment":[{"@language":"en","@value":"The phenomenon in which queer people internalize or adopt queerphobic beliefs (i.e., negative perceptions of and intolerance toward queer people and queerness) as a result of being raised or socialized within a queerphobic environment or culture."},{"@language":"es","@value":"El fenómeno a través del cual personas queer internalizan o adoptan creencias queerfóbicas (es decir, percepciones negativas e intolerancia hacia las personas queer y la identidad queer) como resultado de haber sido criadas o socializadas dentro de un entorno o una cultura lesbofóbica."},{"@language":"nl","@value":"Het fenomeen waarbij queer personen queerfobe overtuigingen internaliseren of overnemen (d.w.z. negatieve percepties van en intolerantie jegens queer personen en queerheid) als gevolg van het feit dat ze zijn opgegroeid of gesocialiseerd in een queerfobe omgeving of cultuur. ​"},{"@language":"sv","@value":"Företeelsen att queera personer internaliserar eller anammar queerfobiska föreställningar – det vill säga negativa uppfattningar om och intolerans mot queera personer och queerness – till följd av att ha vuxit upp eller socialiserats i en queerfobisk miljö eller kultur."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001229"},{"@id":"https://homosaurus.org/v5/homoit0002590"}],"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0003096"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000920"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001441","dc:identifier":"homoit0001441","skos:prefLabel":[{"@language":"en","@value":"Transgender radio"},{"@language":"es","@value":"Radio transgénero"},{"@language":"nl","@value":"Transgender radio"},{"@language":"sv","@value":"Transradio"}],"skos:altLabel":{"@language":"es","@value":"Radio trans"},"rdfs:comment":[{"@language":"en","@value":"Auditory content broadcast on the radio (analog or digital) about transgender people and transgender issues."},{"@language":"es","@value":"Contenidos auditivos transmitidos por radio (analógica o digital) sobre personas transgénero y asuntos transgénero."},{"@language":"nl","@value":"Auditieve inhoud uitgezonden op de radio (analoog of digitaal) over transgender personen en transgender kwesties."},{"@language":"sv","@value":"Ljudinnehåll som sänds i radio, analog eller digital, och som handlar om transpersoner eller transfrågor."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001231"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0004321"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001231"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transgenderRadio"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002806","dc:identifier":"homoit0002806","skos:prefLabel":[{"@language":"en","@value":"Asexual radio"},{"@language":"es","@value":"Radio asexual"},{"@language":"de","@value":"Asexuelles Radio"},{"@language":"nl","@value":"Aseksuele radio"},{"@language":"sv","@value":"Asexuell radio"}],"skos:altLabel":[{"@language":"de","@value":"Ace Radio"},{"@language":"sv","@value":"Ace-radio"}],"rdfs:comment":[{"@language":"en","@value":"Auditory content broadcast on the radio (analog or digital) about asexual people and asexual issues."},{"@language":"es","@value":"Contenido auditivo emitido por radio (análoga o digital) sobre personas asexuales y asuntos asexuales."},{"@language":"de","@value":"Im Radio ausgestrahlte hörbare Inhalte (analog oder digital) über asexuelle Personen und asexuelle Themen."},{"@language":"nl","@value":"Auditieve inhoud uitgezonden op de radio (analoog of digitaal) over aseksuele personen en aseksuele kwesties."},{"@language":"sv","@value":"Ljudinnehåll som sänds i radio, analog eller digital, och som handlar om asexuella personer eller asexuella frågor."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001231"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0004324"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001231"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002938","dc:identifier":"homoit0002938","skos:prefLabel":[{"@language":"en","@value":"Intersex radio"},{"@language":"de","@value":"Inter* Radio"},{"@language":"es","@value":"Radio intersexual"},{"@language":"nl","@value":"Intersekse radio"},{"@language":"sv","@value":"Intersexradio"}],"skos:altLabel":{"@language":"es","@value":"Radio intersex"},"rdfs:comment":[{"@language":"en","@value":"Auditory content broadcast on the radio (analog or digital) about intersex people and intersex issues."},{"@language":"de","@value":"Im Radio ausgestrahlte hörbare Inhalte (analog oder digital) über inter* Personen und inter* Themen."},{"@language":"es","@value":"Contenido auditivo difundido por radio (analógica o digital) sobre personas intersex y asuntos intersex."},{"@language":"nl","@value":"Auditieve inhoud uitgezonden op de radio (analoog of digitaal) over intersekse personen en intersekse kwesties."},{"@language":"sv","@value":"Ljudinnehåll som sänds i radio, analog eller digital, och som handlar om intersexpersoner eller intersexfrågor."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001231"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001231"},"dc:issued":{"@type":"xsd:date","@value":"2023-09-29"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002721","dc:identifier":"homoit0002721","skos:prefLabel":[{"@language":"en","@value":"Two-Spirit radio"},{"@language":"es","@value":"Radio dos espíritus"},{"@language":"nl","@value":"Two-Spirit radio"},{"@language":"sv","@value":"Two-spirit-radio"}],"skos:altLabel":[{"@language":"en","@value":"2S radio"},{"@language":"en","@value":"Two Spirit radio"},{"@language":"en","@value":"Two Spirited radio"},{"@language":"en","@value":"Two-Spirited radio"}],"rdfs:comment":[{"@language":"en","@value":"Auditory content broadcast on the radio (analog or digital) about Two-Spirit people and Two-Spirit issues."},{"@language":"es","@value":"Contenido auditivo emitido por radio (análoga o digital) sobre personas dos espíritus y asuntos dos espíritus."},{"@language":"nl","@value":"Auditieve inhoud die op de radio wordt uitgezonden (analoog of digitaal) over Two-Spirit people en Two-Spirit issues."},{"@language":"sv","@value":"Ljudinnehåll som sänds i radio, analog eller digital, och som handlar om Two-spirit-personer eller Two-spirit-frågor."}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001231"},{"@id":"https://homosaurus.org/v5/homoit0004325"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0002721"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-27"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004317","dc:identifier":"homoit0004317","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ podcasts"},{"@language":"nl","@value":"LHBTQ+-podcasts"},{"@language":"sv","@value":"Hbtq+-poddar"}],"skos:altLabel":[{"@language":"en","@value":"Podcasts (LGBTQ)"},{"@language":"sv","@value":"Hbtq+-podcaster"}],"rdfs:comment":[{"@language":"en","@value":"A recorded series (primarily in audio, but sometimes with a video component) with recurring hosts that feature content about LGBTQ+ people and/or LGBTQ+ issues and that are available digitally for streaming or download. Podcasts are typically episodic and may feature different guests."},{"@language":"nl","@value":"Een opgenomen serie (voornamelijk audio, maar soms met een video-onderdeel) met terugkerende presentatoren die content presenteren over LHBTQ+-personen en/of LHBTQ+-thema's en die digitaal beschikbaar zijn om te streamen of te downloaden. Podcasts bestaan ​​doorgaans uit afleveringen en kunnen verschillende gasten hebben."},{"@language":"sv","@value":"Inspelade radioprogram (inslag av video kan förekomma) med återkommande programledare och innehåll om/för hbtq+-personer och/eller hbtq+-frågor som är digitalt tillgängliga genom streaming eller nedladdning. Poddar är vanligen uppdelade i episoder och kan ha olika gäster."}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0004318"},{"@id":"https://homosaurus.org/v5/homoit0004319"},{"@id":"https://homosaurus.org/v5/homoit0004320"},{"@id":"https://homosaurus.org/v5/homoit0004321"},{"@id":"https://homosaurus.org/v5/homoit0004322"},{"@id":"https://homosaurus.org/v5/homoit0004323"},{"@id":"https://homosaurus.org/v5/homoit0004324"},{"@id":"https://homosaurus.org/v5/homoit0004326"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001231"},{"@id":"https://homosaurus.org/v5/homoit0001983"},{"@id":"https://homosaurus.org/v5/homoit0004325"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0004317"},"dc:issued":{"@type":"xsd:date","@value":"2026-02-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001232","dc:identifier":"homoit0001232","skos:prefLabel":[{"@language":"en","@value":"Rainbow flags"},{"@language":"es","@value":"Banderas arcoíris"},{"@language":"nl","@value":"Regenboogvlaggen"},{"@language":"sv","@value":"Regnbågsflaggor"}],"skos:altLabel":{"@language":"en","@value":"Baker flags"},"rdfs:comment":[{"@language":"en","@value":"Rainbow-striped flags that symbolize LGBTQ+ pride and LGBTQ+ social movements. The first rainbow pride flag, which had eight colors, was created by Gilbert Baker, Lynn Segerblom, and others in San Francisco, California in 1978. Due to difficulties obtaining hot pink fabric and a desire for an even number of stripes, Baker modified his design in 1979 to contain six colors. The six-color version of the flag has been the most popular design since then."},{"@language":"es","@value":"Banderas con franjas arcoíris que simbolizan el orgullo LGBTQ+ y los movimientos sociales LGBTQ+. La primera bandera arcoíris de orgullo fue creada por Gilbert Baker en 1978."},{"@language":"nl","@value":"Regenboog-gestreepte vlaggen die LHBTQ+-pride en LHBTQ+-sociale bewegingen symboliseren. De eerste regenboog pride vlag, die acht kleuren had, werd in 1978 gemaakt door Gilbert Baker, Lynn Segerblom en anderen in San Francisco, Californië. Vanwege de moeilijkheden om felroze stof te verkrijgen en een verlangen naar een even aantal strepen, paste Baker zijn ontwerp in 1979 aan zodat het zes kleuren bevatte. De zeskleurige versie van de vlag is sindsdien het populairste ontwerp."},{"@language":"sv","@value":"Regnbågsflaggor som symboliserar hbtq+-stolthet och sociala rörelser. Den första regnbågsflaggan skapades 1978 i San Francisco. Den mest spridda versionen har sex färger och har använts sedan 1979."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0003246"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000954"},"dc:replaces":{"@id":"http://homosaurus.org/v2/rainbowFlags"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004227","dc:identifier":"homoit0004227","skos:prefLabel":[{"@language":"en","@value":"Two-Spirit people who use substances for recreational purposes"},{"@language":"nl","@value":"Two-Spirit people die middelen recreatief gebruiken"},{"@language":"sv","@value":"Two-spirit-personer som använder substanser i rekreationssyfte"}],"skos:altLabel":[{"@language":"en","@value":"Two Spirit people who use substances for recreational purposes"},{"@language":"en","@value":"Two-Spirited people who use substances for recreational purposes"},{"@language":"en","@value":"Two Spirited people who use substances for recreational purposes"},{"@language":"en","@value":"2S people who use substances for recreational purposes"}],"rdfs:comment":[{"@language":"en","@value":"Two-Spirit people who use substances (that are typically deemed harmful or are subject to legal restriction, such as drugs and alcohol) for recreational or social purposes."},{"@language":"nl","@value":"Het gebruik van middelen (die doorgaans schadelijk worden geacht of onderhevig zijn aan wettelijke beperkingen, zoals drugs of alcohol) door Two-Spirit people voor recreatieve of sociale doeleinden."},{"@language":"sv","@value":"Användning av substanser (som alkohol eller droger) av Two-spirit-personer i rekreationellt eller socialt syfte."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0004225"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0002289"},{"@id":"https://homosaurus.org/v5/homoit0001235"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2025-04-24"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002514","dc:identifier":"homoit0002514","skos:prefLabel":[{"@language":"en","@value":"Romantic relationships"},{"@language":"es","@value":"Relaciones románticas"},{"@language":"nl","@value":"Romantische relaties"},{"@language":"sv","@value":"Romantiska relationer"}],"rdfs:comment":[{"@language":"en","@value":"Ongoing connections between two or more individuals involving romantic behaviors or activities."},{"@language":"es","@value":"Conexiones continuas entre dos o más personas que involucran comportamientos o actividades románticas."},{"@language":"nl","@value":"Voortdurende verbintenissen tussen twee of meer individuen waarbij sprake is van romantisch gedrag of romantische activiteiten"},{"@language":"sv","@value":"Fortlöpande relationer mellan två eller flera personer som kännetecknas av romantiska handlingar eller engagemang."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001237"},"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85067484"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001237"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-11"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002807","dc:identifier":"homoit0002807","skos:prefLabel":[{"@language":"en","@value":"Asexual relationships"},{"@language":"es","@value":"Relaciones asexuales"},{"@language":"de","@value":"Asexuelle Beziehungen"},{"@language":"nl","@value":"Aseksuele relaties"},{"@language":"sv","@value":"Asexuella relationer"}],"skos:altLabel":[{"@language":"de","@value":"Ace Beziehungen"},{"@language":"sv","@value":"Ace-relationer"}],"rdfs:comment":[{"@language":"en","@value":"Ongoing connections (romantic, sexual, or platonic) between two or more asexual people."},{"@language":"es","@value":"Conexiones continuas (románticas, sexuales o platónicas) entre dos o más personas asexuales."},{"@language":"de","@value":"Dauerhafte Beziehungen (romantisch, sexuell oder platonisch) zwischen zwei oder mehr asexuellen Personen."},{"@language":"nl","@value":"Voortdurende verbintenissen (romantisch, seksueel of platonisch) tussen twee of meer aseksuele personen."},{"@language":"sv","@value":"Pågående relationer, romantiska, sexuella eller platoniska, mellan två eller flera asexuella personer."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001237"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0004626"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001237"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002939","dc:identifier":"homoit0002939","skos:prefLabel":[{"@language":"en","@value":"Intersex relationships"},{"@language":"de","@value":"Inter* Beziehungen"},{"@language":"es","@value":"Relaciones intersexuales"},{"@language":"nl","@value":"Intersekse relaties"},{"@language":"sv","@value":"Intersexrelationer"}],"skos:altLabel":{"@language":"es","@value":"Relaciones intersex"},"rdfs:comment":[{"@language":"en","@value":"Ongoing connections (romantic, sexual, or platonic) between two or more intersex people."},{"@language":"de","@value":"Dauerhafte Beziehungen (romantischer, sexueller oder platonischer Natur) zwischen zwei oder mehr inter* Personen."},{"@language":"es","@value":"Conexiones continuas (románticas, sexuales o platónicas) entre dos o más personas intersex."},{"@language":"nl","@value":"Voortdurende connecties (romantisch, seksueel of platonisch) tussen twee of meer intersekse personen."},{"@language":"sv","@value":"Pågående relationer, romantiska, sexuella eller platoniska, mellan två eller flera intersexpersoner."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001237"},"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0002969"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0004629"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001237"},"dc:issued":{"@type":"xsd:date","@value":"2023-09-29"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004631","dc:identifier":"homoit0004631","skos:prefLabel":{"@language":"en","@value":"Non-binary relationships"},"skos:altLabel":{"@language":"en","@value":"Nonbinary relationships"},"rdfs:comment":{"@language":"en","@value":"Ongoing connections (romantic, sexual, or platonic) between two or more non-binary people."},"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001237"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0004628"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001237"},"dc:issued":{"@type":"xsd:date","@value":"2026-06-09"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-09"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002189","dc:identifier":"homoit0002189","skos:prefLabel":[{"@language":"en","@value":"Pairings in fandom"},{"@language":"es","@value":"Parejas en fandom"},{"@language":"nl","@value":"Koppels in fandom"},{"@language":"sv","@value":"Pairings inom fandom"}],"skos:altLabel":[{"@language":"en","@value":"Fandom pairings"},{"@language":"es","@value":"Emparejamiento en fandom"},{"@language":"nl","@value":"Pairings in fandom"}],"rdfs:comment":[{"@language":"en","@value":"The relationships (primarily romantic or sexual) between characters in fanworks, including relationships that are not present within the canon text."},{"@language":"es","@value":"Las relaciones (principalmente románticas o sexuales) entre personajes de obras de fans, incluidas las relaciones que no están presentes en el texto canónico."},{"@language":"nl","@value":"De relaties (voornamelijk romantisch of seksueel) tussen personages in fanuitingen, inclusief relaties die niet aanwezig zijn in de oorspronkelijke tekst"},{"@language":"sv","@value":"Relationer, främst romantiska eller sexuella, mellan karaktärer i fanverk. Inkluderar även relationer som inte förekommer i originalmaterialet."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002199"},"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0002187"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001237"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002722","dc:identifier":"homoit0002722","skos:prefLabel":[{"@language":"en","@value":"Two-Spirit relationships"},{"@language":"es","@value":"Relaciones dos espíritus"},{"@language":"nl","@value":"Two-Spirit relaties"},{"@language":"sv","@value":"Two-spirit-relationer"}],"skos:altLabel":[{"@language":"en","@value":"2S relationships"},{"@language":"en","@value":"Two Spirit relationships"},{"@language":"en","@value":"Two Spirited relationships"},{"@language":"en","@value":"Two-Spirited relationships"}],"rdfs:comment":[{"@language":"en","@value":"Ongoing connections (romantic, sexual, or platonic) between two or more Two-Spirit people."},{"@language":"es","@value":"Conexiones continuas (románticas, sexuales o platónicas) entre dos o más personas dos espíritus."},{"@language":"nl","@value":"Voortdurende verbindtenissen (romantisch, seksueel of platonisch) tussen twee of meer Two-Spirit-people."},{"@language":"sv","@value":"Pågående relationer, romantiska, sexuella eller platoniska, mellan två eller flera Two-spirit-personer."}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001237"},{"@id":"https://homosaurus.org/v5/homoit0004630"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0002722"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-27"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004646","dc:identifier":"homoit0004646","skos:prefLabel":{"@language":"en","@value":"Jealousy in relationships"},"skos:altLabel":{"@language":"en","@value":"Relationship jealousy"},"rdfs:comment":{"@language":"en","@value":"The negative emotion an individual may experience in regards to their partner's relationship with another person, often tied to a fear of losing their relationship and feelings of insecurity and/or possessiveness."},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001237"},"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85069852"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0004646"},"dc:issued":{"@type":"xsd:date","@value":"2026-06-10"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-10"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003115","dc:identifier":"homoit0003115","skos:prefLabel":[{"@language":"en","@value":"Straitjacket"},{"@language":"es","@value":"Camisa de fuerza"},{"@language":"nl","@value":"Dwangbuizen"},{"@language":"sv","@value":"Tvångströja"}],"skos:altLabel":[{"@language":"en","@value":"Strait-jacket"},{"@language":"es","@value":"Straitjacket"},{"@language":"es","@value":"Straightjacket"}],"rdfs:comment":[{"@language":"en","@value":"A type of jacket used to restrain the upper body."},{"@language":"es","@value":"Un tipo de chaqueta utilizada para sujetar la parte superior del cuerpo."},{"@language":"nl","@value":"Een soort jas die het bovenlichaam in bedwang houdt."},{"@language":"sv","@value":"En typ av jacka som används för att begränsa överkroppens rörelseförmåga."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001238"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001266"},"dc:issued":{"@type":"xsd:date","@value":"2023-12-20"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001287","dc:identifier":"homoit0001287","skos:prefLabel":[{"@language":"en-us","@value":"Sexual behavior change"},{"@language":"es","@value":"Cambio de comportamiento sexual"},{"@language":"nl","@value":"Verandering van seksueel gedrag"},{"@language":"sv","@value":"Sexuella beteendeförändringar"},{"@language":"en-gb","@value":"Sexual behaviour change"}],"rdfs:comment":[{"@language":"en","@value":"Term used to describe changes in behavior related to safer sexual practices (e.g., condom use, STI testing)."},{"@language":"es","@value":"Término utilizado para describir cambios en el comportamiento relacionados con prácticas sexuales más seguras (por ejemplo, uso de condones, pruebas de ITS)."},{"@language":"nl","@value":"Term die wordt gebruikt om gedragsveranderingen te beschrijven die verband houden met veiligere seksuele praktijken (bijv. condoomgebruik, soa-testen)."},{"@language":"sv","@value":"Term som används för att beskriva förändringar i beteende kopplade till säkrare sexpraktiker, till exempel kondomanvändning eller testning för könssjukdomar."}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001239"},{"@id":"https://homosaurus.org/v5/homoit0001251"},{"@id":"https://homosaurus.org/v5/homoit0001300"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001287"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sexualBehaviourChange"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002165","dc:identifier":"homoit0002165","skos:prefLabel":[{"@language":"en","@value":"Furries"},{"@language":"es","@value":"Furros"},{"@language":"de","@value":"Furries"},{"@language":"nl","@value":"Furries"},{"@language":"sv","@value":"Furries"}],"skos:altLabel":{"@language":"sv","@value":"Pälsingar"},"rdfs:comment":[{"@language":"en","@value":"Individuals who are interested in anthropomorphized animals, as well as fiction and artwork featuring anthropomorphized animals. Many furries identify with anthropomorphized animal versions of themselves, which are called fursonas."},{"@language":"es","@value":"Personas interesadas en animales antropomorfizados, así como en ficción y obras de arte que presenten animales antropomorfizados. Muchos furros se autoidentifican con versiones animales antropomorfizadas de sí mismos, que se llaman \"fursonas\"."},{"@language":"de","@value":"Personen, die sich für anthropomorphisierte Tiercharaktere sowie für Fiction und Kunst mit anthropomorphisierten Tiercharakteren interessieren. Viele Furries identifizieren sich mit anthropomorphisierten Tierversionen ihrer selbst, die als Fursonas bezeichnet werden."},{"@language":"nl","@value":"Individuen die geïnteresseerd zijn in antropomorfe dieren, maar ook in fictie en kunstwerken met antropomorfe dieren. Veel furries identificeren zich met antropomorfe dierlijke versies van zichzelf, die fursonas worden genoemd"},{"@language":"sv","@value":"Personer som är intresserade av antropomorfa djur samt fiktion och konst som innehåller sådana figurer. Många furries identifierar sig med en antropomorf djurversion av sig själva, kallad en fursona."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002167"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0002168"},{"@id":"https://homosaurus.org/v5/homoit0002169"},{"@id":"https://homosaurus.org/v5/homoit0002219"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001241"},{"@id":"https://homosaurus.org/v5/homoit0001242"},{"@id":"https://homosaurus.org/v5/homoit0003082"},{"@id":"https://homosaurus.org/v5/homoit0003123"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2017004178"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002168","dc:identifier":"homoit0002168","skos:prefLabel":[{"@language":"en","@value":"Fursonas"},{"@language":"es","@value":"Fursonas"},{"@language":"de","@value":"Fursonas"},{"@language":"nl","@value":"Fursona's"},{"@language":"sv","@value":"Fursona"}],"rdfs:comment":[{"@language":"en","@value":"Anthropomorphized animal versions of people. Fursonas, which are created by members of the furry fandom, are not necessarily animals with fur; they can also be reptiles, birds, or fictional animals, for example."},{"@language":"es","@value":"Versiones animales antropomorfizadas de personas. Las fursonas, que son creadas por miembros del fandom de furros, no son necesariamente animales con pelaje; también pueden ser reptiles, pájaros o animales ficticios, por ejemplo."},{"@language":"de","@value":"Anthropomorphisierte Tierversionen von Menschen. Fursonas, die von Mitgliedern der Furry-Fangemeinde geschaffen werden, sind nicht unbedingt Tiere mit Fell; sie können beispielsweise auch Reptilien, Vögel oder fiktive Tiere sein."},{"@language":"nl","@value":"Geantropomorfiseerde dierlijke versies van mensen. Fursona's, die zijn gemaakt door leden van de harige fandom, zijn niet per se dieren met pels; het kunnen bijvoorbeeld ook reptielen, vogels of fictieve dieren zijn"},{"@language":"sv","@value":"Antropomorfa djurversioner av människor. Fursonas, som skapas av medlemmar i furry-gemenskapen, är inte nödvändigtvis djur med päls, de kan också t.ex. vara reptiler, fåglar eller fiktiva djur."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002165"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001241"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002207","dc:identifier":"homoit0002207","skos:prefLabel":[{"@language":"en","@value":"Slash roleplay"},{"@language":"es","@value":"Juego de roles slash"},{"@language":"nl","@value":"Slash rollenspel"},{"@language":"sv","@value":"Slash-rollspel"}],"skos:altLabel":[{"@language":"en","@value":"Slash role play"},{"@language":"es","@value":"Roleplay slash"}],"rdfs:comment":[{"@language":"en","@value":"The act of pretending to be and behaving as a character in a sexual or romantic relationship with another character of the same sex or gender, sometimes to generate ideas for fanworks. Typically erotic or pornographic in nature. Historically used for male-male couples only, but is now used more broadly; includes femslash roleplay."},{"@language":"es","@value":"El acto de pretender ser y comportarse como un personaje en una relación sexual o romántica con otro personaje del mismo sexo o género, a veces para generar ideas para fanworks. Normalmente de naturaleza erótica o pornográfica. Históricamente se utilizaba únicamente para parejas de hombres, pero ahora se utiliza de forma más amplia; incluye juego de rol femslash."},{"@language":"nl","@value":"De handeling van het doen alsof en zich gedragen als een personage in een seksuele of romantische relatie met een ander personage van hetzelfde geslacht of geslacht, soms om ideeën voor fanwerken te genereren. Typisch erotisch of pornografisch van aard. Van oudsher alleen gebruikt voor man-man koppels, maar wordt nu breder gebruikt; inclusief femslash-rollenspel"},{"@language":"sv","@value":"Att agera som en karaktär i en sexuell eller romantisk relation med en annan karaktär av samma kön eller könsidentitet, ibland för att utveckla idéer till fanverk. Ofta erotiskt eller pornografiskt. Termen användes historiskt för man/man-par men används nu bredare och inkluderar även femslash-rollspel."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002204"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001241"},{"@id":"https://homosaurus.org/v5/homoit0001242"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001243","dc:identifier":"homoit0001243","skos:prefLabel":[{"@language":"en","@value":"Rope play"},{"@language":"es","@value":"Juego de cuerda"},{"@language":"nl","@value":"Touwspel"},{"@language":"sv","@value":"Replekar (BDSM)"}],"skos:altLabel":[{"@language":"en","@value":"Shibari"},{"@language":"es","@value":"Shibari"},{"@language":"sv","@value":"Ropeplay"}],"rdfs:comment":[{"@language":"en","@value":"Bondage involving the use of rope for sexual stimulation."},{"@language":"es","@value":"Bondage que implica el uso de cuerdas para la estimulación sexual."},{"@language":"nl","@value":"Bondage waarbij touw wordt gebruikt voor seksuele stimulatie"},{"@language":"sv","@value":"Bondage som involverar användning av rep för sexuell stimulans."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001266"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001266"},"dc:replaces":{"@id":"http://homosaurus.org/v2/ropePlay"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001444","dc:identifier":"homoit0001444","skos:prefLabel":[{"@language":"en","@value":"Transgender Roman Catholics"},{"@language":"es","@value":"Personas católico romanas transgénero"},{"@language":"nl","@value":"Roomskatholieke transgender personen"},{"@language":"sv","@value":"Romersk-katolska transpersoner"}],"skos:altLabel":{"@language":"es","@value":"Católico romanos transgénero"},"rdfs:comment":[{"@language":"en","@value":"Transgender people who are members of the Roman Catholic Church."},{"@language":"es","@value":"Personas transgénero que son miembros de la Iglesia católica romana."},{"@language":"nl","@value":"Transgender personen die lid zijn van de rooms-katholieke kerk."},{"@language":"sv","@value":"Transpersoner som är medlemmar i romersk-katolska kyrkan."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001244"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000928"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transgenderRomanCatholics"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002986","dc:identifier":"homoit0002986","skos:prefLabel":[{"@language":"en","@value":"Asexual Roman Catholics"},{"@language":"es","@value":"Personas católicas romanas asexuales"},{"@language":"de","@value":"Asexuelle Katholik:innen"},{"@language":"nl","@value":"Roomskatholieke aseksuele personen"},{"@language":"sv","@value":"Romersk-katolska asexuella"}],"skos:altLabel":[{"@language":"es","@value":"Católicos romanos asexuales"},{"@language":"es","@value":"Católicas romanas asexuales"},{"@language":"de","@value":"Ace Katholik:innen"},{"@language":"de","@value":"Asexuelle Katholikinnen"},{"@language":"de","@value":"Asexuelle Katholiken"},{"@language":"de","@value":"Asexuelle römisch-katholische Personen"},{"@language":"de","@value":"Katholische asexuelle Personen"}],"rdfs:comment":[{"@language":"en","@value":"Asexual people who are members of the Roman Catholic Church."},{"@language":"es","@value":"Personas asexuales que son miembros de la Iglesia católica romana."},{"@language":"de","@value":"Asexuelle Personen, die Mitglieder der römisch-katholischen Kirche sind."},{"@language":"nl","@value":"Aseksuele personen die lid zijn van de rooms-katholieke kerk."},{"@language":"sv","@value":"Asexuella personer som är medlemmar i den romersk-katolska kyrkan."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001244"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000928"},"dc:issued":{"@type":"xsd:date","@value":"2023-10-27"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002987","dc:identifier":"homoit0002987","skos:prefLabel":[{"@language":"en","@value":"Intersex Roman Catholics"},{"@language":"de","@value":"Inter* Katholik:innen"},{"@language":"es","@value":"Personas católicas romanas intersexuales"},{"@language":"nl","@value":"Roomskatholieke intersekse personen"},{"@language":"sv","@value":"Romersk-katolska intersexpersoner"}],"skos:altLabel":[{"@language":"de","@value":"inter* Katholiken"},{"@language":"de","@value":"inter* Katholikinnen"},{"@language":"de","@value":"inter* römisch-katholische Personen"},{"@language":"de","@value":"Katholische inter* Personen"},{"@language":"es","@value":"Católico romanos intersex"}],"rdfs:comment":[{"@language":"en","@value":"Intersex people who are members of the Roman Catholic Church."},{"@language":"de","@value":"Inter* Personen, die Mitglieder der römisch-katholischen Kirche sind."},{"@language":"es","@value":"Personas intersex que son miembros de la Iglesia católica romana."},{"@language":"nl","@value":"Intersekse personen die lid zijn van de rooms-katholieke kerk."},{"@language":"sv","@value":"Intersexpersoner som är medlemmar i den romersk-katolska kyrkan."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001244"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000928"},"dc:issued":{"@type":"xsd:date","@value":"2023-10-27"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001248","dc:identifier":"homoit0001248","skos:prefLabel":[{"@language":"en","@value":"Rubbermen"},{"@language":"es","@value":"Rubbermen"},{"@language":"nl","@value":"Rubbermannen"},{"@language":"sv","@value":"Gummimän"}],"skos:altLabel":{"@language":"sv","@value":"Rubbermen"},"rdfs:comment":[{"@language":"en","@value":"Men who have fetishes for or engage in fetish activities involving rubber and belong to the rubber community; frequently associated with U.S. LGBTQ+ subcultures."},{"@language":"es","@value":"Hombres que tienen fetiches con o participan de actividades fetichistas relacionadas con la goma y pertenecen a la comunidad de la goma; frecuentemente asociados con las subculturas LGBTQ+ de EE. UU."},{"@language":"nl","@value":"Mannen die een fetisj hebben voor of zich bezighouden met fetisjactiviteiten waarbij rubber betrokken is en die tot de rubbergemeenschap behoren; vaak geassocieerd met LGBTQ+-subculturen."},{"@language":"sv","@value":"Män som attraheras av gummi, som utövar aktiviteter med gummi och som tillhör gummigemenskapen. Ofta kopplade till hbtq+-subkulturer i USA."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001247"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001249"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000297"},"dc:replaces":{"@id":"http://homosaurus.org/v2/rubbermen"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001249","dc:identifier":"homoit0001249","skos:prefLabel":[{"@language":"en","@value":"Rubberwomen"},{"@language":"es","@value":"Rubberwomen"},{"@language":"nl","@value":"Rubbervrouwen"},{"@language":"sv","@value":"Gummikvinnor"}],"skos:altLabel":{"@language":"sv","@value":"Rubberwomen"},"rdfs:comment":[{"@language":"en","@value":"Women who have fetishes for or engage in fetish activities involving rubber and belong to the rubber community; frequently associated with U.S. LGBTQ+ subcultures."},{"@language":"es","@value":"Mujeres que tienen fetiches con o participan de actividades fetichistas relacionadas con la goma y pertenecen a la comunidad de la goma; frecuentemente asociadas con las subculturas LGBTQ+ de EE. UU."},{"@language":"sv","@value":"Kvinnor som attraheras av gummi, som utövar aktiviteter med gummi och som tillhör gummigemenskapen. Ofta kopplade till hbtq+-subkulturer i USA."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001247"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001248"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000297"},"dc:replaces":{"@id":"http://homosaurus.org/v2/rubberwomen"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001252","dc:identifier":"homoit0001252","skos:prefLabel":[{"@language":"en","@value":"Safer sex parties"},{"@language":"es","@value":"Fiestas de sexo más seguro"},{"@language":"nl","@value":"Safe sex parties"},{"@language":"sv","@value":"Safer sex-fester"}],"skos:altLabel":{"@language":"sv","@value":"Safer sex parties"},"rdfs:comment":[{"@language":"en","@value":"Social gatherings or events originating from Black lesbian communities in the Southern United States in the 1990s. Safer sex parties are typically held at private locations where organizers and participants discuss safer sex practices, sexuality, and sexual experiences."},{"@language":"es","@value":"Encuentros o eventos sociales originados en comunidades de lesbianas negras en el sur de los Estados Unidos en la década de 1990. Las fiestas de sexo más seguro generalmente se llevan a cabo en lugares privados donde quienes organizan y participan discuten prácticas sexuales más seguras, la sexualidad y las experiencias sexuales."},{"@language":"nl","@value":"Seksfeesten die doorgaans worden gehouden op privélocaties of seksclubs, waar organisatoren en deelnemers ook veiligere sekspraktijken, seksualiteit en seksuele ervaringen bespreken en praktiseren."},{"@language":"sv","@value":"Sociala sammankomster eller evenemang med ursprung i svarta lesbiska gemenskaper i södra USA på 1990-talet. Safer sex-fester hålls vanligtvis i privata miljöer där arrangörer och deltagare diskuterar säkrare sex, sexualitet och sexuella erfarenheter."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001272"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001251"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000974"},"dc:replaces":{"@id":"http://homosaurus.org/v2/saferSexParties"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001256","dc:identifier":"homoit0001256","skos:prefLabel":[{"@language":"he","@value":"Saris"},{"@language":"es","@value":"Saris"},{"@language":"nl","@value":"Saris"},{"@language":"sv","@value":"Saris"}],"rdfs:comment":[{"@language":"en","@value":"In Jewish culture, this term is used to refer to individuals who were assigned male at birth but later developed feminine characteristics."},{"@language":"es","@value":"En la cultura judía, este término se utiliza para referirse a personas a quienes se les asignó al sexo masculino al nacer pero que luego desarrollaron características femeninas."},{"@language":"nl","@value":"In de joodse cultuur wordt deze term gebruikt om te verwijzen naar personen die bij de geboorte waren toegewezen als man, maar later vrouwelijke kenmerken ontwikkelden."},{"@language":"sv","@value":"Inom judisk kultur används termen för att beskriva personer som tilldelats manligt kön vid födseln men senare utvecklat feminina drag."}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001256"},"dc:replaces":{"@id":"http://homosaurus.org/v2/saris"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001339","dc:identifier":"homoit0001339","skos:prefLabel":[{"@language":"en","@value":"Stature"},{"@language":"es","@value":"Estatura"},{"@language":"nl","@value":"Grootte"},{"@language":"sv","@value":"Kroppslängd"}],"rdfs:comment":[{"@language":"en","@value":"A person’s natural height in an upright position."},{"@language":"es","@value":"La altura natural de una persona en posición erguida."},{"@language":"nl","@value":"De natuurlijke lengte van een persoon in rechtopstaande positie."},{"@language":"sv","@value":"En persons naturliga kroppslängd i upprätt ställning."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001259"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85127601"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001269"},"dc:replaces":{"@id":"http://homosaurus.org/v2/stature"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001495","dc:identifier":"homoit0001495","skos:prefLabel":[{"@language":"en","@value":"Voice"},{"@language":"es","@value":"Voz"},{"@language":"nl","@value":"Stem"},{"@language":"sv","@value":"Röst"}],"rdfs:comment":[{"@language":"en","@value":"Sound produced by the larynx and vocal tract that is used for communication and expression."},{"@language":"es","@value":"Sonido producido por la laringe y el tracto vocal que se utiliza para la comunicación y la expresión."},{"@language":"nl","@value":"Geluid geproduceerd door het strottenhoofd en het stemkanaal dat wordt gebruikt voor communicatie en expressie."},{"@language":"sv","@value":"Ljud som produceras i struphuvudet och talröret och som används för kommunikation och uttryck."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001259"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001842"},{"@id":"https://homosaurus.org/v5/homoit0001843"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85144224"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001269"},"dc:replaces":{"@id":"http://homosaurus.org/v2/voice"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001262","dc:identifier":"homoit0001262","skos:prefLabel":[{"@language":"en","@value":"Seduction"},{"@language":"es","@value":"Seducción"},{"@language":"nl","@value":"Verleiding"},{"@language":"sv","@value":"Förförelse"}],"skos:altLabel":[{"@language":"en","@value":"Temptation"},{"@language":"es","@value":"Tentación"},{"@language":"sv","@value":"Förförelseakt"}],"rdfs:comment":[{"@language":"en","@value":"Enticing or tempting someone into something, typically sexual attraction or activity, through the use of persuasion, flattery, and/or promises."},{"@language":"es","@value":"Atraer o tentar a alguien a algo, generalmente atracción o actividad sexual, mediante el uso de persuasión, halagos y/o promesas."},{"@language":"nl","@value":"Iemand verleiden of verleiden tot iets, meestal seksuele aantrekking of activiteit, door middel van overreding, vleierij en/of beloften."},{"@language":"sv","@value":"Att locka eller fresta någon till något, vanligtvis sexuell attraktion eller aktivitet, genom övertalning, smicker och/eller löften."}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001306"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85119517"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001262"},"dc:replaces":{"@id":"http://homosaurus.org/v2/seduction"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003050","dc:identifier":"homoit0003050","skos:prefLabel":[{"@language":"en","@value":"Violet wands"},{"@language":"es","@value":"Violet wands"},{"@language":"nl","@value":"Violette toverstokken"},{"@language":"sv","@value":"Violet wands"}],"skos:altLabel":{"@language":"es","@value":"Varita violeta"},"rdfs:comment":[{"@language":"en","@value":"A device used to apply an electrical charge to the body."},{"@language":"es","@value":"Dispositivo utilizado para aplicar una carga eléctrica al cuerpo."},{"@language":"nl","@value":"Een apparaat dat wordt gebruikt om een elektrische lading op het lichaam aan te brengen."},{"@language":"sv","@value":"Ett redskap som används för att applicera elektrisk ström på kroppen."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001266"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0003057"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001266"},"dc:issued":{"@type":"xsd:date","@value":"2023-12-15"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003100","dc:identifier":"homoit0003100","skos:prefLabel":[{"@language":"en","@value":"Jockstraps"},{"@language":"es","@value":"Suspensorio"},{"@language":"nl","@value":"Jockstraps"},{"@language":"sv","@value":"Suspensoar"}],"skos:altLabel":[{"@language":"es","@value":"Suspensores"},{"@language":"es","@value":"Jockstraps"}],"rdfs:comment":[{"@language":"en","@value":"An article of clothing with a pouch to support the genitalia, typically worn by athletes, or for aesthetic or sexual gratification."},{"@language":"es","@value":"Artículo de vestir con una bolsa para sostener los genitales, que suele utilizarse por atletas, o para la gratificación estética o sexual."},{"@language":"nl","@value":"Een kledingstuk met een zakje om de genitaliën te beschermen, meestal gedragen door atleten of voor esthetische of seksuele bevrediging."},{"@language":"sv","@value":"Plagg med en påse för att stödja könsorganen, vanligtvis buren av idrottare eller i estetiskt eller sexuellt syfte."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001266"},{"@id":"https://homosaurus.org/v5/homoit0003066"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0003059"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001266"},"dc:issued":{"@type":"xsd:date","@value":"2023-12-18"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003112","dc:identifier":"homoit0003112","skos:prefLabel":[{"@language":"en","@value":"Gas masks (Erotic)"},{"@language":"es","@value":"Máscaras de gas (erótico)"},{"@language":"de","@value":"Gasmasken (Erotik)"},{"@language":"nl","@value":"Gasmaskers"},{"@language":"sv","@value":"Gasmasker (erotik)"}],"rdfs:comment":[{"@language":"en","@value":"A mask traditionally used to protect the wearer from inhaling airborne pollutants and toxic gases and used in kink or erotic play."},{"@language":"es","@value":"Máscara utilizada tradicionalmente para proteger al usuario de la inhalación de contaminantes atmosféricos y gases tóxicos, y usada en juegos eróticos o kink."},{"@language":"de","@value":"Eine Maske, die traditionell zum Schutz der tragenden Person vor dem Einatmen luftgetragener Schadstoffe und toxischer Gase verwendet wird und in Kink- oder erotischem Spiel Verwendung findet."},{"@language":"nl","@value":"Een masker dat traditioneel wordt gebruikt om de drager te beschermen tegen het inademen van vervuilende en giftige gassen in de lucht en dat wordt gebruikt bij kink- of erotisch spel."},{"@language":"sv","@value":"Mask som traditionellt används för att skydda bäraren mot luftburna föroreningar och giftiga gaser, och som används i kink- eller erotisk lek."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001266"},{"@id":"https://homosaurus.org/v5/homoit0003066"},{"@id":"https://homosaurus.org/v5/homoit0003178"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0003083"},{"@id":"https://homosaurus.org/v5/homoit0003090"},{"@id":"https://homosaurus.org/v5/homoit0003113"},{"@id":"https://homosaurus.org/v5/homoit0003146"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001266"},"dc:issued":{"@type":"xsd:date","@value":"2023-12-20"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003144","dc:identifier":"homoit0003144","skos:prefLabel":[{"@language":"en","@value":"Clothespins (Erotic)"},{"@language":"es","@value":"Pinzas para ropa (erótico)"},{"@language":"de","@value":"Wäscheklammern (erotisch)"},{"@language":"nl","@value":"Wasknijpers"},{"@language":"sv","@value":"Klädnypor (sex)"}],"skos:altLabel":[{"@language":"en","@value":"Clothes pegs"},{"@language":"es","@value":"Ganchos"},{"@language":"es","@value":"Pinzas"}],"rdfs:comment":[{"@language":"en","@value":"A fastener usually used to hang up clothes for drying, here used as a sex toy."},{"@language":"es","@value":"Un sujetador generalmente utilizado para colgar ropa y secarla, utilizado aquí como juguete sexual."},{"@language":"de","@value":"Ein Befestigungselement, das normalerweise zum Aufhängen von Kleidung zum Trocknen verwendet wird, hier als Sexspielzeug eingesetzt."},{"@language":"nl","@value":"Een bevestigingsmiddel dat meestal wordt gebruikt om kleding op te hangen om te laten drogen, hier gebruikt als seksspeeltje."},{"@language":"sv","@value":"En klädnypa, vanligtvis använd för att hänga upp kläder på tork, här använd som en sexleksak."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001266"},{"@id":"https://homosaurus.org/v5/homoit0003143"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001266"},"dc:issued":{"@type":"xsd:date","@value":"2023-12-20"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003178","dc:identifier":"homoit0003178","skos:prefLabel":[{"@language":"en","@value":"Masks (Erotic)"},{"@language":"es","@value":"Máscaras (erótica)"},{"@language":"nl","@value":"Maskers"},{"@language":"sv","@value":"Masker (erotik)"}],"rdfs:comment":[{"@language":"en","@value":"Masks worn as a fetish fashion accessory or for sensual or sexual play."},{"@language":"es","@value":"Máscaras utilizadas como accesorio de moda fetiche o para juegos sensuales o sexuales."},{"@language":"nl","@value":"Maskers die worden gedragen als fetisj-modeaccessoire of voor sensueel of seksueel spel."},{"@language":"sv","@value":"Masker som bärs som sexuella accessoarer eller vid sensuell eller sexuell lek."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001266"},{"@id":"https://homosaurus.org/v5/homoit0003066"}],"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0003112"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0003083"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001266"},"dc:issued":{"@type":"xsd:date","@value":"2024-01-17"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001315","dc:identifier":"homoit0001315","skos:prefLabel":[{"@language":"en-us","@value":"Situational sexual behavior"},{"@language":"es","@value":"Comportamiento sexual situacional"},{"@language":"nl","@value":"Situationeel seksueel gedrag"},{"@language":"sv","@value":"Situationsbetingat sexuellt beteende"},{"@language":"en-gb","@value":"Situational sexual behaviour"}],"skos:altLabel":[{"@language":"en","@value":"Situational homosexuality"},{"@language":"es","@value":"Homosexualidad situacional"},{"@language":"sv","@value":"Situationsbetingad homosexualitet"}],"rdfs:comment":[{"@language":"en","@value":"Sexual behaviors that depart from an individual's typical behaviors or preferences as a result of social pressures that permit, encourage, or compel certain behaviors."},{"@language":"es","@value":"Comportamientos sexuales que se desvían de los comportamientos o las preferencias típicas de una persona como resultado de presiones sociales que permiten, alientan u obligan a ciertos comportamientos."},{"@language":"nl","@value":"Seksueel gedrag dat afwijkt van het normale gedrag of de voorkeuren van een persoon als gevolg van sociale druk die bepaald gedrag toestaat, aanmoedigt of afdwingt."},{"@language":"sv","@value":"Sexuella beteenden som skiljer sig från en persons vanliga preferenser eller vanor och som uppstår i situationer där sociala normer eller omständigheter tillåter, uppmuntrar eller pressar till sådana handlingar."}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001267"},{"@id":"https://homosaurus.org/v5/homoit0001299"},{"@id":"https://homosaurus.org/v5/homoit0001300"},{"@id":"https://homosaurus.org/v5/homoit0001306"},{"@id":"https://homosaurus.org/v5/homoit0003738"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001315"},"dc:replaces":{"@id":"http://homosaurus.org/v2/situationalSexualBehaviour"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002219","dc:identifier":"homoit0002219","skos:prefLabel":[{"@language":"en","@value":"Yiff"},{"@language":"es","@value":"Yiff"},{"@language":"nl","@value":"Yiff"},{"@language":"sv","@value":"Yiff"}],"rdfs:comment":[{"@language":"en","@value":"Slang term used by members of the furry fandom to describe the act of sex."},{"@language":"es","@value":"Término en inglés de la jerga utilizado por miembros del fandom o comunidad furro para describir el acto sexual."},{"@language":"sv","@value":"Slangterm som används inom furryfandom för att beskriva sexuell aktivitet."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002165"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001267"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001896","dc:identifier":"homoit0001896","skos:prefLabel":[{"@language":"en","@value":"Endosex"},{"@language":"es","@value":"Endosex"},{"@language":"de","@value":"endogeschlechtlich"},{"@language":"nl","@value":"Endosekse"},{"@language":"sv","@value":"Endosex"}],"skos:altLabel":[{"@language":"en","@value":"Dyadic"},{"@language":"en","@value":"Non-intersex"},{"@language":"en","@value":"Perisex"},{"@language":"es","@value":"No-intersex"},{"@language":"de","@value":"dyadisch"},{"@language":"de","@value":"endo"},{"@language":"de","@value":"endosexuell"},{"@language":"nl","@value":"Non-intersekse"},{"@language":"nl","@value":"Perisekse"}],"rdfs:comment":[{"@language":"en","@value":"The state of individuals born with the sexual anatomy, reproductive system, and chromosomes associated with their assigned sex (i.e., not intersex)."},{"@language":"es","@value":"El estado de las personas que nacen con la anatomía sexual, el sistema reproductivo y los cromosomas asociados con su sexo asignado (es decir, no intersexual)."},{"@language":"de","@value":"Zustand von Personen, die mit der Geschlechtsanatomie, den Fortpflanzungsorganen und den Chromosomen geboren wurden, die ihrem bei der Geburt zugewiesenen Geschlecht entsprechen (d. h. nicht inter* sind)."},{"@language":"nl","@value":"De staat van personen geboren met de seksuele anatomie, het voortplantingssysteem en de chromosomen die geassocieerd worden met hun toegewezen geslacht (d.w.z. niet intersekse)"},{"@language":"sv","@value":"Tillståndet att vara född med könsorgan, reproduktionssystem och kromosomer som överensstämmer med det kön personen tilldelades vid födseln (motsats till intersex)."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001269"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001268"},{"@id":"https://homosaurus.org/v5/homoit0001648"},{"@id":"https://homosaurus.org/v5/homoit0001897"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001269"},"dc:issued":{"@type":"xsd:date","@value":"2022-02-28"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001897","dc:identifier":"homoit0001897","skos:prefLabel":[{"@language":"en","@value":"Endosex people"},{"@language":"es","@value":"Personas endosex"},{"@language":"de","@value":"Endogeschlechtliche Personen"},{"@language":"nl","@value":"Endosekse personen"},{"@language":"sv","@value":"Endosexpersoner"}],"skos:altLabel":[{"@language":"en","@value":"Dyadic people"},{"@language":"en","@value":"Non-intersex people"},{"@language":"en","@value":"Perisex people"},{"@language":"es","@value":"Personas no-intersex"},{"@language":"nl","@value":"Niet-intersekse personen"},{"@language":"nl","@value":"Perisekse personen"}],"rdfs:comment":[{"@language":"en","@value":"Individuals born with the sexual anatomy, reproductive system, and chromosomes associated with their assigned sex (i.e., people who are not intersex)."},{"@language":"es","@value":"Personas que nacen con la anatomía sexual, el sistema reproductivo y los cromosomas asociados con su sexo asignado (es decir, personas que no son intersex)."},{"@language":"de","@value":"Personen, deren körperliche Geschlechtsmerkmale den gesellschaftlichen und medizinischen Normvorstellungen von weiblichen oder männlichen Körpern entsprechen."},{"@language":"nl","@value":"Personen geboren met de seksuele anatomie, het voortplantingssysteem en de chromosomen die geassocieerd worden met hun toegewezen geslacht (d.w.z. iemand die niet intersekse is)"},{"@language":"sv","@value":"Personer som är födda med könsorgan, reproduktionssystem och kromosomer som överensstämmer med det kön de tilldelades vid födseln (dvs. personer som inte är intersex)."}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001268"},{"@id":"https://homosaurus.org/v5/homoit0001648"},{"@id":"https://homosaurus.org/v5/homoit0001896"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001897"},"dc:issued":{"@type":"xsd:date","@value":"2022-02-28"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001274","dc:identifier":"homoit0001274","skos:prefLabel":[{"@language":"en","@value":"Sex therapy"},{"@language":"es","@value":"Terapia sexual"},{"@language":"nl","@value":"Sekstherapie"},{"@language":"sv","@value":"Sexterapi"}],"rdfs:comment":[{"@language":"en","@value":"A form of counseling intended to address sexual dysfunction and other sex-related issues."},{"@language":"es","@value":"Una forma de consejería destinada a abordar la disfunción sexual y otras cuestiones relacionados con el sexo."},{"@language":"nl","@value":"Een vorm van hulpverlening bedoeld om seksuele disfunctie en andere seksgerelateerde problemen aan te pakken."},{"@language":"sv","@value":"En form av samtalsstöd som syftar till att hantera sexuell dysfunktion och andra sexrelaterade problem."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001366"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001291"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85120674"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001004"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sexTherapy"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003764","dc:identifier":"homoit0003764","skos:prefLabel":[{"@language":"en","@value":"Stripping"},{"@language":"nl","@value":"Strippen"},{"@language":"sv","@value":"Strippa"}],"skos:altLabel":[{"@language":"en","@value":"Pole dancing"},{"@language":"en","@value":"Pole-dancing"},{"@language":"en","@value":"Peeling"},{"@language":"en","@value":"Stripteasing"},{"@language":"en","@value":"Exotic dancing"},{"@language":"nl","@value":"Paaldansen"},{"@language":"nl","@value":"Stripteasen"},{"@language":"sv","@value":"Strippning"}],"rdfs:comment":[{"@language":"en","@value":"A form of sex work that involves undressing to music while using a pole to perform dance moves, whether in a venue like a strip club or by hire at private parties. Stripping may also be performed by amateurs in private settings."},{"@language":"nl","@value":"Een vorm van sekswerk waarbij men zich uitkleedt op muziek terwijl men een paal gebruikt om dansbewegingen uit te voeren, hetzij in een locatie als een stripclub of gehuurd op privéfeesten. Strippen kan ook worden uitgevoerd door amateurs in privé-omgeving."},{"@language":"sv","@value":"En form av sexarbete som innebär att klä av sig till musik medan man utför dansrörelser vid en stång, antingen på en plats som en strippklubb eller som underhållning på privata tillställningar. Striptease kan även utföras av amatörer i privata sammanhang."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001276"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001343"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2006006232"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000011"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-30"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003768","dc:identifier":"homoit0003768","skos:prefLabel":[{"@language":"en","@value":"Cam modeling"},{"@language":"nl","@value":"Cam modeling"},{"@language":"sv","@value":"Cam-modellande"}],"skos:altLabel":[{"@language":"en","@value":"Camming"},{"@language":"en","@value":"Webcam modeling"},{"@language":"nl","@value":"Webcam modeling"}],"rdfs:comment":[{"@language":"en","@value":"Short for \"webcam modeling,\" this term refers to real-time sex work via online video calls and livestreams."},{"@language":"nl","@value":"Afkorting voor 'webcam modeling'; verwijst naar sekswerk in realtime via online videogesprekken en livestreams."},{"@language":"sv","@value":"Förkortning för ”webcam-modellande”, en term som refererar till realtidsbaserat sexarbete via onlinevideosamtal och livestreaming."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001276"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0003769"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000011"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-30"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003780","dc:identifier":"homoit0003780","skos:prefLabel":[{"@language":"en","@value":"Street sex work"},{"@language":"nl","@value":"Sekswerk op straat"},{"@language":"sv","@value":"Gatuprostitution"}],"skos:altLabel":{"@language":"en","@value":"Street prostitution"},"rdfs:comment":[{"@language":"en","@value":"Sex work that is generally solicited in a public place such as a street, street corner, or park."},{"@language":"nl","@value":"Sekswerk dat over het algemeen plaatsvindt op een openbare plaats, zoals op straat."},{"@language":"sv","@value":"Säljande av sexuella handlingar på offentliga platser som gator, gatuhörn eller parker."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001276"},"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85107626"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000011"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-30"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003781","dc:identifier":"homoit0003781","skos:prefLabel":[{"@language":"en","@value":"Survival sex work"},{"@language":"nl","@value":"Overlevings-sekswerk"},{"@language":"sv","@value":"Sexarbete och prostitution för överlevnad"}],"skos:altLabel":[{"@language":"en","@value":"Survival prostitution"},{"@language":"sv","@value":"Sexarbete för överlevnad"},{"@language":"sv","@value":"Prostitution för överlevnad"}],"rdfs:comment":[{"@language":"en","@value":"A form of sex work performed in lieu of other employment or in order to meet immediate needs, such as shelter, food, clothing, familial care, etc. Use only for sex work that is self-described as survival."},{"@language":"nl","@value":"Een vorm van sekswerk die wordt uitgevoerd ter vervanging van ander werk of om in directe behoeften te voorzien, zoals onderdak, voedsel, kleding, gezinszorg, enz. Alleen te gebruiken voor sekswerk dat door de persoon zelf wordt beschreven als overlevingswerk."},{"@language":"sv","@value":"En form av sexarbete eller prostitution som utförs i stället för annan försörjning eller för att tillgodose akuta behov såsom bostad, mat, kläder eller familjeomsorg."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001276"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000011"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-30"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003792","dc:identifier":"homoit0003792","skos:prefLabel":[{"@language":"en","@value":"Sugaring"},{"@language":"nl","@value":"Sugaring"},{"@language":"sv","@value":"Sugardejtning"}],"skos:altLabel":[{"@language":"en","@value":"Sugar dating"},{"@language":"nl","@value":"Suiker dating"},{"@language":"nl","@value":"Suikeren"},{"@language":"sv","@value":"Sugardejting"}],"rdfs:comment":[{"@language":"en","@value":"A form of sex work in which companionship and sexual services are exchanged for money, gifts, and other material benefits. Generally but not always sugaring describes a relationship between an older client and a younger sex worker."},{"@language":"nl","@value":"Een vorm van sekswerk waarbij gezelschap en seksuele diensten worden geruild voor geld, geschenken en andere materiële voordelen. Over het algemeen, maar niet altijd, beschrijft sugaring een relatie tussen een oudere cliënt en een jongere sekswerker."},{"@language":"sv","@value":"En form av sexarbete där sällskap och sexuella handlingar utbyts mot pengar, gåvor eller andra materiella förmåner. Sugardejtning syftar oftast men inte alltid på relationer mellan en äldre kund och en yngre sexarbetare."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001276"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0003793"},{"@id":"https://homosaurus.org/v5/homoit0003794"},{"@id":"https://homosaurus.org/v5/homoit0003795"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000011"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-30"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003743","dc:identifier":"homoit0003743","skos:prefLabel":[{"@language":"en","@value":"Sex trafficking"},{"@language":"nl","@value":"Sekshandel"},{"@language":"sv","@value":"Människohandel för sexuella ändamål"}],"skos:altLabel":[{"@language":"en","@value":"Coerced sex work"},{"@language":"en","@value":"Forced sex work"},{"@language":"en","@value":"Non-consensual sex work"},{"@language":"en","@value":"Coerced prostitution"},{"@language":"en","@value":"Forced prostitution"},{"@language":"en","@value":"Non-consensual prostitution"},{"@language":"nl","@value":"Gedwongen sekswerk"},{"@language":"nl","@value":"Prostitutie zonder wederzijdse toestemming"},{"@language":"nl","@value":"Sekswerk zonder wederzijdse toestemming"},{"@language":"sv","@value":"Sextrafficking"}],"rdfs:comment":[{"@language":"en","@value":"Human trafficking for the purpose of sexual exploitation, including recruiting, holding, moving, defrauding, and/or coercing people into engaging in sexual services and performances they cannot or have not meaningfully consented to."},{"@language":"nl","@value":"Mensenhandel met het oog op seksuele uitbuiting, waaronder het werven, vasthouden, verplaatsen, oplichten en/of dwingen van mensen om deel te nemen aan seksuele diensten en prestaties waar zij niet op betekenisvolle wijze mee kunnen of hebben ingestemd."},{"@language":"sv","@value":"Människohandel i syfte att utnyttja personer sexuellt, inklusive att rekrytera, hålla kvar, förflytta, lura och/eller tvinga människor till att erbjuda sexuella handlingar eller framträdanden utan att de har kunnat ge ett meningsfullt samtycke."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0003742"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001276"},"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2006002629"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0003742"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-30"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001437","dc:identifier":"homoit0001437","skos:prefLabel":[{"@language":"en","@value":"Transgender sex workers"},{"@language":"es","@value":"Trabajadores sexuales transgénero"},{"@language":"nl","@value":"Transgender sekswerkers"}],"skos:altLabel":[{"@language":"en","@value":"Trans sex workers"},{"@language":"en","@value":"Transgender prostitutes"},{"@language":"en","@value":"Trans prostitutes"},{"@language":"en","@value":"Transgender prostitution"},{"@language":"en","@value":"Transgender sex work"},{"@language":"en","@value":"Trans sex work"},{"@language":"es","@value":"Prostitutxs transgénero"},{"@language":"es","@value":"Prostitutos transgénero"},{"@language":"es","@value":"Prostitutas transgénero"},{"@language":"es","@value":"Trabajo sexual transgénero"},{"@language":"nl","@value":"Trans sekswerk"},{"@language":"nl","@value":"Trans sekswerkers"},{"@language":"nl","@value":"Transgender prostitutie"},{"@language":"nl","@value":"Transgender prostituées"},{"@language":"nl","@value":"Transgender sekswerk"}],"rdfs:comment":[{"@language":"en","@value":"Transgender people who receive money or goods in exchange for sexual services, performances, or companionship. Use to describe transgender people working across the broad spectrum of sex work."},{"@language":"es","@value":"Personas transgénero que reciben dinero o bienes a cambio de servicios o actuaciones sexuales. Se utiliza para describir a las personas transgénero que trabajan en el amplio espectro del trabajo sexual."},{"@language":"nl","@value":"Transgender personen die geld of goederen ontvangen in ruil voor seksuele diensten, optredens of gezelschap. Wordt gebruikt om transgender personen te beschrijven die in het brede spectrum van sekswerk werken."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001277"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0003758"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transgenderProstitutes"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003759","dc:identifier":"homoit0003759","skos:prefLabel":[{"@language":"en","@value":"Intersex sex workers"},{"@language":"nl","@value":"Intersekse sekswerkers"},{"@language":"sv","@value":"Intersexpersoner som är sexarbetare"}],"skos:altLabel":[{"@language":"en","@value":"Intersex prostitutes"},{"@language":"en","@value":"Intersex prostitution"},{"@language":"nl","@value":"Intersekse prostitué(e)s"},{"@language":"sv","@value":"Sexarbetare som är intersexpersoner"}],"rdfs:comment":[{"@language":"en","@value":"Intersex people who receive money or goods in exchange for sexual services, performances, or companionship. Use to describe intersex people working across the broad spectrum of sex work."},{"@language":"nl","@value":"Intersekse personen die geld of goederen ontvangen in ruil voor seksuele diensten, optredens of gezelschap. Wordt gebruikt om intersekse personen te beschrijven die werkzaam zijn in het brede spectrum van sekswerk."},{"@language":"sv","@value":"Intersexpersoner som tar emot pengar eller varor i utbyte mot sexuella handlingar, framträdanden eller sällskap. Används för att beskriva intersexpersoner som är verksamma inom det breda spektrumet av sexarbete. Vissa anser termen sexarbetare som kränkade och politiserad, medan andra identifierar sig med den. Se även \"Intersexpersoner i prostitution"}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001277"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0003758"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-30"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003760","dc:identifier":"homoit0003760","skos:prefLabel":[{"@language":"en","@value":"Non-binary sex workers"},{"@language":"nl","@value":"Non-binaire sekswerkers"},{"@language":"sv","@value":"Ickebinära sexarbetare"}],"skos:altLabel":[{"@language":"en","@value":"Nonbinary sex workers"},{"@language":"en","@value":"Non-binary prostitutes"},{"@language":"en","@value":"Nonbinary prostitutes"},{"@language":"en","@value":"Non-binary prostitution"},{"@language":"en","@value":"Nonbinary prostitution"},{"@language":"nl","@value":"Non-binaire prostitué(e)s"},{"@language":"nl","@value":"Nonbinaire prostitutie"},{"@language":"nl","@value":"Nonbinaire prostitué(e)s"},{"@language":"nl","@value":"Nonbinaire sekswerkers"}],"rdfs:comment":[{"@language":"en","@value":"Non-binary people who receive money or goods in exchange for sexual services, performances, or companionship. Use to describe non-binary people working across the broad spectrum of sex work."},{"@language":"nl","@value":"Non-binaire personen die geld of goederen ontvangen in ruil voor seksuele diensten, optredens of gezelschap. Wordt gebruikt om non-binaire personen te beschrijven die werkzaam zijn in het brede spectrum van sekswerk."},{"@language":"sv","@value":"Ickebinära personer som tar emot pengar eller varor i utbyte mot sexuella handlingar, framträdanden eller sällskap. Används för att beskriva ickebinära personer som är verksamma inom det breda spektrumet av sexarbete. Vissa anser termen sexarbetare som kränkade och politiserad, medan andra identifierar sig med den. Se även \"Ickebinära i prostitution\"."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001277"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0003758"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-30"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003797","dc:identifier":"homoit0003797","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ strippers"},{"@language":"nl","@value":"LHBTQ+-strippers"},{"@language":"sv","@value":"Strippor (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"Strippers (LGBTQ)"},{"@language":"en","@value":"LGBTQ+ stripteasers"},{"@language":"en","@value":"Stripteasers (LGBTQ)"},{"@language":"en","@value":"LGBTQ+ pole dancers"},{"@language":"en","@value":"Pole dancers (LGBTQ)"},{"@language":"en","@value":"LGBTQ+ peelers"},{"@language":"en","@value":"Peelers (LGBTQ)"},{"@language":"en","@value":"LGBTQ+ exotic dancers"},{"@language":"en","@value":"Exotic dancers (LGBTQ)"},{"@language":"nl","@value":"LHBTQ+-exotische dansers"},{"@language":"nl","@value":"LHBTQ+-paaldansers"},{"@language":"nl","@value":"LHBTQ+-stripteasers"},{"@language":"nl","@value":"Paaldansers (LHBTQ+)"},{"@language":"nl","@value":"Strippers (LHBTQ+)"},{"@language":"nl","@value":"Stripteasers (LHBTQ+)"}],"rdfs:comment":[{"@language":"en","@value":"LGBTQ+ sex workers who undress to music while using a pole to perform dance moves, whether in a venue like a strip club or by hire at private parties. For stripping performed by amateurs in private settings, use \"Stripping.\""},{"@language":"nl","@value":"LHBTQ+-sekswerkers die zich uitkleden op muziek terwijl ze een paal gebruiken om danspasjes te doen, of dat nu in een locatie als een stripclub is of ingehuurd op privéfeestjes. Voor strippen uitgevoerd door amateurs in privé-omgevingen, gebruik je \"Strippen.\""},{"@language":"sv","@value":"Hbtq+-sexarbetare som uppträder med pole dance och striptease till musik, antingen på klubb eller på privata tillställningar. För amatörstriptease i privata sammanhang, använd termen ”Striptease”."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001277"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0003758"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-30"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003761","dc:identifier":"homoit0003761","skos:prefLabel":[{"@language":"en","@value":"Two-Spirit sex workers"},{"@language":"nl","@value":"Two-Spirit sekswerkers"},{"@language":"sv","@value":"Two-spirit-personer som är sexarbetare"}],"skos:altLabel":[{"@language":"en","@value":"Two Spirit sex workers"},{"@language":"en","@value":"Two-Spirited sex workers"},{"@language":"en","@value":"Two Spirited sex workers"},{"@language":"en","@value":"2S sex workers"},{"@language":"en","@value":"Two-Spirit prostitutes"},{"@language":"en","@value":"Two Spirit prostitutes"},{"@language":"en","@value":"Two-Spirited prostitutes"},{"@language":"en","@value":"Two Spirited prostitutes"},{"@language":"en","@value":"2S prostitutes"},{"@language":"en","@value":"Two-Spirit prostitution"}],"rdfs:comment":[{"@language":"en","@value":"Two-Spirit people who receive money or goods in exchange for sexual services, performances, or companionship. Use to describe Two-Spirit people working across the broad spectrum of sex work."},{"@language":"nl","@value":"Two-Spirit-people die geld of goederen ontvangen in ruil voor seksuele diensten, optredens of gezelschap. Wordt gebruikt om Two-Spirit-people te beschrijven die in het brede spectrum van sekswerk werken."},{"@language":"sv","@value":"Two-spirit-personer som tar emot pengar eller varor i utbyte mot sexuella handlingar, framträdanden eller sällskap. Används för att beskriva Two-spirit-personer som är verksamma inom det breda spektrumet av sexarbete. Vissa anser termen sexarbetare som kränkade och politiserad, medan andra identifierar sig med den. Se även \"Two-spirit-personer i prostitution\"."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001480"},{"@id":"https://homosaurus.org/v5/homoit0003758"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001277"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-30"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001279","dc:identifier":"homoit0001279","skos:prefLabel":[{"@language":"en","@value":"Sexologists"},{"@language":"es","@value":"Sexólogos"},{"@language":"nl","@value":"Seksuologen"},{"@language":"sv","@value":"Sexologer"}],"rdfs:comment":[{"@language":"en","@value":"People who professionally study sexology, or human sexual behavior and sexual relationships."},{"@language":"es","@value":"Personas que estudian profesionalmente la sexología, o el comportamiento sexual humano y las relaciones sexuales."},{"@language":"nl","@value":"Personen die beroepsmatig seksuologie bestuderen, of menselijk seksueel gedrag en seksuele relaties."},{"@language":"sv","@value":"Personer som yrkesmässigt studerar sexologi eller mänskligt sexuellt beteende och sexuella relationer."}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001280"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85120693"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001279"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sexologists"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001280","dc:identifier":"homoit0001280","skos:prefLabel":[{"@language":"en","@value":"Sexology"},{"@language":"es","@value":"Sexología"},{"@language":"nl","@value":"Seksuologie"},{"@language":"sv","@value":"Sexologi"}],"rdfs:comment":[{"@language":"en","@value":"Scientific study of human sexuality including sexual interests, behaviors, and functions that utilizes tools from other academic fields like anthropology, biology, medicine, and psychology. "},{"@language":"es","@value":"Estudio científico de la sexualidad humana, incluidos los intereses, comportamientos y funciones sexuales, y que utiliza herramientas de otras áreas académicas como la antropología, la biología, la medicina y la psicología."},{"@language":"nl","@value":"Wetenschappelijke studie van menselijke seksualiteit, inclusief seksuele interesses, gedragingen en functies, waarbij gebruik wordt gemaakt van hulpmiddelen uit andere academische gebieden zoals antropologie, biologie, geneeskunde en psychologie."},{"@language":"sv","@value":"Vetenskapen om mänsklig sexualitet, inklusive intressen, beteenden och funktioner. Sexologi bygger på kunskap från bland annat antropologi, biologi, medicin och psykologi."}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001279"},{"@id":"https://homosaurus.org/v5/homoit0001306"},{"@id":"https://homosaurus.org/v5/homoit0004234"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh90004841"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001280"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sexology"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004234","dc:identifier":"homoit0004234","skos:prefLabel":[{"@language":"en","@value":"Sexual studies"},{"@language":"nl","@value":"Seksuele studies"},{"@language":"sv","@value":"Sexualitetsstudier"}],"rdfs:comment":[{"@language":"en","@value":"An interdisciplinary field that studies the social, cultural, and historical dimensions of sex and sexuality."},{"@language":"nl","@value":"Een interdisciplinair vakgebied dat de sociale, culturele en historische dimensies van seks en seksualiteit bestudeert."},{"@language":"sv","@value":"Ett tvärvetenskapligt område som studerar de sociala, kulturella och historiska dimensionerna av sex och sexualitet."}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001280"},{"@id":"https://homosaurus.org/v5/homoit0001306"},{"@id":"https://homosaurus.org/v5/homoit0004430"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0004234"},"dc:issued":{"@type":"xsd:date","@value":"2025-04-24"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001539","dc:identifier":"homoit0001539","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ people with internet sex addictions"},{"@language":"es","@value":"Personas LGBTQ+ con adicciones al sexo por Internet"},{"@language":"nl","@value":"LHBTQ+-personen met een internet seksverslaving"},{"@language":"sv","@value":"Hbtq+-personer med internetsexberoende"}],"skos:altLabel":[{"@language":"en","@value":"LGBTQ+ people with cybersex addictions"},{"@language":"en","@value":"LGBTQ+ people with internet sexual addictions"},{"@language":"en","@value":"LGBTQ+ people with porn addictions"},{"@language":"en","@value":"LGBTQ+ people with pornography addictions"},{"@language":"es","@value":"Personas LGBTQ+ adictos al sexo por Internet"},{"@language":"nl","@value":"LHBTQ+-personen met internet seksuele verslaving"},{"@language":"nl","@value":"LHBTQ+-personen met pornografie verslaving"},{"@language":"nl","@value":"LHBTQ+-personen met pornoverslaving"}],"rdfs:comment":[{"@language":"en","@value":"LGBTQ+ people experiencing addiction to or dependency upon sexual activities involving the internet, including watching pornography, engaging in sexual conversations online, etc. Only use to refer to individuals who describe themselves as having internet sex addictions, not individuals who sexual practices are perceived as promiscuous or excessive by others."},{"@language":"es","@value":"Personas LGBTQ+ que experimentan una adicción o dependencia de actividades sexuales que involucran el internet, incluyendo ver pornografía, participar de conversaciones sexuales en línea, etc. Utilícese únicamente para referirse a personas que se describen a sí mismas como adictas al sexo por internet, no a personas cuyas prácticas sexuales se perciban como promiscuas o excesivo por otras personas."},{"@language":"nl","@value":"LHBTQ+-personen die verslaafd zijn aan of afhankelijk zijn van seksuele activiteiten waarbij internet betrokken is, waaronder het kijken naar pornografie, online seksuele gesprekken voeren, enz. Alleen gebruiken om te verwijzen naar personen die zichzelf omschrijven als seksverslaafden op het internet, niet naar personen wiens seksuele praktijken door anderen als promiscue of excessief beschouwd worden"},{"@language":"sv","@value":"Hbtq+-personer som upplever beroende eller beroendeproblematik kopplad till sexuella aktiviteter via internet, såsom att titta på pornografi eller delta i sexuella samtal online. Används endast för personer som själva beskriver sig som att de har ett internetrelaterat sexberoende och inte för personer vars sexuella praktiker uppfattas som promiskuösa eller överdrivna av andra."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001283"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/internetSexAddiction"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-03"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001286","dc:identifier":"homoit0001286","skos:prefLabel":[{"@language":"en","@value":"Sexual autonomy"},{"@language":"es","@value":"Autonomía sexual"},{"@language":"nl","@value":"Seksuele autonomie"},{"@language":"sv","@value":"Sexuell autonomi"}],"rdfs:comment":[{"@language":"en","@value":"One’s ability or prerogative to freely choose when, with whom, and under what circumstances they engage in sexual activity or relationships."},{"@language":"es","@value":"La capacidad o prerrogativa de una persona para elegir libremente cuándo, con quién y bajo qué circunstancias participar en actividades o relaciones sexuales."},{"@language":"nl","@value":"Iemands vermogen of recht om vrij te kiezen wanneer, met wie en onder welke omstandigheden zij seksuele activiteiten of relaties aangaan."},{"@language":"sv","@value":"En persons förmåga eller rätt att fritt välja när, med vem och under vilka omständigheter hen har sex eller inleder sexuella relationer."}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001300"},{"@id":"https://homosaurus.org/v5/homoit0001306"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001286"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sexualAutonomy"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001326","dc:identifier":"homoit0001326","skos:prefLabel":[{"@language":"en","@value":"Sodomy laws"},{"@language":"es","@value":"Leyes de sodomía"},{"@language":"nl","@value":"Sodomiewetgeving"},{"@language":"sv","@value":"Sodomilagar"}],"skos:altLabel":[{"@language":"es","@value":"Leyes sobre sodomía"},{"@language":"sv","@value":"Antigaylagstiftning"},{"@language":"sv","@value":"18 kap. 10 § strafflagen"},{"@language":"sv","@value":"Antihomosexuella lagar"},{"@language":"sv","@value":"Kriminaliserat samkönat sex"}],"rdfs:comment":[{"@language":"en","@value":"Laws and regulations regarding the legality of sodomy, particularly in the United States, Great Britain, and/or former British colonies."},{"@language":"es","@value":"Leyes y regulaciones relativas a la legalidad de la sodomía, particularmente en los Estados Unidos, Gran Bretaña y/o antiguas colonias británicas."},{"@language":"nl","@value":"Wetten en regelgeving betreffende de legaliteit van sodomie, met name in de Verenigde Staten, Groot-Brittannië en/of voormalige Britse koloniën."},{"@language":"sv","@value":"Lagar och förordningar som rör kriminalisering eller legalitet av sodomi, särskilt i USA, Storbritannien och tidigare brittiska kolonier."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001289"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001325"},{"@id":"https://homosaurus.org/v5/homoit0002373"},{"@id":"https://homosaurus.org/v5/homoit0002380"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2013003497"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000702"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sodomyLaws"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001489","dc:identifier":"homoit0001489","skos:prefLabel":[{"@language":"en","@value":"Vaginismus"},{"@language":"es","@value":"Vaginismo"},{"@language":"nl","@value":"Vaginisme"},{"@language":"sv","@value":"Vaginism"}],"skos:altLabel":[{"@language":"en","@value":"Vaginism"},{"@language":"sv","@value":"Slidkramp"},{"@language":"sv","@value":"Vaginism"},{"@language":"sv","@value":"Vestibulit"},{"@language":"sv","@value":"Vulvodyni"}],"rdfs:comment":[{"@language":"en","@value":"A condition characterized by painful, spasmodic contractions of the vagina in response to physical contact, pressure, or insertion."},{"@language":"es","@value":"Una condición caracterizada por contracciones espasmódicas y dolorosas de la vagina en respuesta al contacto físico, la presión o la inserción."},{"@language":"nl","@value":"Een aandoening die wordt gekenmerkt door pijnlijke, krampachtige samentrekkingen van de vagina als reactie op fysiek contact, druk of inbrenging."},{"@language":"sv","@value":"Ett tillstånd som kännetecknas av smärtsamma, krampartade sammandragningar i slidan vid fysisk beröring, tryck eller penetration."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001291"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001488"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85141761"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001291"},"dc:replaces":{"@id":"http://homosaurus.org/v2/vaginismus"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001632","dc:identifier":"homoit0001632","skos:prefLabel":[{"@language":"en","@value":"Megasexuality"},{"@language":"es","@value":"Megasexualidad"},{"@language":"nl","@value":"Megaseksualiteit"},{"@language":"sv","@value":"Megasexualitet"}],"rdfs:comment":[{"@language":"en","@value":"A sexual orientation generally characterized by a person's lack of emotional connection to other people unless or until they have formed a strong sexual connection with them first."},{"@language":"es","@value":"Una orientación sexual generalmente caracterizada por la falta de conexión emocional de una persona con otras personas a menos que, o hasta que, primero esa persona haya formado una fuerte conexión sexual con ellas."},{"@language":"nl","@value":"Een seksuele oriëntatie die over het algemeen wordt gekenmerkt door het ontbreken van een emotionele band met andere mensen, tenzij of totdat zij eerst een sterke seksuele band met hen hebben gevormd"},{"@language":"sv","@value":"En sexuell läggning som generellt kännetecknas av att en person inte upplever starka känslomässiga band till andra om de inte först har utvecklat ett starkt sexuell band."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001295"},{"@id":"https://homosaurus.org/v5/homoit0001298"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001302"},{"@id":"https://homosaurus.org/v5/homoit0001633"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001295"},"dc:replaces":{"@id":"http://homosaurus.org/v2/megasexuality"},"dc:issued":{"@type":"xsd:date","@value":"2020-12-11"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002276","dc:identifier":"homoit0002276","skos:prefLabel":[{"@language":"en","@value":"Sapphic identity"},{"@language":"es","@value":"Identidad sáfica"},{"@language":"nl","@value":"Sapphische identiteit"},{"@language":"sv","@value":"Sapfisk identitet"}],"skos:altLabel":[{"@language":"en","@value":"Sapphist identity"},{"@language":"es","@value":"Identidad safista"}],"rdfs:comment":[{"@language":"en","@value":"Sexual identity or sexuality term used to describe women and, in some definitions, non-binary people who are sapphic, or attracted to women. Only use to describe individuals who describe their identity as sapphic."},{"@language":"es","@value":"Término de identidad sexual o de sexualidad utilizado para describir a mujeres y, en algunas definiciones, a personas no binarias que son sáficas o que se ven atraídas por mujeres. Utilícese únicamente para describir a personas que describen su identidad como sáfica."},{"@language":"nl","@value":"Seksuele identiteit of seksuele term die wordt gebruikt om vrouwen te beschrijven en, in sommige definities, niet-binaire personen die sapphisch zijn of zich aangetrokken voelen tot vrouwen. Alleen gebruiken om personen te beschrijven die hun identiteit als sapphisch omschrijven."},{"@language":"sv","@value":"Sexuell identitet eller läggning som används för att beskriva kvinnor och, i vissa definitioner, ickebinära personer som är sapfiska, det vill säga attraherade av kvinnor. Används endast för personer som själva beskriver sin identitet som sapfisk."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001295"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0002277"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001295"},"dc:issued":{"@type":"xsd:date","@value":"2022-11-08"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001406","dc:identifier":"homoit0001406","skos:prefLabel":[{"@language":"en","@value":"Transgender culture"},{"@language":"es","@value":"Cultura transgénero"},{"@language":"de","@value":"trans Kultur"},{"@language":"nl","@value":"Transgender cultuur"},{"@language":"sv","@value":"Transkultur"}],"rdfs:comment":[{"@language":"en","@value":"Cultural experiences shared by members of transgender communities or products of transgender culture (e.g., art and media created by and for transgender people, activism focused on transgender issues, slang commonly used in transgender communities, etc.)."},{"@language":"es","@value":"Experiencias culturales compartidas por miembros de comunidades transgénero o productos de la cultura transgénero (por ejemplo, arte y medios creados por y para personas transgénero, activismo centrado en cuestiones transgénero, jerga comúnmente utilizada en comunidades transgénero, etc.)."},{"@language":"de","@value":"Bezieht sich auf kulturelle Erfahrungen, die Mitglieder der trans Gemeinschaft teilen, oder auf Produkte der trans Kultur (z. B. Kunst und Medien, die von und für trans Personen geschaffen wurden, Aktivismus mit Schwerpunkt auf trans Themen, in trans Gemeinschaften gebräuchliche Slangausdrücke usw.)."},{"@language":"nl","@value":"Gebruik om culturele ervaringen te beschrijven die worden gedeeld door leden van transgender gemeenschappen of producten van transgendercultuur (bijv. kunst en media gemaakt door en voor transgenderpersonen, activisme gericht op transgenderkwesties, jargon dat veel wordt gebruikt in transgendergemeenschappen, enz.)."},{"@language":"sv","@value":"Kulturella erfarenheter som delas av medlemmar i transgemenskaper eller produkter av transkultur, till exempel konst och medier skapade av och för transpersoner, aktivism med fokus på transfrågor eller slang som används inom transgemenskaper."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001831"},"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0001445"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001295"},{"@id":"https://homosaurus.org/v5/homoit0001832"},{"@id":"https://homosaurus.org/v5/homoit0001833"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transgenderCulture"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001375","dc:identifier":"homoit0001375","skos:prefLabel":[{"@language":"zh","@value":"Tongzhi"},{"@language":"es","@value":"Tongzhi"},{"@language":"nl","@value":"Tongzhi"},{"@language":"sv","@value":"Tongzhi"}],"skos:altLabel":[{"@language":"zh","@value":"Tongzhis"},{"@language":"es","@value":"Tongzhis"}],"rdfs:comment":[{"@language":"en","@value":"Contemporary term for LGBTQ+ people in China and Taiwan."},{"@language":"es","@value":"Término contemporáneo para las personas LGBTQ+ en China y Taiwán."},{"@language":"sv","@value":"Moderna term för hbtq+-personer i Kina och Taiwan."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001297"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001297"},"dc:replaces":{"@id":"http://homosaurus.org/v2/tongzhi"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001627","dc:identifier":"homoit0001627","skos:prefLabel":[{"@language":"en","@value":"Greysexual people"},{"@language":"es","@value":"Personas grissexuales"},{"@language":"fr","@value":"Personnes grissexuelles"},{"@language":"nl","@value":"Grijsseksuele personen"},{"@language":"sv","@value":"Gråsexuella personer"}],"skos:altLabel":[{"@language":"en","@value":"Graysexual people"},{"@language":"en","@value":"Grey-sexual people"},{"@language":"en","@value":"Gray-sexual people"},{"@language":"fr","@value":"Personnes gris sexuelles"},{"@language":"fr","@value":"A-gris"},{"@language":"fr","@value":"A-grises"},{"@language":"fr","@value":"Personnes graysexuelles"},{"@language":"fr","@value":"Personnes greysexuelles"},{"@language":"fr","@value":"Greysexuel"},{"@language":"fr","@value":"Greysexuelle"},{"@language":"fr","@value":"Graysexuel"},{"@language":"fr","@value":"Graysexuelle"},{"@language":"nl","@value":"Greyseksuele mensen"},{"@language":"nl","@value":"Grijsseksuelen"},{"@language":"sv","@value":"Greysexual-personer"}],"rdfs:comment":[{"@language":"en","@value":"People who experience infrequent, rare, or low-intensity sexual attraction."},{"@language":"es","@value":"Personas que experimentan una atracción sexual infrecuente, rara o de baja intensidad."},{"@language":"fr","@value":"Personnes qui éprouvent une attirance sexuelle peu fréquente, rare ou de faible intensité."},{"@language":"nl","@value":"Mensen die onregelmatige, zeldzame of lage intensiteit seksuele aantrekkingskracht ervaren"},{"@language":"sv","@value":"Personer som upplever sexuell attraktion som är sällsynt, lågintensiv eller mycket sällan förekommande."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001297"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001626"},{"@id":"https://homosaurus.org/v5/homoit0001987"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001297"},"dc:replaces":{"@id":"http://homosaurus.org/v2/greysexualPeople"},"dc:issued":{"@type":"xsd:date","@value":"2020-12-11"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001626","dc:identifier":"homoit0001626","skos:prefLabel":[{"@language":"en","@value":"Greysexuality"},{"@language":"es","@value":"Grissexualidad"},{"@language":"fr","@value":"Grissexualité"},{"@language":"nl","@value":"Grijze seksualiteit"},{"@language":"sv","@value":"Gråsexualitet"}],"skos:altLabel":[{"@language":"en","@value":"Graysexuality"},{"@language":"en","@value":"Grey-sexuality"},{"@language":"en","@value":"Gray-sexuality"},{"@language":"fr","@value":"Asexualité grise"},{"@language":"fr","@value":"Sexualité grise"},{"@language":"fr","@value":"Gris sexualité"},{"@language":"fr","@value":"Gris-sexualité"},{"@language":"fr","@value":"Gris-asexualité"},{"@language":"nl","@value":"Grey seksualiteit"},{"@language":"nl","@value":"Greyseksualiteit"},{"@language":"sv","@value":"Greysexuality"}],"rdfs:comment":[{"@language":"en","@value":"A sexual orientation generally characterized by infrequent, rare, or low-intensity sexual attraction."},{"@language":"es","@value":"Orientación sexual caracterizada generalmente por una atracción sexual poco frecuente, rara o de baja intensidad."},{"@language":"fr","@value":"Orientation sexuelle généralement caractérisée par une attirance sexuelle peu fréquente, rare ou de faible intensité."},{"@language":"nl","@value":"Een seksuele oriëntatie die over het algemeen wordt gekenmerkt door niet-frequente, zeldzame of lage intensiteit van seksuele aantrekkingskracht"},{"@language":"sv","@value":"Sexuell läggning som generellt kännetecknas av sällsynt, lågintensiv eller mycket sällan förekommande sexuell attraktion."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001298"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001627"},{"@id":"https://homosaurus.org/v5/homoit0001988"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001298"},"dc:replaces":{"@id":"http://homosaurus.org/v2/greysexuality"},"dc:issued":{"@type":"xsd:date","@value":"2020-12-11"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001828","dc:identifier":"homoit0001828","skos:prefLabel":[{"@language":"en","@value":"Romantic orientation"},{"@language":"es","@value":"Orientación romántica"},{"@language":"nl","@value":"Romantische oriëntatie"},{"@language":"sv","@value":"Romantisk orientering"}],"rdfs:comment":[{"@language":"en","@value":"The direction or nature of an individual's romantic attraction toward others."},{"@language":"es","@value":"La dirección o naturaleza de la atracción romántica de una personas hacia otras."},{"@language":"nl","@value":"De richting of aard van de romantische aantrekkingskracht van een persoon op anderen"},{"@language":"sv","@value":"Riktningen eller typen av romantisk attraktion en individ upplever gentemot andra."}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0001644"},{"@id":"https://homosaurus.org/v5/homoit0001791"},{"@id":"https://homosaurus.org/v5/homoit0001792"},{"@id":"https://homosaurus.org/v5/homoit0001793"},{"@id":"https://homosaurus.org/v5/homoit0001794"},{"@id":"https://homosaurus.org/v5/homoit0001795"},{"@id":"https://homosaurus.org/v5/homoit0001986"},{"@id":"https://homosaurus.org/v5/homoit0001988"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001298"},{"@id":"https://homosaurus.org/v5/homoit0001636"},{"@id":"https://homosaurus.org/v5/homoit0001829"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001828"},"dc:issued":{"@type":"xsd:date","@value":"2022-02-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001344","dc:identifier":"homoit0001344","skos:prefLabel":[{"@language":"en","@value":"Striptease"},{"@language":"es","@value":"Estriptís"},{"@language":"fr","@value":"Effeuillage"},{"@language":"nl","@value":"Striptease"},{"@language":"sv","@value":"Striptease"}],"skos:altLabel":[{"@language":"es","@value":"Striptease"},{"@language":"es","@value":"Desnudarse"},{"@language":"es","@value":"Estriptis"},{"@language":"fr","@value":"Striptease"},{"@language":"fr","@value":"Strip-tease"},{"@language":"sv","@value":"Striptease-dans"}],"rdfs:comment":[{"@language":"en","@value":"A form of erotic dance during which the performer gradually undresses in a seductive and sexually suggestive manner."},{"@language":"es","@value":"Una forma de danza erótica durante la cual la persona que lo interpreta se desnuda gradualmente de una manera seductora y sexualmente sugerente."},{"@language":"fr","@value":"Danse érotique au cours de laquelle l'interprète se déshabille progressivement de manière séduisante et sexuellement suggestive."},{"@language":"nl","@value":"Een erotische dans waarbij de performer zich geleidelijk aan uitkleedt op een verleidelijke en seksueel suggestieve manier"},{"@language":"sv","@value":"En form av erotisk dans där artisten gradvis klär av sig på ett förföriskt och sexuellt anspelande sätt."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001299"},{"@id":"https://homosaurus.org/v5/homoit0001363"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85129138"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001299"},"dc:replaces":{"@id":"http://homosaurus.org/v2/striptease"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001628","dc:identifier":"homoit0001628","skos:prefLabel":[{"@language":"en","@value":"Hard swap"},{"@language":"es","@value":"Intercambio duro"},{"@language":"de","@value":"Hard Swap"},{"@language":"nl","@value":"Hard swap"},{"@language":"sv","@value":"Hard swap"}],"skos:altLabel":[{"@language":"es","@value":"Hard swap"},{"@language":"es","@value":"Intercambio de pareja duro"}],"rdfs:comment":[{"@language":"en","@value":"A term used in the swinging community to describe a type of partner swapping in which sexual activities happen in different spaces or rooms where partners may not necessarily be in sight of each other."},{"@language":"es","@value":"Un término utilizado en la comunidad swinger para describir un tipo de intercambio de pareja en el que las actividades sexuales ocurren en diferentes espacios o habitaciones donde las parejas no necesariamente están a la vista."},{"@language":"de","@value":"Ein Begriff, der in der Swinger-Szene verwendet wird, um eine Form des Partnertauschs zu beschreiben, bei der sexuelle Handlungen in verschiedenen Räumen stattfinden, in denen sich die Partner nicht gegenseitig sehen können."},{"@language":"nl","@value":"Een term die in de swing-gemeenschap wordt gebruikt om een type partnerruil te beschrijven waarbij seksuele activiteiten plaatsvinden in verschillende ruimtes of kamers, waar niet alle partners noodzakelijkerwijs elkaar kunnen zien."},{"@language":"sv","@value":"Term som används inom swingers-kulturen för att beskriva partnerbyte där de sexuella aktiviteterna sker i separata rum eller utrymmen där partnerna inte nödvändigtvis ser varandra."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001299"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001640"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001299"},"dc:replaces":{"@id":"http://homosaurus.org/v2/hardSwap"},"dc:issued":{"@type":"xsd:date","@value":"2020-12-11"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001640","dc:identifier":"homoit0001640","skos:prefLabel":[{"@language":"en","@value":"Soft swap"},{"@language":"es","@value":"Intercambio suave"},{"@language":"nl","@value":"Soft swap"},{"@language":"sv","@value":"Soft swap"}],"skos:altLabel":[{"@language":"es","@value":"Intercambio de parejas suave"},{"@language":"es","@value":"Soft swap"}],"rdfs:comment":[{"@language":"en","@value":"A term used in the swinging community to describe a type of partner swap in which sexual activities happen in the same shared space so that all partners are within sight of one another."},{"@language":"es","@value":"Un término utilizado en la comunidad swinger para describir un tipo de intercambio de pareja en el que las actividades sexuales ocurren en el mismo espacio compartido de modo que todas las parejas estén a la vista la una de la otra."},{"@language":"nl","@value":"Een term die in de swing-gemeenschap wordt gebruikt om een type partnerruil te beschrijven waarbij seksuele activiteiten plaatsvinden in dezelfde gedeelde ruimte, zodat alle partners elkaar kunnen zien."},{"@language":"sv","@value":"Term som används inom swinging-kulturen för att beskriva en form av partnerbyte där alla sexuella aktiviteter sker i samma rum så att alla deltagare är synliga för varandra."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001299"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001628"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001299"},"dc:replaces":{"@id":"http://homosaurus.org/v2/softSwap"},"dc:issued":{"@type":"xsd:date","@value":"2020-12-11"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003072","dc:identifier":"homoit0003072","skos:prefLabel":[{"@language":"en","@value":"Body worship"},{"@language":"es","@value":"Adoración corporal"},{"@language":"de","@value":"Body-Worship"},{"@language":"nl","@value":"Aanbidding van het lichaam"},{"@language":"sv","@value":"Kroppsdyrkan"}],"rdfs:comment":[{"@language":"en","@value":"Any practice of revering another’s physical body, usually in a sexual context."},{"@language":"es","@value":"Cualquier práctica de reverenciar el cuerpo físico de otra persona, generalmente en un contexto sexual."},{"@language":"de","@value":"Jede Praxis, den Körper eines anderen zu verehren, meist in einem sexuellen Kontext."},{"@language":"nl","@value":"Het aanbidden van het fysieke lichaam van een ander, meestal in een seksuele context."},{"@language":"sv","@value":"Alla praktiker där en annan persons fysiska kropp dyrkas, oftast i ett sexuellt sammanhang."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001299"},"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0003051"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001654"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001299"},"dc:issued":{"@type":"xsd:date","@value":"2023-12-18"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001641","dc:identifier":"homoit0001641","skos:prefLabel":[{"@language":"en","@value":"Swinging"},{"@language":"es","@value":"Intercambio de parejas"},{"@language":"nl","@value":"Swingen"},{"@language":"sv","@value":"Swinging"}],"skos:altLabel":[{"@language":"en","@value":"Wife swapping"},{"@language":"en","@value":"Husband swapping"},{"@language":"en","@value":"Partner swapping"},{"@language":"es","@value":"Swinging"},{"@language":"es","@value":"Intercambio de esposo"},{"@language":"es","@value":"Intercambio de esposa"}],"rdfs:comment":[{"@language":"en","@value":"An agreement, sexual practice, or relationship in which a couple engages in group sex or the swapping of sexual partners within a group, often on a habitual basis."},{"@language":"es","@value":"Un acuerdo, una práctica sexual o una relación en la que una pareja mantiene relaciones sexuales en grupo o intercambia parejas sexuales dentro de un grupo, a menudo de forma habitual."},{"@language":"nl","@value":"Een overeenkomst of seksuele praktijk in een relatie waarbij een paar groepsseks heeft of binnen een groep van seksuele partner wisselt"},{"@language":"sv","@value":"En överenskommelse, sexuell praktik eller relation där ett par deltar i gruppsex eller byter sexuella partners inom en grupp, ofta återkommande."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001629"},{"@id":"https://homosaurus.org/v5/homoit0001651"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001299"},{"@id":"https://homosaurus.org/v5/homoit0001656"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001636"},"dc:replaces":{"@id":"http://homosaurus.org/v2/swinging"},"dc:issued":{"@type":"xsd:date","@value":"2020-12-11"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001917","dc:identifier":"homoit0001917","skos:prefLabel":[{"@language":"en","@value":"Allosexual people"},{"@language":"es","@value":"Personas alosexuales"},{"@language":"de","@value":"Allosexuelle Personen"},{"@language":"nl","@value":"Alloseksuele personen"},{"@language":"sv","@value":"Allosexuella"}],"rdfs:comment":[{"@language":"en","@value":"Individuals who generally experience sexual attraction or the desire for partnered sexual experiences."},{"@language":"es","@value":"Personas que generalmente experimentan atracción sexual o deseo de tener experiencias sexuales en pareja."},{"@language":"de","@value":"Personen, die allgemein sexuelle Anziehung oder den Wunsch nach partnerschaftlicher sexueller Erfahrung verspüren."},{"@language":"nl","@value":"Personen die over het algemeen seksuele aantrekkingskracht of het verlangen naar seksuele ervaringen met partners ervaren"},{"@language":"sv","@value":"Personer som generellt upplever sexuell attraktion eller önskan om sexuella upplevelser med en eller flera partner."}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001300"},{"@id":"https://homosaurus.org/v5/homoit0001302"},{"@id":"https://homosaurus.org/v5/homoit0001531"},{"@id":"https://homosaurus.org/v5/homoit0001535"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001917"},"dc:issued":{"@type":"xsd:date","@value":"2022-03-31"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003738","dc:identifier":"homoit0003738","skos:prefLabel":[{"@language":"en","@value":"Sexual fluidity"},{"@language":"nl","@value":"Seksuele fluïditeit"},{"@language":"sv","@value":"Sexuell fluiditet"}],"skos:altLabel":{"@language":"sv","@value":"Sexuell rörlighet"},"rdfs:comment":[{"@language":"en","@value":"The idea that a person's sexual orientation can change over time or in different situations."},{"@language":"nl","@value":"Het idee dat iemands seksuele oriëntatie in de loop van de tijd of in verschillende situaties kan veranderen."},{"@language":"sv","@value":"Idén att en persons sexuella läggning kan förändras över tid eller i olika situationer."}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001306"},{"@id":"https://homosaurus.org/v5/homoit0001300"},{"@id":"https://homosaurus.org/v5/homoit0001315"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0003738"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003433","dc:identifier":"homoit0003433","skos:prefLabel":[{"@language":"en","@value":"Child sexual abuse content"},{"@language":"de","@value":"Inhalte zu sexuellem Kindesmissbrauch"},{"@language":"es","@value":"Contenido de abuso sexual infantil"},{"@language":"nl","@value":"Materiaal met seksueel misbruik van kinderen"},{"@language":"sv","@value":"Dokumenterade sexuella övergrepp på barn"}],"skos:altLabel":[{"@language":"en","@value":"CSA content"},{"@language":"en","@value":"CSA materials"},{"@language":"en","@value":"Child pornography"},{"@language":"en","@value":"Child sexual abuse materials"},{"@language":"de","@value":"CSAM"},{"@language":"es","@value":"Contenido de abuso sexual contra menores"},{"@language":"nl","@value":"Kinderpornografie"},{"@language":"sv","@value":"Barnpornografi"}],"rdfs:comment":[{"@language":"en","@value":"Images and videos that show children and youth who are under the age of consent engaged in sexual activities. While this term is not otherwise within the scope of the Homosaurus vocabulary, it is provided as an alternative to commonly used terms such as \"Child pornography\" in order to highlight that the production of such materials is a direct product of and contributes to the sexual abuse of children."},{"@language":"de","@value":"Bilder und Videos, die Kinder und Minderjährige bei sexuellen Handlungen zeigen. Dieser Begriff fällt zwar nicht in den Rahmen des Homosaurus-Vokabulars, wird jedoch als Alternative zu häufig verwendeten Begriffen wie „Kinderpornografie” angeboten, um zu verdeutlichen, dass die Produktion solcher Materialien eine direkte Folge des sexuellen Missbrauchs von Kindern ist und zu diesem beiträgt."},{"@language":"es","@value":"Imágenes y vídeos que muestran a niños y jóvenes menores a la edad de consentimiento participando en actividades sexuales. Aunque este término no entra en el ámbito del vocabulario de Homosaurus, se ofrece como alternativa a términos de uso común como «pornografía infantil» con el fin de resaltar que la producción de tales materiales es un producto directo del abuso sexual de menores y contribuye al mismo."},{"@language":"nl","@value":"Afbeeldingen en video's die kinderen en jongeren tonen die jonger zijn dan de leeftijd voor seksuele meerderjarigheid en die seksuele activiteiten ondernemen. Hoewel deze term niet anderszins binnen de reikwijdte van de Homosaurus-vocabulaire valt, wordt deze getoond als alternatief voor veelgebruikte termen zoals 'Kinderpornografie' om te benadrukken dat de productie van dergelijke materialen een direct product is van en bijdraagt ​​aan seksueel misbruik van kinderen."},{"@language":"sv","@value":"Bilder och videor som visar barn och ungdomar under samtyckesåldern engagerade i sexuella aktiviteter. Denna term ingår vanligtvis inte i Homosaurus-vokabulären men tillhandahålls som ett alternativ till ofta använda termer såsom ”barnpornografi” för att betona att produktionen av sådant material är en direkt produkt av och bidrar till sexuella övergrepp mot barn."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001305"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85023536"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001305"},"dc:issued":{"@type":"xsd:date","@value":"2024-07-21"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003613","dc:identifier":"homoit0003613","skos:prefLabel":[{"@language":"en","@value":"Women's sexuality"},{"@language":"nl","@value":"Seksualiteit van vrouwen"},{"@language":"sv","@value":"Kvinnors sexualitet"}],"skos:altLabel":{"@language":"en","@value":"Female sexuality"},"rdfs:comment":[{"@language":"en","@value":"Term used to describe the ways in which women experience and express themselves sexually, including the types of people and practices they are sexually interested in."},{"@language":"nl","@value":"Term die wordt gebruikt om de manieren te beschrijven waarop vrouwen zichzelf seksueel ervaren en uiten, inclusief de typen personen en praktijken waarin ze seksueel geïnteresseerd zijn."},{"@language":"sv","@value":"Term som beskriver hur kvinnor upplever och uttrycker sin sexualitet, inklusive vilka personer och praktiker de är sexuellt intresserade av."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001306"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0002279"},{"@id":"https://homosaurus.org/v5/homoit0001510"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001306"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-22"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002350","dc:identifier":"homoit0002350","skos:prefLabel":[{"@language":"en","@value":"Siblings of LGBTQ+ people"},{"@language":"es","@value":"Hermanos de personas LGBTQ+"},{"@language":"nl","@value":"Broers en zusters van LHBTQ+-personen"},{"@language":"sv","@value":"Syskon till hbtq+-personer"}],"skos:altLabel":[{"@language":"es","@value":"Hermanas de personas LGBTQ+"},{"@language":"es","@value":"Hermanxs de personas LGBTQ+"}],"rdfs:comment":[{"@language":"en","@value":"People who share a sibling relationship with one or more LGBTQ+ person. For siblings who are themselves LGBTQ+, use the term \"LGBTQ+ siblings.\""},{"@language":"es","@value":"Personas que comparten una relación de hermanos con una o más personas LGBTQ+. Para hermanos que son LGBTQ+, utilice el término \"hermanos LGBTQ+\"."},{"@language":"nl","@value":"Personen die een broer/zusrelatie hebben met een of meer LHBTQ+-personen. Voor broers en zusters die zelf LHBTQ+ zijn, gebruik de term 'LHBTQ+-broers en zusters'."},{"@language":"sv","@value":"Personer som är syskon till en eller flera hbtq+-personer. För syskon som själva är hbtq+ används termen ”Syskon (hbtq+)”."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001310"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000421"},"dc:issued":{"@type":"xsd:date","@value":"2022-12-13"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001445","dc:identifier":"homoit0001445","skos:prefLabel":[{"@language":"en","@value":"Transgender slang"},{"@language":"es","@value":"Jerga transgénero"},{"@language":"nl","@value":"Transgender taal"},{"@language":"sv","@value":"Transslang"}],"skos:altLabel":{"@language":"es","@value":"Argot transgénero"},"rdfs:comment":[{"@language":"en","@value":"Colloquial or informal language related to transgender identity or used by transgender people."},{"@language":"es","@value":"Lenguaje coloquial o informal relacionado con la identidad transgénero o utilizado por personas transgénero."},{"@language":"nl","@value":"Omgangstaal of informele taal met betrekking tot transgender identiteit of gebruikt door transgender personen."},{"@language":"sv","@value":"Vardagligt eller informellt språkbruk relaterat till transidentitet eller som används av transpersoner."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001317"},{"@id":"https://homosaurus.org/v5/homoit0001406"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001317"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transgenderSlang"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002789","dc:identifier":"homoit0002789","skos:prefLabel":[{"@language":"en","@value":"Asexual slang"},{"@language":"es","@value":"Argot asexual"},{"@language":"de","@value":"Asexueller Slang"},{"@language":"nl","@value":"Aseksuele taal"},{"@language":"sv","@value":"Asexuell slang"}],"skos:altLabel":[{"@language":"de","@value":"Ace Slang"},{"@language":"sv","@value":"Ace-slang"}],"rdfs:comment":[{"@language":"en","@value":"Colloquial or informal language related to asexual identity or used by asexual people."},{"@language":"es","@value":"Lenguaje coloquial o informal en relación a la identidad asexual o utilizado por personas asexuales."},{"@language":"de","@value":"Umgangsprachliche oder informelle Sprache, die sich auf Asexualität bezieht oder von asexuellen Personen verwendet wird."},{"@language":"nl","@value":"Omgangstaal of informele taal met betrekking tot biseksualiteit of gebruikt door aseksuele personen."},{"@language":"sv","@value":"Vardagligt eller informellt språkbruk relaterat till asexuell identitet eller som används av asexuella personer."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001317"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0002788"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001317"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002940","dc:identifier":"homoit0002940","skos:prefLabel":[{"@language":"en","@value":"Intersex slang"},{"@language":"de","@value":"Inter* Slang"},{"@language":"es","@value":"Jerga intersexual"},{"@language":"nl","@value":"Intersekse taal"},{"@language":"sv","@value":"Intersexslang"}],"skos:altLabel":{"@language":"es","@value":"Argot intersex"},"rdfs:comment":[{"@language":"en","@value":"Colloquial or informal language related to intersex identity or used by intersex people."},{"@language":"de","@value":"Umgangsprachliche oder informelle Sprache, die sich auf inter* Identität bezieht oder von inter* Personen verwendet wird."},{"@language":"es","@value":"Lenguaje coloquial o informal relacionado con la identidad intersex o utilizado por personas intersex."},{"@language":"nl","@value":"Omgangstaal of informele taal met betrekking tot of gebruikt door intersekse personen."},{"@language":"sv","@value":"Vardagligt eller informellt språkbruk relaterat till intersexidentitet eller som används av intersexpersoner."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001317"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001317"},"dc:issued":{"@type":"xsd:date","@value":"2023-09-29"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002158","dc:identifier":"homoit0002158","skos:prefLabel":[{"@language":"en","@value":"Fandom terminology"},{"@language":"es","@value":"Terminología de fandom"},{"@language":"de","@value":"Fandom-Terminologie"},{"@language":"nl","@value":"Fandom terminologie"},{"@language":"sv","@value":"Fandom-terminologi"}],"skos:altLabel":[{"@language":"en","@value":"Fan terminology"},{"@language":"en","@value":"Fan terms"},{"@language":"en","@value":"Fandom terms"},{"@language":"es","@value":"Terminología fan"},{"@language":"es","@value":"Términos fan"},{"@language":"es","@value":"Términos de fandom"},{"@language":"de","@value":"Fandom-Begriffe"},{"@language":"nl","@value":"Fan-terminologie"},{"@language":"nl","@value":"Fandom-termen"}],"rdfs:comment":[{"@language":"en","@value":"Jargon or slang commonly used in fan communities, such as \"slash\" and \"shipping.\""},{"@language":"es","@value":"Jerga o argot comúnmente utilizado en las comunidades de fans, tales como \"slash\" y \"shippeo\""},{"@language":"de","@value":"In Fan-Communitys häufig verwendete Fachbegriffe oder Slangausdrücke wie „Slash“ und „Shipping“."},{"@language":"nl","@value":"Jargon of argot dat veel wordt gebruikt in fan-gemeenschappen, zoals 'slash' en 'shipping'"},{"@language":"sv","@value":"Jargong eller slang som ofta används i fangemenskaper, såsom ”slash” och ”shipping”."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002156"},"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0002208"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001317"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002208","dc:identifier":"homoit0002208","skos:prefLabel":[{"@language":"en","@value":"Slash terminology"},{"@language":"es","@value":"Terminología slash"},{"@language":"nl","@value":"Slash terminologie"},{"@language":"sv","@value":"Slash-terminologi"}],"skos:altLabel":[{"@language":"en","@value":"Slash terms"},{"@language":"es","@value":"Términos slash"},{"@language":"es","@value":"Términos de slash"}],"rdfs:comment":[{"@language":"en","@value":"Slang relating to fanworks about sexual or romantic relationships between characters of the same sex or gender. Historically used for male-male couples only, but is now used more broadly; includes femslash terminology."},{"@language":"es","@value":"Jerga relacionada con obras de fans sobre relaciones sexuales o románticas entre personajes del mismo sexo o género. Históricamente se utilizaba únicamente para parejas de hombres, pero ahora se utiliza de forma más amplia; incluye terminología femslash."},{"@language":"nl","@value":"Argot met betrekking tot fanwerken over seksuele of romantische relaties tussen personages van hetzelfde geslacht of gender. Van oudsher alleen gebruikt voor man-man koppels, maar wordt nu breder gebruikt; omvat femslash-terminologie"},{"@language":"sv","@value":"Slang relaterad till fanverk om sexuella eller romantiska relationer mellan karaktärer av samma kön eller könsidentitet. Termen användes ursprungligen för man/man-par men används numera bredare och inkluderar femslash-termer."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0002158"},{"@id":"https://homosaurus.org/v5/homoit0002203"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001317"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002724","dc:identifier":"homoit0002724","skos:prefLabel":[{"@language":"en","@value":"Two-Spirit slang"},{"@language":"es","@value":"Jerga dos espíritus"},{"@language":"nl","@value":"Two-Spirit taal"},{"@language":"sv","@value":"Two-spirit-slang"}],"skos:altLabel":[{"@language":"en","@value":"2S slang"},{"@language":"en","@value":"Two Spirit slang"},{"@language":"en","@value":"Two Spirited slang"},{"@language":"en","@value":"Two-Spirited slang"},{"@language":"es","@value":"Argot dos espíritus"}],"rdfs:comment":[{"@language":"en","@value":"Colloquial or informal language related to Two-Spirit identity or used by Two-Spirit people."},{"@language":"es","@value":"Lenguaje coloquial o informal en relación a la identidad dos espíritus o utilizado por personas dos espíritus."},{"@language":"nl","@value":"Omgangstaal of informele taal met betrekking tot of gebruikt door Two-Spirit people."},{"@language":"sv","@value":"Vardagligt eller informellt språkbruk relaterat till Two-spirit-identitet eller som används av Two-spirit-personer."}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001317"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0002724"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-27"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003515","dc:identifier":"homoit0003515","skos:prefLabel":[{"@language":"en","@value":"Lavender linguistics"},{"@language":"de","@value":"Lavender Linguistics"},{"@language":"es","@value":"Lingüística LGBTQ+"},{"@language":"nl","@value":"Lavender taalkunde"},{"@language":"sv","@value":"Lavendellingvistik"}],"skos:altLabel":[{"@language":"en","@value":"LGBTQ+ linguistics"},{"@language":"en","@value":"Linguistics (LGBTQ)"},{"@language":"de","@value":"LGBTQ+-Linguistik"},{"@language":"de","@value":"Queere Linguistik"},{"@language":"es","@value":"Lavender linguistics"},{"@language":"es","@value":"Lingüística (LGBTQ)"},{"@language":"es","@value":"Lingüística lavanda"},{"@language":"nl","@value":"Taalkunde (LHBTQ+)"}],"rdfs:comment":[{"@language":"en","@value":"The study of language as used by members of LGBTQ+ communities."},{"@language":"de","@value":"Die Untersuchung der Sprache, wie sie von Angehörigen der LGBTQ+-Gemeinschaften verwendet wird."},{"@language":"es","@value":"El estudio del lenguaje utilizado por los miembros de las comunidades LGBTQ+."},{"@language":"nl","@value":"De studie van taalgebruik door leden van LHBTQ+-gemeenschappen."},{"@language":"sv","@value":"Studiet av språk som det används av personer i hbtq+-gemenskaper."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001365"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001317"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001365"},"dc:issued":{"@type":"xsd:date","@value":"2024-07-31"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003520","dc:identifier":"homoit0003520","skos:prefLabel":[{"@language":"en","@value":"Queer linguistics"},{"@language":"nl","@value":"Queer taalkunde"},{"@language":"sv","@value":"Queer lingvistik"}],"rdfs:comment":[{"@language":"en","@value":"A field of linguistics that analyzes the effect of heteronormativity on the expression of sexual identity through language."},{"@language":"nl","@value":"Een vakgebied binnen de taalkunde dat het effect van heteronormativiteit op de expressie van seksuele identiteit door middel van taal analyseert."},{"@language":"sv","@value":"Ett språkvetenskapligt forskningsfält som analyserar hur heteronormativitet påverkar uttrycket av sexuell identitet i språket."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001365"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001317"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001365"},"dc:issued":{"@type":"xsd:date","@value":"2024-07-31"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004316","dc:identifier":"homoit0004316","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ hand signs (Language)"},{"@language":"nl","@value":"LHBTQ+-handgebaren (Taal)"},{"@language":"sv","@value":"Teckenspråkstecken (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"LGBTQ+ hand signs "},{"@language":"nl","@value":"LHBTQ+-autobio's"},{"@language":"nl","@value":"LHBTQ+-memoires"}],"rdfs:comment":[{"@language":"en","@value":"Visual gestural signs used in sign languages to describe LGBTQ+ people, cultures, and related terminology."},{"@language":"nl","@value":"Visuele gebaren die in gebarentalen worden gebruikt om LHBTQ+-personen, -culturen en gerelateerde terminologie te beschrijven."},{"@language":"sv","@value":"Tecken använda i teckenspråk för att beskriva hbtq+-personer, -kulturer och relaterad terminologi."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001878"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001866"},{"@id":"https://homosaurus.org/v5/homoit0001860"},{"@id":"https://homosaurus.org/v5/homoit0001317"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000297"},"dc:issued":{"@type":"xsd:date","@value":"2026-02-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004604","dc:identifier":"homoit0004604","skos:prefLabel":{"@language":"en","@value":"Lesbian submissives"},"skos:altLabel":{"@language":"en","@value":"Lesbian subs"},"rdfs:comment":{"@language":"en","@value":"Lesbians who are part of the BDSM scene and assume the submissive role in sexual relationships with a dominant/submissive dynamic."},"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001318"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0003194"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001295"},"dc:issued":{"@type":"xsd:date","@value":"2026-06-08"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-10"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004606","dc:identifier":"homoit0004606","skos:prefLabel":{"@language":"en","@value":"Asexual submissives"},"skos:altLabel":[{"@language":"en","@value":"Ace submissives"},{"@language":"en","@value":"Asexual subs"},{"@language":"en","@value":"Ace subs"}],"rdfs:comment":{"@language":"en","@value":"Asexual people who are part of the BDSM scene and assume the submissive role in sexual relationships with a dominant/submissive dynamic."},"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001318"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0002991"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001295"},"dc:issued":{"@type":"xsd:date","@value":"2026-06-08"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-10"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004607","dc:identifier":"homoit0004607","skos:prefLabel":{"@language":"en","@value":"Intersex submissives"},"skos:altLabel":{"@language":"en","@value":"Intersex subs"},"rdfs:comment":{"@language":"en","@value":"Intersex people who are part of the BDSM scene and assume the submissive role in sexual relationships with a dominant/submissive dynamic."},"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001318"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0004601"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001295"},"dc:issued":{"@type":"xsd:date","@value":"2026-06-08"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-10"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004608","dc:identifier":"homoit0004608","skos:prefLabel":{"@language":"en","@value":"Non-binary submissives"},"skos:altLabel":[{"@language":"en","@value":"Nonbinary submissives"},{"@language":"en","@value":"Non-binary subs"},{"@language":"en","@value":"Nonbinary subs"}],"rdfs:comment":{"@language":"en","@value":"Non-binary people who are part of the BDSM scene and assume the submissive role in sexual relationships with a dominant/submissive dynamic."},"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001318"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0004602"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001295"},"dc:issued":{"@type":"xsd:date","@value":"2026-06-08"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-10"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004609","dc:identifier":"homoit0004609","skos:prefLabel":{"@language":"en","@value":"Transgender submissives"},"skos:altLabel":[{"@language":"en","@value":"Trans submissives"},{"@language":"en","@value":"Transgender subs"},{"@language":"en","@value":"Trans subs"}],"rdfs:comment":{"@language":"en","@value":"Transgender people who are part of the BDSM scene and assume the submissive role in sexual relationships with a dominant/submissive dynamic."},"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001318"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001420"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001295"},"dc:issued":{"@type":"xsd:date","@value":"2026-06-08"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-10"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004612","dc:identifier":"homoit0004612","skos:prefLabel":{"@language":"en","@value":"Two-Spirit submissives"},"skos:altLabel":[{"@language":"en","@value":"Two Spirit submissives"},{"@language":"en","@value":"Two-Spirited submissives"},{"@language":"en","@value":"Two Spirited submissives"},{"@language":"en","@value":"2S submissives"},{"@language":"en","@value":"Two-Spirit subs"},{"@language":"en","@value":"Two Spirit subs"},{"@language":"en","@value":"Two-Spirited subs"},{"@language":"en","@value":"Two Spirited subs"},{"@language":"en","@value":"2S subs"}],"rdfs:comment":{"@language":"en","@value":"Two-Spirit people who are part of the BDSM scene and assume the submissive role in sexual relationships with a dominant/submissive dynamic."},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001318"},{"@id":"https://homosaurus.org/v5/homoit0004611"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0004612"},"dc:issued":{"@type":"xsd:date","@value":"2026-06-08"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-10"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003985","dc:identifier":"homoit0003985","skos:prefLabel":[{"@language":"en","@value":"Chrononormativity"},{"@language":"nl","@value":"Chrononormativiteit"},{"@language":"sv","@value":"Krononormativitet"}],"skos:altLabel":{"@language":"en","@value":"Normative time"},"rdfs:comment":[{"@language":"en","@value":"Term used to describe the ways in which human lives and experiences are expected to follow specific, linear patterns over time in conformity with normative frameworks. This includes expectations regarding how long and what hours people work, with the aim of achieving maximum productivity, as well as expectations for people to reach life milestones, such as graduating high school, getting married, and having children, at specific ages and in a particular order."},{"@language":"nl","@value":"Term die gebruikt wordt om de manieren te beschrijven waarop menselijke levens en ervaringen naar verwachting specifieke, lineaire patronen in de loop van de tijd volgen, conform normatieve kaders. Dit omvat verwachtingen over hoe lang en hoeveel uur mensen werken, met als doel maximale productiviteit te bereiken, evenals verwachtingen dat mensen mijlpalen in hun leven bereiken, zoals het behalen van hun middelbareschooldiploma, trouwen en kinderen krijgen, op specifieke leeftijden en in een bepaalde volgorde."},{"@language":"sv","@value":"Term som används för att beskriva hur mänskliga liv och erfarenheter förväntas följa specifika, linjära mönster över tid i enlighet med normativa ramverk. Detta inkluderar förväntningar på hur länge och vilka timmar människor arbetar, i syfte att uppnå maximal produktivitet, samt förväntningar på att människor ska nå milstolpar i livet, såsom att ta studenten, gifta sig och skaffa barn, vid specifika åldrar och i en viss ordning."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001323"},"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0003988"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0003986"},{"@id":"https://homosaurus.org/v5/homoit0003987"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001323"},"dc:issued":{"@type":"xsd:date","@value":"2025-04-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002380","dc:identifier":"homoit0002380","skos:prefLabel":[{"@language":"en","@value":"Criminalization of homosexuality"},{"@language":"es","@value":"Criminalización de la homosexualidad"},{"@language":"de","@value":"Kriminalisierung von Homosexualität"},{"@language":"nl","@value":"Criminalisering van homoseksualiteit"},{"@language":"sv","@value":"Kriminalisering av homosexualitet"}],"skos:altLabel":[{"@language":"en","@value":"Criminalization of same-gender relations"},{"@language":"en","@value":"Criminalization of same-sex relations"},{"@language":"es","@value":"Criminalización de las relación del mismo género"},{"@language":"es","@value":"Criminalización de las relación del mismo sexo"},{"@language":"nl","@value":"Criminalisering van same-sex relaties"}],"rdfs:comment":[{"@language":"en","@value":"Criminalization of acts considered to be sexual or romantic between individuals perceived as being of the same gender category in a given sociocultural context."},{"@language":"es","@value":"La criminalización de actos considerados sexuales o románticos entre personas percibidas como de la misma categoría de género en un determinado contexto sociocultural."},{"@language":"de","@value":"Kriminalisierung von Handlungen, die als sexuell oder romantisch zwischen Personen angesehen werden, die in einem bestimmten soziokulturellen Kontext als derselben Geschlechtskategorie angehörig wahrgenommen werden."},{"@language":"nl","@value":"Strafbaarstelling van handelingen die als seksueel of romantisch worden beschouwd tussen individuen die in een bepaalde sociaal-culturele context tot dezelfde gendercategorie behoren."},{"@language":"sv","@value":"Kriminalisering av handlingar som anses vara sexuella eller romantiska mellan individer som i en given sociokulturell kontext uppfattas tillhöra samma könskategori."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002379"},"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0004291"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001326"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000702"},"dc:issued":{"@type":"xsd:date","@value":"2023-01-13"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001446","dc:identifier":"homoit0001446","skos:prefLabel":[{"@language":"en","@value":"Transgender sons"},{"@language":"es","@value":"Hijos transgénero"},{"@language":"fr","@value":"Fils trans"},{"@language":"nl","@value":"Transgender zonen"},{"@language":"sv","@value":"Söner som är transpersoner"}],"rdfs:comment":[{"@language":"en","@value":"Transgender people who are sons."},{"@language":"es","@value":"Personas transgénero que son hijos."},{"@language":"fr","@value":"Fils qui s'identifient comme trans."},{"@language":"nl","@value":"Zonen die zich identificeren als transgender."},{"@language":"sv","@value":"Transpersoner som är söner."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001329"},{"@id":"https://homosaurus.org/v5/homoit0001378"},{"@id":"https://homosaurus.org/v5/homoit0001400"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transgenderSons"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002790","dc:identifier":"homoit0002790","skos:prefLabel":[{"@language":"en","@value":"Asexual sons"},{"@language":"de","@value":"Asexuelle Söhne"},{"@language":"es","@value":"Hijos asexuales"},{"@language":"nl","@value":"Aseksuele zonen"},{"@language":"sv","@value":"Asexuella söner"}],"skos:altLabel":{"@language":"de","@value":"Ace Söhne"},"rdfs:comment":[{"@language":"en","@value":"Asexual people who are sons."},{"@language":"de","@value":"Asexuelle Personen, die Söhne sind."},{"@language":"es","@value":"Personas asexuales que son hijos."},{"@language":"nl","@value":"Zonen die zich identificeren als aseksueel."},{"@language":"sv","@value":"Söner som identifierar sig som asexuella."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001329"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002941","dc:identifier":"homoit0002941","skos:prefLabel":[{"@language":"en","@value":"Intersex sons"},{"@language":"de","@value":"Inter* Söhne"},{"@language":"es","@value":"Hijos intersexuales"},{"@language":"nl","@value":"Intersekse zonen"},{"@language":"sv","@value":"Intersexsöner"}],"skos:altLabel":{"@language":"es","@value":"Hijos intersex"},"rdfs:comment":[{"@language":"en","@value":"Intersex people who are sons. Only use to describe individuals who identify as sons."},{"@language":"de","@value":"Inter* Personen, die Söhne sind. Wird nur verwendet, um Personen zu beschreiben, die sich selbst als inter* identifizieren."},{"@language":"es","@value":"Personas intersex que son hijos. Utilícese únicamente para describir a personas que se autoidentifiquen como hijos."},{"@language":"nl","@value":"Zonen die zich als intersekse identificeren."},{"@language":"sv","@value":"Söner som identifierar sig som intersex. Används endast för personer som själva identifierar sig som söner."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001329"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-09-29"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002355","dc:identifier":"homoit0002355","skos:prefLabel":[{"@language":"en","@value":"Sons of LGBTQ+ people"},{"@language":"es","@value":"Hijos de personas LGBTQ+"},{"@language":"nl","@value":"Zonen van LHBTQ+-personen"},{"@language":"sv","@value":"Söner till hbtq+-personer"}],"rdfs:comment":[{"@language":"en","@value":"Sons who have one or more LGBTQ+ parent. For sons who are themselves LGBTQ+, use the term \"LGBTQ+ sons.\""},{"@language":"es","@value":"Hijos que tienen uno o más padres LGBTQ+. Para los hijos que son LGBTQ+, utilice el término \"hijos LGBTQ+\"."},{"@language":"nl","@value":"Zonen die één of meerdere LHBTQ+-ouders hebben. Voor zonen die zelf LHBTQ+ zijn, gebruik de term 'LHBTQ+-zonen'."},{"@language":"sv","@value":"Söner som har en eller flera hbtq+-föräldrar. För söner som själva är hbtq+ används termen ”Hbtq+-söner”."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002353"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0001330"},{"@id":"https://homosaurus.org/v5/homoit0001331"},{"@id":"https://homosaurus.org/v5/homoit0001332"},{"@id":"https://homosaurus.org/v5/homoit0001333"},{"@id":"https://homosaurus.org/v5/homoit0001334"},{"@id":"https://homosaurus.org/v5/homoit0002745"},{"@id":"https://homosaurus.org/v5/homoit0002914"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000421"},"dc:issued":{"@type":"xsd:date","@value":"2022-12-13"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002626","dc:identifier":"homoit0002626","skos:prefLabel":[{"@language":"en","@value":"Sperm donation "},{"@language":"es","@value":"Donación de esperma"},{"@language":"nl","@value":"Sperma donatie"},{"@language":"sv","@value":"Spermadonation"}],"rdfs:comment":[{"@language":"en","@value":"The process by which a person donates their sperm for reproduction."},{"@language":"es","@value":"El proceso mediante el cual una persona dona su esperma para la reproducción."},{"@language":"nl","@value":"Het proces waarbij een persoon zijn sperma doneert voor reproductie."},{"@language":"sv","@value":"Processen där en person donerar sin sperma i syfte att möjliggöra reproduktion."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002618"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001336"},{"@id":"https://homosaurus.org/v5/homoit0002620"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0002619"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001337","dc:identifier":"homoit0001337","skos:prefLabel":[{"@language":"en","@value":"Spreader bars"},{"@language":"es","@value":"Barra separadora"},{"@language":"nl","@value":"Spreidstangen"},{"@language":"sv","@value":"Spridstänger (BDSM)"}],"skos:altLabel":[{"@language":"es","@value":"Barra de expansión"},{"@language":"es","@value":"Spreader bar"},{"@language":"sv","@value":"Benspretare"},{"@language":"sv","@value":"Spreader bars"}],"rdfs:comment":[{"@language":"en","@value":"Bondage devices consisting of wooden or metal bars with cuffs at either end that are used to keep an individual's arms or legs apart."},{"@language":"es","@value":"Equipo de bondage que consiste en barras de madera o metal con esposas en cada extremo que se utilizan para mantener separados los brazos o las piernas de la persona, generalmente durante actividades sexuales o para estimulación sexual."},{"@language":"nl","@value":"Bondage hulpmiddelen die bestaan uit een houten of metalen staaf met aan beide uiteinden manchetten die worden gebruikt om de armen of benen van een persoon uit elkaar te houden."},{"@language":"sv","@value":"En typ av bondage-redskap bestående av en trä- eller metallstång med fästanordningar i båda ändar som används för att hålla en persons armar eller ben isär."}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001337"},"dc:replaces":{"@id":"http://homosaurus.org/v2/spreaderBars"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001343","dc:identifier":"homoit0001343","skos:prefLabel":[{"@language":"en","@value":"Strippers"},{"@language":"es","@value":"Strippers"},{"@language":"nl","@value":"Strippers"},{"@language":"sv","@value":"Strippor"}],"skos:altLabel":[{"@language":"en","@value":"Stripteasers"},{"@language":"en","@value":"Peelers"},{"@language":"en","@value":"Pole-dancers"},{"@language":"en","@value":"Pole dancers"},{"@language":"en","@value":"Exotic dancers"},{"@language":"es","@value":"Estriptís"},{"@language":"es","@value":"Estriptis"},{"@language":"es","@value":"Estripers"},{"@language":"nl","@value":"Paaldansers"},{"@language":"nl","@value":"Stripteasers"},{"@language":"sv","@value":"Strippare"},{"@language":"sv","@value":"Stripteasedansare"},{"@language":"sv","@value":"Stripteasedansöser"},{"@language":"sv","@value":"Stripteasers"}],"rdfs:comment":[{"@language":"en","@value":"Sex workers who undress to music while using a pole to perform dance moves, whether in a venue like a strip club or by hire at private parties. For stripping performed by amateurs in private settings, use \"Stripping.\""},{"@language":"es","@value":"Personas trabajadoras sexuales que se desnudan al ritmo de la música mientras utilizan una barra para realizar movimientos de baile, ya sea en un local como un club de striptease o por encargo en fiestas privadas. Para el striptease realizado por gente aficionada en entornos privados, utilice «Stripping»."},{"@language":"nl","@value":"Sekswerkers die zich uitkleden op muziek terwijl ze een paal gebruiken om danspasjes uit te voeren, of dat nu in een locatie is als een stripclub of gehuurd op privéfeestjes. Voor strippen uitgevoerd door amateurs in privé-omgevingen, gebruik \"Striptease.\""},{"@language":"sv","@value":"Sexarbetare som klär av sig till musik och använder en stång för att utföra dansrörelser, antingen på platser som stripklubbar eller vid privata evenemang. För stripp som utförs av amatörer i privata sammanhang, använd ”Strippa”."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0003758"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0003764"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh88005823"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0003758"},"dc:replaces":{"@id":"http://homosaurus.org/v2/strippers"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002156","dc:identifier":"homoit0002156","skos:prefLabel":[{"@language":"en","@value":"Fandom"},{"@language":"es","@value":"Fandom"},{"@language":"de","@value":"Fandom"},{"@language":"nl","@value":"Fandom"},{"@language":"sv","@value":"Fandom"}],"skos:altLabel":[{"@language":"de","@value":"Fangemeinde"},{"@language":"de","@value":"Fan-Community"}],"rdfs:comment":[{"@language":"en","@value":"Communities of people who are fans of a particular work or media property. Participation in fandom can include writing and reading fanfiction, creating and viewing fanart, attending conventions, cosplaying, and/or roleplaying."},{"@language":"es","@value":"Comunidades de personas que son fanáticas de una obra o propiedad mediática en particular. La participación en el fandom puede incluir escribir y leer fanfiction, crear y ver fanart, asistir a convenciones, hacer cosplay y/o juegos de rol."},{"@language":"de","@value":"Gemeinschaften von Menschen, die Fans eines bestimmten Werks oder Medienprodukts sind. Die Teilnahme am Fandom kann das Schreiben und Lesen von Fanfiction, das Erstellen und Betrachten von Fanart, die Teilnahme an Conventions, Cosplay und/oder Rollenspiele umfassen."},{"@language":"nl","@value":"Gemeenschappen van personen die fan zijn van een bepaald werk of media-uiting. Deelname aan fandom kan bestaan uit het schrijven en lezen van fanfictie, het maken en bekijken van fanart, het bijwonen van conventies, cosplayen en/of rollenspellen"},{"@language":"sv","@value":"Gemenskaper av personer som är fans av ett visst verk eller populärkulturellt fenomen. Deltagande i fandom kan omfatta att skriva och läsa fanfiction, skapa och titta på fanart, gå på konvent, cosplaya och/eller rollspela."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001345"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0002144"},{"@id":"https://homosaurus.org/v5/homoit0002157"},{"@id":"https://homosaurus.org/v5/homoit0002158"},{"@id":"https://homosaurus.org/v5/homoit0002161"},{"@id":"https://homosaurus.org/v5/homoit0002167"},{"@id":"https://homosaurus.org/v5/homoit0002171"},{"@id":"https://homosaurus.org/v5/homoit0002181"},{"@id":"https://homosaurus.org/v5/homoit0002190"},{"@id":"https://homosaurus.org/v5/homoit0002194"},{"@id":"https://homosaurus.org/v5/homoit0002199"},{"@id":"https://homosaurus.org/v5/homoit0002203"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003123","dc:identifier":"homoit0003123","skos:prefLabel":[{"@language":"en","@value":"Furry culture"},{"@language":"de","@value":"Furry-Kultur"},{"@language":"es","@value":"Cultura furra"},{"@language":"nl","@value":"Furry cultuur"},{"@language":"sv","@value":"Furrykultur"}],"skos:altLabel":{"@language":"es","@value":"Cultura furry"},"rdfs:comment":[{"@language":"en","@value":"Use to describe cultural experiences shared by members of furry communities or products of furry culture (e.g., art and media created by and for furries, activism focused on furry issues, slang commonly used in furry communities, etc.)."},{"@language":"de","@value":"Bezeichnet kulturelle Erfahrungen, die Mitglieder von Furry-Communities teilen, oder Produkte der Furry-Kultur (z. B. Kunst und Medien, die von und für Furries geschaffen wurden, Aktivismus mit Schwerpunkt auf Furry-Themen, in Furry-Communities gebräuchliche Slangausdrücke usw.)."},{"@language":"es","@value":"Utilícese para describir experiencias culturales compartidas por miembros de comunidades furras o productos de la cultura furra (p. ej., arte y medios creados por y para furros, activismo centrado en temas furros, jerga comúnmente utilizada en comunidades furras, etc.)."},{"@language":"nl","@value":"Te gebruiken om culturele ervaringen te beschrijven die gedeeld worden door leden van furry gemeenschappen of producten van de furry cultuur (bijv. kunst en media gemaakt door en voor furries, activisme gericht op furry kwesties, taal die vaak gebruikt wordt in furry gemeenschappen, etc.)."},{"@language":"sv","@value":"Kulturella erfarenheter som delas av medlemmar i furrygemenskaper eller produkter av furrykulturen, till exempel konst och media skapad av och för furries, aktivism kopplad till furryfrågor, slang som används i furrykretsar med mera."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001345"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0002165"},{"@id":"https://homosaurus.org/v5/homoit0003082"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2023-12-20"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001448","dc:identifier":"homoit0001448","skos:prefLabel":[{"@language":"en","@value":"Transgender survivors of hate crimes"},{"@language":"es","@value":"Sobrevivientes transgénero de crímenes de odio"},{"@language":"fr","@value":"Personnes trans survivantes de crimes haineux"},{"@language":"nl","@value":"Transgender overlevenden van haatmisdrijven"},{"@language":"sv","@value":"Transpersoner som är hatbrottsöverlevare"}],"skos:altLabel":{"@language":"es","@value":"Sobrevivientes trans de crímenes de odio"},"rdfs:comment":[{"@language":"en","@value":"Transgender people who have experienced and survived hate crimes; follow the individual's preference for \"victims\" or \"survivors\" whenever possible."},{"@language":"es","@value":"Personas transgénero que han sufrido y sobrevivido crímenes de odio; siga la preferencia de la persona sobre el uso de \"víctimas\" o \"sobrevivientes\" siempre que sea posible."},{"@language":"fr","@value":"Personnes transgenres qui ont été victimes de crimes haineux et qui peuvent ou non avoir survécu; respecter la préférence de la personne concernée entre les termes « victimes » ou « survivantes » dans la mesure du possible."},{"@language":"nl","@value":"Transgender personen die haatmisdrijven hebben meegemaakt en overleefd; volg waar mogelijk de voorkeur van het individu voor \"slachtoffers\" of \"overlevenden\"."},{"@language":"sv","@value":"Transpersoner som har upplevt hatbrott och som har överlevt. Följ individens preferens för att använda ”offer” eller ”överlevare” när det är möjligt."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001349"},{"@id":"https://homosaurus.org/v5/homoit0001456"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transgenderSurvivorsOfHateCrimes"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002850","dc:identifier":"homoit0002850","skos:prefLabel":[{"@language":"en","@value":"Asexual survivors of hate crimes"},{"@language":"es","@value":"Sobrevivientes asexuales de crímenes de odio"},{"@language":"de","@value":"Asexuelle Überlebende von Hasskriminalität"},{"@language":"nl","@value":"Aseksuele overlevenden van haatmisdrijven"},{"@language":"sv","@value":"Asexuella hatbrottsöverlevare"}],"skos:altLabel":[{"@language":"de","@value":"Ace Überlebende von Hasskriminalität"},{"@language":"de","@value":"Asexuelle Überlebende von Hassdelikten"},{"@language":"de","@value":"Asexuelle Überlebende von Hassverbrechen"}],"rdfs:comment":[{"@language":"en","@value":"Asexual people who have experienced and survived hate crimes; follow the individual's preference for \"victims\" or \"survivors\" whenever possible."},{"@language":"es","@value":"Personas asexuales que han sufrido y sobrevivido a crímenes de odio; siga la preferencia de la persona sobre el uso de \"víctimas\" o \"sobrevivientes\" siempre que sea posible."},{"@language":"de","@value":"Asexuelle Personen, die Hasskriminalität erlebt und überlebt haben; wenn möglich die Präferenz der Person für „Opfer“ oder „Überlebende“ beachten."},{"@language":"nl","@value":"Aseksuele personen die haatmisdrijven hebben meegemaakt en overleefd; volg waar mogelijk de voorkeur van het individu voor \"slachtoffers\" of \"overlevenden\"."},{"@language":"sv","@value":"Asexuella personer som har upplevt och överlevt hatbrott. Följ individens preferens för att använda ”offer” eller ”överlevare” när det är möjligt."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001349"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002942","dc:identifier":"homoit0002942","skos:prefLabel":[{"@language":"en","@value":"Intersex survivors of hate crimes"},{"@language":"de","@value":"Inter* Überlebende von Hasskriminalität"},{"@language":"es","@value":"Sobrevivientes intersexuales de crímenes de odio"},{"@language":"nl","@value":"Intersekse overlevenden van haatmisdrijven"},{"@language":"sv","@value":"Intersexpersoner som överlevt hatbrott"}],"skos:altLabel":[{"@language":"de","@value":"Inter* Überl