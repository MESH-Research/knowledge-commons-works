rijdkrachten."},{"@language":"sv","@value":"Transpersoner som tjänstgör inom nationella försvarsstyrkor."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001100"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001378"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2007020042"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000712"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transgenderPeopleInTheMilitary"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002801","dc:identifier":"homoit0002801","skos:prefLabel":[{"@language":"en","@value":"Asexual people in the military"},{"@language":"es","@value":"Personas asexuales en el ejército"},{"@language":"de","@value":"Asexuelle Militärangehörige"},{"@language":"nl","@value":"Aseksueel militair personeel"},{"@language":"sv","@value":"Asexuella i militären"}],"skos:altLabel":[{"@language":"es","@value":"Personas asexuales en las fuerzas armadas"},{"@language":"de","@value":"Ace Militärangehörige"},{"@language":"de","@value":"Ace Armeeangehörige"},{"@language":"de","@value":"Asexuelle Armeeangehörige"}],"rdfs:comment":[{"@language":"en","@value":"Asexual people serving in state and national armed forces."},{"@language":"es","@value":"Personas asexuales que sirven en las fuerzas armadas estatales y nacionales."},{"@language":"de","@value":"Asexuelle Personen, die in Streitkräften dienen"},{"@language":"nl","@value":"Aseksuele personen die dienen in staats- en nationale strijdkrachten."},{"@language":"sv","@value":"Asexuella personer som tjänstgör inom nationella försvarsstyrkor."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001100"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000712"},"dc:issued":{"@type":"xsd:date","@value":"20