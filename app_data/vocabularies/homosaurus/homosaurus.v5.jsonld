som mixade."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000820"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-01-18"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001798","dc:identifier":"homoit0001798","skos:prefLabel":[{"@language":"en","@value":"Biracial bisexual people"},{"@language":"es","@value":"Personas bisexuales birraciales"},{"@language":"de","@value":"Biracial bisexuelle Personen"},{"@language":"nl","@value":"Biraciale biseksuele personen"},{"@language":"sv","@value":"Mixade bisexuella"}],"skos:altLabel":[{"@language":"en","@value":"Bi-racial bisexual people"},{"@language":"en","@value":"Bisexual bi-racial people"},{"@language":"en","@value":"Bisexual biracial people"},{"@language":"de","@value":"Bisexuelle bi-racial Personen"},{"@language":"de","@value":"Bisexuelle biracial Personen"},{"@language":"de","@value":"Bi-racial bisexuelle Personen"},{"@language":"nl","@value":"Biraciale biseksuelen"},{"@language":"nl","@value":"Biseksuele bi-raciale personen"},{"@language":"nl","@value":"Biseksuele biraciale personen"},{"@language":"sv","@value":"Blandade bisexuella"}],"rdfs:comment":[{"@language":"en","@value":"Bisexual people who belong to two or more racial groups. Only use to describe people who self-identify as biracial."},{"@language":"es","@value":"Personas bisexuales que pertenecen a dos o más grupos raciales. Utilícese únicamente para personas que se autoidentifiquen como birraciales."},{"@language":"de","@value":"Bisexuelle Personen, die zu zwei oder mehreren Volksgruppen gehören. Hinweis: Der englische Begriff «Race» ist nicht mit dem deutschen Begriff «Rasse» gleichzusetzen, da sie in zwei unterschiedlichen Diskursen stehen. Oft wird deshalb im Deutschen ebenfalls Race verwendet."},{"@language":"nl","