orrusos LGBTQ+"},{"@language":"es","@value":"Bielorrusos LGBTQ"},{"@language":"es","@value":"Bielorrusos (LGBTQ)"},{"@language":"es","@value":"Bielorrusas LGBTQ+"},{"@language":"es","@value":"Bielorrusas LGBTQ"},{"@language":"es","@value":"Bielorrusas (LGBTQ)"},{"@language":"nl","@value":"Belarussische personen (LHBTQ+)"},{"@language":"nl","@value":"LHBTQ+-Belarussen"}],"rdfs:comment":[{"@language":"en","@value":"LGBTQ+ people who are ethnically Belarusian or have Belarusian nationality."},{"@language":"de","@value":"LGBTQ+-Personen, die ethnisch belarusisch sind oder die belarusische Staatsangehörigkeit besitzen."},{"@language":"es","@value":"Personas LGBTQ+ de etnia bielorrusa o con nacionalidad bielorrusa."},{"@language":"nl","@value":"LHBTQ+-personen die etnisch Belarussisch zijn of de Belarussische nationaliteit hebben."},{"@language":"sv","@value":"Hbtq+-personer med belarusisk etnicitet eller nationalitet."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000860"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0003307"},{"@id":"https://homosaurus.org/v5/homoit0003308"},{"@id":"https://homosaurus.org/v5/homoit0003309"},{"@id":"https://homosaurus.org/v5/homoit0003310"},{"@id":"https://homosaurus.org/v5/homoit0003311"},{"@id":"https://homosaurus.org/v5/homoit0003312"},{"@id":"https://homosaurus.org/v5/homoit0003313"},{"@id":"https://homosaurus.org/v5/homoit0003314"},{"@id":"https://homosaurus.org/v5/homoit0003315"},{"@id":"https://homosaurus.org/v5/homoit0003316"},{"@id":"https://homosaurus.org/v5/homoit0003317"},{"@id":"https://homosaurus.org/v5/homoit0003318"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2024-06-10"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003319","dc:identifier":"homoit0003319","skos:prefLabel":[{"@language":"en","@value":"Russian LGBTQ+ people"},{"@language":"es","@value":"Personas LGBTQ+ rusas"},{"@language":"nl","@value":"Russische LHBTQ+-personen"},{"@language":"sv","@value":"Ryska hbtq+-personer"}],"skos:altLabel":[{"@language":"en","@value":"LGBTQ+ Russians"},{"@language":"en","@value":"Russians (LGBTQ)"},{"@language":"es","@value":"Rusos LGBTQ+"},{"@language":"es","@value":"Rusos (LGBTQ)"},{"@language":"es","@value":"Rusas LGBTQ+"},{"@language":"es","@value":"Rusas (LGBTQ)"},{"@language":"es","@value":"Personas (LGBTQ) rusas"},{"@language":"nl","@value":"Russen (LHBTQ+)"}],"rdfs:comment":[{"@language":"en","@value":"LGBTQ+ people who are ethnically Russian or have Russian nationality."},{"@language":"es","@value":"Personas LGBTQ+ de etnia o nacionalidad rusa."},{"@language":"nl","@value":"LHBTQ+-personen die etnisch Russisch zijn of de Russische nationaliteit hebben."},{"@language":"sv","@value":"Hbtq+-personer som är etniskt ryska eller har rysk nationalitet."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000860"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0003320"},{"@id":"https://homosaurus.org/v5/homoit0003321"},{"@id":"https://homosaurus.org/v5/homoit0003322"},{"@id":"https://homosaurus.org/v5/homoit0003323"},{"@id":"https://homosaurus.org/v5/homoit0003324"},{"@id":"https://homosaurus.org/v5/homoit0003325"},{"@id":"https://homosaurus.org/v5/homoit0003326"},{"@id":"https://homosaurus.org/v5/homoit0003327"},{"@id":"https://homosaurus.org/v5/homoit0003328"},{"@id":"https://homosaurus.org/v5/homoit0003329"},{"@id":"https://homosaurus.org/v5/homoit0003330"},{"@id":"https://homosaurus.org/v5/homoit0003331"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2024-06-10"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003334","dc:identifier":"homoit0003334","skos:prefLabel":[{"@language":"en","@value":"Ukrainian LGBTQ+ people"},{"@language":"es","@value":"Personas LGBTQ+ ucranianas"},{"@language":"nl","@value":"Oekraïnse LHBTQ+-personen"},{"@language":"sv","@value":"Ukrainska hbtq+-personer"}],"skos:altLabel":[{"@language":"en","@value":"LGBTQ+ Ukrainians"},{"@language":"en","@value":"Ukrainians (LGBTQ)"},{"@language":"es","@value":"Ucranianos LGBTQ+"},{"@language":"es","@value":"Ucranianos LGBTQ"},{"@language":"es","@value":"Ucranianos (LGBTQ)"},{"@language":"es","@value":"Ucranianas LGBTQ+"},{"@language":"es","@value":"Ucranianas LGBTQ"},{"@language":"es","@value":"Ucranianas (LGBTQ)"},{"@language":"nl","@value":"Oekraïners (LHBTQ+)"}],"rdfs:comment":[{"@language":"en","@value":"LGBTQ+ people who are ethnically Ukrainian or have Ukrainian nationality."},{"@language":"es","@value":"Personas LGBTQ+ que son de etnia o nacionalidad ucraniana."},{"@language":"nl","@value":"LHBTQ+-personen die etnisch Oekraïens zijn of de Oekraïense nationaliteit hebben."},{"@language":"sv","@value":"Hbtq+-personer som är etniskt ukrainska eller har ukrainskt medborgarskap."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000860"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0003335"},{"@id":"https://homosaurus.org/v5/homoit0003336"},{"@id":"https://homosaurus.org/v5/homoit0003337"},{"@id":"https://homosaurus.org/v5/homoit0003338"},{"@id":"https://homosaurus.org/v5/homoit0003339"},{"@id":"https://homosaurus.org/v5/homoit0003340"},{"@id":"https://homosaurus.org/v5/homoit0003341"},{"@id":"https://homosaurus.org/v5/homoit0003342"},{"@id":"https://homosaurus.org/v5/homoit0003343"},{"@id":"https://homosaurus.org/v5/homoit0003344"},{"@id":"https://homosaurus.org/v5/homoit0003345"},{"@id":"https://homosaurus.org/v5/homoit0003346"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2024-06-19"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002022","dc:identifier":"homoit0002022","skos:prefLabel":[{"@language":"en","@value":"Hispanic LGBTQ+ people"},{"@language":"es","@value":"Personas LGBTQ+ hispanas"},{"@language":"de","@value":"Hispanische LGBTQ+-Personen"},{"@language":"nl","@value":"Hispanic LHBTQ+-personen"},{"@language":"sv","@value":"Hbtq+-personer som är hispanic"}],"skos:altLabel":[{"@language":"en","@value":"Hispanic people (LGBTQ)"},{"@language":"en","@value":"LGBTQ+ Hispanic people"},{"@language":"en","@value":"LGBTQ+ Hispanics"},{"@language":"es","@value":"Personas hispanas (LGBTQ)"},{"@language":"es","@value":"Personas hispanas LGBTQ+"},{"@language":"es","@value":"Hispanos LGBTQ+"},{"@language":"nl","@value":"LHBTQ+-Hispanics"}],"rdfs:comment":[{"@language":"en","@value":"LGBTQ+ people who are from or descended from Spain or other regions formerly colonized by Spain that are primarily Spanish-speaking. Only use for individuals who self-identify as Hispanic; do not conflate with Latino/a/x or Chicano/a/x."},{"@language":"es","@value":"Personas LGBTQ+ que hablan español, son de países de habla hispana y/o descienden de culturas de habla hispana; utilícese únicamente para personas que se autoidentifiquen como hispanas. No debe combinarse con Latino/a/x o Chicano/a/x."},{"@language":"de","@value":"LGBTQ+-Personen, die aus Spanien oder ehemals von Spanien kolonisierten, überwiegend spanischsprachigen Regionen kommen oder von dort abstammen. Nur für Personen verwenden, die sich selbst als „hispanisch» bezeichnen; nicht mit „Latino/a/x“ oder „Chicano/a/x“ gleichsetzen."},{"@language":"nl","@value":"LHBTQ+-personen die afkomstig zijn uit of afstammen van Spanje of andere regio's die vroeger door Spanje werden gekoloniseerd en die voornamelijk Spaanstalig zijn. Alleen gebruiken voor personen die zichzelf identificeren als Hispanic; niet verwarren met Latino/a/x of Chicano/a/x."},{"@language":"sv","@value":"Hbtq+-personer som kommer från eller härstammar från Spanien eller andra regioner som tidigare varit under spanskt kolonialt styre och där spanska är det dominerande språket. Används endast för personer som själva identifierar sig som hispanic och ska inte sammanblandas med latino/a/x eller chicano/a/x."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000860"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0002023"},{"@id":"https://homosaurus.org/v5/homoit0002024"},{"@id":"https://homosaurus.org/v5/homoit0002025"},{"@id":"https://homosaurus.org/v5/homoit0002026"},{"@id":"https://homosaurus.org/v5/homoit0002027"},{"@id":"https://homosaurus.org/v5/homoit0002028"},{"@id":"https://homosaurus.org/v5/homoit0003818"},{"@id":"https://homosaurus.org/v5/homoit0003819"},{"@id":"https://homosaurus.org/v5/homoit0003827"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-05-16"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004162","dc:identifier":"homoit0004162","skos:prefLabel":[{"@language":"en","@value":"Sámi LGBTQ+ people"},{"@language":"nl","@value":"Sami LHBTQ+-personen"},{"@language":"sv","@value":"Samer (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"LGBTQ+ Sámi people"},{"@language":"en","@value":"LGBTQ+ Sámis"},{"@language":"en","@value":"Sámi people (LGBTQ)"}],"rdfs:comment":[{"@language":"en","@value":"LGBTQ+ people who belong to the Sámi Indigenous people of Sápmi, which encompasses large parts of the regions now known as Norway, Sweden, Finland, and the Kola Peninsula of Russia. Only use to refer to people who self-identify as Sámi."},{"@language":"nl","@value":"LHBTQ+-personen die behoren tot de traditioneel Sami-sprekende inheemse bevolking van een gebied dat grote delen omvat van het noorden van Noorwegen, Zweden, Finland en het Kola-schiereiland in Rusland. De term wordt alleen gebruikt voor mensen die zichzelf als Sami identificeren."},{"@language":"sv","@value":"Hbtq+-personer som tillhör det samiska urfolket i Sápmi, traditionellt förbundet med de samiska språken och områden som idag omfattar stora delar av Norge, Sverige, Finland och Kolahalvön i Ryssland. Används endast för personer som identifierar sig som samer."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000860"},{"@id":"https://homosaurus.org/v5/homoit0000886"}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0004163"},{"@id":"https://homosaurus.org/v5/homoit0004164"},{"@id":"https://homosaurus.org/v5/homoit0004165"},{"@id":"https://homosaurus.org/v5/homoit0004166"},{"@id":"https://homosaurus.org/v5/homoit0004167"},{"@id":"https://homosaurus.org/v5/homoit0004168"},{"@id":"https://homosaurus.org/v5/homoit0004169"},{"@id":"https://homosaurus.org/v5/homoit0004170"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2025-04-24"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004349","dc:identifier":"homoit0004349","skos:prefLabel":[{"@language":"en","@value":"Canadian LGBTQ+ people"},{"@language":"nl","@value":"Canadese LHBTQ+-personen"},{"@language":"sv","@value":"Kanadensiska hbtq+-personer"}],"skos:altLabel":[{"@language":"en","@value":"LGBTQ+ Canadian people"},{"@language":"en","@value":"LGBTQ+ Canadians"},{"@language":"en","@value":"Canadian people (LGBTQ+)"},{"@language":"en","@value":"Canadians (LGBTQ+)"}],"rdfs:comment":[{"@language":"en","@value":"LGBTQ+ people who were born, raised, or currently reside in Canada, or who hold Canadian citizenship. Only use to describe people who self-identify as Canadian and LGBTQ+."},{"@language":"nl","@value":"LHBTQ+ personen die in Canada geboren, opgegroeid of woonachtig zijn, of die de Canadese nationaliteit bezitten. Gebruik deze term alleen om personen te beschrijven die zichzelf identificeren als Canadees en LHBTQ+."},{"@language":"sv","@value":"Hbtq+-personer som är födda, uppvuxna eller för närvarande bor i Kanada, eller som har kanadensiskt medborgarskap. Används endast för personer som identifierar sig som kanadensare och hbtq+."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000860"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0004350"},{"@id":"https://homosaurus.org/v5/homoit0004351"},{"@id":"https://homosaurus.org/v5/homoit0004352"},{"@id":"https://homosaurus.org/v5/homoit0004353"},{"@id":"https://homosaurus.org/v5/homoit0004354"},{"@id":"https://homosaurus.org/v5/homoit0004356"},{"@id":"https://homosaurus.org/v5/homoit0004357"},{"@id":"https://homosaurus.org/v5/homoit0004358"},{"@id":"https://homosaurus.org/v5/homoit0004359"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0004355"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2026-02-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000902","dc:identifier":"homoit0000902","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ migrants"},{"@language":"es","@value":"Migrantes LGBTQ+"},{"@language":"nl","@value":"LHBTQ+-migranten"},{"@language":"sv","@value":"Hbtq+-migranter"}],"skos:altLabel":[{"@language":"en","@value":"Migrants (LGBTQ)"},{"@language":"en","@value":"LGBTQ migrants"},{"@language":"es","@value":"Migrantes LGBTQ"},{"@language":"es","@value":"Migrantes (LGBTQ)"},{"@language":"sv","@value":"Migranter (hbtq+)"}],"rdfs:comment":[{"@language":"en","@value":"LGBTQ+ people who temporarily or permanently move away from their place of residence within a country or across an international border."},{"@language":"es","@value":"Personas LGBTQ+ que se mudan temporal o permanentemente de su lugar de residencia dentro de un país o a través de una frontera internacional."},{"@language":"nl","@value":"LHBTQ+-personen die tijdelijk of definitief verhuizen uit hun woonplaats binnen een land of over een internationale grens."},{"@language":"sv","@value":"Hbtq+-personer som tillfälligt eller permanent flyttar från sin bostadsort, inom ett land eller över nationsgränser."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000915"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000860"},{"@id":"https://homosaurus.org/v5/homoit0000927"},{"@id":"https://homosaurus.org/v5/homoit0001482"},{"@id":"https://homosaurus.org/v5/homoit0001815"},{"@id":"https://homosaurus.org/v5/homoit0001853"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQMigrants"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000949","dc:identifier":"homoit0000949","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ sporting events"},{"@language":"es","@value":"Eventos deportivos LGBTQ+"},{"@language":"nl","@value":"LHBTQ+-sportevenementen"},{"@language":"sv","@value":"Sportevenemang (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"LGBTQ sporting events"},{"@language":"es","@value":"Eventos deportivos LGBTQ"},{"@language":"es","@value":"Eventos de deporte LGBTQ"},{"@language":"sv","@value":"EuroGames"},{"@language":"sv","@value":"Gay Games"},{"@language":"sv","@value":"Outgames"}],"rdfs:comment":[{"@language":"en","@value":"Organized games or sports activities for LGBTQ+ people or communities; includes both competitive and recreational events."},{"@language":"es","@value":"Juegos o actividades deportivas organizadas para personas o comunidades LGBTQ+; incluye eventos competitivos y recreativos."},{"@language":"nl","@value":"Georganiseerde spelen of sportactiviteiten voor LHBTQ+-personen of -gemeenschappen; omvat zowel competitieve als recreatieve evenementen."},{"@language":"sv","@value":"Organiserade spel eller idrottsaktiviteter för hbtq+-personer eller hbtq+-gemenskaper. Inkluderar både tävlingsinriktade och rekreationella evenemang."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000861"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001929"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000861"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQSportingEvents"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003594","dc:identifier":"homoit0003594","skos:prefLabel":[{"@language":"en","@value":"Lesbian events"},{"@language":"nl","@value":"Lesbische evenementen"},{"@language":"sv","@value":"Lesbiska evenemang"}],"skos:altLabel":{"@language":"sv","@value":"Lesbiska event"},"rdfs:comment":[{"@language":"en","@value":"Organized public or social occasions for lesbians and lesbian communities."},{"@language":"nl","@value":"Georganiseerde openbare of sociale bijeenkomsten voor lesbische vrouwen en gemeenschappen."},{"@language":"sv","@value":"Organiserade offentliga eller sociala tillställningar för lesbiska och lesbiska gemenskaper."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000861"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000861"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-22"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"