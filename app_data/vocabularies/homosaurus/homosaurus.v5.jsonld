anic"},{"@language":"sv","@value":"Lesbiska som är latinamerikaner och som själva identifierar sig som latines (latino, latina eller latinx). Blanda inte ihop med chicano/a/x eller hispanic."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000253"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianLatinas"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001181","dc:identifier":"homoit0001181","skos:prefLabel":[{"@language":"en","@value":"Latino/a/x queer people"},{"@language":"de","@value":"Queere Latino/-a/-x-Personen"},{"@language":"es","@value":"Personas queer Latinx"},{"@language":"nl","@value":"Latino/a/x queer personen"},{"@language":"sv","@value":"Queera latines"}],"skos:altLabel":[{"@language":"en","@value":"Latina queer people"},{"@language":"en","@value":"Latine queer people"},{"@language":"en","@value":"Latino queer people"},{"@language":"en","@value":"Latinx queer people"},{"@language":"en","@value":"Queer Latinas"},{"@language":"en","@value":"Queer Latine people"},{"@language":"en","@value":"Queer Latinos"},{"@language":"en","@value":"Queer Latinx people"},{"@language":"de","@value":"Queere Latinos"},{"@language":"de","@value":"Queere Latinas"},{"@language":"de","@value":"Queere Latinx"},{"@language":"es","@value":"Personas Latinx queer"},{"@language":"es","@value":"Latinxs queer"},{"@language":"es","@value":"Latines queer"},{"@language":"nl","@value":"Latino queer personen"},{"@language":"nl","@value":"Latinx queer personen"},{"@language":"nl","@value":"Queer Latina's"},{"@language":"nl","@value":"Queer Latino's"},{"@language":"nl","@value":"Queer Latinx personen"},{"@language":"sv","@value":"Latino/a/x queers"}],"rdfs:comment":[{"@language":"en","@value":"Latin American people who are queer; only use to describe individuals who self-identify as Latino, Latina, or Latinx. Do not conflate with Chicano/a/x or Hispanic."},{"@language":"de","@value":"Queere Personen lateinamerikanischer Herkunft; dieser Begriff bezieht sich ausschließlich auf Personen, die sich selbst als Latino, Latina oder Latinx bezeichnen. Nicht mit Chicano/a/x oder Hispanic zu verwechseln."},{"@language":"es","@value":"Personas latinoamericanas que son queer; utilícese únicamente para describir a personas que se autoidentifican como latinos, latinas o latinxs. No debe confundirse con chicano/a/x o hispano/a/x."},{"@language":"nl","@value":"Latijns-Amerikaanse personen die queer zijn; alleen gebruiken om personen te beschrijven die zichzelf identificeren als Latino, Latina of Latinx. Niet verwarren met Chicano/a/x of Hispanic"},{"@language":"sv","@value":"Queera personer som är latinamerikaner och som själva identifierar sig som latines (latino, latina eller latinx). Blanda inte ihop med chicano/a/x eller hispanic."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000253"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerLatinx"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001417","dc:identifier":"homoit0001417","skos:prefLabel":[{"@language":"en","@value":"Latino/a/x transgender people"},{"@language":"de","@value":"Trans Latino/-a/-x-Personen"},{"@language":"es","@value":"Personas transgénero Latinx"},{"@language":"nl","@value":"Latino/a/x transgender personen"},{"@language":"sv","@value":"Transpersoner som är latines"}],"skos:altLabel":[{"@language":"en","@value":"Latina transgender people"},{"@language":"en","@value":"Latine transgender people"},{"@language":"en","@value":"Latino transgender people"},{"@language":"en","@value":"Latinx transgender people"},{"@language":"en","@value":"Transgender Latinas"},{"@language":"en","@value":"Transgender Latine people"},{"@language":"en","@value":"Transgender Latinos"},{"@language":"en","@value":"Transgender Latinx people"},{"@language":"de","@value":"Trans Latinos"},{"@language":"de","@value":"Trans Latinas"},{"@language":"de","@value":"Trans Latinx"},{"@language":"es","@value":"Personas transgénero Latinxs"},{"@language":"es","@value":"Personas trans latinx"},{"@language":"es","@value":"Personas latines transgénero"},{"@language":"es","@value":"Latinxs trans"},{"@language":"es","@value":"Personas latinas trans"},{"@language":"nl","@value":"Latino transgender personen"},{"@language":"nl","@value":"Latinx transgender personen"},{"@language":"nl","@value":"Transgender Latina's"},{"@language":"nl","@value":"Transgender Latino's"},{"@language":"nl","@value":"Transgender Latinx personen"},{"@language":"sv","@value":"Latino/a/x transpersoner"}],"rdfs:comment":[{"@language":"en","@value":"Latin American people who are transgender; only use to describe individuals who self-identify as Latino, Latina, or Latinx. Do not conflate with Chicano/a/x or Hispanic."},{"@language":"de","@value":"Trans Personen lateinamerikanischer Herkunft; dieser Begriff bezieht sich ausschließlich auf Personen, die sich selbst als Latino, Latina oder Latinx bezeichnen. Nicht mit Chicano/a/x oder Hispanic zu verwechseln."},{"@language":"es","@value":"Personas latinoamericanas que son transgénero; utilícese únicamente para describir a personas que se autoidentifican como latinos, latinas o latinxs. No debe confundirse con chicano/a/x o hispano/a/x."},{"@language":"nl","@value":"Latijns-Amerikaanse personen die transgender zijn; alleen gebruiken om personen te beschrijven die zichzelf identificeren als Latino, Latina of Latinx. Niet verwarren met Chicano/a/x of Hispanic"},{"@language":"sv","@value":"Transpersoner som är latinamerikaner och som själva identifierar sig som latines (latino, latina eller latinx). Blanda inte ihop med chicano/a/x eller hispanic."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000253"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transgenderLatinx"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002769","dc:identifier":"homoit0002769","skos:prefLabel":[{"@language":"en","@value":"Latino/a/x intersex people"},{"@language":"de","@value":"Inter* Latino/-a/-x-Personen"},{"@language":"es","@value":"Personas intersexuales Latinx"},{"@language":"nl","@value":"Latino/a/x intersekse personen"},{"@language":"sv","@value":"Intersexpersoner som är latines"}],"skos:altLabel":[{"@language":"en","@value":"Intersex Latinas"},{"@language":"en","@value":"Intersex Latine people"},{"@language":"en","@value":"Intersex Latinos"},{"@language":"en","@value":"Intersex Latinx people"},{"@language":"en","@value":"Latina intersex people"},{"@language":"en","@value":"Latine intersex people"},{"@language":"en","@value":"Latino intersex people"},{"@language":"en","@value":"Latinx intersex people"},{"@language":"de","@value":"Inter* Latinos"},{"@language":"de","@value":"Inter* Latinas"},{"@language":"de","@value":"Inter* Latinx"},{"@language":"es","@value":"Personas intersex Latinx"},{"@language":"es","@value":"Personas intersex latinas"},{"@language":"es","@value":"Personas intersex latines"},{"@language":"es","@value":"Latinos intersexuales"},{"@language":"es","@value":"Latines intersexuales"},{"@language":"es","@value":"Latinas intersexuales"},{"@language":"es","@value":"Latinxs intersexuales"},{"@language":"es","@value":"Latinxs intersex"},{"@language":"nl","@value":"Interse