Asexuelle Paare"},{"@language":"nl","@value":"Aseksuele paren"},{"@language":"sv","@value":"Asexuella par"}],"skos:altLabel":{"@language":"de","@value":"Ace Paare"},"rdfs:comment":[{"@language":"en","@value":"Partnerships in which both people are asexual."},{"@language":"es","@value":"Relaciones de pareja donde las dos personas son asexuales."},{"@language":"de","@value":"Partnerschaften, in denen beide Personen asexuell sind."},{"@language":"nl","@value":"Partnerschappen waarin beide personen biseksueel zijn"},{"@language":"sv","@value":"Parrelationer där båda parterna är asexuella."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000310"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001237"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-27"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002969","dc:identifier":"homoit0002969","skos:prefLabel":[{"@language":"en","@value":"Intersex couples"},{"@language":"es","@value":"Parejas intersexuales"},{"@language":"nl","@value":"Intersekse paren"},{"@language":"sv","@value":"Intersexpar"}],"skos:altLabel":{"@language":"es","@value":"Parejas intersex"},"rdfs:comment":[{"@language":"en","@value":"Partnerships in which both people are intersex."},{"@language":"es","@value":"Relaciones en las que ambas personas son intersex."},{"@language":"nl","@value":"Partnerschappen waarin beide personen intersekse zijn."},{"@language":"sv","@value":"Parrelationer där båda personerna är intersex."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000310"},{"@id":"https://homosaurus.org/v5/homoit0002939"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001237"},"dc:issued":{"@type":"xsd:date","@value":"2023-09-29"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001083","dc:identifier":"homoit0001083","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ partners"},{"@language":"es","@value":"Parejas LGBTQ+"},{"@language":"nl","@value":"LHBTQ+-partners"},{"@language":"sv","@value":"Partners (hbtq+)"}],"skos:altLabel":{"@language":"en","@value":"Partners (LGBTQ)"},"rdfs:comment":[{"@language":"en","@value":"Gender-neutral term for sexual, romantic, or play partners who are also LGBTQ+."},{"@language":"es","@value":"Término de género neutro para parejas sexuales, románticas o de juego que también son LGBTQ+."},{"@language":"nl","@value":"Genderneutrale term voor seksuele, romantische of speelpartners die ook LHBTQ+ zijn"},{"@language":"sv","@value":"Könsneutral term för sexuella, romantiska eller kink-partners som också är hbtq+-personer."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000420"},{"@id":"https://homosaurus.org/v5/homoit0002365"}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000863"},{"@id":"https://homosaurus.org/v5/homoit0002367"},{"@id":"https://homosaurus.org/v5/homoit0002368"},{"@id":"https://homosaurus.org/v5/homoit0002369"},{"@id":"https://homosaurus.org/v5/homoit0002370"},{"@id":"https://homosaurus.org/v5/homoit0002371"},{"@id":"https://homosaurus.org/v5/homoit0002800"},{"@id":"https://homosaurus.org/v5/homoit0002920"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000310"},{"@id":"https://homosaurus.org/v5/homoit0000855"},{"@id":"https://homosaurus.org/v5/homoit0000895"},{"@id":"https://homosaurus.org/v5/homoit0001237"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000420"},"dc:replaces":{"@id":"http://homosaurus.org/v2/partnersLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002690","dc:identifier":"homoit0002690","skos:prefLabel":[{"@language":"en","@value":"Two-Spirit couples"},{"@language":"es","@value":"Parejas dos espíritus"},{"@language":"nl","@value":"Two-Spirit paren"},{"@language":"sv","@value":"Two-spirit-par"}],"skos:altLabel":[{"@language":"en","@value":"2S couples"},{"@language":"en","@value":"Two Spirit couples"},{"@language":"en","@value":"Two Spirited couples"},{"@language":"en","@value":"Two-Spirited couples"}],"rdfs:comment":[{"@language":"en","@value":"Partnerships in which both people are Two-Spirit"},{"@language":"es","@value":"Relaciones de pareja donde las dos personas son dos espíritus."},{"@language":"nl","@value":"Partnerschappen waarin beide personen LHBTQ+ zijn."},{"@language":"sv","@value":"Parrelationer där båda personerna är Two-spirit-personer."}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000310"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0002690"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-26"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000312","dc:identifier":"homoit0000312","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ victims of crime"},{"@language":"es","@value":"Víctimas LGBTQ+ de crímenes"},{"@language":"fr","@value":"Personnes LGBTQ+ victimes de crimes"},{"@language":"nl","@value":"LHBTQ+-slachtoffers van misdrijven"},{"@language":"sv","@value":"Brottsoffer (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"Crime victims (LGBTQ)"},{"@language":"en","@value":"LGBTQ victims of crime"}],"rdfs:comment":[{"@language":"en","@value":"LGBTQ+ people who have experienced crimes and may or may not have survived; follow the individual's preference for “victims” or “survivors” whenever possible."},{"@language":"es","@value":"Personas LGBTQ+ que han sufrido crímenes y pueden o no haber sobrevivido; siga la preferencia de la persona sobre el uso de \"víctimas\" o \"sobrevivientes\" siempre que sea posible."},{"@language":"fr","@value":"Personnes LGBTQ+ qui ont été victimes de crimes et qui peuvent ou non avoir survécu; respecter la préférence de la personne concernée entre les termes « victimes » ou « survivantes » dans la mesure du possible."},{"@language":"nl","@value":"LHBTQ+-personen die misdrijven hebben meegemaakt en het al dan niet hebben overleefd; volg waar mogelijk de voorkeur van het individu voor 'slachtoffers' of 'overlevers'."},{"@language":"sv","@value":"Hbtq+-personer som har utsatts för brott och som kan ha överlevt eller inte. Följ individens eget språkbruk om de föredrar ”offer” eller ”överlevare”"}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000915"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000613"},{"@id":"https://homosaurus.org/v5/homoit0000958"},{"@id":"https://homosaurus.org/v5/homoit0000959"},{"@id":"https://homosaurus.org/v5/homoit0003745"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001492"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQVictimsOfCrime"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003745","dc:identifier":"homoit0003745","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ victims of human trafficking"},{"@language":"nl","@value":"LHBTQ+-slachtoffers van mensenhandel"},{"@language":"sv","@value":"Offer för människohandel (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"Victims of human trafficking (LGBTQ)"},{"@language":"en","@value":"LGBTQ+ trafficking victims"},{"@language":"en","@value":"Trafficking victims (LGBTQ)"}],"rdfs:comment":[{"@language":"en","@value":"LGBTQ+ people who have experienced and may or may not have survived human trafficking. Follow the individual's preference for \"victims\" or \"survivors\" whenever possible."},{"@language":"nl","@value":"LHBTQ+-personen die mensenhandel hebben meegemaakt en misschien wel of niet hebben overleefd. Volg waar mogelijk de voorkeur van het individu voor \"slachtoffers\" of \"overlevenden\"."},{"@language":"sv","@value":"Hbtq+-personer som har utsatts för människohandel och som kan ha överlevt eller inte. Följ individens eget språkbruk om de föredrar ”offer” eller ”överlevare”."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000312"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0003746"},{"@id":"https://homosaurus.org/v5/homoit0003750"},{"@id":"https://homosaurus.org/v5/homoit0003754"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0003747"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-30"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000313","dc:identifier":"homoit0000313","skos:prefLabel":[{"@language":"en","@value":"Criminal law"},{"@language":"de","@value":"Strafrecht"},{"@language":"es","@value":"Derecho penal"},{"@language":"nl","@value":"Strafrecht"},{"@language":"sv","@value":"Straffrätt"}],"skos:altLabel":[{"@language":"de","@value":"Strafgesetz"},{"@language":"es","@value":"Ley penal"},{"@language":"es","@value":"Leyes penales"}],"rdfs:comment":[{"@language":"en","@value":"Body of law relating to crime that prescribes the legality and consequences of conduct perceived as threatening, harmful, or endangering to the property, health, safety, and/or moral welfare of oneself and others. "},{"@language":"de","@value":"Gesamtheit der Rechtsvorschriften im Bereich der Kriminalität, die die Rechtmäßigkeit und die Folgen von Handlungen regeln, die als bedrohlich, schädlich oder gefährlich für das Eigentum, die Gesundheit, die Sicherheit und/oder das moralische Wohlergehen von sich selbst und anderen angesehen werden."},{"@language":"es","@value":"Conjunto de leyes relativas al delito que prescribe la legalidad y las consecuencias de conductas percibidas como amenazantes, dañinas o que ponen en peligro la propiedad, la salud, la seguridad y/o el bienestar moral de uno mismo y de los demás."},{"@language":"nl","@value":"Wetgeving met betrekking tot misdaad die de wettigheid en gevolgen voorschrijft van gedrag dat wordt gezien als bedreigend, schadelijk of in gevaar brengend voor het eigendom, de gezondheid, veiligheid en/of het morele welzijn van zichzelf en anderen."},{"@language":"sv","@value":"Rättsområde som rör brott och som fastställer laglighet och konsekvenser av handlingar som uppfattas som hotande, skadliga eller farliga för egendom, hälsa, säkerhet och/eller moralisk välfärd för en själv eller andra."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000702"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000314"},{"@id":"https://homosaurus.org/v5/homoit0000339"},{"@id":"https://homosaurus.org/v5/homoit0001289"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85034058"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000702"},"dc:replaces":{"@id":"http://homosaurus.org/v2/criminalLaw"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000314","dc:identifier":"homoit0000314","skos:prefLabel":[{"@language":"en-us","@value":"Criminalization"},{"@language":"es","@value":"Criminalización"},{"@language":"de","@value":"Kriminalisierung"},{"@language":"fr","@value":"Criminalisation"},{"@language":"nl","@value":"Criminalisering"},{"@language":"sv","@value":"Kriminalisering"},{"@language":"en-gb","@value":"Criminalisation"}],"rdfs:comment":[{"@language":"en","@value":"The process by which behaviors and individuals are framed as and come to be known as criminal."},{"@language":"es","@value":"El proceso mediante el cual conductas y personas son concebidas y llegan a ser conocidas como delictivas."},{"@language":"de","@value":"Der Prozess, durch den Verhaltensweisen und Personen als kriminell eingestuft werden und als solche bekannt werden."},{"@language":"fr","@value":"Processus juridique et législatif par lequel une autorité compétente qualifie un comportement ou un acte d'infraction criminelle, le rendant ainsi illégal et passible de sanctions pénales. Ce terme s'utilise également en criminologie pour désigner le processus social qui qualifie certaines personnes ou actions de criminelles."},{"@language":"nl","@value":"Proces waarbij gedragingen worden getransformeerd tot misdaad en individuen tot criminelen"},{"@language":"sv","@value":"Processen genom vilken beteenden och individer beskrivs som och uppfattas som kriminella."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000313"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0002379"},{"@id":"https://homosaurus.org/v5/homoit0002388"},{"@id":"https://homosaurus.org/v5/homoit0003773"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000339"},{"@id":"https://homosaurus.org/v5/homoit0001139"},{"@id":"https://homosaurus.org/v5/homoit0003499"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000702"},"dc:replaces":{"@id":"http://homosaurus.org/v2/criminalisation"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002379","dc:identifier":"homoit0002379","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ criminalization"},{"@language":"es","@value":"Criminalización LGBTQ+"},{"@language":"ja","@value":"LGBTQ+に関連することの刑事罰化"},{"@language":"nl","@value":"LHBTQ+-criminalisering"},{"@language":"sv","@value":"Kriminalisering (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"Criminalization of LGBTQ+ people"},{"@language":"es","@value":"Criminalización de personas LGBTQ+"},{"@language":"ja","@value":"LGBTQ+の人々に関連することの刑事罰化"},{"@language":"sv","@value":"Hbtq+-kriminalisering"}],"rdfs:comment":[{"@language":"en","@value":"Criminalization of existing or identifying as an LGBTQ+ person, being perceived as LGBTQ+, or engaging in any of various actions considered to be linked to LGBTQ+ status."},{"@language":"es","@value":"La criminalización de una persona LGBTQ+ por existir o identificarse como tal, ser percibida como LGBTQ+ o participar de cualquiera de las diversas acciones consideradas vinculadas al estatus LGBTQ+."},{"@language":"ja","@value":"LGBTQ+であることや、LGBTQ+であると自認すること、LGBTQ+であると見なされること、あるいはLGBTQ+の立場に関連するとみなされる様々な行為を行うことに対する刑事罰化。"},{"@language":"nl","@value":"Criminalisering van het bestaan of de identificatie als LHBTQ+-persoon, het worden gezien als LHBTQ+, of het deelnemen aan een van de verschillende acties waarvan wordt aangenomen dat deze verband houden met de LHBTQ+-status."},{"@language":"sv","@value":"Kriminalisering av att vara eller identifiera sig som hbtq+-person, att uppfattas som hbtq+, eller att delta i handlingar som kopplas till hbtq+."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000314"},"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0002380"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000356"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000702"},"dc:issued":{"@type":"xsd:date","@value":"2023-01-13"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002388","dc:identifier":"homoit0002388","skos:prefLabel":[{"@language":"en","@value":"Criminalization of gender non-conformity"},{"@language":"es","@value":"Criminalización de la disidencia de género"},{"@language":"de","@value":"Kriminalisierung von Gender-Nonkonformität"},{"@language":"nl","@value":"Criminalisering van gender niet-conformiteit"},{"@language":"sv","@value":"Kriminalisering av könsöverskridande"}],"rdfs:comment":[{"@language":"en","@value":"Criminalization of any expression of gender considered to be nonconforming in a given sociocultural context."},{"@language":"es","@value":"La criminalización de cualquier expresión de género considerada disconforme en un determinado contexto sociocultural."},{"@language":"de","@value":"Kriminalisierung jeglicher Ausdrucksform von Geschlecht, die in einem bestimmten soziokulturellen Kontext als nonkonform angesehen wird."},{"@language":"nl","@value":"Strafbaarstelling van elke uiting van gender die in een bepaalde sociaal-culturele context als niet-conform wordt beschouwd."},{"@language":"sv","@value":"Kriminalisering av könsuttryck som i en given sociokulturell kontext anses vara normbrytande."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000314"},"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0002389"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001922"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000702"},"dc:issued":{"@type":"xsd:date","@value":"2023-01-13"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003773","dc:identifier":"homoit0003773","skos:prefLabel":[{"@language":"en","@value":"Criminalization of sex work"},{"@language":"nl","@value":"Criminalisering van sekswerk"},{"@language":"sv","@value":"Kriminalisering av sexarbete och prostitution"},{"@language":"en-gb","@value":"Criminalisation of sex work"}],"skos:altLabel":[{"@language":"en","@value":"Sex work criminalization"},{"@language":"en","@value":"Criminalization of prostitution"},{"@language":"en","@value":"Prostitution criminalization"},{"@language":"nl","@value":"Sekswerk criminalisering"},{"@language":"sv","@value":"Kriminalisering av prostitution"},{"@language":"sv","@value":"Kriminalisering av sexarbete"}],"rdfs:comment":[{"@language":"en","@value":"The process by which the practice and solicitation of sex work is made criminal, typically by introducing laws, regulations, and criminal penalties. Efforts to criminalize sex work often target street sex work and other forms of \"direct,\" visible sex work."},{"@language":"nl","@value":"Het proces waarbij de praktijk en het werven van sekswerk strafbaar wordt gesteld, doorgaans door het invoeren van wetten, regels en strafrechtelijke sancties. Pogingen om sekswerk strafbaar te stellen, richten zich vaak op straat-sekswerk en andere vormen van \"direct\", zichtbaar sekswerk."},{"@language":"sv","@value":"Processen genom vilken utövandet och erbjudandet av sexarbete eller prostitution görs olagligt, vanligtvis genom införandet av lagar, regleringar och straffrättsliga påföljder. Försök att kriminalisera sexarbete/prostitution riktas ofta mot gatuprostitution och andra former av ”direkt” och synligt sexarbete."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000314"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0003772"},{"@id":"https://homosaurus.org/v5/homoit0003774"},{"@id":"https://homosaurus.org/v5/homoit0003775"},{"@id":"https://homosaurus.org/v5/homoit0003776"},{"@id":"https://homosaurus.org/v5/homoit0003777"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000702"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-30"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000315","dc:identifier":"homoit0000315","skos:prefLabel":[{"@language":"en","@value":"Cross-cultural relationships"},{"@language":"es","@value":"Relaciones interculturales"},{"@language":"de","@value":"Interkulturelle Beziehungen"},{"@language":"nl","@value":"Interculturele relaties"},{"@language":"sv","@value":"Interkulturella relationer"}],"skos:altLabel":[{"@language":"en","@value":"Intercultural relationships"},{"@language":"en","@value":"Interracial relationships"},{"@language":"es","@value":"Relaciones interraciales"},{"@language":"es","@value":"Relaciones interculturales"},{"@language":"sv","@value":"Förhållanden över kulturgränser"},{"@language":"sv","@value":"Interkulturella förhållanden"},{"@language":"sv","@value":"Relationer över kulturgränser"},{"@language":"sv","@value":"Tvärkulturella förhållanden"},{"@language":"sv","@value":"Tvärkulturella relationer"}],"rdfs:comment":[{"@language":"en","@value":"Relationships between people of different ethnic or racial backgrounds."},{"@language":"es","@value":"Relaciones entre personas de diferentes orígenes étnicos o raciales."},{"@language":"de","@value":"Beziehungen zwischen Menschen unterschiedlicher Ethnie oder Herkunft."},{"@language":"nl","@value":"relaties tussen personen uit verschillende culturen ofvan verschillende etnische afkomst"},{"@language":"sv","@value":"Relationer mellan personer med olika etnisk eller rasbakgrund."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001237"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001295"},{"@id":"https://homosaurus.org/v5/homoit0001636"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001237"},"dc:replaces":{"@id":"http://homosaurus.org/v2/cross-culturalRelationships"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001636","dc:identifier":"homoit0001636","skos:prefLabel":[{"@language":"en","@value":"Relationship orientation"},{"@language":"es","@value":"Orientación relacional"},{"@language":"nl","@value":"Relatie-oriëntatie"},{"@language":"sv","@value":"Relationspreferens"}],"skos:altLabel":{"@language":"sv","@value":"Relationsorientering"},"rdfs:comment":[{"@language":"en","@value":"An individual's preference toward or away from a particular relationship model."},{"@language":"es","@value":"La preferencia de una persona con respecto a un modelo relacional particular."},{"@language":"nl","@value":"Iemands voorkeur voor of tegen een bepaald relatievorm."},{"@language":"sv","@value":"En individs preferens för eller mot en viss relationsmodell."}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0001019"},{"@id":"https://homosaurus.org/v5/homoit0001659"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000315"},{"@id":"https://homosaurus.org/v5/homoit0000663"},{"@id":"https://homosaurus.org/v5/homoit0001237"},{"@id":"https://homosaurus.org/v5/homoit0001298"},{"@id":"https://homosaurus.org/v5/homoit0001302"},{"@id":"https://homosaurus.org/v5/homoit0001650"},{"@id":"https://homosaurus.org/v5/homoit0001828"},{"@id":"https://homosaurus.org/v5/homoit0003229"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001636"},"dc:replaces":{"@id":"http://homosaurus.org/v2/relationshipOrientation"},"dc:issued":{"@type":"xsd:date","@value":"2020-12-11"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000373","dc:identifier":"homoit0000373","skos:prefLabel":[{"@language":"en","@value":"Drag kings"},{"@language":"es","@value":"Drag kings"},{"@language":"de","@value":"Dragkings"},{"@language":"nl","@value":"Drag kings"},{"@language":"sv","@value":"Dragkings"}],"skos:altLabel":[{"@language":"es","@value":"Reyes drag"},{"@language":"de","@value":"Drag-Kings"}],"rdfs:comment":[{"@language":"en","@value":"Performers, often people assigned female at birth, who dress in stereotypically masculine attire and enact masculine personas for the purpose of entertainment."},{"@language":"es","@value":"Artistas, a menudo personas asignadas al sexo femenino al nacer, que se visten con atuendos estereotípicamente masculinos y representan personajes masculinos con el propósito de entretener."},{"@language":"de","@value":"Künstler:innen, denen bei der Geburt häufig eine weibliche Rolle zugewiesen wurde und zu Unterhaltungszwecken stereotypisch männliche Kleidung tragen und männliche Rollen spielen."},{"@language":"nl","@value":"Een artiest, vaak een persoon die bij de geboorte als vrouw is toegewezen, die zich kleedt in stereotiepe mannelijke kleding en een mannelijke persoon opvoert voor amusementsdoeleinden."},{"@language":"sv","@value":"Artister, ofta personer som tilldelats kvinnligt kön vid födseln, som klär sig i stereotypiskt maskulina kläder och gestaltar maskulina personas i underhållningssyfte."}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000316"},{"@id":"https://homosaurus.org/v5/homoit0000367"},{"@id":"https://homosaurus.org/v5/homoit0000370"},{"@id":"https://homosaurus.org/v5/homoit0000371"},{"@id":"https://homosaurus.org/v5/homoit0000372"},{"@id":"https://homosaurus.org/v5/homoit0000374"},{"@id":"https://homosaurus.org/v5/homoit0000375"},{"@id":"https://homosaurus.org/v5/homoit0000983"},{"@id":"https://homosaurus.org/v5/homoit0001906"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2021001446"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000373"},"dc:replaces":{"@id":"http://homosaurus.org/v2/dragKings"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000375","dc:identifier":"homoit0000375","skos:prefLabel":[{"@language":"en","@value":"Drag queens"},{"@language":"es","@value":"Drag queens"},{"@language":"de","@value":"Dragqueens"},{"@language":"nl","@value":"Drag queens"},{"@language":"sv","@value":"Dragqueens"}],"skos:altLabel":[{"@language":"es","@value":"Reinas drag"},{"@language":"de","@value":"Drag-Queens"}],"rdfs:comment":[{"@language":"en","@value":"Performers, often people assigned male at birth, who dress in stereotypically feminine attire and enact feminine personas for the purpose of entertainment."},{"@language":"es","@value":"Artistas, a menudo personas asignadas al sexo masculino al nacer, que se visten con atuendos estereotípicamente femeninos y representan personajes femeninos con el propósito de entretener."},{"@language":"de","@value":"Künstler:innen, denen bei der Geburt häufig eine männliche Rolle zugewiesen wurden und zu Unterhaltungszwecken stereotypisch weibliche Kleidung tragen und weibliche Rollen spielen."},{"@language":"nl","@value":"Een artiest, vaak een persoon die bij de geboorte als man is toegewezen, die zich kleedt in stereotiepe vrouwelijke kleding en een vrouwelijk personage voorstelt ​​voor amusementsdoeleinden."},{"@language":"sv","@value":"Artister, ofta personer som tilldelats manligt kön vid födseln, som klär sig i stereotypiskt feminina kläder och gestaltar feminina personas i underhållningssyfte."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001148"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000316"},{"@id":"https://homosaurus.org/v5/homoit0000367"},{"@id":"https://homosaurus.org/v5/homoit0000370"},{"@id":"https://homosaurus.org/v5/homoit0000371"},{"@id":"https://homosaurus.org/v5/homoit0000372"},{"@id":"https://homosaurus.org/v5/homoit0000373"},{"@id":"https://homosaurus.org/v5/homoit0000374"},{"@id":"https://homosaurus.org/v5/homoit0000431"},{"@id":"https://homosaurus.org/v5/homoit0001906"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2021001445"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/dragQueens"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000396","dc:identifier":"homoit0000396","skos:prefLabel":[{"@language":"en","@value":"Eonist people"},{"@language":"es","@value":"Personas eonistas"},{"@language":"fr","@value":"Personnes éonistes"},{"@language":"nl","@value":"Eonisten"},{"@language":"sv","@value":"Eonister"}],"skos:altLabel":[{"@language":"es","@value":"Eonistas"},{"@language":"fr","@value":"Travestie"},{"@language":"fr","@value":"Hommes travestis"}],"rdfs:comment":[{"@language":"en","@value":"Historical term for people assigned male at birth who adopt feminine behaviors."},{"@language":"es","@value":"Término histórico para personas asignadas al sexo masculino al nacer que adoptan comportamientos femeninos."},{"@language":"fr","@value":"Terme historique désignant les personnes assignées au genre masculin à la naissance qui adoptent des comportements féminins."},{"@language":"sv","@value":"Historisk benämning på personer som tilldelats manligt kön vid födseln och som antog feminina beteenden."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000878"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000316"},{"@id":"https://homosaurus.org/v5/homoit0000395"},{"@id":"https://homosaurus.org/v5/homoit0001378"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000878"},"dc:replaces":{"@id":"http://homosaurus.org/v2/eonistPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001076","dc:identifier":"homoit0001076","skos:prefLabel":[{"@language":"en","@value":"Parents of crossdressers"},{"@language":"es","@value":"Madres y padres de transformistas"},{"@language":"nl","@value":"Ouders van crossdressers"},{"@language":"sv","@value":"Föräldrar till crossdressare"}],"skos:altLabel":[{"@language":"es","@value":"Madres de transformistas"},{"@language":"es","@value":"Padres de transformistas"}],"rdfs:comment":[{"@language":"en","@value":"People who act as parents to one or more crossdresser. Only use to describe the parents of someone who self-identifies as a crossdresser."},{"@language":"es","@value":"Personas que actúan como padres de uno o más transformistas. Utilícese únicamente para describir a los padres de alguien que se autoidentifican como transformistas."},{"@language":"nl","@value":"Ouders van mensen die crossdresser zijn; alleen gebruiken wanneer de persoon zichzelf identificeert als een crossdresser"},{"@language":"sv","@value":"Personer som fungerar som föräldrar till en eller flera personer som identifierar sig som crossdressare. Använd endast för föräldrar till personer som själva identifierar sig som crossdressare."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002372"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000316"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000421"},"dc:replaces":{"@id":"http://homosaurus.org/v2/parentsOfCrossdressers"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001085","dc:identifier":"homoit0001085","skos:prefLabel":[{"@language":"en","@value":"Partners of crossdressers"},{"@language":"es","@value":"Parejas de transformistas"},{"@language":"nl","@value":"Partners van crossdressers"},{"@language":"sv","@value":"Partners till crossdressare"}],"rdfs:comment":[{"@language":"en","@value":"People whose sexual, romantic, or play partner is a crossdresser. Only use to describe individuals whose partners self-identify as crossdressers."},{"@language":"es","@value":"Personas cuya pareja sexual, romántica o de juego es transformista. Utilícese únicamente para describir personas cuyas parejas se autoidentifiquen como transformistas."},{"@language":"nl","@value":"Seksuele, romantische of speelpartners van crossdressers. Alleen gebruiken om personen te beschrijven wiens partners zichzelf identificeren als crossdressers."},{"@language":"sv","@value":"Personer som har en romantisk, sexuell eller kinkbaserad relation med en crossdresser. Använd endast för personer vars partner själv identifierar sig som crossdresser."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002365"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000316"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0002365"},"dc:replaces":{"@id":"http://homosaurus.org/v2/partnersOfCrossdressers"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001470","dc:identifier":"homoit0001470","skos:prefLabel":[{"@language":"en","@value":"Transvestites"},{"@language":"es","@value":"Travestis"},{"@language":"nl","@value":"Travestieten"},{"@language":"sv","@value":"Transvestiter"}],"rdfs:comment":[{"@language":"en","@value":"U.S. historical term used to describe individuals who wear clothes associated with a gender other than their gender assigned at birth; generally considered to be a derogatory term; use only in historical contexts."},{"@language":"es","@value":"Término histórico estadounidense utilizado para describir a personas que utilizan ropa asociada con un género distinto al asignado al nacer; generalmente se considera un término despectivo; utilícese únicamente en contextos históricos."},{"@language":"nl","@value":"Historische term die wordt gebruikt om personen te beschrijven die kleding dragen die geassocieerd wordt met een ander geslacht dan hun geslacht dat bij geboorte is toegewezen; algemeen beschouwd als een denigrerende term; alleen gebruiken in historische context"},{"@language":"sv","@value":"En person som klär sig som ett annat kön än det den identifierar sig som, att det är en del av personens identitet och att personen själv definierar sig som transvestit."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000878"},{"@id":"https://homosaurus.org/v5/homoit0001817"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000316"},{"@id":"https://homosaurus.org/v5/homoit0001378"},{"@id":"https://homosaurus.org/v5/homoit0001781"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000878"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transvestites"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000317","dc:identifier":"homoit0000317","skos:prefLabel":[{"@language":"en","@value":"Hormone therapy (Gender)"},{"@language":"de","@value":"Hormontherapie (geschlechtsangleichend)"},{"@language":"es","@value":"Terapia hormonal (género)"},{"@language":"nl","@value":"Hormoontherapie (Gender)"},{"@language":"sv","@value":"Hormonbehandling (kön)"}],"skos:altLabel":[{"@language":"en","@value":"Cross-gender hormone therapy"},{"@language":"en","@value":"Hormone reassignment therapy"},{"@language":"en","@value":"Hormone replacement therapy"},{"@language":"de","@value":"geschlechtsbestätigende Hormontherapie"},{"@language":"de","@value":"gschlechtsangleichende Hormontherapie"},{"@language":"de","@value":"Hormonersatztherapie"},{"@language":"es","@value":"Terapia de reemplazo hormonal"},{"@language":"es","@value":"Terapia de hormonas"},{"@language":"nl","@value":"Hormoonvervangingstherapie"}],"rdfs:comment":[{"@language":"en","@value":"The process of altering one's sex hormones using hormone blockers and/or doses of testosterone, estrogen, or progesterone."},{"@language":"de","@value":"Der Prozess, bei dem die eigenen Geschlechtshormone mittels Hormonblockern und/oder durch die Verabreichung von Testosteron, Östrogen oder Progesteron angepasst werden."},{"@language":"es","@value":"El proceso de alterar las hormonas sexuales utilizando bloqueadores hormonales y/o dosis de testosterona, estrógeno o progesterona."},{"@language":"nl","@value":"Het proces van het veranderen van iemands geslachtshormonen met behulp van hormoonblokkers en/of doses testosteron, oestrogeen of progesteron."},{"@language":"sv","@value":"Processen att påverka kroppens könshormoner genom användning av hormonblockerare och/eller tillförsel av testosteron, östrogen eller progesteron."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001366"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000407"},{"@id":"https://homosaurus.org/v5/homoit0000650"},{"@id":"https://homosaurus.org/v5/homoit0001362"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001007"},{"@id":"https://homosaurus.org/v5/homoit0001047"},{"@id":"https://homosaurus.org/v5/homoit0001378"},{"@id":"https://homosaurus.org/v5/homoit0002820"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2020000101"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001004"},"dc:replaces":{"@id":"http://homosaurus.org/v2/hormoneTherapyGender"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000407","dc:identifier":"homoit0000407","skos:prefLabel":[{"@language":"en","@value":"Estrogen"},{"@language":"es","@value":"Estrógeno"},{"@language":"de","@value":"Östrogen"},{"@language":"nl","@value":"Oestrogeen"},{"@language":"sv","@value":"Östrogen"}],"skos:altLabel":[{"@language":"de","@value":"Estrogene"},{"@language":"de","@value":"Follikelhormone"}],"rdfs:comment":[{"@language":"en","@value":"A category of steroid hormones including estrone, estradiol, estriol, and estetrol. Estrogens are commonly utilized in feminizing hormone therapy regimens. Estrogens are produced mainly in the ovaries, in addition to the adrenal glands and fat cells. Responsible for certain secondary sexual characteristics, including breast growth, thickening of the endometrium, menstrual cycle regulation, and sperm maturation."},{"@language":"es","@value":"Una categoría de hormonas esteroides que incluye la estrona, estradiol, estriol y estetrol. Los estrógenos se utilizan comúnmente en regímenes de terapia hormonal feminizante. Los estrógenos se producen principalmente en los ovarios, además de las glándulas suprarrenales y las células grasas. Son responsables de ciertas características sexuales secundarias, incluido el crecimiento de los senos, el engrosamiento del endometrio, la regulación del ciclo menstrual y la maduración de los espermatozoides."},{"@language":"de","@value":"Eine Kategorie von Steroidhormonen, zu denen Östron, Östradiol, Östriol und Östetrol gehören. Östrogene werden häufig in hormonellen Therapien zur Feminisierung eingesetzt. Östrogene werden hauptsächlich in den Eierstöcken, aber auch in den Nebennieren und Fettzellen produziert. Sie sind für bestimmte sekundäre Geschlechtsmerkmale verantwortlich, darunter das Wachstum der Brüste, die Verdickung der Gebärmutterschleimhaut, die Regulierung des Menstruationszyklus und die Reifung der Spermien."},{"@language":"nl","@value":"Een categorie van steroïde hormonen, waaronder oestron, estradiol, estriol en estetrol. Oestrogenen worden vaak gebruikt bij feminiserende hormoontherapieregimes. Oestrogenen worden voornamelijk geproduceerd in de eierstokken, naast de bijnieren en vetcellen. Verantwoordelijk voor bepaalde secundaire geslachtskenmerken, waaronder borstgroei, verdikking van het endometrium, regulatie van de menstruatiecyclus en rijping van sperma."},{"@language":"sv","@value":"En kategori steroidhormon som bildas främst i gonaderna, huvudsakligen i ovarier men även i testiklar, binjurar och fettvävnad. De inkluderar östrogen (E1), östradiol (E2), östriol (E3) och estetrol (E4). Östrogener påverkar bland annat bröstutveckling, förtjockning av livmoderslemhinnan, menstruationscykelns reglering och spermieutveckling."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000317"},{"@id":"https://homosaurus.org/v5/homoit0000651"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000986"},{"@id":"https://homosaurus.org/v5/homoit0001642"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85045012"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001004"},"dc:replaces":{"@id":"http://homosaurus.org/v2/estrogen"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000650","dc:identifier":"homoit0000650","skos:prefLabel":[{"@language":"en","@value":"Hormone blockers"},{"@language":"es","@value":"Bloqueadores hormonales"},{"@language":"de","@value":"Hormonblocker"},{"@language":"nl","@value":"Hormoonremmers"},{"@language":"sv","@value":"Hormonblockerare"}],"skos:altLabel":[{"@language":"de","@value":"Hormonhemmer"},{"@language":"sv","@value":"Stopphormoner"},{"@language":"sv","@value":"Pubertetsblockerare"}],"rdfs:comment":[{"@language":"en","@value":"Medications used to block the body from producing certain hormones in order to replace or supplement them with other types of hormones."},{"@language":"es","@value":"Medicamentos utilizados para impedir que el cuerpo produzca ciertas hormonas con el fin de reemplazarlas o complementarlas con otros tipos de hormonas."},{"@language":"de","@value":"Medikamente, die die Bildung bestimmter Hormone im Körper unterdrücken, um sie durch andere Hormone zu ersetzen oder zu ergänzen."},{"@language":"nl","@value":"Medicatie die wordt gebruikt om te voorkomen dat het lichaam bepaalde hormonen aanmaakt om ze te vervangen of aan te vullen met andere."},{"@language":"sv","@value":"Läkemedel som blockerar kroppens produktion av vissa hormoner i syfte att ersätta dem eller komplettera med andra hormoner."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000317"},{"@id":"https://homosaurus.org/v5/homoit0001007"}],"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0001138"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85061977"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001004"},"dc:replaces":{"@id":"http://homosaurus.org/v2/hormoneBlockers"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001362","dc:identifier":"homoit0001362","skos:prefLabel":[{"@language":"en","@value":"Testosterone"},{"@language":"es","@value":"Testosterona"},{"@language":"nl","@value":"Testosteron"},{"@language":"sv","@value":"Testosteron"}],"rdfs:comment":[{"@language":"en","@value":"A steroid hormone that is produced in the testes, ovaries, and adrenal cortex. Testosterone is commonly utilized in masculinizing hormone therapy regimens for certain secondary sexual characteristics, such as increased muscle mass and growth of body hair."},{"@language":"es","@value":"Hormona esteroide que se produce en los testículos, los ovarios y la corteza suprarrenal. La testosterona se utiliza comúnmente en regímenes de terapia hormonal masculinizante para ciertas características sexuales secundarias, como el aumento de la masa muscular y el crecimiento del vello corporal."},{"@language":"nl","@value":"Een steroïde hormoon dat voornamelijk in de teelballen wordt geproduceerd, naast de eierstokken en de bijnierschors. Testosteron wordt vaak gebruikt bij masculiniserende hormoontherapie voor bepaalde secundaire geslachtskenmerken, zoals verhoogde spiermassa en groei van lichaamshaar."},{"@language":"sv","@value":"Ett steroidhormon som produceras i testiklarna, äggstockarna och binjurebarken. Testosteron används ofta i hormonbehandling med syfte att förstärka vissa maskulina sekundära könskarakteristika som ökad muskelmassa och kroppshår."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000317"},{"@id":"https://homosaurus.org/v5/homoit0000651"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000436"},{"@id":"https://homosaurus.org/v5/homoit0001643"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85134159"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001004"},"dc:replaces":{"@id":"http://homosaurus.org/v2/testosterone"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001007","dc:identifier":"homoit0001007","skos:prefLabel":[{"@language":"en","@value":"Medication"},{"@language":"es","@value":"Medicamento"},{"@language":"nl","@value":"Medicatie"},{"@language":"sv","@value":"Läkemedel"}],"skos:altLabel":[{"@language":"en","@value":"Pharmaceuticals"},{"@language":"es","@value":"Productos farmacéuticos"},{"@language":"es","@value":"Farmacéuticos"},{"@language":"sv","@value":"Farmaka"},{"@language":"sv","@value":"Mediciner"}],"rdfs:comment":[{"@language":"en","@value":"Non-recreational drugs as used by members of the LGBTQ+ community."},{"@language":"es","@value":"Drogas no recreativas utilizadas por miembros de la comunidad LGBTQ+."},{"@language":"sv","@value":"Icke-rekreationella droger som används av personer inom hbtq+-gemenskaper."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001366"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000399"},{"@id":"https://homosaurus.org/v5/homoit0000650"},{"@id":"https://homosaurus.org/v5/homoit0001091"},{"@id":"https://homosaurus.org/v5/homoit0001138"},{"@id":"https://homosaurus.org/v5/homoit0001981"},{"@id":"https://homosaurus.org/v5/homoit0003909"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000317"},{"@id":"https://homosaurus.org/v5/homoit0000380"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85039719"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001004"},"dc:replaces":{"@id":"http://homosaurus.org/v2/medication"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001047","dc:identifier":"homoit0001047","skos:prefLabel":[{"@language":"en","@value":"No hormone identity"},{"@language":"es","@value":"Identidad sin hormonas"},{"@language":"nl","@value":"No hormone identiteit"},{"@language":"sv","@value":"No hormone-identitet"}],"rdfs:comment":[{"@language":"en","@value":"Individuals who have not undergone hormone treatment; typically used to describe trans people who have not undergone and/or do not plan to undergo hormone treatment."},{"@language":"es","@value":"Personas que no se han sometido a tratamiento hormonal; normalmente se utiliza para describir a personas trans que no se han sometido y/o no planean someterse a tratamiento hormonal."},{"@language":"nl","@value":"Personen die geen hormoonbehandeling hebben ondergaan; meestal gebruikt om transgender personen te beschrijven die geen hormoonbehandeling hebben ondergaan en/of niet van plan zijn om een hormoonbehandeling te ondergaan."},{"@language":"sv","@value":"Personer som inte genomgått hormonbehandling. Används vanligtvis för att beskriva transpersoner som inte genomgått och/eller inte planerar att genomgå hormonbehandling."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001464"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000317"},{"@id":"https://homosaurus.org/v5/homoit0000617"},{"@id":"https://homosaurus.org/v5/homoit0001049"},{"@id":"https://homosaurus.org/v5/homoit0001378"},{"@id":"https://homosaurus.org/v5/homoit0001381"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001465"},"dc:replaces":{"@id":"http://homosaurus.org/v2/noHormoneIdentity"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002820","dc:identifier":"homoit0002820","skos:prefLabel":[{"@language":"en","@value":"Androgens"},{"@language":"es","@value":"Andrógenos"},{"@language":"de","@value":"Androgene"},{"@language":"nl","@value":"Androgenen"},{"@language":"sv","@value":"Androgener"}],"rdfs:comment":[{"@language":"en","@value":"A term that encompasses testosterone, dihydrotestosterone, and other hormones primarily produced in the testes but also in the ovaries and adrenal glands."},{"@language":"es","@value":"Un término que abarca a la testosterona, la dihidrotestosterona y otras hormonas producidas principalmente en los testículos, pero también en los ovarios y las glándulas suprarrenales."},{"@language":"de","@value":"Ein Begriff, der Testosteron, Dihydrotestosteron und andere Hormone umfasst, die hauptsächlich in den Hoden, aber auch in den Eierstöcken und Nebennieren produziert werden."},{"@language":"nl","@value":"Een term die testosteron, dihydrotestosteron en andere hormonen omvat die voornamelijk in de testikels worden geproduceerd, maar ook in de eierstokken en de bijnieren."},{"@language":"sv","@value":"Könshormon som huvudsakligen produceras i testiklar, äggstockar och binjuren och som främst avser testosteron och dihydrotestosteron men även andra förstadier till olika könshormon."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000651"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000317"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001269"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000395","dc:identifier":"homoit0000395","skos:prefLabel":[{"@language":"en","@value":"Eonism"},{"@language":"es","@value":"Eonismo"},{"@language":"de","@value":"Eonismus"},{"@language":"fr","@value":"Éonisme"},{"@language":"nl","@value":"Eonisme"},{"@language":"sv","@value":"Eonism"}],"skos:altLabel":[{"@language":"fr","@value":"Travestisme"},{"@language":"fr","@value":"Travestisme masculin"},{"@language":"fr","@value":"Travestime sans érotisation"}],"rdfs:comment":[{"@language":"en","@value":"Historical term used to describe people assigned male at birth who adopt feminine behaviors."},{"@language":"es","@value":"Término histórico utilizado para describir a las personas asignadas al sexo masculino al nacer y que adoptan comportamientos femeninos."},{"@language":"de","@value":"Historischer Begriff für die Beschreibung von Menschen, denen bei der Geburt das männliche Geschlecht zugewiesen wurde und die weibliche Verhaltensweisen annehmen."},{"@language":"fr","@value":"Terme historique désignant l'adoption, par les personnes assignées au genre masculin à la naissance, de comportements féminins."},{"@language":"nl","@value":"Historische term die wordt gebruikt om mensen te beschrijven die bij de geboorte als man zijn toegewezen en die feminiem gedrag aannemen"},{"@language":"sv","@value":"Historisk term som användes för att beskriva personer som tilldelats manligt kön vid födseln och som antog feminina beteenden."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000568"},{"@id":"https://homosaurus.org/v5/homoit0000878"},{"@id":"https://homosaurus.org/v5/homoit0001006"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000318"},{"@id":"https://homosaurus.org/v5/homoit0000396"},{"@id":"https://homosaurus.org/v5/homoit0001296"},{"@id":"https://homosaurus.org/v5/homoit0001463"},{"@id":"https://homosaurus.org/v5/homoit0001468"},{"@id":"https://homosaurus.org/v5/homoit0001469"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/eonism"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000685","dc:identifier":"homoit0000685","skos:prefLabel":[{"@language":"ja","@value":"Kabuki"},{"@language":"es","@value":"Kabuki"},{"@language":"ja","@value":"歌舞伎"},{"@language":"nl","@value":"Kabuki"},{"@language":"sv","@value":"Kabuki"}],"skos:altLabel":{"@language":"ja","@value":"かぶき"},"rdfs:comment":[{"@language":"en","@value":"A form of theatre in Japan that often features crossdressing actors. Historically, female performers played both male and female roles, but women were later banned from performing and were replaced with male performers who played both male and female roles."},{"@language":"es","@value":"Un tipo de teatro en Japón donde a menudo figuran actores transformistas. Históricamente, actrices asumían los roles masculinos y femeninos, pero eventualmente se le prohibió a las mujeres presentarse en el escenario y fueron reemplazadas por actores que asumían los roles masculinos y femeninos."},{"@language":"ja","@value":"日本では、江戸時代以降、男性と女性の役を男性が演じて登場することが多い演劇の一つ。歴史的には、出雲阿国のような女性役者が男女両方の役を演じていたが、後に女性の出演が禁止され、男女両方の役を演じる男性役者（若衆、野郎）に置き換えられた。"},{"@language":"nl","@value":"traditioneel japanse vorm van theater met cross-dressing acteurs; in het begin speelden vrouwelijke acteurs zowel vrouwen- als mannenrollen,maar later werden vrouwen verbannen en speeldenmannelijke acteurs zowel mannen- als vrouwenrollen"},{"@language":"sv","@value":"En form av teater i Japan som ofta innehåller crossdressing. Historiskt spelade kvinnliga skådespelare både manliga och kvinnliga roller, men kvinnor förbjöds senare att uppträda och ersattes med män som spelade båda rollerna."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001363"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000318"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85071224"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001363"},"dc:replaces":{"@id":"http://homosaurus.org/v2/kabuki"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001233","dc:identifier":"homoit0001233","skos:prefLabel":[{"@language":"en","@value":"Reading (Gender)"},{"@language":"es","@value":"Lectura (género)"},{"@language":"nl","@value":"Reading (Gender)"},{"@language":"sv","@value":"Läsa (kön)"}],"skos:altLabel":[{"@language":"en","@value":"Reading (Transgender)"},{"@language":"es","@value":"Lectura (transgénero)"},{"@language":"es","@value":"Reading (género)"},{"@language":"sv","@value":"Avläsning (kön)"}],"rdfs:comment":[{"@language":"en","@value":"Slang term for the act of identifying (or reading) someone in public as trans, non-binary, crossdressing, or in drag. Unlike Clocking (Gender), which is typically understood as a threat (of violence or outing) against the person being clocked or read, Reading (Gender) refers to shared identification or recognized kinship between two individuals who are both gender minorities."},{"@language":"es","@value":"Término del argot para el acto de identificar (o leer) a alguien en público como trans, no binario, transformista o en drag. A diferencia del fichaje (género), que normalmente se entiende como una amenaza (de violencia o sacar del armario) contra la persona que está siendo fichada o leída, la lectura (género) se refiere a la identificación compartida o el vínculo reconocido entre dos personas que pertenecen a minorías de género."},{"@language":"nl","@value":"Argot voor het identificeren (of lezen/reading) van iemand in het openbaar als trans, non-binair, crossdressing of drag. In tegenstelling tot Clocking (Gender), dat doorgaans wordt opgevat als een bedreiging (met geweld of outing) tegen de persoon die wordt \"geklokt\" of \"gelezen\", verwijst Reading (Gender) naar gedeelde identificatie of erkende verwantschap tussen twee personen die beide behoren tot genderminderheden"},{"@language":"sv","@value":"Slanguttryck för att identifiera eller känna igen någon som transperson, ickebinär, crossdresser eller dragperson i offentligheten. Till skillnad från “klocka”, som ofta har hotfulla undertoner, syftar “läsa” på ömsesidig igenkänning inom marginaliserade grupper."}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000318"},{"@id":"https://homosaurus.org/v5/homoit0001090"},{"@id":"https://homosaurus.org/v5/homoit0001378"},{"@id":"https://homosaurus.org/v5/homoit0001900"},{"@id":"https://homosaurus.org/v5/homoit0002192"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001233"},"dc:replaces":{"@id":"http://homosaurus.org/v2/readingTransgender"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001469","dc:identifier":"homoit0001469","skos:prefLabel":[{"@language":"en","@value":"Transvestism"},{"@language":"es","@value":"Travestismo"},{"@language":"nl","@value":"Travestie"},{"@language":"sv","@value":"Transvestism"}],"rdfs:comment":[{"@language":"en","@value":"U.S. historical term used to describe the practices of individuals who wear clothes associated with a gender other than their gender assigned at birth; generally considered to be a derogatory term; use only in historical contexts."},{"@language":"es","@value":"Término histórico estadounidense utilizado para describir las prácticas de personas que utilizan ropa asociada con un género distinto al asignado al nacer; generalmente se considera un término despectivo; utilícese únicamente en contextos históricos."},{"@language":"nl","@value":"Algemeen beschouwd als een denigrerende term"},{"@language":"sv","@value":"Transvestism innebär att någon klär sig som ett annat kön än det den identifierar sig som, att det är en del av personens identitet och att personen själv definierar sig som transvestit. Har även historiskt använts som en nedsättande term för transidentiteter."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000568"},{"@id":"https://homosaurus.org/v5/homoit0001006"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000318"},{"@id":"https://homosaurus.org/v5/homoit0000395"},{"@id":"https://homosaurus.org/v5/homoit0001563"},{"@id":"https://homosaurus.org/v5/homoit0001895"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transvestism"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003126","dc:identifier":"homoit0003126","skos:prefLabel":[{"@language":"en","@value":"Dollification"},{"@language":"de","@value":"Dollifizierung"},{"@language":"nl","@value":"Dollificatie"},{"@language":"sv","@value":"Dockifiering"}],"skos:altLabel":[{"@language":"en","@value":"Rubber dolling"},{"@language":"de","@value":"Gummi-Dollifizierung"},{"@language":"sv","@value":"Dollification, Bimbofication, Bimbofiering"}],"rdfs:comment":[{"@language":"en","@value":"A practice of dressing and acting like a living doll (through makeup, dressing, etc.) for aesthetic or sexual gratification."},{"@language":"de","@value":"Die Praxis, sich wie eine lebendige Puppe zu kleiden und zu verhalten (durch Schminke, Kleidung, usw.) zur ästhetischen oder sexuellen Befriedigung."},{"@language":"nl","@value":"Een praktijk waarbij men zich kleedt en zich gedraagt als een levende pop (door middel van make-up, aankleden, enz.) voor esthetische of seksuele bevrediging."},{"@language":"sv","@value":"En praktik där en person klär sig och agerar som en levande docka (genom smink, kläder med mera) i estetiskt eller sexuellt syfte."}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000318"},{"@id":"https://homosaurus.org/v5/homoit0000568"},{"@id":"https://homosaurus.org/v5/homoit0001246"},{"@id":"https://homosaurus.org/v5/homoit0003070"},{"@id":"https://homosaurus.org/v5/homoit0003851"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0003126"},"dc:issued":{"@type":"xsd:date","@value":"2023-12-20"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000340","dc:identifier":"homoit0000340","skos:prefLabel":[{"@language":"tha","@value":"Dee"},{"@language":"es","@value":"Dee"},{"@language":"de","@value":"Dee"},{"@language":"nl","@value":"Dee"},{"@language":"sv","@value":"Dee"}],"rdfs:comment":[{"@language":"en","@value":"In Thailand, cisgender women who conform to feminine gender norms and who often partner with masculine-identified toms; similar to a femme in U.S. lesbian culture."},{"@language":"es","@value":"En Tailandia, las mujeres cisgénero que se conforman con las normas de género femeninas y que a menudo se emparejan con \"toms\"; similar a una mujer femme en la cultura lésbica estadounidense."},{"@language":"de","@value":"In Thailand sind dies cisgender Frauen, die weiblichen Geschlechtsnormen entsprechen und oft Beziehungen mit maskulin identifizierten Toms führen; ähnlich wie eine Femme in der lesbischen Kultur der USA."},{"@language":"nl","@value":"In Thailand, cisgender-vrouwen die voldoen aan vrouwelijke gendernormen en die vaak samenwerken met mannelijk geïdentificeerde toms; vergelijkbaar met een femme in de westerse lesbische cultuur"},{"@language":"sv","@value":"I Thailand, ciskvinnor som följer feminina könsnormer och ofta bildar relationer med maskulint identifierade toms. Liknar en femme inom den västerländska lesbiska kulturen."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000322"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000687"},{"@id":"https://homosaurus.org/v5/homoit0001373"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/dee"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000350","dc:identifier":"homoit0000350","skos:prefLabel":[{"@language":"bn","@value":"Dhurani"},{"@language":"es","@value":"Dhurani"},{"@language":"de","@value":"Dhurani"},{"@language":"nl","@value":"Dhurani"},{"@language":"sv","@value":"Dhurani"}],"rdfs:comment":[{"@language":"en","@value":"Bengali term for third sex people, often referring to feminine people who were assigned male at birth."},{"@language":"es","@value":"Término bengalí para personas del tercer sexo, que a menudo se refiere a personas femeninas asignadas al sexo masculino al nacer."},{"@language":"de","@value":"Bengalischer Begriff für Menschen des \"dritten Geschlechts\", der sich oft auf weibliche Personen bezieht, denen bei der Geburt das männliche Geschlecht zugewiesen wurde."},{"@language":"nl","@value":"Bengaalse term voor het derde geslacht, vaak verwijzend naar vrouwelijke, als man toegewezen mensen"},{"@language":"sv","@value":"Bengalisk term för personer som identifieras som ett tredje kön, ofta med hänvisning till feminina personer som tilldelats manligt kön vid födseln."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000322"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/dhurani"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000353","dc:identifier":"homoit0000353","skos:prefLabel":[{"@language":"nv","@value":"Dilbaa"},{"@language":"es","@value":"Dilbaa"},{"@language":"de","@value":"Dilbaa"},{"@language":"nl","@value":"Dilbaa"},{"@language":"sv","@value":"Dilbaa"}],"rdfs:comment":[{"@language":"en","@value":"Navajo term for a person assigned female at birth who takes on the role of a boy in childhood and a man in adulthood."},{"@language":"es","@value":"Término navajo para una persona asignada al sexo femenino al nacer que asume el papel de niño en la infancia y de hombre en la edad adulta."},{"@language":"de","@value":"Navajo-Begriff für eine Person, die bei der Geburt weiblich zugeordnet wurde und in ihrer Kindheit die Rolle eines Jungen und im Erwachsenenalter die Rolle eines Mannes einnimmt."},{"@language":"nl","@value":"Navajo-term voor een persoon die bij de geboorte als vrouw is toegewezen en die de rol op zich neemt van een jongen in de kindertijd en een man op volwassen leeftijd"},{"@language":"sv","@value":"Navajo-term för en person som tilldelats kvinnligt kön vid födseln och som antar en pojkroll i barndomen och en mansroll i vuxenlivet."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000322"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001035"},{"@id":"https://homosaurus.org/v5/homoit0001480"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/dilbaa"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000413","dc:identifier":"homoit0000413","skos:prefLabel":[{"@language":"smo","@value":"Fa'afafine"},{"@language":"es","@value":"Fa'afafine"},{"@language":"de","@value":"Fa'afafine"},{"@language":"nl","@value":"Fa'afafine"},{"@language":"sv","@value":"Fa'afafine"}],"rdfs:comment":[{"@language":"en","@value":"In New Zealand, Samoan people who were assigned male at birth but behave in feminine ways and may consider themselves women."},{"@language":"es","@value":"En Nueva Zelanda, los samoanos a quienes se les asignó al sexo masculino al nacer pero que se comportan de manera femenina y pueden considerarse mujeres."},{"@language":"de","@value":"In Neuseeland: Samoanische Personen, die bei der Geburt als männlich zugewiesen wurden, sich jedoch feminin verhalten und sich möglicherweise als Frauen betrachten."},{"@language":"nl","@value":"In Nieuw-Zeeland, Samoanen die bij hun geboorte als man zijn toegewezen en die zich vrouwelijk gedragen en zichzelf als vrouw kunnen beschouwen"},{"@language":"sv","@value":"I Nya Zeeland, samoanska personer som tilldelats manligt kön vid födseln men uppvisar feminint beteende och kan betrakta sig som kvinnor."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000322"},{"@id":"https://homosaurus.org/v5/homoit0002653"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000414"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/faafafine"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000414","dc:identifier":"homoit0000414","skos:prefLabel":[{"@language":"smo","@value":"Fa'afatama"},{"@language":"es","@value":"Fa'afatama"},{"@language":"de","@value":"Fa'afatama"},{"@language":"nl","@value":"Fa'afatama"},{"@language":"sv","@value":"Fa'afatama"}],"rdfs:comment":[{"@language":"en","@value":"In New Zealand, Samoan people who were assigned female at birth but behave in masculine ways and may consider themselves men."},{"@language":"es","@value":"En Nueva Zelanda, los samoanos a quienes se les asignó al sexo femenino al nacer pero que se comportan de manera masculina y pueden considerarse hombres."},{"@language":"de","@value":"In Neuseeland: Samoanische Personen, die bei der Geburt als weiblich zugewiesen wurden, sich jedoch maskulin verhalten und sich möglicherweise als Männer betrachten."},{"@language":"nl","@value":"In Nieuw-Zeeland, Samoanen die bij hun geboorte als vrouw zijn toegewezen en zich mannelijk gedragen en zichzelf als man kunnen beschouwen"},{"@language":"sv","@value":"I Nya Zeeland, samoanska personer som tilldelats kvinnligt kön vid födseln men uppvisar maskulint beteende och kan betrakta sig som män."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000322"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000413"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/faafatama"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000419","dc:identifier":"homoit0000419","skos:prefLabel":[{"@language":"ton","@value":"Fakaleitī"},{"@language":"es","@value":"Fakaleitī"},{"@language":"de","@value":"Fakaleitī"},{"@language":"nl","@value":"Fakaleiti"},{"@language":"sv","@value":"Fakaleitī"}],"skos:altLabel":[{"@language":"ton","@value":"Fakaleiti"},{"@language":"es","@value":"Fakaleiti"}],"rdfs:comment":[{"@language":"en","@value":"Tongan people assigned male at birth who behave in an effeminate manner."},{"@language":"es","@value":"Personas tonganas asignadas al sexo masculino al nacer que se comportan de forma afeminada."},{"@language":"de","@value":"Tongaische Personen, die bei der Geburt als männlich zugewiesen wurden und sich feminin verhalten."},{"@language":"nl","@value":"Mensen uit Tonga, die bij de geboorte als man kregen toegewezen, die zich feminiem gedragen"},{"@language":"sv","@value":"Tonganska personer som tilldelats manligt kön vid födseln och som uppvisar feminint beteende."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000322"},{"@id":"https://homosaurus.org/v5/homoit0002653"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/fakaleiti"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000441","dc:identifier":"homoit0000441","skos:prefLabel":[{"@language":"nap","@value":"Femminiello"},{"@language":"es","@value":"Femminiello"},{"@language":"de","@value":"Femminiello"},{"@language":"nl","@value":"Femminiello"},{"@language":"sv","@value":"Femminiello"}],"rdfs:comment":[{"@language":"en","@value":"In Italy, this is a Neapolitan term for homosexual men with feminine gender expression. Often considered a third gender; associated with good luck."},{"@language":"es","@value":"En Italia, es un término napolitano para referirse a los hombres homosexuales con expresión de género femenina. A menudo, se considera un tercer género, asociado con la buena suerte."},{"@language":"de","@value":"In Italien ein neapolitanischer Begriff für homosexuelle Männer mit weiblicher Gender-Ausdrucksweise. Oft als drittes Geschlecht angesehen; wird mit Glück assoziiert."},{"@language":"nl","@value":"In Italië, een Napolitaanse term voor homoseksuele mannen met een vrouwelijke genderexpressie; vaak beschouwd als een derde geslacht; geassocieerd met geluk"},{"@language":"sv","@value":"I Italien är detta en neapolitansk term för bögar med feminint könsuttryck. Ofta betraktad som ett tredje kön, förknippat med tur."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000322"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/femminiello"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000461","dc:identifier":"homoit0000461","skos:prefLabel":[{"@language":"lat","@value":"Galli"},{"@language":"es","@value":"Galli"},{"@language":"nl","@value":"Galli"},{"@language":"sv","@value":"Galli"}],"rdfs:comment":[{"@language":"en","@value":"A term originating in Ancient Rome that describes eunuch priestesses who were voluntarily castrated as part of an annual celebration."},{"@language":"es","@value":"Término originado en la Antigua Roma que describe a las sacerdotisas eunucos que fueron castradas voluntariamente como parte de una celebración anual."},{"@language":"nl","@value":"Afgeleid van oude Romeinse religie, een term voor eunuch-priesteressen die vrijwillig zijn gecastreerd tijdens een jaarlijkse viering"},{"@language":"sv","@value":"En term med ursprung i det antika Rom som beskriver eunuck-prästinnor vilka frivilligt kastrerade sig som en del av en årlig ceremoni."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000322"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/galli"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000604","dc:identifier":"homoit0000604","skos:prefLabel":[{"@language":"es","@value":"Güevedoce"},{"@language":"de","@value":"Güevedoce"},{"@language":"nl","@value":"Güevedoche"},{"@language":"sv","@value":"Güevedoce"}],"skos:altLabel":[{"@language":"es","@value":"Guevedoche"},{"@language":"de","@value":"Guevedoche"}],"rdfs:comment":[{"@language":"en","@value":"In the Dominican Republic, this term refers to people who have undifferentiated genitalia and who are generally raised as female until puberty; may be considered a third gender."},{"@language":"es","@value":"En la República Dominicana, este término se refiere a las personas que tienen genitales indiferenciados y que generalmente son criadas como mujeres hasta la pubertad; puede considerarse un tercer género."},{"@language":"de","@value":"In der Dominikanischen Republik bezieht sich dieser Begriff auf Menschen mit uneindeutigen Genitalien, die in der Regel bis zur Pubertät als weiblich erzogen werden; sie können als drittes Geschlecht betrachtet werden."},{"@language":"nl","@value":"In de Dominicaanse Republiek, mensen met ongedifferentieerde genitaliën, die over het algemeen als vrouw worden opgevoed tot de puberteit; kan worden beschouwd als een derde geslacht"},{"@language":"sv","@value":"I Dominikanska republiken avser denna term personer med icke entydiga könsorgan som vanligtvis uppfostras som flickor fram till puberteten. Kan betraktas som ett tredje kön."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000322"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/guevedoche"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000616","dc:identifier":"homoit0000616","skos:prefLabel":[{"@language":"chy","@value":"Hemaneh"},{"@language":"es","@value":"Hemaneh"},{"@language":"de","@value":"Hemaneh"},{"@language":"nl","@value":"Hemaneh"},{"@language":"sv","@value":"Hemaneh"}],"skos:altLabel":{"@language":"de","@value":"He'emaneh"},"rdfs:comment":[{"@language":"en","@value":"Cheyenne term for a half-man, half-woman persona."},{"@language":"es","@value":"Término cheyenne para una persona mitad hombre, mitad mujer."},{"@language":"de","@value":"Ein Begriff aus der Sprache der Cheyenne, einer indigenen Gruppe in Nordamerika, für eine Person, die halb Mann, halb Frau ist."},{"@language":"nl","@value":"Ojibwe term voor half-man, half-vrouw persona"},{"@language":"sv","@value":"Cheyenne-term för en person som är både man och kvinna, eller en gestalt som förenar manliga och kvinnliga drag."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000322"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/hemaneh"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000678","dc:identifier":"homoit0000678","skos:prefLabel":[{"@language":"pa","@value":"Jankha"},{"@language":"es","@value":"Jankha"},{"@language":"nl","@value":"Jankha"},{"@language":"sv","@value":"Jankha"}],"rdfs:comment":[{"@language":"en","@value":"In India, this term is used to describe people assigned male at birth who take on female dress and characteristics but who do not elect to receive castration."},{"@language":"es","@value":"En la India, este término se utiliza para describir a las personas asignadas al sexo masculino al nacer que adoptan vestimenta y características femeninas pero que no eligen la castración."},{"@language":"nl","@value":"Term voor mensen die bij de geboorte in India als man zijn toegewezen en die vrouwelijke kleding en kenmerken aannemen, maar er niet voor kiezen om gecastreerd te worden"},{"@language":"sv","@value":"I Indien används termen för att beskriva personer som tilldelats manligt kön vid födseln men som bär kvinnokodade kläder och uttryck, men som inte väljer kastrering."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000322"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/jankha"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000684","dc:identifier":"homoit0000684","skos:prefLabel":[{"@language":"kn","@value":"Jogappa"},{"@language":"es","@value":"Jogappa"},{"@language":"nl","@value":"Jogappa"},{"@language":"sv","@value":"Jogappa"}],"rdfs:comment":[{"@language":"en","@value":"In India, this term is used to describe people assigned male at birth who become genderfluid in a spiritual conversion."},{"@language":"es","@value":"En India, este término se utiliza para describir a las personas asignadas al sexo masculino al nacer y que asumen un género fluido a través de una conversión espiritual."},{"@language":"nl","@value":"In India, mensen bij hun geboorte als man toegewezen die genderfluïde werden in een spirituele conversie"},{"@language":"sv","@value":"I Indien används denna term för att beskriva personer som tilldelats manligt kön vid födseln och som genom en andlig omvandling utvecklar en flytande könsidentitet."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000322"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000632"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/jogappa"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000687","dc:identifier":"homoit0000687","skos:prefLabel":[{"@language":"tha","@value":"Katoey"},{"@language":"es","@value":"Katoey"},{"@language":"nl","@value":"Katoey"},{"@language":"sv","@value":"Katoey"}],"skos:altLabel":[{"@language":"en","@value":"Ladyboy"},{"@language":"tha","@value":"Kathoey"},{"@language":"es","@value":"Kathoey"},{"@language":"es","@value":"Ladyboy"}],"rdfs:comment":[{"@language":"en","@value":"In Thailand, this term refers to a range of people of non-normative gender expressions, including intersex people, transgender women, and effeminate gay men. Some regard this term as outdated and offensive, while others self-identify with it. Only use to describe people who self-identify as katoey."},{"@language":"es","@value":"En Tailandia, este término se refiere a un espectro de personas con expresiones de género no normativas, incluyendo a personas intersex, mujeres transgénero y hombres gay afeminados. Algunas personas consideran este término como anticuado y ofensivo, mientras que otras se autoidentifican con él. Utilícese únicamente para describir a las personas que se autoidentifiquen como katoey."},{"@language":"nl","@value":"In Thailand verwijst deze term naar een reeks personen met niet-normatieve genderexpressies, waaronder intersekse personen, transgendervrouwen en feminine homomannen. Sommigen beschouwen deze term als verouderd en beledigend, terwijl anderen zichzelf ermee identificeren. Alleen gebruiken om personen te beschrijven die zichzelf identificeren als katoey."},{"@language":"sv","@value":"I Thailand används termen för att beskriva ett spektrum av personer med icke-normativa könsuttryck, inklusive intersexpersoner, transkvinnor och feminina bögar. Vissa anser termen vara föråldrad och kränkande, medan andra identifierar sig med den. Används endast för personer som själva identifierar sig som katoey."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000322"},{"@id":"https://homosaurus.org/v5/homoit0001297"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000340"},{"@id":"https://homosaurus.org/v5/homoit0001373"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/katoey"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000688","dc:identifier":"homoit0000688","skos:prefLabel":[{"@language":"pa","@value":"Khusra"},{"@language":"es","@value":"Khusra"},{"@language":"nl","@value":"Khusra"},{"@language":"sv","@value":"Khusra"}],"rdfs:comment":[{"@language":"en","@value":"A term used in Pakistan and Northern India to describe third-gender people, typically people assigned male at birth who identify as female."},{"@language":"es","@value":"Término utilizado en Pakistán y el norte de la India para describir a personas del tercer género, normalmente personas asignadas al sexo masculino al nacer y que se autoidentifican como mujeres."},{"@language":"nl","@value":"Een term die in Pakistan en Noord-India wordt gebruikt voor mensen van het derde geslacht; beschrijft gewoonlijk mensen die bij de geboorte als man zijn toegewezen en die zich als vrouw identificeren"},{"@language":"sv","@value":"Term som används i Pakistan och norra Indien för att beskriva personer av tredje kön, vanligen personer som tilldelats manligt kön vid födseln och som identifierar sig som kvinnor."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000322"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000632"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/khusra"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000689","dc:identifier":"homoit0000689","skos:prefLabel":[{"@language":"ur","@value":"Khwaja sira"},{"@language":"es","@value":"Khawaja sara"},{"@language":"nl","@value":"Khwaja sira"},{"@language":"sv","@value":"Khawaja sara"}],"skos:altLabel":[{"@language":"en","@value":"Khawaja sara"},{"@language":"en","@value":"Khwaja sara"},{"@language":"en","@value":"Khawaja sira"},{"@language":"nl","@value":"Khawaja sira"},{"@language":"nl","@value":"Khwaja sara"}],"rdfs:comment":[{"@language":"en","@value":"An umbrella term used in Pakistan and South Asia to describe people assigned male at birth who identify as women, intersex, or third gender."},{"@language":"es","@value":"Término del urdu utilizado en el sudeste de Asia para describir a personas transgénero."},{"@language":"nl","@value":"Een verzamelnaam die in Pakistan en Zuid-Azië wordt gebruikt voor personen die bij de geboorte werden toegewezen als man en die zich identificeren als vrouw, intersekse of als derde geslacht."},{"@language":"sv","@value":"Paraplybegrepp i Pakistan och Sydasien som beskriver personer som tilldelats manligt kön vid födseln och som identifierar sig som kvinnor, intersex eller tredje kön."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000322"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/khawajaSara"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000690","dc:identifier":"homoit0000690","skos:prefLabel":[{"@language":"hil","@value":"Kinnar"},{"@language":"es","@value":"Kinnar"},{"@language":"nl","@value":"Kinnar"},{"@language":"sv","@value":"Kinnar"}],"rdfs:comment":[{"@language":"en","@value":"A variant term for hijra used in northern India."},{"@language":"es","@value":"Variante del término \"hijra\" utilizado en el norte de India."},{"@language":"nl","@value":"Een variante term voor hijra die wordt gebruikt in Noord-India"},{"@language":"sv","@value":"En variant av termen hijra som används i norra Indien."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000322"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000632"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/kinnar"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000693","dc:identifier":"homoit0000693","skos:prefLabel":[{"@language":"tr","@value":"Köçek"},{"@language":"es","@value":"Köçek"},{"@language":"nl","@value":"Köçek"},{"@language":"sv","@value":"Köçek"}],"rdfs:comment":[{"@language":"en","@value":"Turkish term for male dancers who crossdress in feminine attire for entertainment purposes."},{"@language":"es","@value":"Término turco para los bailarines que se visten con atuendos femeninos con fines de entretenimiento."},{"@language":"nl","@value":"Turkse term voor mannelijke dansers die zich in vrouwelijke kleding kleden voor amusementsdoeleinden"},{"@language":"sv","@value":"Turkisk term för manliga dansare som klär sig i kvinnliga kläder i underhållningssyfte."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000322"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/köçek"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000694","dc:identifier":"homoit0000694","skos:prefLabel":[{"@language":"hil","@value":"Kothis"},{"@language":"es","@value":"Kothis"},{"@language":"nl","@value":"Kothi's"},{"@language":"sv","@value":"Kothis"}],"rdfs:comment":[{"@language":"en","@value":"In South Asia, this term is used to describe people who are assigned male at birth who exhibit feminine characteristics. Please note that not all kothis identify as hijra or transgender."},{"@language":"es","@value":"En el sur de Asia, este término se utiliza para describir a las personas asignadas al sexo masculino al nacer que presentan características femeninas. No todas las kothis se autoidentifican como hijra o transgénero."},{"@language":"nl","@value":"In Zuid-Azië, mensen die bij de geboorte als man zijn toegewezen, en vrouwelijke kenmerken vertonen; niet alle kothi's identificeren zich als hijra of transgender"},{"@language":"sv","@value":"I Sydasien används termen för att beskriva personer som tilldelats manligt kön vid födseln men som uppvisar feminina egenskaper. Inte alla som identifierar sig som kothi ser sig som hijra eller transpersoner."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000322"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000632"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/kothi"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000695","dc:identifier":"homoit0000695","skos:prefLabel":[{"@language":"km","@value":"Khteuy"},{"@language":"es","@value":"Khteuy"},{"@language":"nl","@value":"Khteuy"},{"@language":"sv","@value":"Khteuy"}],"skos:altLabel":[{"@language":"km","@value":"Kteuy"},{"@language":"es","@value":"Kteuy"}],"rdfs:comment":[{"@language":"en","@value":"Khmer term for third sex people. Can be considered outdated and offensive."},{"@language":"es","@value":"Término del khmer para personas del tercer sexo. Puede ser considerado anticuado y ofensivo."},{"@language":"nl","@value":"Cambodjaanse term voor derde geslacht; kan als verouderd en beledigend worden beschouwd"},{"@language":"sv","@value":"Khmerterm för personer av tredje kön. Kan uppfattas som föråldrad och kränkande."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000322"},{"@id":"https://homosaurus.org/v5/homoit0001560"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001253"},{"@id":"https://homosaurus.org/v5/homoit0001338"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/kteuy"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000697","dc:identifier":"homoit0000697","skos:prefLabel":[{"@language":"ceb","@value":"Lakin-on"},{"@language":"es","@value":"Lakin-on"},{"@language":"de","@value":"Lakin-on"},{"@language":"nl","@value":"Lakin-on"},{"@language":"sv","@value":"Lakin-on"}],"rdfs:comment":[{"@language":"en","@value":"Cebuano term for women who are attracted to women and take on male personas and cultural work."},{"@language":"es","@value":"Término cebuano para mujeres que se sienten atraídas por mujeres, y asumen el personaje y el trabajo cultural masculinos."},{"@language":"de","@value":"Ein Begriff aus dem Cebuano (austronesische Sprache auf den Philippinen) für Frauen, die sich zu Frauen hingezogen fühlen und männliche Rollen sowie kulturelle Aufgaben übernehmen."},{"@language":"nl","@value":"Filipijnse term voor vrouwen die zich aangetrokken voelen tot vrouwen en die mannelijke persona's en cultureel werk aannemen"},{"@language":"sv","@value":"Cebuanoterm för kvinnor som attraheras av kvinnor och som antar manliga roller och uttryck, även i kulturellt arbete."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000322"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lakinOn"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000898","dc:identifier":"homoit0000898","skos:prefLabel":[{"@language":"mi","@value":"Takatāpui"},{"@language":"es","@value":"Takatāpui"},{"@language":"nl","@value":"Takatāpui"},{"@language":"sv","@value":"Takatāpui"}],"skos:altLabel":[{"@language":"en","@value":"LGBTQ+ Māori people"},{"@language":"en","@value":"Māori (LGBTQ)"},{"@language":"en","@value":"Māori LGBTQ+ people"},{"@language":"es","@value":"Personas LGBTQ+ Maori"},{"@language":"es","@value":"Personas LGBTQ+ Māori"},{"@language":"es","@value":"Māori (LGBTQ)"},{"@language":"nl","@value":"Māori's LHBTQ+"}],"rdfs:comment":[{"@language":"en","@value":"Term used by the Māori people, or people who are part of the Indigenous Polynesian people of mainland Aotearoa (New Zealand), that was historically used to describe an \"intimate companion of the same sex.\" In the 1980s, the term was reclaimed for use by lesbian, gay, bisexual, transgender, queer, intersex people, and other members of Rainbow communities. Only use to refer to individuals who identify as Takatāpui."},{"@language":"es","@value":"Término utilizado por el pueblo maorí, o personas que forman parte del pueblo indígena polinesio de la parte continental de Aotearoa (Nueva Zelanda), que históricamente se utilizó para describir a un \"compañero íntimo del mismo sexo\". En la década de 1980, el término fue reclamado para ser utilizado por personas lesbianas, gay, bisexuales, transgénero, queer, intersex y otros miembros de las comunidades arcoíris. Utilícese únicamente para referirse a personas que se identifiquen como takatāpui."},{"@language":"nl","@value":"Term die wordt gebruikt door de Māori-bevolking, of mensen die deel uitmaken van de inheemse Polynesische bevolking van het vasteland van Aotearoa (Nieuw-Zeeland), en die historisch werd gebruikt om een 'intieme metgezel van hetzelfde geslacht' te beschrijven. In de jaren tachtig werd de term teruggewonnen voor gebruik door lesbische vrouwen, homomannen, biseksuele personen, transgender personen, queer personen, intersekse personen en andere leden van Regenboog-gemeenschappen. Alleen gebruiken om te verwijzen naar personen die zich identificeren als Takatāpui"},{"@language":"sv","@value":"Term som används av māorifolket, ett av urfolken i Aotearoa (Nya Zeeland), och som historiskt syftade på en ”intim partner av samma kön”. På 1980-talet återtogs termen av lesbiska, homosexuella, bisexuella, transpersoner, intersexpersoner, queera och andra medlemmar av regnbågsgemenskaper. Används endast om personer som själva identifierar sig som takatāpui."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000322"},{"@id":"https://homosaurus.org/v5/homoit0000886"},{"@id":"https://homosaurus.org/v5/homoit0001297"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001810"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/takatapui"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000966","dc:identifier":"homoit0000966","skos:prefLabel":[{"@language":"zun","@value":"Lhamana"},{"@language":"es","@value":"Lhamana"},{"@language":"nl","@value":"Lhamana"},{"@language":"sv","@value":"Lhamana"}],"rdfs:comment":[{"@language":"en","@value":"Native American Zuni people assigned male at birth who exhibit mixed gender traits."},{"@language":"es","@value":"Personas del pueblo nativo americano Zuni asignadas al sexo masculino al nacer que exhiben rasgos de género mixto."},{"@language":"nl","@value":"Inheemse Amerikaanse Zuni-mensen die bij de geboorte als man zijn toegewezen en die gemengde geslachtskenmerken vertonen"},{"@language":"sv","@value":"Personer tillhörande Zuni, urfolk i Nordamerika, som tilldelats manligt kön vid födseln och som uppvisar blandade könsuttryck."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000322"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001480"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lhamana"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000979","dc:identifier":"homoit0000979","skos:prefLabel":[{"@language":"haw","@value":"Māhū"},{"@language":"es","@value":"Māhū"},{"@language":"nl","@value":"Māhū"},{"@language":"sv","@value":"Māhū"}],"skos:altLabel":[{"@language":"haw","@value":"Mahu"},{"@language":"es","@value":"Mahu"}],"rdfs:comment":[{"@language":"en","@value":"Term used in Hawaiian and Tahitian cultures for third gender people who blend genders and often hold spiritual roles."},{"@language":"es","@value":"Término utilizado en las culturas hawaianas y tahitianas para las personas del tercer género que mezclan géneros y que, a menudo, desempeñan roles espirituales."},{"@language":"nl","@value":"Term die in de Hawaïaanse en Tahitiaanse culturen wordt gebruikt voor mensen van het derde geslacht die genders met elkaar vermengen en vaak een spirituele rol vervullen"},{"@language":"sv","@value":"Term som används inom hawaiiansk och tahitisk kultur för personer av tredje kön som förenar könsuttryck och ofta har andliga roller."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000322"},{"@id":"https://homosaurus.org/v5/homoit0002653"}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0002654"},{"@id":"https://homosaurus.org/v5/homoit0002655"},{"@id":"https://homosaurus.org/v5/homoit0003231"},{"@id":"https://homosaurus.org/v5/homoit0003256"},{"@id":"https://homosaurus.org/v5/homoit0003762"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001955"},{"@id":"https://homosaurus.org/v5/homoit0001959"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/mahu"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000980","dc:identifier":"homoit0000980","skos:prefLabel":[{"@language":"ms","@value":"Mak nyahs"},{"@language":"es","@value":"Mak nyahs"},{"@language":"nl","@value":"Mak nyahs"},{"@language":"sv","@value":"Mak nyahs"}],"rdfs:comment":[{"@language":"en","@value":"Term used in Malaysia for transgender women."},{"@language":"es","@value":"Término utilizado en Malasia para mujeres transgénero."},{"@language":"nl","@value":"Term die in Maleisië wordt gebruikt voor transgendervrouwen"},{"@language":"sv","@value":"Term för transkvinnor som används i Malaysia."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000322"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/makNyah"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000987","dc:identifier":"homoit0000987","skos:prefLabel":[{"@language":"zmw","@value":"Mangaiko"},{"@language":"es","@value":"Mangaiko"},{"@language":"nl","@value":"Mangaiko"},{"@language":"sv","@value":"Mangaiko"}],"rdfs:comment":[{"@language":"en","@value":"Mbo term for third gender people."},{"@language":"es","@value":"Término mbo para personas del tercer género."},{"@language":"nl","@value":"Democratische Republiek Congo: Term voor derde geslacht"},{"@language":"sv","@value":"Mbo-term för personer av tredje kön."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000322"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/mangaiko"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000996","dc:identifier":"homoit0000996","skos:prefLabel":[{"@language":"sw","@value":"Mashoga"},{"@language":"es","@value":"Mashoga"},{"@language":"nl","@value":"Mashoga"},{"@language":"sv","@value":"Mashoga"}],"rdfs:comment":[{"@language":"en","@value":"Swahili term for people assigned male at birth who engage in sex with men and who may dress as women."},{"@language":"es","@value":"Término swahili para personas asignadas al sexo masculino al nacer que tienen relaciones sexuales con hombres y que pueden vestirse como mujeres."},{"@language":"nl","@value":"Swahili-term voor mensen die bij de geboorte als man zijn toegewezen en die seks hebben met mannen en zich als vrouw kunnen kleden"},{"@language":"sv","@value":"Swahili-term för personer som tilldelats manligt kön vid födseln, som har sex med män och som kan klä sig i kvinnokodade kläder."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000322"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/mashoga"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001013","dc:identifier":"homoit0001013","skos:prefLabel":[{"@language":"ne","@value":"Metis"},{"@language":"es","@value":"Metis"},{"@language":"nl","@value":"Metis"},{"@language":"sv","@value":"Metis"}],"rdfs:comment":[{"@language":"en","@value":"Officially recognized third gender in Nepal; predominantly used to refer to transgender women."},{"@language":"es","@value":"Tercer género oficialmente reconocido en Nepal; se utiliza predominantemente para referirse a mujeres transgénero."},{"@language":"nl","@value":"Officieel erkend derde geslacht in Nepal; voornamelijk gebruikt om te verwijzen naar transgender vrouwen"},{"@language":"sv","@value":"Officiellt erkänd tredje könskategori i Nepal, som huvudsakligen används för att beskriva transkvinnor."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000322"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/metis"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001029","dc:identifier":"homoit0001029","skos:prefLabel":[{"@language":"ar","@value":"Mukhannathun"},{"@language":"es","@value":"Mukhannathun"},{"@language":"nl","@value":"Mukhannathun"},{"@language":"sv","@value":"Mukhannathun"}],"skos:altLabel":[{"@language":"ar","@value":"Mukhannaths"},{"@language":"es","@value":"Mukhannaths"}],"rdfs:comment":[{"@language":"en","@value":"A term used in classical Arabic to refer to men who are perceived as effeminate."},{"@language":"es","@value":"Término utilizado en el árabe clásico para referirse a hombres percibidos como afeminados."},{"@language":"nl","@value":"Een term die in het klassiek Arabisch wordt gebruikt om te verwijzen naar mannen die als feminien worden beschouwd"},{"@language":"sv","@value":"Term som användes i klassisk arabiska för att beskriva män som uppfattas som feminina."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000322"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/mukhannathun"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001034","dc:identifier":"homoit0001034","skos:prefLabel":[{"@language":"zap","@value":"Muxe"},{"@language":"es","@value":"Muxe"},{"@language":"nl","@value":"Muxe"},{"@language":"sv","@value":"Muxe"}],"rdfs:comment":[{"@language":"en","@value":"In Zapotec cultures of Oaxaca (southern Mexico), this term refers to people assigned male at birth who dress and behave in feminine ways; sometimes considered a third gender."},{"@language":"es","@value":"En las culturas zapotecas de Oaxaca (sur de México), este término se refiere a personas asignadas al sexo masculino al nacer que se visten y comportan de manera femenina; a veces es considerado un tercer género."},{"@language":"nl","@value":"In Zapoteekse culturen van Oaxaca (Zuid-Mexico) verwijst deze term naar mensen die bij de geboorte als man zijn toegewezen en zich vrouwelijk kleden en gedragen; soms beschouwd als een derde geslacht"},{"@language":"sv","@value":"I zapotekisk kultur i Oaxaca (södra Mexiko) avser termen personer som tilldelats manligt kön vid födseln och som klär sig och uppträder på feminint sätt. Betraktas ibland som ett tredje kön."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000322"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/muxe"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001035","dc:identifier":"homoit0001035","skos:prefLabel":[{"@language":"nv","@value":"Nádleehi"},{"@language":"es","@value":"Nádleehi"},{"@language":"nl","@value":"Nádleehi"},{"@language":"sv","@value":"Nádleehi"}],"rdfs:comment":[{"@language":"en","@value":"Term used in Native American Navajo tribes to describe people assigned male at birth who take on the role of girls in childhood and women in adulthood."},{"@language":"es","@value":"Término utilizado en las tribus nativo americanas navajos para describir a las personas asignadas al sexo masculino al nacer que asumen el papel de niñas en la niñez y de mujeres en la adultez."},{"@language":"nl","@value":"Gebruikt in Indiaanse Navajo-stammen voor een persoon die bij de geboorte als man is toegewezen en die de rol op zich neemt van een meisje in de kindertijd en een vrouw op volwassen leeftijd"},{"@language":"sv","@value":"Term som används inom Navajo-kulturen i Nordamerika för att beskriva personer som tilldelats manligt kön vid födseln och som tar på sig rollen som flickor i barndomen och kvinnor i vuxen ålder."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000322"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000353"},{"@id":"https://homosaurus.org/v5/homoit0001480"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/nadleehi"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001043","dc:identifier":"homoit0001043","skos:prefLabel":[{"@language":"oj","@value":"Niizh manidoowag"},{"@language":"es","@value":"Niizh manidoowag"},{"@language":"nl","@value":"Niizh manidoowag"},{"@language":"sv","@value":"Niizh manidoowag"}],"rdfs:comment":[{"@language":"en","@value":"Native American Ojibwa term for Two-Spirit people."},{"@language":"es","@value":"Término nativoamericano ojibwa para referirse a las personas dos espíritus."},{"@language":"sv","@value":"Nordamerikanska ursprungsbefolkningen ojibwas term för Two-spirit-personer."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000322"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001480"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/niizhManidoowag"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001044","dc:identifier":"homoit0001044","skos:prefLabel":[{"@language":"bla","@value":"Ninauposkitzipxpe"},{"@language":"es","@value":"Ninauposkitzipxpe"},{"@language":"nl","@value":"Ninauposkitzipxpe"},{"@language":"sv","@value":"Ninauposkitzipxpe"}],"rdfs:comment":[{"@language":"en","@value":"Used in Native American Blackfoot tribes for people assigned female at birth who are not constrained to the social roles of women; translates to \"manly-hearted woman.\""},{"@language":"es","@value":"Se utiliza en las tribus nativo americanas blackfoot para personas asignadas al sexo femenino al nacer que no están limitadas a los roles sociales de las mujeres; se traduce a \"mujer de corazón varonil\"."},{"@language":"nl","@value":"Gebruikt in Native American Blackfoot-stammen voor mensen die bij de geboorte als vrouw zijn toegewezen en niet beperkt zijn tot de sociale rol van een vrouw; vertaalt naar \"mannelijke vrouw\""},{"@language":"sv","@value":"Term som används inom Blackfoot-folket i Nordamerika för personer som tilldelats kvinnligt kön vid födseln men som inte följer samhällets förväntade kvinnoroller. Översätts som ”kvinna med manligt hjärta”."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000322"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001480"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/ninauposkitzipxpe"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001070","dc:identifier":"homoit0001070","skos:prefLabel":[{"@language":"chy","@value":"Palao'ana"},{"@language":"es","@value":"Palao'ana"},{"@language":"nl","@value":"Palao'ana"},{"@language":"sv","@value":"Palao'ana"}],"rdfs:comment":[{"@language":"en","@value":"Chamorro (Mariana Islands) term for third gender people."},{"@language":"es","@value":"Término chamorro (Islas Marianas) para personas del tercer género."},{"@language":"nl","@value":"Chamarro (Marianen-eilanden) term voor derde geslacht"},{"@language":"sv","@value":"Chamorro-term (från ögruppen Marianerna i Mikronesien) för personer med tredje kön."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000322"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/palaoana"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001072","dc:identifier":"homoit0001072","skos:prefLabel":[{"@language":"en","@value":"Pangender people"},{"@language":"es","@value":"Personas pangénero"},{"@language":"fr","@value":"Personnes pangenres"},{"@language":"nl","@value":"Pangender personen"},{"@language":"sv","@value":"Pangenderpersoner"}],"rdfs:comment":[{"@language":"en","@value":"People who identify as multiple or all genders."},{"@language":"es","@value":"Personas que se identifican como de múltiples o todos los géneros."},{"@language":"nl","@value":"Mensen die zich identificeren als meerdere of alle genders"},{"@language":"sv","@value":"Personer som identifierar sig med flera eller alla kön."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000322"},{"@id":"https://homosaurus.org/v5/homoit0001378"},{"@id":"https://homosaurus.org/v5/homoit0001817"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001071"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/pangenderPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001147","dc:identifier":"homoit0001147","skos:prefLabel":[{"@language":"qu","@value":"Quariwarmi"},{"@language":"es","@value":"Qariwarmi"},{"@language":"nl","@value":"Quariwarmi"},{"@language":"sv","@value":"Quariwarmi"}],"rdfs:comment":[{"@language":"en","@value":"North American Inca term for people assigned male at birth who fulfill a third gender role that is often spiritual in nature."},{"@language":"es","@value":"Término quechua andino para personas asignadas al sexo masculino al nacer que cumplen un rol de tercer género que a menudo es de naturaleza espiritual."},{"@language":"nl","@value":"Inca-term voor mensen die bij de geboorte als man zijn toegewezen en die een derde geslachtsrol vervullen die vaak spiritueel van aard is"},{"@language":"sv","@value":"Inka-term som används för personer som tilldelats manligt kön vid födseln och som har en tredje könsroll, ofta med andlig betydelse."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000322"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001480"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/quariwarmi"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001253","dc:identifier":"homoit0001253","skos:prefLabel":[{"@language":"km","@value":"Sak veng"},{"@language":"es","@value":"Sak veng"},{"@language":"nl","@value":"Sak veng"},{"@language":"sv","@value":"Sak veng"}],"rdfs:comment":[{"@language":"en","@value":"Term used in Cambodia for people assigned male at birth who identify as women; translates to \"long hairs.\""},{"@language":"es","@value":"Término utilizado en Camboya para las personas asignadas al sexo masculino al nacer y que se autoidentifican como mujeres; se traduce como \"cabellos largos\"."},{"@language":"nl","@value":"Term die in Cambodja wordt gebruikt voor mensen die bij de geboorte als man zijn toegewezen en die zich als vrouw identificeren; letterlijk vertaald: \"lange haren\""},{"@language":"sv","@value":"Term som används i Kambodja för personer som tilldelats manligt kön vid födseln och identifierar sig som kvinnor. Kan översättas som ”långhåriga”."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000322"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000695"},{"@id":"https://homosaurus.org/v5/homoit0001338"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sakVeng"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001263","dc:identifier":"homoit0001263","skos:prefLabel":[{"@language":"egy","@value":"Sekhet"},{"@language":"es","@value":"Sekhet"},{"@language":"nl","@value":"Sekhet"},{"@language":"sv","@value":"Sekhet"}],"skos:altLabel":[{"@language":"egy","@value":"Sht"},{"@language":"es","@value":"Sht"}],"rdfs:comment":[{"@language":"en","@value":"Egyptian term that refers to a range of people of non-normative gender and sexual identities, including gay people, eunuchs, trans people, etc. Only use to describe people who self-identify as sekhet. "},{"@language":"es","@value":"Término egipcio que se refiere a una variedad de personas con identidades sexuales y de género no normativas, incluidos hombres gay, eunucos, personas trans, etc. Utilícese únicamente para describir a personas que se autoidentifiquen como sekhet."},{"@language":"nl","@value":"Egyptische term die verwijst naar een reeks personen met niet-normatieve gender- en seksuele identiteiten, waaronder homomannen, eunuchen, transgender personen, enz. Wordt alleen gebruikt om mensen te beschrijven die zichzelf identificeren als sekhet."},{"@language":"sv","@value":"Egyptisk term som avser ett spektrum av personer med icke-normativa könsidentiteter och sexuella identiteter, inklusive homosexuella, eunucker, transpersoner med flera. Använd endast för personer som själva identifierar sig som sekhet."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000322"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sekhet"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001264","dc:identifier":"homoit0001264","skos:prefLabel":[{"@language":"mg","@value":"Sekrata"},{"@language":"es","@value":"Sekrata"},{"@language":"nl","@value":"Sekrata"},{"@language":"sv","@value":"Sekrata"}],"rdfs:comment":[{"@language":"en","@value":"In Madagascar, this term refers to people of a third gender who were assigned male at birth and present feminine characteristics."},{"@language":"es","@value":"En Madagascar, este término se refiere a las personas de un tercer género a las que se les asignó al sexo masculino al nacer y presentan características femeninas."},{"@language":"nl","@value":"In Madagaskar verwijst deze term naar personen van een derde geslacht die bij de geboorte als man zijn toegewezen en feminine kenmerken vertonen."},{"@language":"sv","@value":"I Madagaskar avser denna term personer av ett tredje kön som tilldelats manligt kön vid födseln och uppvisar feminina egenskaper."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000322"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sekrata"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001309","dc:identifier":"homoit0001309","skos:prefLabel":[{"@language":"hil","@value":"Shiv-Shakthis"},{"@language":"es","@value":"Shiv-Shakthis"},{"@language":"nl","@value":"Shiv-Shakthis"},{"@language":"sv","@value":"Shiv-Shakthis"}],"rdfs:comment":[{"@language":"en","@value":"Term used in the Andhra Pradesh region of India to describe transgender people who are considered to be married to the gods (particularly Shiva). They often serve as astrologers and spiritual healers and their community is guarded by gurus who induct disciples and train them."},{"@language":"es","@value":"Término utilizado en la región de Andhra Pradesh en India para describir a las personas transgénero que se consideran estar casadas con los dioses (particularmente Shiva). A menudo sirven como astrólogos y sanadores espirituales y su comunidad está custodiada por gurús que inician a sus discípulos y los entrenan."},{"@language":"nl","@value":"Term die in de regio Andhra Pradesh in India wordt gebruikt om transgender personen te beschrijven die worden beschouwd als getrouwd met de goden (in het bijzonder Shiva). Ze dienen vaak als astrologen en spirituele genezers en hun gemeenschap wordt bewaakt door goeroes die discipelen inwijden en trainen."},{"@language":"sv","@value":"Term som används i Andhra Pradesh i Indien för att beskriva transpersoner som anses vara gifta med gudarna, särskilt Shiva. De fungerar ofta som astrologer och andliga helare och deras gemenskap leds av guruer som initierar lärjungar och utbildar dem."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000322"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/shivShakthis"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001316","dc:identifier":"homoit0001316","skos:prefLabel":[{"@language":"ru","@value":"Skoptsy"},{"@language":"es","@value":"Skoptsy"},{"@language":"nl","@value":"Skoptsy"},{"@language":"sv","@value":"Skoptser"}],"skos:altLabel":[{"@language":"es","@value":"Eunucos"},{"@language":"es","@value":"Castrados"},{"@language":"es","@value":"Blancas Palomas"}],"rdfs:comment":[{"@language":"en","@value":"A sect within the larger Spiritual Christianity movement in the Russian Empire that emerged in the 18th century. This sect is most commonly known for conducting castrations and mastectomies in order to suppress sexual desire."},{"@language":"es","@value":"Una secta dentro del movimiento más amplio del cristianismo espiritual en el Imperio ruso que surgió en el siglo XVIII. Esta secta es más conocida por realizar castraciones y mastectomías para suprimir el deseo sexual."},{"@language":"nl","@value":"Een sekte binnen de grotere spirituele christendombeweging in het Russische rijk die ontstond in de 18e eeuw en die vooral bekend staat om het uitvoeren van castraties en borstamputaties om seksueel verlangen te onderdrukken"},{"@language":"sv","@value":"En sekt inom den bredare rörelsen för andlig kristendom i det ryska imperiet som uppstod på 1700-talet. Sekten är mest känd för att praktisera kastrering och mastektomi för att undertrycka sexuell lust."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000322"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85123228"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/skoptsy"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001338","dc:identifier":"homoit0001338","skos:prefLabel":[{"@language":"km","@value":"Srey sros"},{"@language":"es","@value":"Srey sros"},{"@language":"nl","@value":"Srey sros"},{"@language":"sv","@value":"Srey sros"}],"rdfs:comment":[{"@language":"en","@value":"Term used in Cambodia for people assigned male at birth who identify as women; translates to \"charming girls.\""},{"@language":"es","@value":"Término utilizado en Camboya para las personas asignadas al sexo masculino al nacer y que se autoidentifican como mujeres; se traduce como \"chicas encantadoras\"."},{"@language":"nl","@value":"Term die in Cambodja wordt gebruikt voor mensen die bij de geboorte als man zijn toegewezen en die zich als vrouw identificeren; letterlijk vertaald: \"charmante meisjes\""},{"@language":"sv","@value":"Term som används i Kambodja för personer som tilldelats manligt kön vid födseln och identifierar sig som kvinnor. Översätts till ”förtjusande flickor”."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000322"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000695"},{"@id":"https://homosaurus.org/v5/homoit0001253"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sreySros"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001368","dc:identifier":"homoit0001368","skos:prefLabel":[{"@language":"en","@value":"Third gender"},{"@language":"es","@value":"Tercer género"},{"@language":"fr","@value":"Troisième genre"},{"@language":"nl","@value":"Derde geslacht"},{"@language":"sv","@value":"Tredje kön"}],"rdfs:comment":[{"@language":"en","@value":"Social category present in societies that recognize three or more genders."},{"@language":"es","@value":"Categoría social presente en sociedades que reconocen tres o más géneros."},{"@language":"fr","@value":"Catégorie sociale présente dans les sociétés qui reconnaissent trois genres ou plus."},{"@language":"nl","@value":"Sociale categorie aanwezig in samenlevingen die drie of meer geslachten erkennen"},{"@language":"sv","@value":"Social kategori som förekommer i samhällen där tre eller fler kön erkänns."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000322"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001369"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/thirdGender"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001371","dc:identifier":"homoit0001371","skos:prefLabel":[{"@language":"ta","@value":"Thirunambi"},{"@language":"es","@value":"Thirunambi"},{"@language":"nl","@value":"Thirunambi"},{"@language":"sv","@value":"Thirunambi"}],"rdfs:comment":[{"@language":"en","@value":"Regional term in Tamil Nadu, India for people assigned female at birth who identify as men."},{"@language":"es","@value":"Término regional en Tamil Nadu, la India, para las personas asignadas al sexo femenino al nacer y que se autoidentifican como hombres."},{"@language":"nl","@value":"Regionale term in Tamil Nadu, India voor mensen die bij de geboorte als vrouw zijn toegewezen en zich identificeren als mannen"},{"@language":"sv","@value":"Regional term i Tamil Nadu, Indien för personer som tilldelats kvinnligt kön vid födseln och identifierar sig som män."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000322"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/thirunambi"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001372","dc:identifier":"homoit0001372","skos:prefLabel":[{"@language":"wba","@value":"Tida wena"},{"@language":"es","@value":"Tida wena"},{"@language":"nl","@value":"Tida wena"},{"@language":"sv","@value":"Tida wena"}],"rdfs:comment":[{"@language":"en","@value":"In Venezuela's indigenous Warao culture, this term refers to people assigned male at birth who are thought to possess two spirits and often assume a spiritual role; translates to \"twisted women.\""},{"@language":"es","@value":"En la cultura indígena warao de Venezuela, este término se refiere a las personas asignadas al sexo masculino al nacer y que se cree que poseen dos espíritus y que, a menudo, asumen un papel espiritual; se traduce como \"mujeres retorcidas\"."},{"@language":"nl","@value":"In de inheemse Warao-cultuur van Venezuela verwijst deze term naar mensen die bij de geboorte als man zijn toegewezen en waarvan wordt gedacht dat ze twee geesten bezitten en vaak een spirituele rol spelen; Letterlijk vertaald: \"verdraaide vrouwen\""},{"@language":"sv","@value":"Hos Venezuelas ursprungskultur Warao avser termen personer som tilldelats manligt kön vid födseln och som anses ha två andar och ofta har en andlig roll. Översätts till ”vridna kvinnor”."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000322"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001480"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/tidaWena"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001373","dc:identifier":"homoit0001373","skos:prefLabel":[{"@language":"tha","@value":"Tom"},{"@language":"es","@value":"Tom"},{"@language":"nl","@value":"Tom"},{"@language":"sv","@value":"Tom"}],"rdfs:comment":[{"@language":"en","@value":"In Thailand, this term is used to describe people assigned female at birth who exhibit masculine traits, often partnering with feminine dees; similar to a butch in U.S. lesbian culture."},{"@language":"es","@value":"En Tailandia, este término se utiliza para describir a las personas asignadas al sexo femenino al nacer y que exhiben rasgos masculinos, a menudo, emparejándose con dees femeninos; similar a una marimacha en la cultura lésbica estadounidense."},{"@language":"nl","@value":"In Thailand, mensen bij de geboorte als vrouw toegewezen en mannelijke eigenschappen vertonen, hebben vaak vrouwelijke dees als partner; vergelijkbaar met een butch in de Amerikaanse lesbische cultuur"},{"@language":"sv","@value":"I Thailand används termen för att beskriva personer som tilldelats kvinnligt kön vid födseln och som uppvisar maskulina drag, ofta i relation med feminina dees. Motsvarar ungefär butch inom amerikansk lesbisk kultur."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000322"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000340"},{"@id":"https://homosaurus.org/v5/homoit0000687"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/tom"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001471","dc:identifier":"homoit0001471","skos:prefLabel":[{"@language":"es","@value":"Travestis"},{"@language":"nl","@value":"Travestis"},{"@language":"sv","@value":"Travestis"}],"skos:altLabel":{"@language":"es","@value":"Travesti"},"rdfs:comment":[{"@language":"en","@value":"Spanish term for people assigned male at birth who have a feminine gender identity; commonly used in South America."},{"@language":"es","@value":"Término para personas asignadas al sexo masculino al nacer que tienen una identidad de género femenina; comúnmente utilizado en Sudamérica."},{"@language":"nl","@value":"Spaanse term voor mensen die bij de geboorte als man zijn toegewezen en die een vrouwelijke genderidentiteit hebben; veel gebruikt in Zuid-Amerika"},{"@language":"sv","@value":"Spansk term för personer som tilldelats manligt kön vid födseln och har en feminin könsidentitet. Används i Sydamerika."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000322"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/travesti"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001474","dc:identifier":"homoit0001474","skos:prefLabel":[{"@language":"en","@value":"Trigender people"},{"@language":"es","@value":"Personas trigénero"},{"@language":"fr","@value":"Trigenre"},{"@language":"nl","@value":"Trigender personen"},{"@language":"sv","@value":"Trigenderpersoner"}],"rdfs:comment":[{"@language":"en","@value":"People whose gender continually moves between or among three gender identities, typically male, female, and a third gender."},{"@language":"es","@value":"Personas cuyo género se mueve continuamente entre tres identidades de género, típicamente masculina, femenina y un tercer género."},{"@language":"fr","@value":"Personnes dont le genre évolue continuellement entre ou parmi trois identités de genre, typiquement homme, femme et un troisième genre."},{"@language":"nl","@value":"Personen wiens gender voortdurend wisselt tussen drie genderidentiteiten: mannelijk, vrouwelijk en een derde geslacht"},{"@language":"sv","@value":"Personer vars kön kontinuerligt växlar mellan eller rör sig mellan tre könsidentiteter, vanligtvis man, kvinna och ett tredje kön."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000322"},{"@id":"https://homosaurus.org/v5/homoit0001378"},{"@id":"https://homosaurus.org/v5/homoit0001817"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001473"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/trigenderPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001475","dc:identifier":"homoit0001475","skos:prefLabel":[{"@language":"hil","@value":"Tritiya-Prakriti"},{"@language":"es","@value":"Tritiya-Prakriti"},{"@language":"nl","@value":"Tritiya-Prakriti"},{"@language":"sv","@value":"Tritiya-Prakriti"}],"rdfs:comment":[{"@language":"en","@value":"Ancient Hindu term for a third gender that is typically described as fluid and/or continuously transformative."},{"@language":"es","@value":"Término hindú antiguo para un tercer género que normalmente se describe como fluido y/o continuamente en transformación."},{"@language":"nl","@value":"Oude hindoe-term voor een derde geslacht dat doorgaans wordt beschreven als fluïde en/of continu transformerend"},{"@language":"sv","@value":"Mycket gammal hinduisk term för ett tredje kön som vanligen beskrivs som flytande och/eller ständigt föränderligt."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000322"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/tritiyaPrakriti"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001477","dc:identifier":"homoit0001477","skos:prefLabel":[{"@language":"he","@value":"Tumtum"},{"@language":"es","@value":"Tumtum"},{"@language":"nl","@value":"Tumtum"},{"@language":"sv","@value":"Tumtum"}],"rdfs:comment":[{"@language":"en","@value":"Term originating in Rabbinic Judaism to refer to someone with an unknown sex; literally translates to \"hidden.\" Used historically to refer to intersex variations where the genitals were covered by skin. Only use for individuals who are Jewish and who self-identify as Tumtum."},{"@language":"es","@value":"Término hebreo utilizado en referencia a un género desconocido; se traduce literalmente como \"oculto\"."},{"@language":"nl","@value":"Israëlische term die wordt gebruikt met betrekking tot een onbekend gender; letterlijke vertaling: \"verborgen\""},{"@language":"sv","@value":"Term med ursprung i rabbinisk judendom som avser någon med okänt kön. Betyder bokstavligen ”dold”. Har historiskt använts för att beskriva intersexvariationer där könsorganen täckts av hud. Bör endast användas för personer som är judar och som själva identifierar sig som tumtum."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000322"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/tumtum"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001501","dc:identifier":"homoit0001501","skos:prefLabel":[{"@language":"id","@value":"Waria"},{"@language":"es","@value":"Waria"},{"@language":"nl","@value":"Waria"},{"@language":"sv","@value":"Waria"}],"rdfs:comment":[{"@language":"en","@value":"Third gender people in Indonesia who are assigned male at birth but who express femininity and may identify as women."},{"@language":"es","@value":"Personas del tercer género en Indonesia que fueron asignadas al sexo masculino al nacer pero que expresan feminidad y pueden identificarse como mujeres."},{"@language":"nl","@value":"Mensen van het derde geslacht in Indonesië die bij de geboorte als man zijn toegewezen, maar die zich vrouwelijk uitdrukken en zich mogelijk als vrouw identificeren"},{"@language":"sv","@value":"Tredje kön i Indonesien. Avser personer som tilldelats manligt kön vid födseln men som uttrycker femininitet och kan identifiera sig som kvinnor."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000322"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/waria"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001502","dc:identifier":"homoit0001502","skos:prefLabel":[{"@language":"mi","@value":"Whakawāhine"},{"@language":"es","@value":"Whakawāhine"},{"@language":"nl","@value":"Whakawahine"},{"@language":"sv","@value":"Whakawāhine"}],"skos:altLabel":[{"@language":"mi","@value":"Whakawahine"},{"@language":"es","@value":"Whakawahine"}],"rdfs:comment":[{"@language":"en","@value":"In Māori culture in New Zealand, this term is used to describe people assigned male at birth who pursue traditionally female roles."},{"@language":"es","@value":"En la cultura maorí de Nueva Zelanda, este término se utiliza para describir a las personas asignadas al sexo masculino al nacer y que desempeñan roles tradicionalmente femeninos."},{"@language":"nl","@value":"In de Māori-cultuur in Nieuw-Zeeland mensen die bij de geboorte als man zijn toegewezen en die traditioneel vrouwelijke rollen vervullen"},{"@language":"sv","@value":"I māorikulturen i Nya Zeeland används termen för personer som tilldelats manligt kön vid födseln och som tar på sig traditionellt kvinnliga roller."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000322"},{"@id":"https://homosaurus.org/v5/homoit0002653"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001499"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/whakawahine"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001506","dc:identifier":"homoit0001506","skos:prefLabel":[{"@language":"lkt","@value":"Winkté"},{"@language":"es","@value":"Winkté"},{"@language":"nl","@value":"Winkté"},{"@language":"sv","@value":"Winkté"}],"skos:altLabel":[{"@language":"en","@value":"Winkte"},{"@language":"es","@value":"Winkte"}],"rdfs:comment":[{"@language":"en","@value":"North American Lakota word referring to people assigned male at birth who adopt feminine roles; translates to \"to be like a woman.\""},{"@language":"es","@value":"Palabra lakota norteamericana que se refiere a personas asignadas al sexo masculino al nacer y que adoptan roles femeninos; se traduce como \"ser como una mujer\"."},{"@language":"nl","@value":"Noord-Amerikaans Lakota-woord dat verwijst naar mensen die bij de geboorte als man zijn toegewezen en vrouwelijke rollen aannemen; letterlijke vertaling: \"zijn als een vrouw\""},{"@language":"sv","@value":"Lakotaord från Nordamerika som syftar på personer som tilldelats manligt kön vid födseln och som antar feminina roller. Översätts som ”att vara som en kvinna”."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000322"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001480"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/winkte"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001517","dc:identifier":"homoit0001517","skos:prefLabel":[{"@language":"ar","@value":"Khaniths"},{"@language":"es","@value":"Khaniths"},{"@language":"nl","@value":"Khaniths"},{"@language":"sv","@value":"Khaniths"}],"skos:altLabel":[{"@language":"ar","@value":"Khanith"},{"@language":"ar","@value":"Xanith"},{"@language":"ar","@value":"Xaniths"},{"@language":"es","@value":"Khanith"},{"@language":"es","@value":"Xanith"},{"@language":"es","@value":"Xaniths"},{"@language":"nl","@value":"Xanith"},{"@language":"nl","@value":"Xaniths"}],"rdfs:comment":[{"@language":"en","@value":"Arabic word used in Oman for people who assigned male at birth who adopt feminine mannerisms and/or roles."},{"@language":"es","@value":"Palabra árabe utilizada en Omán para las personas asignadas al sexo masculino al nacer y que adoptan gestos y/o roles femeninos."},{"@language":"nl","@value":"Arabisch woord dat in Oman wordt gebruikt voor mensen die bij de geboorte als man zijn toegewezen die vrouwelijke manieren en/of rollen aannemen"},{"@language":"sv","@value":"Arabiskt ord som används i Oman för personer som tilldelats manligt kön vid födseln och som antar feminina manér och/eller roller."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000322"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/xanith"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001518","dc:identifier":"homoit0001518","skos:prefLabel":[{"@language":"ja","@value":"X-jendā"},{"@language":"es","@value":"X-jendā"},{"@language":"nl","@value":"X-jendā"},{"@language":"sv","@value":"X-jendā"}],"rdfs:comment":[{"@language":"en","@value":"Japanese term for people who do not fit within the categories of man or woman; includes individuals born intersex, female, or male, and is often abbreviated using FTX, MTX, or XTX to describe individuals' transitions; some definitions equate the term to genderqueer or beyond the binary identities."},{"@language":"es","@value":"Término japonés para personas que no encajan en las categorías de hombre o mujer; incluye a personas nacidas intersex, mujeres u hombres, y a menudo se abrevia utilizando FTX, MTX o XTX para describir las transiciones de las personas; algunas definiciones equiparan el término con genderqueer o más allá de las identidades binarias."},{"@language":"nl","@value":"Japanse term voor mensen die niet passen binnen de categorieën man of vrouw; omvat individuen die intersekse, vrouwelijk of mannelijk zijn geboren en wordt vaak afgekort met FTX, MTX of XTX om de overgangen van individuen te beschrijven; sommige definities stellen de term gelijk aan genderqueer of voorbij de binaire identiteiten"},{"@language":"sv","@value":"Japansk term för personer som inte passar in i kategorierna man eller kvinna. Inkluderar individer som är födda intersex, kvinnor eller män, och förkortas ofta som FTX, MTX eller XTX för att beskriva individers transitioner. Termen motsvarar i vissa definitioner genderqueer eller ickebinära identiteter."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000322"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000457"},{"@id":"https://homosaurus.org/v5/homoit0001027"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/XJenda"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001519","dc:identifier":"homoit0001519","skos:prefLabel":[{"@language":"zh","@value":"Yīnyángrén"},{"@language":"es","@value":"Yīnyángrén"},{"@language":"nl","@value":"Yīnyángrén"},{"@language":"sv","@value":"Yīnyángrén"}],"skos:altLabel":[{"@language":"zh","@value":"Jiānxìngrén"},{"@language":"zh","@value":"Yin-yang ren"},{"@language":"zh","@value":"Yinyang ren"},{"@language":"zh","@value":"Yinyangren"},{"@language":"es","@value":"Jiānxìngrén"},{"@language":"es","@value":"Yin-yang ren"},{"@language":"es","@value":"Yinyang ren"},{"@language":"es","@value":"Yinyangren"}],"rdfs:comment":[{"@language":"en","@value":"Chinese word for individuals who are both female (yin) and male (yang)."},{"@language":"es","@value":"Palabra china para personas que son tanto femeninas (yin) como masculinas (yang)."},{"@language":"nl","@value":"Chinees woord voor een persoon die zowel vrouwelijk (yin) als mannelijk (yang) is"},{"@language":"sv","@value":"Kinesiskt ord för individer som är både kvinnliga (yin) och manliga (yang)."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000322"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/yinyangRen"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001523","dc:identifier":"homoit0001523","skos:prefLabel":[{"@language":"hil","@value":"Zenanas"},{"@language":"es","@value":"Zenanas"},{"@language":"nl","@value":"Zenanas"},{"@language":"sv","@value":"Zenanas"}],"rdfs:comment":[{"@language":"en","@value":"In northern India and Pakistan, this term is used to refer to effeminate people."},{"@language":"es","@value":"En el norte de la India y Pakistán, este término se utiliza para referirse a las personas afeminadas."},{"@language":"nl","@value":"In Noord-India en Pakistan wordt deze term gebruikt om feminine personen aan te duiden."},{"@language":"sv","@value":"I norra Indien och Pakistan används denna term för att beskriva feminina personer."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000322"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/zenanas"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002286","dc:identifier":"homoit0002286","skos:prefLabel":[{"@language":"mzk","@value":"Yan daudu"},{"@language":"es","@value":"Yan daudu"},{"@language":"nl","@value":"Yan daudu"},{"@language":"sv","@value":"Yan daudu"}],"rdfs:comment":[{"@language":"en","@value":"Nigerian term that directly translates to \"feminine men\" but cannot be easily understood through Euro-American understandings of gender. The term has been used to describe people who may identify variously as feminine men, gay men, both male and female (or third gender), and/or trans. While some people self-identify as yan daudu, others consider the term a slur. Only use to describe individuals who self-identify as yan daudu."},{"@language":"es","@value":"Término nigeriano que se traduce directamente como \"hombres femeninos\" pero que no puede entenderse fácilmente a través de la interpretación euroamericana del género. El término se ha utilizado para describir a personas que pueden identificarse de diversas formas como hombres femeninos, hombres gay, tanto masculinos como femeninos (o de tercer género) y/o trans. Mientras que algunas personas seautoidentifican como yan daudu, otras consideran el término un insulto. Utilícese únicamente para describir a personas que seautoidentifican como yan daudu."},{"@language":"nl","@value":"Nigeriaanse term die letterlijk vertaald \"feminiene mannen\" betekent, maar die niet gemakkelijk kan worden begrepen door middel van Euro-Amerikaanse opvattingen over gender. De term is gebruikt om personen te beschrijven die zich op verschillende manieren kunnen identificeren als vrouwelijke mannen, homoseksuele mannen, zowel mannelijk als vrouwelijk (of derde geslacht) en / of trans. Terwijl sommige personen zichzelf identificeren als yan daudu, beschouwen anderen de term als een smet. Alleen gebruiken om personen te beschrijven die zichzelf identificeren als yan daudu."},{"@language":"sv","@value":"Nigeriansk term som direkt översätts till ”feminina män” men som inte enkelt kan förstås genom euro-amerikanska könsbegrepp. Termen har använts för att beskriva personer som kan identifiera sig som feminina män, bögar, både man och kvinna (eller tredje kön) och/eller som trans. Vissa identifierar sig själva som yan daudu, medan andra betraktar termen som nedsättande. Bör endast användas om personer som själva identifierar sig som yan daudu."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000322"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2022-11-10"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003974","dc:identifier":"homoit0003974","skos:prefLabel":[{"@language":"en","@value":"Warmipangui"},{"@language":"nl","@value":"Warmipangui"},{"@language":"sv","@value":"Warmipangui"}],"rdfs:comment":[{"@language":"en","@value":"Amongst the Canelos-Quichua, one of the indigenous Kichwa peoples of the Ecuadorian Amazon, this term is used to refer to people who were assigned male at birth but have the ability to transition between feminine and masculine. "},{"@language":"nl","@value":"Bij de Canelos-Quichua, een van de inheemse Kichwa-volkeren in het Ecuadoraanse Amazonegebied, wordt deze term gebruikt voor mensen die bij de geboorte als man zijn toegewezen, maar die de mogelijkheid hebben om van vrouwelijk naar mannelijk over te gaan."},{"@language":"sv","@value":"Bland Canelos-Quichua, ett av de inhemska kichwa-folken i ecuadorianska delen av Amazonas, används denna term för att hänvisa till personer som tilldelades manligt kön vid födseln men har förmågan att växla mellan feminin och maskulin."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000322"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0003293"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2025-04-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000323","dc:identifier":"homoit0000323","skos:prefLabel":[{"@language":"en","@value":"Cum"},{"@language":"es","@value":"Semen"},{"@language":"de","@value":"Sperma"},{"@language":"nl","@value":"Zaad"},{"@language":"sv","@value":"Utlösning"}],"skos:altLabel":[{"@language":"en","@value":"Semen"},{"@language":"es","@value":"Leche"},{"@language":"es","@value":"Lefa"},{"@language":"de","@value":"Cum"},{"@language":"de","@value":"Ejakulat"},{"@language":"sv","@value":"Sagge"},{"@language":"sv","@value":"Sats"}],"rdfs:comment":[{"@language":"en","@value":"Body fluids produced by sexual arousal and orgasm."},{"@language":"es","@value":"Término coloquial para referirse al semen (o, con menos frecuencia, al fluido vaginal) eyaculado durante el orgasmo."},{"@language":"de","@value":"Körperflüssigkeiten, die durch sexuelle Erregung und Orgasmus produziert werden, typischerweise von biologisch männlichen Personen."},{"@language":"nl","@value":"Informele term voor sperma (of, minder vaak, vaginale vloeistof), geëjaculeerd tijdens een orgasme."},{"@language":"sv","@value":"Kroppsvätskor som produceras vid sexuell upphetsning och orgasm."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0003061"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000589"},{"@id":"https://homosaurus.org/v5/homoit0000610"},{"@id":"https://homosaurus.org/v5/homoit0000683"},{"@id":"https://homosaurus.org/v5/homoit0001284"},{"@id":"https://homosaurus.org/v5/homoit0001288"},{"@id":"https://homosaurus.org/v5/homoit0003128"}],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85119883"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0003061"},"dc:replaces":{"@id":"http://homosaurus.org/v2/cum"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003061","dc:identifier":"homoit0003061","skos:prefLabel":[{"@language":"en","@value":"Body fluids"},{"@language":"es","@value":"Fluidos corporales"},{"@language":"de","@value":"Körperflüssigkeiten"},{"@language":"nl","@value":"Lichaamssappen"},{"@language":"sv","@value":"Kroppsvätskor"}],"skos:altLabel":[{"@language":"en","@value":"Feces"},{"@language":"en","@value":"Milk"},{"@language":"en","@value":"Snot"},{"@language":"en","@value":"Sweat"},{"@language":"en","@value":"Urine"},{"@language":"en","@value":"Vomit"},{"@language":"es","@value":"Heces"},{"@language":"es","@value":"Sudor"},{"@language":"es","@value":"Leche"},{"@language":"es","@value":"Mocos"},{"@language":"es","@value":"Vómito"},{"@language":"es","@value":"Orina"},{"@language":"de","@value":"Fäkalien"},{"@language":"de","@value":"Milch"},{"@language":"de","@value":"Rotz"},{"@language":"de","@value":"Schweiß"},{"@language":"de","@value":"Urin"},{"@language":"de","@value":"Erbrochenes"},{"@language":"nl","@value":"Melk"},{"@language":"nl","@value":"Ontlasting"},{"@language":"nl","@value":"Snot"},{"@language":"nl","@value":"Urine"},{"@language":"nl","@value":"Zweet"}],"rdfs:comment":[{"@language":"en","@value":"Naturally occurring fluids produced by the human body."},{"@language":"es","@value":"Fluidos naturales producidos por el cuerpo humano."},{"@language":"de","@value":"Natürlich vorkommende Flüssigkeiten, die vom menschlichen Körper produziert werden."},{"@language":"nl","@value":"Natuurlijk voorkomende vloeistoffen geproduceerd door het menselijk lichaam."},{"@language":"sv","@value":"Naturligt förekommande vätskor som produceras av människokroppen."}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000323"},{"@id":"https://homosaurus.org/v5/homoit0000683"},{"@id":"https://homosaurus.org/v5/homoit0003114"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000597"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0003061"},"dc:issued":{"@type":"xsd:date","@value":"2023-12-18"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000589","dc:identifier":"homoit0000589","skos:prefLabel":[{"@language":"en","@value":"Getting off"},{"@language":"es","@value":"Venirse"},{"@language":"de","@value":"zum Orgasmus kommen"},{"@language":"nl","@value":"Klaarkomen"},{"@language":"sv","@value":"Komma"}],"skos:altLabel":[{"@language":"es","@value":"Pajearse"},{"@language":"es","@value":"Correrse||"},{"@language":"de","@value":"kommen"}],"rdfs:comment":[{"@language":"en","@value":"Slang term for the act of experiencing erotic or sexual pleasure, typically referring to an orgasm."},{"@language":"es","@value":"Término de la jerga para el acto de experimentar placer erótico o sexual, que generalmente se refiere a un orgasmo."},{"@language":"de","@value":"Umgangssprachlicher Ausdruck für das Erleben erotischer oder sexueller Lust, meist mit Bezug auf einen Orgasmus."},{"@language":"nl","@value":"Term voor het ervaren van erotisch of seksueel genot, meestal verwijzend naar een orgasme."},{"@language":"sv","@value":"Slangterm för att uppleva sexuell njutning, ofta med syftning på orgasm."}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000323"},{"@id":"https://homosaurus.org/v5/homoit0000610"},{"@id":"https://homosaurus.org/v5/homoit0000683"},{"@id":"https://homosaurus.org/v5/homoit0001000"},{"@id":"https://homosaurus.org/v5/homoit0001284"},{"@id":"https://homosaurus.org/v5/homoit0001288"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000589"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gettingOff"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000610","dc:identifier":"homoit0000610","skos:prefLabel":[{"@language":"en","@value":"Happy endings"},{"@language":"es","@value":"Finales felices"},{"@language":"de","@value":"Happy Endings"},{"@language":"nl","@value":"Happy endings"},{"@language":"sv","@value":"Happy endings"}],"rdfs:comment":[{"@language":"en","@value":"Term used in the context of sex work to describe a massage that ends with the masseuse giving the client an orgasm."},{"@language":"es","@value":"Término utilizado en el contexto del trabajo sexual para describir un masaje que termina con el o la masajista dándole al cliente un orgasmo."},{"@language":"de","@value":"Begriff, der im Zusammenhang mit Sexarbeit verwendet wird, um eine Massage zu beschreiben, die damit endet, dass Masseur:innen dem Kunden einen Orgasmus verschaffen."},{"@language":"sv","@value":"Term som används inom sexarbete för att beskriva en massage som avslutas med att massören ger kunden en orgasm."}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000323"},{"@id":"https://homosaurus.org/v5/homoit0000402"},{"@id":"https://homosaurus.org/v5/homoit0000589"},{"@id":"https://homosaurus.org/v5/homoit0000683"},{"@id":"https://homosaurus.org/v5/homoit0001284"},{"@id":"https://homosaurus.org/v5/homoit0001288"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000610"},"dc:replaces":{"@id":"http://homosaurus.org/v2/happyEndings"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000683","dc:identifier":"homoit0000683","skos:prefLabel":[{"@language":"en","@value":"Jizz"},{"@language":"es","@value":"Jizz"},{"@language":"nl","@value":"Kwakje"},{"@language":"sv","@value":"Jizz"}],"rdfs:comment":[{"@language":"en","@value":"Slang term for semen; primarily used in the United States."},{"@language":"es","@value":"Término de la jerga para semen; usado principalmente en Estados Unidos"},{"@language":"nl","@value":"Argot-term voor sperma"},{"@language":"sv","@value":"Slangterm för sperma, används främst i USA."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0003061"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000323"},{"@id":"https://homosaurus.org/v5/homoit0000589"},{"@id":"https://homosaurus.org/v5/homoit0000610"},{"@id":"https://homosaurus.org/v5/homoit0001284"},{"@id":"https://homosaurus.org/v5/homoit0001288"},{"@id":"https://homosaurus.org/v5/homoit0003128"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0003061"},"dc:replaces":{"@id":"http://homosaurus.org/v2/jizz"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modi