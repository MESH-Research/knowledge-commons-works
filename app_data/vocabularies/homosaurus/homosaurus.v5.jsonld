le intersekse personen"}],"rdfs:comment":[{"@language":"en","@value":"Intersex people who belong to two or more racial groups. Only use for people who self-identify as multiracial."},{"@language":"es","@value":"Personas intersexuales que pertenecen a dos o más grupos raciales. Utilícese únicamente para personas que se autoidentifiquen como multirraciales."},{"@language":"nl","@value":"Intersekse personen die tot twee of meer raciale groepen behoren. Alleen gebruiken voor mensen die zichzelf identificeren als multiraciaal."},{"@language":"sv","@value":"Intersexpersoner som tillhör två eller flera rasliga grupper. Används endast för personer som själva identifierar sig som multirasiala."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000903"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-09-29"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003421","dc:identifier":"homoit0003421","skos:prefLabel":[{"@language":"en","@value":"Multiracial non-binary people"},{"@language":"es","@value":"Personas no binarias multirraciales"},{"@language":"nl","@value":"Multiraciale non-binaire personen"},{"@language":"sv","@value":"Multirasiala ickebinära"}],"skos:altLabel":[{"@language":"en","@value":" Non-binary muti-racial people"},{"@language":"en","@value":"Multi-racial nonbinary people"},{"@language":"en","@value":"Multiracial nonbinary people"},{"@language":"en","@value":"Muti-racial non-binary people"},{"@language":"en","@value":"Non-binary multiracial people"},{"@language":"en","@value":"Nonbinary multi-racial people"},{"@language":"en","@value":"Nonbinary multiracial people"},{"@language":"es","@value":"Personas multirraciales no binarias"},{"@language":"nl","@value":"Non-binaire multiraciale personen"},{"@language":"nl","@value":"Nonbinaire multiraciale personen"}],"rdfs:comment":[{"@language":"en","@value":"Non-binary people who belong to two or more racial groups."},{"@language":"es","@value":"Personas no binarias que pertenecen a dos o más grupos raciales. Utilícese únicamente para personas que se autoidentifican como multirraciales."},{"@language":"nl","@value":"Non-binaire personen die tot twee of meer raciale groepen behoren."},{"@language":"sv","@value":"Ickebinära personer som tillhör två eller flera rasliga grupper. Används endast för personer som själva identifierar sig som multirasiala."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000903"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2024-07-11"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004444","dc:identifier":"homoit0004444","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ composers"},{"@language":"ja","@value":"LGBTQ+の作曲家"},{"@language":"nl","@value":"LHBTQ+-componisten"},{"@language":"sv","@value":"Kompositörer (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"Composers (LGBTQ+)"},{"@language":"en","@value":"LGBTQ composers"},{"@language":"ja","@value":"作曲家 (LGBTQ+)"},{"@language":"ja","@value":"LGBTQの作曲家"},{"@language":"sv","@value":"Tonsättare (hbtq+)"}],"rdfs:comment":[{"@language":"en","@value":"LGBTQ+ people who create and arrange original music."},{"@language":"nl","@value":"LHBTQ+-personen die originele muziek componeren en arrangeren."},{"@language":"sv","@value":"Hbtq+-personer som skapar och arrangerar musik."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000908"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0004445"},{"@id":"https://homosaurus.org/v5/homoit0004446"},{"@id":"https://homosaurus.org/v5/homoit0004447"},{"@id":"https://homosaurus.org/v5/homoit0004448"},{"@id":"https://homosaurus.org/v5/homoit0004449"},{"@id":"https://homosaurus.org/v5/homoit0004450"},{"@id":"https://homosaurus.org/v5/homoit0004452"},{"@id":"https://homosaurus.org/v5/homoit0004453"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0004451"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2026-02-24"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002147","dc:identifier":"homoit0002147","skos:prefLabel":[{"@language":"en","@value":"Bandslash"},{"@language":"de","@value":"Bandslash"},{"@language":"es","@value":"Bandslash"},{"@language":"nl","@value":"Bandslash"},{"@language":"sv","@value":"Band-slash"}],"skos:altLabel":[{"@language":"en","@value":"Band slash"},{"@language":"de","@value":"Band slash"},{"@language":"de","@value":"Band-Slash"},{"@language":"es","@value":"Band slash"}],"rdfs:comment":[{"@language":"en","@value":"Fanfiction that focuses on, incorporates, or details the romantic or sexual relationships between same-gender or same-sex musicians who exist in the real world, usually men."},{"@language":"de","@value":"Fanfiction, die romantische oder sexuelle Beziehungen zwischen gleichgeschlechtlichen Musiker:innen thematisieren oder detailliert beschreiben. Die Musiker:innen, zumeist Männer, existieren in der realen Welt."},{"@language":"es","@value":"Fanficcion que se centra, incorpora o detalla las relaciones románticas o sexuales entre músicos del mismo género o del mismo sexo que existen en el mundo real, normalmente hombres."},{"@language":"nl","@value":"Fanfictie die zich richt op, incorporeert of details geeft over de romantische of seksuele relaties tussen muzikanten van hetzelfde geslacht of gender die in de echte wereld bestaan, meestal mannen"},{"@language":"sv","@value":"Fanfiction som fokuserar på eller beskriver romantiska eller sexuella relationer mellan musiker av samma kön eller könsidentitet som existerar i verkligheten, vanligtvis män."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002196"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000908"},{"@id":"https://homosaurus.org/v5/homoit0001806"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004650","dc:identifier":"homoit0004650","skos:prefLabel":{"@language":"en","@value":"Queer clubs (Nightlife)"},"skos:altLabel":[{"@language":"en","@value":"Queer discos"},{"@language":"en","@value":"Queer nightclubs"}],"rdfs:comment":{"@language":"en","@value":"Nightlife entertainment venues or clubs where people dance to recorded music; use in reference to venues that primarily cater to queer people."},"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000909"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001161"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000909"},"dc:issued":{"@type":"xsd:date","@value":"2026-06-10"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-10"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004651","dc:identifier":"homoit0004651","skos:prefLabel":{"@language":"en","@value":"Dyke clubs (Nightlife)"},"skos:altLabel":[{"@language":"en","@value":"Dyke discos"},{"@language":"en","@value":"Dyke nightclubs"}],"rdfs:comment":{"@language":"en","@value":"Nightlife entertainment venues or clubs where people dance to recorded music; use in reference to venues that primarily cater to dykes. For establishments that cater to lesbians more broadly, use \"Lesbian clubs (Nightlife).\""},"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000909"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0003719"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000909"},"dc:issued":{"@type":"xsd:date","@value":"2026-06-10"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-10"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004652","dc:identifier":"homoit0004652","skos:prefLabel":{"@language":"en","@value":"Transgender clubs (Nightlife)"},"skos:altLabel":[{"@language":"en","@value":"Trans discos"},{"@language":"en","@value":"Transgender discos"},{"@language":"en","@value":"Trans nightclubs"},{"@language":"en","@value":"Transgender nightclubs"},{"@language":"en","@value":"Trans clubs (Nightlife)"}],"rdfs:comment":{"@language":"en","@value":"Nightlife entertainment venues or clubs where people dance to recorded music; use in reference to venues that primarily cater to transgender people."},"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000909"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001394"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000909"},"dc:issued":{"@type":"xsd:date","@value":"2026-06-10"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-10"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000930","dc:identifier":"homoit0000930","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ restaurants"},{"@language":"es","@value":"Restaurantes LGBTQ+"},{"@language":"nl","@value":"LHBTQ+-restaurants"},{"@language":"sv","@value":"Hbtq+-restauranger"}],"skos:altLabel":[{"@language":"en","@value":"LGBTQ restaurants"},{"@language":"es","@value":"Restaurants (LGBTQ)"}],"rdfs:comment":[{"@language":"en","@value":"Commercial establishments that prepare and serve food and drinks; use in reference to restaurants that cater primarily to LGBTQ+ people or are known to be frequented by LGBTQ+ people."},{"@language":"es","@value":"Establecimientos comerciales que preparan y sirven alimentos y bebidas; utilícese en referencia a restaurantes que atienden principalmente a personas LGBTQ+ o que son conocidos por ser frecuentados por personas LGBTQ+."},{"@language":"nl","@value":"Commerciële etablissementen die eten en drinken bereiden en serveren; gebruik met betrekking tot restaurants die zich voornamelijk richten op LHBTQ+-personen of waarvan bekend is dat ze veelal worden bezocht door LHBTQ+-personen."},{"@language":"sv","@value":"Kommersiella verksamheter som tillagar och serverar mat och dryck. Används för restauranger som i första hand vänder sig till hbtq+-personer eller som är kända för att ofta besökas av hbtq+-personer."}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000909"},{"@id":"https://homosaurus.org/v5/homoit0000956"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000930"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQRestaurants"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002385","dc:identifier":"homoit0002385","skos:prefLabel":[{"@language":"en","@value":"Police raids on LGBTQ+ nightclubs"},{"@language":"es","@value":"Redadas policiales en clubes nocturnos LGBTQ+"},{"@language":"nl","@value":"Politie-invallen in LHBTQ+-nachtclubs"},{"@language":"sv","@value":"Polisräder mot hbtq+-klubbar"}],"skos:altLabel":[{"@language":"es","@value":"Redadas policiales en clubs LGBTQ+"},{"@language":"sv","@value":"Polisrazzior mot hbtq+-klubbar"}],"rdfs:comment":[{"@language":"en","@value":"Unexpected and unannounced entry into and searches of nightclubs owned or frequented by LGBTQ+ people by law enforcement officers with the aim of using surprise to seize evidence or arrest suspects. Police raids may be undertaken legally using a search warrant or through exigent circumstances, such as probable cause, though the latter is highly subjective and civilians often have little resources to appeal illegal raids."},{"@language":"es","@value":"Redadas policiales en clubes nocturnos afiliados o relacionados con comunidades o identidades LGBTQ+"},{"@language":"nl","@value":"Politie-invallen in LHBTQ+-gelieerde of -gerelateerde nachtclubs."},{"@language":"sv","@value":"Oannonserade och oväntade intrång i och genomsökningar av nattklubbar som ägs av eller frekventeras av hbtq+-personer, genomförda av poliser i syfte att överraska för att beslagta bevis eller gripa misstänkta. Polisräder kan genomföras lagligt med stöd av husrannsakan eller genom påstådda brådskande omständigheter, till exempel sannolika skäl, vilket är subjektivt och ofta ger begränsade möjligheter för civila att överklaga olagliga räder."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002381"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000909"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000611"},"dc:issued":{"@type":"xsd:date","@value":"2023-01-13"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001943","dc:identifier":"homoit0001943","skos:prefLabel":[{"@language":"en","@value":"Papuan lesbians"},{"@language":"es","@value":"Lesbianas papúes"},{"@language":"nl","@value":"Papoea lesbische vrouwen"},{"@language":"sv","@value":"Lesbiska papuaner"}],"skos:altLabel":[{"@language":"en","@value":"Lesbian Papuans"},{"@language":"es","@value":"Papúes lesbianas"}],"rdfs:comment":[{"@language":"en","@value":"Lesbians who are Papuan, or part of the Indigenous peoples of new Guinea; only use for people who identify as Papuan."},{"@language":"es","@value":"Lesbianas que son papúes o parte de los pueblos indígenas de Nueva Guinea. Utilícese únicamente para personas que se autoidentifiquen como papúes."},{"@language":"nl","@value":"Lesbische vrouwen die Papoea zijn, of deel uitmaken van de inheemse volkeren van Nieuw-Guinea; alleen gebruiken voor mensen die zich identificeren als Papoea"},{"@language":"sv","@value":"Lesbiska som är papuanska eller tillhör något av Nya Guineas ursprungsfolk. Använd endast för personer som själva identifierar sig som papuanska."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000913"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-05-11"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001944","dc:identifier":"homoit0001944","skos:prefLabel":[{"@language":"en","@value":"Papuan gay men"},{"@language":"es","@value":"Hombres gay papúes"},{"@language":"nl","@value":"Papoea homomannen"},{"@language":"sv","@value":"Papuanska bögar"}],"skos:altLabel":[{"@language":"en","@value":"Gay Papuan men"},{"@language":"en","@value":"Gay Papuans"},{"@language":"es","@value":"Hombres papúes gay"}],"rdfs:comment":[{"@language":"en","@value":"Gay men who are Papuan, or part of the Indigenous peoples of new Guinea; only use for people who identify as Papuan."},{"@language":"es","@value":"Hombres gay que son papúes o parte de los pueblos indígenas de Nueva Guinea. Utilícese únicamente para personas que se autoidentifiquen como papúes."},{"@language":"nl","@value":"Homomannen die Papoea zijn, of deel uitmaken van de inheemse volkeren van Nieuw-Guinea; alleen gebruiken voor mensen die zich identificeren als Papoea"},{"@language":"sv","@value":"Bögar som är papuanska eller tillhör något av Nya Guineas ursprungsfolk. Använd endast för personer som själva identifierar sig som papuanska."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000913"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-05-11"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001945","dc:identifier":"homoit0001945","skos:prefLabel":[{"@language":"en","@value":"Papuan bisexual people"},{"@language":"es","@value":"Personas bisexuales papúes"},{"@language":"nl","@value":"Papoea biseksuele personen"},{"@language":"sv","@value":"Bisexuella papuaner"}],"skos:altLabel":[{"@language":"en","@value":"Bisexual Papuan people"},{"@language":"en","@value":"Bisexual Papuans"},{"@language":"es","@value":"Personas papúes bisexuales"},{"@language":"nl","@value":"Papoea biseksuelen"}],"rdfs:comment":[{"@language":"en","@value":"Bisexual people who are Papuan, or part of the Indigenous peoples of new Guinea; only use for people who identify as Papuan."},{"@language":"es","@value":"Personas bisexuales que son papúes o parte de los pueblos indígenas de Nueva Guinea. Utilícese únicamente para personas que se autoidentifiquen como papúes."},{"@language":"nl","@value":"Biseksuele personen die Papoea zijn, of deel uitmaken van de inheemse volkeren van Nieuw-Guinea; alleen gebruiken voor mensen die zich identificeren als Papoea"},{"@language":"sv","@value":"Bisexuella personer som är papuanska eller tillhör något av Nya Guineas ursprungsfolk. Använd endast för personer som själva identifierar sig som papuanska."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000913"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-05-11"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme