kos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000192"},{"@id":"https://homosaurus.org/v5/homoit0000544"},{"@id":"https://homosaurus.org/v5/homoit0000786"},{"@id":"https://homosaurus.org/v5/homoit0000880"},{"@id":"https://homosaurus.org/v5/homoit0001215"},{"@id":"https://homosaurus.org/v5/homoit0001452"},{"@id":"https://homosaurus.org/v5/homoit0002223"},{"@id":"https://homosaurus.org/v5/homoit0002292"},{"@id":"https://homosaurus.org/v5/homoit0002460"},{"@id":"https://homosaurus.org/v5/homoit0002489"},{"@id":"https://homosaurus.org/v5/homoit0002509"},{"@id":"https://homosaurus.org/v5/homoit0002538"},{"@id":"https://homosaurus.org/v5/homoit0003460"},{"@id":"https://homosaurus.org/v5/homoit0003474"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000630"},{"@id":"https://homosaurus.org/v5/homoit0000674"},{"@id":"https://homosaurus.org/v5/homoit0000933"},{"@id":"https://homosaurus.org/v5/homoit0000964"},{"@id":"https://homosaurus.org/v5/homoit0001522"},{"@id":"https://homosaurus.org/v5/homoit0001756"},{"@id":"https://homosaurus.org/v5/homoit0002700"},{"@id":"https://homosaurus.org/v5/homoit0002711"},{"@id":"https://homosaurus.org/v5/homoit0004262"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2004011606"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001520"},"dc:replaces":{"@id":"http://homosaurus.org/v2/youthLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000203","dc:identifier":"homoit0000203","skos:prefLabel":[{"@language":"en","@value":"Bisexual youth literature"},{"@language":"es","@value":"Literatura juvenil bisexual"},{"@language":"de","@value":"Bisexuelle Jugendliteratur"},{"@language":"nl","@value":"Biseksuele jeugdliteratuur"},{"@language":"sv","@value":"Bisexuell ungdomslitteratur"}],"rdfs:comment":[{"@language":"en","@value":"Written literary works for an audience of readers from 12-18 years of age, also known as young adult literature or YA; use in reference to youth literature focusing on bisexual characters or themes."},{"@language":"es","@value":"Obras literarias escritas para una audiencia de lectores de 12 a 18 años de edad, también conocida como literatura para adultos jóvenes o YA; utilícese en referencia a la literatura juvenil que se centra en personajes o temas bisexuales."},{"@language":"de","@value":"Literarische Werke, die für eine Leserschaft im Alter von 12 bis 18 Jahren geschrieben werden, auch bekannt als YA (Young Adult); verwenden in Bezug auf Jugendliteratur, die sich auf bisexuelle Charakteren oder Themen konzentriert."},{"@language":"nl","@value":"Geschreven literaire werken voor een lezerspubliek van 12-18 jaar, ook wel jong volwassenen literatuur genoemd; gebruik met verwijzing naar jeugdliteratuur gericht op biseksuele personages of thema's."},{"@language":"sv","@value":"Litterära verk för läsare mellan 12 och 18 år, även kallat YA. Används för ungdomslitteratur med fokus på bisexuella karaktärer eller teman."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001522"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000192"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualYouthLiterature"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001359","dc:identifier":"homoit0001359","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ television"},{"@language":"es","@value":"Televisión LGBTQ+"},{"@language":"nl","@value":"LHBTQ+-televisie"},{"@language":"sv","@value":"Tv-program (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"Television (LGBTQ)"},{"@language":"es","@value":"Televisión (LGBTQ)"}],"rdfs:comment":[{"@language":"en","@value":"Television shows featuring LGBTQ+ characters or themes."},{"@language":"es","@value":"Programas de televisión con personajes o temas LGBTQ+."},{"@language":"nl","@value":"Televisieprogramma's met LHBTQ+- personen of LHBTQ+-thema's."},{"@language":"sv","@value":"Tv-program med hbtq+-karaktärer eller teman."}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000193"},{"@id":"https://homosaurus.org/v5/homoit0000545"},{"@id":"https://homosaurus.org/v5/homoit0000787"},{"@id":"https://homosaurus.org/v5/homoit0001216"},{"@id":"https://homosaurus.org/v5/homoit0001453"},{"@id":"https://homosaurus.org/v5/homoit0002854"},{"@id":"https://homosaurus.org/v5/homoit0002946"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000249"},{"@id":"https://homosaurus.org/v5/homoit0002730"},{"@id":"https://homosaurus.org/v5/homoit0003245"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001359"},"dc:replaces":{"@id":"http://homosaurus.org/v2/televisionLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001363","dc:identifier":"homoit0001363","skos:prefLabel":[{"@language":"en-us","@value":"LGBTQ+ theater"},{"@language":"es","@value":"Teatro LGBTQ+"},{"@language":"nl","@value":"LHBTQ+-theater"},{"@language":"sv","@value":"Teater (hbtq+)"},{"@language":"en-gb","@value":"LGBTQ+ theatre"}],"rdfs:comment":[{"@language":"en","@value":"Works in the performance arts that focus on LGBTQ+ characters, communities, or issues."},{"@language":"es","@value":"Trabajos en las artes escénicas que se centran en personajes, comunidades o cuestiones LGBTQ+."},{"@language":"nl","@value":"Uitvoeringen in de podiumkunsten die zich richten op LHBTQ+-personages, gemeenschappen of kwesties."},{"@language":"sv","@value":"Scenkonstverk som fokuserar på hbtq+-karaktärer, gemenskaper eller frågor."}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000194"},{"@id":"https://homosaurus.org/v5/homoit0000431"},{"@id":"https://homosaurus.org/v5/homoit0000546"},{"@id":"https://homosaurus.org/v5/homoit0000685"},{"@id":"https://homosaurus.org/v5/homoit0000788"},{"@id":"https://homosaurus.org/v5/homoit0000983"},{"@id":"https://homosaurus.org/v5/homoit0001217"},{"@id":"https://homosaurus.org/v5/homoit0001344"},{"@id":"https://homosaurus.org/v5/homoit0001454"},{"@id":"https://homosaurus.org/v5/homoit0002453"},{"@id":"https://homosaurus.org/v5/homoit0002469"},{"@id":"https://homosaurus.org/v5/homoit0002486"},{"@id":"https://homosaurus.org/v5/homoit0002502"},{"@id":"https://homosaurus.org/v5/homoit0002523"},{"@id":"https://homosaurus.org/v5/homoit0002947"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000376"},{"@id":"https://homosaurus.org/v5/homoit0000816"},{"@id":"https://homosaurus.org/v5/homoit0001031"},{"@id":"https://homosaurus.org/v5/homoit0001755"},{"@id":"https://homosaurus.org/v5/homoit0001813"},{"@id":"https://homosaurus.org/v5/homoit0002731"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001363"},"dc:replaces":{"@id":"http://homosaurus.org/v2/theatreLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000961","dc:identifier":"homoit0000961","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ victims of war"},{"@language":"es","@value":"Víctimas LGBTQ+ de guerra"},{"@language":"fr","@value":"Personnes LGBTQ+ victimes de guerre"},{"@language":"nl","@value":"LHBTQ+-oorlogsslachtoffers"},{"@language":"sv","@value":"Krigsoffer (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"LGBTQ war victims"},{"@language":"en","@value":"Victims of war (LGBTQ)"}],"rdfs:comment":[{"@language":"en","@value":"LGBTQ+ people who have experienced war and may or may not have survived; follow the individual's preference for \"victims\" or \"survivors\" whenever possible."},{"@language":"es","@value":"Personas LGBTQ+ que han sufrido la guerra y que pueden haber sobrevivido o no; siga la preferencia de la persona sobre el uso de \"víctimas\" o \"sobrevivientes\" siempre que sea posible."},{"@language":"fr","@value":"Personnes LGBTQ+ ayant vécu la guerre et qui peuvent ou non avoir survécu; respecter la préférence de la personne concernée entre les termes « victimes » ou « survivantes » dans la mesure du possible."},{"@language":"nl","@value":"LHBTQ+-personen die oorlog hebben meegemaakt en al dan niet hebben overleefd; volg waar mogelijk de voorkeur van het individu voor \"slachtoffers\" of \"overlevenden\""},{"@language":"sv","@value":"Hbtq+-personer som har upplevt krig och som kan ha överlevt eller inte. Följ individens preferens för att använda ”offer” eller ”överlevare” när det är möjligt."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000915"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000199"},{"@id":"https://homosaurus.org/v5/homoit0000553"},{"@id":"https://homosaurus.org/v5/homoit0000795"},{"@id":"https://homosaurus.org/v5/homoit0001224"},{"@id":"https://homosaurus.org/v5/homoit0001459"},{"@id":"https://homosaurus.org/v5/homoit0002857"},{"@id":"https://homosaurus.org/v5/homoit0002950"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001352"},{"@id":"https://homosaurus.org/v5/homoit0002735"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/victimsOfWarLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000200","dc:identifier":"homoit0000200","skos:prefLabel":[{"@language":"en","@value":"Bisexual victims' rights"},{"@language":"es","@value":"Derechos de víctimas bisexuales"},{"@language":"de","@value":"Bisexuelle Opferrechte"},{"@language":"nl","@value":"Slachtofferrechten voor biseksuele personen"},{"@language":"sv","@value":"Bisexuella brottsoffers rättigheter"}],"skos:altLabel":[{"@language":"de","@value":"Rechte bisexueller Opfer"},{"@language":"nl","@value":"Slachtofferrechten voor biseksuelen"}],"rdfs:comment":[{"@language":"en","@value":"Bisexual people's legal rights to be informed, present, and heard within the criminal justice system after having been harmed or injured as the result of of a crime, accident, or other event."},{"@language":"es","@value":"Los derechos legales de las personas bisexuales a estar informadas, estar presentes y ser escuchadas dentro del sistema de justicia penal después de haber sido perjudicadas o lesionadas como resultado de un delito, una accidente u otro evento."},{"@language":"de","@value":"Das Recht bisexueller Personen auf Information, Anwesenheit und Anhörung im Rahmen des Strafrechtssystems, wenn sie infolge eines Verbrechens, eines Unfalls oder eines anderen Ereignisses geschädigt oder verletzt worden sind."},{"@language":"nl","@value":"De wettelijke rechten van biseksuele personen om te worden geïnformeerd, aanwezig te zijn en gehoord te worden binnen het strafrechtsysteem nadat ze zijn geschaad of gewond zijn geraakt als gevolg van een misdrijf, ongeval of andere gebeurtenis."},{"@language":"sv","@value":"Bisexuella personers juridiska rättigheter som brottsoffer att få information, närvara och komma till tals inom rättsväsendet efter att ha utsatts för brott, olycka eller annan händelse som orsakat skada."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001492"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000702"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualVictimsRights"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001492","dc:identifier":"homoit0001492","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ victims' rights"},{"@language":"es","@value":"Derechos de víctimas LGBTQ+"},{"@language":"nl","@value":"LHBTQ+-slachtofferrechten"},{"@language":"sv","@value":"Brottsoffers rättigheter (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"Victims' rights (LGBTQ)"},{"@language":"es","@value":"Derechos de víctimas LGBTQ"}],"rdfs:comment":[{"@language":"en","@value":"LGBTQ+ people’s legal rights to be informed, present, and heard within the criminal justice system after having been harmed or injured as the result of a crime, accident, or other event."},{"@language":"es","@value":"Los derechos legales de las personas LGBTQ+ a estar informadas, estar presentes y ser escuchadas dentro del sistema de justicia penal después de haber sido perjudicadas o lesionadas como resultado de un delito, accidente u otro evento."},{"@language":"nl","@value":"De wettelijke rechten van LHBTQ+-personen om te worden geïnformeerd, aanwezig te zijn en gehoord te worden binnen het strafrechtsysteem nadat ze zijn geschaad of gewond zijn geraakt als gevolg van een misdrijf, ongeval of andere gebeurtenis."},{"@language":"sv","@value":"Hbtq+-personers juridiska rättigheter som brottsoffer att få information, närvara och komma till tals inom rättsväsendet efter att ha utsatts för brott, olycka eller annan händelse som orsakat skada."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000702"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000200"},{"@id":"https://homosaurus.org/v5/homoit0000554"},{"@id":"https://homosaurus.org/v5/homoit0000796"},{"@id":"https://homosaurus.org/v5/homoit0001225"},{"@id":"https://homosaurus.org/v5/homoit0001460"},{"@id":"https://homosaurus.org/v5/homoit0002858"},{"@id":"https://homosaurus.org/v5/homoit0002951"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000276"},{"@id":"https://homosaurus.org/v5/homoit0000312"},{"@id":"https://homosaurus.org/v5/homoit0002736"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000702"},"dc:replaces":{"@id":"http://homosaurus.org/v2/victimsRightsLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000201","dc:identifier":"homoit0000201","skos:prefLabel":[{"@language":"en","@value":"White bisexual people"},{"@language":"es","@value":"Personas bisexuales blancas"},{"@language":"nl","@value":"Witte biseksuele personen"},{"@language":"sv","@value":"Vita bisexuella personer"}],"skos:altLabel":[{"@language":"en","@value":"Bisexual Caucasian people"},{"@language":"en","@value":"Bisexual white people"},{"@language":"es","@value":"Personas caucásicas bisexuales"},{"@language":"es","@value":"Personas blancas bisexuales"},{"@language":"nl","@value":"Biseksuele witte personen"},{"@language":"nl","@value":"Witte biseksuelen"}],"rdfs:comment":[{"@language":"en","@value":"Bisexual people who are white."},{"@language":"es","@value":"Personas bisexuales que son blancas."},{"@language":"nl","@value":"Biseksuele personen die wit zijn"},{"@language":"sv","@value":"Bisexuella personer som är vita."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000243"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000243"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualWhitePeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000243","dc:identifier":"homoit0000243","skos:prefLabel":[{"@language":"en","@value":"White LGBTQ+ people"},{"@language":"es","@value":"Personas LGBTQ+ blancas"},{"@language":"nl","@value":"Witte LHBTQ+-personen"},{"@language":"sv","@value":"Vita hbtq+-personer"}],"skos:altLabel":[{"@language":"en","@value":"Caucasians (LGBTQ)"},{"@language":"en","@value":"White people (LGBTQ)"},{"@language":"en","@value":"Caucasian LGBTQ+ people"},{"@language":"en","@value":"LGBTQ+ Caucasian people"},{"@language":"en","@value":"LGBTQ+ white people"},{"@language":"es","@value":"Personas caucásicas LGBTQ+"},{"@language":"es","@value":"Caucásicos (LGBTQ+)"},{"@language":"es","@value":"Personas caucásicas (LGBTQ)"},{"@language":"es","@value":"Personas caucásicas  blancas"},{"@language":"es","@value":"Personas blancas LGBTQ+"},{"@language":"es","@value":"Personas blancas (LGBTQ)"},{"@language":"nl","@value":"Blanken (LHBTQ+)"},{"@language":"nl","@value":"LHBTQ+-blanke personen"},{"@language":"nl","@value":"LHBTQ+-witte personen"},{"@language":"nl","@value":"Witte personen (LHBTQ+)"}],"rdfs:comment":[{"@language":"en","@value":"LGBTQ+ people who are white."},{"@language":"es","@value":"Personas LGBTQ+ que son blancas."},{"@language":"nl","@value":"LHBTQ+-personen die wit zijn"},{"@language":"sv","@value":"Hbtq+-personer som är vita."}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000201"},{"@id":"https://homosaurus.org/v5/homoit0000555"},{"@id":"https://homosaurus.org/v5/homoit0000797"},{"@id":"https://homosaurus.org/v5/homoit0001226"},{"@id":"https://homosaurus.org/v5/homoit0001461"},{"@id":"https://homosaurus.org/v5/homoit0002746"},{"@id":"https://homosaurus.org/v5/homoit0002915"},{"@id":"https://homosaurus.org/v5/homoit0003381"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001133"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000243"},"dc:replaces":{"@id":"http://homosaurus.org/v2/whitePeopleLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001002","dc:identifier":"homoit0001002","skos:prefLabel":[{"@language":"srn","@value":"Mati"},{"@language":"es","@value":"Mati"},{"@language":"nl","@value":"Mati"},{"@language":"sv","@value":"Mati"}],"rdfs:comment":[{"@language":"en","@value":"Surinamese-Creole women who have sexual relations with other women but also have had or do have relationships with men."},{"@language":"es","@value":"Mujeres surinamesas-criollas que tienen relaciones sexuales con otras mujeres pero que también han tenido o tienen relaciones con hombres."},{"@language":"nl","@value":"Surinaams-Creoolse vrouwen die seksuele relaties hebben met andere vrouwen, maar die ook relaties hebben of hebben gehad met mannen"},{"@language":"sv","@value":"Surinamesisk-kreolska kvinnor som har sexuella relationer med andra kvinnor men som också har haft eller har relationer med män."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000202"},{"@id":"https://homosaurus.org/v5/homoit0001510"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/mati"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001510","dc:identifier":"homoit0001510","skos:prefLabel":[{"@language":"en","@value":"Women who have sex with women"},{"@language":"es","@value":"Mujeres que tienen sexo con mujeres"},{"@language":"nl","@value":"Vrouwen die seks hebben met vrouwen"},{"@language":"sv","@value":"Kvinnor som har sex med kvinnor"}],"skos:altLabel":[{"@language":"en","@value":"WSW"},{"@language":"sv","@value":"KSK"}],"rdfs:comment":[{"@language":"en","@value":"Women who engage in sexual activity with other women."},{"@language":"es","@value":"Mujeres que mantienen actividad sexual con otras mujeres."},{"@language":"nl","@value":"Vrouwen die seksuele activiteiten hebben met andere vrouwen"},{"@language":"sv","@value":"Kvinnor som har sex med andra kvinnor."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000915"},{"@id":"https://homosaurus.org/v5/homoit0001509"}],"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0001002"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000202"},{"@id":"https://homosaurus.org/v5/homoit0000556"},{"@id":"https://homosaurus.org/v5/homoit0001254"},{"@id":"https://homosaurus.org/v5/homoit0001297"},{"@id":"https://homosaurus.org/v5/homoit0001342"},{"@id":"https://homosaurus.org/v5/homoit0003613"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/womenWhoHaveSexWithWomen"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001522","dc:identifier":"homoit0001522","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ youth literature"},{"@language":"es","@value":"Literatura juvenil LGBTQ+"},{"@language":"nl","@value":"LHBTQ+-jeugdliteratuur"},{"@language":"sv","@value":"Ungdomslitteratur (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"Young adult literature (LGBTQ)"},{"@language":"en","@value":"Youth literature (LGBTQ)"},{"@language":"sv","@value":"Hbtq+-ungdomslitteratur"}],"rdfs:comment":[{"@language":"en","@value":"Written literary works for an audience of readers from 12-18 years of age, also known as young adult literature or YA; use in reference to youth literature focusing on LGBTQ+ characters or themes."},{"@language":"es","@value":"Obras literarias escritas para una audiencia de lectores de 12 a 18 años de edad, también conocidas como literatura para adultos jóvenes o YA (por sus siglas en inglés); utilícese en referencia a la literatura juvenil centrada en personajes o temas LGBTQ+."},{"@language":"nl","@value":"Geschreven literaire werken voor een lezerspubliek van 12-18 jaar, ook wel young adult literatuur of YA genoemd; gebruik in verwijzing naar jeugdliteratuur gericht op LHBTQ+-personages of thema's."},{"@language":"sv","@value":"Litterära verk för läsare mellan 12 och 18 år, även kallat YA. Används för ungdomslitteratur med fokus på hbtq+-karaktärer eller teman."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000972"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000203"},{"@id":"https://homosaurus.org/v5/homoit0000557"},{"@id":"https://homosaurus.org/v5/homoit0000798"},{"@id":"https://homosaurus.org/v5/homoit0001228"},{"@id":"https://homosaurus.org/v5/homoit0001462"},{"@id":"https://homosaurus.org/v5/homoit0002461"},{"@id":"https://homosaurus.org/v5/homoit0002478"},{"@id":"https://homosaurus.org/v5/homoit0002490"},{"@id":"https://homosaurus.org/v5/homoit0002510"},{"@id":"https://homosaurus.org/v5/homoit0002539"},{"@id":"https://homosaurus.org/v5/homoit0002953"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001521"},{"@id":"https://homosaurus.org/v5/homoit0002179"},{"@id":"https://homosaurus.org/v5/homoit0002712"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/youthLiteratureLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001558","dc:identifier":"homoit0001558","skos:prefLabel":[{"@language":"en","@value":"Polysexuality"},{"@language":"es","@value":"Polisexualidad"},{"@language":"fr","@value":"Polysexualité"},{"@language":"nl","@value":"Polyseksualiteit"},{"@language":"sv","@value":"Polysexualitet"}],"rdfs:comment":[{"@language":"en","@value":"Term used to describe the sexual identity of individuals who experience attraction to more than one gender; includes bisexuality and pansexuality."},{"@language":"es","@value":"Término utilizado para describir la identidad sexual de personas que sienten atracción por más de un género; incluye la bisexualidad y la pansexualidad."},{"@language":"fr","@value":"Identité sexuelle des personnes qui ressentent une attirance envers plus d'un genre; inclut la bisexualité et la pansexualité."},{"@language":"nl","@value":"Een seksuele voorkeur waarbij personen zich aangetrokken voelen tot meer dan één geslacht, zoals biseksualiteit of panseksualiteit"},{"@language":"sv","@value":"Term som används för att beskriva sexuell identitet hos personer som känner attraktion till mer än ett kön. Inkluderar bisexualitet och pansexualitet."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001290"},{"@id":"https://homosaurus.org/v5/homoit0001295"},{"@id":"https://homosaurus.org/v5/homoit0001298"},{"@id":"https://homosaurus.org/v5/homoit0001300"}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000204"},{"@id":"https://homosaurus.org/v5/homoit0001926"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001123"},{"@id":"https://homosaurus.org/v5/homoit0001919"},{"@id":"https://homosaurus.org/v5/homoit0004441"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000358"},"dc:replaces":{"@id":"http://homosaurus.org/v2/polysexuality"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-03"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003445","dc:identifier":"homoit0003445","skos:prefLabel":[{"@language":"en","@value":"Bicuriosity"},{"@language":"de","@value":"Bi-Curiosity"},{"@language":"es","@value":"Bicuriosidad"},{"@language":"nl","@value":"Bicuriositeit"},{"@language":"sv","@value":"Bi-nyfiken"}],"skos:altLabel":[{"@language":"en","@value":"Bi-curiosity"},{"@language":"en","@value":"Bi-curious"},{"@language":"en","@value":"Bicurious"},{"@language":"de","@value":"Bi-Neugierde"},{"@language":"es","@value":"Bi-curiosidad"},{"@language":"es","@value":"Bicurioso"},{"@language":"es","@value":"Bicuriosa"},{"@language":"nl","@value":"Bi-curiositeit"},{"@language":"nl","@value":"Bi-nieuwsgierig"},{"@language":"sv","@value":"Binyfiken"},{"@language":"sv","@value":"Bicuriosity"}],"rdfs:comment":[{"@language":"en","@value":"A term used to describe the phenomena of heterosexual or hetero-presenting individuals expressing curiosity about exploring sexual relationships or experiences with other people of the same gender."},{"@language":"de","@value":"Ein Begriff, der das Phänomen beschreibt, dass heterosexuelle oder heterosexuell auftretende Personen neugierig darauf sind, sexuelle Beziehungen oder Erfahrungen mit anderen Menschen desselben Geschlechts zu erkunden."},{"@language":"es","@value":"Término utilizado para describir el fenómeno de personas heterosexuales o de apariencia heterosexual que expresan curiosidad por explorar relaciones o experiencias sexuales con otras personas de su mismo género."},{"@language":"nl","@value":"Een term die wordt gebruikt om het fenomeen te beschrijven waarbij heteroseksuele of zich als hetero presenterende personen nieuwsgierig zijn naar het verkennen van seksuele relaties of ervaringen met andere mensen van hetzelfde geslacht."},{"@language":"sv","@value":"En term som används för att beskriva fenomenet där heterosexuella eller personer som uppfattas som heterosexuella uttrycker nyfikenhet på att utforska sexuella relationer eller upplevelser med personer av samma kön."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000204"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000620"},{"@id":"https://homosaurus.org/v5/homoit0000631"},{"@id":"https://homosaurus.org/v5/homoit0003509"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001298"},"dc:issued":{"@type":"xsd:date","@value":"2024-07-31"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000647","dc:identifier":"homoit0000647","skos:prefLabel":[{"@language":"en","@value":"Homosexuality"},{"@language":"es","@value":"Homosexualidad"},{"@language":"de","@value":"Homosexualität"},{"@language":"fr","@value":"Homosexualité"},{"@language":"nl","@value":"Homoseksualiteit"},{"@language":"sv","@value":"Homosexualitet"}],"rdfs:comment":[{"@language":"en","@value":"Sexual orientation with sexual and/or romantic attraction to individuals of the same sex."},{"@language":"es","@value":"Orientación sexual con atracción sexual y/o romántica hacia personas del mismo sexo."},{"@language":"de","@value":"Sexuelle Orientierung, bei der man sich sexuell und/oder romantisch zu Personen des gleichen Geschlechts hingezogen fühlt."},{"@language":"fr","@value":"Orientation sexuelle avec attirance sexuelle ou romantique pour les personnes du même sexe."},{"@language":"nl","@value":"Seksuele oriëntatie met seksuele en/of romantische aantrekking tot personen van hetzelfde geslacht"},{"@language":"sv","@value":"Sexuell läggning som innebär sexuell och/eller romantisk attraktion till personer av samma kön."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001298"},{"@id":"https://homosaurus.org/v5/homoit0001556"}],"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0001240"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000204"},{"@id":"https://homosaurus.org/v5/homoit0000506"},{"@id":"https://homosaurus.org/v5/homoit0000556"},{"@id":"https://homosaurus.org/v5/homoit0000631"},{"@id":"https://homosaurus.org/v5/homoit0000799"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85061780"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001298"},"dc:replaces":{"@id":"http://homosaurus.org/v2/homosexuality"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000799","dc:identifier":"homoit0000799","skos:prefLabel":[{"@language":"en","@value":"Lesbianism"},{"@language":"es","@value":"Lesbianismo"},{"@language":"fr","@value":"Lesbianisme"},{"@language":"nl","@value":"Lesbianisme"},{"@language":"sv","@value":"Lesbiskhet"}],"skos:altLabel":{"@language":"sv","@value":"Lesbianism"},"rdfs:comment":[{"@language":"en","@value":"Sexual orientation of women and femmes who are sexually and/or romantically attracted to other women and femmes. However, not all lesbians are women, and gender non-conforming people who belong to lesbian communities have often identified as lesbian."},{"@language":"es","@value":"Orientación sexual de mujeres y femmes que se sienten atraídas sexual y/o románticamente por otras mujeres y femmes. Sin embargo, no todas las lesbianas son mujeres, y las personas disidentes de género que pertenecen a comunidades lésbicas a menudo se han identificado como lesbianas."},{"@language":"fr","@value":"Orientation sexuelle des femmes qui sont sexuellement et/ou romantiquement attirées par d'autres femmes. Cependant, toutes les lesbiennes ne sont pas des femmes, et les personnes non conformes au genre qui appartiennent à des communautés lesbiennes se sont souvent identifiées comme lesbiennes."},{"@language":"nl","@value":"Seksuele oriëntatie van vrouwen en femmes die zich seksueel en/of romantisch aangetrokken voelen tot andere vrouwen en femmes. Niet alle lesbische vrouwen zijn echter vrouwen, en gender-niet-conforme personen die tot lesbische gemeenschappen behoren, worden vaak als lesbische vrouw geïdentificeerd."},{"@language":"sv","@value":"Sexuell läggning hos kvinnor och feminina personer som är romantiskt och/eller sexuellt attraherade av andra kvinnor och feminina personer. Alla som identifierar sig som lesbiska är dock inte kvinnor, och könsöverskridande personer i lesbiska gemenskaper har ofta identifierat sig som lesbiska."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001298"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000204"},{"@id":"https://homosaurus.org/v5/homoit0000556"},{"@id":"https://homosaurus.org/v5/homoit0000647"},{"@id":"https://homosaurus.org/v5/homoit0001669"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85076157"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001298"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianism"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000205","dc:identifier":"homoit0000205","skos:prefLabel":[{"@language":"bug","@value":"Bissu"},{"@language":"es","@value":"Bissu"},{"@language":"de","@value":"Bissu"},{"@language":"nl","@value":"Bissu"},{"@language":"sv","@value":"Bissu"}],"rdfs:comment":[{"@language":"en","@value":"Mentally and physically androgynous shamans in Bugis (Indonesia) culture."},{"@language":"es","@value":"Chamanes mental y físicamente andróginos en la cultura bugis (Indonesia)."},{"@language":"de","@value":"Geistig und körperlich androgyne Schamanen in der Kultur der Bugis (Indonesien)."},{"@language":"nl","@value":"Mentaal en fysiek androgyne sjamanen in de Bugis (Indonesië) cultuur"},{"@language":"sv","@value":"Shamaner inom bugis-kulturen i Indonesien som uppfattas som androgyna i både kropp och sinne."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000322"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bissu"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000206","dc:identifier":"homoit0000206","skos:prefLabel":[{"@language":"en","@value":"Biting (Erotic)"},{"@language":"es","@value":"Morder"},{"@language":"de","@value":"Beißen"},{"@language":"fr","@value":"Morsures"},{"@language":"nl","@value":"Bijten (Erotisch)"},{"@language":"sv","@value":"Bitning (sexualitet)"}],"skos:altLabel":{"@language":"sv","@value":"Bitsex"},"rdfs:comment":[{"@language":"en","@value":"Biting, or applying pressure with one's teeth, for the purposes of sexual arousal."},{"@language":"es","@value":"Morder o aplicar presión con los dientes con el fin de provocar excitación sexual."},{"@language":"de","@value":"Beißen oder Druckausübung mit den Zähnen zum Zweck der sexuellen Erregung."},{"@language":"fr","@value":"Pression exercée avec les dents, à des fins d'excitation sexuelle."},{"@language":"nl","@value":"Bijten, of druk uitoefenen met de tanden, met als doel seksuele opwinding."},{"@language":"sv","@value":"Att bita eller applicera tryck med tänderna i syfte att framkalla sexuell upphetsning."}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000206"},"dc:replaces":{"@id":"http://homosaurus.org/v2/biting"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000207","dc:identifier":"homoit0000207","skos:prefLabel":[{"@language":"zap","@value":"Biza'ah"},{"@language":"es","@value":"Biza'ah"},{"@language":"de","@value":"Biza'ah"},{"@language":"nl","@value":"Biza'ah"},{"@language":"sv","@value":"Biza'ah"}],"rdfs:comment":[{"@language":"en","@value":"Among the Zapotec in Teotitlán del Valle, Mexico, this term refers to people assigned male at birth who exhibit feminine characteristics."},{"@language":"es","@value":"Entre los zapotecas de Teotitlán del Valle, México, este término se refiere a personas asignadas al sexo masculino al nacer y que exhiben características femeninas."},{"@language":"de","@value":"Bei den Zapoteken in Teotitlán del Valle, Mexiko, bezieht sich dieser Begriff auf Menschen, die bei der Geburt als männlich eingestuft wurden und weibliche Merkmale aufweisen."},{"@language":"nl","@value":"Onder de Zapotec in Teotitlán del Valle, Mexico, verwijst deze term naar mensen die bij de geboorte als man zijn toegewezen en vrouwelijke kenmerken vertonen"},{"@language":"sv","@value":"Bland zapotekerna i Teotitlán del Valle, Mexiko, används denna term för personer som tilldelats manligt kön vid födseln och som uppvisar feminina egenskaper."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000322"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bizaah"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000477","dc:identifier":"homoit0000477","skos:prefLabel":[{"@language":"en","@value":"Black gay men"},{"@language":"es","@value":"Hombres gay negros"},{"@language":"de","@value":"Schwarze schwule Männer"},{"@language":"nl","@value":"Zwarte homomannen"},{"@language":"sv","@value":"Svarta bögar"}],"skos:altLabel":[{"@language":"en","@value":"Gay Black men"},{"@language":"es","@value":"Hombres negros gay"},{"@language":"de","@value":"Schwule schwarze Männer"}],"rdfs:comment":[{"@language":"en","@value":"Black men who are gay. Use only for individuals who self-identity as Black. Follow the individual’s preference for African American or Black whenever possible."},{"@language":"es","@value":"Hombres negros que son gay. Utilícese únicamente para personas que seautoidentificancomo negras. Siga la preferencia del individuo para el uso de afroamericanos o negros siempre que sea posible."},{"@language":"de","@value":"Schwarze Männer, die schwul oder homosexuell sind. Nur für Personen zu verwenden, die sich selbst als schwarz identifizieren. Nach Möglichkeit der Präferenz der Person für \"Afroamerikanisch\" oder \"Schwarz\" folgen."},{"@language":"nl","@value":"Zwarte personen die homo zijn. Alleen gebruiken voor personen die zichzelf als zwart identificeren. Volg waar mogelijk de voorkeur van de persoon voor een Afrikaanse diaspora-identiteit of een zwarte identiteit."},{"@language":"sv","@value":"Svarta män som är homosexuella. Används endast för individer som själva identifierar sig som svarta. Följ individens preferens för att använda svart eller diasporaidentitet som t.ex. afroeuropé när det är möjligt."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000208"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2004002160"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayBlackPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000726","dc:identifier":"homoit0000726","skos:prefLabel":[{"@language":"en","@value":"Black lesbians"},{"@language":"es","@value":"Lesbianas negras"},{"@language":"de","@value":"Schwarze Lesben"},{"@language":"nl","@value":"Zwarte lesbische vrouwen"},{"@language":"sv","@value":"Svarta lesbiska"}],"skos:altLabel":{"@language":"de","@value":"Lesbische schwarze Frauen"},"rdfs:comment":[{"@language":"en","@value":"Black people who are lesbians. Use only for individuals who self-identity as Black. Follow the individual’s preference for African American or Black whenever possible."},{"@language":"es","@value":"Personas negras que son lesbianas. Utilícese únicamente para personas que seautoidentificancomo negras. Siga la preferencia del individuo para el uso de afroamericanos o negros siempre que sea posible."},{"@language":"de","@value":"Schwarze Menschen, die lesbisch sind. Nur für Personen zu verwenden, die sich selbst als schwarz identifizieren. Nach Möglichkeit der Präferenz der Person für \"Afroamerikanisch\" oder \"Schwarz\" folgen."},{"@language":"nl","@value":"Zwarte personen die lesbisch zijn. Alleen gebruiken voor personen die zichzelf als zwart identificeren. Volg waar mogelijk de voorkeur van de persoon voor een Afrikaanse diaspora-identiteit of een zwarte identiteit."},{"@language":"sv","@value":"Svarta personer som är lesbiska. Används endast för individer som själva identifierar sig som svarta. Följ individens preferens för att använda svart eller diasporaidentitet som t.ex. afroeuropé när det är möjligt."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000208"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2013002418"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianBlackPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001163","dc:identifier":"homoit0001163","skos:prefLabel":[{"@language":"en","@value":"Black queer people"},{"@language":"es","@value":"Personas queer negras"},{"@language":"de","@value":"Schwarze queere Personen"},{"@language":"nl","@value":"Zwarte queer personen"},{"@language":"sv","@value":"Svarta queera personer"}],"skos:altLabel":[{"@language":"en","@value":"Queer Black people"},{"@language":"es","@value":"Personas negras queer"},{"@language":"de","@value":"Queere schwarze Personen"}],"rdfs:comment":[{"@language":"en","@value":"Black people who are queer. Use only for individuals who self-identity as Black. Follow the individual’s preference for African American or Black whenever possible."},{"@language":"es","@value":"Personas negras que son queer. Utilícese únicamente para personas que seautoidentificancomo negras. Siga la preferencia del individuo para el uso de afroamericanos o negros siempre que sea posible."},{"@language":"de","@value":"Schwarze Menschen, die queer sind. Nur für Personen zu verwenden, die sich selbst als schwarz identifizieren. Nach Möglichkeit der Präferenz der Person für \"Afroamerikanisch\" oder \"Schwarz\" folgen."},{"@language":"nl","@value":"Zwarte personen die queer zijn. Alleen gebruiken voor personen die zichzelf als zwart identificeren. Volg waar mogelijk de voorkeur van de persoon voor een Afrikaanse diaspora-identiteit of een zwarte identiteit."},{"@language":"sv","@value":"Svarta personer som är queera. Används endast för individer som själva identifierar sig som svarta. Följ individens preferens för att använda svart eller diasporaidentitet som t.ex. afroeuropé när det är möjligt."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000208"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0003608"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerBlackPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001396","dc:identifier":"homoit0001396","skos:prefLabel":[{"@language":"en","@value":"Black transgender people"},{"@language":"es","@value":"Personas transgénero negras"},{"@language":"de","@value":"Schwarze trans Personen"},{"@language":"nl","@value":"Zwarte transgender personen"},{"@language":"sv","@value":"Svarta transpersoner"}],"skos:altLabel":[{"@language":"en","@value":"Transgender Black people"},{"@language":"es","@value":"Personas negras transgénero"},{"@language":"de","@value":"Trans schwarze Personen"}],"rdfs:comment":[{"@language":"en","@value":"Black people who are transgender. Use only for individuals who self-identity as Black. Follow the individual’s preference for African American or Black whenever possible."},{"@language":"es","@value":"Personas negras que son queer. Utilícese únicamente para personas que seautoidentificancomo negras. Siga la preferencia del individuo para el uso de afroamericanos o negros siempre que sea posible."},{"@language":"de","@value":"Schwarze Menschen, die trans sind. Nur für Personen zu verwenden, die sich selbst als schwarz identifizieren. Nach Möglichkeit der Präferenz der Person für \"Afroamerikanisch\" oder \"Schwarz\" folgen."},{"@language":"nl","@value":"Zwarte personen die transgender zijn. Alleen gebruiken voor personen die zichzelf als zwart identificeren. Volg waar mogelijk de voorkeur van de persoon voor een Afrikaanse diaspora-identiteit of een zwarte identiteit."},{"@language":"sv","@value":"Svarta personer som är trans. Används endast för individer som själva identifierar sig som svarta. Följ individens preferens för att använda svart eller diasporaidentitet som t.ex. afroeuropé när det är möjligt."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000208"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0001384"},{"@id":"https://homosaurus.org/v5/homoit0001385"},{"@id":"https://homosaurus.org/v5/homoit0001386"},{"@id":"https://homosaurus.org/v5/homoit0001387"},{"@id":"https://homosaurus.org/v5/homoit0001388"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0002399"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transgenderBlackPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001782","dc:identifier":"homoit0001782","skos:prefLabel":[{"@language":"en","@value":"Blaqueer people"},{"@language":"es","@value":"Personas blaqueer"},{"@language":"de","@value":"Blaqueer Personen"},{"@language":"fr","@value":"Personnes blaqueers"},{"@language":"nl","@value":"Blaqueer personen"},{"@language":"sv","@value":"Blaqueer-personer"}],"skos:altLabel":[{"@language":"en","@value":"BlaQ people"},{"@language":"es","@value":"Personas Blaq"},{"@language":"es","@value":"Blaqueer"},{"@language":"de","@value":"Black \u0026 Queer-Personen"},{"@language":"de","@value":"BlaQ-Personen"},{"@language":"fr","@value":"BlaQ"},{"@language":"sv","@value":"BlaQ-personer"}],"rdfs:comment":[{"@language":"en","@value":"Black queer people who recognize their queer identity as salient to their Blackness and vice versa; only use to describe individuals who identify as Blaqueer or BlaQ."},{"@language":"es","@value":"Personas negras queer que reconocen su identidad queer como imprescindible para su negritud y viceversa; utilícese para describir a personas que se autoidentifican como Blaqueer o BlaQ."},{"@language":"de","@value":"Schwarze queere Menschen, die ihre queere Identität als wesentlich für ihre Schwarzheit erkennen und umgekehrt; wird nur verwendet, um Personen zu beschreiben, die sich als Blaqueer oder BlaQ identifizieren."},{"@language":"fr","@value":"Personnes noires queers qui reconnaissent que leur identité queer est liée à leur expérience d'être une personne noire et vice versa; à utiliser uniquement pour décrire les personnes qui s'identifient comme Blaqueers ou BlaQ."},{"@language":"nl","@value":"Zwarte queer personen die hun queer identiteit erkennen als saillant voor hun zwart zijn en vice versa; alleen gebruiken om personen te beschrijven die zich identificeren als Blaqueer of BlaQ"},{"@language":"sv","@value":"Svarta queera personer som ser sin queera identitet som en integrerad del av sin svarthet och vice versa. Används endast för att beskriva individer som identifierar sig som Blaqueer eller BlaQ."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000208"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2021-12-07"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002334","dc:identifier":"homoit0002334","skos:prefLabel":[{"@language":"en","@value":"Black asexual people"},{"@language":"es","@value":"Personas asexuales negras"},{"@language":"de","@value":"Schwarze asexuelle Personen"},{"@language":"nl","@value":"Zwarte aseksuele personen"},{"@language":"sv","@value":"Svarta asexuella personer"}],"skos:altLabel":[{"@language":"en","@value":"Asexual Black people"},{"@language":"en","@value":"Black ace people"},{"@language":"es","@value":"Personas negras asexuales"},{"@language":"es","@value":"Personas negras ace"},{"@language":"nl","@value":"Zwarte ace personen"}],"rdfs:comment":[{"@language":"en","@value":"Black people who are asexual. Use only for individuals who self-identity as Black. Follow the individual’s preference for African American or Black whenever possible."},{"@language":"es","@value":"Personas negras que son asexuales. Utilícese únicamente para personas que se autoidentifiquen como negras. Siga la preferencia de la persona sobre el uso de \"afroamericanos\" o \"negros\" siempre que sea posible."},{"@language":"de","@value":"Schwarze Menschen, die asexuell sind. Nur für Personen verwenden, die sich selbst als schwarz identifizieren. Nach Möglichkeit der Präferenz der Person für „Afroamerikaner” oder „schwarz” folgen."},{"@language":"nl","@value":"Zwarte personen die aseksueel zijn. Alleen gebruiken voor personen die zich als zwart identificeren. Volg waar mogelijk de voorkeur van de persoon voor een Afrikaanse diaspora-identiteit of een zwarte identiteit."},{"@language":"sv","@value":"Svarta personer som är asexuella. Används endast för individer som själva identifierar sig som svarta. Följ individens preferens för att använda svart eller diasporaidentitet som t.ex. afroeuropé när det är möjligt."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000208"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0002893"},{"@id":"https://homosaurus.org/v5/homoit0002894"},{"@id":"https://homosaurus.org/v5/homoit0002896"},{"@id":"https://homosaurus.org/v5/homoit0002898"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-12-13"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002764","dc:identifier":"homoit0002764","skos:prefLabel":[{"@language":"en","@value":"Black intersex people"},{"@language":"de","@value":"Schwarze inter* Personen"},{"@language":"es","@value":"Personas intersexuales negras"},{"@language":"nl","@value":"Zwarte intersekse personen"},{"@language":"sv","@value":"Svarta intersexpersoner"}],"skos:altLabel":[{"@language":"en","@value":"Intersex Black people"},{"@language":"de","@value":"Inter* schwarze Personen"},{"@language":"es","@value":"Personas negras intersex"},{"@language":"es","@value":"Personas intersex negras"}],"rdfs:comment":[{"@language":"en","@value":"Black people who are intersex. Use only for individuals who self-identity as Black. Follow the individual’s preference for African American or Black whenever possible."},{"@language":"de","@value":"Schwarze Menschen, die inter* sind. Nur für Personen zu verwenden, die sich selbst als schwarz identifizieren. Nach Möglichkeit der Präferenz der Person für \"Afroamerikanisch\" oder \"Schwarz\" folgen."},{"@language":"es","@value":"Personas negras que son intersexuales. Utilícese únicamente para personas que se autoidentificancomo negras. Siga la preferencia de la persona para el uso de afroamericanos o negros siempre que sea posible."},{"@language":"nl","@value":"Zwarte personen die intersekse zijn. Alleen gebruiken voor personen die zich als zwart identificeren. Volg waar mogelijk de voorkeur van de persoon voor een Afrikaanse diaspora-identiteit of een zwarte identiteit."},{"@language":"sv","@value":"Svarta personer som är intersexpersoner. Används endast för individer som själva identifierar sig som svarta. Följ individens preferens för att använda svart eller diasporaidentitet som t.ex. afroeuropé när det är möjligt."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000208"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0002957"},{"@id":"https://homosaurus.org/v5/homoit0002958"},{"@id":"https://homosaurus.org/v5/homoit0002959"},{"@id":"https://homosaurus.org/v5/homoit0002960"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-27"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003400","dc:identifier":"homoit0003400","skos:prefLabel":[{"@language":"en","@value":"Black non-binary people"},{"@language":"de","@value":"Schwarze nichtbinäre Personen"},{"@language":"es","@value":"Personas no binarixs negras"},{"@language":"nl","@value":"Zwarte non-binaire personen"},{"@language":"sv","@value":"Svarta ickebinära"}],"skos:altLabel":[{"@language":"en","@value":"Black nonbinary people"},{"@language":"en","@value":"Non-binary Black people"},{"@language":"en","@value":"Nonbinary Black people"},{"@language":"de","@value":"Schwarze nicht-binäre Personen"},{"@language":"de","@value":"Schwarze non-binäre Personen"},{"@language":"de","@value":"Non-binäre schwarze Personen"},{"@language":"de","@value":"Nichtbinäre schwarze Personen"},{"@language":"de","@value":"Nicht-binäre schwarze Personen"},{"@language":"es","@value":"Personas negras no binarias"},{"@language":"es","@value":"No binarixs negrxs"},{"@language":"es","@value":"Negrxs no binarixs"},{"@language":"nl","@value":"Nonbinaire zwarte personen"},{"@language":"nl","@value":"Zwarte nonbinaire personen"}],"rdfs:comment":[{"@language":"en","@value":"Black people who are non-binary. Use only for individuals who self-identity as Black. Follow the individual’s preference for African American or Black whenever possible."},{"@language":"de","@value":"Schwarze Menschen, die nichtbinär sind. Nur für Personen zu verwenden, die sich selbst als schwarz identifizieren. Nach Möglichkeit der Präferenz der Person für \"Afroamerikanisch\" oder \"Schwarz\" folgen."},{"@language":"es","@value":"Personas negras que son no binarias. Utilícese únicamente para personas que se autoidentifican como negrxs. Siga la preferencia por \"afroamericanxs\" o \"negrxs\" siempre que sea posible."},{"@language":"nl","@value":"Zwarte personen die non-binair zijn. Gebruik alleen voor personen die zichzelf identificeren als zwart. Volg waar mogelijk de voorkeur van de persoon voor een Afrikaanse diaspora-identiteit of een zwarte identiteit."},{"@language":"sv","@value":"Svarta personer som är ickebinära. Används endast för individer som själva identifierar sig som svarta. Följ individens preferens för att använda svart eller diasporaidentitet som t.ex. afroeuropé när det är möjligt."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000208"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2024-07-11"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001928","dc:identifier":"homoit0001928","skos:prefLabel":[{"@language":"en","@value":"BIPOC"},{"@language":"es","@value":"BIPOC"},{"@language":"de","@value":"BIPoC"},{"@language":"fr","@value":"PANDC"},{"@language":"nl","@value":"BIPOC"},{"@language":"sv","@value":"BIPOC"}],"skos:altLabel":[{"@language":"en","@value":"Black, Indigenous, and people of color"},{"@language":"en","@value":"Black, Indigenous, and people of colour"},{"@language":"es","@value":"Personas negras, indígenas y de color"},{"@language":"de","@value":"Schwarze, Indigene und People of Color"},{"@language":"fr","@value":"BIPOC"},{"@language":"fr","@value":"Personnes autochtones"},{"@language":"nl","@value":"Black, Indigenous, and people of colour"},{"@language":"nl","@value":"Black, Indigenous, en personen van kleur"}],"rdfs:comment":[{"@language":"en","@value":"Acronym primarily used in the United States to describe Black, Indigenous, and people of color as a group, while also centering the specific experiences of Black and Indigenous people."},{"@language":"es","@value":"Acrónimo utilizado principalmente en los Estados Unidos para describir a personas negras, indígenas y de color como grupo, centrando, a la vez, en las experiencias específicas de las personas negras e indígenas."},{"@language":"de","@value":"Akronym, das vor allem in den Vereinigten Staaten verwendet wird, um Schwarze, Indigene und People of Color als Gruppe zu bezeichnen, wobei auch die spezifischen Erfahrungen Schwarzer und indigener Menschen im Mittelpunkt stehen."},{"@language":"fr","@value":"Sigle signifiant personnes autochtones, noires et de couleur."},{"@language":"nl","@value":"Acroniem dat voornamelijk in de Verenigde Staten wordt gebruikt om zwarte, inheemse en gekleurde personen als een groep te beschrijven, terwijl het ook de specifieke ervaringen van zwarte en inheemse personen centraal stelt."},{"@language":"sv","@value":"Akronym som främst används i USA för att beskriva svarta, urfolk och icke-vita/people of color som en grupp, samtidigt som den betonar de specifika erfarenheterna hos svarta och urfolk."}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000208"},{"@id":"https://homosaurus.org/v5/homoit0001101"},{"@id":"https://homosaurus.org/v5/homoit0002273"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001928"},"dc:issued":{"@type":"xsd:date","@value":"2022-04-18"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002376","dc:identifier":"homoit0002376","skos:prefLabel":[{"@language":"en","@value":"Police harassment of Black LGBTQ+ people"},{"@language":"es","@value":"Acoso policial a personas LGBTQ+ negras"},{"@language":"nl","@value":"Intimidatie door de politie van zwarte LHBTQ+-personen"},{"@language":"sv","@value":"Polistrakasserier mot svart hbtq+-personer"}],"skos:altLabel":[{"@language":"es","@value":"Maltrato hacia personas LGBTQ+ negras por la policía"},{"@language":"es","@value":"Acoso de personas LGBTQ+ negras por la policía"},{"@language":"es","@value":"Brutalidad policial hacia personas LGBTQ+ negras"},{"@language":"es","@value":"Mala conducta policial hacia personas LGBTQ+ negras"},{"@language":"es","@value":"Maltrato policial contra personas LGBTQ+ negras"},{"@language":"es","@value":"Hostigamiento policial a personas LGBTQ+ negras"}],"rdfs:comment":[{"@language":"en","@value":"Any of various forms of inappropriate conduct, illegal actions, or abuses of power undertaken by law enforcement agents or agents of the state against Black LGBTQ+ members of the public. This includes but is not limited to racial, ethnic, and other forms of profiling; unwarranted surveillance, searches, and seizure; selective enforcement; excessive use of force; sexual misconduct; intimidation and witness tampering; falsification of evidence; coerced confessions; false arrests and imprisonment; and bribing or lobbying."},{"@language":"es","@value":"Cualquiera de las diversas formas de conducta inapropiada, acciones ilegales o abusos de poder que violentan directa o indirectamente a las personas LGBTQ+ negras, incluidas, entre otras, confesiones forzadas, intimidación, arrestos y encarcelamientos falsos, falsificación de pruebas, perjurio policial, manipulación de testigos, brutalidad y corrupción policial, elaboración de caracterizaciones raciales, étnicos y de otro tipo, vigilancia injustificada, registros o incautación de propiedad, soborno o cabildeo para obtener poder o estatus excesivo o para evitar consecuencias, aplicación selectiva de la ley y conducta sexual inapropiada."},{"@language":"nl","@value":"Alle vormen van ongepast gedrag, illegale acties of machtsmisbruik die direct of indirect schade toebrengen aan zwarte LHBTQ+-personen."},{"@language":"sv","@value":"Olämpligt uppförande, olagliga handlingar eller maktmissbruk från polis gentemot svarta hbtq+-personer. Det kan inkludera rasprofilering, övervakning utan grund, olagliga husrannsakningar och beslag, selektiv rättstillämpning, övervåld, sexuella övergrepp, hot, bevisförfalskning, tvingade erkännanden, felaktiga gripanden eller fängslanden samt mutor eller otillbörlig påverkan."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002375"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000208"},{"@id":"https://homosaurus.org/v5/homoit0002257"},{"@id":"https://homosaurus.org/v5/homoit0002397"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000611"},"dc:issued":{"@type":"xsd:date","@value":"2023-01-13"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002398","dc:identifier":"homoit0002398","skos:prefLabel":[{"@language":"en","@value":"Black Lives Matter movement "},{"@language":"es","@value":"Movimiento Black Lives Matter"},{"@language":"de","@value":"Black Lives Matter-Bewegung"},{"@language":"nl","@value":"Black Lives Matter-beweging"},{"@language":"sv","@value":"Black Lives Matter-rörelsen"}],"skos:altLabel":[{"@language":"en","@value":"BLM"},{"@language":"en","@value":"Black Lives Matter"},{"@language":"en","@value":"BlackLivesMatter"},{"@language":"en","@value":"Movement for Black Lives"},{"@language":"es","@value":"BLM"},{"@language":"es","@value":"Black Lives Matter"},{"@language":"es","@value":"Movimiento BLM"},{"@language":"es","@value":"Movimiento por las vidas negras"},{"@language":"es","@value":"Movimiento Las Vidas Negras Importan"},{"@language":"de","@value":"Black Lives Matter"},{"@language":"de","@value":"BLM-Bewegung"},{"@language":"nl","@value":"BLM"}],"rdfs:comment":[{"@language":"en","@value":"A primarily U.S. American and Canadian decentralized political and social movement advocating for non-violent civil disobedience in protest against incidents of police brutality and all racially motivated violence against Black people. The broader movement and its related organizations typically advocate against police violence towards Black people, as well as for various other policy changes considered to be related to Black liberation."},{"@language":"es","@value":"Un movimiento político y social descentralizado principalmente estadounidense y canadiense que aboga por la desobediencia civil no-violenta como protesta contra incidentes de brutalidad policial y toda violencia por motivos raciales contra las personas negras. El movimiento más amplio y sus respectivas organizaciones suelen abogar contra la violencia policial hacia las personas negras, así como a favor de otros cambios de políticas que se consideran relacionados con la liberación negra."},{"@language":"de","@value":"Eine vor allem in den USA und Kanada verbreitete dezentrale politische und soziale Bewegung, die sich für gewaltfreien zivilen Ungehorsam einsetzt, um gegen Polizeibrutalität und alle rassistisch motivierten Gewalttaten gegen schwarze Menschen zu protestieren. Die breitere Bewegung und die mit ihr verbundenen Organisationen setzen sich in der Regel gegen Polizeigewalt gegenüber Schwarzen sowie für verschiedene andere politische Veränderungen ein, die als für die Befreiung schwarzer Menschen relevant angesehen werden."},{"@language":"nl","@value":"Een voornamelijk Amerikaanse en Canadese decentrale politieke en sociale beweging die pleit voor geweldloze burgerlijke ongehoorzaamheid als protest tegen incidenten van politiegeweld en racistisch gemotiveerde geweld tegen zwarte mensen. De bredere beweging en verwante organisaties vechten meestal tegen politiegeweld tegen zwarte mensen, alsook voor verschillende andere beleidwijzigingen die worden beschouwd als onderdeel van de zwarte bevrijding."},{"@language":"sv","@value":"En decentraliserad politisk och social rörelse, främst i USA och Kanada, som förespråkar civil olydnad i protest mot polisbrutalitet och allt rasistiskt våld riktat mot svarta personer. Rörelsen och dess relaterade organisationer verkar vanligtvis mot polisvåld mot svarta personer samt för policyförändringar som anses kopplade till svart frigörelse."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001322"},"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0002399"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000208"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2016001442"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001322"},"dc:issued":{"@type":"xsd:date","@value":"2023-01-13"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002399","dc:identifier":"homoit0002399","skos:prefLabel":[{"@language":"en","@value":"Black Trans Lives Matter movement "},{"@language":"es","@value":"Movimiento Black Trans Lives Matter"},{"@language":"de","@value":"Black Trans Lives Matter-Bewegung"},{"@language":"nl","@value":"Black Trans Lives Matter-beweging"},{"@language":"sv","@value":"Black Trans Lives Matter-rörelsen"}],"skos:altLabel":[{"@language":"en","@value":"BTLM Movement"},{"@language":"en","@value":"BTLM"},{"@language":"es","@value":"BTLM"},{"@language":"es","@value":"Movimiento BTLM"},{"@language":"de","@value":"Black Trans Lives Matter"},{"@language":"de","@value":"BTLM"}],"rdfs:comment":[{"@language":"en","@value":"A part of the Black Lives Matter movement which specifically advocates for Black trans people (especially Black trans women) and fights for racial equity and Black liberation."},{"@language":"es","@value":"Una parte del movimiento Black Lives Matter (Las Vidas Negras Importan en inglés) que aboga específicamente por las personas trans negras (especialmente las mujeres trans negras) y lucha por la equidad racial y la liberación negra."},{"@language":"de","@value":"Ein Teil der Black Lives Matter-Bewegung, der sich speziell für schwarze trans Personen (insbesondere schwarze trans Frauen) einsetzt und für Rassengleichheit und die Befreiung schwarzer Menschen kämpft."},{"@language":"nl","@value":"Een onderdeel van de Black Lives Matter-beweging dat specifiek opkomt voor zwarte transpersonen (vooral zwarte transvrouwen) en vecht voor raciale gelijkheid en zwarte bevrijding."},{"@language":"sv","@value":"En del av Black Lives Matter-rörelsen som specifikt förespråkar rättigheter för svarta transpersoner (särskilt svarta transkvinnor) och kämpar mot rasism och för svart frigörelse."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002398"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000208"},{"@id":"https://homosaurus.org/v5/homoit0001396"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001322"},"dc:issued":{"@type":"xsd:date","@value":"2023-01-13"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000209","dc:identifier":"homoit0000209","skos:prefLabel":[{"@language":"en","@value":"Blindfolds"},{"@language":"de","@value":"Augenbinden"},{"@language":"es","@value":"Vendas para los ojos"},{"@language":"nl","@value":"Blinddoeken"},{"@language":"sv","@value":"Ögonbindlar"}],"skos:altLabel":{"@language":"es","@value":"Vendas"},"rdfs:comment":[{"@language":"en","@value":"An accessory used to cover the eyes, traditionally a piece of cloth tied around one’s head to eliminate or limit vision."},{"@language":"de","@value":"Ein Accessoire, das zum Bedecken der Augen verwendet wird, traditionell ein Stück Stoff, das um den Kopf gebunden wird, um die Sicht zu verhindern oder einzuschränken."},{"@language":"es","@value":"Trozos de tela o material similar utilizados para cubrir los ojos de una persona y perjudicar su visión, a menudo para estimulación sexual."},{"@language":"nl","@value":"Een stuk stof of soortgelijk materiaal dat wordt gebruikt om de ogen van een persoon te bedekken en hun gezichtsvermogen te belemmeren, vaak voor seksuele stimulatie"},{"@language":"sv","@value":"Ett tillbehör som används för att täcka ögonen, traditionellt en tygbit som knyts runt huvudet för att begränsa eller ta bort synförmågan."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001266"},{"@id":"https://homosaurus.org/v5/homoit0003059"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0003146"},{"@id":"https://homosaurus.org/v5/homoit0003850"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2003009027"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001266"},"dc:replaces":{"@id":"http://homosaurus.org/v2/blindfolds"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003850","dc:identifier":"homoit0003850","skos:prefLabel":[{"@language":"en","@value":"Sensory deprivation (Erotic)"},{"@language":"nl","@value":"Sensorische deprivatie (Erotisch)"},{"@language":"sv","@value":"Sensory deprivation (erotik)"}],"skos:altLabel":[{"@language":"en","@value":"Sensory isolation (Erotic)"},{"@language":"en","@value":"Stimulus deprivation (Erotic)"},{"@language":"nl","@value":"Stimulus deprivatie (Erotisch)"},{"@language":"sv","@value":"Sensorisk deprivation (erotik)"}],"rdfs:comment":[{"@language":"en","@value":"Stifling of one or more physical senses with the use of blindfolds, ear plugs, hoods, or bondage for erotic or sensual pleasure."},{"@language":"nl","@value":"Het onderdrukken van een of meerdere zintuigen door middel van blinddoeken, oordopjes, kappen of bondage, voor erotisch of sensueel genot."},{"@language":"sv","@value":"Att begränsa ett eller flera av kroppens sinnen genom användning av ögonbindel, öronproppar, huva eller bondage i syfte att uppnå erotisk eller sensuell njutning."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000442"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0003134"},{"@id":"https://homosaurus.org/v5/homoit0000209"},{"@id":"https://homosaurus.org/v5/homoit0003146"},{"@id":"https://homosaurus.org/v5/homoit0003071"}],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85120053"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000404"},"dc:issued":{"@type":"xsd:date","@value":"2025-01-09"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000211","dc:identifier":"homoit0000211","skos:prefLabel":[{"@language":"en","@value":"Vampirism (Erotic)"},{"@language":"es","@value":"Vampirismo (sexo)"},{"@language":"nl","@value":"Vampirisme (Erotisch)"},{"@language":"sv","@value":"Vampyrism (sexualitet)"}],"skos:altLabel":[{"@language":"en","@value":"Blood sports"},{"@language":"en","@value":"Vampire sex"},{"@language":"es","@value":"Blood sports"},{"@language":"es","@value":"Sexo vampiresco"},{"@language":"sv","@value":"Vampyrsex"}],"rdfs:comment":[{"@language":"en","@value":"Sexual practices or fetishes centering around the \"vampire lifestyle\"; can be a subset of BDSM communities and include roleplay, the consumption of blood, etc. "},{"@language":"es","@value":"Prácticas sexuales o fetiches centrados en el \"estilo de vida vampírico\"; puede ser un subconjunto de comunidades BDSM e incluir juegos de roles, consumo de sangre, etc."},{"@language":"nl","@value":"Seksuele praktijken of fetisjen rond de \"vampierlevensstijl\"; kan een subset zijn van BDSM-gemeenschappen en omvat rollenspellen, de consumptie van bloed, enz."},{"@language":"sv","@value":"Sexuella praktiker med koppling till en så kallad vampyrlivsstil. Kan utgöra en del av BDSM-gemenskaper och inkludera rollspel, blodkonsumtion med mera."}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000211"},"dc:replaces":{"@id":"http://homosaurus.org/v2/vampirism"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000212","dc:identifier":"homoit0000212","skos:prefLabel":[{"@language":"en","@value":"Fellat