nsvar."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000297"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000297"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQCommunes"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001170","dc:identifier":"homoit0001170","skos:prefLabel":[{"@language":"en","@value":"Queer community"},{"@language":"es","@value":"Comunidad queer"},{"@language":"fr","@value":"Communauté queer"},{"@language":"nl","@value":"Queer gemeenschap"},{"@language":"sv","@value":"Queera gemenskaper"}],"skos:altLabel":{"@language":"sv","@value":"Queercommunityn"},"rdfs:comment":[{"@language":"en","@value":"Groups of people who share the experience of being queer."},{"@language":"es","@value":"Grupos de personas que comparten la experiencia de ser queer."},{"@language":"fr","@value":"Groupes de personnes qui partagent l'expérience d'être queer."},{"@language":"nl","@value":"Groepen mensen die de ervaring van het queer-zijn delen."},{"@language":"sv","@value":"Grupper av personer som delar erfarenheten av att vara queer."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000297"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000806"},{"@id":"https://homosaurus.org/v5/homoit0000807"},{"@id":"https://homosaurus.org/v5/homoit0000882"},{"@id":"https://homosaurus.org/v5/homoit0001161"},{"@id":"https://homosaurus.org/v5/homoit0001789"},{"@id":"https://homosaurus.org/v5/homoit0003193"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000297"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerCommunity"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"}