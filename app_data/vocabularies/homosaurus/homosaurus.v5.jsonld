5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001087","dc:identifier":"homoit0001087","skos:prefLabel":[{"@language":"en","@value":"Partners of lesbians"},{"@language":"es","@value":"Parejas de lesbianas"},{"@language":"fr","@value":"Partenaires de personnes lesbiennes"},{"@language":"nl","@value":"Partners van lesbische vrouwen"},{"@language":"sv","@value":"Partners till lesbiska"}],"rdfs:comment":[{"@language":"en","@value":"People whose sexual, romantic, or play partner is a lesbian."},{"@language":"es","@value":"Personas cuya pareja sexual, romántica o de juego es lesbiana."},{"@language":"fr","@value":"Personnes dont le ou la partenaire sexuel·le, romantique ou de jeu est une personne lesbienne."},{"@language":"nl","@value":"Seksuele, romantische of speelpartners van lesbische vrouwen."},{"@language":"sv","@value":"Personer som har en romantisk, sexuell eller kinkbaserad relation med en lesbisk person."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002366"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0002365"},"dc:replaces":{"@id":"http://homosaurus.org/v2/partnersOfLesbians"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001088","dc:identifier":"homoit0001088","skos:prefLabel":[{"@language":"en","@value":"Partners of queer people"},{"@language":"es","@value":"Parejas de personas queer"},{"@language":"fr","@value":"Partenaires de personnes queers"},{"@language":"nl","@value":"Partners van queer personen"},{"@language":"sv","@value":"Partners till queera personer"}],"rdfs:comment":[{"@language":"en","@value":"People whose sexual, romantic, or play partner is queer."},{"@language":"es","@value":"Personas cuya pareja sexual, romántica o de juego es queer."},{"@language":"fr","@value":"Personnes dont le ou la partenaire sexuel·le, romantique ou de jeu est une personne queer."},{"@language":"nl","@value":"Individuen wiens romantische, seksuele of speelpartners queer zijn."},{"@language":"sv","@value":"Personer som har en romantisk, sexuell eller kinkbaserad relation med en queer person."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002366"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0002365"},"dc:replaces":{"@id":"http://homosaurus.org/v2/partnersOfQueerPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001089","dc:identifier":"homoit0001089","skos:prefLabel":[{"@language":"en","@value":"Partners of transgender people"},{"@language":"es","@value":"Parejas de personas transgénero"},{"@language":"fr","@value":"Partenaires de personnes trans"},{"@language":"nl","@value":"Partners van transgender personen"},{"@language":"sv","@value":"Partners till transpersoner"}],"rdfs:comment":[{"@language":"en","@value":"People whose sexual, romantic, or play partner is transgender."},{"@language":"es","@value":"Personas cuya pareja sexual, romántica o de juego es transgénero."},{"@language":"fr","@value":"Personnes dont le ou la partenaire sexuel·le, romantique ou de jeu est une personne trans."},{"@language":"nl","@value":"Individuen wiens romantische, seksuele of speelpartners transgender zijn."},{"@language":"sv","@value":"Personer som har en romantisk, sexuell eller kinkbaserad relation med en transperson."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002366"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001378"},{"@id":"https://homosaurus.org/v5/homoit0001780"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0002365"},"dc:replaces":{"@id":"http://homosaurus.org/v2/partnersOfTransgenderPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001780","dc:identifier":"homoit0001780","skos:prefLabel":[{"@language":"en","@value":"t4t"},{"@language":"es","@value":"t4t"},{"@language":"nl","@value":"T4T (Trans voor Trans)"},{"@language":"sv","@value":"t4t"}],"skos:altLabel":[{"@language":"en","@value":"T4T (Trans for Trans)"},{"@language":"en","@value":"TFT"},{"@language":"en","@value":"Trans4Trans"},{"@language":"en","@value":"tft"},{"@language":"es","@value":"T4T"},{"@language":"es","@value":"Trans for trans"},{"@language":"nl","@value":"Trans4Trans"}],"rdfs:comment":[{"@language":"en","@value":"Abbreviated form of the phrase \"trans for trans,\" a label used to describe trans people who prioritize engaging in romantic, sexual, or other relationships with other trans people."},{"@language":"es","@value":"Forma abreviada de la frase en inglés \"trans for trans\", traducida como \"trans para trans\", una etiqueta utilizada para describir a las personas trans que priorizan entablar relaciones románticas, sexuales o de otro tipo con otras personas trans."},{"@language":"nl","@value":"Een term die wordt gebruikt om transgenders te beschrijven die een voorkeur hebben voor het aangaan van romantische, seksuele of andere relaties met andere transgenders"},{"@language":"sv","@value":"Förkortning av uttrycket ”trans for trans”, en benämning på transpersoner som prioriterar romantiska, sexuella eller andra relationer med andra transpersoner."}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001089"},{"@id":"https://homosaurus.org/v5/homoit0001378"},{"@id":"https://homosaurus.org/v5/homoit0001403"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001780"},"dc:issued":{"@type":"xsd:date","@value":"2021-12-07"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001901","dc:identifier":"homoit0001901","skos:prefLabel":[{"@language":"en","@value":"Passing (Sexuality)"},{"@language":"es","@value":"Pasar (sexualidad)"},{"@language":"sv","@value":"Passera (sexualitet)"}],"skos:altLabel":[{"@language":"en","@value":"Passing (Sexual identity)"},{"@language":"en","@value":"Passing (Sexual orientation)"},{"@language":"es","@value":"Pasando"},{"@language":"es","@value":"Pasar desapercibido"}],"rdfs:comment":[{"@language":"en","@value":"The ability of a person who is not heterosexual to \"pass,\" or be accepted or regarded as heterosexual by others. \"Passing\" has historically been used to describe an individual's ability to \"pass\" as a certain race or ethnicity, though the term was later appropriated by the LGBTQ+ community."},{"@language":"es","@value":"La capacidad de una persona que no es heterosexual de \"pasar\", ser aceptada o considerada heterosexual por otras personas. \"Pasar\" se ha utilizado históricamente para describir la capacidad de una persona de \"pasar\" como una determinada raza o etnia, aunque eventualmente la comunidad LGBTQ+ se apropió del término."},{"@language":"sv","@value":"En icke-heterosexuell persons förmåga att ”passera”, det vill säga att bli uppfattad som heterosexuell av omgivningen. Begreppet har historiskt använts om ras och etnicitet men används numera också inom hbtq+-sammanhang."}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001090"},{"@id":"https://homosaurus.org/v5/homoit0001295"},{"@id":"https://homosaurus.org/v5/homoit0001306"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001901"},"dc:issued":{"@type":"xsd:date","@value":"2022-02-28"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001098","dc:identifier":"homoit0001098","skos:prefLabel":[{"@language":"en","@value":"Penile plethysmography"},{"@language":"es","@value":"Pletismografía peneana"},{"@language":"nl","@value":"Fallometrie"},{"@language":"sv","@value":"Pletysmografi av penis"}],"skos:altLabel":[{"@language":"en","@value":"Penile response measurement"},{"@language":"en","@value":"Phallometry"},{"@language":"sv","@value":"Penispletysmografi"},{"@language":"sv","@value":"Falloplethysmografi"}],"rdfs:comment":[{"@language":"en","@value":"Assessments of penile tumescence in response to erotic stimuli in order to test an individual's sexual preference or excitement."},{"@language":"es","@value":"Evaluaciones de la tumescencia del pene en respuesta a estímulos eróticos para probar la preferencia o excitación sexual de una persona."},{"@language":"nl","@value":"peniszwellingsmeting in reactie op erotische stimuli om seksuele voorkeuren vast te stellen"},{"@language":"sv","@value":"Mätning av penisens svällnad vid erotisk stimulans, i syfte att undersöka sexuell respons eller preferens."}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001099"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001098"},"dc:replaces":{"@id":"http://homosaurus.org/v2/penilePlethysmography"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001196","dc:identifier":"homoit0001196","skos:prefLabel":[{"@language":"en","@value":"Queer people in the military"},{"@language":"es","@value":"Personas queer en el ejército"},{"@language":"de","@value":"Queere Armeeangehörige"},{"@language":"nl","@value":"Queer militair personeel"},{"@language":"sv","@value":"Queera personer inom militären"}],"skos:altLabel":[{"@language"