rat."},{"@language":"nl","@value":"LHBTQ+-personen die wonen in of afstammen van de inheemse bevolking van de Indiase deelstaat Gujarat"},{"@language":"sv","@value":"Hbtq+-personer som bor i eller härstammar från ursprungsbefolkningen i den indiska delstaten Gujarat."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000860"},{"@id":"https://homosaurus.org/v5/homoit0001101"}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0002232"},{"@id":"https://homosaurus.org/v5/homoit0002233"},{"@id":"https://homosaurus.org/v5/homoit0002234"},{"@id":"https://homosaurus.org/v5/homoit0002235"},{"@id":"https://homosaurus.org/v5/homoit0002236"},{"@id":"https://homosaurus.org/v5/homoit0002237"},{"@id":"https://homosaurus.org/v5/homoit0002238"},{"@id":"https://homosaurus.org/v5/homoit0003408"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-20"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002239","dc:identifier":"homoit0002239","skos:prefLabel":[{"@language":"en","@value":"Haryanvi LGBTQ+ people"},{"@language":"es","@value":"Personas LGBTQ+ haryanvi"},{"@language":"nl","@value":"Haryanvi LHBTQ+-personen"},{"@language":"sv","@value":"Haryanvi (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"Haryanvi people (LGBTQ)"},{"@language":"en","@value":"Haryanvis (LGBTQ)"},{"@language":"en","@value":"LGBTQ+ Haryanvi people"},{"@language":"en","@value":"LGBTQ+ Haryanvis"},{"@language":"es","@value":"Personas haryanvi LGBTQ+"},{"@language":"nl","@value":"LHBTQ+ Haryanvi's"}],"rdfs:comment":[{"@language":"en","@value":"LGBTQ+ people who are indigenous to or descended from those indigenous to what is now the Indian state of Haryana. This term can also apply to those who currently reside in Haryana."},{"@language":"es","@value":"Personas LGB