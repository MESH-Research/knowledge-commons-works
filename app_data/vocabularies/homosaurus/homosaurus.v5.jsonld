nguage":"sv","@value":"Asexuella muslimer"}],"skos:altLabel":[{"@language":"de","@value":"Muslimische Asexuelle"},{"@language":"de","@value":"Ace Muslim:innen"},{"@language":"de","@value":"Asexuelle Muslim:innen"},{"@language":"de","@value":"Asexuelle Personen muslimischen Glaubens"},{"@language":"de","@value":"Ace Personen muslimischen Glaubens"}],"rdfs:comment":[{"@language":"en","@value":"Asexual people who are Muslim."},{"@language":"es","@value":"Personas asexuales que son musulmanas."},{"@language":"de","@value":"Asexuelle Personen, die muslimischen Glaubens sind."},{"@language":"nl","@value":"Biseksuele personen die moslim zijn"},{"@language":"sv","@value":"Asexuella personer som är muslimer."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001032"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000928"},"dc:issued":{"@type":"xsd:date","@value":"2023-10-27"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001190","dc:identifier":"homoit0001190","skos:prefLabel":[{"@language":"en","@value":"Native American queer people"},{"@language":"es","@value":"Personas queer nativoamericanas"},{"@language":"nl","@value":"Indiaans-Amerikaanse queer personen"},{"@language":"sv","@value":"Queera ursprungsamerikaner"}],"skos:altLabel":[{"@language":"en","@value":"American Indian queer people"},{"@language":"en","@value":"Queer American Indians"},{"@language":"en","@value":"Queer Native Americans"},{"@language":"es","@value":"Personas nativoamericanas queer"},{"@language":"nl","@value":"Queer Amerikaanse Indianen"},{"@language":"nl","@value":"Queer Native Americans"}],"rdfs:comment":[{"@language":"en","@value":"People who are part of the Native peoples of the continental United States and Canada (excluding Inuit people) and self-identity as queer. Use more specific terms when available."},{"@language":"es","@value":"Personas queer que son nativoamericanas o parte de los pueblos indígenas de Norteamérica; utilícese únicamente para personas que se autoidentifiquen como nativoamericanas y queer."},{"@language":"nl","@value":"Queer personen die Native American zijn, of deel uitmaken van de inheemse volkeren van Noord-Amerika; alleen gebruiken voor personen die zichzelf identificeren als Native American en queer."},{"@language":"sv","@value":"Personer som tillhör ursprungsfolken i det kontinentala USA och Kanada (exklusive inuiter) och som identifierar sig som queera. Använd mer specifika termer där det är möjligt."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001037"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerNativeAmericans"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001426","dc:identifier":"homoit0001426","skos:prefLabel":[{"@language":"en","@value":"Native American transgender people"},{"@language":"es","@value":"Personas transgénero nativoamericanas"},{"@language":"nl","@value":"Indiaans-Amerikaanse transgender personen"},{"@language":"sv","@value":"Transpersoner som är ursprungsamerikaner"}],"skos:altLabel":[{"@language":"en","@value":"American Indian transgender people"},{"@language":"en","@value":"Transgender American Indians"},{"@language":"en","@value":"Transgender Native Americans"},{"@language":"es","@value":"Personas nativoamericanas transgénero"},{"@language":"nl","@value":"Transgender Amerikaanse Indianen"},{"@language":"nl","@value":"Transgender Native Americans"}],"rdfs:comment":[{"@language":"en","@value":"People who are part of the Native peoples of the continental United States and Canada (excluding Inuit people) and self-identity as transgender. Use more specific terms when available."},{"@language":"es","@value":"Personas transgénero que son nativoamericanas o parte de los pueblos indígenas de Norteamérica; utilícese únicamente para personas que se autoidentifiquen como nativoamericanas y transgénero."},{"@language":"nl","@value":"Transgender personen die Native American zijn, of deel uitmaken van de inheemse volkeren van Noord-Amerika; alleen gebruiken voor personen die zichzelf identificeren als Native American en transgender."},{"@language":"sv","@value":"Personer som tillhör ursprungsfolken i det kontinentala USA och Kanada (exklusive inuiter) och som identifierar sig som transpersoner. Använd mer specifika termer där det är möjligt."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001037"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transgenderNativeAmericans"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002925","dc:identifier":"homoit0002925","skos:prefLabel":[{"@language":"en","@value":"Native American asexual people"},{"@language":"es","@value":"Personas asexuales nativoamericanas"},{"@language":"nl","@value":"Indiaans-Amerikaanse aseksuele personen"},{"@language":"sv","@value":"Asexuella ursprungsamerikaner"}],"skos:altLabel":[{"@language":"en","@value":"American Indian asexual people"},{"@language":"en","@value":"Asexual American Indians"},{"@language":"en","@value":"Asexual Native Americans"},{"@language":"es","@value":"Personas nativoamericanas asexuales"},{"@language":"nl","@value":"Aseksuele Native Amerikanen"},{"@language":"nl","@value":"Native American aseksuele personen"}],"rdfs:comment":[{"@language":"en","@value":"People who are part of the Native peoples of the continental United States and Canada (excluding Inuit people) and self-identity as asexual. Use more specific terms when available."},{"@language":"es","@value":"Personas asexuales que son nativoamericanas o parte de los pueblos indígenas de Norteamérica; utilícese únicamente para personas que se autoidentifiquen como nativoamericanas y asexuales."},{"@language":"nl","@value":"Aseksuele personen die Indiaans-Amerikaans zijn, of deel uitmaken van de inheemse volkeren van Noord-Amerika; alleen gebruiken voor personen die zichzelf identificeren als zowel Indiaans-Amerikaans als aseksueel."},{"@language":"sv","@value":"Personer som tillhör ursprungsfolken i det kontinentala USA och Kanada (exklusive inuiter) och som identifierar sig som asexuella. Använd mer specifika termer där det är möjligt."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001037"},{"@id":"https://homosaurus.org/v5/homoit0002922"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-30"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002964","dc:identifier":"homoit0002964","skos:prefLabel":[{"@language":"en","@value":"Native American intersex people"},{"@language":"es","@value":"Personas intersexuales nativoamericanas"},{"@language":"nl","@value":"Indiaans-Amerikaanse intersekse personen"},{"@language":"sv","@value":"Intersexpersoner som är ursprungsamerikaner"}],"skos:altLabel":[{"@language":"en","@value":"American Indian intersex people"},{"@language":"en","@value":"Intersex American Indians"},{"@language":"en","@value":"Intersex Native Americans"},{"@language":"es","@value":"Personas intersex nativoamericanas"},{"@language":"es","@value":"Personas nativoamericanas intersexuales"},{"@language":"nl","@value":"Intersekse Native Americans"},{"@language":"nl","@value":"Native American intersekse personen"}],"rdfs:comment":[{"@language":"en","@value":"People who are part of the Native peoples of the continental United States and Canada (excluding Inuit people) and self-identity as intersex. Use more specific terms when available."},{"@language":"es","@value":"Personas intersexuales que son nativoamericanas o parte de los pueblos indígenas de Norteamérica; utilícese únicamente para personas que se autoidentifiquen como nativoamericanas e intersexuales."},{"@language":"nl","@value":"Mensen die deel uitmaken van de inheemse volkeren van de continentale Verenigde Staten en Canada (met uitzondering van Inuit) en zichzelf identificeren als intersekse. Gebruik specifiekere termen indien mogelijk."},{"@language":"sv","@value":"Personer som tillhör ursprungsfolken i det kontinentala USA och Kanada (exklusive inuiter) och som identifierar sig som intersexpersoner. Använd mer specifika termer där det är möjligt."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001037"},{"@id":"https://homosaurus.org/v5/homoit0001973"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-09-29"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003422","dc:identifier":"homoit0003422","skos:prefLabel":[{"@language":"en","@value":"Native American non-binary people"},{"@language":"es","@value":"Personas no binarias nativoamericanas"},{"@language":"nl","@value":"Indiaans-Amerikaanse non-binaire personen"},{"@language":"sv","@value":"Ickebinära ursprungsamerikaner"}],"skos:altLabel":[{"@language":"en","@value":"American Indian non-binary people"},{"@language":"en","@value":"American Indian nonbinary people"},{"@language":"en","@value":"Native American nonbinary people"},{"@language":"en","@value":"Non-binary American Indians"},{"@language":"en","@value":"Non-binary Native Americans"},{"@language":"en","@value":"Nonbinary American Indians"},{"@language":"en","@value":"Nonbinary Native Americans"},{"@language":"es","@value":"Personas nativoamericanas no binarias"},{"@language":"nl","@value":"Amerikaans-Indiaanse nonbinaire personen"},{"@language":"nl","@value":"Native Amerikaanse non-binaire personen"},{"@language":"nl","@value":"Non-binaire Amerikaanse Indianen"},{"@language":"nl","@value":"Non-binaire Native Amerikanen"},{"@language":"nl","@value":"Nonbinaire Amerikaanse Indianen"},{"@language":"nl","@value":"Nonbinaire Native Amerikanen"}],"rdfs:comment":[{"@language":"en","@value":"People who are part of the Native peoples of the continental United States and Canada (excluding Inuit people) and self-identity as Non-binary. Do not conflate with Two-Spirit people. Use more specific terms when available."},{"@language":"es","@value":"Personas no binarias que son nativoamericanas o parte de los pueblos indígenas de Norteamérica. Utilícese únicamente para personas que se autoidentifican como nativoamericanas y asexuales."},{"@language":"nl","@value":"Personen die deel uitmaken van de inheemse volkeren van continentaal Verenigde Staten en Canada (exclusief Inuit) en een zelfidentiteit als Non-binair. Niet verwarren met Two-Spirit-people. Gebruik specifiekere termen indien beschikbaar."},{"@language":"sv","@value":"Personer som tillhör ursprungsfolken i det kontinentala USA och Kanada (exklusive inuiter) och som identifierar sig som ickebinära. Blanda inte ihop med Two-spirit-personer. Använd mer specifika termer där det är möjligt."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001037"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2024-07-11"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001038","dc:identifier":"homoit0001038","skos:prefLabel":[{"@language":"en","@value":"Nudism"},{"@language":"es","@value":"Nudismo"},{"@language":"fr","@value":"Nudisme"},{"@language":"nl","@value":"Nudisme"},{"@language":"sv","@value":"Nudism"}],"skos:altLabel":[{"@language":"en","@value":"Naturism"},{"@language":"es","@value":"Naturismo"}],"rdfs:comment":[{"@language":"en","@value":"Practice of engaging in social activities while nude, either in private or public. This term also refers to the cultural movement advocating for nudism as an alternative, healthy lifestyle."},{"@language":"es","@value":"Práctica de participar en actividades sociales al desnudo, ya sea en privado o en público. Este término también se refiere al movimiento cultural que aboga por el nudismo como un estilo de vida alternativo y saludable."},{"@language":"fr","@value":"Pratique consistant à s'engager dans des activités sociales en étant nu·e, que ce soit en privé ou en public. Ce terme fait également référence au mouvement culturel prônant le nudisme comme mode de vie alternatif et sain."},{"@language":"nl","@value":"Praktijk van het deelnemen aan sociale activiteiten in privé en/of in het openbaar terwijl je naakt bent; verwijst ook naar culturele bewegingen die pleiten voor nudisme als een alternatieve, gezonde levensstijl."},{"@language":"sv","@value":"Att delta i sociala aktiviteter naken, antingen privat eller offentligt. Termen används även för att beskriva den kulturella rörelse som förespråkar nudism som en hälsosam livsstil."}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001050"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85093173"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001038"},"dc:replaces":{"@id":"http://homosaurus.org/v2/nudism"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001039","dc:identifier":"homoit0001039","skos:prefLabel":[{"@language":"en","@value":"Tantric sex"},{"@language":"es","@value":"Sexo tántrico"},{"@language":"nl","@value":"Tantrische seks"},{"@language":"sv","@value":"Tantrasex"}],"skos:altLabel":[{"@language":"en","@value":"Neotantra"},{"@language":"es","@value":"Neotantra"},{"@language":"nl","@value":"Tantric seks"}],"rdfs:comment":[{"@language":"en","@value":"Traditionally refers to a wide range of practices in Hindu and Buddhist yoga usually involving the ritual exercise of sexuality. Do not use outside of these contexts."},{"@language":"es","@value":"Tradicionalmente se refiere a una amplia gama de prácticas de yoga hindú y budista que generalmente implican el ejercicio ritual de la sexualidad. No se debe utilizar fuera de estos contextos."},{"@language":"nl","@value":"Verwijst traditioneel naar een breed scala aan praktijken in hindoeïstische en boeddhistische yoga, meestal met rituele beoefening van seksualiteit. Niet gebruiken buiten deze context."},{"@language":"sv","@value":"Avser ett brett spektrum av praktiker inom hinduistisk och buddhistisk yoga där sexualitet utövas rituellt. Bör inte användas utanför dessa kontexter."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001267"},{"@id":"https://homosaurus.org/v5/homoit0001299"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001267"},"dc:replaces":{"@id":"http://homosaurus.org/v2/tantricSex"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001191","dc:identifier":"homoit0001191","skos:prefLabel":[{"@language":"en","@value":"Queer newsletters"},{"@language":"es","@value":"Boletines queer"},{"@language":"nl","@value":"Queer nieuwsbrieven"},{"@language":"sv","@value":"Queera nyhetsbrev"}],"rdfs:comment":[{"@language":"en","@value":"Serialized print or digital periodicals created by or for queer people, often with the purpose of sharing news and information related to queer communities and queer issues."},{"@language":"es","@value":"Publicaciones periódicas impresas o digitales serializadas creadas por o para personas queer, a menudo con el propósito de compartir noticias e información relacionadas con comunidades y temas queer."},{"@language":"nl","@value":"Periodieke gedrukte of digitale tijdschriften gemaakt door of voor queer personen, vaak met als doel het delen van nieuws en informatie met betrekking tot queer gemeenschappen en queer kwesties."},{"@language":"sv","@value":"Seriella tryckta eller digitala tidskrifter skapade av eller för queera personer, ofta i syfte att dela nyheter och information relaterad till queera frågor och queera gemenskaper."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001041"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001132"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerNewsletters"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001427","dc:identifier":"homoit0001427","skos:prefLabel":[{"@language":"en","@value":"Transgender newsletters"},{"@language":"es","@value":"Boletines transgénero"},{"@language":"nl","@value":"Transgender nieuwsbrieven"},{"@language":"sv","@value":"Transnyhetsbrev"}],"rdfs:comment":[{"@language":"en","@value":"Serialized print or digital periodicals created by or for transgender people, often with the purpose of sharing news and information related to transgender communities and transgender issues."},{"@language":"es","@value":"Publicaciones periódicas impresas o digitales serializadas creadas por o para personas transgénero, a menudo con el propósito de compartir noticias e información relacionadas con comunidades transgénero y asuntos transgénero."},{"@language":"nl","@value":"Periodieke gedrukte of digitale tijdschriften gemaakt door of voor transgender personen, vaak met als doel het delen van nieuws en informatie met betrekking tot transgender gemeenschappen en transgender kwesties."},{"@language":"sv","@value":"Seriella tryckta eller digitala tidskrifter skapade av eller för transpersoner, ofta i syfte att dela nyheter och information relaterad till transfrågor och transgemenskaper."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001041"},{"@id":"https://homosaurus.org/v5/homoit0001436"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001428"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001132"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transgenderNewsletters"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002797","dc:identifier":"homoit0002797","skos:prefLabel":[{"@language":"en","@value":"Asexual newsletters"},{"@language":"es","@value":"Boletines asexuales"},{"@language":"de","@value":"Asexuelle Newsletter"},{"@language":"nl","@value":"Aseksuele nieuwsbrieven"},{"@language":"sv","@value":"Asexuella nyhetsbrev"}],"skos:altLabel":[{"@language":"de","@value":"Ace Newsletter"},{"@language":"sv","@value":"Ace-nyhetsbrev"}],"rdfs:comment":[{"@language":"en","@value":"Serialized print or digital periodicals created by or for asexual people, often with the purpose of sharing news and information related to asexual communities and asexual issues."},{"@language":"es","@value":"Publicaciones periódicas impresas o digitales serializadas creadas por o para personas asexuales, a menudo con el pr