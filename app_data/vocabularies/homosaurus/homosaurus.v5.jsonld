oit0002695","skos:prefLabel":[{"@language":"en","@value":"Two-Spirit wheelchair users"},{"@language":"es","@value":"Usarios dos espíritus de sillas de ruedas"},{"@language":"nl","@value":"Two-Spirit rolstoelgebruikers"},{"@language":"sv","@value":"Rullstolsburna Two-spirit-personer"}],"skos:altLabel":[{"@language":"en","@value":"2S wheelchair users"},{"@language":"en","@value":"Two Spirit wheelchair users"},{"@language":"en","@value":"Two Spirited wheelchair users"},{"@language":"en","@value":"Two-Spirited wheelchair users"}],"rdfs:comment":[{"@language":"en","@value":"Two-Spirit people who use wheelchairs."},{"@language":"es","@value":"Personas dos espíritus que utilizan sillas de ruedas."},{"@language":"nl","@value":"Two-Spirit people die rolstoelen gebruiken."},{"@language":"sv","@value":"Two-spirit-personer som använder rullstol."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002682"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001877"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-26"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002786","dc:identifier":"homoit0002786","skos:prefLabel":[{"@language":"en","@value":"Asexual people with chronic illnesses"},{"@language":"es","@value":"Personas asexuales con enfermedades crónicas"},{"@language":"de","@value":"Asexuelle Personen mit chronischen Krankheiten"},{"@language":"nl","@value":"Aseksuele personen met chronische ziekten"},{"@language":"sv","@value":"Asexuella personer med kronisk sjukdom"}],"skos:altLabel":[{"@language":"en","@value":"Chronically ill asexual people"},{"@language":"es","@value":"Personas con enfermedades crónicas asexuales"},{"@language":"es","@value":"Enfermos crónicos asexuales"},{"@language":"es","@value":"Enfermas crónicas asexuales"},{"@language":"de","@value":"Chronisch kranke asexuelle Personen"},{"@language":"sv","@value":"Kroniskt sjuka asexuella personer"}],"rdfs:comment":[{"@language":"en","@value":"Asexual people who have long-term health conditions that require continued medical attention and/or significantly impact or limit daily life; some but not all people with chronic illnesses consider themselves disabled."},{"@language":"es","@value":"Personas asexuales que padecen de condiciones de salud a largo plazo que requieren atención médica continua y/o que impactan o limitan significativamente sus vidas diarias; algunas, pero no todas, las personas con enfermedades crónicas se consideran discapacitadas."},{"@language":"de","@value":"Asexuelle Menschen mit langfristigen gesundheitlichen Problemen, die eine kontinuierliche medizinische Betreuung erfordern und/oder das tägliche Leben erheblich beeinträchtigen oder einschränken; einige, aber nicht alle Menschen mit chronischen Krankheiten betrachten sich als behindert."},{"@language":"nl","@value":"Aseksuele personen met langdurige gezondheidsproblemen die voortdurende medische aandacht vereisen en/of een significante impact hebben op het dagelijks leven of deze beperken; sommige, maar niet alle personen met chronische ziekten beschouwen zichzelf als gehandicapt"},{"@language":"sv","@value":"Asexuella personer med långvariga hälsotillstånd som kräver kontinuerlig medicinsk behandling och/eller har en betydande påverkan på eller begränsar det dagliga livet. Vissa, men inte alla, personer med kroniska sjukdomar identifierar sig som personer med funktionsnedsättning."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001879"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0002782"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002928","dc:identifier":"homoit0002928","skos:prefLabel":[{"@language":"en","@value":"Intersex people with chronic illnesses"},{"@language":"de","@value":"Inter* Personen mit chronischen Krankheiten"},{"@language":"es","@value":"Personas intersexuales con enfermedades crónicas"},{"@language":"nl","@value":"Intersekse personen met chronische ziekten"},{"@language":"sv","@value":"Intersexpersoner med kronisk sjukdom"}],"skos:altLabel":[{"@language":"en","@value":"Chronically ill intersex people"},{"@language":"de","@value":"inter* Menschen mit chronischen Krankheiten"},{"@language":"es","@value":"Personas con enfermedades crónicas intersex"},{"@language":"es","@value":"Enfermos crónicos intersex"},{"@language":"es","@value":"Personas intersex con enfermedades crónicas"},{"@language":"sv","@value":"Kroniskt sjuka intersexpersoner"}],"rdfs:comment":[{"@language":"en","@value":"Intersex people who have long-term health conditions that require continued medical attention and/or significantly impact or limit daily life; some but not all people with chronic illnesses consider themselves disabled."},{"@language":"de","@value":"Inter* Personen mit langfristigen gesundheitlichen Problemen, die eine kontinuierliche medizinische Betreuung erfordern und/oder das tägliche Leben erheblich beeinträchtigen oder einschränken; einige, aber nicht alle Personen mit chronischen Krankheiten betrachten sich als behindert."},{"@language":"es","@value":"Personas intersex que tienen condiciones de salud a largo plazo que requieren atención médica continua y/o impactan o limitan significativamente la vida diaria; algunas, pero no todas, las personas con enfermedades crónicas se consideran discapacitadas."},{"@language":"nl","@value":"Intersekse personen met langdurige gezondheidsproblemen die voortdurende medische aandacht vereisen en/of het dagelijks leven aanzienlijk beïnvloeden of beperken; sommige, maar niet alle, personen met chronische ziekten beschouwen zichzelf als gehandicapt."},{"@language":"sv","@value":"Intersexpersoner med långvariga hälsotillstånd som kräver kontinuerlig medicinsk behandling och/eller har en betydande påverkan på eller begränsar det dagliga livet. Vissa, men inte alla, personer med kroniska sjukdomar identifierar sig som personer med funktionsnedsättning."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001879"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0002929"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-30"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002694","dc:identifier":"homoit0002694","skos:prefLabel":[{"@language":"en","@value":"Two-Spirit people with chronic illnesses"},{"@language":"es","@value":"Personas dos espíritus con enfermedades crónicas"},{"@language":"nl","@value":"Two-Spirit people met chronische ziekten"},{"@language":"sv","@value":"Two-spirit-personer med kronisk sjukdom"}],"skos:altLabel":[{"@language":"en","@value":"2S people with chronic illnesses"},{"@language":"en","@value":"Chronically ill 2S people"},{"@language":"en","@value":"Chronically ill Two Spirit people"},{"@language":"en","@value":"Chronically ill Two Spirited people"},{"@language":"en","@value":"Chronically ill Two-Spirited people"},{"@language":"en","@value":"Two Spirit people with chronic illnesses"},{"@language":"en","@value":"Two Spirited people with chronic illnesses"},{"@language":"en","@value":"Two-Spirited people with chronic illnesses"},{"@language":"es","@value":"Personas con enfermedades crónicas dos espíritus"},{"@language":"es","@value":"Enfermos crónicos dos espíritus"},{"@language":"sv","@value":"Kroniskt sjuka Two-spirit-personer"}],"rdfs:comment":[{"@language":"en","@value":"Two-Spirit people who have long-term health conditions that require continued medical attention and/or significantly impact or limit daily life; some but not all people with chronic illnesses consider themselves disabled."},{"@language":"es","@value":"Personas dos espíritus que padecen de condiciones de salud a largo plazo que requieren atención médica continua y/o que impactan o limitan significativamente sus vidas diarias; algunas, pero no todas, las personas con enfermedades crónicas se consideran discapacitadas."},{"@language":"nl","@value":"Two-Spirit people met langdurige gezondheidsproblemen die voortdurende medische aandacht vereisen en/of het dagelijks leven aanzienlijk beïnvloeden of beperken; sommige, maar niet alle personen met chronische ziekten beschouwen zichzelf als gehandicapt."},{"@language":"sv","@value":"Two-spirit-personer med långvariga hälsotillstånd som kräver kontinuerlig medicinsk behandling och/eller har en betydande påverkan på eller begränsar det dagliga livet. Vissa, men inte alla, personer med kroniska sjukdomar identifierar sig som personer med funktionsnedsättning."}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001879"},{"@id":"https://homosaurus.org/v5/homoit0002682"},{"@id":"https://homosaurus.org/v5/homoit0004226"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0002694"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-26"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003986","dc:identifier":"homoit0003986","skos:prefLabel":[{"@language":"en","@value":"Crip time"},{"@language":"nl","@value":"Crip time"},{"@language":"sv","@value":"Crip-tid"}],"skos:altLabel":[{"@language":"en","@value":"Crip temporality"},{"@language":"sv","@value":"Crip tid"},{"@language":"sv","@value":"Crippad tid"}],"rdfs:comment":[{"@language":"en","@value":"Term used to describe the ways in which disabled and chronically ill people experience and relate to time differently than is socially expected. According to Alison Kafer, quoted in a paper published by Ellen Samuels, \"rather than bend disabled bodies and minds to meet the clock, crip time bends the clock to meet disabled bodies and minds.\""},{"@language":"nl","@value":"Term die gebruikt wordt om de manieren te beschrijven waarop mensen met een beperking en chronisch zieken tijd anders ervaren en ermee omgaan dan maatschappelijk verwacht. Volgens Alison Kafer, geciteerd in een artikel gepubliceerd door Ellen Samuels, \"in plaats van het lichaam en de geest van een beperking te buigen om de klok te volgen, buigt de tijd van een beperking de klok om het lichaam en de geest van een beperking te volgen.\""},{"@language":"sv","@value":"Term som används för att beskriva hur personer med funktionshinder och kroniskt sjuka personer upplever och förhåller sig till tid på ett annat sätt än vad som förväntas enligt sociala normer. Enligt Alison Kafer, citerad i en artikel publicerad av Ellen Samuels, ”snarare än att böja funktionshindrade kroppar och sinnen för att möta klockan, böjer den crippade tiden klockan för att möta funktionshindrade kroppar och sinnen”."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001891"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0003985"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001317"},"dc:issued":{"@type":"xsd:date","@value":"2025-04-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001898","dc:identifier":"homoit0001898","skos:prefLabel":[{"@language":"en","@value":"Studs (Lesbian culture)"},{"@language":"es","@value":"Studs"},{"@language":"nl","@value":"Studs (Lesbische cultuur)"},{"@language":"sv","@value":"Studs"}],"rdfs:comment":[{"@language":"en","@value":"Masculine identity associated with Black lesbian communities in the United States."},{"@language":"es","@value":"Identidad masculina asociada a las comunidades de lesbianas negras en Estados Unidos."},{"@language":"nl","@value":"Masculiene identiteit geassocieerd met zwarte lesbische gemeenschappen in de Verenigde Staten"},{"@language":"sv","@value":"Maskulin identitet som är förknippad med svarta lesbiska gemenskaper i USA."}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001898"},"dc:issued":{"@type":"xsd:date","@value":"2022-02-28"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002038","dc:identifier":"homoit0002038","skos:prefLabel":[{"@language":"en","@value":"Racism"},{"@language":"es","@value":"Racismo"},{"@language":"nl","@value":"Racisme"},{"@language":"sv","@value":"Rasism"}],"rdfs:comment":[{"@language":"en","@value":"The belief that groups of human beings possess different inherent behavioral traits that correspond to inherited attributes and can be divided based on the superiority of one race over another. This term also encompasses prejudice, discrimination, and antagonism (whether personal or systematic) directed against other people because of their race and its perceived inferiority."},{"@language":"es","@value":"La creencia de que grupos de seres humanos poseen diferentes rasgos de comportamiento inherentes que corresponden a atributos heredados y que pueden dividirse en función de la superioridad de una raza sobre otra. Este término también abarca prejuicios, discriminación y antagonismo (ya sea personal o sistemático) dirigido contra otras personas debido a su raza y su percibida inferioridad."},{"@language":"nl","@value":"De overtuiging dat groepen mensen verschillende inherente gedragskenmerken hebben die overeenkomen met overgeërfde eigenschappen en kunnen worden verdeeld op basis van de superioriteit van het ene ras boven het andere. Deze term omvat ook vooroordelen, discriminatie en antagonisme (persoonlijk of systematisch) gericht tegen andere mensen vanwege hun ras en de vermeende minderwaardigheid ervan"},{"@language":"sv","@value":"Föreställningen att mänskliga grupper har medfödda beteenden kopplade till biologiska egenskaper, vilket ofta leder till hierarkier mellan raser. Inkluderar fördomar, diskriminering och fientlighet mot andra utifrån upplevd ras."}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0002194"},{"@id":"https://homosaurus.org/v5/homoit0002257"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001902"},{"@id":"https://homosaurus.org/v5/homoit0001903"},{"@id":"https://homosaurus.org/v5/homoit0001904"},{"@id":"https://homosaurus.org/v5/homoit0002269"},{"@id":"https://homosaurus.org/v5/homoit0002270"},{"@id":"https://homosaurus.org/v5/homoit0002271"},{"@id":"https://homosaurus.org/v5/homoit0002272"},{"@id":"https://homosaurus.org/v5/homoit0003691"},{"@id":"https://homosaurus.org/v5/homoit0003692"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85110266"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0002038"},"dc:issued":{"@type":"xsd:date","@value":"2022-06-15"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002257","dc:identifier":"homoit0002257","skos:prefLabel":[{"@language":"en","@value":"Anti-Blackness"},{"@language":"de","@value":"Anti-Schwarzer Rassismus"},{"@language":"es","@value":"Anti-negritud"},{"@language":"nl","@value":"Anti-Zwart racisme"},{"@language":"sv","@value":"Antisvarthet"}],"skos:altLabel":[{"@language":"en","@value":"Anti Blackness"},{"@language":"de","@value":"Antischwarzer Rassismus"},{"@language":"de","@value":"Anti-Schwarzsein"},{"@language":"de","@value":"Anti-blackness"},{"@language":"de","@value":"Anti Blackness"},{"@language":"es","@value":"Antinegritud"},{"@language":"es","@value":"Anti-blackness"},{"@language":"sv","@value":"Antisvart rasism"}],"rdfs:comment":[{"@language":"en","@value":"Term used to acknowledge the particularities of racism as directed toward Black people. Anti-Blackness includes the belief that Black people possess different inherent behavioral traits that correspond to inherited attributes and are inferior to those of other races--particularly white people. Anti-Blackness also encompasses prejudice, discrimination, and antagonism (whether personal or systematic) directed toward Black people because of their race and its perceived inferiority."},{"@language":"de","@value":"Begriff, der verwendet wird, um die Besonderheiten des Rassismus, der sich gegen Schwarze Menschen richtet, anzuerkennen. Anti-Schwarzer Rassismus beinhaltet die Überzeugung, dass Schwarze Menschen andere angeborene Verhaltensmerkmale besitzen, die ererbten Eigenschaften entsprechen und denen anderer Races - insbesondere der weißen - unterlegen sind. Anti-Schwarzer Rassismus umfasst auch Vorurteile, Diskriminierung und Feindseligkeit (persönlich oder systematisch), die sich gegen Schwarze Menschen aufgrund ihrer Race und ihrer wahrgenommenen Minderwertigkeit richten. Hinweis: Der englische Begriff «Race» ist nicht mit dem deutschen Begriff «Rasse» gleichzusetzen, da sie in zwei unterschiedlichen Diskursen stehen. Oft wird deshalb im Deutschen ebenfalls Race verwendet."},{"@language":"es","@value":"Término utilizado para reconocer las particularidades del racismo dirigido hacia las personas negras. La antinegritud incluye la creencia de que las personas negras poseen diferentes características conductuales inherentes que corresponden a atributos heredados, y que son inferiores a otras razas, particularmente a las personas blancas. La antinegritud también abarca el prejuicio, la discriminación y el antagonismo (ya sea personal o sistemático) dirigido hacia las personas negras debido a su raza y su percibida inferioridad."},{"@language":"nl","@value":"Term die wordt gebruikt om racisme tegen zwarte personen te typeren. Anti-Zwart racisme omvat de overtuiging dat zwarte personen verschillende inherente gedragskenmerken bezitten die overeenkomen met overgeërfde eigenschappen en inferieur zijn aan die van andere rassen, met name witte personen. Anti-Zwart racisme omvat ook vooroordelen, discriminatie en antagonisme (persoonlijk of systematisch) gericht tegen zwarte personen vanwege hun ras en de vermeende minderwaardigheid ervan."},{"@language":"sv","@value":"Term som erkänner de specifika uttrycken av rasism riktad mot svarta personer. Antisvarthet inkluderar föreställningen att svarta människor innehar inneboende beteendemässiga egenskaper kopplade till ärftliga attribut och att dessa är underlägsna jämfört med andra raser, särskilt vita. Antisvarthet omfattar även fördomar, diskriminering och antagonism (både individuell och systemisk) riktad mot svarta personer på grund av deras hudfärg och dess upplevda underlägsenhet."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002038"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001902"},{"@id":"https://homosaurus.org/v5/homoit0001903"},{"@id":"https://homosaurus.org/v5/homoit0001904"},{"@id":"https://homosaurus.org/v5/homoit0002376"},{"@id":"https://homosaurus.org/v5/homoit0003691"},{"@id":"https://homosaurus.org/v5/homoit0003692"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0002038"},"dc:issued":{"@type":"xsd:date","@value":"2022-09-09"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002269","dc:identifier":"homoit0002269","skos:prefLabel":[{"@language":"en","@value":"Anti-racism"},{"@language":"es","@value":"Anti-racismo"},{"@language":"de","@value":"Antirassismus"},{"@language":"nl","@value":"Anti-racisme"},{"@language":"sv","@value":"Antirasism"}],"skos:altLabel":[{"@language":"en","@value":"Antiracism"},{"@language":"es","@value":"Antirracismo"},{"@language":"de","@value":"AntiRa"},{"@language":"de","@value":"Antira"}],"rdfs:comment":[{"@language":"en","@value":"Umbrella term used to describe a range of ideas, policies, and political actions that are intended to actively challenge, reject, or oppose racism and racial oppression (whether personal or systemic), as well as advocate for racial equity."},{"@language":"es","@value":"Término general utilizado para describir una variedad de ideas, políticas y acciones políticas que tienen como objetivo desafiar, rechazar u oponerse activamente al racismo y la opresión racial (ya sea personal o sistémica), así como defender la equidad racial."},{"@language":"de","@value":"Sammelbegriff für eine Reihe von Ideen, Maßnahmen und politischen Aktionen, die darauf abzielen, Rassismus und rassistische Unterdrückung (ob persönlich oder systemisch) aktiv in Frage zu stellen, abzulehnen oder zu bekämpfen und sich für die Gleichstellung aller Races einzusetzen. Hinweis: Der englische Begriff «Race» ist nicht mit dem deutschen Begriff «Rasse» gleichzusetzen, da sie in zwei unterschiedlichen Diskursen stehen. Oft wird deshalb im Deutschen ebenfalls Race verwendet."},{"@language":"nl","@value":"Overkoepelende term die wordt gebruikt om een reeks ideeën, beleidslijnen en politieke acties te beschrijven die bedoeld zijn om racisme en raciale onderdrukking (persoonlijk of systemisch) actief aan te vechten, af te wijzen of tegen te gaan, en om te pleiten voor raciale gelijkheid."},{"@language":"sv","@value":"Samlingsterm för idéer, policys och politiska åtgärder som syftar till att motverka rasism och rasistiskt förtryck, både individuellt och strukturellt, samt främja jämlikhet och rättvisa mellan grupper."}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001902"},{"@id":"https://homosaurus.org/v5/homoit0002038"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2007000043"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0002269"},"dc:issued":{"@type":"xsd:date","@value":"2022-11-08"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003988","dc:identifier":"homoit0003988","skos:prefLabel":[{"@language":"en","@value":"White time"},{"@language":"nl","@value":"Witte tijd"},{"@language":"sv","@value":"Vit-tid"}],"skos:altLabel":[{"@language":"en","@value":"White temporality"},{"@language":"en","@value":"White temporal imaginary"},{"@language":"en","@value":"Racialization of time"},{"@language":"en","@value":"Racial time"},{"@language":"nl","@value":"White temporality"},{"@language":"nl","@value":"White time"},{"@language":"sv","@value":"Vittid"}],"rdfs:comment":[{"@language":"en","@value":"Term used to describe the racialization of time in a white supremacist society, which results in unequal temporal access to institutions, resources, power, etc. This term also references the ways in which non-white people are expected to conform to specific, linear patterns over time, as well as the calculation of time and history through white, Western expectations for progress and productivity."},{"@language":"nl","@value":"Term die wordt gebruikt om de racialisering van tijd in een witte suprematistische maatschappij te beschrijven, wat resulteert in ongelijke tijdelijke toegang tot instellingen, middelen, macht, enz. Deze term verwijst ook naar de manieren waarop van niet-witte personen wordt verwacht dat ze zich in de loop van de tijd aan specifieke, lineaire patronen conformeren, evenals de berekening van tijd en geschiedenis door witte, westerse verwachtingen van vooruitgang en productiviteit."},{"@language":"sv","@value":"Term som används för att beskriva rasifieringen av tid i ett samhälle med vit överhöghet, vilket resulterar i ojämlik tidsmässig tillgång till institutioner, resurser, makt etc. Denna term hänvisar också till hur icke-vita människor förväntas anpassa sig till specifika, linjära mönster över tid, såväl som beräkningen av tid och historia genom vita, västerländska förväntningar på framsteg och produktivitet."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0003985"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001902"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001323"},"dc:issued":{"@type":"xsd:date","@value":"2025-04-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002985","dc:identifier":"homoit0002985","skos:prefLabel":[{"@language":"en","@value":"Asexual witches"},{"@language":"de","@value":"Asexuelle Hexen"},{"@language":"nl","@value":"Aseksuele heksen"},{"@language":"sv","@value":"Asexuella häxor"}],"skos:altLabel":[{"@language":"en","@value":"Asexual Wiccans"},{"@language":"de","@value":"Ace Hexen"},{"@language":"de","@value":"Asexuelle Wicca"},{"@language":"de","@value":"Asexuelle Wicca-Anhänger:innen"}],"rdfs:comment":[{"@language":"en","@value":"Asexual practitioners of Wicca or other Pagan religions who self-identify as witches."},{"@language":"de","@value":"Asexuelle Anhänger:innen von Wicca oder anderen heidnischen Religionen, die sich selbst als Hexen bezeichnen."},{"@language":"nl","@value":"Aseksuele beoefenaars van Wicca of andere paganistische religies die zichzelf identificeren als heksen"},{"@language":"sv","@value":"Asexuella personer som utövar wicca eller andra hedniska religioner och som identifierar sig som häxor."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001907"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000928"},"dc:issued":{"@type":"xsd:date","@value":"2023-10-27"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002581","dc:identifier":"homoit0002581","skos:prefLabel":[{"@language":"en","@value":"Appropriation of Two-Spirit identity"},{"@language":"es","@value":"Apropiación de identidades dos espíritus"},{"@language":"de","@value":"Aneignung von Two-Spirit-Identität"},{"@language":"nl","@value":"Toe-eigening van Two-Spirit identiteit"},{"@language":"sv","@value":"Appropriering av two spirit-identitet"}],"rdfs:comment":[{"@language":"en","@value":"A form of cultural appropriation involving identification with Two-Spirit identity by people who cannot claim citizenship, belonging, and/or descent from Indigenous people in North America."},{"@language":"es","@value":"Una forma de apropiación cultural que implica la identificación con la identidad Dos Espíritus por parte de personas que no pueden reclamar ciudadanía, pertenencia y/o descendencia de pueblos indígenas de Norteamérica."},{"@language":"de","@value":"Eine Form der kulturellen Aneignung, die die Identifizierung mit der Two-Spirit-Identität von Personen umfasst, die keine Staatsbürgerschaft, Zugehörigkeit und/oder Abstammung von indigenen Völkern in Nordamerika vorweisen können."},{"@language":"nl","@value":"Een vorm van culturele toe-eigening waarbij personen zich identificeren met de Two-Spirit-identiteit die geen aanspraak kunnen maken op het behoren tot en/of afstammen van de inheemse bevolking in Noord-Amerika."},{"@language":"sv","@value":"En form av kulturell appropriering där personer som inte kan göra anspråk på medborgarskap, tillhörighet och/eller härkomst från ursprungsbefolkningar i Nordamerika identifierar sig som Two-spirit."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002580"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001914"},"skos:hasTopC