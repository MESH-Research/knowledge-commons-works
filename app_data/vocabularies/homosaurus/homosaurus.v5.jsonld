ople"},{"@language":"en","@value":"LGBTQ+ Ryūkyūans"},{"@language":"en","@value":"Ryūkyūan people (LGBTQ)"},{"@language":"en","@value":"Ryūkyūans (LGBTQ)"}],"rdfs:comment":[{"@language":"en","@value":"LGBTQ+ people who belong to the Ryukyuan, an ethnic group indigenous to the Ryukyu archipelago in what is now known as Japan. Only use to refer to people who self-identify as Ryukyuan."},{"@language":"nl","@value":"LHBTQ+-personen die behoren tot de Riukiuanen, een etnische groep afkomstig uit de Riukiu-archipel in wat nu Japan heet. Deze term wordt alleen gebruikt voor mensen die zichzelf identificeren als Riukiuaan."},{"@language":"sv","@value":"Hbtq+-personer som tillhör ryukyuanfolket, en etnisk grupp och urfolk från Ryukyuöarna, i det som nu kallas Japan. Används endast för personer som identifierar sig som ryukyuan."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000074"},{"@id":"https://homosaurus.org/v5/homoit0000886"}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0004154"},{"@id":"https://homosaurus.org/v5/homoit0004155"},{"@id":"https://homosaurus.org/v5/homoit0004156"},{"@id":"https://homosaurus.org/v5/homoit0004157"},{"@id":"https://homosaurus.org/v5/homoit0004158"},{"@id":"https://homosaurus.org/v5/homoit0004159"},{"@id":"https://homosaurus.org/v5/homoit0004160"},{"@id":"https://homosaurus.org/v5/homoit0004161"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2025-04-24"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000075","dc:identifier":"homoit0000075","skos:prefLabel":[{"@language":"en","@value":"Autoerotic asphyxiation"},{"@language":"es","@value":"Asfixia autoerótica"},{"@language":"de","@value":"Autoerotische Strangulation"},{"@language":"fr","@value":"Asphyxie autoérotique"},{"@language":"nl","@value":"Auto-erotische asfyxie"},{"@language":"sv","@value":"Autoerotisk kvävning"}],"skos:altLabel":[{"@language":"en","@value":"Asphyxiophilia"},{"@language":"en","@value":"Autoerotic asphyxia"},{"@language":"en","@value":"Hypoxyphilia"},{"@language":"en","@value":"Strangulation sex"},{"@language":"es","@value":"Asfixiofilia"},{"@language":"es","@value":"Hipoxifilia"},{"@language":"es","@value":"Sexo por estrangulación"},{"@language":"de","@value":"Asphyxiophilie"},{"@language":"de","@value":"Hypoxyphilie"},{"@language":"de","@value":"Autoerotische Atemkontrolle"},{"@language":"nl","@value":"Auto-erotische verstikking"},{"@language":"nl","@value":"Wurgseks"}],"rdfs:comment":[{"@language":"en","@value":"Intentional restriction of one's own oxygen for the purposes of sexual arousal."},{"@language":"es","@value":"Restricción intencionada del oxígeno propio con fines de excitación sexual."},{"@language":"de","@value":"Absichtliche Erschwerung oder Unterbindung der eigenen Atmung zum Zweck der sexuellen Erregung."},{"@language":"fr","@value":"Pratique consistant à restreindre volontairement son apport en oxygène afin d'en tirer une stimulation sexuelle."},{"@language":"nl","@value":"Opzettelijke beperking van zuurstof naar de hersenen om seksueel opgewonden te raken."},{"@language":"sv","@value":"Medveten begränsning av sitt eget syreintag i syfte att uppnå sexuell upphetsning."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001267"},{"@id":"https://homosaurus.org/v5/homoit0001299"},{"@id":"https://homosaurus.org/v5/homoit0003113"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000442"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85010060"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001267"},"dc:replaces":{"@id":"http://homosaurus.org/v2/autoeroticAsphyxiation"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003113","dc:identifier":"homoit0003113","skos:prefLabel":[{"@language":"en","@value":"Breath control"},{"@language":"es","@value":"Control de la respiración"},{"@language":"de","@value":"Atemkontrolle"},{"@language":"nl","@value":"Controle van de ademhaling"},{"@language":"sv","@value":"Andningskontroll"}],"skos:altLabel":[{"@language":"en","@value":"Breath control play"},{"@language":"en","@value":"Breath play"},{"@language":"en","@value":"Breathplay"},{"@language":"en","@value":"Suffocation"},{"@language":"es","@value":"Control de respiración"},{"@language":"es","@value":"Juego de respiración"},{"@language":"es","@value":"Juego de control de respiración"},{"@language":"es","@value":"Sofocación"},{"@language":"de","@value":"Asphyxiophilie"},{"@language":"de","@value":"Breath-Play"},{"@language":"nl","@value":"Adembeheersing"},{"@language":"nl","@value":"Ademcontrole"},{"@language":"nl","@value":"Ademspel"},{"@language":"nl","@value":"Verstikking"}],"rdfs:comment":[{"@language":"en","@value":"Controlling or restricting the ability to breathe in order to achieve heightened pleasure or stimulation."},{"@language":"es","@value":"Controlar o restringir la capacidad de respirar para lograr mayor placer o estimulación."},{"@language":"de","@value":"Die Fähigkeit zu atmen kontrollieren oder einschränken, um gesteigerte Lust oder Stimulation zu erreichen."},{"@language":"nl","@value":"Het beheersen of beperken van het vermogen om te ademen om meer plezier of stimulatie te bereiken."},{"@language":"sv","@value":"Kontroll eller begränsning av andningen för att uppnå ökad njutning eller stimulans."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001299"},"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0000075"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000307"},{"@id":"https://homosaurus.org/v5/homoit0000442"},{"@id":"https://homosaurus.org/v5/homoit0003112"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001299"},"dc:issued":{"@type":"xsd:date","@value":"2023-12-20"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000459","dc:identifier":"homoit0000459","skos:prefLabel":[{"@language":"en","@value":"Fucking"},{"@language":"es","@value":"Follar"},{"@language":"de","@value":"Ficken"},{"@language":"nl","@value":"Neuken"},{"@language":"sv","@value":"Knulla"}],"skos:altLabel":[{"@language":"es","@value":"Culear"},{"@language":"es","@value":"Garchar"},{"@language":"es","@value":"Echar un polvo"},{"@language":"es","@value":"Tirar"},{"@language":"es","@value":"Acostar"},{"@language":"es","@value":"Chingar"},{"@language":"es","@value":"Joder"},{"@language":"es","@value":"Coger"},{"@language":"es","@value":"Chichar"}],"rdfs:comment":[{"@language":"en","@value":"Slang term (typically regarded as vulgar) for the sexual act of penetrating another individual’s mouth, anus, or vagina with a penis or dildo. May also be used to describe sex acts in general (e.g., \"They were fucking.\")."},{"@language":"es","@value":"Término de la jerga (generalmente considerado vulgar) para el acto sexual de penetrar la boca, el ano o la vagina de otra persona con un pene o un consolador. También se puede utilizar para describir actos sexuales en general (por ejemplo, \"Estaban follando\")."},{"@language":"de","@value":"Slangbegriff (in der Regel als vulgär angesehen) für den Geschlechtsakt, bei dem der Penis oder ein Dildo in den Mund, Anus oder die Vagina einer anderen Person eingeführt wird. Kann auch zur Beschreibung von Geschlechtsakten im Allgemeinen verwendet werden (z. B. „Sie haben gefickt.“)."},{"@language":"sv","@value":"Slangterm (vanligtvis betraktad som vulgär) för sexuell handling där en penis eller dildo förs in i mun, anus eller vagina på en annan person. Kan även användas som allmän benämning på sexuella handlingar (t.ex. ”De knullade”)."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000280"},{"@id":"https://homosaurus.org/v5/homoit0001109"},{"@id":"https://homosaurus.org/v5/homoit0001267"},{"@id":"https://homosaurus.org/v5/homoit0001487"}],"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0000076"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000588"},{"@id":"https://homosaurus.org/v5/homoit0000662"},{"@id":"https://homosaurus.org/v5/homoit0003107"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001267"},"dc:replaces":{"@id":"http://homosaurus.org/v2/fucking"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000099","dc:identifier":"homoit0000099","skos:prefLabel":[{"@language":"en","@value":"Barebacking"},{"@language":"de","@value":"Barebacking"},{"@language":"es","@value":"Sexo a pelo"},{"@language":"nl","@value":"Barebacking"},{"@language":"sv","@value":"Barebacking"}],"skos:altLabel":[{"@language":"de","@value":"ungeschützter Analverkehr"},{"@language":"es","@value":"Barebacking"},{"@language":"es","@value":"Sexo sin preservativo"}],"rdfs:comment":[{"@language":"en","@value":"The practice of engaging in anal sex without using a condom."},{"@language":"de","@value":"Analverkehr ohne Kondom."},{"@language":"es","@value":"La práctica de tener sexo anal sin preservativo."},{"@language":"sv","@value":"Sexuell praktik som innebär analsex utan att använda kondom."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000076"},{"@id":"https://homosaurus.org/v5/homoit0001239"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0003129"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001267"},"dc:replaces":{"@id":"http://homosaurus.org/v2/barebacking"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000293","dc:identifier":"homoit0000293","skos:prefLabel":[{"@language":"en","@value":"Enemas"},{"@language":"es","@value":"Enemas"},{"@language":"de","@value":"Einlauf"},{"@language":"nl","@value":"Klysma's"},{"@language":"sv","@value":"Lavemang (redskap och praktik)"}],"skos:altLabel":[{"@language":"en","@value":"Colonic irrigation"},{"@language":"es","@value":"Lavativa"},{"@language":"es","@value":"Hidroterapia de colon"},{"@language":"de","@value":"Darmspülung"},{"@language":"de","@value":"Kolonirrigation"}],"rdfs:comment":[{"@language":"en","@value":"A liquid application device used as a douche or to cleanse the bowels or vagina, or usage of such a device. Can be used for sexual or erotic purposes."},{"@language":"es","@value":"Inyecciones de agua u otros líquidos en el recto, normalmente con fines médicos o higiénicos; también se puede utilizar en un contexto erótico."},{"@language":"de","@value":"Ein Gerät zur Verabreichung von Flüssigkeiten, das als Spülung oder zur Reinigung des Darms oder der Vagina verwendet wird, oder die Verwendung eines solchen Geräts. Kann für sexuelle oder erotische Zwecke verwendet werden."},{"@language":"nl","@value":"Een apparaat voor het aanbrengen van vloeistoffen dat wordt gebruikt als douche of om de darmen of de vagina te reinigen, of gebruik van een dergelijk apparaat. Kan gebruikt worden voor seksuele of erotische doeleinden."},{"@language":"sv","@value":"En anordning för applicering av vätska som används som intimdusch eller vid lavemang för rengöring av tarmar eller slida, eller användning av en sådan anordning. Kan användas i sexuella eller erotiska sammanhang."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000442"},{"@id":"https://homosaurus.org/v5/homoit0001266"},{"@id":"https://homosaurus.org/v5/homoit0001267"},{"@id":"https://homosaurus.org/v5/homoit0001299"},{"@id":"https://homosaurus.org/v5/homoit0003059"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000076"},{"@id":"https://homosaurus.org/v5/homoit0000081"},{"@id":"https://homosaurus.org/v5/homoit0003124"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85043118"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000404"},"dc:replaces":{"@id":"http://homosaurus.org/v2/enemas"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003107","dc:identifier":"homoit0003107","skos:prefLabel":[{"@language":"en","@value":"Sex swings"},{"@language":"es","@value":"Columpios sexuales"},{"@language":"nl","@value":"Seksschommels"},{"@language":"sv","@value":"Sexgungor"}],"skos:altLabel":[{"@language":"en","@value":"Sex slings"},{"@language":"en","@value":"Slings"},{"@language":"en","@value":"Swings"},{"@language":"es","@value":"Slings"},{"@language":"nl","@value":"Seks slings"},{"@language":"nl","@value":"Slings"}],"rdfs:comment":[{"@language":"en","@value":"A type of reclining seat suspended from a stand or ceiling, typically used to position the body for sexual activity."},{"@language":"es","@value":"Un tipo de asiento reclinable suspendido de un soporte o del techo, que generalmente se utiliza para posicionar el cuerpo para la actividad sexual."},{"@language":"nl","@value":"Een type ligstoel dat aan een standaard of plafond hangt en dat doorgaans wordt gebruikt om het lichaam in de juiste positie te brengen voor seksuele activiteit."},{"@language":"sv","@value":"En typ av vilostol som hänger från ett stativ eller tak, vanligtvis använd för att positionera kroppen vid sexuell aktivitet."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001266"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000076"},{"@id":"https://homosaurus.org/v5/homoit0000445"},{"@id":"https://homosaurus.org/v5/homoit0000459"},{"@id":"https://homosaurus.org/v5/homoit0003059"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001266"},"dc:issued":{"@type":"xsd:date","@value":"2023-12-20"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000077","dc:identifier":"homoit0000077","skos:prefLabel":[{"@language":"en","@value":"Assigned female at birth"},{"@language":"de","@value":"Bei der Geburt weiblich zugewiesenes Geschlecht"},{"@language":"es","@value":"Asignadx sexo femenino al nacer"},{"@language":"fr","@value":"Assigné femme à la naissance"},{"@language":"nl","@value":"Toegewezen als vrouw bij geboorte"},{"@language":"sv","@value":"AFAB"}],"skos:altLabel":[{"@language":"en","@value":"AFAB"},{"@language":"en","@value":"Assigned F at birth"},{"@language":"en","@value":"Designated female at birth"},{"@language":"en","@value":"DFAB"},{"@language":"en","@value":"Female assigned at birth"},{"@language":"en","@value":"FAAB"},{"@language":"es","@value":"Asignado mujer al nacer"},{"@language":"es","@value":"Asignada mujer al nacer"},{"@language":"es","@value":"Asignado sexo femenino al nacer"},{"@language":"es","@value":"Asignada sexo femenino al nacer AMAN"},{"@language":"sv","@value":"Assigned female at birth Tilldelat kvinnligt kön vid födseln Tillskrivet kvinnligt kön vid födseln"}],"rdfs:comment":[{"@language":"en","@value":"The assignment of a female gender marker or a female sex designation shortly after birth.\r\n"},{"@language":"de","@value":"Die Zuweisung des weiblichen Geschlechts kurz nach der Geburt."},{"@language":"es","@value":"Asignación de un marcador de sexo femenino o una designación de sexo femenino poco después del nacimiento."},{"@language":"fr","@value":"Personnes assignées femme à la naissance"},{"@language":"nl","@value":"Een toewijzing van een vrouwelijke gender-aanduiding of een vrouwelijke geslachtsaanduiding kort na de geboorte."},{"@language":"sv","@value":"Tilldelning av kvinnligt kön eller en kvinnlig könsmarkör strax efter födseln."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000078"},{"@id":"https://homosaurus.org/v5/homoit0001268"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000272"},{"@id":"https://homosaurus.org/v5/homoit0001643"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/assignedFemaleAtBirth"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000078","dc:identifier":"homoit0000078","skos:prefLabel":[{"@language":"en","@value":"Assigned gender"},{"@language":"es","@value":"Género asignado"},{"@language":"de","@value":"Zugewiesenes soziales Geschlecht"},{"@language":"fr","@value":"Genre assigné"},{"@language":"nl","@value":"Gendertoewijzing"},{"@language":"sv","@value":"Tilldelat kön vid födelsen"}],"skos:altLabel":[{"@language":"fr","@value":"Genre assigné à la naissance"},{"@language":"sv","@value":"Kön tilldelat vid födseln"},{"@language":"sv","@value":"Kön tillskrivet vid födseln"},{"@language":"sv","@value":"Tillskrivet kön vid födseln"},{"@language":"sv","@value":"AGAB"}],"rdfs:comment":[{"@language":"en","@value":"The gender, typically \"girl\" or \"boy,\" ascribed to a child at birth or adolescence based on the child's perceived sex."},{"@language":"es","@value":"El género, típicamente \"niña\" o \"niño\", asignado a un infante al nacer o a un adolescente basado en su género percibido."},{"@language":"de","@value":"Soziales Geschlecht, in vielen Ländern \"weiblich\" oder \"männlich\", das Menschen, meist kurz nach der Geburt, zugewiesen wird."},{"@language":"fr","@value":"Genre, généralement « masculin » ou « féminin », assigné à la naissance ou à l'adolescence en fonction du sexe perçu."},{"@language":"nl","@value":"Het geslacht, meestal \"meisje\" of \"jongen\", toegeschreven aan een kind bij de geboorte of adolescentie op basis van het waargenomen geslacht van het kind"},{"@language":"sv","@value":"Kön, vanligtvis ”flicka” eller ”pojke”, som tillskrivs ett barn vid födseln eller under ungdomen baserat på barnets uppfattade kön."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000560"},{"@id":"https://homosaurus.org/v5/homoit0000571"}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000077"},{"@id":"https://homosaurus.org/v5/homoit0000079"},{"@id":"https://homosaurus.org/v5/homoit0000120"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000118"},{"@id":"https://homosaurus.org/v5/homoit0000266"},{"@id":"https://homosaurus.org/v5/homoit0000288"},{"@id":"https://homosaurus.org/v5/homoit0001465"},{"@id":"https://homosaurus.org/v5/homoit0001648"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/assignedGender"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001268","dc:identifier":"homoit0001268","skos:prefLabel":[{"@language":"en","@value":"Sex assigned at birth"},{"@language":"es","@value":"Sexo asignado al nacer"},{"@language":"fr","@value":"Sexe assigné à la naissance"},{"@language":"nl","@value":"Toegewezen geslacht bij geboorte"},{"@language":"sv","@value":"Könstildelning vid födseln"}],"skos:altLabel":[{"@language":"en","@value":"Birth sex"},{"@language":"en","@value":"Birth-assigned sex"},{"@language":"en","@value":"Natal sex"},{"@language":"en","@value":"Sex at birth"},{"@language":"en","@value":"Sex reported at birth"},{"@language":"en","@value":"ASAB "},{"@language":"en","@value":"SAAB"},{"@language":"es","@value":"Asignación de sexo"},{"@language":"es","@value":"Sexo al nacer"},{"@language":"fr","@value":"Sexe attribué à la naissance"},{"@language":"nl","@value":"Geslacht bij geboorte"},{"@language":"nl","@value":"Geslacht toegewezen bij de geboorte"},{"@language":"nl","@value":"Geslacht vermeld bij geboorte"},{"@language":"sv","@value":"Kön tilldelat vid födseln"},{"@language":"sv","@value":"Kön tillskrivet vid födseln"},{"@language":"sv","@value":"Tilldelat kön"},{"@language":"sv","@value":"Tillskrivet kön"},{"@language":"sv","@value":"Tillskrivet kön vid födseln"}],"rdfs:comment":[{"@language":"en","@value":"The process of determining an individual’s sex relatively shortly after birth, usually documented on official records, such as a birth certificate. Determination is usually based on the appearance of external genitalia but may use other methodologies. In practice, sex assigned at birth is often culturally variable; the term “gender assigned at birth” is often more applicable or accurate."},{"@language":"es","@value":"El proceso de determinar el sexo de una persona relativamente poco después del nacimiento, generalmente documentado en registros oficiales, como un certificado de nacimiento. La determinación suele basarse en la apariencia de los genitales externos, pero puede utilizar otras metodologías. En la práctica, el sexo asignado al nacer suele variar culturalmente; el término “género asignado al nacer” suele ser más aplicable o preciso."},{"@language":"fr","@value":"Sexe assigné au moment de la naissance, et consigné dans les documents officiels comme le certificat de naissance, déterminé selon l'évaluation de caractéristiques sexuelles, notamment les organes génitaux externes, les chromosomes et les hormones. En pratique, le sexe attribué à la naissance varie souvent selon les cultures; le terme « genre assigné à la naissance » est souvent plus approprié ou plus précis."},{"@language":"nl","@value":"Label of kenmerk die door een medische professional aan een baby is toegekend om aan te geven of de baby mannelijk, vrouwelijk, intersekse of een andere categorie is, meestal door middel van een uitwendig onderzoek van de geslachtsorganen van de baby."},{"@language":"sv","@value":"Ett främst engelskspråkigt begrepp som grundar sig i de två engelska termerna \"sex\" och \"gender\" där denna term handlar om \"sex\", inte \"gender\". Processen att fastställa en individs kön (sex) strax efter födseln, vanligtvis dokumenterad i officiella handlingar. Bedömningen baseras vanligen på yttre genitalier men kan också omfatta andra metoder. I praktiken är tilldelning av kön (sex) vid födsel kulturellt varierande, ofta är termen ”Kön tilldelat vid födsel” mer tillämplig eller korrekt."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001648"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000077"},{"@id":"https://homosaurus.org/v5/homoit0000079"},{"@id":"https://homosaurus.org/v5/homoit0001646"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000120"},{"@id":"https://homosaurus.org/v5/homoit0000585"},{"@id":"https://homosaurus.org/v5/homoit0000600"},{"@id":"https://homosaurus.org/v5/homoit0000668"},{"@id":"https://homosaurus.org/v5/homoit0000669"},{"@id":"https://homosaurus.org/v5/homoit0000670"},{"@id":"https://homosaurus.org/v5/homoit0001006"},{"@id":"https://homosaurus.org/v5/homoit0001099"},{"@id":"https://homosaurus.org/v5/homoit0001488"},{"@id":"https://homosaurus.org/v5/homoit0001896"},{"@id":"https://homosaurus.org/v5/homoit0001897"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001269"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sexAssignedAtBirth"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000272","dc:identifier":"homoit0000272","skos:prefLabel":[{"@language":"en","@value":"Cisgender women"},{"@language":"es","@value":"Mujeres cisgénero"},{"@language":"de","@value":"Cis Frauen"},{"@language":"nl","@value":"Cisgender vrouwen"},{"@language":"sv","@value":"Ciskvinnor"}],"skos:altLabel":{"@language":"es","@value":"Mujeres cis"},"rdfs:comment":[{"@language":"en","@value":"Women whose gender identity matches the sex or gender they were assigned at birth. "},{"@language":"es","@value":"Mujeres cuya identidad de género coincide con el género o sexo que les fue asignado al nacer."},{"@language":"de","@value":"Frauen, deren Geschlechtsidentität mit dem Geschlecht übereinstimmt, das ihnen bei der Geburt zugewiesen wurde."},{"@language":"nl","@value":"Vrouwen wiens genderidentiteit overeenkomt met hun gender of geslacht dat bij de geboorte is toegewezen."},{"@language":"sv","@value":"Kvinnor vars könsidentitet överensstämmer med det kön de tilldelades vid födseln."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000271"},{"@id":"https://homosaurus.org/v5/homoit0001509"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000077"},{"@id":"https://homosaurus.org/v5/homoit0001925"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000271"},"dc:replaces":{"@id":"http://homosaurus.org/v2/cisgenderWomen"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001643","dc:identifier":"homoit0001643","skos:prefLabel":[{"@language":"en","@value":"Transgender men"},{"@language":"es","@value":"Hombres trans"},{"@language":"fr","@value":"Hommes trans"},{"@language":"nl","@value":"Transmannen"},{"@language":"sv","@value":"Transmän"}],"skos:altLabel":[{"@language":"en","@value":"Transmen"},{"@language":"en","@value":"Trans-men"},{"@language":"en","@value":"Trans men"},{"@language":"es","@value":"Hombres transgénero"},{"@language":"nl","@value":"Transgender mannen"}],"rdfs:comment":[{"@language":"en","@value":"Men who are transgender."},{"@language":"es","@value":"Hombres a los que se les asignó al sexo femenino al nacer."},{"@language":"fr","@value":"Hommes dont le genre assigné à la naissance n'était pas masculin. Ne pas utiliser pour les personnes intersexes, à moins que la personne intersexe ne s'identifie comme un homme trans."},{"@language":"nl","@value":"Mannen die werden toegewezen als vrouw bij geboorte."},{"@language":"sv","@value":"Män som inte tilldelades manligt kön vid födseln. Används inte för intersexpersoner om de inte själva identifierar sig som transmän."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001008"},{"@id":"https://homosaurus.org/v5/homoit0001378"}],"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0000436"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000077"},{"@id":"https://homosaurus.org/v5/homoit0000114"},{"@id":"https://homosaurus.org/v5/homoit0001362"},{"@id":"https://homosaurus.org/v5/homoit0001820"},{"@id":"https://homosaurus.org/v5/homoit0002061"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2018002395"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transMen"},"dc:issued":{"@type":"xsd:date","@value":"2020-12-11"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000079","dc:identifier":"homoit0000079","skos:prefLabel":[{"@language":"en","@value":"Assigned male at birth"},{"@language":"de","@value":"Bei der Geburt männlich zugewiesenes Geschlecht"},{"@language":"es","@value":"Asignadx sexo masculino al nacer"},{"@language":"fr","@value":"Assigné homme à la naissance"},{"@language":"nl","@value":"Toegewezen als man bij geboorte"},{"@language":"sv","@value":"AMAB"}],"skos:altLabel":[{"@language":"en","@value":"AMAB"},{"@language":"en","@value":"Assigned M at birth"},{"@language":"en","@value":"Designated male at birth"},{"@language":"en","@value":"DMAB"},{"@language":"en","@value":"Male assigned at birth"},{"@language":"en","@value":"MAAB"},{"@language":"es","@value":"Asignado hombre al nacer"},{"@language":"es","@value":"Asignada hombre al nacer"},{"@language":"es","@value":"Asignada sexo masculino al nacer"},{"@language":"es","@value":"Asignado sexo masculino al nacer"},{"@language":"es","@value":"AHAN"},{"@language":"fr","@value":"Personne assignée homme à la naissance"},{"@language":"sv","@value":"Assigned male at birth Tilldelat manligt kön vid födseln Tillskrivet manligt kön vid födseln"}],"rdfs:comment":[{"@language":"en","@value":"The assignment of a male gender marker or a male sex designation shortly after birth.\r\n"},{"@language":"de","@value":"Die Zuweisung des männlichen Geschlechts kurz nach der Geburt."},{"@language":"es","@value":"Asignación de un marcador de género masculino o una designación de sexo masculino poco después del nacimiento."},{"@language":"fr","@value":"Genre masculin assigné à une personne à la naissance."},{"@language":"nl","@value":"Een toewijzing van een mannelijke gender-aanduiding of een mannelijke geslachtsaanduiding kort na de geboorte."},{"@language":"sv","@value":"Tilldelning av ett manligt kön eller en manlig könsmarkör strax efter födseln."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000078"},{"@id":"https://homosaurus.org/v5/homoit0001268"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000270"},{"@id":"https://homosaurus.org/v5/homoit0001642"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/assignedMaleAtBirth"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000120","dc:identifier":"homoit0000120","skos:prefLabel":[{"@language":"en","@value":"Gender assigned at birth"},{"@language":"es","@value":"Género asignado al nacer"},{"@language":"fr","@value":"Genre assigné à la naissance"},{"@language":"nl","@value":"Gendertoewijzing bij geboorte"},{"@language":"sv","@value":"Kön tilldelat vid födseln"}],"skos:altLabel":[{"@language":"en","@value":"Birth gender"},{"@language":"en","@value":"Natal gender"},{"@language":"en","@value":"GAAB"},{"@language":"en","@value":"Assigned gender at birth"},{"@language":"en","@value":"AGAB"},{"@language":"en","@value":"Designated gender at birth"},{"@language":"en","@value":"DGAB"},{"@language":"en","@value":"Gender at birth"},{"@language":"fr","@value":"Genre attribué à la naissance"},{"@language":"sv","@value":"Kön tilldelat vid födseln"},{"@language":"sv","@value":"Kön tillskrivet vid födseln"},{"@language":"sv","@value":"Tilldelat kön"},{"@language":"sv","@value":"Tillskrivet kön"},{"@language":"sv","@value":"Tillskrivet kön vid födseln"}],"rdfs:comment":[{"@language":"en","@value":"The legal gender marker recorded in birth-related certifications and registries. Often but not always used synonymously with “sex assigned at birth.\" Also used in reference to the gendered roles and expectations associated with said gender marker."},{"@language":"es","@value":"El marcador legal de género registrado en las certificaciones y registros relacionados con el nacimiento. A menudo, pero no siempre, se utiliza como sinónimo de \"sexo asignado al nacer\". También se utiliza en referencia a los roles de género y las expectativas asociadas con dicho marcador de género."},{"@language":"fr","@value":"Marqueur de genre légal figurant sur les certificats et registres liés à la naissance. Souvent, mais pas toujours, synonyme de « sexe assigné à la naissance ». Également utilisé en référence aux rôles et attentes associés à ce marqueur de genre."},{"@language":"nl","@value":"De wettelijke geslachtsmarkering vastgelegd in geboortegerelateerde certificeringen en registers. Vaak synoniem gebruikt met \"geslacht toegewezen bij de geboorte\", maar niet altijd. Wordt ook gebruikt met betrekking tot de genderrollen en verwachtingen die verband houden met de gendermarkering."},{"@language":"sv","@value":"Det juridiska kön som registreras i samband med födelse i certifikat och register. Kan också syfta på de könsroller och förväntningar som är knutna till detta kön."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000078"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000118"},{"@id":"https://homosaurus.org/v5/homoit0000119"},{"@id":"https://homosaurus.org/v5/homoit0000271"},{"@id":"https://homosaurus.org/v5/homoit0000567"},{"@id":"https://homosaurus.org/v5/homoit0000573"},{"@id":"https://homosaurus.org/v5/homoit0001268"},{"@id":"https://homosaurus.org/v5/homoit0001378"},{"@id":"https://homosaurus.org/v5/homoit0002256"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/genderAssignedAtBirth"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000118","dc:identifier":"homoit0000118","skos:prefLabel":[{"@language":"en","@value":"Birth certificate amendments"},{"@language":"es","@value":"Enmiendas al certificado de nacimiento"},{"@language":"de","@value":"Änderung der Geburtsurkunde"},{"@language":"fr","@value":"Modification du certificat de naissance"},{"@language":"nl","@value":"Wijzigingen in de geboorteakte"},{"@language":"sv","@value":"Födelseattesttillägg"}],"rdfs:comment":[{"@language":"en","@value":"Formal changes to an individual's birth certificate, typically to reflect a change to the individual's legal name or gender or sex marker."},{"@language":"es","@value":"Cambios formales al certificado de nacimiento de una persona, normalmente para reflejar un cambio en su nombre legal, o de su marca de género o sexo."},{"@language":"de","@value":"Formale Änderung der Geburtsurkunde, typischerweise um eine Anpassung des gesetzlichen Namens oder des Geschlechts bzw. der Geschlechtsmerkmale widerzuspiegeln."},{"@language":"fr","@value":"Changements officiels apportés à l'acte de naissance d'une personne, généralement pour refléter une modification de son nom légal ou de la mention de son genre ou de son sexe."},{"@language":"nl","@value":"Formele wijzigingen in de geboorteakte van een persoon, meestal vanwege een wijziging in de wettelijke naam of gender- of geslachtsaanduiding van de persoon"},{"@language":"sv","@value":"Formella ändringar av en individs födelsebevis, vanligtvis för att återspegla en förändring av individens juridiska namn eller könsmarkör. Förekommer inte i Sverige."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000119"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000078"},{"@id":"https://homosaurus.org/v5/homoit0000120"},{"@id":"https://homosaurus.org/v5/homoit0000918"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000712"},"dc:replaces":{"@id":"http://homosaurus.org/v2/birthCertificateAmendments"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000266","dc:identifier":"homoit0000266","skos:prefLabel":[{"@language":"en","@value":"Chromosomes"},{"@language":"es","@value":"Cromosomas"},{"@language":"de","@value":"Chromosomen"},{"@language":"nl","@value":"Chromosomen"},{"@language":"sv","@value":"Kromosomer"}],"rdfs:comment":[{"@language":"en","@value":"Structures found in the nucleus of most living cells that carry genetic information in the form of genes. Often used in reference to sex chromosomes, a type of chromosome involved in sex determination."},{"@language":"es","@value":"Estructuras que se encuentran en el núcleo de la mayoría de las células vivas y que transportan información genética en forma de genes. A menudo, se utiliza en referencia a los cromosomas sexuales, un tipo de cromosoma involucrado en la determinación del sexo."},{"@language":"de","@value":"Strukturen, die im Nukleus der meisten lebenden Zellen vorkommen und genetische Informationen in Form von Genen tragen. Wird häufig in Bezug auf Geschlechtschromosomen verwendet, eine Art von Chromosomen, die an der Geschlechtsbestimmung beteiligt sind."},{"@language":"nl","@value":"Structuren in de kern van de meeste levende cellen die genetische informatie in de vorm van genen dragen. Vaak gebruikt met betrekking tot geslachtschromosomen, een type chromosoom dat betrokken is bij geslachtsbepaling."},{"@language":"sv","@value":"Kromosomerna är lokaliserade i cellkärnan och bär på genetisk information i form av DNA som kodar hur individen utvecklas. En typisk uppsättning kromosomer består av 46 stycken eller 23 kromosompar, där 46,XX (typiskt definierad som kvinna) och 46,XY (typiskt defninerad som man) är könskromosomer och kodar för könstillhörighet. Utöver dessa kombinationer finns flera intersexvariationer med variationer i antal kromosomer och olika uppsättningar av könskromosomer som till exempel 45,X (Turners syndrom)."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001269"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000078"},{"@id":"https://homosaurus.org/v5/homoit0001648"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85025391"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001269"},"dc:replaces":{"@id":"http://homosaurus.org/v2/chromosomes"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000288","dc:identifier":"homoit0000288","skos:prefLabel":[{"@language":"en","@value":"Stealth (Transgender)"},{"@language":"es","@value":"Discreción (transgénero)"},{"@language":"nl","@value":"Stealth (Transgender)"},{"@language":"sv","@value":"Stealth (transpersoner)"}],"skos:altLabel":[{"@language":"en","@value":"Stealth"},{"@language":"es","@value":"Stealth"}],"rdfs:comment":[{"@language":"en","@value":"Term used to describe the experience of a trans person who is not openly trans and is choosing to pass as cisgender."},{"@language":"es","@value":"Término utilizado para describir la experiencia de una persona trans que no es abiertamente trans y elige hacerse pasar por cisgénero."},{"@language":"nl","@value":"Passing als cisgender."},{"@language":"sv","@value":"Term som beskriver erfarenheten hos en transperson som inte lever öppet som trans och väljer att passera som cis."}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000078"},{"@id":"https://homosaurus.org/v5/homoit0000295"},{"@id":"https://homosaurus.org/v5/homoit0000560"},{"@id":"https://homosaurus.org/v5/homoit0001065"},{"@id":"https://homosaurus.org/v5/homoit0001090"},{"@id":"https://homosaurus.org/v5/homoit0001261"},{"@id":"https://homosaurus.org/v5/homoit0001378"},{"@id":"https://homosaurus.org/v5/homoit0001781"},{"@id":"https://homosaurus.org/v5/homoit0001783"},{"@id":"https://homosaurus.org/v5/homoit0001784"},{"@id":"https://homosaurus.org/v5/homoit0001785"},{"@id":"https://homosaurus.org/v5/homoit0001786"},{"@id":"https://homosaurus.org/v5/homoit0001787"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000288"},"dc:replaces":{"@id":"http://homosaurus.org/v2/stealthTransgender"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001465","dc:identifier":"homoit0001465","skos:prefLabel":[{"@language":"en","@value":"Transitioning (Gender)"},{"@language":"es","@value":"Transición (Género)"},{"@language":"fr","@value":"Transition"},{"@language":"nl","@value":"Transitie (Gender)"},{"@language":"sv","@value":"Transitionering"}],"skos:altLabel":[{"@language":"en","@value":"Transitioning (Transgender)"},{"@language":"es","@value":"Transición (Transgénero)"},{"@language":"fr","@value":"Transition de genre"},{"@language":"sv","@value":"Transitionera"}],"rdfs:comment":[{"@language":"en","@value":"The process of changing one's gender presentation to affirm one's internal sense of gender; can include social or medical transition."},{"@language":"es","@value":"El proceso de cambiar la presentación de género para afirmar el sentido propio del género; puede incluir una transición social o médica."},{"@language":"fr","@value":"Processus d'affirmation de l'identité de genre d'une personne pour qu'il corresponde au ressenti intérieur de son genre; peut inclure une transition sociale, juridique et médicale."},{"@language":"nl","@value":"Het proces van het veranderen van iemands genderpresentatie om iemands interne gevoel van gender te bevestigen; kan sociale of medische transitie omvatten"},{"@language":"sv","@value":"Processen att förändra sitt könsuttryck för att bekräfta sin könsidentitet. Det kan inkludera både social och medicinsk transition."}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0001464"},{"@id":"https://homosaurus.org/v5/homoit0001834"},{"@id":"https://homosaurus.org/v5/homoit0001835"},{"@id":"https://homosaurus.org/v5/homoit0001836"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000078"},{"@id":"https://homosaurus.org/v5/homoit0000119"},{"@id":"https://homosaurus.org/v5/homoit0000377"},{"@id":"https://homosaurus.org/v5/homoit0000561"},{"@id":"https://homosaurus.org/v5/homoit0000571"},{"@id":"https://homosaurus.org/v5/homoit0000573"},{"@id":"https://homosaurus.org/v5/homoit0000584"},{"@id":"https://homosaurus.org/v5/homoit0000606"},{"@id":"https://homosaurus.org/v5/homoit0001005"},{"@id":"https://homosaurus.org/v5/homoit0001092"},{"@id":"https://homosaurus.org/v5/homoit0001324"},{"@id":"https://homosaurus.org/v5/homoit0001378"},{"@id":"https://homosaurus.org/v5/homoit0001381"},{"@id":"https://homosaurus.org/v5/homoit0001468"},{"@id":"https://homosaurus.org/v5/homoit0001496"},{"@id":"https://homosaurus.org/v5/homoit0001837"},{"@id":"https://homosaurus.org/v5/homoit0001838"},{"@id":"https://homosaurus.org/v5/homoit0001839"},{"@id":"https://homosaurus.org/v5/homoit0001840"},{"@id":"https://homosaurus.org/v5/homoit0001841"},{"@id":"https://homosaurus.org/v5/homoit0001842"},{"@id":"https://homosaurus.org/v5/homoit0001843"},{"@id":"https://homosaurus.org/v5/homoit0001844"},{"@id":"https://homosaurus.org/v5/homoit0001845"},{"@id":"https://homosaurus.org/v5/homoit0001846"},{"@id":"https://homosaurus.org/v5/homoit0001847"},{"@id":"https://homosaurus.org/v5/homoit0001848"},{"@id":"https://homosaurus.org/v5/homoit0001849"},{"@id":"https://homosaurus.org/v5/homoit0001850"},{"@id":"https://homosaurus.org/v5/homoit0001851"},{"@id":"https://homosaurus.org/v5/homoit0001894"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2020000100"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001465"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transitioningTransgender"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001648","dc:identifier":"homoit0001648","skos:prefLabel":[{"@language":"en","@value":"Assigned sex"},{"@language":"es","@value":"Sexo asignado"},{"@language":"de","@value":"Zugewiesenes Geschlecht"},{"@language":"fr","@value":"Sexe assigné"},{"@language":"nl","@value":"Toegewezen geslacht"},{"@language":"sv","@value":"Tilldelat kön"}],"skos:altLabel":[{"@language":"fr","@value":"Sexe assigné à la naissance"},{"@language":"fr","@value":"Sexe attribué à la naissance"}],"rdfs:comment":[{"@language":"en","@value":"An individual's sex as determined by a medical practitioner or provider. Determination is usually based on the appearance of external genitalia but may use other methodologies. In practice, sex assigned at birth is often culturally variable; the term \"assigned gender\" is often more applicable or accurate.\r\n"},{"@language":"es","@value":"El sexo de una persona determinado por un médico. La determinación suele basarse en la apariencia de los genitales externos, pero pueden utilizarse otras metodologías. En la práctica, el sexo asignado al nacer suele variar culturalmente; el término \"género asignado\" suele ser más aplicable o preciso."},{"@language":"de","@value":"Das Geschlecht einer Person, wie es von Ärzt:innen oder medizinischem Personal bestimmt wird. Die Bestimmung basiert in der Regel auf dem Aussehen der äußeren Genitalien, kann jedoch auch andere Methoden umfassen. In der Praxis ist das bei der Geburt zugewiesene Geschlecht oft kulturell variabel; der Begriff „zugewiesenes Geschlecht“ ist daher oft passender oder genauer."},{"@language":"fr","@value":"Sexe assigné à une personne selon des normes médicales, en se basant généralement sur l'apparence des organes génitaux externes."},{"@language":"nl","@value":"Het geslacht van een persoon zoals bepaald door een arts of zorgverlener. Bepaling is meestal gebaseerd op het uiterlijk van externe genitaliën, maar kan ook via het gebruik van andere methoden. In de praktijk is het geslacht dat bij de geboorte wordt toegekend vaak cultureel variabel; de term \"toegewezen gender\" is vaak toepasselijker of nauwkeuriger."},{"@language":"sv","@value":"En individs kön som fastställs av en medicinsk yrkesperson eller vårdgivare. Fastställandet baseras vanligtvis på yttre könsorgan, men andra metoder kan också användas. I praktiken är det kön som tilldelas vid födseln ofta kulturellt varierande, och termen ”tilldelat kön” är ofta mer tillämplig eller exakt."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001269"},"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0001268"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000078"},{"@id":"https://homosaurus.org/v5/homoit0000266"},{"@id":"https://homosaurus.org/v5/homoit0001896"},{"@id":"https://homosaurus.org/v5/homoit0001897"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001269"},"dc:replaces":{"@id":"http://homosaurus.org/v2/assignedSex"},"dc:issued":{"@type":"xsd:date","@value":"2021-06-30"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000270","dc:identifier":"homoit0000270","skos:prefLabel":[{"@language":"en","@value":"Cisgender men"},{"@language":"es","@value":"Hombres cisgénero"},{"@language":"de","@value":"Cis Männer"},{"@language":"nl","@value":"Cisgender mannen"},{"@language":"sv","@value":"Cismän"}],"skos:altLabel":{"@language":"es","@value":"Hombre cis"},"rdfs:comment":[{"@language":"en","@value":"Men whose gender identity matches the sex or gender they were assigned at birth."},{"@language":"es","@value":"Hombres cuya identidad de género coincide con el sexo o género que les fue asignado al nacer."},{"@language":"de","@value":"Männer, deren Geschlechtsidentität mit dem Geschlecht übereinstimmt, das ihnen bei der Geburt zugewiesen wurde."},{"@language":"nl","@value":"Mannen wiens genderidentiteit overeenkomt met hun gender of geslacht dat bij de geboorte is toegewezen."},{"@language":"sv","@value":"Män vars könsidentitet överensstämmer med det kön de tilldelades vid födseln."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000271"},{"@id":"https://homosaurus.org/v5/homoit0001008"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000079"},{"@id":"https://homosaurus.org/v5/homoit0001925"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000271"},"dc:replaces":{"@id":"http://homosaurus.org/v2/cisgenderMen"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001642","dc:identifier":"homoit0001642","skos:prefLabel":[{"@language":"en","@value":"Transgender women"},{"@language":"es","@value":"Mujeres transgénero"},{"@language":"fr","@value":"Femmes trans"},{"@language":"nl","@value":"Transvrouwen"},{"@language":"sv","@value":"Transkvinnor"}],"skos:altLabel":[{"@language":"en","@value":"Transwomen"},{"@language":"en","@value":"Trans-women"},{"@language":"en","@value":"Trans women"},{"@language":"es","@value":"Mujeres trans"}],"rdfs:comment":[{"@language":"en","@value":"Women who are transgender. "},{"@language":"es","@value":"Mujeres a las que se les asignó al sexo masculino al nacer."},{"@language":"fr","@value":"Femmes dont le genre assigné à la naissance n'était pas féminin. Ne pas utiliser pour les personnes intersexes, à moins que la personne intersexe ne s'identifie comme une femme trans."},{"@language":"nl","@value":"Vrouwen die werden toegewezen als man bij geboorte"},{"@language":"sv","@value":"Kvinnor som inte tilldelades kvinnligt kön vid födseln. Använd inte för intersexpersoner om de inte själva identifierar sig som transkvinnor."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001378"},{"@id":"https://homosaurus.org/v5/homoit0001509"}],"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0000986"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000079"},{"@id":"https://homosaurus.org/v5/homoit0000407"},{"@id":"https://homosaurus.org/v5/homoit0001821"},{"@id":"https://homosaurus.org/v5/homoit0002043"},{"@id":"https://homosaurus.org/v5/homoit0002274"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2018002623"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transWomen"},"dc:issued":{"@type":"xsd:date","@value":"2020-12-11"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000080","dc:identifier":"homoit0000080","skos:prefLabel":[{"@language":"en-us","@value":"Normalization"},{"@language":"es","@value":"Normalización"},{"@language":"nl","@value":"Normalisering"},{"@language":"sv","@value":"Normalisering"},{"@language":"en-gb","@value":"Normalisation"}],"skos:altLabel":[{"@language":"en","@value":"Assimilation"},{"@language":"es","@value":"Asimilación"}],"rdfs:comment":[{"@language":"en","@value":"Social processes through which ideas, characteristics, and behaviors come to be seen as \"normal\" or \"natural\" and accepted as such."},{"@language":"es","@value":"Procesos sociales a través de los cuales ideas, características y conductas llegan a ser vistas como \"normales\" o \"naturales\" y aceptadas como tales."},{"@language":"nl","@value":"Sociale processen waardoor ideeën, kenmerken en gedragingen als 'normaal' of 'natuurlijk' worden gezien en als zodanig worden geaccepteerd."},{"@language":"sv","@value":"Sociala processer där idéer, egenskaper och beteenden kommer att uppfattas som ”normala” eller ”naturliga” och accepteras som sådana."}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000620"},{"@id":"https://homosaurus.org/v5/homoit0000644"},{"@id":"https://homosaurus.org/v5/homoit0000947"},{"@id":"https://homosaurus.org/v5/homoit0001323"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000080"},"dc:replaces":{"@id":"http://homosaurus.org/v2/normalisation"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000620","dc:identifier":"homoit0000620","skos:prefLabel":[{"@language":"en","@value":"Heteronormativity"},{"@language":"es","@value":"Heteronormatividad"},{"@language":"de","@value":"Heteronormativität"},{"@language":"nl","@value":"Heteronormativiteit"},{"@language":"sv","@value":"Heteronormativitet"}],"skos:altLabel":[{"@language":"en","@value":"Heterosexual norms"},{"@language":"es","@value":"Normas heteronormativas"}],"rdfs:comment":[{"@language":"en","@value":"The notion or belief that heterosexuality is the normal or preferred sexual orientation."},{"@language":"es","@value":"La noción o creencia de que la heterosexualidad es la orientación sexual normal o preferida."},{"@language":"de","@value":"Die Vorstellung oder der Glaube, dass Heterosexualität die normale oder bevorzugte sexuelle Orientierung ist."},{"@language":"nl","@value":"Het idee dat heteroseksualiteit de normale of te prefereren seksuele oriëntatie is"},{"@language":"sv","@value":"Föreställningen eller tron att heterosexualitet är den normala eller föredragna sexuella läggningen."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001323"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000080"},{"@id":"https://homosaurus.org/v5/homoit0000619"},{"@id":"https://homosaurus.org/v5/homoit0000644"},{"@id":"https://homosaurus.org/v5/homoit0003445"},{"@id":"https://homosaurus.org/v5/homoit0003989"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh93002513"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001323"},"dc:replaces":{"@id":"http://homosaurus.org/v2/heteronormativity"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000644","dc:identifier":"homoit0000644","skos:prefLabel":[{"@language":"en","@value":"Homonormativity"},{"@language":"es","@value":"Homonormatividad"},{"@language":"de","@value":"Homonormativität"},{"@language":"nl","@value":"Homonormativiteit"},{"@language":"sv","@value":"Homonormativitet"}],"skos:altLabel":[{"@language":"en","@value":"Homosexual norms"},{"@language":"es","@value":"Normas homosexuales"}],"rdfs:comment":[{"@language":"en","@value":"The projection of heteronormative ideals and constructs onto LGBTQ+ cultures and identities, predicated on the assumption that LGBTQ+ people (particularly cisgender gay men and lesbians) must conform to the norms and values of heterosexuality (e.g., the gender binary, marriage, procreation, and monogamy) in order to be viewed as \"normal\" and gain social acceptance. "},{"@language":"es","@value":"La proyección de ideales y construcciones homonormativas en culturas e identidades LGBTQ+, basada en el supuesto de que las personas LGBTQ+ (particularmente hombres gay y lesbianas cisgénero) deben ajustarse a las normas y valores de la heterosexualidad (por ejemplo, el binario de género, el matrimonio, la procreación y la monogamia) para ser vistos como \"normales\" y ganar aceptación social."},{"@language":"de","@value":"Die Übertragung heteronormativer Ideale und Konstrukte auf LGBTQ+-Kulturen und -Identitäten, die auf der Annahme beruht, dass LGBTQ+-Personen (insbesondere cis schwule Männer und Lesben) sich den Normen und Werten der Heterosexualität (z. B. der binären Geschlechterordnung, Ehe, Fortpflanzung und Monogamie) anpassen müssen, um als „normal“ angesehen zu werden und gesellschaftliche Akzeptanz zu erlangen."},{"@language":"nl","@value":"Het bevoordelen van heteronormatieve idealen en constructies op LHBTQ+-culturen en -identiteiten, gebaseerd op de veronderstelling dat LHBTQ+-personen (met name cisgender homomannen en lesbische vrouwen) zich moeten conformeren aan de normen en waarden van heteroseksualiteit (bijv. ) om als \"normaal\" te worden beschouwd en sociale acceptatie te krijgen."},{"@language":"sv","@value":"Projicering av heteronormativa ideal och strukturer på hbtq+-kulturer och identiteter, med utgångspunkt i föreställningen att hbtq+-personer (särskilt ciskönade bögar och lesbiska) måste anpassa sig till heterosexualitetens normer – som könsbinaritet, äktenskap, barnafödande och monogami – för att betraktas som ”normala” och uppnå social acceptans."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001323"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000080"},{"@id":"https://homosaurus.org/v5/homoit0000620"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001323"},"dc:replaces":{"@id":"http://homosaurus.org/v2/homonormativity"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000947","dc:identifier":"homoit0000947","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ social processes"},{"@language":"es","@value":"Procesos sociales LGBTQ+"},{"@language":"nl","@value":"LHBTQ+-sociale processen"},{"@language":"sv","@value":"Sociala processer (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"LGBTQ social processes"},{"@language":"es","@value":"Procesos sociales LGBTQ"}],"rdfs:comment":[{"@language":"en","@value":"Forms of social interaction that occur repeatedly; use to describe the ways in which LGBTQ+ people interact and establish social relationships."},{"@language":"es","@value":"Formas de interacción social que ocurren repetidamente; utilícese para describir las formas en que las personas LGBTQ+ interactúan y establecen relaciones sociales."},{"@language":"nl","@value":"Vormen van sociale interactie die herhaaldelijk voorkomen; deze term gebruiken om de wijze te beschrijven hoe LHBTQ+-personen met elkaar omgaan en sociale relaties aangaan."},{"@language":"sv","@value":"Sociala interaktioner som återkommer över tid. Används för att beskriva hur hbtq+-personer umgås och bygger sociala relationer."}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000500"},{"@id":"https://homosaurus.org/v5/homoit0000538"},{"@id":"https://homosaurus.org/v5/homoit0000575"},{"@id":"https://homosaurus.org/v5/homoit0000748"},{"@id":"https://homosaurus.org/v5/homoit0000857"},{"@id":"https://homosaurus.org/v5/homoit0000960"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000080"},{"@id":"https://homosaurus.org/v5/homoit0001273"},{"@id":"https://homosaurus.org/v5/homoit0001301"},{"@id":"https://homosaurus.org/v5/homoit0001303"},{"@id":"https://homosaurus.org/v5/homoit0003694"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000947"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQSocialProcesses"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001323","dc:identifier":"homoit0001323","skos:prefLabel":[{"@language":"en","@value":"Social norms"},{"@language":"es","@value":"Normas sociales"},{"@language":"nl","@value":"Sociale normen"},{"@language":"sv","@value":"Sociala normer"}],"skos:altLabel":[{"@language":"es","@value":"Reglas sociales"},{"@language":"nl","@value":"Normen en waarden"}],"rdfs:comment":[{"@language":"en","@value":"Group-held beliefs about how members of that group should behave in a given context."},{"@language":"es","@value":"Creencias grupales sobre cómo deberían comportarse los miembros de tal grupo en un contexto determinado."},{"@language":"nl","@value":"groepsgebonden overtuigingen hoe men zich dient te gedragen in bepaalde situaties"},{"@language":"sv","@value":"Gemensamma föreställningar inom en grupp om hur medlemmarna bör bete sig i ett givet sammanhang."}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000620"},{"@id":"https://homosaurus.org/v5/homoit0000644"},{"@id":"https://homosaurus.org/v5/homoit0001532"},{"@id":"https://homosaurus.org/v5/homoit0001535"},{"@id":"https://homosaurus.org/v5/homoit0001555"},{"@id":"https://homosaurus.org/v5/homoit0003985"},{"@id":"https://homosaurus.org/v5/homoit0003989"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000080"},{"@id":"https://homosaurus.org/v5/homoit0000643"},{"@id":"https://homosaurus.org/v5/homoit0001241"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85123980"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001323"},"dc:replaces":{"@id":"http://homosaurus.org/v2/socialNorms"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000232","dc:identifier":"homoit0000232","skos:prefLabel":[{"@language":"en","@value":"Butt"},{"@language":"es","@value":"Nalgas"},{"@language":"de","@value":"Hintern"},{"@language":"nl","@value":"Bil"},{"@language":"sv","@value":"Skinkor"}],"skos:altLabel":[{"@language":"en","@value":"Arse"},{"@language":"en","@value":"Ass"},{"@language":"en","@value":"Bum"},{"@language":"en","@value":"Buttock"},{"@language":"en","@val