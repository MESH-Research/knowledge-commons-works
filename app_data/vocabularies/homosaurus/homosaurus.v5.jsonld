"}],"rdfs:comment":[{"@language":"en","@value":"Queer people who are getting married and identify as a bride."},{"@language":"nl","@value":"Queer personen die gaan trouwen en zich identificeren als bruid."},{"@language":"sv","@value":"Queera personer som ska gifta sig och identifierar sig som brudar."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0004360"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0004344"},{"@id":"https://homosaurus.org/v5/homoit0004376"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2026-02-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004378","dc:identifier":"homoit0004378","skos:prefLabel":[{"@language":"en","@value":"Intersex grooms"},{"@language":"nl","@value":"Intersekse bruidegoms"},{"@language":"sv","@value":"Brudgummar som är intersexpersoner"}],"skos:altLabel":{"@language":"sv","@value":"Brudgummar som är intersex"},"rdfs:comment":[{"@language":"en","@value":"Intersex people who are getting married and identify as a groom."},{"@language":"nl","@value":"Intersekse personen die gaan trouwen en zich identificeren als bruidegom."},{"@language":"sv","@value":"Intersexpersoner som ska gifta sig och identifierar sig som brudgummar."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0004361"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0004345"},{"@id":"https://homosaurus.org/v5/homoit0004379"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2026-02-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004379","dc:identifier":"homoit0004379","skos:prefLabel":[{"@language":"en","@value":"Intersex brides"},{"@language":"nl","@value":"Intersekse bruiden"},{"@language":"sv","@value":"Brudar som är intersexpersoner"}],"skos:altLabel":{"@language":"sv","@value":"Brudar som är intersex"},"rdfs:comment":[{"@language":"en","@value":"Intersex people who are getting married and identify as a bride."},{"@language":"nl","@value":"Intersekse personen die gaan trouwen en zich identificeren als bruid."},{"@language":"sv","@value":"Intersexpersoner som ska gifta sig och identifierar sig som brudar."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0004360"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0004345"},{"@id":"https://homosaurus.org/v5/homoit0004378"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2026-02-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004346","dc:identifier":"homoit0004346","skos:prefLabel":[{"@language":"en","@value":"Mutual aid funds"},{"@language":"nl","@value":"Wederzijdse hulpfondsen"},{"@language":"sv","@value":"Fonder för ömsesidig hjälp"}],"skos:altLabel":[{"@language":"en","@value":"Mutual aid"},{"@language":"sv","@value":"Ömsesidig hjälp-fonder"}],"rdfs:comment":[{"@language":"en","@value":"Funds that distribute goods and money collected and raised using the mutual aid organizational model. This model utilizes voluntary, collaborative exchanges of resources and services for common benefit and take place amongst community members to overcome social, economic, and political barriers to meet common needs. This can include funds which distribute resources like food, clothing, or medicine, as well as those that provide financial support for medical services, rent payments, and other financial needs."},{"@language":"nl","@value":"Fondsen die goederen en geld verdelen, ingezameld volgens het model van wederzijdse hulp. Dit model maakt gebruik van vrijwillige, gezamenlijke uitwisselingen van middelen en diensten ten behoeve van het algemeen belang. Deze uitwisselingen vinden plaats tussen leden van de gemeenschap om sociale, economische en politieke barrières te overwinnen en in gemeenschappelijke behoeften te voorzien. Dit kan fondsen omvatten die middelen zoals voedsel, kleding of medicijnen verstrekken, maar ook fondsen die financiële steun bieden voor medische zorg, huur en andere financiële behoeften."},{"@language":"sv","@value":"Fonder som fördelar varor och pengar som samlats in med hjälp av en modell kring ömsesidig hjälp. Denna modell utgår från ett frivilligt samarbete kring utbyte av resurser och tjänster för gemensam nytta och äger rum mellan gemenskapsmedlemmar för att övervinna sociala, ekonomiska och politiska hinder för att möta gemensamma behov. Detta kan inkludera fonder som distribuerar resurser som mat, kläder eller medicin, såväl som de som ger ekonomiskt stöd för medicinska tjänster, hyresbetalningar och andra ekonomiska behov."}],"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0004486"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0004346"},"dc:issued":{"@type":"xsd:date","@value":"2026-02-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004350","dc:identifier":"homoit0004350","skos:prefLabel":[{"@language":"en","@value":"Canadian lesbians"},{"@language":"sv","@value":"Lesbiska kanadensare"}],"skos:altLabel":{"@language":"en","@value":"Lesbian Canadians"},"rdfs:comment":[{"@language":"en","@value":"Lesbians who were born, raised, or currently reside in Canada, or who hold Canadian citizenship. Only use to describe people who self-identify as Canadian and lesbian."},{"@language":"sv","@value":"Lesbiska som är födda, uppvuxna eller för närvarande bor i Kanada, eller som har kanadensiskt medborgarskap. Används endast för personer som identifierar sig som kanadensare och lesbiska."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0004349"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2026-02-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004351","dc:identifier":"homoit0004351","skos:prefLabel":[{"@language":"en","@value":"Canadian gay men"},{"@language":"sv","@value":"Kanadensiska bögar"}],"skos:altLabel":[{"@language":"en","@value":"Gay Canadian men"},{"@language":"en","@value":"Gay Canadians"},{"@language":"sv","@value":"Kanadensiska homosexuella män"}],"rdfs:comment":[{"@language":"en","@value":"Gay men who were born, raised, or currently reside in Canada, or who hold Canadian citizenship. Only use to describe people who self-identify as Canadian and gay."},{"@language":"sv","@value":"Bögar som är födda, uppvuxna eller för närvarande bor i Kanada, eller som har kanadensiskt medborgarskap. Används endast för personer som identifierar sig som kanadensare och bögar."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0004349"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2026-02-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004352","dc:identifier":"homoit0004352","skos:prefLabel":[{"@language":"en","@value":"Canadian bisexual people"},{"@language":"sv","@value":"Bisexuella kanadensare"}],"skos:altLabel":[{"@language":"en","@value":"Bisexual Canadian people"},{"@language":"en","@value":"Bi Canadian people"},{"@language":"en","@value":"Bisexual Canadians"},{"@language":"en","@value":"Bi Canadians"}],"rdfs:comment":[{"@language":"en","@value":"Bisexual people who were born, raised, or currently reside in Canada, or who hold Canadian citizenship. Only use to describe people who self-identify as Canadian and bisexual."},{"@language":"sv","@value":"Bisexuella personer som är födda, uppvuxna eller för närvarande bor i Kanada, eller som har kanadensiskt medborgarskap. Används endast för personer som identifierar sig som kanadensare och bisexuella."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0004349"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2026-02-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004353","dc:identifier":"homoit0004353","skos:prefLabel":[{"@language":"en","@value":"Canadian transgender people"},{"@language":"sv","@value":"Kanadensiska transpersoner"}],"skos:altLabel":[{"@language":"en","@value":"Transgender Canadian people"},{"@language":"en","@value":"Transgender Canadians"},{"@language":"en","@value":"Trans Canadian people"},{"@language":"en","@value":"Trans Canadians"}],"rdfs:comment":[{"@language":"en","@value":"Transgender people who were born, raised, or currently reside in Canada, or who hold Canadian citizenship. Only use to describe people who self-identify as Canadian and transgender."},{"@language":"sv","@value":"Transpersoner som är födda, uppvuxna eller för närvarande bor i Kanada, eller som har kanadensiskt medborgarskap. Används endast för personer som identifierar sig som kanadensare och transpersoner."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0004349"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2026-02-23"