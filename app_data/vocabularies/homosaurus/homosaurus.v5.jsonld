ren"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000192","dc:identifier":"homoit0000192","skos:prefLabel":[{"@language":"en","@value":"Bisexual youth"},{"@language":"es","@value":"Juventud bisexual"},{"@language":"de","@value":"Bisexuelle Jugendliche"},{"@language":"nl","@value":"Biseksuele jongeren"},{"@language":"sv","@value":"Unga bisexuella"}],"skos:altLabel":[{"@language":"en","@value":"Bisexual teenagers"},{"@language":"en","@value":"Bisexual adolescents"},{"@language":"en","@value":"Bisexual teens"},{"@language":"es","@value":"Adolescentes bisexuales"},{"@language":"es","@value":"Jóvenes bisexuales"},{"@language":"de","@value":"Bi-Jugendliche"},{"@language":"de","@value":"Bi-Teenager:innen"},{"@language":"de","@value":"Bisexuelle Teenager:innen"},{"@language":"nl","@value":"Biseksuele teenagers"},{"@language":"nl","@value":"Biseksuele tieners"}],"rdfs:comment":[{"@language":"en","@value":"Bisexual people between the ages of childhood and adulthood."},{"@language":"es","@value":"Personas bisexuales entre las edades de la infancia y la edad adulta."},{"@language":"de","@value":"Bisexuelle Menschen im Alter zwischen Kindheit und Erwachsensein."},{"@language":"nl","@value":"Biseksuelen in de leeftijd van kindertijd tot volwassenheid"},{"@language":"sv","@value":"Bisexuella personer i åldern mellan barndom och vuxenliv."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000170"},{"@id":"https://homosaurus.org/v5/homoit0001521"}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000137"},{"@id":"https://homosaurus.org/v5/homoit0000152"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000203"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh97003789"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/