osaurus.org/v5/homoit0003601"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000868"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0003601"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001982","dc:identifier":"homoit0001982","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ home movies"},{"@language":"es","@value":"Películas caseras LGBTQ+"},{"@language":"nl","@value":"LHBTQ+-home movies"},{"@language":"sv","@value":"Hbtq+-hemmafilmer"}],"skos:altLabel":[{"@language":"en","@value":"Home movies (LGBTQ)"},{"@language":"en","@value":"LGBTQ+ personal films"},{"@language":"en","@value":"Personal films (LGBTQ)"},{"@language":"es","@value":"Películas caseras LGBTQ"},{"@language":"es","@value":"Películas de casa LGBTQ+"},{"@language":"es","@value":"Películas de casa (LGBTQ)"},{"@language":"es","@value":"Películas personales LGBTQ+"},{"@language":"nl","@value":"LHBTQ+-persoonlijke films"},{"@language":"nl","@value":"LHBTQ+-thuisfilms"}],"rdfs:comment":[{"@language":"en","@value":"Short amateur films or videos created primarily to preserve memories; use in reference to home movies created by or featuring LGBTQ+ people."},{"@language":"es","@value":"Cortometrajes o vídeos de aficionados creados principalmente para preservar recuerdos; utilícese en referencia a películas caseras creadas por o protagonizadas por personas LGBTQ+."},{"@language":"nl","@value":"Korte amateurfilms of -video's die voornamelijk zijn gemaakt om herinneringen te bewaren; gebruiken met verwijzing naar homevideo's gemaakt door of met LHBTQ+-personen"},{"@language":"sv","@value":"Korta amatörfilmer eller videor som främst skapats för att bevara minnen. Används för hemmavideor skapade av eller med hbtq+-personer."}],"skos:broader":{"@id":"https://homosaurus.org/v5