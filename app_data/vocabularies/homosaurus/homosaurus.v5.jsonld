s:broader":{"@id":"https://homosaurus.org/v5/homoit0002614"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0002553"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-12"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002615","dc:identifier":"homoit0002615","skos:prefLabel":[{"@language":"en","@value":"Demisexual erotic art "},{"@language":"es","@value":"Arte erótico demisexual"},{"@language":"de","@value":"Demisexuelle erotische Kunst"},{"@language":"nl","@value":"Demiseksuele erotische kunst"},{"@language":"sv","@value":"Demisexuell erotisk konst"}],"rdfs:comment":[{"@language":"en","@value":"Erotic art, created by demisexual artists, depicting demisexual people, or that are regarded as important within demisexual culture."},{"@language":"es","@value":"Arte erótico, creado por artistas demisexuales, que representa a personas demisexuales, o a personas consideradas importantes dentro de la cultura demisexual."},{"@language":"de","@value":"Erotische Kunst von demisexuellen Künstler:innen, die demisexuelle Personen darstellen oder als wichtig innerhalb der demisexuellen Kultur angesehen werden."},{"@language":"nl","@value":"Erotische kunst, gemaakt door demiseksuele kunstenaars, die demiseksuele personen uitbeeldt, of die binnen de demiseksuele cultuur als belangrijk wordt beschouwd."},{"@language":"sv","@value":"Erotisk konst skapad av konstnärer som är demisexuella, som avbildar demisexuella personer eller som anses betydelsefull inom demisexuell kultur."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002579"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0002554"},{"@id":"https://homosaurus.org/v5/homoit0002559"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0002605"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003728","dc:identifier":"homoit0003728","skos:prefLabel":[{"@language":"en","@value":"Two-Spirit documentaries"},{"@language":"nl","@value":"Two-Spirit documentaires"},{"@language":"sv","@value":"Two-spirit-dokumentärer"}],"skos:altLabel":[{"@language":"en","@value":"Two Spirit documentaries"},{"@language":"en","@value":"Two-Spirited documentaries"},{"@language":"en","@value":"Two Spirited documentaries"},{"@language":"en","@value":"2S documentaries"},{"@language":"en","@value":"Two-Spirit documentary films"}],"rdfs:comment":[{"@language":"en","@value":"Non-fictional films that center Two-Spirit people or topics, created for the purposes of education, advocacy, or personal expression."},{"@language":"nl","@value":"Non-fictiefilms waarin Two-Spirit people of -onderwerpen centraal staan, gemaakt met educatieve, pleitbezorgings- of persoonlijke expressiedoeleinden."},{"@language":"sv","@value":"Icke-fiktiva filmer som fokuserar på Two-spirit-personer eller teman och som skapats i syfte att utbilda, föra fram aktivism eller uttrycka personliga erfarenheter."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002560"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0003720"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0002560"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004303","dc:identifier":"homoit0004303","skos:prefLabel":[{"@language":"en","@value":"Non-binary historical fiction"},{"@language":"nl","@value":"non-binaire historische literatuur"},{"@language":"sv","@value":"Ickebinära historiska skildringar"}],"skos:altLabel":[{"@language":"en","@value":"Nonbinary historical fiction"},{"@language":"sv","@value":"Ickebinära historiska romaner"}],"rdfs:comment":[{"@language":"en","@value":"Genre of written works that depicts events set during particular real historical events. Use for historical fiction focusing on non-binary characters or themes."},{"@language":"nl","@value":"Geschreven fictieve werken waarin het verhaal zich afspeelt tegen de achtergrond van specifieke, waargebeurde historische gebeurtenissen; gebruik in verwijzing naar historische fictie met non-binaire personages of thema's."},{"@language":"sv","@value":"Skönlitterära verk som utspelar sig i historisk tid, med verkliga händelser och miljöer. Används för historiska skildringar med fokus på ickebinära karaktärer eller teman."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0002565"},{"@id":"https://homosaurus.org/v5/homoit0004295"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2026-02-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002606","dc:identifier":"homoit0002606","skos:prefLabel":[{"@language":"en","@value":"Two-Spirit erotic art "},{"@language":"es","@value":"Arte erótico dos espíritus"},{"@language":"nl","@value":"Two-Spirit erotische kunst"},{"@language":"sv","@value":"Two-spirit-erotisk konst"}],"skos:altLabel":[{"@language":"en","@value":"2S erotic art "},{"@language":"en","@value":"Two Spirit erotic art "},{"@language":"en","@value":"Two Spirited erotic art "},{"@language":"en","@value":"Two-Spirited erotic art "}],"rdfs:comment":[{"@language":"en","@value":"Erotic art, created by Two-Spirit artists, depicting Two-Spirit people, or that are regarded as important within Two-Spirit culture."},{"@language":"es","@value":"Arte erótico, creado por artistas dos espíritus, que representa a personas dos espíritus o que se considera importante dentro de la cultura dos espíritus."},{"@language":"nl","@value":"Erotische kunst, gemaakt door Two-Spirit kunstenaars, waarop Two-Spirit people zijn afgebeeld of die als belangrijk worden beschouwd binnen de Two-Spirit cultuur."},{"@language":"sv","@value":"Erotisk konst skapad av konstnärer som är Two‑Spirit, som avbildar Two‑Spirit‑personer eller som anses betydelsefull inom Two‑Spirit‑kulturen."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002597"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0002579"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0002597"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002580","dc:identifier":"homoit0002580","skos:prefLabel":[{"@language":"en","@value":"Appropriation of Indigenous identity"},{"@language":"es","@value":"Apropiación de identidades indígenas"},{"@language":"de","@value":"Aneignung indigenener Identität"},{"@language":"nl","@value":"Toe-eigening van inheemse identiteit"},{"@language":"sv","@value":"Appropriering av amerikanska urfolksidentiteter"}],"skos:altLabel":[{"@language":"en","@value":"Pretendians"},{"@language":"es","@value":"Pretendians"}],"rdfs:comment":[{"@language":"en","@value":"A form of cultural appropriation and race shifting involving false claims of citizenship, belonging, and/or descent from Indigenous people in North America. Not to be confused with disconnected or reconnecting descendants."},{"@language":"es","@value":"Una forma de apropiación cultural y cambio racial que implica afirmaciones falsas de ciudadanía, pertenencia y/o ascendencia de pueblos indígenas de Norteamérica. No se debe confundir con descendientes desconectados o reconectados."},{"@language":"de","@value":"Eine Form der kulturellen Aneignung und Ethnie, bei der falsche Ansprüche auf Staatsbürgerschaft, Zugehörigkeit und/oder Abstammung von indigenen Völkern in Nordamerika erhoben werden. Nicht zu verwechseln mit Nachkommen, die nicht mehr mit ihren Vorfahren verbunden sind, oder Nachkommen, die wieder Verbindung zu ihren Vorfahren suchen."},{"@language":"nl","@value":"Een vorm van culturele toe-eigening waarbij sprake is van valse claims van het behoren tot en/of afstammen van de inheemse bevolking."},{"@language":"sv","@value":"En form av kulturell appropriering som innebär falska påståenden om medborgarskap, tillhörighet och/eller härkomst från ursprungsbefolkningar i Nordamerika. Ska inte förväxlas med avlägsna eller återknytande ättlingar."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002582"},"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0002581"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0002582"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002582","dc:identifier":"homoit0002582","skos:prefLabel":[{"@language":"en","@value":"Appropriation of marginalized identities"},{"@language":"es","@value":"Apropiación de identidades marginadas"},{"@language":"de","@value":"Aneignung marginalisierter Identitäten"},{"@language":"nl","@value":"Toe-eigening van gemarginaliseerde identiteiten"},{"@language":"sv","@value":"Appropriering av marginaliserade identiteter"}],"rdfs:comment":[{"@language":"en","@value":"Falsely claiming belonging to a marginalized group (including, but not limited to: disability, ethnicity, race, and sexuality)."},{"@language":"es","@value":"Afirmar falsamente pertenecer a un grupo marginado (incluyendo, pero no limitado a: la discapacidad, el origen étnico, la raza y la sexualidad)."},{"@language":"de","@value":"Die falsche Behauptung, einer marginalisierten Gruppe anzugehören (u. a. Behinderung, Ethnie, Hautfarbe und Sexualität)."},{"@language":"nl","@value":"Ten onrechte beweren dat je tot een gemarginaliseerde groep behoort (inclusief, maar niet beperkt tot: handicap, etniciteit, ras en seksualiteit)."},{"@language":"sv","@value":"Falska påståenden om tillhörighet till en marginaliserad grupp (inklusive, men inte begränsat till, funktionsvariationer, etnicitet, ras och sexualitet)."}],"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0002580"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0002582"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003091","dc:identifier":"homoit0003091","skos:prefLabel":[{"@language":"en","@value":"Lateral oppression"},{"@language":"es","@value":"Opresión lateral"},{"@language":"de","@value":"Laterale Unterdrückung"},{"@language":"nl","@value":"Laterale onderdrukking"},{"@language":"sv","@value":"Lateralt förtryck"}],"skos:altLabel":{"@language":"en","@value":"Lateral violence"},"rdfs:comment":[{"@language":"en","@value":"The phenomenon in which someone in a marginalized group displaces violence or oppression onto other members of their own group, often by acting on internalized oppressive beliefs (i.e., negative perceptions of and intolerance toward any marginalized identities they hold) adopted as a result of being raised or socialized within an oppressive environment or culture."},{"@language":"es","@value":"El fenómeno a través del cual una persona de un grupo marginado desplaza la violencia u opresión hacia otros miembros de su propio grupo, a menudo, actuando sobre la base de creencias opresivas internalizadas (es decir, percepciones negativas e intolerancia hacia cualquier identidad marginada que tengan), adoptadas como resultado de haber sido criadas o socializadas dentro de un entorno o una cultura opresiva."},{"@language":"de","@value":"Das Phänomen, bei dem eine Person aus einer marginalisierten Gruppe Gewalt oder Unterdrückung auf andere Mitglieder ihrer eigenen Gruppe überträgt, oft indem sie nach verinnerlichten unterdrückerischen Überzeugungen handelt (d. h. negative Wahrnehmungen und Intoleranz gegenüber den eigenen marginalisierten Identitäten), die sie aufgrund ihrer Erziehung oder Sozialisation in einem unterdrückerischen Umfeld oder einer unterdrückerischen Kultur übernommen hat."},{"@language":"nl","@value":"Het verschijnsel waarbij personen in een gemarginaliseerde groep geweld of onderdrukking toepassen op andere leden van hun eigen groep, vaak door te handelen op basis van geïnternaliseerde onderdrukkende overtuigingen (d.w.z. negatieve percepties van en intolerantie ten opzichte van gemarginaliseerde identiteiten die zij hebben) die zij hebben aangenomen als gevolg van opvoeding of socialisatie in een onderdrukkende omgeving of cultuur."},{"@language":"sv","@value":"Företeelsen att en person inom en marginaliserad grupp riktar våld eller förtryck mot andra i samma grupp, ofta genom att agera utifrån internaliserade förtryckande föreställningar – det vill säga negativa uppfattningar om och intolerans mot de marginaliserade identiteter personen själv har – som de tagit till sig genom uppväxt eller socialisering i en förtryckande miljö."}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0003092"},{"@id":"https://homosaurus.org/v5/homoit0003093"},{"@id":"https://homosaurus.org/v5/homoit0003094"},{"@id":"https://homosaurus.org/v5/homoit0003095"},{"@id":"https://homosaurus.org/v5/homoit0003096"},{"@id":"https://homosaurus.org/v5/homoit0003097"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0002590"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0003091"},"dc:issued":{"@type":"xsd:date","@value":"2023-12-18"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003092","dc:identifier":"homoit0003092","skos:prefLabel":[{"@language":"en","@value":"Lateral lesbophobia"},{"@language":"es","@value":"Lesbofobia lateral"},{"@language":"de","@value":"Laterale Lesbophobie"},{"@language":"nl","@value":"Laterale lesbofobie"},{"@language":"sv","@value":"Lateral lesbofobi"}],"rdfs:comment":[{"@language":"en","@value":"The phenomenon in which lesbians displace violence or oppression onto other lesbians, often by acting on internalized lesbophobic beliefs (i.e., negative perceptions of and intolerance toward lesbians and lesbianism) adopted as a result of being raised or socialized within a lesbophobic environment or culture."},{"@language":"es","@value":"El fenómeno a través del cual las lesbianas desplazan la violencia o la opresión sobre otras lesbianas, a menudo, actuando sobre la base de creencias lesbofóbicas internalizadas (es decir, percepciones negativas e intolerancia hacia las lesbianas y el lesbianismo), adoptadas como resultado de haber sido criadas o socializadas dentro de un entorno o una cultura lesbofóbica."},{"@language":"de","@value":"Das Phänomen, bei dem Lesben Gewalt oder Unterdrückung auf andere Lesben übertragen, oft indem sie verinnerlichte lesbophobe Überzeugungen (d. h. negative Vorstellungen von und Intoleranz gegenüber Lesben und Lesbentum) ausleben, die sie aufgrund ihrer Erziehung oder Sozialisation in einem lesbophoben Umfeld oder einer lesbophoben Kultur übernommen haben."},{"@language":"nl","@value":"Het verschijnsel waarbij lesbische vrouwen geweld of onderdrukking toepassen op andere lesbische vrouwen, vaak door te handelen op basis van geïnternaliseerde lesbofobe overtuigingen (d.w.z. negatieve percepties van en intolerantie ten opzichte van lesbische vrouwen en vrouwelijke homoseksualiteit) die zij hebben aangenomen als gevolg van opvoeding of socialisatie in een lesbofobe omgeving of cultuur."},{"@language":"sv","@value":"Företeelsen att lesbiska riktar våld eller förtryck mot andra lesbiska, ofta genom att agera utifrån internaliserade lesbofobiska föreställningar – det vill säga negativa uppfattningar om och intolerans mot lesbiska och lesbiskhet – som de tagit till sig genom uppväxt eller socialisering i en lesbofobisk miljö."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0002591"},{"@id":"https://homosaurus.org/v5/homoit0003091"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000920"},"dc:issued":{"@type":"xsd:date","@value":"2023-12-18"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003094","dc:identifier":"homoit0003094","skos:prefLabel":[{"@language":"en","@value":"Lateral biphobia"},{"@language":"es","@value":"Bifobia lateral"},{"@language":"nl","@value":"Laterale bifobie"},{"@language":"sv","@value":"Lateral bifobi"}],"rdfs:comment":[{"@language":"en","@value":"The phenomenon in which bisexual people displace violence or oppression onto other bisexual people, often by acting on internalized biphobic beliefs (i.e., negative perceptions of and intolerance toward bisexual people and bisexuality) adopted as a result of being raised or socialized within a biphobic environment or culture."},{"@language":"es","@value":"El fenómeno a través del cual las personas bisexuales desplazan la violencia u opresión hacia otras personas bisexuales, a menudo, actuando sobre la base de creencias bifóbicas internalizadas (es decir, percepciones negativas e intolerancia hacia las personas bisexuales y la bisexualidad), adoptadas como resultado de haber sido criadas o socializadas dentro de un entorno o una cultura bifóbica."},{"@language":"nl","@value":"Het verschijnsel waarbij biseksuele personen geweld of onderdrukking toepassen op andere biseksuele personen, vaak door te handelen op basis van geïnternaliseerde bifobe overtuigingen (d.w.z. negatieve percepties van en intolerantie ten opzichte van biseksuele personen en biseksualiteit) die zij hebben aangenomen als gevolg van opvoeding of socialisatie in een bifobe omgeving of cultuur."},{"@language":"sv","@value":"Företeelsen att bisexuella personer riktar våld eller förtryck mot andra bisexuella, ofta genom att agera utifrån internaliserade bifobiska föreställningar – det vill säga negativa uppfattningar om och intolerans mot bisexualitet – som de tagit till sig genom uppväxt eller socialisering i en bifobisk miljö."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0002592"},{"@id":"https://homosaurus.org/v5/homoit0003091"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000920"},"dc:issued":{"@type":"xsd:date","@value":"2023-12-18"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003095","dc:identifier":"homoit0003095","skos:prefLabel":[{"@language":"en","@value":"Lateral transphobia"},{"@language":"es","@value":"Transfobia lateral"},{"@language":"de","@value":"Laterale Transphobie"},{"@language":"nl","@value":"Laterale transfobie"},{"@language":"sv","@value":"Lateral transfobi"}],"rdfs:comment":[{"@language":"en","@value":"The phenomenon in which transgender people displace violence or oppression onto other transgender people, often by acting on internalized transphobic beliefs (i.e., negative perceptions of and intolerance toward transgender people and trans identities) adopted as a result of being raised or socialized within transphobic environment or culture."},{"@language":"es","@value":"El fenómeno a través del cual las personas transgénero desplazan la violencia u opresión hacia otras personas transgénero, a menudo, actuando sobre la base de creencias transfóbicas internalizadas (es decir, percepciones negativas e intolerancia hacia las personas transgénero y las identidades trans), adoptadas como resultado de haber sido criadas o socializadas en un entorno o una cultura transfóbica."},{"@language":"de","@value":"Das Phänomen, bei dem trans Personen Gewalt oder Unterdrückung auf andere trans Personen übertragen, oft indem sie verinnerlichte transphobe Überzeugungen (d. h. negative Vorstellungen von und Intoleranz gegenüber trans Personen und trans Identitäten) ausleben, die sie aufgrund ihrer Erziehung oder Sozialisation in einem transphoben Umfeld oder einer transphoben Kultur übernommen haben."},{"@language":"nl","@value":"Het verschijnsel waarbij transpersonen geweld of onderdrukking toepassen op andere transpersonen, vaak door te handelen op basis van geïnternaliseerde transfobe overtuigingen (d.w.z. negatieve percepties van en intolerantie ten opzichte van transpersonen en transidentiteiten) die zij hebben aangenomen als gevolg van opvoeding of socialisatie in een transfobe omgeving of cultuur."},{"@language":"sv","@value":"Företeelsen att transpersoner riktar våld eller förtryck mot andra transpersoner, ofta genom att agera utifrån internaliserade transfobiska föreställningar – det vill säga negativa uppfattningar om och intolerans mot transpersoner och transidentiteter – som de tagit till sig genom uppväxt eller socialisering i en transfobisk miljö."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0002593"},{"@id":"https://homosaurus.org/v5/homoit0003091"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000920"},"dc:issued":{"@type":"xsd:date","@value":"2023-12-18"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003096","dc:identifier":"homoit0003096","skos:prefLabel":[{"@language":"en","@value":"Lateral queerphobia"},{"@language":"es","@value":"Queerfobia lateral"},{"@language":"de","@value":"Laterale Queerphobie"},{"@language":"nl","@value":"Laterale queerfobie"},{"@language":"sv","@value":"Lateral queerfobi"}],"rdfs:comment":[{"@language":"en","@value":"The phenomenon in which queer people displace violence or oppression onto other queer people, often by acting on internalized queerphobic beliefs (i.e., negative perceptions of and intolerance toward queer people and queer identity) adopted as a result of being raised or socialized within a queerphobic environment or culture."},{"@language":"es","@value":"El fenómeno a través del cual las personas queer desplazan la violencia u opresión hacia otras personas queer, a menudo, actuando sobre la base de creencias queerfóbicas internalizadas (es decir, percepciones negativas e intolerancia hacia las personas queer y la identidad queer), adoptadas como resultado de haber sido criadas o socializadas dentro de un entorno o una cultura queerfóbica."},{"@language":"de","@value":"Das Phänomen, bei dem queere Menschen Gewalt oder Unterdrückung auf andere queere Menschen übertragen, oft indem sie nach verinnerlichten queerenfeindlichen Überzeugungen handeln (d. h. negative Vorstellungen von und Intoleranz gegenüber queeren Menschen und queerer Identität), die sie aufgrund ihrer Erziehung oder Sozialisation in einem queerenfeindlichen Umfeld oder einer queerenfeindlichen Kultur übernommen haben."},{"@language":"nl","@value":"Het verschijnsel waarbij queer personen geweld of onderdrukking toepassen op andere queer personen, vaak door te handelen op basis van geïnternaliseerde queerfobe overtuigingen (d.w.z. negatieve percepties van en intolerantie ten opzichte van queer personen en queer identiteit) die zij hebben aangenomen als gevolg van opvoeding of socialisatie in een queerfobe omgeving of cultuur."},{"@language":"sv","@value":"Företeelsen att queera personer riktar våld eller förtryck mot andra queera personer, ofta genom att agera utifrån internaliserade queerfobiska föreställningar – det vill säga negativa uppfattningar om och intolerans mot queera personer och queer identitet – som de tagit till sig genom uppväxt eller socialisering i en queerfobisk miljö."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0002594"},{"@id":"https://homosaurus.org/v5/homoit0003091"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000920"},"dc:issued":{"@type":"xsd:date","@value":"2023-12-18"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003097","dc:identifier":"homoit0003097","skos:prefLabel":[{"@language":"en","@value":"Lateral intersexphobia"},{"@language":"es","@value":"Intersexfobia lateral"},{"@language":"de","@value":"Laterale Interphobie"},{"@language":"nl","@value":"Laterale interseksefobie"},{"@language":"sv","@value":"Lateral intersexfobi"}],"skos:altLabel":{"@language":"en","@value":"Lateral interphobia"},"rdfs:comment":[{"@language":"en","@value":"The phenomenon in which intersex people displace violence or oppression onto other intersex people, often by acting on internalized intersexphobic beliefs (i.e., negative perceptions of and intolerance toward intersex people and intersex variations) adopted as a result of being raised or socialized within a intersexphobic environment or culture."},{"@language":"es","@value":"El fenómeno a través del cual las personas intersex desplazan la violencia u opresión hacia otras personas intersex, a menudo, actuando sobre la base de creencias intersexfóbicas internalizadas (es decir, percepciones negativas e intolerancia hacia las personas intersex y variaciones intersex), adoptadas como resultado de haber sido criadas o socializadas dentro de un entorno o una cultura intersexfóbica."},{"@language":"de","@value":"Das Phänomen, bei dem inter* Menschen Gewalt oder Unterdrückung auf andere inter*Menschen übertragen, oft indem sie nach verinnerlichten inter*feindlichen Überzeugungen handeln (d. h. negative Vorstellungen von und Intoleranz gegenüber inter* Menschen und inter*ariationen), die sie aufgrund ihrer Erziehung oder Sozialisation in einem inter*eindlichen Umfeld oder einer inter*feindlichen Kultur übernommen haben."},{"@language":"nl","@value":"Het verschijnsel waarbij intersekse personen geweld of onderdrukking toepassen op andere intersekse personen, vaak door te handelen op basis van geïnternaliseerde interseksefobe overtuigingen (d.w.z. negatieve percepties van en intolerantie ten opzichte van intersekse personen en intersekse) die zij hebben aangenomen als gevolg van opvoeding of socialisatie in een interseksefobe omgeving of cultuur."},{"@language":"sv","@value":"Företeelsen att intersexpersoner riktar våld eller förtryck mot andra intersexpersoner, ofta genom att agera utifrån internaliserade intersexfobiska föreställningar – det vill säga negativa uppfattningar om och intolerans mot intersexpersoner och intersexvariationer – som de tagit till sig genom uppväxt eller socialisering i en intersexfobisk miljö."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0002595"},{"@id":"https://homosaurus.org/v5/homoit0003091"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000920"},"dc:issued":{"@type":"xsd:date","@value":"2023-12-18"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004004","dc:identifier":"homoit0004004","skos:prefLabel":[{"@language":"en","@value":"Transgender people in visual art"},{"@language":"nl","@value":"Transgender personen in de beeldende kunst"},{"@language":"sv","@value":"Transpersoner i visuell konst"}],"skos:altLabel":[{"@language":"en","@value":"Trans people in visual art"},{"@language":"en","@value":"Transgender people in art"},{"@language":"en","@value":"Trans people in art"},{"@language":"nl","@value":"Trans personen in de kunst"},{"@language":"nl","@value":"Transgender personen in de kunst"},{"@language":"sv","@value":"Transpersoner i bildkonst"}],"rdfs:comment":[{"@language":"en","@value":"The depiction of trans people and communities in visual art, including painting, performance art, sculpture, photography, cinema, etc."},{"@language":"nl","@value":"De weergave van transgender personen en gemeenschappen in de beeldende kunst, zoals schilderkunst, performancekunst, beeldhouwkunst, fotografie, film, enz."},{"@language":"sv","@value":"Skildringen av transpersoner och transgemenskaper i bildkonst, inklusive måleri, performancekonst, skulptur, fotografi, film och andra visuella uttryck."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0004000"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0002596"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2015000095"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2025-04-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004008","dc:identifier":"homoit0004008","skos:prefLabel":[{"@language":"en","@value":"Two-Spirit people in visual art"},{"@language":"nl","@value":"Two-Spirit people in de beeldende kunst"},{"@language":"sv","@value":"Two-spirit-personer i visuell konst"}],"skos:altLabel":[{"@language":"en","@value":"Two Spirit people in visual art"},{"@language":"en","@value":"Two-Spirited people in visual art"},{"@language":"en","@value":"Two Spirited people in visual art"},{"@language":"en","@value":"2S people in visual art"},{"@language":"en","@value":"Two-Spirit people in art"},{"@language":"sv","@value":"Two-spirit-personer i bildkonst"}],"rdfs:comment":[{"@language":"en","@value":"The depiction of Two-Spirit people and communities in visual art, including painting, performance art, sculpture, photography, cinema, etc."},{"@language":"nl","@value":"De weergave van Two-Spirit people en gemeenschappen in de beeldende kunst, zoals schilderkunst, performancekunst, beeldhouwkunst, fotografie, film, enz."},{"@language":"sv","@value":"Skildringen av two-spirit-personer och two-spirit-gemenskaper i bildkonst, inklusive måleri, performancekonst, skulptur, fotografi, film och andra visuella uttryck."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0003999"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0002597"},{"@id":"https://homosaurus.org/v5/homoit0004000"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2025-04-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004002","dc:identifier":"homoit0004002","skos:prefLabel":[{"@language":"en","@value":"Gay men in visual art"},{"@language":"nl","@value":"Homomannen in de beeldende kunst"},{"@language":"sv","@value":"Bögar i visuell konst"}],"skos:altLabel":[{"@language":"en","@value":"Gay men in art"},{"@language":"sv","@value":"Bögar i bildkonst"}],"rdfs:comment":[{"@language":"en","@value":"The depiction of gay men and gay communities in visual art, including painting, performance art, sculpture, photography, cinema, etc."},{"@language":"nl","@value":"De weergave van homomannen en gemeenschappen in de beeldende kunst, zoals schilderkunst, performancekunst, beeldhouwkunst, fotografie, film, enz."},{"@language":"sv","@value":"Skildringen av bögar och böggemenskaper i bildkonst, inklusive måleri, performancekonst, skulptur, fotografi, film och andra visuella uttryck."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0004000"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0002598"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh97000998"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2025-04-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004001","dc:identifier":"homoit0004001","skos:prefLabel":[{"@language":"en","@value":"Lesbians in visual art"},{"@language":"nl","@value":"Lesbische vrouwen in de beeldende kunst"},{"@language":"sv","@value":"Lesbiska i visuell konst"}],"skos:altLabel":[{"@language":"en","@value":"Lesbians in art"},{"@language":"sv","@value":"Lesbiska i bildkonst"}],"rdfs:comment":[{"@language":"en","@value":"The depiction of lesbians and lesbian communities in visual art, including painting, performance art, sculpture, photography, cinema, etc."},{"@language":"nl","@value":"De weergave van lesbische vrouwen en gemeenschappen in de beeldende kunst, zoals schilderkunst, performancekunst, beeldhouwkunst, fotografie, film, enz."},{"@language":"sv","@value":"Skildringen av lesbiska och lesbiska gemenskaper i bildkonst, inklusive måleri, performancekonst, skulptur, fotografi, film och andra visuella uttryck."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0004000"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0002599"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh97001911"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2025-04-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004003","dc:identifier":"homoit0004003","skos:prefLabel":[{"@language":"en","@value":"Bisexual people in visual art"},{"@language":"nl","@value":"Biseksuele personen in de beeldende kunst"},{"@language":"sv","@value":"Bisexuella i visuell konst"}],"skos:altLabel":[{"@language":"en","@value":"Bi people in visual art"},{"@language":"en","@value":"Bisexual people in art"},{"@language":"en","@value":"Bi people in art"},{"@language":"nl","@value":"Bi-personen in de kunst"},{"@language":"nl","@value":"Biseksuele personen in de kunst"},{"@language":"sv","@value":"Bisexuella i bildkonst"}],"rdfs:comment":[{"@language":"en","@value":"The depiction of bisexual people and communities in visual art, including painting, performance art, sculpture, photography, cinema, etc."},{"@language":"nl","@value":"De weergave van biseksuele personen en gemeenschappen in de beeldende kunst, zoals schilderkunst, performancekunst, beeldhouwkunst, fotografie, film, enz."},{"@language":"sv","@value":"Skildringen av bisexuella och bisexuella gemenskaper i bildkonst, inklusive måleri, performancekonst, skulptur, fotografi, film och andra visuella uttryck."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0004000"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0002600"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2025-04-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004005","dc:identifier":"homoit0004005","skos:prefLabel":[{"@language":"en","@value":"Queer people in visual art"},{"@language":"nl","@value":"Queer personen in de beeldende kunst"},{"@language":"sv","@value":"Queera personer i visuell konst"}],"skos:altLabel":[{"@language":"en","@value":"Queer people in art"},{"@language":"sv","@value":"Queera personer i bildkonst"}],"rdfs:comment":[{"@language":"en","@value":"The depiction of queer people and communities in visual art, including painting, performance art, sculpture, photography, cinema, etc."},{"@language":"nl","@value":"De weergave van queer personen en gemeenschappen in de beeldende kunst, zoals schilderkunst, performancekunst, beeldhouwkunst, fotografie, film, enz."},{"@language":"sv","@value":"Skildringen av queera personer och queera gemenskaper i bildkonst, inklusive måleri, performancekonst, skulptur, fotografi, film och andra visuella uttryck."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0004000"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0002601"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2025-04-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004006","dc:identifier":"homoit0004006","skos:prefLabel":[{"@language":"en","@value":"Intersex people in visual art"},{"@language":"nl","@value":"Intersekse personen in de beeldende kunst"},{"@language":"sv","@value":"Intersexpersoner i visuell konst"}],"skos:altLabel":[{"@language":"en","@value":"Intersex people in art"},{"@language":"sv","@value":"Intersexpersoner i bildkonst"}],"rdfs:comment":[{"@language":"en","@value":"The depiction of intersex people and communities in visual art, including painting, performance art, sculpture, photography, cinema, etc."},{"@language":"nl","@value":"De weergave van intersekse personen en gemeenschappen in de beeldende kunst, zoals schilderkunst, performancekunst, beeldhouwkunst, fotografie, film, enz."},{"@language":"sv","@value":"Skildringen av intersexpersoner och intersexgemenskaper i bildkonst, inklusive måleri, performancekonst, skulptur, fotografi, film och andra visuella uttryck."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0004000"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0002602"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2025-04-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002619","dc:identifier":"homoit0002619","skos:prefLabel":[{"@language":"en","@value":"Assisted reproductive technology "},{"@language":"es","@value":"Tecnología de reproducción asistida"},{"@language":"de","@value":"Techniken der assistierten Reproduktion"},{"@language":"nl","@value":"Geassisteerde reproductieve technologie"},{"@language":"sv","@value":"Teknik för assisterad befruktning"}],"skos:altLabel":[{"@language":"en","@value":"ART"},{"@language":"en","@value":"Assisted reproductive technologies"},{"@language":"es","@value":"TRA"},{"@language":"es","@value":"Tecnología asistida de reproducción"},{"@language":"de","@value":"ART"},{"@language":"de","@value":"Assisted reproductive technologies"},{"@language":"de","@value":"Artificial Reproductive Technology"},{"@language":"de","@value":"Assistierte Reproduktionstechniken"},{"@language":"nl","@value":"Geassisteerde reproductieve technologieën"}],"rdfs:comment":[{"@language":"en","@value":"An umbrella term used to describe all methods of conception beyond sexual intercourse, including but not limited to donor insemination, artificial insemination, surrogacy, egg donation, and IVF."},{"@language":"es","@value":"Término general utilizado para describir todos los métodos de concepción más allá de las relaciones sexuales, incluidos, pero no limitados a, la inseminación de une donante, la inseminación artificial, la maternidad subrogada, la donación de óvulos y la FIV."},{"@language":"de","@value":"Ein Oberbegriff, der alle Methoden der Empfängnis außerhalb des Geschlechtsverkehrs beschreibt, einschließlich, aber nicht beschränkt auf Spenderinsemination, künstliche Befruchtung, Leihmutterschaft, Eizellspende und IVF."},{"@language":"nl","@value":"Een overkoepelende term die wordt gebruikt om alle conceptiemethoden te beschrijven die buiten de geslachtsgemeenschap omgaan, inclusief maar niet beperkt tot donorinseminatie, kunstmatige inseminatie, draagmoederschap, eiceldonatie en IVF."},{"@language":"sv","@value":"Ett paraplybegrepp som används för att beskriva alla metoder för befruktning utöver samlag, inklusive men inte begränsat till donatorinsemination, assisterad insemination, surrogatmoderskap, äggdonation och IVF."}],"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0002618"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh88005587"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0002619"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002622","dc:identifier":"homoit0002622","skos:prefLabel":[{"@language":"en","@value":"Egg donation "},{"@language":"es","@value":"Donación de óvulos"},{"@language":"de","@value":"Eizellspende"},{"@language":"nl","@value":"Eiceldonatie"},{"@language":"sv","@value":"Äggdonation"}],"rdfs:comment":[{"@language":"en","@value":"The process by which a person donates their eggs for reproduction."},{"@language":"es","@value":"El proceso mediante el cual una persona dona sus óvulos para la reproducción."},{"@language":"de","@value":"Der Prozess, bei dem eine Person ihre Eizellen zur Fortpflanzung spendet."},{"@language":"nl","@value":"Het proces waarbij een persoon zijn eicellen doneert voor reproductie."},{"@language":"sv","@value":"Processen där en person donerar sina ägg för reproduktion."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002618"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0002627"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0002619"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004296","dc:identifier":"homoit0004296","skos:prefLabel":[{"@language":"en","@value":"Māhū historical fiction"},{"@language":"nl","@value":"Māhū historische literatuur"},{"@language":"sv","@value":"Historiska skildringar om māhū"}],"skos:altLabel":[{"@language":"en","@value":"Mahu historical fiction"},{"@language":"sv","@value":"Historiska romaner om māhū"}],"rdfs:comment":[{"@language":"en","@value":"Genre of written works that depicts events set during particular real historical events. Use for historical fiction focusing on māhū characters or themes."},{"@language":"nl","@value":"Geschreven fictieve werken waarin het verhaal zich afspeelt tegen de achtergrond van specifieke, waargebeurde historische gebeurtenissen; gebruik in verwijzing naar historische fictie die zich richt op māhū-personages of -thema's."},{"@language":"sv","@value":"Skönlitterära verk som utspelar sig i historisk tid, med verkliga händelser och miljöer. Används för historiska skildringar med fokus på māhū-karaktärer eller teman."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002632"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0004295"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0002632"},"dc:issued":{"@type":"xsd:date","@value":"2026-02-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004653","dc:identifier":"homoit0004653","skos:prefLabel":{"@language":"en","@value":"Māhū urban fantasy fiction"},"skos:altLabel":{"@language":"en","@value":"Mahu urban fantasy fiction"},"rdfs:comment":{"@language":"en","@value":"Subgenre of fantasy fiction, written works that depicts magical, fantastical, and/or supernatural elements in contemporary urban settings. Use for urban fantasy fiction focusing on māhū characters or themes."},"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002636"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0003179"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0002632"},"dc:issued":{"@type":"xsd:date","@value":"2026-06-15"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-15"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003005","dc:identifier":"homoit0003005","skos:prefLabel":[{"@language":"en","@value":"Non-binary neurodivergent people"},{"@language":"es","@value":"Personas no binarias neurodivergentes"},{"@language":"nl","@value":"Non-binaire neurodivergente personen"},{"@language":"sv","@value":"Ickebinära neurodivergenta personer"}],"skos:altLabel":[{"@language":"en","@value":"Neurodivergent non-binary people"},{"@language":"en","@value":"Neurodivergent nonbinary people"},{"@language":"en","@value":"Neuroatypical non-binary people"},{"@language":"en","@value":"Neuroatypical nonbinary people"},{"@language":"en","@value":"Nonbinary neurodivergent people"},{"@language":"en","@value":"Non-binary neuroatypical people"},{"@language":"en","@value":"Nonbinary neuroatypical people"},{"@language":"es","@value":"Personas neurodivergentes no binarias"},{"@language":"nl","@value":"Neuro-atypische nonbinaire personen"},{"@language":"nl","@value":"Neurodivergente non-binaire personen"},{"@language":"nl","@value":"Neurodivergente nonbinaire personen"},{"@language":"nl","@value":"Non-binaire neuro-atypische personen"},{"@language":"nl","@value":"Nonbinaire neuro-atypische personen"},{"@language":"nl","@value":"Nonbinaire neurodivergente personen"}],"rdfs:comment":[{"@language":"en","@value":"Non-binary people with neurodevelopmental differences in areas such as cognition, sensory processing, emotionality, and sociality."},{"@language":"es","@value":"Personas no binarias cuyos cerebros procesan, aprenden y/o se comportan de manera diferente a lo que la sociedad considera típico. Algunas de estas diferencias neurológicas pueden presentarse como problemas de aprendizaje, trastornos médicos y otras condiciones."},{"@language":"nl","@value":"Non-binaire personen met neurodevelopmentale verschillen op gebieden zoals cognitie, zintuiglijke verwerking, emotionaliteit en sociale vaardigheden."},{"@language":"sv","@value":"Ickebinära personer vars kognition, sensoriska bearbetning, emotionalitet eller sociala förmåga skiljer sig från normen. Dessa variationer kan för vissa innebära funktionsnedsättningar eller medicinska tillstånd, medan de för andra är egenskaper som ingår i deras identitet."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002652"},"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0002673"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-10-27"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003011","dc:identifier":"homoit0003011","skos:prefLabel":[{"@language":"en","@value":"Non-binary blind people"},{"@language":"es","@value":"Personas no binarias ciegas"},{"@language":"nl","@value":"Non-binaire blinde personen"},{"@language":"sv","@value":"Ickebinära blinda personer"}],"skos:altLabel":[{"@language":"en","@value":"Blind non-binary people"},{"@language":"en","@value":"Nonbinary blind people"},{"@language":"es","@value":"Personas ciegas no binarias"},{"@language":"nl","@value":"Nonbinaire blinde personen"},{"@language":"sv","@value":"Blinda Ickebinära"}],"rdfs:comment":[{"@language":"en","@value":"Non-binary people with significant or total loss of vision."},{"@language":"es","@value":"Personas no binarias con pérdida significativa o total de la visión."},{"@language":"nl","@value":"Non-binaire personen met een aanzienlijk of volledig verlies van het gezichtsvermogen."},{"@language":"sv","@value":"Ickebinära personer med betydande eller total synnedsättning."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002652"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-10-27"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003016","dc:identifier":"homoit0003016","skos:prefLabel":[{"@language":"en","@value":"Non-binary hard of hearing people"},{"@language":"es","@value":"Personas no binarias con problemas de audición"},{"@language":"nl","@value":"Hardhorende non-binaire personen"},{"@language":"sv","@value":"Ickebinära hörselskadade personer"}],"skos:altLabel":[{"@language":"en","@value":"Hearing impaired non-binary people"},{"@language":"en","@value":"HoH Non-binary people"},{"@language":"en","@value":"Non-binary HoH people"},{"@language":"en","@value":"Non-binary hearing impaired people"},{"@language":"en","@value":"Nonbinary hard of hearing people"},{"@language":"es","@value":"Personas no binarias con dificultades de audición"},{"@language":"es","@value":"Personas no binarias con dificultades auditivas"},{"@language":"nl","@value":"Nonbinaire hardhorende personen"}],"rdfs:comment":[{"@language":"en","@value":"Non-binary people with significant or total hearing loss who may or may not consider themselves d/Deaf."},{"@language":"es","@value":"Personas no binarias con pérdida auditiva significativa o total, que pueden o no considerarse S/sordas."},{"@language":"nl","@value":"Non-binaire personen met een aanzienlijk of volledig gehoorverlies die zichzelf wel of niet als doof/doven beschouwen."},{"@language":"sv","@value":"Ickebinära personer med betydande eller total hörselförlust."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002652"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0003021"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-10-27"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003021","dc:identifier":"homoit0003021","skos:prefLabel":[{"@language":"en","@value":"Non-binary Deaf people"},{"@language":"es","@value":"Personas no binarias sordas"},{"@language":"nl","@value":"Dove non-binaire personen"},{"@language":"sv","@value":"Döva ickebinära personer"}],"skos:altLabel":[{"@language":"en","@value":"Deaf non-binary people"},{"@language":"en","@value":"Nonbinary Deaf people"},{"@language":"es","@value":"Personas sordas no binarias"},{"@language":"es","@value":"Sordos no binarios"},{"@language":"nl","@value":"Nonbinaire dove personen"}],"rdfs:comment":[{"@language":"en","@value":"Non-binary people with significant or total hearing loss. Some but not all Deaf people prefer to capitalize Deaf in recognition of the cultural and linguistic identity they share with other Deaf people."},{"@language":"es","@value":"Personas no binarias con pérdida auditiva significativa o total. Algunas personas sordas, pero no todas, prefieren escribir “Sorda/o” con mayúscula  en reconocimiento de la identidad cultural y lingüística que comparten con otras personas sordas."},{"@language":"nl","@value":"Non-binaire personen met een significant of totaal gehoorverlies."},{"@language":"sv","@value":"Ickebinära personer med betydande eller total hörselförlust."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002652"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0003016"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-10-27"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003027","dc:identifier":"homoit0003027","skos:prefLabel":[{"@language":"en","@value":"Non-binary wheelchair users"},{"@language":"es","@value":"Usuarios no binarios de sillas de ruedas"},{"@language":"nl","@value":"Non-binaire rolstoelgebruikers"},{"@language":"sv","@value":"Rullstolsburna ickebinära personer"}],"skos:altLabel":[{"@language":"en","@value":"Nonbinary wheelchair users"},{"@language":"es","@value":"Usuarios de sillas de ruedas no binarios"}],"rdfs:comment":[{"@language":"en","@value":"Non-binary people who use wheelchairs."},{"@language":"es","@value":"Personas no binarias que utilizan sillas de ruedas."},{"@language":"nl","@value":"Non-binaire personen die gebruik maken van een rolstoel."},{"@language":"sv","@value":"Ickebinära personer som använder rullstol."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002652"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-10-27"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003026","dc:identifier":"homoit0003026","skos:prefLabel":[{"@language":"en","@value":"Non-binary people with chronic illnesses"},{"@language":"es","@value":"Personas no binarias con enfermedades crónicas"},{"@language":"nl","@value":"Non-binaire personen met chronische ziekten"},{"@language":"sv","@value":"Ickebinära personer med kronisk sjukdom"}],"skos:altLabel":[{"@language":"en","@value":"Chronically ill non-binary people"},{"@language":"es","@value":"Personas con enfernedades crónicas no binarias"},{"@language":"es","@value":"Enfermos crónicos no binarios"},{"@language":"sv","@value":"Kroniskt sjuka Ickebinära personer"}],"rdfs:comment":[{"@language":"en","@value":"Non-binary people who have long-term health conditions that require continued medical attention and/or significantly impact or limit daily life; some but not all people with chronic illnesses consider themselves disabled."},{"@language":"es","@value":"Personas no binarias que tienen condiciones de salud a largo plazo que requieren atención médica continua y/o impactan o limitan significativamente la vida diaria; algunas, pero no todas, las personas con enfermedades crónicas se consideran discapacitadas."},{"@language":"nl","@value":"Non-binaire personen met langdurige gezondheidsproblemen die voortdurende medische aandacht vereisen en/of een aanzienlijke impact of beperking op het dagelijks leven hebben. Sommige, maar niet alle, personen met chronische ziekten beschouwen zichzelf als gehandicapt."},{"@language":"sv","@value":"Ickebinära personer med långvariga hälsotillstånd som kräver kontinuerlig medicinsk behandling och/eller har en betydande påverkan på eller begränsar det dagliga livet. Vissa, men inte alla, personer med kroniska sjukdomar identifierar sig som personer med funktionsnedsättning."}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0002652"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0003026"},"dc:issued":{"@type":"xsd:date","@value":"2023-10-27"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003531","dc:identifier":"homoit0003531","skos:prefLabel":[{"@language":"en","@value":"Two-Spirit political groups"},{"@language":"nl","@value":"Two-Spirit politieke groepen"},{"@language":"sv","@value":"Two-spirit-politska grupper"}],"skos:altLabel":[{"@language":"en","@value":"Two-Spirited political groups"},{"@language":"en","@value":"2S political groups"},{"@language":"en","@value":"Two Spirit political groups"},{"@language":"en","@value":"Two Spirited political groups"}],"rdfs:comment":[{"@language":"en","@value":"Organized groups centered on political change and action for Two-Spirit people's rights."},{"@language":"nl","@value":"Georganiseerde groepen die zich richten op politieke verandering en actie voor de rechten van Two-Spirit people."},{"@language":"sv","@value":"Organiserade grupper med fokus på politisk förändring och aktivism för Two-spirit-personers rättigheter."}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0002656"},{"@id":"https://homosaurus.org/v5/homoit0003521"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0003531"},"dc:issued":{"@type":"xsd:date","@value":"2024-09-19"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002659","dc:identifier":"homoit0002659","skos:prefLabel":[{"@language":"en","@value":"Gay neurodivergent men"},{"@language":"de","@value":"Schwule neurodivergente Männer"},{"@language":"es","@value":"Hombres gay neurodivergentes"},{"@language":"nl","@value":"Neurodivergente homomannen"},{"@language":"sv","@value":"Neurodivergenta bögar"}],"skos:altLabel":[{"@language":"en","@value":"Gay neurodivergent people"},{"@language":"de","@value":"Neurodivergente schwule Männer"},{"@language":"es","@value":"Personas neurodivergentes gay"},{"@language":"sv","@value":"Neurodivergenta homosexuella män"}],"rdfs:comment":[{"@language":"en","@value":"Gay men with neurodevelopmental differences in areas such as cognition, sensory processing, emotionality, and sociality."},{"@language":"de","@value":"Schwule Männer, deren Gehirne anders verarbeiten, lernen und/oder sich anders verhalten als es von der Gesellschaft als typisch angesehen wird. Einige dieser neurologischen Unterschiede können sich in Form von Lernstörungen, medizinischen Störungen und anderen Erkrankungen äußern."},{"@language":"es","@value":"Hombres gay cuyos cerebros procesan, aprenden y/o se comportan de manera diferente a lo que la sociedad considera típico. Algunas de estas diferencias neurológicas pueden presentarse como problemas de aprendizaje, trastornos médicos y otras condiciones."},{"@language":"nl","@value":"Homomannen met neurodevelopmentale verschillen op gebieden zoals cognitie, zintuiglijke verwerking, emotionaliteit en sociale vaardigheden."},{"@language":"sv","@value":"Bögar vars kognition, sensoriska bearbetning, emotionalitet eller sociala förmåga skiljer sig från normen. Dessa variationer kan för vissa innebära funktionsnedsättningar eller medicinska tillstånd, medan de för andra är egenskaper som ingår i deras identitet."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002658"},"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0002669"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-26"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002660","dc:identifier":"homoit0002660","skos:prefLabel":[{"@language":"en","@value":"Lesbian neurodivergent people"},{"@language":"es","@value":"Lesbianas neurodivergentes"},{"@language":"nl","@value":"Lesbische neurodivergente personen"},{"@language":"sv","@value":"Lesbiska neurodivergenta"}],"skos:altLabel":[{"@language":"en","@value":"Neurodivergent lesbians"},{"@language":"en","@value":"Neuroatypical lesbians"},{"@language":"en","@value":"Lesbian neuroatypical people"},{"@language":"nl","@value":"Neuro-atypische lesbische vrouwen"},{"@language":"nl","@value":"Neurodivergente lesbische vrouwen"}],"rdfs:comment":[{"@language":"en","@value":"Lesbians with neurodevelopmental differences in areas such as cognition, sensory processing, emotionality, and sociality."},{"@language":"es","@value":"Lesbianas cuyos cerebros procesan, aprenden y/o se comportan de manera diferente a lo que la sociedad considera típico. Algunas de estas diferencias neurológicas pueden presentarse como problemas de aprendizaje, trastornos médicos y otras condiciones."},{"@language":"nl","@value":"Lesbische vrouwen met neurodevelopmentale verschillen op gebieden zoals cognitie, zintuiglijke verwerking, emotionaliteit en sociale vaardigheden."},{"@language":"sv","@value":"Lesbiska personer vars kognition, sensoriska bearbetning, emotionalitet eller sociala förmåga skiljer sig från normen. Dessa variationer kan för vissa innebära funktionsnedsättningar eller medicinska tillstånd, medan de för andra är egenskaper som ingår i deras identitet."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002658"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-26"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002661","dc:identifier":"homoit0002661","skos:prefLabel":[{"@language":"en","@value":"Bisexual neurodivergent people"},{"@language":"de","@value":"Bisexuelle neurodivergente Personen"},{"@language":"es","@value":"Personas bisexuales neurodivergentes"},{"@language":"nl","@value":"Biseksuele neurodivergente personen"},{"@language":"sv","@value":"Bisexuella neurodivergenta personer"}],"skos:altLabel":[{"@language":"en","@value":"Bi neurodivergent people"},{"@language":"en","@value":"Bisexual neuroatypical people"},{"@language":"en","@value":"Bi neuroatypical people"},{"@language":"de","@value":"Neurodivergente bisexuelle Personen"},{"@language":"nl","@value":"Bi neurodivergente personen"},{"@language":"nl","@value":"Biseksuele neuro-atypische personen"}],"rdfs:comment":[{"@language":"en","@value":"Bisexual people with neurodevelopmental differences in areas such as cognition, sensory processing, emotionality, and sociality."},{"@language":"de","@value":"Bisexuelle Menschen, deren Gehirn anders verarbeitet, lernt und/oder sich anders verhält als gesellschaftlich üblich. Einige dieser neurologischen Unterschiede können sich in Lernschwierigkeiten, medizinischen Störungen und anderen Erkrankungen äussern."},{"@language":"es","@value":"Personas bisexuales cuyos cerebros procesan, aprenden y/o se comportan de manera diferente a lo que la sociedad considera típico. Algunas de estas diferencias neurológicas pueden presentarse como problemas de aprendizaje, trastornos médicos y otras condiciones."},{"@language":"nl","@value":"Biseksuele personen met neurodevelopmentale verschillen op gebieden zoals cognitie, zintuiglijke verwerking, emotionaliteit en sociale vaardigheden."},{"@language":"sv","@value":"Bisexuella personer vars kognition, sensoriska bearbetning, emotionalitet eller sociala förmåga skiljer sig från normen. Dessa variationer kan för vissa innebära funktionsnedsättningar eller medicinska tillstånd, medan de för andra är egenskaper som ingår i deras identitet."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002658"},"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0002670"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-26"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002662","dc:identifier":"homoit0002662","skos:prefLabel":[{"@language":"en","@value":"Transgender neurodivergent people"},{"@language":"es","@value":"Personas transgénero neurodivergentes"},{"@language":"nl","@value":"Transgender neurodivergente personen"},{"@language":"sv","@value":"Neurodivergenta transpersoner"}],"skos:altLabel":[{"@language":"en","@value":"Neurodivergent transgender people"},{"@language":"en","@value":"Trans neurodivergent people"},{"@language":"en","@value":"Neuroatypical transgender people"},{"@language":"en","@value":"Neuroatypical trans people"},{"@language":"en","@value":"Trans neuroatypical people"},{"@language":"en","@value":"Transgender neuroatypical people"},{"@language":"es","@value":"Personas neurodivergentes transgénero"},{"@language":"nl","@value":"Neuro-atypische transgender personen"},{"@language":"nl","@value":"Neurodivergente transgender personen"},{"@language":"nl","@value":"Trans neuro-atypische personen"},{"@language":"nl","@value":"Trans neurodivergente personen"},{"@language":"nl","@value":"Transgender neuro-atypische personen"}],"rdfs:comment":[{"@language":"en","@value":"Transgender people with neurodevelopmental differences in areas such as cognition, sensory processing, emotionality, and sociality."},{"@language":"es","@value":"Personas transgénero cuyos cerebros procesan, aprenden y/o se comportan de manera diferente a lo que la sociedad considera típico. Algunas de estas diferencias neurológicas pueden presentarse como problemas de aprendizaje, trastornos médicos y otras condiciones."},{"@language":"nl","@value":"Transgender personen met neurodevelopmentale verschillen op gebieden zoals cognitie, zintuiglijke verwerking, emotionaliteit en sociale vaardigheden."},{"@language":"sv","@value":"Transpersoner vars kognition, sensoriska bearbetning, emotionalitet eller sociala förmåga skiljer sig från normen. Dessa variationer kan för vissa innebära funktionsnedsättningar eller medicinska tillstånd, medan de för andra är egenskaper som ingår i deras identitet."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002658"},"skos:related":{"@id":"https://homosaurus.org/