ner med betydande eller total synnedsättning."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000822"},{"@id":"https://homosaurus.org/v5/homoit0002929"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-30"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002683","dc:identifier":"homoit0002683","skos:prefLabel":[{"@language":"en","@value":"Two-Spirit blind people"},{"@language":"es","@value":"Personas dos espíritus ciegas"},{"@language":"nl","@value":"Blinde Two-Spirit people"},{"@language":"sv","@value":"Blinda Two-spirit-personer"}],"skos:altLabel":[{"@language":"en","@value":"2S blind people"},{"@language":"en","@value":"Blind 2S people"},{"@language":"en","@value":"Blind Two Spirit people"},{"@language":"en","@value":"Blind Two Spirited people"},{"@language":"en","@value":"Blind Two-Spirited people"},{"@language":"en","@value":"Two Spirit blind people"},{"@language":"en","@value":"Two Spirited blind people"},{"@language":"en","@value":"Two-Spirited blind people"},{"@language":"es","@value":"Personas ciegas dos espíritus"},{"@language":"es","@value":"Ciegos dos espíritus"}],"rdfs:comment":[{"@language":"en","@value":"Two-Spirit people with significant or total loss of vision."},{"@language":"es","@value":"Personas dos espíritus con pérdida significativa o total de visión."},{"@language":"nl","@value":"Two-Spirit people met een aanzienlijk of totaal verlies van gezichtsvermogen."},{"@language":"sv","@value":"Two-spirit-personer med betydande eller total synnedsättning."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002682"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000822"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-26"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000823","dc:identifier":"homoit0000823","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ blogs"},{"@language":"es","@value":"Blogs LGBTQ+"},{"@language":"ja","@value":"LGBTQ+関連のブログ"},{"@language":"nl","@value":"LHBTQ+-blogs"},{"@language":"sv","@value":"Hbtq+-bloggar"}],"skos:altLabel":[{"@language":"en","@value":"LGBTQ blogs"},{"@language":"es","@value":"Blogs LGBTQ"},{"@language":"ja","@value":"LGBTQ関連のブログ"}],"rdfs:comment":[{"@language":"en","@value":"Websites featuring informal, often personal writing and reflections created by LGBTQ+ people or about LGBTQ+ communities and issues."},{"@language":"es","@value":"Sitios web que presentan escritos y reflexiones informales, a menudo personales, creados por personas LGBTQ+ o sobre comunidades y cuestiones LGBTQ+."},{"@language":"ja","@value":"LGBTQ+の人々によって作成された、あるいはLGBTQ+のコミュニティや課題に関する、カジュアルで個人的な文章や考察を掲載したウェブサイト。"},{"@language":"nl","@value":"Websites met informeel, vaak persoonlijk schrijven en reflecties gemaakt door LHBTQ+-personen of over LHBTQ+-gemeenschappen en -kwesties."},{"@language":"sv","@value":"Webbplatser med informella, ofta personliga texter och reflektioner skrivna av hbtq+-personer eller om hbtq+-gemenskaper och frågor."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000946"},"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0001983"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000946"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQBlogs"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000946","dc:identifier":"homoit0000946","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ social media"},{"@language":"es","@value":"Redes sociales LGBTQ+"},{"@language":"nl","@value":"LHBTQ+-sociale media"},{"@language":"sv","@value":"Sociala medier (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"LGBTQ social media"},{"@language":"es","@value":"Redes sociales LGBTQ"}],"rdfs:comment":[{"@language":"en","@value":"Web-based and mobile technologies that facilitate interactive dialogue, as used by or designed for LGBTQ+ people."},{"@language":"es","@value":"Tecnologías móviles y basadas en la web que facilitan el diálogo interactivo, tal como las utilizan o están diseñadas para personas LGBTQ+."},{"@language":"nl","@value":"Webgebaseerde en mobiele technologieën die worden gebruikt om communicatie om te zetten in interactieve dialogen"},{"@language":"sv","@value":"Webb- och mobilteknik som möjliggör interaktiv dialog, som används av eller är utformad för hbtq+-personer."}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000823"},{"@id":"https://homosaurus.org/v5/homoit0000832"},{"@id":"https://homosaurus.org/v5/homoit0000846"},{"@id":"https://homosaurus.org/v5/homoit0000888"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000900"},{"@id":"https://homosaurus.org/v5/homoit0000962"},{"@id":"https://homosaurus.org/v5/homoit0001983"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000946"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQSocialMedia"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001983","dc:identifier":"homoit0001983","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ vlogs"},{"@language":"es","@value":"Vlogs LGBTQ+"},{"@language":"nl","@value":"LHBTQ+-vlogs"},{"@language":"sv","@value":"Vloggar (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"LGBTQ+ video blogs"},{"@language":"en","@value":"Video blogs (LGBTQ)"},{"@language":"en","@value":"Vlogs (LGBTQ)"},{"@language":"es","@value":"Video blogs LGBTQ+"},{"@language":"nl","@value":"Video blogs (LHBTQ+)"},{"@language":"nl","@value":"Vlogs (LHBTQ+)"},{"@language":"sv","@value":"Hbtq+-vloggar"}],"rdfs:comment":[{"@language":"en","@value":"A form of online blogging via short videos about an individual's life; use in reference to vlogs created by LGBTQ+ people or focusing on LGBTQ+ issues."},{"@language":"es","@value":"Una forma de blogueo en línea a través de videos cortos sobre la vida de una persona; utilícese en referencia a vlogs creados por personas LGBTQ+ o que se centren en asuntos LGBTQ+."},{"@language":"nl","@value":"Een vorm van online bloggen via korte video's over iemands leven; gebruiken met betrekking tot vlogs gemaakt door LHBTQ+-personen of gericht op LHBTQ+-kwesties"},{"@language":"sv","@value":"En form av videoblogg där en person berättar om sitt liv i korta videoklipp. Används för vloggar skapade av hbtq+-personer eller med fokus på hbtq+-frågor."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000823"},{"@id":"https://homosaurus.org/v5/homoit0001982"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000946"},{"@id":"https://homosaurus.org/v5/homoit0004317"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000946"},"dc:issued":{"@type":"xsd:date","@value":"2022-05-11"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000825","dc:identifier":"homoit0000825","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ book censorship"},{"@language":"es","@value":"Censura de libros LGBTQ+"},{"@language":"ja","@value":"LGBTQ+関連書籍の検閲"},{"@language":"nl","@value":"LHBTQ+-boekencensuur"},{"@language":"sv","@value":"Bokcensur (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"LGBTQ book censorship"},{"@language":"es","@value":"Censura de libros LGBTQ"},{"@language":"ja","@value":"LGBTQ関連書籍の検閲"},{"@language":"sv","@value":"Bokförbud (hbtq+)"}],"rdfs:comment":[{"@language":"en","@value":"The suppression or prohibition of written texts by LGBTQ+ authors and/or about LGBTQ+ issues due to religious, moral, political, and/or social objections."},{"@language":"es","@value":"La supresión o prohibición de textos escritos de autores LGBTQ+ y/o sobre temas LGBTQ+ por objeciones religiosas, morales, políticas y/o sociales."},{"@language":"ja","@value":"宗教的、道徳的、政治的、社会的な反対理由から、LGBTQ+の著者による、あるいはLGBTQ+に関連する著作物の抑制または禁止。"},{"@language":"nl","@value":"De onderdrukking van geschreven teksten van LHBTQ+-schrijvers of over LHBTQ+-kwesties vanwege religieuze, morele, politieke of sociale opvattingen."},{"@language":"sv","@value":"Förtryck, förbud eller censur av texter skrivna av hbtq+-författare och/eller om hbtq+-frågor, grundat i religiösa, moraliska, politiska och/eller sociala invändningar."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000829"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000827"},{"@id":"https://homosaurus.org/v5/homoit0000831"},{"@id":"https://homosaurus.org/v5/homoit0003617"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000245"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQBookCensorship"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000831","dc:identifier":"homoit0000831","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ challenged books"},{"@language":"es","@value":"Libros desafiados LGBTQ+"},{"@language":"ja","@value":"LGBTQ+を題材にして議論の対象となった図書"},{"@language":"nl","@value":"LHBTQ+-betwiste boeken"},{"@language":"sv","@value":"Ifrågasatta hbtq+-böcker"}],"skos:altLabel":[{"@language":"en","@value":"LGBTQ challenged books"},{"@language":"es","@value":"Libros desafiados LGBTQ"},{"@language":"es","@value":"Libros impugnados LGBTQ+"},{"@language":"ja","@value":"LGBTQを題材にして議論の対象となった図書"}],"rdfs:comment":[{"@language":"en","@value":"Books about LGBTQ+ people and issues or written by LGBTQ+ authors that individuals or organizations have attempted to restrict or remove from school curricula, library circulation, or sale."},{"@language":"es","@value":"Libros sobre personas y temas LGBTQ+ o escritos por autores LGBTQ+ que personas u organizaciones han intentado restringir o eliminar de los planes de estudio escolares, la circulación en bibliotecas o la venta."},{"@language":"ja","@value":"LGBTQ+の人々や問題を取り上げた書籍、あるいはLGBTQ+の著者が執筆した書籍のうち、個人や団体によって、学校のカリキュラムや図書館の貸出、販売から排除または撤去しようとする動きがあったもの。"},{"@language":"nl","@value":"Boeken over LHBTQ+-personen en -kwesties of geschreven door LHBTQ+-auteurs die personen of organisaties hebben geprobeerd beperkingen op te leggen bij of te verwijderen uit schoolcurricula, bibliotheekcirculatie of verkoop."},{"@language":"sv","@value":"Böcker om hbtq+-personer och hbtq+-frågor, eller skrivna av hbtq+-författare, som någon försökt förbjuda eller begränsa tillgången till i skolor, bibliotek eller bokhandel."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000827"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000825"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000827"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQChallengedBooks"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000826","dc:identifier":"homoit0000826","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ book clubs"},{"@language":"es","@value":"Clubes de lectura LGBTQ+"},{"@language":"ja","@value":"LGBTQ+の読書会"},{"@language":"nl","@value":"LHBTQ+-boekenclubs"},{"@language":"sv","@value":"Bokklubbar (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"LGBTQ book clubs"},{"@language":"es","@value":"Clubes de lectura LGBTQ"},{"@language":"ja","@value":"LGBTQの読書会"},{"@language":"sv","@value":"Hbtq+-bokklubbar"}],"rdfs:comment":[{"@language":"en","@value":"Groups of people gathering regularly to read and discuss written works; use in reference to book clubs with primarily LGBTQ+ membership or book clubs focused on books by LGBTQ+ authors or featuring LGBTQ+ characters and themes."},{"@language":"es","@value":"Grupos de personas que se reúnen periódicamente para leer y discutir trabajos escritos; utilícese en referencia a clubes de lectura con membresía principalmente LGBTQ+ o clubes de lectura centrados en libros de autores LGBTQ+ o que presentan personajes y temas LGBTQ+."},{"@language":"ja","@value":"定期的に集まって著作物を読み、議論する人々のグループ。主にLGBTQ+のメンバーで構成される読書会、あるいはLGBTQ+の作家による作品や、LGBTQ+の登場人物・テーマを取り上げた作品に焦点を当てた読書会を指す。"},{"@language":"nl","@value":"Groepen mensen die regelmatig samenkomen om geschreven werken te lezen en te bespreken; gebruik om te verwijzen naar boekenclubs met voornamelijk LHBTQ+-lidmaatschap of boekenclubs gericht op boeken van LHBTQ+-auteurs of met LHBTQ+-personages en -thema's."},{"@language":"sv","@value":"Grupper av personer som regelbundet samlas för att läsa och diskutera litteratur. Används för bokcirklar med huvudsakligen hbtq+-personer som deltagare, med fokus på litteratur av hbtq+-författare eller med hbtq+-karaktärer och teman."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000836"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000827"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000836"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQBookClubs"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000828","dc:identifier":"homoit0000828","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ cartoons"},{"@language":"es","@value":"Caricaturas LGBTQ+"},{"@language":"ja","@value":"LGBTQ+をテーマにした漫画"},{"@language":"nl","@value":"LHBTQ+-cartoons"},{"@language":"sv","@value":"Satiriska teckningar (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"LGBTQ cartoons"},{"@language":"es","@value":"Caricaturas LGBTQ"},{"@language":"ja","@value":"LGBTQ+をテーマにした漫画"}],"rdfs:comment":[{"@language":"en","@value":"Satirical drawings created by LGBTQ+ cartoonists or that depict someone or something relating to LGBTQ+ culture."},{"@language":"es","@value":"Dibujos satíricos creados por caricaturistas LGBTQ+ o que representan a alguien o algo relacionado con la cultura LGBTQ+."},{"@language":"ja","@value":"LGBTQ+の漫画家によって制作された漫画、またはLGBTQ+文化に関連する人物や事物を描いた漫画。"},{"@language":"nl","@value":"Satirische tekeningen van iets of iemand met betrekking tot de LHBTQ+-cultuur"},{"@language":"sv","@value":"Satirteckningar skapade av hbtq+-konstnärer eller som avbildar något relaterat till hbtq+-kultur."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000841"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0002144"},{"@id":"https://homosaurus.org/v5/homoit0002172"},{"@id":"https://homosaurus.org/v5/homoit0003881"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQCartoons"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002144","dc:identifier":"homoit0002144","skos:prefLabel":[{"@language":"en","@value":"Anime and manga fandom"},{"@language":"es","@value":"Fandom de anime y manga"},{"@language":"de","@value":"Anime und Manga Fandom"},{"@language":"nl","@value":"Anime en manga fandom"},{"@language":"sv","@value":"Anime- och mangafandom"}],"skos:altLabel":[{"@language":"en","@value":"Anime and manga fan community"},{"@language":"en","@value":"Anime fandom"},{"@language":"en","@value":"Manga and anime fandom"},{"@language":"en","@value":"Manga fandom"},{"@language":"es","@value":"Comunidad fan del anime y manga"},{"@language":"es","@value":"Fandom de anime"},{"@language":"es","@value":"Fandom de manga"},{"@language":"es","@value":"Comunidades fan de anime y manga"},{"@language":"de","@value":"Anime und Manga Fangemeinde"},{"@language":"de","@value":"Anime Fandom"},{"@language":"de","@value":"Manga Fandom"},{"@language":"de","@value":"Manga und Anime Fandom"},{"@language":"de","@value":"Manga Fangemeinde"},{"@language":"de","@value":"Manga und Anime Fangemeinde"},{"@language":"de","@value":"Anime Fangemeinde"},{"@language":"de","@value":"Anime und Manga Fantum"},{"@language":"de","@value":"Anime Fantum"},{"@language":"de","@value":"Manga Fantum"},{"@language":"nl","@value":"Anime fandom"},{"@language":"nl","@value":"Manga en anime fandom"},{"@language":"nl","@value":"Manga fandom"}],"rdfs:comment":[{"@language":"en","@value":"The fan community that focuses on, incorporates, or details the relationships of characters derived from anime or manga."},{"@language":"es","@value":"La comunidad de fans que se centra sobre, incorpora o detalla las relaciones de personajes derivados del anime o manga."},{"@language":"de","@value":"Die Fangemeinde, die sich auf die Beziehungen von Figuren aus Anime oder Manga konzentriert, diese einbezieht oder detailliert beschreibt."},{"@language":"nl","@value":"De fangemeenschap die zich richt op of details geeft over de relaties van personages die zijn afgeleid van anime of manga"},{"@language":"sv","@value":"Fangemenskap som fokuserar på eller skildrar relationer mellan karaktärer från anime eller manga."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002156"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0002149"},{"@id":"https://homosaurus.org/v5/homoit0002151"},{"@id":"https://homosaurus.org/v5/homoit0002152"},{"@id":"https://homosaurus.org/v5/homoit0002173"},{"@id":"https://homosaurus.org/v5/homoit0002221"},{"@id":"https://homosaurus.org/v5/homoit0003507"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000828"},{"@id":"https://homosaurus.org/v5/homoit0000897"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002172","dc:identifier":"homoit0002172","skos:prefLabel":[{"@language":"ja","@value":"Hentai"},{"@language":"es","@value":"Hentai"},{"@language":"de","@value":"Hentai"},{"@language":"nl","@value":"Hentai"},{"@language":"sv","@value":"Hentai"}],"rdfs:comment":[{"@language":"en","@value":"A genre of anime and manga characterized by explicit sexual content; can also include hentai video games."},{"@language":"es","@value":"Un género de anime y manga caracterizado por contenido sexual explícito; también puede incluir videojuegos hentai."},{"@language":"ja","@value":"露骨な性的描写を特徴とするアニメやマンガのジャンル。これにはエロゲームも含まれることがある。一般的には、性的関心が強い人や異常に性欲が強い人、性的なプレイを好む人、あるいはその行為を示す。"},{"@language":"de","@value":"Ein Anime- und Manga-Genre, das sich durch explizite sexuelle Inhalte auszeichnet; kann auch Hentai-Videospiele umfassen."},{"@language":"nl","@value":"Een genre van anime en manga dat wordt gekenmerkt door expliciete seksuele inhoud; kan ook hentai-videogames bevatten"},{"@language":"sv","@value":"En genre inom anime och manga som kännetecknas av explicit sexuellt innehåll. Kan även inkludera hentai-datorspel."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001128"},{"@id":"https://homosaurus.org/v5/homoit0002173"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000828"},{"@id":"https://homosaurus.org/v5/homoit0000859"},{"@id":"https://homosaurus.org/v5/homoit0000897"},{"@id":"https://homosaurus.org/v5/homoit0002217"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000011"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000867","dc:identifier":"homoit0000867","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ film censorship"},{"@language":"es","@value":"Censura de cine LGBTQ+"},{"@language":"nl","@value":"LHBTQ+-filmcensuur"},{"@language":"sv","@value":"Filmcensur (hbtq+)"}],"skos:altLabel":{"@language":"en","@value":"LGBTQ film censorship"},"rdfs:comment":[{"@language":"en","@value":"The suppression or prohibition of films by LGBTQ+ filmmakers or about LGBTQ+ people and issues; includes censorship due to religious, moral, political, or social objections."},{"@language":"es","@value":"La supresión o prohibición de películas de cineastas LGBTQ+ o sobre personas y temas LGBTQ+; incluye censura por objeciones religiosas, morales, políticas o sociales."},{"@language":"nl","@value":"Het onderdrukken of verbieden van films van LHBTQ+-filmmakers of over LHBTQ+-personen en -kwesties; omvat censuur vanwege religieuze, morele, politieke of sociale opvattingen."},{"@language":"sv","@value":"Förtryck, förbud eller censur av filmer skapade av hbtq+-personer eller med hbtq+-tematik. Inkluderar censur baserad på religiösa, moraliska, politiska eller sociala invändningar."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000829"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000869"},{"@id":"https://homosaurus.org/v5/homoit0002327"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000245"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQFilmCensorship"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000964","dc:identifier":"homoit0000964","skos:prefLabel":[{"@language":"en-us","@value":"LGBTQ+ youth centers"},{"@language":"es","@value":"Centros juveniles LGBTQ+"},{"@language":"nl","@value":"LHBTQ+-jongerencentra"},{"@language":"sv","@value":"Mötesplatser för hbtq+-ungdomar"},{"@language":"en-gb","@value":"LGBTQ+ youth centres"}],"skos:altLabel":{"@language":"sv","@value":"Fritidsgårdar för hbtq+-ungdomar"},"rdfs:comment":[{"@language":"en","@value":"Spaces in which LGBTQ+ young people meet for social, education, recreational, or organizing activities."},{"@language":"es","@value":"Espacios en los que jóvenes LGBTQ+ se reúnen para realizar actividades sociales, educativas, recreativas u organizativas."},{"@language":"nl","@value":"Ruimtes waar LHBTQ+-jongeren elkaar ontmoeten voor sociale, educatieve, recreatieve activiteiten of het organiseren van daarvan."},{"@language":"sv","@value":"Platser där unga hbtq+-personer möts för sociala, utbildningsrelaterade, fritids- eller organisatoriska aktiviteter."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000830"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001521"},{"@id":"https://homosaurus.org/v5/homoit0004262"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000830"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQYouthCentres"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000832","dc:identifier":"homoit0000832","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ chatrooms"},{"@language":"es","@value":"Salas de chat LGBTQ+"},{"@language":"ja","@value":"LGBTQ+のチャットルーム"},{"@language":"nl","@value":"LHBTQ+-chatrooms"},{"@language":"sv","@value":"Hbtq+-chattrum"}],"skos:altLabel":[{"@language":"en","@value":"LGBTQ chatrooms"},{"@language":"es","@value":"Salas de chat LGBTQ"},{"@language":"ja","@value":"LGBTQのチャットルーム"},{"@language":"sv","@value":"Chattkanaler (hbtq+)"},{"@language":"sv","@value":"Chattrum (hbtq+)"}],"rdfs:comment":[{"@language":"en","@value":"Online websites or applications for virtual, instant communication; use in reference to chatrooms focusing on LGBTQ+ communities or issues, as well as chatrooms with primarily LGBTQ+ members."},{"@language":"es","@value":"Sitios web o aplicaciones en línea para comunicación virtual e instantánea; utilícese en referencia a salas de chat que se centran en comunidades o cuestiones LGBTQ+, así como salas de chat con miembros principalmente LGBTQ+."},{"@language":"ja","@value":"バーチャルでリアルタイムのコミュニケーションを行うためのオンラインサイトやアプリケーション。LGBTQ+コミュニティや関連する課題に焦点を当てたチャットルーム、および主にLGBTQ+のメンバーで構成されるチャットルームを指して使用される。"},{"@language":"nl","@value":"Online websites of applicaties voor virtuele, directe communicatie; gebruik in verwijzing naar chatrooms gericht op LHBTQ+-gemeenschappen of -kwesties, evenals chatrooms met voornamelijk LHBTQ+-leden."},{"@language":"sv","@value":"Webbplatser eller appar för direktkommunikation online. Används för chattrum med fokus på hbtq+-frågor eller där medlemmarna huvudsakligen är hbtq+-personer."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000946"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000946"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQChatrooms"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Vers