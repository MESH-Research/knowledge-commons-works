kos:altLabel":[{"@language":"es","@value":"Golpe de paleta"},{"@language":"es","@value":"Paddling"},{"@language":"sv","@value":"Paddling"}],"rdfs:comment":[{"@language":"en","@value":"Striking a body with a paddle as a form of impact play."},{"@language":"es","@value":"Golpear un cuerpo con una paleta o \"paddle\" como forma de juego de impacto."},{"@language":"nl","@value":"Het slaan van een lichaam met een peddel als een vorm van impactspel."},{"@language":"sv","@value":"Att slå en kropp med en paddel som en form av ”impact play”."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0003053"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000081"},{"@id":"https://homosaurus.org/v5/homoit0001068"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000404"},"dc:issued":{"@type":"xsd:date","@value":"2023-12-18"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000082","dc:identifier":"homoit0000082","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ atheists"},{"@language":"es","@value":"Ateos LGBTQ+"},{"@language":"ja","@value":"LGBTQ+の無神論者"},{"@language":"nl","@value":"LHBTQ+-atheïsten"},{"@language":"sv","@value":"Ateister (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"Atheists (LGBTQ)"},{"@language":"es","@value":"Ateos (LGBTQ)"},{"@language":"ja","@value":"無神論者(LGBTQ)"}],"rdfs:comment":[{"@language":"en","@value":"LGBTQ+ people who do not believe in the existence of God or gods."},{"@language":"es","@value":"Personas LGBTQ+ que son ateas."},{"@language":"ja","@value":"宗教的な神の存在を信じていないLGBTQ+の人々。"},{"@language":"nl","@value":"LHBTQ+-ers die niet geloven in het bestaan van God of goden."},{"@language":"sv","@value":"Hbtq+-personer som inte tror på Gud eller gudar."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000915"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000132"},{"@id":"https://homosaurus.org/v5/homoit0000473"},{"@id":"https://homosaurus.org/v5/homoit0000723"},{"@id":"https://homosaurus.org/v5/homoit0001160"},{"@id":"https://homosaurus.org/v5/homoit0001393"},{"@id":"https://homosaurus.org/v5/homoit0002973"},{"@id":"https://homosaurus.org/v5/homoit0002979"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000928"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/atheistsLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000132","dc:identifier":"homoit0000132","skos:prefLabel":[{"@language":"en","@value":"Bisexual atheists"},{"@language":"es","@value":"Ateos bisexuales"},{"@language":"de","@value":"Bisexuelle Atheist:innen"},{"@language":"nl","@value":"Biseksuele atheïsten"},{"@language":"sv","@value":"Bisexuella ateister"}],"rdfs:comment":[{"@language":"en","@value":"Bisexual people who are atheists."},{"@language":"es","@value":"Personas bisexuales que son ateas."},{"@language":"de","@value":"Bisexuelle Menschen, die atheistisch sind."},{"@language":"nl","@value":"Biseksuele personen die atheïst zijn"},{"@language":"sv","@value":"Bisexuella personer som är ateister."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000082"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualAtheists"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000473","dc:identifier":"homoit0000473","skos:prefLabel":[{"@language":"en","@value":"Gay atheists"},{"@language":"es","@value":"Ateos gay"},{"@language":"de","@value":"Schwule Atheisten"},{"@language":"nl","@value":"Homo-atheïsten"},{"@language":"sv","@value":"Ateistiska bögar"}],"skos:altLabel":{"@language":"sv","@value":"Ateistiska homosxuella män"},"rdfs:comment":[{"@language":"en","@value":"Gay men who are atheists."},{"@language":"es","@value":"Hombres gay que son ateos."},{"@language":"de","@value":"Schwule Männer, die atheistisch sind."},{"@language":"sv","@value":"Bögar som är ateister."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000082"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayAtheists"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000723","dc:identifier":"homoit0000723","skos:prefLabel":[{"@language":"en","@value":"Lesbian atheists"},{"@language":"es","@value":"Ateas lesbianas"},{"@language":"de","@value":"Lesbische Atheistinnen"},{"@language":"nl","@value":"Lesbische atheïsten"},{"@language":"sv","@value":"Lesbiska aktivister"}],"skos:altLabel":{"@language":"de","@value":"Atheistische Lesben"},"rdfs:comment":[{"@language":"en","@value":"Lesbians who are atheists."},{"@language":"es","@value":"Lesbianas que son ateas."},{"@language":"de","@value":"Lesben, die Atheistinnen sind."},{"@language":"nl","@value":"Lesbische vrouwen die atheïst zijn."},{"@language":"sv","@value":"Lesbiska som är ateister."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000082"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianAtheists"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001160","dc:identifier":"homoit0001160","skos:prefLabel":[{"@language":"en","@value":"Queer atheists"},{"@language":"es","@value":"Ateos queer"},{"@language":"nl","@value":"Queer atheïsten"},{"@language":"sv","@value":"Queera ateister"}],"rdfs:comment":[{"@language":"en","@value":"Queer people who are atheists."},{"@language":"es","@value":"Personas queer que son ateas."},{"@language":"nl","@value":"Queer personen die atheïst zijn."},{"@language":"sv","@value":"Queera personer som är ateister."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000082"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerAtheists"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001393","dc:identifier":"homoit0001393","skos:prefLabel":[{"@language":"en","@value":"Transgender atheists"},{"@language":"es","@value":"Ateos transgénero"},{"@language":"nl","@value":"Transgender atheïsten"},{"@language":"sv","@value":"Ateistiska transpersoner"}],"rdfs:comment":[{"@language":"en","@value":"Transgender people who are atheists."},{"@language":"es","@value":"Personas transgénero que son ateas."},{"@language":"nl","@value":"Transgender personen die atheïst zijn."},{"@language":"sv","@value":"Transpersoner som är ateister."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000082"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transgenderAtheists"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002973","dc:identifier":"homoit0002973","skos:prefLabel":[{"@language":"en","@value":"Intersex atheists"},{"@language":"es","@value":"Ateos intersex"},{"@language":"nl","@value":"Intersekse atheïsten"},{"@language":"sv","@value":"Intersexateister"}],"rdfs:comment":[{"@language":"en","@value":"Intersex people who are atheists."},{"@language":"es","@value":"Personas intersex que son ateas."},{"@language":"nl","@value":"Intersekse personen die atheïst zijn"},{"@language":"sv","@value":"Intersexpersoner som är ateister."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000082"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-09-29"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002979","dc:identifier":"homoit0002979","skos:prefLabel":[{"@language":"en","@value":"Asexual atheists"},{"@language":"es","@value":"Ateos asexuales"},{"@language":"de","@value":"Asexuelle Atheist:innen"},{"@language":"nl","@value":"Aseksuele atheïsten"},{"@language":"sv","@value":"Asexuella ateister"}],"skos:altLabel":{"@language":"de","@value":"Ace Atheist:innen"},"rdfs:comment":[{"@language":"en","@value":"Asexual people who are atheists."},{"@language":"es","@value":"Personas asexuales que son ateas."},{"@language":"de","@value":"Asexuelle Personen, die atheistisch sind."},{"@language":"nl","@value":"Aseksuele personen die atheïst zijn"},{"@language":"sv","@value":"Asexuella personer som är ateister."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000082"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-10-27"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000083","dc:identifier":"homoit0000083","skos:prefLabel":[{"@language":"en","@value":"Autoeroticism"},{"@language":"es","@value":"Autoerotismo"},{"@language":"de","@value":"Autoerotik"},{"@language":"nl","@value":"Auto-erotiek"},{"@language":"sv","@value":"Autoerotik"}],"rdfs:comment":[{"@language":"en","@value":"Practice of sexually stimulating oneself."},{"@language":"es","@value":"Práctica de estimularse sexualmente."},{"@language":"de","@value":"Die Ausübung sexueller Selbststimulierung."},{"@language":"sv","@value":"Aktivitet där en person sexuellt stimulerar sig själv."}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001000"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000083"},"dc:replaces":{"@id":"http://homosaurus.org/v2/autoeroticism"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001000","dc:identifier":"homoit0001000","skos:prefLabel":[{"@language":"en","@value":"Masturbation"},{"@language":"es","@value":"Masturbación"},{"@language":"fr","@value":"Masturbation"},{"@language":"nl","@value":"Masturbatie"},{"@language":"sv","@value":"Onani"}],"rdfs:comment":[{"@language":"en","@value":"Sexual stimulation of one's own genitals for sexual pleasure."},{"@language":"es","@value":"Estimulación sexual de los propios genitales para el placer sexual."},{"@language":"fr","@value":"Stimulation sexuelle de ses propres organes génitaux pour son propre plaisir."},{"@language":"sv","@value":"Sexuell stimulans av de egna könsorganen för sexuell njutning."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001267"},{"@id":"https://homosaurus.org/v5/homoit0001299"}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000681"},{"@id":"https://homosaurus.org/v5/homoit0001033"},{"@id":"https://homosaurus.org/v5/homoit0001498"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000083"},{"@id":"https://homosaurus.org/v5/homoit0000589"},{"@id":"https://homosaurus.org/v5/homoit0000988"},{"@id":"https://homosaurus.org/v5/homoit0001328"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85082015"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001267"},"dc:replaces":{"@id":"http://homosaurus.org/v2/masturbation"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000084","dc:identifier":"homoit0000084","skos:prefLabel":[{"@language":"en","@value":"Aversion therapy"},{"@language":"es","@value":"Terapia de aversión"},{"@language":"de","@value":"Aversionstherapie"},{"@language":"fr","@value":"Thérapie par aversion"},{"@language":"nl","@value":"Aversietherapie"},{"@language":"sv","@value":"Aversionsterapi (hbtq+)"}],"skos:altLabel":[{"@language":"fr","@value":"Conditionnement aversif"},{"@language":"fr","@value":"Thérapie aversive"},{"@language":"fr","@value":"Cure de dégoût"}],"rdfs:comment":[{"@language":"en","@value":"Behavior modification therapy intended to displace pleasant associations evoked by homosexuality with unpleasant ones (in the form of electric shocks or nausea-inducing drugs) in order to shift the subject's homosexual orientation to a heterosexual one."},{"@language":"es","@value":"Terapia de modificación de comportamiento que busca sustituir asociaciones placenteras evocadas por la homosexualidad con otras desagradables (utilizando descargas eléctricas o fármacos que provocan náuseas) con el fin de cambiar la orientación homosexual del sujeto por una heterosexual."},{"@language":"de","@value":"Verhaltenstherapie, die darauf abzielt, angenehme Assoziationen, die durch Homosexualität hervorgerufen werden, durch unangenehme Assoziationen (in Form von Elektroschocks oder Brechmitteln) zu ersetzen, um die homosexuelle Orientierung der Proband:innen in eine heterosexuelle zu ändern."},{"@language":"fr","@value":"Thérapie de modification du comportement visant à remplacer les associations agréables associées à l'homosexualité par des associations désagréables (au moyen de décharges électriques ou de médicaments provoquant des nausées) dans le but de modifier l'orientation sexuelle de la personne pour qu'elle « devienne » hétérosexuelle."},{"@language":"nl","@value":"gedragstherapeutische techniek, die vooral gebruikt wordt bij het behandelen van afwijkende impulsen die de patiënt bevrediging geven; ook gebruikt om homoseksualiteit te 'genezen' of te ontmoedigen door het toedienen van electrische schokken of braakmiddelen in combinatie met het aanbieden van homoseksuele stimuli"},{"@language":"sv","@value":"Beteendeterapi som syftar till att ersätta positiva associationer kopplade till homosexualitet med negativa, exempelvis genom elchocker eller illamåendeframkallande läkemedel, i försök att förändra individens homosexuella läggning till en heterosexuell."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000106"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000303"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85010520"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001004"},"dc:replaces":{"@id":"http://homosaurus.org/v2/aversionTherapy"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000106","dc:identifier":"homoit0000106","skos:prefLabel":[{"@language":"en-us","@value":"Behavioral therapy"},{"@language":"es","@value":"Terapia conductual"},{"@language":"de","@value":"Verhaltenstherapie"},{"@language":"fr","@value":"Thérapie comportementale"},{"@language":"nl","@value":"Gedragstherapie"},{"@language":"sv","@value":"Beteendeterapi"},{"@language":"en-gb","@value":"Behavioural therapy"}],"skos:altLabel":[{"@language":"es","@value":"Terapia de comportamiento"},{"@language":"es","@value":"Terapia de conducta"}],"rdfs:comment":[{"@language":"en","@value":"Therapeutic techniques and treatments derived from cognitive psychology that are designed to identify and potentially change behaviors perceived as self-destructive or unhealthy. Includes behavioral therapy intended to alter an individual's sexual or gender identity or expression."},{"@language":"es","@value":"Técnicas y tratamientos terapéuticos derivados de la psicología cognitiva diseñados para identificar y potencialmente cambiar conductas percibidas como autodestructivas o poco saludables. Incluye la terapia conductual destinada a modificar la identidad o expresión sexual o de género de una persona."},{"@language":"de","@value":"Aus der kognitiven Psychologie abgeleitete therapeutische Techniken und Behandlungen, die darauf abzielen, als selbstzerstörerisch oder ungesund empfundene Verhaltensweisen zu erkennen und möglicherweise zu ändern. Dazu gehören auch Verhaltenstherapien, die darauf abzielen, die sexuelle oder geschlechtliche Identität oder den Ausdruck einer Person zu verändern."},{"@language":"fr","@value":"Approche thérapeutique dérivée de la psychologie cognitive conçue pour identifier et éventuellement modifier les comportements perçus comme autodestructeurs ou malsains. La thérapie comportementale peut viser à modifier l'identité ou l'expression sexuelle ou de genre d'une personne."},{"@language":"nl","@value":"Therapeutische technieken en behandelingen afgeleid van de cognitieve psychologie die zijn ontworpen om gedrag dat als zelfdestructief of ongezond wordt beschouwd, te identificeren en mogelijk te veranderen. Omvat ook gedragstherapie die bedoeld is om de seksuele of genderidentiteit of -expressie van een persoon te veranderen."},{"@language":"sv","@value":"Terapeutiska metoder och behandlingar med ursprung i kognitiv psykologi som syftar till att identifiera och eventuellt förändra beteenden som uppfattas som självdestruktiva eller ohälsosamma. Inkluderar beteendeterapi med syfte att förändra en individs sexuella eller könsrelaterade identitet eller uttryck."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001366"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000084"},{"@id":"https://homosaurus.org/v5/homoit0000303"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85012900"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001004"},"dc:replaces":{"@id":"http://homosaurus.org/v2/behaviouralTherapy"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000303","dc:identifier":"homoit0000303","skos:prefLabel":[{"@language":"en","@value":"Conversion therapy"},{"@language":"de","@value":"Konversionstherapie"},{"@language":"es","@value":"Terapia de conversión de género"},{"@language":"nl","@value":"Conversietherapie"},{"@language":"sv","@value":"Omvändelseterapi"}],"skos:altLabel":[{"@language":"en","@value":"Reparative therapy"},{"@language":"en","@value":"Reorientation therapy"},{"@language":"en","@value":"Sexual reorientation therapy"},{"@language":"de","@value":"Reparativtherapie"},{"@language":"de","@value":"Umpolungstherapie"},{"@language":"es","@value":"Terapia de conversion de género"},{"@language":"es","@value":"Terapia de conversión para personas trans"},{"@language":"es","@value":"Terapia de conversación para personas transgénero"},{"@language":"es","@value":"Terapia de reorientacion de género"},{"@language":"es","@value":"Terapia de conversión trans"},{"@language":"es","@value":"Terapia de conversión transgénero"},{"@language":"nl","@value":"Reparatieve therapie"},{"@language":"nl","@value":"Seksuele heroriëntatie therapie"}],"rdfs:comment":[{"@language":"en","@value":"Efforts to change the sexual or gender identity of an individual who is or is suspected to be LGBTQ+ to meet heterosexual or cisgender norms, typically under the belief that being LGBTQ+ is dangerous and/or the result of mental illness or trauma. The processes involved in conversion therapy include visualization training, spiritual interventions, and other aversion treatments. "},{"@language":"de","@value":"Bemühungen, die sexuelle oder geschlechtliche Identität einer Person, die LGBTQ+ ist oder vermutlich ist, zu ändern, um heterosexuellen oder cisgender Normen zu entsprechen, typischerweise in der Überzeugung, dass LGBTQ+ zu sein gefährlich und/oder das Ergebnis einer psychischen Erkrankung oder eines Traumas ist. Zu den Verfahren der Konversionstherapie gehören Visualisierungstraining, spirituelle Interventionen und andere Aversionsbehandlungen."},{"@language":"es","@value":"Esfuerzos por cambiar la identidad de género de una persona transgénero o no binaria para que se ajuste a las normas cisgénero, normalmente bajo la creencia de que su identidad es peligrosa y/o el resultado de una enfermedad mental o un trauma. Los procesos implicados en la terapia de conversión incluyen entrenamiento de visualización, intervenciones espirituales y otros tratamientos de aversión."},{"@language":"nl","@value":"Pogingen om de seksuele of genderidentiteit van een persoon die LHBTQ+ is of waarvan wordt vermoed dat hij LHBTQ+ is, te veranderen om te voldoen aan heteroseksuele of cisgender-normen, doorgaans in de veronderstelling dat LHBTQ+ zijn gevaarlijk is en/of het resultaat is van een psychische aandoening of trauma. De processen die betrokken zijn bij conversietherapie omvatten visualisatietraining, spirituele interventies en andere aversiebehandelingen."},{"@language":"sv","@value":"Försök att förändra en individs sexuella eller könsrelaterade identitet om personen är eller misstänks vara hbtq+, i syfte att anpassa individen till heterosexuella eller cispersoners normer, ofta utifrån föreställningen att hbtq+ är farligt och/eller ett resultat av psykisk ohälsa eller trauma. Metoder inom omvändelseterapi inkluderar visualiseringsträning, andliga interventioner och andra former av aversionsterapi."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000106"},"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0003512"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2006004076"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001004"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sexualReorientation"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000085","dc:identifier":"homoit0000085","skos:prefLabel":[{"@language":"he","@value":"Aylonit"},{"@language":"es","@value":"Aylonit"},{"@language":"de","@value":"Aylonit"},{"@language":"nl","@value":"Aylonit"},{"@language":"sv","@value":"Aylonit"},{"@language":"he","@value":"Ay'lonit"}],"rdfs:comment":[{"@language":"en","@value":"A romanized version of the Hebrew term traditionally used in Judaism to describe people assigned female at birth who develop secondary-sex characteristics perceived as \"male\" as well as fertility issues."},{"@language":"es","@value":"Término hebreo que se refiere a una mujer con desarrollo masculino que suele ser infértil."},{"@language":"de","@value":"Eine romanisierte Version des hebräischen Begriffs, der im Judentum traditionell verwendet wird, um Menschen zu beschreiben, denen bei der Geburt das weibliche Geschlecht zugewiesen wurde und die sekundäre Geschlechtsmerkmale entwickeln, die als „männlich“ wahrgenommen werden, sowie Probleme mit der Fruchtbarkeit haben."},{"@language":"nl","@value":"Een geromaniseerde versie van Hebreeuwse term die traditioneel in het Jodendom wordt gebruikt om mensen te beschrijven die bij de geboorte als vrouw zijn aangemerkt en die secundaire geslachtskenmerken ontwikkelen die als 'mannelijk' worden beschouwd, en die vruchtbaarheidsproblemen hebben."},{"@language":"sv","@value":"En israelisk term som används för att beskriva kvinnor med maskulina drag och som vanligen är infertila."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000322"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/aylonit"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000086","dc:identifier":"homoit0000086","skos:prefLabel":[{"@language":"en","@value":"Bondage"},{"@language":"es","@value":"Bondage"},{"@language":"de","@value":"Bondage"},{"@language":"fr","@value":"Bondage"},{"@language":"nl","@value":"Bondage"},{"@language":"sv","@value":"Bondage"}],"skos:altLabel":[{"@language":"en","@value":"Erotic bondage"},{"@language":"en","@value":"Sexual bondage "},{"@language":"es","@value":"B\u0026D"},{"@language":"es","@value":"Bondage y disciplina"},{"@language":"fr","@value":"Ligotage"},{"@language":"nl","@value":"Bondage en discipline"}],"rdfs:comment":[{"@language":"en","@value":"The act of tying up or restraining the body, usually with rope, cuffs, tape, or other adhesive, for the purposes of erotic enjoyment or aesthetic appreciation."},{"@language":"es","@value":"Actos sexuales que implican la restricción física de una pareja."},{"@language":"de","@value":"Das Fesseln oder Festbinden des Körpers, in der Regel mit Seilen, Handschellen, Klebeband oder anderen Haftmitteln, zum Zweck erotischer Lust oder ästhetischer Betrachtung."},{"@language":"fr","@value":"Acte d'attacher ou d'immobiliser le corps, habituellement avec de la corde, des menottes, du ruban adhésif ou un autre, à des fins de plaisir érotique ou d'appréciation esthétique."},{"@language":"nl","@value":"Seksuele handelingen waarbij een partner wordt vastgebonden"},{"@language":"sv","@value":"Handling där kroppen binds eller begränsas, vanligtvis med rep, handbojor, tejp eller andra fästanordningar, i syfte att uppnå erotisk njutning eller en estetisk upplevelse."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000442"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0003071"},{"@id":"https://homosaurus.org/v5/homoit0003089"},{"@id":"https://homosaurus.org/v5/homoit0003145"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001238"},{"@id":"https://homosaurus.org/v5/homoit0003059"},{"@id":"https://homosaurus.org/v5/homoit0003090"},{"@id":"https://homosaurus.org/v5/homoit0003117"},{"@id":"https://homosaurus.org/v5/homoit0003134"},{"@id":"https://homosaurus.org/v5/homoit0003146"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85015498"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000404"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bondage"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003071","dc:identifier":"homoit0003071","skos:prefLabel":[{"@language":"en","@value":"Mummification (Erotic)"},{"@language":"es","@value":"Momificación (erótica)"},{"@language":"nl","@value":"Mummificatie (Erotisch)"},{"@language":"sv","@value":"Mumifiering (erotik)"}],"rdfs:comment":[{"@language":"en","@value":"A form of bondage that involves wrapping the body with bandages, plastic wrap, or other materials."},{"@language":"es","@value":"Una forma de bondage que consiste en envolver el cuerpo con vendas, plástico u otros materiales."},{"@language":"nl","@value":"Een vorm van bondage waarbij het lichaam wordt omwikkeld met verband, plastic folie of andere materialen."},{"@language":"sv","@value":"En form av bondage som innebär att kroppen lindas in i bandage, plastfolie eller annat material."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000086"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001238"},{"@id":"https://homosaurus.org/v5/homoit0003850"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000404"},"dc:issued":{"@type":"xsd:date","@value":"2023-12-18"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003089","dc:identifier":"homoit0003089","skos:prefLabel":[{"@language":"en","@value":"Rope bondage"},{"@language":"es","@value":"Bondage de cuerda"},{"@language":"nl","@value":"Touw bondage"},{"@language":"sv","@value":"Repbondage"}],"skos:altLabel":[{"@language":"en","@value":"Japanese rope bondage"},{"@language":"en","@value":"Kinbaku"},{"@language":"en","@value":"Shibari"},{"@language":"es","@value":"Atadura con cuerda"},{"@language":"es","@value":"Kinbaku"},{"@language":"es","@value":"Shibari"},{"@language":"nl","@value":"Kinbaku"},{"@language":"nl","@value":"Shibari"},{"@language":"sv","@value":"Rope bondage"}],"rdfs:comment":[{"@language":"en","@value":"Use of rope to tie and restrain the body for sensual or erotic play."},{"@language":"es","@value":"Uso de cuerda para atar y sujetar el cuerpo para juegos sensuales o eróticos."},{"@language":"nl","@value":"Het gebruik van touw om het lichaam vast te binden en vast te houden tijdens een sensueel of erotisch spel."},{"@language":"sv","@value":"Användning av rep för att binda och begränsa kroppen i syfte att skapa sexuell eller sensuell njutning."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000086"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001238"},{"@id":"https://homosaurus.org/v5/homoit0001242"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000404"},"dc:issued":{"@type":"xsd:date","@value":"2023-12-18"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003145","dc:identifier":"homoit0003145","skos:prefLabel":[{"@language":"en","@value":"Hogtie"},{"@language":"de","@value":"Hogtie"},{"@language":"es","@value":"Atar de manos y pies"},{"@language":"nl","@value":"Hogtie"},{"@language":"sv","@value":"Hogtie"}],"skos:altLabel":[{"@language":"en","@value":"Hogtie restraining"},{"@language":"de","@value":"Hogtie-Fesselung"},{"@language":"es","@value":"Cerdito invertido"},{"@language":"es","@value":"Hogtie"}],"rdfs:comment":[{"@language":"en","@value":"The position or activity of tying a person’s wrists and ankles together behind their back."},{"@language":"de","@value":"Die Position oder Handlung, bei der die Handgelenke und Knöchel einer Person hinter dem Rücken zusammengebunden werden."},{"@language":"es","@value":"La posición o actividad de atar las muñecas y los tobillos de una persona detrás de su espalda."},{"@language":"nl","@value":"De positie of activiteit van het samenbinden van iemands polsen en enkels achter de rug."},{"@language":"sv","@value":"Position eller aktivitet där en persons handleder och fotleder binds samman bakom ryggen."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000086"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001238"},{"@id":"https://homosaurus.org/v5/homoit0003117"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000404"},"dc:issued":{"@type":"xsd:date","@value":"2024-01-02"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001238","dc:identifier":"homoit0001238","skos:prefLabel":[{"@language":"en","@value":"Restraints"},{"@language":"es","@value":"Restricciones"},{"@language":"nl","@value":"Bondage-objecten"},{"@language":"sv","@value":"Fängsel"}],"skos:altLabel":{"@language":"sv","@value":"Restraints"},"rdfs:comment":[{"@language":"en","@value":"Binding tools, devices, and accessories such as handcuffs, legcuffs, ropes, chains, straps, or straitjackets."},{"@language":"es","@value":"Objetos para atar como esposas, esposas, cuerdas, cadenas, correas o camisas de fuerza."},{"@language":"nl","@value":"Hulpmiddelen, apparaten en accessoires om vast te binden zoals handboeien, beenboeien, touwen, kettingen, riemen of dwangbuizen"},{"@language":"sv","@value":"Föremål och redskap som används för att binda fast eller begränsa en persons rörelseförmåga, till exempel handfängsel, rep, kedjor eller tvångströjor."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001266"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0003115"},{"@id":"https://homosaurus.org/v5/homoit0003117"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000086"},{"@id":"https://homosaurus.org/v5/homoit0000704"},{"@id":"https://homosaurus.org/v5/homoit0003059"},{"@id":"https://homosaurus.org/v5/homoit0003071"},{"@id":"https://homosaurus.org/v5/homoit0003089"},{"@id":"https://homosaurus.org/v5/homoit0003090"},{"@id":"https://homosaurus.org/v5/homoit0003145"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001266"},"dc:replaces":{"@id":"http://homosaurus.org/v2/restraints"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003059","dc:identifier":"homoit0003059","skos:prefLabel":[{"@language":"en","@value":"Kink accessories"},{"@language":"es","@value":"Accesorios kink"},{"@language":"nl","@value":"Kink accessoires"},{"@language":"sv","@value":"Kink-accessoarer"}],"skos:altLabel":[{"@language":"en","@value":"Bondage gear"},{"@language":"en","@value":"Bondagewear"},{"@language":"en","@value":"Fetishwear"},{"@language":"en","@value":"Leather gear"},{"@language":"nl","@value":"Bondage kleding"},{"@language":"nl","@value":"Fetisj kleding"},{"@language":"nl","@value":"Leren accessoires"}],"rdfs:comment":[{"@language":"en","@value":"Items used during kink play or worn as fashionable accessories to indicate participation in the kink or leather communities."},{"@language":"es","@value":"Elementos utilizados durante juegos de kink o empleados como accesorios de moda para indicar la participación en las comunidades de kink o cuero."},{"@language":"nl","@value":"Voorwerpen die worden gebruikt tijdens het kinkspel of worden gedragen als modieuze accessoires om deelname aan de kink- of leergemeenschappen aan te duiden."},{"@language":"sv","@value":"Föremål som används under kinklekar eller bärs som modeaccessoarer för att signalera tillhörighet till kink- eller lädergemenskaper."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000442"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000209"},{"@id":"https://homosaurus.org/v5/homoit0000293"},{"@id":"https://homosaurus.org/v5/homoit0000307"},{"@id":"https://homosaurus.org/v5/homoit0000612"},{"@id":"https://homosaurus.org/v5/homoit0003058"},{"@id":"https://homosaurus.org/v5/homoit0003062"},{"@id":"https://homosaurus.org/v5/homoit0003063"},{"@id":"https://homosaurus.org/v5/homoit0003090"},{"@id":"https://homosaurus.org/v5/homoit0003134"},{"@id":"https://homosaurus.org/v5/homoit0003142"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000086"},{"@id":"https://homosaurus.org/v5/homoit0000705"},{"@id":"https://homosaurus.org/v5/homoit0001238"},{"@id":"https://homosaurus.org/v5/homoit0001266"},{"@id":"https://homosaurus.org/v5/homoit0003066"},{"@id":"https://homosaurus.org/v5/homoit0003100"},{"@id":"https://homosaurus.org/v5/homoit0003107"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000404"},"dc:issued":{"@type":"xsd:date","@value":"2023-12-15"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003090","dc:identifier":"homoit0003090","skos:prefLabel":[{"@language":"en","@value":"Gags"},{"@language":"es","@value":"Mordaza"},{"@language":"de","@value":"Gags"},{"@language":"nl","@value":"Knevels"},{"@language":"sv","@value":"Munkavlar"}],"skos:altLabel":[{"@language":"en","@value":"Ball gags"},{"@language":"en","@value":"Ballgags"},{"@language":"de","@value":"Ball gags"},{"@language":"de","@value":"Knebel"},{"@language":"de","@value":"Ballknebel"},{"@language":"sv","@value":"Gags"}],"rdfs:comment":[{"@language":"en","@value":"An item or device used to prevent speech, usually by blocking or filling the mouth. Often used in some forms of bondage play."},{"@language":"es","@value":"Un artículo o dispositivo utilizado para impedir el habla."},{"@language":"de","@value":"Ein Gegenstand oder Gerät, das verwendet wird, um das Sprechen zu verhindern, meist durch Blockieren oder Ausfüllen des Mundes. Wird häufig in einigen Formen von Bondage-Spiel verwendet."},{"@language":"nl","@value":"Een voorwerp of apparaat dat wordt gebruikt om het spreken te verhinderen, meestal door de mond te blokkeren of te vullen. Vaak gebruikt bij sommige vormen van bondage."},{"@language":"sv","@value":"Föremål eller redskap som används för att förhindra tal, vanligtvis genom att blockera eller fylla munnen. Används ofta inom vissa former av bondage."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0003059"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000086"},{"@id":"https://homosaurus.org/v5/homoit0001238"},{"@id":"https://homosaurus.org/v5/homoit0003112"},{"@id":"https://homosaurus.org/v5/homoit0003146"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000404"},"dc:issued":{"@type":"xsd:date","@value":"2023-12-18"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003117","dc:identifier":"homoit0003117","skos:prefLabel":[{"@language":"en","@value":"Cuffs"},{"@language":"de","@value":"Fesseln"},{"@language":"es","@value":"Grilletes"},{"@language":"nl","@value":"Boeien"},{"@language":"sv","@value":"Handfängsel"}],"skos:altLabel":[{"@language":"en","@value":"Cuff restraints"},{"@language":"de","@value":"Manschetten"},{"@language":"de","@value":"Manschettenfesseln"},{"@language":"sv","@value":"Cuffs"}],"rdfs:comment":[{"@language":"en","@value":"Any of various restraint devices designed to secure an individual’s wrists or ankles in bondage play."},{"@language":"de","@value":"Verschiedene Fesselvorrichtungen, die dazu dienen, die Handgelenke oder Knöchel einer Person bei Fesselspielen zu fixieren."},{"@language":"es","@value":"Cualquiera de los diversos dispositivos de sujeción diseñados para asegurar las muñecas o los tobillos de una persona en un juego de bondage."},{"@language":"nl","@value":"Een van de verschillende bevestigingsmiddelen die zijn ontworpen om iemands polsen of enkels vast te zetten bij bondagespel."},{"@language":"sv","@value":"Olika typer av fasthållningsanordningar som är utformade för att fixera en individs handleder eller vrister vid bondage-lekar."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001238"},{"@id":"https://homosaurus.org/v5/homoit0003066"}],"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0000608"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000086"},{"@id":"https://homosaurus.org/v5/homoit0003145"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001266"},"dc:issued":{"@type":"xsd:date","@value":"2023-12-20"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003134","dc:identifier":"homoit0003134","skos:prefLabel":[{"@language":"en","@value":"Body bags (Erotic)"},{"@language":"es","@value":"Bolsas corporales (erotica)"},{"@language":"de","@value":"Bodybag (erotisch)"},{"@language":"nl","@value":"Lichaamstassen (Erotisch)"},{"@language":"sv","@value":"Kroppssäckar (erotiskt)"}],"skos:altLabel":{"@language":"sv","@value":"Body bags (erotiskt)"},"rdfs:comment":[{"@language":"en","@value":"A body encasing or bag, often leather, used for sensory deprivation or during kink or sexual play."},{"@language":"es","@value":"Una funda o bolsa para el cuerpo, a menudo de cuero, utilizada para la privación sensorial o durante el juego sexual o kinky."},{"@language":"de","@value":"Eine Körperhülle oder ein Sack, oft aus Leder, der zur sensorischen Deprivation oder bei sexuellen Praktiken verwendet wird."},{"@language":"nl","@value":"Een omhulsel of zak voor het lichaam, vaak van leer, gebruikt voor sensorische deprivatie of tijdens kinky of seksueel spel."},{"@language":"sv","@value":"En helkroppsdräkt eller påse som används för att blockera sinnesintryck eller under kinkaktiviteter och sexuella lekar."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001266"},{"@id":"https://homosaurus.org/v5/homoit0003059"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000086"},{"@id":"https://homosaurus.org/v5/homoit0003850"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001266"},"dc:issued":{"@type":"xsd:date","@value":"2023-12-20"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003146","dc:identifier":"homoit0003146","skos:prefLabel":[{"@language":"en","@value":"Hoods (Erotic)"},{"@language":"es","@value":"Capuchas (erótico)"},{"@language":"de","@value":"Hoods"},{"@language":"nl","@value":"Kappen (Erotisch)"},{"@language":"sv","@value":"Huvor (erotik)"}],"skos:altLabel":[{"@language":"en","@value":"Bondage hoods"},{"@language":"de","@value":"Bondage-Hoods"}],"rdfs:comment":[{"@language":"en","@value":"A hood used as a head covering or restraint, for kink, erotic play or fashion."},{"@language":"es","@value":"Una capucha que se utiliza para cubrir o sujetar la cabeza, para el kink, los juegos eróticos o de moda."},{"@language":"de","@value":"Eine Haube oder Maske, die zur Bedeckung des Kopfes oder zur Fixierung dient und für Kink, erotisches Spiel oder modische Zwecke eingesetzt wird."},{"@language":"nl","@value":"Een kap die wordt gebruikt als hoofdbedekking of fixatie, voor kink, erotisch spel of mode."},{"@language":"sv","@value":"En huva som täcker huvudet, använd vid kink, erotisk lek eller som modeaccessoar."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001266"},{"@id":"https://homosaurus.org/v5/homoit0003066"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000086"},{"@id":"https://homosaurus.org/v5/homoit0000209"},{"@id":"https://homosaurus.org/v5/homoit0003090"},{"@id":"https://homosaurus.org/v5/homoit0003112"},{"@id":"https://homosaurus.org/v5/homoit0003850"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001266"},"dc:issued":{"@type":"xsd:date","@value":"2024-01-02"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000087","dc:identifier":"homoit0000087","skos:prefLabel":[{"@language":"en","@value":"Dark rooms"},{"@language":"de","@value":"Darkrooms"},{"@language":"es","@value":"Cuartos oscuros"},{"@language":"nl","@value":"Darkrooms"},{"@language":"sv","@value":"Dark rooms"}],"skos:altLabel":[{"@language":"en","@value":"Backrooms"},{"@language":"es","@value":"Dark rooms"},{"@language":"sv","@value":"Backrooms"},{"@language":"sv","@value":"Darkrooms"}],"rdfs:comment":[{"@language":"en","@value":"Rooms in nightclubs, sex clubs, or bathhouses where patrons can discretely engage in sexual activity. Dark rooms were common features in gay bars and clubs in the 1960-80s and remain common among swingers today."},{"@language":"de","@value":"Räume in Nachtclubs, Sexclubs oder Badehäusern, in denen Gäste diskret sexuellen Aktivitäten nachgehen können. Darkrooms entstanden ab den 1960er-Jahren in Schwulenbars und -clubs und sind auch heute noch in schwulen und queeren Szenen verbreitet."},{"@language":"es","@value":"Habitaciones en clubes nocturnos, clubes sexuales o baños públicos donde los clientes pueden participar discretamente en actividades sexuales. Los cuartos oscuros figuraban con frecuencia en los bares y clubes gay entre las décadas de 1960 y 1980, y siguen siendo comunes entre los swingers en la actualidad."},{"@language":"nl","@value":"Ruimtes in nachtclubs, seksclubs of badhuizen waar klanten discreet seksuele handelingen kunnen verrichten. Darkrooms waren gebruikelijk in homobars en -clubs in de jaren 1960-80 en zijn tegenwoordig nog steeds gebruikelijk onder swingers."},{"@language":"sv","@value":"Rum på nattklubbar, sexklubbar eller badhus där besökare diskret kan ha sex. Dark rooms var vanliga inslag i gaybarer och klubbar under 1960–80-talet och är fortfarande vanliga bland swingers idag."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000974"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000474"},{"@id":"https://homosaurus.org/v5/homoit0001270"},{