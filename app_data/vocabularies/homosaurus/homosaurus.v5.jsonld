/homoit0003713"},{"@id":"https://homosaurus.org/v5/homoit0003714"},{"@id":"https://homosaurus.org/v5/homoit0003715"},{"@id":"https://homosaurus.org/v5/homoit0003716"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000869"},{"@id":"https://homosaurus.org/v5/homoit0002327"},{"@id":"https://homosaurus.org/v5/homoit0003717"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000868"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQFilmFestivals"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003710","dc:identifier":"homoit0003710","skos:prefLabel":[{"@language":"en","@value":"Lesbian film festivals"},{"@language":"nl","@value":"Lesbische filmfestivals"},{"@language":"sv","@value":"Lesbiska filmfestivaler"}],"rdfs:comment":[{"@language":"en","@value":"Organized presentations of films in a single location, often with prizes awarded in various categories. Use in reference to film festivals focusing on films created by lesbians or featuring lesbian characters and themes."},{"@language":"nl","@value":"Georganiseerde filmpresentaties op één locatie, vaak met prijzen in verschillende categorieën; gebruik om te verwijzen naar filmfestivals die zich richten op films die zijn gemaakt door lesbische vrouwen of met lesbische personages en -thema's."},{"@language":"sv","@value":"Organiserade visningar av filmer på en plats, ofta med prisutdelningar i olika kategorier. Används för filmfestivaler med filmer skapade av lesbiska eller med lesbiska karaktärer och teman."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000868"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000868"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inS