vision"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000256","dc:identifier":"homoit0000256","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ children"},{"@language":"ja","@value":"LGBTQ+の子どもたち"},{"@language":"es","@value":"Niños y niñas LGBTQ+"},{"@language":"fr","@value":"Enfants LGBTQ+"},{"@language":"nl","@value":"LHBTQ+-kinderen"},{"@language":"sv","@value":"Hbtq+-barn"}],"skos:altLabel":[{"@language":"en","@value":"Children (LGBTQ)"},{"@language":"ja","@value":"子どもたち (LGBTQ)"},{"@language":"es","@value":"Niños (LGBTQ)"},{"@language":"es","@value":"Niñxs LGBTQ+"},{"@language":"es","@value":"Niños y niñas (LGBTQ)"},{"@language":"es","@value":"Niñxs LGBTQ"}],"rdfs:comment":[{"@language":"en","@value":"LGBTQ+ people who have not yet reached the age of adolescence."},{"@language":"ja","@value":"まだ思春期に達していないLGBTQ+の子どもたち。"},{"@language":"es","@value":"Niños y niñas menores de 18 años que se autoidentifican como LGBTQ+."},{"@language":"fr","@value":"Personnes LGBTQ+ qui n'ont pas encore atteint l'adolescence."},{"@language":"nl","@value":"LHBTQ+-ers die de puberteit nog niet hebben bereikt."},{"@language":"sv","@value":"Hbtq+-personer som ännu inte har nått tonåren."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000255"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000140"},{"@id":"https://homosaurus.org/v5/homoit0000668"},{"@id":"https://homosaurus.org/v5/homoit0001167"},{"@id":"https://homosaurus.org/v5/homoit0001307"},{"@id":"https://homosaurus.org/v5/homoit0001400"},{"@id":"https://homosaurus.org/v5/homoit0002222"},{"@id":"https://homosaurus.org/v5/homoit0002362"},{"@id":"https://homosaurus.org/v5/homoit0002363"},{"@id":"https://homosaurus.org/v5/homoit0002772"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001756"},{"@id":"https://homosaurus.org/v5/homoit0002699"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000421"},"dc:replaces":{"@id":"http://homosaurus.org/v2/childrenLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000152","dc:identifier":"homoit0000152","skos:prefLabel":[{"@language":"en","@value":"Bisexual girls"},{"@language":"de","@value":"Bisexuelle junge Frauen"},{"@language":"es","@value":"Niñas bisexuales"},{"@language":"fr","@value":"Filles bisexuelles"},{"@language":"nl","@value":"Biseksuele meiden"},{"@language":"sv","@value":"Bisexuella flickor"}],"skos:altLabel":{"@language":"sv","@value":"Bisexuella tjejer"},"rdfs:comment":[{"@language":"en","@value":"Girls (typically children younger than 18) who are bisexual."},{"@language":"de","@value":"Junge Frauen (in der Regel unter 18 Jahre), die sich als bisexuell identifizieren."},{"@language":"es","@value":"Niñas (normalmente niñas menores de 18 años) que son bisexuales."},{"@language":"fr","@value":"Filles (enfants de moins de 18 ans) qui sont bisexuelles."},{"@language":"nl","@value":"Meiden (meestal kinderen jonger dan 18 jaar) die biseksueel zijn"},{"@language":"sv","@value":"Flickor (vanligtvis barn eller ungdomar under 18 år) som är bisexuella."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000140"},{"@id":"https://homosaurus.org/v5/homoit0000192"},{"@id":"https://homosaurus.org/v5/homoit0000590"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualGirls"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000153","dc:identifier":"homoit0000153","skos:prefLabel":[{"@language":"en","@value":"Bisexual identity"},{"@language":"de","@value":"Bisexuelle Identität"},{"@language":"es","@value":"Identidad bisexual"},{"@language":"fr","@value":"Identité bisexuelle"},{"@language":"nl","@value":"Biseksuele identiteit"},{"@language":"sv","@value":"Bisexuell identitet"}],"rdfs:comment":[{"@language":"en","@value":"Term used to describe the sexual identity of individuals who are romantically and/or sexually attracted to people of more than one gender and who prefer the term bisexual over alternatives such as pansexual, polysexual, etc."},{"@language":"de","@value":"Begriff, der verwendet wird, um die sexuelle Identität von Personen zu beschreiben, die sich romantisch und/oder sexuell zu Menschen mehr als eines Geschlechts hingezogen fühlen und den Begriff „bisexuell“ gegenüber Alternativen wie „pansexuell“, „polysexuell“ usw. bevorzugen."},{"@language":"es","@value":"Término utilizado para describir la identidad sexual de personas que se sienten atraídas romántica y/o sexualmente por personas de más de un género y que prefieren el término bisexual a alternativas como pansexual, polisexual, etc."},{"@language":"fr","@value":"Identité sexuelle des personnes qui sont attirées romantiquement et sexuellement par des personnes du même genre qu'elles et d'un genre différent."},{"@language":"nl","@value":"Term die wordt gebruikt om de seksuele identiteit te beschrijven van personen die zich romantisch en/of seksueel aangetrokken voelen tot personen van meer dan één gender en die de voorkeur geven aan de term biseksueel boven alternatieven zoals panseksueel, polyseksueel, enz."},{"@language":"sv","@value":"Term som används för att beskriva den sexuella identiteten hos personer som är romantiskt och/eller sexuellt attraherade av personer av mer än ett kön och som föredrar termen bisexuell framför alternativ såsom pansexuell eller polysexuell."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001295"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000140"},{"@id":"https://homosaurus.org/v5/homoit0000170"},{"@id":"https://homosaurus.org/v5/homoit0004466"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001295"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualIdentity"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000141","dc:identifier":"homoit0000141","skos:prefLabel":[{"@language":"en","@value":"Bisexual Christians"},{"@language":"es","@value":"Cristianos bisexuales"},{"@language":"de","@value":"Bisexuelle Christ:innen"},{"@language":"nl","@value":"Biseksuele christenen"},{"@language":"sv","@value":"Bisexuella kristna"}],"skos:altLabel":[{"@language":"es","@value":"Cristianas bisexuales"},{"@language":"es","@value":"Cristianxs bisexuales"}],"rdfs:comment":[{"@language":"en","@value":"Bisexual people who are Christian."},{"@language":"es","@value":"Personas bisexuales que son cristianas."},{"@language":"de","@value":"Bisexuelle Personen, die christlich sind."},{"@language":"nl","@value":"Biseksuele personen die christen zijn."},{"@language":"sv","@value":"Bisexuella personer som är kristna."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000265"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000928"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualChristians"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000265","dc:identifier":"homoit0000265","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ Christians"},{"@langu