":"https://homosaurus.org/v5/homoit0002701"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-27"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003498","dc:identifier":"homoit0003498","skos:prefLabel":[{"@language":"en","@value":"Two-Spirit children's literature"},{"@language":"es","@value":"Literatura infantil dos espíritus"},{"@language":"nl","@value":"Two-Spirit kinderliteratuur"},{"@language":"sv","@value":"Two-spirit-barnlitteratur"}],"skos:altLabel":[{"@language":"en","@value":"2S children's literature"},{"@language":"en","@value":"Two Spirit children's literature"},{"@language":"en","@value":"Two Spirited children's literature"},{"@language":"en","@value":"Two-Spirit juvenile literature"},{"@language":"en","@value":"Two-Spirit kid lit"},{"@language":"en","@value":"Two-Spirited children's literature"},{"@language":"es","@value":"Literatura dos espíritus infantil"},{"@language":"nl","@value":"Two Spirit kinderliteratuur"},{"@language":"nl","@value":"Two Spirited kinderliteratuur"},{"@language":"nl","@value":"Two-Spirit kid lit"},{"@language":"nl","@value":"Two-Spirited kinderliteratuur"}],"rdfs:comment":[{"@language":"en","@value":"Written literary works for an audience of readers up to 12 years of age, also known as kid lit or juvenile literature. Use in reference to children's literature focusing on Two-Spirit characters or themes."},{"@language":"es","@value":"Obras literarias escritas para un público de lectores de hasta 12 años de edad, también conocidas como literatura infantil. Se utiliza en referencia a la literatura infantil centrada en personajes o temas dos espíritus."},{"@language":"nl","@value":"Geschreven literaire werken voor een publiek van lezers tot 12 jaar, ook bekend als kid lit. Gebruik in verwijzing naar kinderliteratuur die zich richt op Two-Spirit-personages of -thema's."},{"@language":"sv","@value":"Litterära verk för läsare upp till 12 års ålder. Används för barnlitteratur med Two-spirit-karaktärer eller teman."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002710"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0003488"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0002710"},"dc:issued":{"@type":"xsd:date","@value":"2024-07-31"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003919","dc:identifier":"homoit0003919","skos:prefLabel":[{"@language":"en","@value":"Two-Spirit survival guides"},{"@language":"nl","@value":"Two-Spirit overlevingsgidsen"},{"@language":"sv","@value":"Överlevnadsguider för Two-spirit-personer"}],"skos:altLabel":[{"@language":"en","@value":"Two Spirit survival guides"},{"@language":"en","@value":"Two-Spirited survival guides"},{"@language":"en","@value":"Two Spirited survival guides"},{"@language":"en","@value":"2S survival guides"}],"rdfs:comment":[{"@language":"en","@value":"Written publications designed to support Two-Spirit people by sharing common advice and community knowledge."},{"@language":"nl","@value":"Geschreven publicaties die Two-Spirit people ondersteunen door algemeen advies en kennis van de gemeenschap te delen."},{"@language":"sv","@value":"Publikationer skapade för att stödja two-spirit-personer genom att dela råd och kunskap."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002710"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0003911"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0002710"},"dc:issued":{"@type":"xsd:date","@value":"2025-03-20"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004026","dc:identifier":"homoit0004026","skos:prefLabel":[{"@language":"en","@value":"Two-Spirit people in literature"},{"@language":"nl","@value":"Two-Spirit people in de literatuur"},{"@language":"sv","@value":"Two-spirit-personer i litteraturen"}],"skos:altLabel":[{"@language":"en","@value":"Two Spirit people in literature"},{"@language":"en","@value":"Two-Spirited people in literature"},{"@language":"en","@value":"Two Spirited people in literature"},{"@language":"en","@value":"2S people in literature"}],"rdfs:comment":[{"@language":"en","@value":"The depiction of Two-Spirit people in literature."},{"@language":"nl","@value":"Het weergeven van Two-Spirit people in de literatuur."},{"@language":"sv","@value":"Skildringen av two-spirit-personer i litteraturen."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0003999"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0004018"},{"@id":"https://homosaurus.org/v5/homoit0002710"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2015002025"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2025-04-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004630","dc:identifier":"homoit0004630","skos:prefLabel":{"@language":"en","@value":"Two-Spirit personals"},"skos:altLabel":[{"@language":"en","@value":"Two-Spirit personal ads"},{"@language":"en","@value":"Two-Spirit personal advertisements"},{"@language":"en","@value":"Two Spirit personals"},{"@language":"en","@value":"Two Spirit personal ads"},{"@language":"en","@value":"Two Spirit personal advertisements"},{"@language":"en","@value":"Two-Spirited personals"},{"@language":"en","@value":"Two-Spirited personal ads"},{"@language":"en","@value":"Two-Spirited personal advertisements"},{"@language":"en","@value":"Two Spirited personals"},{"@language":"en","@value":"Two Spirited personal ads"},{"@language":"en","@value":"Two Spirited personal advertisements"},{"@language":"en","@value":"2S personals"},{"@language":"en","@value":"2S personal ads"},{"@language":"en","@value":"2S personal advertisements"}],"rdfs:comment":{"@language":"en","@value":"A form of classified advertising for Two-Spirit people interested in seeking connections around sex, romance, and/or community. The content of these ads focus largely on the type of arrangement sought and details or criteria about the writer and the type of person they are looking for (e.g. personality traits, physical looks, etc.). While Two-Spirit personals are most commonly thought of as existing in print media, they also have existed online in spaces such as Craigslist."},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0004621"},{"@id":"https://homosaurus.org/v5/homoit0002722"},{"@id":"https://homosaurus.org/v5/homoit0002719"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0004630"},"dc:issued":{"@type":"xsd:date","@value":"2026-06-09"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-09"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004325","dc:identifier":"homoit0004325","skos:prefLabel":[{"@language":"en","@value":"Two-Spirit podcasts"},{"@language":"nl","@value":"Two-Spirit podcasts"},{"@language":"sv","@value":"Two-spirit-poddar"}],"skos:altLabel":[{"@language":"en","@value":"Two Spirit podcasts"},{"@language":"en","@value":"Two Spirited podcasts"},{"@language":"en","@value":"Two-Spirited podcasts"},{"@language":"en","@value":"2S podcasts"},{"@language":"sv","@value":"Two-spirit-podcaster"}],"rdfs:comment":[{"@language":"en","@value":"A recorded series (primarily in audio, but sometimes with a video component) with recurring hosts that feature content about Two-Spirit people and/or Two-Spirit issues and that are available digitally for streaming or download. Podcasts are typically episodic and may feature different guests."},{"@language":"nl","@value":"Een opgenomen serie (voornamelijk audio, maar soms met een video-onderdeel) met terugkerende presentatoren die content presenteren over Two-Spirit people en/of Two-Spirit thema's en die digitaal beschikbaar zijn om te streamen of te downloaden. Podcasts bestaan ​​doorgaans uit afleveringen en kunnen verschillende gasten hebben."},{"@language":"sv","@value":"Inspelade radioprogram (inslag av video kan förekomma) med återkommande programledare och innehåll om/för two-spirit-personer och/eller two-spirit-frågor som är digitalt tillgängliga genom streaming eller nedladdning. Poddar är vanligen uppdelade i episoder och kan ha olika gäster."}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0002721"},{"@id":"https://homosaurus.org/v5/homoit0004317"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0004325"},"dc:issued":{"@type":"xsd:date","@value":"2026-02-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004024","dc:identifier":"homoit0004024","skos:prefLabel":[{"@language":"en","@value":"Intersex people in literature"},{"@language":"nl","@value":"Intersekse personen in de literatuur"},{"@language":"sv","@value":"Intersexpersoner i litteraturen"}],"rdfs:comment":[{"@language":"en","@value":"The depiction of intersex people in literature."},{"@language":"nl","@value":"Het weergeven van intersekse personen in de literatuur."},{"@language":"sv","@value":"Skildringen av intersexpersoner i litteraturen."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0004018"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0002750"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2025-04-23"},"dc:modi