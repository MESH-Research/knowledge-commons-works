guage":"sv","@value":"Icke-fiktiva filmer som fokuserar på demisexuella personer eller teman och som skapats i syfte att utbilda, föra fram aktivism eller uttrycka personliga erfarenheter."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0003720"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003732","dc:identifier":"homoit0003732","skos:prefLabel":[{"@language":"en","@value":"Greyromantic documentaries"},{"@language":"nl","@value":"Grijsromantische documentaires"},{"@language":"sv","@value":"Gråromantiska dokumentärer"}],"skos:altLabel":[{"@language":"en","@value":"Greyromantic documentary films"},{"@language":"sv","@value":"Greyromantic-dokumentärer"}],"rdfs:comment":[{"@language":"en","@value":"Non-fictional films that center greyromantic people or topics, created for the purposes of education, advocacy, or personal expression."},{"@language":"nl","@value":"Non-fictiefilms waarin grijsromantische personen of -onderwerpen centraal staan, gemaakt voor educatie, belangenbehartiging of persoonlijke expressie."},{"@language":"sv","@value":"Icke-fiktiva filmer som fokuserar på gråromantiska personer eller teman och som skapats i syfte att utbilda, föra fram aktivism eller uttrycka personliga erfarenheter."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0003720"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003733","dc:identifier":"homoit0003733","skos:prefLabel":[{"@language":"en","@value":"Megasexual documentaries"},{"@language":"nl","@value":"Megaseksuele documentaires"},{"@language":"sv","@value":"Megasexuella dokumentärer"}],"skos:altLabel":{"@language":"en","@value":"Megasexual documentary films"},"rdfs:comment":[{"@language":"en","@value":"Non-fictional films that center megasexual people or topics, created for the purposes of education, advocacy, or personal expression."},{"@language":"nl","@value":"Non-fictiefilms waarin megaseksuele personen of -onderwerpen centraal staan, gemaakt voor educatie, belangenbehartiging of persoonlijke expressie."},{"@language":"sv","@value":"Icke-fiktiva filmer som fokuserar på megasexuella personer eller teman och som skapats i syfte att utbilda, föra fram aktivism eller uttrycka personliga erfarenheter."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0003720"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003742","dc:identifier":"homoit0003742","skos:prefLabel":[{"@language":"en","@value":"Human trafficking"},{"@language":"nl","@value":"Mensenhandel"},{"@language":"sv","@value":"Människohandel"}],"skos:altLabel":[{"@language":"en","@value":"People trafficking"},{"@language":"sv","@value":"Trafficking"}],"rdfs:comment":[{"@language":"en","@value":"The trade and exploitation of human beings through force, fraud, and/or coercion, often with the intention of compelling the individual to provide sexual services or other forms of labor against their will."},{"@language":"nl","@value":"De handel in en uitbuiting van mensen door middel van geweld, bedrog en/of dwang, vaak met de bedoeling om het individu te dwingen seksuele diensten te verlenen of andere vormen van arbeid te verrichten tegen hun wil."},{"@language":"sv","@value":"Handel med och utnyttjande av människor genom tvång, bedrägeri och/eller övertalning, ofta i syfte att tvinga personen till att sälja sexuella handlingar eller arbete mot sin vilja."}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0003743"},{"@id":"https://homosaurus.org/v5/homoit0003744"}],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2006002629"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0003742"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-30"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003744","dc:identifier":"homoit0003744","skos:prefLabel":[{"@language":"en","@value":"Labor trafficking"},{"@language":"nl","@value":"Arbeidshandel"},{"@language":"sv","@value":"Människohandel för tvångsarbete"},{"@language":"en-gb","@value":"Labour trafficking"}],"skos:altLabel":[{"@language":"en","@value":"Forced labor"},{"@language":"en","@value":"Coerced labor"},{"@language":"sv","@value":"Traffickad arbetskraft"}],"rdfs:comment":[{"@language":"en","@value":"Human trafficking for the purpose of labor exploitation, including recruiting, holding, moving, defrauding, and/or coercing people into labor, such as through debt bondage or involuntary servitude, against their will."},{"@language":"nl","@value":"Mensenhandel met het oog op arbeidsuitbuiting, waaronder het werven, vasthouden, verplaatsen, oplichten en/of dwingen van mensen tot arbeid, bijvoorbeeld door middel van schuldslavernij of gedwongen arbeid, tegen hun wil."},{"@language":"sv","@value":"Människohandel i syfte att exploatera arbetskraft, inklusive rekrytering, förflyttning, frihetsberövande, bedrägeri och/eller tvång, till exempel genom skuldfällor eller ofrivilligt arbete."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0003742"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0003742"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-30"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003746","dc:identifier":"homoit0003746","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ survivors of human trafficking"},{"@language":"nl","@value":"LHBTQ+-overlevenden van mensenhandel"},{"@language":"sv","@value":"Hbtq+-personer som överlevt människohandel"}],"skos:altLabel":[{"@language":"en","@value":"Survivors of human trafficking (LGBTQ)"},{"@language":"en","@value":"LGBTQ+ trafficking survivors"},{"@language":"en","@value":"Trafficking survivors (LGBTQ)"},{"@language":"sv","@value":"Hbtq+-personer som överlevt trafficking"}],"rdfs:comment":[{"@language":"en","@value":"LGBTQ+ people who have experienced and survived human trafficking. Follow the individual's preference for \"victims\" or \"survivors\" whenever possible."},{"@language":"nl","@value":"LHBTQ+-personen die mensenhandel hebben meegemaakt en overleefd. Volg waar mogelijk de voorkeur van het individu voor \"slachtoffers\" of \"overlevenden\"."},{"@language":"sv","@value":"Hbtq+-personer som har upplevt och överlevt människohandel. Följ individens eget språkbruk om de föredrar ”offer” eller ”överlevare”."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0003745"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0003749"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-30"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003750","dc:identifier":"homoit0003750","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ victims of sex trafficking"},{"@language":"nl","@value":"LHBTQ+-slachtoffers van sekshandel"},{"@language":"sv","@value":"Offer för människohandel för sexuella ändamål (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"Victims of sex trafficking (LGBTQ)"},{"@language":"en","@value":"LGBTQ+ sex trafficking victims"},{"@language":"en","@value":"Sex trafficking victims (LGBTQ)"},{"@language":"sv","@value":"Offer för sextrafficking (hbtq+)"}],"rdfs:comment":[{"@language":"en","@value":"LGBTQ+ people who have experienced and may or may not have survived sex trafficking. Follow the individual's preference for \"victims\" or \"survivors\" whenever possible."},{"@language":"nl","@value":"LHBTQ+-personen die sekshandel hebben meegemaakt en misschien wel of niet hebben overleefd. Volg waar mogelijk de voorkeur van het individu voor \"slachtoffers\" of \"overlevenden\"."},{"@language":"sv","@value":"Hbtq+-personer som har utsatts för människohandel i form av sexuell exploatering och som kan ha överlevt eller inte. Följ individens eget språkbruk om de föredrar ”offer” eller ”överlevare”."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0003745"},"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0003751"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0003752"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-30"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003754","dc:identifier":"homoit0003754","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ victims of labor trafficking"},{"@language":"nl","@value":"LHBTQ+-slachtoffers van arbeidshandel"},{"@language":"sv","@value":"Offer för människohandel för tvångsarbete (hbtq+)"},{"@language":"en-gb","@value":"LGBTQ+ victims of labour trafficking"}],"skos:altLabel":[{"@language":"en","@value":"Victims of labor trafficking (LGBTQ)"},{"@la