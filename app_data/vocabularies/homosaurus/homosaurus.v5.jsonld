":"en","@value":"LGBTQ+ people who belong to the indigenous Kalasha people and reside in the Chitral District of Khyber-Pakhtunkhwa province in Pakistan."},{"@language":"es","@value":"Personas LGBTQ+ que pertenecen al pueblo indígena kalasha y residen en el distrito Chitral de la provincia Khyber-Pakhtunkhwa en Pakistán."},{"@language":"nl","@value":"LHBTQ+-personen die behoren tot het inheemse Kalasha-volk en wonen in het Chitral-district van de provincie Khyber-Pakhtunkhwa in Pakistan"},{"@language":"sv","@value":"Hbtq+-personer som tillhör det ursprungliga Kalashafolket och bor i Chitral-distriktet i Khyber-Pakhtunkhwa, Pakistan."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000860"},{"@id":"https://homosaurus.org/v5/homoit0001101"}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0002248"},{"@id":"https://homosaurus.org/v5/homoit0002249"},{"@id":"https://homosaurus.org/v5/homoit0002250"},{"@id":"https://homosaurus.org/v5/homoit0002251"},{"@id":"https://homosaurus.org/v5/homoit0002252"},{"@id":"https://homosaurus.org/v5/homoit0002253"},{"@id":"https://homosaurus.org/v5/homoit0002254"},{"@id":"https://homosaurus.org/v5/homoit0003412"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-28"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002295","dc:identifier":"homoit0002295","skos:prefLabel":[{"@language":"en","@value":"Kashmiri LGBTQ+ people"},{"@language":"es","@value":"Personas LGBTQ+ cachemires"},{"@language":"nl","@value":"Kasjmiri LHBTQ+-personen"},{"@language":"sv","@value":"Kashmirier (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"LGBTQ+ Kashmiri people"},{"@language":"en","@value":"LGBTQ+ Kashmiris"},{"@language":"nl","@value":"LHBTQ+ Kasjmiri's"}],"rdfs:comment":[{"@language":"en","@value":"LGBTQ+ people who live in or are descended from those native to the Kashmir Valley in the Indian subcontinent."},{"@language":"es","@value":"Personas LGBTQ+ que viven en o son descendientes de las personas nativas del valle de Cachemira en el subcontinente indio."},{"@language":"nl","@value":"LHBTQ+-personen die leven in of afstammen van oorspronkelijke bewoners van de Kasjmir-vallei op het Indiase subcontinent."},{"@language":"sv","@value":"Hbtq+-personer som bor i eller härstammar från Kashmirdalen i Indien."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000860"},{"@id":"https://homosaurus.org/v5/homoit0001101"}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0002296"},{"@id":"https://homosaurus.org/v5/homoit0002297"},{"@id":"https://homosaurus.org/v5/homoit0002298"},{"@id":"https://homosaurus.org/v5/homoit0002299"},{"@id":"https://homosaurus.org/v5/homoit0002300"},{"@id":"https://homosaurus.org/v5/homoit0002301"},{"@id":"https://homosaurus.org/v5/homoit0002302"},{"@id":"https://homosaurus.org/v5/homoit0003414"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-11-15"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002303","dc:identifier":"homoit0002303","skos:prefLabel":[{"@language":"en","@value":"Konkan LGBTQ+ people"},{"@language":"es","@value":"Personas LGBTQ+ konkani"},{"@language":"nl","@value":"Konkan LHBTQ+-personen"},{"@language":"sv","@value":"Konkanis (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"LGBTQ+ Konkani"},{"@language":"es","@value":"Personas konkani LGBTQ+"}],"rdfs:comment":[{"@language":"en","@value":"LGBTQ+ people who are from or descended from those native to the Konkan region of the Indian subcontinent, and who speak any of the dialects of the Konkani language."},{"@language":"es","@value":"Personas LGBTQ+ que pertenecen a o son descendientes de las personas nativas de la región Konkan del subcontinente indio, y que hablan cualquiera de los dialectos de la lengua konkani."},{"@language":"nl","@value":"LHBTQ+-personen die afkomstig zijn uit of afstammen van de oorspronkelijke bewoners van de Konkan-regio van het Indiase subcontinent en die een van de dialecten van de Konkani-taal spreken."},{"@language":"sv","@value":"Hbtq+-personer som kommer från eller härstammar från Konkanregionen i Indien och som talar någon form av konkani."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000860"},{"@id":"https://homosaurus.org/v5/homoit0001101"}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0002304"},{"@id":"https://homosaurus.org/v5/homoit0002305"},{"@id":"https://homosaurus.org/v5/homoit0002306"},{"@id":"https://homosaurus.org/v5/homoit0002307"},{"@id":"https://homosaurus.org/v5/homoit0002308"},{"@id":"https://homosaurus.org/v5/homoit0002309"},{"@id":"https://homosaurus.org/v5/homoit0002310"},{"@id":"https://homosaurus.org/v5/homoit0003416"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-11-15"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002311","dc:identifier":"homoit0002311","skos:prefLabel":[{"@language":"en","@value":"Kumaoni LGBTQ+ people"},{"@language":"es","@value":"Personas LGBTQ+ kumaoni"},{"@language":"nl","@value":"Kumaoni LHBTQ+-personen"},{"@language":"sv","@value":"Kumaoni (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"Kumain LGBTQ+ people"},{"@language":"en","@value":"Kumaiye LGBTQ+ people"},{"@language":"en","@value":"LGBTQ+ Kumaoni people"},{"@language":"es","@value":"Personas kumaoni LGBTQ+"},{"@language":"nl","@value":"Kumaiye LHBTQ+-personen"},{"@language":"nl","@value":"LHBTQ+-Kumaoni's"}],"rdfs:comment":[{"@language":"en","@value":"LGBTQ+ people who live mostly in Kumaon region in the Indian Himalayas. They might also speak the Kumaoni language as their first language."},{"@language":"es","@value":"Personas LGBTQ+ que viven principalmente en la región de Kumaon, en el Himalaya indio. También pueden hablar la lengua kumaoni como su primera lengua."},{"@language":"nl","@value":"LHBTQ+-personen die voornamelijk in de regio Kumaon in de Indiase Himalaya wonen. Ze spreken misschien ook de Kumaoni-taal als hun eerste taal."},{"@language":"sv","@value":"Hbtq+-personer som främst bor i Kumaonregionen i Indiens Himalaya och som eventuellt har kumaoni som modersmål."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000860"},{"@id":"https://homosaurus.org/v5/homoit0001101"}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0002312"},{"@id":"https://homosaurus.org/v5/homoit0002313"},{"@id":"https://homosaurus.org/v5/homoit0002314"},{"@id":"https://homosaurus.org/v5/homoit0002315"},{"@id":"https://homosaurus.org/v5/homoit0002316"},{"@id":"https://homosaurus.org/v5/homoit0002317"},{"@id":"https://homosaurus.org/v5/homoit0002318"},{"@id":"https://homosaurus.org/v5/homoit0003417"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-11-15"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002319","dc:identifier":"homoit0002319","skos:prefLabel":[{"@language":"en","@value":"Kutchi LGBTQ+ people"},{"@language":"es","@value":"Personas LGBTQ+ kutchi"},{"@language":"nl","@value":"Kutchi LHBTQ+-personen"},{"@language":"sv","@value":"Kutchi (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"LGBTQ+ Kutchi people"},{"@language":"es","@value":"Personas kutchi LGBTQ+"}],"rdfs:comment":[{"@language":"en","@value":"L