d assume the dominant role in sexual relationships with a dominant/submissive dynamic."},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000999"},{"@id":"https://homosaurus.org/v5/homoit0004612"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0004611"},"dc:issued":{"@type":"xsd:date","@value":"2026-06-08"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-08"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001033","dc:identifier":"homoit0001033","skos:prefLabel":[{"@language":"en","@value":"Mutual masturbation"},{"@language":"es","@value":"Masturbación mutua"},{"@language":"nl","@value":"Wederzijdse masturbatie"},{"@language":"sv","@value":"Gemensam onani"}],"rdfs:comment":[{"@language":"en","@value":"Sex act in which two or more people simultaneously stimulate their own genitalia."},{"@language":"es","@value":"Acto sexual en el que dos o más personas estimulan simultáneamente sus propios genitales."},{"@language":"nl","@value":"Seksuele handeling waarbij twee of meer mensen tegelijkertijd hun eigen geslachtsdelen stimuleren."},{"@language":"sv","@value":"Sexuell aktivitet där två eller flera personer samtidigt stimulerar sina egna könsorgan."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001000"},{"@id":"https://homosaurus.org/v5/homoit0001267"},{"@id":"https://homosaurus.org/v5/homoit0001299"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001267"},"dc:replaces":{"@id":"http://homosaurus.org/v2/mutualMasturbation"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001328","dc:identifier":"homoit0001328","skos:prefLabel":[{"@language":"en","@value":"Solo sex"},{"@language":"es","@value":"Sexo en solitario"},{"@language":"nl","@value":"Soloseks"},{"@language":"sv","@value":"Solosex"}],"skos:altLabel":[{"@language":"sv","@value":"Egensex"},{"@language":"sv","@value":"Ensamsex"}],"rdfs:comment":[{"@language":"en","@value":"Sexual acts involving only one person, such as masturbation, as opposed to sex with a partner."},{"@language":"es","@value":"Actos sexuales que involucran a una sola persona, como la masturbación, a diferencia del sexo con una pareja."},{"@language":"nl","@value":"Solo masturbatie, in tegenstelling tot seks met een partner."},{"@language":"sv","@value":"Sexuella handlingar som endast involverar en person, såsom onani, till skillnad från sex med en partner."}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001000"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001328"},"dc:replaces":{"@id":"http://homosaurus.org/v2/soloSex"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004465","dc:identifier":"homoit0004465","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ medical doctors"},{"@language":"nl","@value":"LHBTQ+-artsen"},{"@language":"sv","@value":"Läkare (hbtq+)"},{"@language":"en-gb","@value":"LGBTQ+ medical practitioners"}],"skos:altLabel":[{"@language":"en","@value":"LGBTQ physicians"},{"@language":"en","@value":"Doctors (LGBTQ+)"},{"@language":"en","@value":"LGBTQ+ doctors"},{"@language":"en","@value":"Physicians (LGBTQ+)"},{"@language":"nl","@value":"Dokters (LHBTQ+)"},{"@language":"nl","@value":"LHBTQ+-dokters"},{"@language":"nl","@value":"LHBTQ+-geneeskundigen"},{"@language":"nl","@value":"LHBTQ+-medische artsen"}],"rdfs:comment":[{"@language":"en","@value":"LGBTQ+ people who are licensed, qualified practitioners of medicine."},{"@language":"nl","@value":"LHBTQ+ personen die bevoegd en gekwalificeerd zijn als arts."},{"@language":"sv","@value":"Hbtq+-personer som är legitimerade och utbildade att praktisera medicin som läkare."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0004455"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0004477"},{"@id":"https://homosaurus.org/v5/homoit0004478"},{"@id":"https://homosaurus.org/v5/homoit0004479"},{"@id":"https://homosaurus.org/v5/homoit0004480"},{"@id":"https://homosaurus.org/v5/homoit0004481"},{"@id":"https://homosaurus.org/v5/homoit0004482"},{"@id":"https://homosaurus.org/v5/homoit0004484"},{"@id":"https://homosaurus.org/v5/homoit0004485"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001004"},{"@id":"https://homosaurus.org/v5/homoit0004483"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2026-02-24"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003223","dc:identifier":"homoit0003223","skos:prefLabel":[{"@language":"en","@value":"Pregnant men"},{"@language":"es","@value":"Hombres embarazados"},{"@language":"nl","@value":"Zwangere mannen"},{"@language":"sv","@value":"Gravida män"}],"skos:altLabel":{"@language":"sv","@value":"Gravida transmän"},"rdfs:comment":[{"@language":"en","@value":"Pregnant people who are trans or intersex men. For the fandom trope in which cisgender men can become pregnant, use the term \"Mpreg.\""},{"@language":"es","@value":"Personas embarazadas que son hombres trans o intersexuales. Para el tema recurrente de fandom donde los hombres cisgénero pueden quedar embarazados, utilícese el término \"Mpreg\"."},{"@language":"nl","@value":"Zwangere personen die trans- of intersekse mannen zijn. Gebruik de term “Mpreg” voor de fandom troop waarin cisgender mannen zwanger kunnen raken."},{"@language":"sv","@value":"Gravida personer som är transmän eller intersexpersoner. För fandomtroper om cis-män som blir gravida, använd termen ”Mpreg”."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001008"},{"@id":"https://homosaurus.org/v5/homoit0003364"}],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2004009893"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2024-05-24"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004644","dc:identifier":"homoit0004644","skos:prefLabel":{"@language":"en","@value":"Non-binary men"},"skos:altLabel":{"@language":"en","@value":"Nonbinary men"},"rdfs:comment":{"@language":"en","@value":"Men who are non-binary. Only use to describe people who identify both as men and non-binary."},"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001008"},{"@id":"https://homosaurus.org/v5/homoit0001048"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2026-06-10"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-10"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001185","dc:identifier":"homoit0001185","skos:prefLabel":[{"@language":"en","@value":"Queer men"},{"@language":"es","@value":"Hombres queer"},{"@language":"nl","@value":"Queer mannen"},{"@language":"sv","@value":"Queera män"}],"rdfs:comment":[{"@language":"en","@value":"Men who are queer."},{"@language":"es","@value":"Hombres que se identifican como queer."},{"@language":"nl","@value":"Mannen die zich identificeren als queer."},{"@language":"sv","@value":"Män som identifierar sig som queera."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001195"},{"@id":"https://homosaurus.org/v5/homoit0001008"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerMen"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002182","dc:identifier":"homoit0002182","skos:prefLabel":[{"@language":"en","@value":"Men in fandom"},{"@language":"es","@value":"Hombres en fandom"},{"@language":"nl","@value":"Mannen in fandom"},{"@language":"sv","@value":"Män inom fandom"}],"rdfs:comment":[{"@language":"en","@value":"The participation and inclusion of men in fan communities."},{"@language":"es","@value":"La participación e inclusión de los hombres en las comunidades de fans."},{"@language":"sv","@value":"Mäns deltagande och inkludering i fangemenskaper."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002171"},"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0002170"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001008"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004645","dc:identifier":"homoit0004645","skos:prefLabel":{"@language":"en","@value":"Two-Spirit men"},"skos:altLabel":[{"@language":"en","@value":"Two Spirit men"},{"@language":"en","@value":"Two-Spirited men"},{"@language":"en","@value":"Two Spirited men"},{"@language":"en","@value":"2S men"}],"rdfs:comment":{"@language":"en","@value":"Men who are Two-Spirit.  Only use to describe people who identify both as men and Two-Spirit."},"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001480"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001008"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2026-06-10"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-10"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001010","dc:identifier":"homoit0001010","skos:prefLabel":[{"@language":"en","@value":"Men's movement"},{"@language":"es","@value":"Movimiento de hombres"},{"@language":"nl","@value":"Mannenbeweging"},{"@language":"sv","@value":"Mansrörelser"}],"skos:altLabel":{"@language":"es","@value":"Men's movement"},"rdfs:comment":[{"@language":"en","@value":"Movement that began in the 1960s and 1970s (primarily in the United States, United Kingdom, and Australia) in response to the women's movement. Consists of groups and organizations of men and their allies working to address gender issues and their impact on men. Different men's movement groups vary significantly in how they frame their relationship to the women's movement and society at large. Not to be confused with the men's or father's rights movement, which focuses on perceived inequalities faced by men and seeks to maintain patriarchal values."},{"@language":"es","@value":"Movimiento que comenzó en las décadas de 1960 y 1970 (principalmente en los Estados Unidos, el Reino Unido y Australia) en respuesta al movimiento de mujeres. Está formado por grupos y organizaciones de hombres y sus aliados que trabajan para abordar los asuntos de género y su impacto en los hombres. Los diferentes grupos del movimiento de hombres varían significativamente en la forma en que enmarcan su relación con el movimiento de mujeres y la sociedad en general. No confundir con el movimiento por los derechos de los hombres o de los padres, que se centra en las desigualdades percibidas que enfrentan los hombres y busca mantener los valores patriarcales."},{"@language":"nl","@value":"Beweging die begon in de jaren zestig en zeventig (voornamelijk in de Verenigde Staten, Europa en Australië) als reactie op de vrouwenbeweging. Bestaat uit groepen en organisaties van mannen en hun bondgenoten die zich bezighouden met genderkwesties en hun impact op mannen. Verschillende mannenbewegingsgroepen verschillen aanzienlijk in de manier waarop ze hun relatie met de vrouwenbeweging en de samenleving in het algemeen vormgeven. Niet te verwarren met de mannen- of vaderrechtenbeweging, die zich richt op vermeende ongelijkheden waarmee mannen worden geconfronteerd en die patriarchale waarden tracht te behouden"},{"@language":"sv","@value":"En rörelse som växte fram under 1960- och 1970-talen, främst i USA, Storbritannien och Australien, som en reaktion på kvinnorörelsen. Består av grupper och organisationer av män och deras allierade som arbetar med frågor som rör kön och könsroller och hur dessa påverkar män. Olika delar av rörelsen skiljer sig åt i hur de förhåller sig till kvinnorörelsen och samhället i stort. Ska inte förväxlas med mäns rättighetsrörelser eller pappors rättighetsrörelser, som fokuserar på upplevda orättvisor mot män och ofta syftar till att upprätthålla patriarkala värderingar."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001322"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh92002382"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001322"},"dc:replaces":{"@id":"http://homosaurus.org/v2/mensMovement"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004442","dc:identifier":"homoit0004442","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ people with depression"},{"@language":"nl","@value":"LHBTQ+-personen met een depressie"},{"@language":"sv","@value":"Deprimerade hbtq+-personer"}],"skos:altLabel":[{"@language":"en","@value":"LGBTQ+ depressed people"},{"@language":"en","@value":"Depressed people (LGBTQ+)"},{"@language":"en","@value":"Depressed LGBTQ+ people"},{"@language":"nl","@value":"Depressieve personen (LHBTQ+)"},{"@language":"nl","@value":"LHBTQ+-depressieve personen"},{"@language":"sv","@value":"Hbtq+-personer med depression"},{"@language":"sv","@value":"Depression (hbtq+)"}],"rdfs:comment":[{"@language":"en","@value":"LGBTQ+ people who experience any of the key symptoms of depression, including but not limited to persistent sadness, loss of interest in everyday activities and difficulty and managing work, relationships, etc. LGBTQ+ people are at risk for a higher rate of depression due to life factors such as social stigma, discrimination, lack of family support, and other stressors. "},{"@language":"nl","@value":"LHBTQ+ personen die een of meer van de belangrijkste symptomen van depressie ervaren, waaronder maar niet beperkt tot aanhoudend verdriet, verlies van interesse in dagelijkse activiteiten en moeite met het combineren van werk, relaties, enz. LHBTQ+ personen lopen een hoger risico op depressie als gevolg van levensfactoren zoals sociaal stigma, discriminatie, gebrek aan steun van familie en andere stressfactoren."},{"@language":"sv","@value":"Hbtq+-personer som upplever depressionssymtom, inklusive men inte begränsat till ihållande nedstämdhet, minskat intresse för vardagliga aktiviteter och svårigheter att hantera arbete, relationer etc. Hbtq+-personer löper högre risk för depression på grund av livsfaktorer som social stigma, diskriminering, brist på familjestöd och andra stressfaktorer."}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001011"},{"@id":"https://homosaurus.org/v5/homoit0001012"},{"@id":"https://homosaurus.org/v5/homoit0004443"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0004442"},"dc:issued":{"@type":"xsd:date","@value":"2026-02-24"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004443","dc:identifier":"homoit0004443","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ people with anxiety"},{"@language":"nl","@value":"LHBTQ+-personen met angstklachten"},{"@language":"sv","@value":"Hbtq+-personer med ångest"}],"skos:altLabel":[{"@language":"en","@value":"LGBTQ+ anxious people"},{"@language":"en","@value":"Anxious people (LGBTQ+)"},{"@language":"en","@value":"Anxious LGBTQ+ people"},{"@language":"nl","@value":"Angstige personen (LHBTQ+)"},{"@language":"nl","@value":"LHBTQ+-angstige personen"}],"rdfs:comment":[{"@language":"en","@value":"LGBTQ+ people who experience any of the key symptoms of anxiety including but not limited to feelings of unease, worry and fear, commonly as a reaction to stress. LGBTQ+ people are at risk of higher rates of anxiety due to life factors such as social stigma, discrimination, lack of family support, and other stressors."},{"@language":"nl","@value":"LHBTQ+-personen die een of meer van de belangrijkste symptomen van angst ervaren, waaronder, maar niet beperkt tot, gevoelens van ongemak, zorgen en vrees, vaak als reactie op stress. LHBTQ+-personen lopen een hoger risico op angststoornissen als gevolg van levensfactoren zoals sociaal stigma, discriminatie, gebrek aan steun van familie en andere stressfactoren."},{"@language":"sv","@value":"HBTQ+-personer som upplever ångestsymptom, inklusive men inte begränsat till känslor av obehag, oro och rädsla, vanligtvis som en reaktion på stress. Hbtq+-personer löper större risk för ångest på grund av livsfaktorer som social stigma, diskriminering, brist på familjestöd och andra stressfaktorer."}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001011"},{"@id":"https://homosaurus.org/v5/homoit0001012"},{"@id":"https://homosaurus.org/v5/homoit0004442"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0004443"},"dc:issued":{"@type":"xsd:date","@value":"2026-02-24"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003990","dc:identifier":"homoit0003990","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ psychology"},{"@language":"nl","@value":"LHBTQ+-psychologie"},{"@language":"sv","@value":"Psykologi (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"Psychology (LGBTQ)"},{"@language":"sv","@value":"Hbtq+-psykologi"}],"rdfs:comment":[{"@language":"en","@value":"A subfield of psychology that focuses on the study of and care for the experiences, well-being, and mental health of LGBTQ+ people."},{"@language":"nl","@value":"Een deelgebied van psychologie dat zich richt op de studie van en de zorg voor de ervaringen, het welzijn en de geestelijke gezondheid van LHBTQ+-personen."},{"@language":"sv","@value":"Ett underområde inom psykologi som fokuserar på studier och vård av hbtq+-personer utifrån deras upplevelser, välbefinnande och mentala hälsa."}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001012"},{"@id":"https://homosaurus.org/v5/homoit0001366"}],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2005005061"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0003990"},"dc:issued":{"@type":"xsd:date","@value":"2025-04-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001135","dc:identifier":"homoit0001135","skos:prefLabel":[{"@language":"en","@value":"Pronouns"},{"@language":"es","@value":"Pronombres"},{"@language":"fr","@value":"Pronoms"},{"@language":"nl","@value":"Persoonlijke voornaamwoorden"},{"@language":"sv","@value":"Pronomen"}],"skos:altLabel":[{"@language":"en","@value":"Personal pronouns"},{"@language":"es","@value":"Pronombres personales"},{"@language":"nl","@value":"Voornaamwoorden"}],"rdfs:comment":[{"@language":"en","@value":"Words used in place of a noun. Typically used in the context of \"personal pronouns,\" or pronouns used to describe people (e.g., she, he, they, ze)."},{"@language":"es","@value":"Palabras utilizadas en lugar de un sustantivo. Normalmente se utiliza en el contexto de \"pronombres personales\" o pronombres utilizados para describir personas (por ejemplo, ella, él, elle, ellxs)."},{"@language":"fr","@value":"Mot ou groupe de mots qui représentent un autre mot ou groupe de mots énoncés avant ou après dans le texte, généralement utilisés dans le contexte des « pronoms personnels », c'est-à-dire des pronoms servant à désigner des personnes (par exemple : elle, il, iel, ille)."},{"@language":"nl","@value":"Persoonlijke pronouns (voornaamwoorden)"},{"@language":"sv","@value":"Ord som används istället för substantiv. Vanligtvis syftar man på personliga pronomen, det vill säga pronomen som används för att beskriva personer (t.ex. hon, han, hen, ze)."}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0001673"},{"@id":"https://homosaurus.org/v5/homoit0001674"},{"@id":"https://homosaurus.org/v5/homoit0001675"},{"@id":"https://homosaurus.org/v5/homoit0001676"},{"@id":"https://homosaurus.org/v5/homoit0001677"},{"@id":"https://homosaurus.org/v5/homoit0001678"},{"@id":"https://homosaurus.org/v5/homoit0001679"},{"@id":"https://homosaurus.org/v5/homoit0001680"},{"@id":"https://homosaurus.org/v5/homoit0001681"},{"@id":"https://homosaurus.org/v5/homoit0001682"},{"@id":"https://homosaurus.org/v5/homoit0001683"},{"@id":"https://homosaurus.org/v5/homoit0001684"},{"@id":"https://homosaurus.org/v5/homoit0001685"},{"@id":"https://homosaurus.org/v5/homoit0001686"},{"@id":"https://homosaurus.org/v5/homoit0001687"},{"@id":"https://homosaurus.org/v5/homoit0001688"},{"@id":"https://homosaurus.org/v5/homoit0001689"},{"@id":"https://homosaurus.org/v5/homoit0001690"},{"@id":"https://homosaurus.org/v5/homoit0001691"},{"@id":"https://homosaurus.org/v5/homoit0001692"},{"@id":"https://homosaurus.org/v5/homoit0001693"},{"@id":"https://homosaurus.org/v5/homoit0001694"},{"@id":"https://homosaurus.org/v5/homoit0001695"},{"@id":"https://homosaurus.org/v5/homoit0001696"},{"@id":"https://homosaurus.org/v5/homoit0001697"},{"@id":"https://homosaurus.org/v5/homoit0001698"},{"@id":"https://homosaurus.org/v5/homoit0001699"},{"@id":"https://homosaurus.org/v5/homoit0001700"},{"@id":"https://homosaurus.org/v5/homoit0001701"},{"@id":"https://homosaurus.org/v5/homoit0001702"},{"@id":"https://homosaurus.org/v5/homoit0001703"},{"@id":"https://homosaurus.org/v5/homoit0001704"},{"@id":"https://homosaurus.org/v5/homoit0001705"},{"@id":"https://homosaurus.org/v5/homoit0001706"},{"@id":"https://homosaurus.org/v5/homoit0001707"},{"@id":"https://homosaurus.org/v5/homoit0001708"},{"@id":"https://homosaurus.org/v5/homoit0001709"},{"@id":"https://homosaurus.org/v5/homoit0001710"},{"@id":"https://homosaurus.org/v5/homoit0001711"},{"@id":"https://homosaurus.org/v5/homoit0001712"},{"@id":"https://homosaurus.org/v5/homoit0001713"},{"@id":"https://homosaurus.org/v5/homoit0001714"},{"@id":"https://homosaurus.org/v5/homoit0001715"},{"@id":"https://homosaurus.org/v5/homoit0001716"},{"@id":"https://homosaurus.org/v5/homoit0004655"},{"@id":"https://homosaurus.org/v5/homoit0004656"},{"@id":"https://homosaurus.org/v5/homoit0004657"},{"@id":"https://homosaurus.org/v5/homoit0004658"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001016"},{"@id":"https://homosaurus.org/v5/homoit0001672"},{"@id":"https://homosaurus.org/v5/homoit0002259"}],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85043654"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001135"},"dc:replaces":{"@id":"http://homosaurus.org/v2/pronouns"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002259","dc:identifier":"homoit0002259","skos:prefLabel":[{"@language":"en","@value":"Gender-neutral language"},{"@language":"es","@value":"Lenguaje de género neutro"},{"@language":"de","@value":"genderneutrale Sprache"},{"@language":"nl","@value":"Genderneutrale taal"},{"@language":"sv","@value":"Könsneutralt språk"}],"skos:altLabel":[{"@language":"en","@value":"Gender inclusive language"},{"@language":"en","@value":"Gender neutral language"},{"@language":"en","@value":"Gender-inclusive language"},{"@language":"es","@value":"Lenguaje de género inclusivo"},{"@language":"es","@value":"Lenguage inclusivo"},{"@language":"es","@value":"Lenguaje de género neutral"},{"@language":"es","@value":"Lenguaje neutro"},{"@language":"de","@value":"geschlechtsneutrale Sprache"},{"@language":"de","@value":"geschlechtsinklusive Sprache"},{"@language":"de","@value":"genderinklusive Sprache"},{"@language":"nl","@value":"Gender neutrale taal"},{"@language":"nl","@value":"Gender-inclusieve taal"}],"rdfs:comment":[{"@language":"en","@value":"Language that avoids the use of gender-specific words, either to be inclusive of nonbinary, agender, and other gender diverse peoples, or to avoid gender bias."},{"@language":"es","@value":"Lenguaje que evita el uso de palabras generizadas, ya sea para incluir a personas no binarias, agénero y otras personas género-diversas, o para evitar prejuicios de género."},{"@language":"de","@value":"Sprache, die die Verwendung geschlechtsspezifischer Wörter vermeidet, entweder um nichtbinäre, agender und andere geschlechterdiverse Personen einzubeziehen oder um geschlechtliche Voreingenommenheit zu vermeiden."},{"@language":"nl","@value":"Taal die het gebruik van genderspecifieke woorden vermijdt, ofwel om niet-binaire, agender- en andere genderdiverse personen te omvatten, ofwel om gendervooroordelen te vermijden."},{"@language":"sv","@value":"Språkbruk som undviker könsspecifika ord, antingen för att inkludera ickebinära, agender och andra könsdiversa personer, eller för att undvika könsbias."}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001016"},{"@id":"https://homosaurus.org/v5/homoit0001135"},{"@id":"https://homosaurus.org/v5/homoit0001278"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0002259"},"dc:issued":{"@type":"xsd:date","@value":"2022-11-08"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002183","dc:identifier":"homoit0002183","skos:prefLabel":[{"@language":"en","@value":"Misogyny in fandom"},{"@language":"es","@value":"Misoginia en fandom"},{"@language":"nl","@value":"Misogynie in fandom"},{"@language":"sv","@value":"Misogyni inom fandom"}],"skos:altLabel":[{"@language":"en","@value":"Sexism in fandom"},{"@language":"es","@value":"Sexismo en fandom"}],"rdfs:comment":[{"@language":"en","@value":"Issues and discussions about the presence of misogyny in fan spaces and works."},{"@language":"es","@value":"Cuestiones y discusiones sobre la presencia de la misoginia en espacios y obras de fans."},{"@language":"nl","@value":"Kwesties en discussies over de aanwezigheid van misogynie in fan-ruimtes en uitingen"},{"@language":"sv","@value":"Frågor och diskussioner om förekomsten av misogyni i fangemenskaper och fanverk."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001017"},{"@id":"https://homosaurus.org/v5/homoit0002171"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001278"},{"@id":"https://homosaurus.org/v5/homoit0002194"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001017"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001904","dc:identifier":"homoit0001904","skos:prefLabel":[{"@language":"en","@value":"Misogynoir"},{"@language":"es","@value":"Misogynoir"},{"@language":"nl","@value":"Misogynoir"},{"@language":"sv","@value":"Misogynoir"}],"skos:altLabel":[{"@language":"es","@value":"Misoginia negra"},{"@language":"es","@value":"Sexismo hacia las mujeres negras"}],"rdfs:comment":[{"@language":"en","@value":"Term coined by scholar Moya Bailey to describe the intersection of misogyny and anti-Black racism as directed toward Black women."},{"@language":"es","@value":"El término original en inglés \"misogynoir\" fue acuñado por la académica Moya Bailey para describir la intersección de la misoginia y el racismo anti-negro dirigido hacia las mujeres negras."},{"@language":"nl","@value":"Term bedacht door Moya Bailey om de intersectie van mosogynie en anti-zwart racisme te beschrijven, gericht op zwarte vrouwen"},{"@language":"sv","@value":"Term myntad av forskaren Moya Bailey för att beskriva skärningspunkten mellan misogyni och rasism mot svarta riktad mot svarta kvinnor."}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001017"},{"@id":"https://homosaurus.org/v5/homoit0001892"},{"@id":"https://homosaurus.org/v5/homoit0001903"},{"@id":"https://homosaurus.org/v5/homoit0002038"},{"@id":"https://homosaurus.org/v5/homoit0002257"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2020010021"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001904"},"dc:issued":{"@type":"xsd:date","@value":"2022-03-29"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002992","dc:identifier":"homoit0002992","skos:prefLabel":[{"@language":"en","@value":"Asexual mistresses (BDSM culture)"},{"@language":"de","@value":"Asexuelle Mistresses"},{"@language":"nl","@value":"Aseksuele meesteressen (BDSM cultuur)"},{"@language":"sv","@value":"Asexuella härskarinnor"}],"skos:altLabel":[{"@language":"de","@value":"Ace Mistresses"},{"@language":"sv","@value":"Asexuella mistresses"}],"rdfs:comment":[{"@language":"en","@value":"Asexual women who are part of the BDSM scene and assume the mistress role in sexual relationships with a mistress/submissive dynamic."},{"@language":"de","@value":"Asexuelle Frauen, die Teil der BDSM-Szene sind und in sexuellen Beziehungen mit einer Mistress/Sklavin-Dynamik die Rolle der Herrin übernehmen."},{"@language":"nl","@value":"Aseksuele vrouwen die deel uitmaken van de BDSM-scene en de meesteresrol op zich nemen in seksuele relaties met een meesteres/onderdanige dynamiek."},{"@language":"sv","@value":"Asexuella personer som intar en dominerande roll inom BDSM och/eller i maktutbytesrelationer med en härskarinna/undergiven-dynamik. Termen används främst av feminint identifierade personer."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001018"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001295"},"dc:issued":{"@type":"xsd:date","@value":"2023-10-27"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001019","dc:identifier":"homoit0001019","skos:prefLabel":[{"@language":"en","@value":"Monogamy"},{"@language":"es","@value":"Monogamia"},{"@language":"fr","@value":"Monogamie"},{"@language":"nl","@value":"Monogamie"},{"@language":"sv","@value":"Monogami"}],"rdfs:comment":[{"@language":"en","@value":"Relationship orientation in which individuals are exclusively committed to one partner at a time."},{"@language":"es","@value":"Orientación relacional en la que las personas se comprometen exclusivamente con una pareja a la vez."},{"@language":"fr","@value":"Situation relationnelle dans laquelle les personnes s'engagent exclusivement avec un·e seul·e partenaire à la fois."},{"@language":"nl","@value":"Relatie-oriëntatie waarbij personen uitsluitend toegewijd zijn aan één partner tegelijkertijd."},{"@language":"sv","@value":"Relationsorientering där individen är exklusivt engagerad i endast en partner åt gången."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001081"},{"@id":"https://homosaurus.org/v5/homoit0001302"},{"@id":"https://homosaurus.org/v5/homoit0001636"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001295"},{"@id":"https://homosaurus.org/v5/homoit0001555"},{"@id":"https://homosaurus.org/v5/homoit0001916"}],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2005004443"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001300"},"dc:replaces":{"@id":"http://homosaurus.org/v2/monogamy"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001081","dc:identifier":"homoit0001081","skos:prefLabel":[{"@language":"en","@value":"Partner preference"},{"@language":"es","@value":"Preferencia de pareja"},{"@language":"nl","@value":"Partnerkeuze"},{"@language":"sv","@value":"Partnerpreferens"}],"rdfs:comment":[{"@language":"en","@value":"An enduring pattern of desire for connection and relationships (romantic, sexual, or play) with people of specific identities or within specific relationship orientations (monogamy, polyamory, polygamy)."},{"@language":"es","@value":"Un patrón duradero de deseo de conexión y relaciones (románticas, sexuales o de juego) con personas de identidades específicas o dentro de orientaciones relacionales específicas (monogamia, poliamor, poligamia)."},{"@language":"nl","@value":"Een blijvend patroon van verlangen naar verbinding en relaties (romantisch, seksueel of spel) met mensen met een specifieke identiteit of binnen specifieke relatieoriëntaties (monogamie, polyamorie, polygamie)."},{"@language":"sv","@value":"Ett varaktigt mönster av längtan efter anknytning och relationer – romantiska, sexuella eller kinkbaserade – med personer som har vissa identiteter eller relationella orienteringar (som monogami, polyamori, polygami)."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001300"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0001019"},{"@id":"https://homosaurus.org/v5/homoit0001124"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001295"},{"@id":"https://homosaurus.org/v5/homoit0001302"},{"@id":"https://homosaurus.org/v5/homoit0001311"},{"@id":"https://homosaurus.org/v5/homoit0001916"},{"@id":"https://homosaurus.org/v5/homoit0002255"},{"@id":"https://homosaurus.org/v5/homoit0002365"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001300"},"dc:replaces":{"@id":"http://homosaurus.org/v2/partnerPreference"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001916","dc:identifier":"homoit0001916","skos:prefLabel":[{"@language":"en","@value":"Monogamous people"},{"@language":"es","@value":"Personas monógamas"},{"@language":"fr","@value":"Personnes monogames"},{"@language":"nl","@value":"Monogame personen"},{"@language":"sv","@value":"Monogama personer"}],"rdfs:comment":[{"@language":"en","@value":"Individuals who engage in sexual or romantic relationships with only one person at a time."},{"@language":"es","@value":"Personas que mantienen relaciones sexuales o románticas con una sola persona a la vez."},{"@language":"fr","@value":"Personnes qui ont des relations sexuelles ou romantiques avec une seule personne à la fois."},{"@language":"nl","@value":"Personen die seksuele of romantische relaties aangaan met slechts één persoon tegelijk"},{"@language":"sv","@value":"Personer som har sexuella eller romantiska relationer med endast en person åt gången."}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001019"},{"@id":"https://homosaurus.org/v5/homoit0001081"},{"@id":"https://homosaurus.org/v5/homoit0001302"},{"@id":"https://homosaurus.org/v5/homoit0001555"},{"@id":"https://homosaurus.org/v5/homoit0001650"},{"@id":"https://homosaurus.org/v5/homoit0001656"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001916"},"dc:issued":{"@type":"xsd:date","@value":"2022-03-31"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002343","dc:identifier":"homoit0002343","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ mothers"},{"@language":"es","@value":"Madres LGBTQ+"},{"@language":"nl","@value":"LHBTQ+-moeders"},{"@language":"sv","@value":"Hbtq+-mammor"}],"skos:altLabel":[{"@language":"en","@value":"LGBTQ+ moms"},{"@language":"en","@value":"Moms (LGBTQ)"},{"@language":"en","@value":"Mothers (LGBTQ)"},{"@language":"es","@value":"Mamás LGBTQ+"},{"@language":"es","@value":"Mamás LGBTQ"},{"@language":"es","@value":"Madres LGBTQ"},{"@language":"es","@value":"Madres (LGBTQ)"},{"@language":"es","@value":"Mamás (LGBTQ)"},{"@language":"nl","@value":"Mama's (LHBTQ+)"},{"@language":"nl","@value":"Moeders (LHBTQ+)"},{"@language":"sv","@value":"Hbtq+-mödrar"},{"@language":"sv","@value":"Mammor (hbtq+)"}],"rdfs:comment":[{"@language":"en","@value":"LGBTQ+ people who are mothers."},{"@language":"es","@value":"Personas LGBTQ+ que son madres."},{"@language":"nl","@value":"LHBTQ+-personen die moeder zijn."},{"@language":"sv","@value":"Hbtq+-personer som är mammor."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001021"},{"@id":"https://homosaurus.org/v5/homoit0001075"}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0001422"},{"@id":"https://homosaurus.org/v5/homoit0002344"},{"@id":"https://homosaurus.org/v5/homoit0002345"},{"@id":"https://homosaurus.org/v5/homoit0002346"},{"@id":"https://homosaurus.org/v5/homoit0002347"},{"@id":"https://homosaurus.org/v5/homoit0002795"},{"@id":"https://homosaurus.org/v5/homoit0002916"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000421"},"dc:issued":{"@type":"xsd:date","@value":"2022-12-13"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002348","dc:identifier":"homoit0002348","skos:prefLabel":[{"@language":"en","@value":"Mothers of LGBTQ+ people"},{"@language":"es","@value":"Madres de personas LGBTQ+"},{"@language":"nl","@value":"Moeders van LHBTQ+-personen"},{"@language":"sv","@value":"Mammor till hbtq+-personer"}],"skos:altLabel":[{"@language":"en","@value":"Moms of LGBTQ+ people"},{"@language":"es","@value":"Mamás de personas LGBTQ+"},{"@language":"sv","@value":"Mödrar till hbtq+-personer"}],"rdfs:comment":[{"@language":"en","@value":"People who act as a mother to one or more LGBTQ+ person. For mothers who are themselves LGBTQ+, use the term \"LGBTQ+ mothers.\""},{"@language":"es","@value":"Personas que actúan como madre de una o más personas LGBTQ+. Para las madres que son LGBTQ+, utilice el término \"madres LGBTQ+\"."},{"@language":"nl","@value":"Personen die optreden als moeder van een of meer LHBTQ+-personen. Voor moeders die zelf LHBTQ+ zijn, gebruik de term 'LHBTQ+-moeders'."},{"@language":"sv","@value":"Personer som intar en modersroll i relation till en eller flera hbtq+-personer. För mammor som själva är hbtq+-personer, använd termen ”Hbtq+-mammor”."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001021"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0001022"},{"@id":"https://homo