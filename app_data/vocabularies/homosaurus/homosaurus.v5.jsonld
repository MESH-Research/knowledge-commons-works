,{"@language":"nl","@value":"Garhwali non-binaire personen"},{"@language":"sv","@value":"Ickebinära garwhali"}],"skos:altLabel":[{"@language":"en","@value":"Garhwali nonbinary people"},{"@language":"en","@value":"Non-binary Garhwali people"},{"@language":"en","@value":"Non-binary Garhwalis"},{"@language":"en","@value":"Nonbinary Garhwali people"},{"@language":"en","@value":"Nonbinary Garhwalis"},{"@language":"es","@value":"Personas garhwalis no binarias"},{"@language":"es","@value":"Garhwalis no binarixs"},{"@language":"es","@value":"No binarixs garhwalis"},{"@language":"nl","@value":"Non-binaire Garhwali's"},{"@language":"nl","@value":"Nonbinaire Garhwali's"}],"rdfs:comment":[{"@language":"en","@value":"Non-binary people who belong to or are descended from those native to Garhwal in Uttarakhand and who speak Garhwali."},{"@language":"es","@value":"Personas no binarias que pertenecen o son descendientes de las personas nativas de Garhwal en Uttarakhand y hablan garhwali."},{"@language":"nl","@value":"Non-binaire personen die behoren tot de oorspronkelijke bewoners van Garhwal in Uttarakhand of daarvan afstammen en die Garhwali spreken."},{"@language":"sv","@value":"Ickebinära personer som tillhör eller härstammar från ursprungsbefolkningen i Garhwal i Uttarakhand och som talar garhwali."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002134"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2024-07-11"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002196","dc:identifier":"homoit0002196","skos:prefLabel":[{"@language":"en","@value":"Real person fiction"},{"@language":"es","@value":"Ficción de personas reales"},{"@language":"nl","@value":"Real person fictie"},{"@language":"sv","@value":"Fanfiction om verkliga personer"}],"skos:altLabel":[{"@language":"en","@value":"RPF"},{"@language":"en","@value":"RPS"},{"@language":"en","@value":"Real people fiction"},{"@language":"en","@value":"Real person slash"},{"@language":"en","@value":"Real person stories"},{"@language":"es","@value":"Real person fiction"},{"@language":"es","@value":"RPF"},{"@language":"nl","@value":"Real person slash"},{"@language":"nl","@value":"Real person stories"},{"@language":"nl","@value":"RPF"},{"@language":"nl","@value":"RPS"}],"rdfs:comment":[{"@language":"en","@value":"Fanfiction about real people, such as actors or musicians; often but not always used to describe fanfiction focusing on (real or imagined) same-sex or same-gender relationships between celebrities."},{"@language":"es","@value":"Fanfiction sobre personas reales, como actores o músicos; a menudo, pero no siempre, se utiliza para describir fanfiction que se centra en relaciones (reales o imaginarias) entre celebridades del mismo sexo o del mismo género."},{"@language":"nl","@value":"Fanfictie over echte mensen, zoals acteurs of muzikanten; vaak maar niet altijd gebruikt om fanfictie te beschrijven die zich richt op (echte of ingebeelde) relaties tussen beroemdheden van hetzelfde geslacht gender"},{"@language":"sv","@value":"Fanfiction som handlar om verkliga personer, till exempel kändisar, ofta med fokus på verkliga eller påhittade samkönade relationer."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002205"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0002142"},{"@id":"https://homosaurus.org/v5/homoit0002147"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002143","dc:identifier":"homoit0002143","skos:prefLabel":[{"@language":"en","@value":"Alternate universe settings (Fanfiction)"},{"@language":"es","@value":"Escenarios de un universo alternativo (fanfiction)"},{"@language":"de","@value":"Alternativuniversum (Fanfiction)"},{"@language":"nl","@value":"Alternatieve settings voor het universum (Fanfictie)"},{"@language":"sv","@value":"Alternativa universum (fanfiction)"}],"skos:altLabel":[{"@language":"en","@value":"AU (Fanfiction)"},{"@language":"es","@value":"AU (Fanfiction)"},{"@language":"es","@value":"UA (Fanficción)"},{"@language":"es","@value":"Fanfic"},{"@language":"de","@value":"Setting eines alternativen Universums (Fanfiction)"},{"@language":"de","@value":"AU"}],"rdfs:comment":[{"@language":"en","@value":"Settings alternative to the canonical universe of a text in which fanfiction might take place."},{"@language":"es","@value":"Escenarios alternativos al universo canónico de un texto en el que podría desarrollarse un fanfiction."},{"@language":"de","@value":"Alternernative Schauplätze zum kanonischen Universum eines Textes, in dem Fanfiction spielen könnte."},{"@language":"nl","@value":"Alternatieve settings voor het canonieke universum van een tekst waarin fanfictie zou kunnen plaatsvinden"},{"@language":"sv","@value":"Alternativa universum till den ursprungliga världen i ett fiktivt verk där fanfiction kan utspelas."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002160"},"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0002186"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0002210"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002186","dc:identifier":"homoit0002186","skos:prefLabel":[{"@language":"en","@value":"Omegaverse"},{"@language":"es","@value":"Omegaverso"},{"@language":"nl","@value":"Omegaverse"},{"@language":"sv","@value":"Omegaverse"}],"skos:altLabel":[{"@language":"en","@value":"A/B/O"},{"@language":"en","@value":"ABO"},{"@language":"en","@value":"Alpha/Beta/Omega"},{"@language":"es","@value":"Omergaverse"},{"@language":"es","@value":"A/B/O"},{"@language":"es","@value":"ABO"},{"@language":"es","@value":"Alpha/Beta/Omega"},{"@language":"nl","@value":"ABO"},{"@language":"nl","@value":"Alpha/Beta/Omega"}],"rdfs:comment":[{"@language":"en","@value":"The alternate universe fanworks trope in which society is divided into three categories of people: alphas, betas, and omegas. Fanworks in the omegaverse often depict characters with genitalia and breeding behaviors (such as heat cycles) similar to wolves. Use to describe fanworks in the omegaverse that focus on LGBTQ+ people and issues."},{"@language":"es","@value":"El tropo de obras de fans del universo alternativo en el que la sociedad se divide en tres categorías de personas: alfas, betas y omegas. Las obras de fans en el omegaverso a menudo representan personajes con genitales y comportamientos reproductivos (como ciclos de celo) similares a los de los lobos. Utilícese para describir obras de fans en el omegaverso que se centran en personas y cuestiones LGBTQ+."},{"@language":"nl","@value":"De fanwerk-troop van het alternatieve universum waarin de samenleving is verdeeld in drie categorieën mensen: alfa's, bèta's en omega's. Fanwerken in de omegaverse verbeelden vaak karakters met geslachtsdelen en fokgedrag (zoals hittecycli) vergelijkbaar met wolven. Gebruik deze term om fanwerken in de omegaverse te beschrijven die zich richten op LHBTQ+-personen en -onderwerpen"},{"@language":"sv","@value":"En fanfiction-trop där samhället är indelat i tre kategorier: alfa, beta och omega. Fanverk i omegaverse innehåller ofta karaktärer med könsorgan och fortplantningsbeteenden (till exempel löpcykler) som påminner om vargars. Används för att beskriva fanverk inom omegaverse som fokuserar på hbtq+-personer och teman."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002143"},"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0002184"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0002176"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002173","dc:identifier":"homoit0002173","skos:prefLabel":[{"@language":"en","@value":"Hentai fandom"},{"@language":"es","@value":"Fandom de hentai"},{"@language":"ja","@value":"変態ファンダム"},{"@language":"nl","@value":"Hentai fandom"},{"@language":"sv","@value":"Hentai fandom"},{"@language":"ja","@value":"Hentai fandom"}],"rdfs:comment":[{"@language":"en","@value":"The fan community that focuses on, incorporates, or details the relationships of characters in hentai, or sexually explicit anime and manga."},{"@language":"es","@value":"La comunidad de fans que se centra en, incorpora o detalla las relaciones de personajes de hentai o anime y manga sexualmente explícitos."},{"@language":"ja","@value":"エロアニメや性描写の多いアニメ・マンガに登場する「変態」のキャラクターの関係に注目したり、それらを受け入れたり、詳細に掘り下げたりするファンコミュニティ。"},{"@language":"nl","@value":"De fangemeenschap die zich richt op of details geeft over de relaties van personages in hentai, of seksueel expliciete anime en manga"},{"@language":"sv","@value":"Fangemenskap som fokuserar på, innehåller eller utforskar relationerna mellan karaktärer i hentai – det vill säga sexuellt explicita anime- och mangaserier."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002144"},"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0002172"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002221","dc:identifier":"homoit0002221","skos:prefLabel":[{"@language":"en","@value":"Yuri fandom"},{"@language":"es","@value":"Fandom yuri"},{"@language":"nl","@value":"Yuri fandom"},{"@language":"sv","@value":"Yuri fandom"},{"@language":"ja","@value":"Yuri fandom"}],"rdfs:comment":[{"@language":"en","@value":"The fan community that focuses on, incorporates, or details the romantic or sexual relationships between female characters from anime and manga."},{"@language":"es","@value":"La comunidad de fans que se centra sobre, incorpora o detalla las relaciones románticas o sexuales entre personajes femeninos del anime y manga."},{"@language":"nl","@value":"De fangemeenschap die zich richt op of details geeft over de romantische of seksuele relaties tussen vrouwelijke personages uit anime en manga"},{"@language":"sv","@value":"Fangemenskap som fokuserar på, innehåller eller beskriver romantiska eller sexuella relationer mellan kvinnliga karaktärer i anime och manga."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0002144"},{"@id":"https://homosaurus.org/v5/homoit0003507"}],"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0002220"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0002162"},{"@id":"https://homosaurus.org/v5/homoit0002203"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002214","dc:identifier":"homoit0002214","skos:prefLabel":[{"@language":"ja","@value":"Uke (Yaoi)"},{"@language":"es","@value":"Uke (Yaoi)"},{"@language":"nl","@value":"Uke (Yaoi)"},{"@language":"sv","@value":"Uke (Yaoi)"}],"rdfs:comment":[{"@language":"en","@value":"Term used in yaoi and yaoi fan communities to describe the receiving or submissive partner in a fictional male-male relationship."},{"@language":"es","@value":"Término utilizado en las comunidades de fans del yaoi y del yaoi para describir a la pareja receptora o sumisa en una relación ficticia entre hombres."},{"@language":"nl","@value":"Term die wordt gebruikt in yaoi- en yaoi-fangemeenschappen om de \"ontvangende\" of onderdanige partner in een fictieve man-man-relatie te beschrijven"},{"@language":"sv","@value":"Term som används i yaoi och yaoi-fangemenskaper för att beskriva den mottagande eller undergivna parten i en fiktiv relation mellan män."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002217"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0002151"},{"@id":"https://homosaurus.org/v5/homoit0002152"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002218","dc:identifier":"homoit0002218","skos:prefLabel":[{"@language":"en","@value":"Yaoi fandom"},{"@language":"es","@value":"Fandom yaoi"},{"@language":"ja","@value":"やおいファンダム"},{"@language":"nl","@value":"Yaoi fandom"},{"@language":"sv","@value":"Yaoi-fandom"},{"@language":"ja","@value":"Yaoi fandom"}],"rdfs:comment":[{"@language":"en","@value":"The fan community that focuses on, incorporates, or details the sexual or romantic relationships between male characters from anime and manga."},{"@language":"es","@value":"La comunidad de fans que se centra sobre, incorpora o detalla las relaciones sexuales o románticas entre personajes masculinos del anime y manga."},{"@language":"ja","@value":"アニメやマンガの男性キャラクター間の性的関係や恋愛関係に注目して、取り上げ、あるいは詳細に関心を持つファンコミュニティ。"},{"@language":"nl","@value":"De fangemeenschap die zich richt op, incorporeert of details geeft over de seksuele of romantische relaties tussen mannelijke personages uit anime en manga"},{"@language":"sv","@value":"Fangemenskap som fokuserar på, innehåller eller beskriver sexuella eller romantiska relationer mellan manliga karaktärer i anime och manga."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002152"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0002164"},{"@id":"https://homosaurus.org/v5/homoit0002217"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003500","dc:identifier":"homoit0003500","skos:prefLabel":[{"@language":"en","@value":"Danmei"},{"@language":"de","@value":"Danmei"},{"@language":"es","@value":"Danmei"},{"@language":"nl","@value":"Danmei"},{"@language":"sv","@value":"Danmei"}],"skos:altLabel":{"@language":"en","@value":"Dānměi"},"rdfs:comment":[{"@language":"en","@value":"A genre focusing on the romantic or sexual relationships between male characters in Chinese novels, comics, movies, animation, and dramas."},{"@language":"de","@value":"Ein Genre, das sich auf die romantischen oder sexuellen Beziehungen zwischen männlichen Figuren in chinesischen Romanen, Comics, Filmen, Animationen und Serien konzentriert."},{"@language":"es","@value":"Género literario que se centra en las relaciones románticas o sexuales entre personajes masculinos en novelas, cómics, películas, animación y dramas chinos."},{"@language":"nl","@value":"Een genre dat zich richt op de romantische of seksuele relaties tussen mannelijke personages in Chinese romans, strips, films, animaties en drama's."},{"@language":"sv","@value":"En genre som fokuserar på romantiska eller sexuella relationer mellan manliga karaktärer i kinesiska romaner, serier, filmer, animationer och dramer."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002152"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2024-07-31"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002155","dc:identifier":"homoit0002155","skos:prefLabel":[{"@language":"en","@value":"Fanart"},{"@language":"es","@value":"Fanart"},{"@language":"de","@value":"Fanart"},{"@language":"nl","@value":"Fanart"},{"@language":"sv","@value":"Fanart"}],"skos:altLabel":[{"@language":"en","@value":"Fan art"},{"@language":"es","@value":"Fan art"},{"@language":"es","@value":"Arte de fans"},{"@language":"de","@value":"Fan-Art"}],"rdfs:comment":[{"@language":"en","@value":"Art created by fans that relates to media properties or other subjects of fandom."},{"@language":"es","@value":"Arte creado por fanáticos que se relaciona con propiedades de los medios u otros temas del fandom."},{"@language":"de","@value":"Von Fans geschaffene Kunst, die sich auf Medieninhalte oder andere Themen des Fandoms bezieht."},{"@language":"nl","@value":"Kunst gemaakt door fans die betrekking heeft op media-uitingen of andere onderwerpen van fandom"},{"@language":"sv","@value":"Konst skapad av fans och som relaterar till populärkulturella verk eller andra ämnen inom fandom."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002161"},"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0002201"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0002159"},{"@id":"https://homosaurus.org/v5/homoit0002204"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002204","dc:identifier":"homoit0002204","skos:prefLabel":[{"@language":"en","@value":"Slash fanworks"},{"@language":"es","@value":"Fanworks slash"},{"@language":"nl","@value":"Slash fanwerken"},{"@language":"sv","@value":"Slashfan-verk"}],"skos:altLabel":[{"@language":"en","@value":"Slash fan works"},{"@language":"es","@value":"Fan works slash"},{"@language":"sv","@value":"Slash fanwork"}],"rdfs:comment":[{"@language":"en","@value":"Works created by fans that focus on romantic or sexual relationships between characters of the same sex or gender. Typically erotic or pornographic in nature. Historically used for male-male couples only, but is now used more broadly; includes femslash fanworks."},{"@language":"es","@value":"Obras creadas por fans que se centran en relaciones románticas o sexuales entre personajes del mismo sexo o género. Normalmente de naturaleza erótica o pornográfica. Históricamente se utilizaba únicamente para parejas de hombres, pero ahora se utiliza de forma más amplia; incluye obras de fans de femslash."},{"@language":"nl","@value":"Werken gemaakt door fans die zich richten op romantische of seksuele relaties tussen personages van hetzelfde geslacht of gender. Typisch erotisch of pornografisch van aard. Van oudsher alleen gebruikt voor man-man koppels, maar wordt nu breder gebruikt; inclusief femslash fanwerken"},{"@language":"sv","@value":"Fanverk som fokuserar på romantiska eller sexuella relationer mellan karaktärer av samma kön eller könsidentitet. Dessa är ofta erotiska eller pornografiska. Termen användes ursprungligen för man/man-par men har senare breddats till att inkludera andra hbtq+-relationer som till exempel femslash."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0002161"},{"@id":"https://homosaurus.org/v5/homoit0002203"}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0002201"},{"@id":"https://homosaurus.org/v5/homoit0002205"},{"@id":"https://homosaurus.org/v5/homoit0002206"},{"@id":"https://homosaurus.org/v5/homoit0002207"},{"@id":"https://homosaurus.org/v5/homoit0002209"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0002155"},{"@id":"https://homosaurus.org/v5/homoit0002217"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002167","dc:identifier":"homoit0002167","skos:prefLabel":[{"@language":"en","@value":"Furry fandom"},{"@language":"es","@value":"Fandom de furros"},{"@language":"de","@value":"Furry-Fandom"},{"@language":"nl","@value":"Furry fandom"},{"@language":"sv","@value":"Furryfandom"}],"skos:altLabel":[{"@language":"en","@value":"Furry community"},{"@language":"en","@value":"Furry fan community"},{"@language":"es","@value":"Comunidad furra"},{"@language":"es","@value":"Comunidades fan de furros"},{"@language":"de","@value":"Furry-Community"},{"@language":"de","@value":"Furry-Fangemeinde"},{"@language":"nl","@value":"Furry gemeenschap"},{"@language":"nl","@value":"Harige fandom"}],"rdfs:comment":[{"@language":"en","@value":"The fan community that focuses on, incorporates, or details anthropomorphized animals."},{"@language":"es","@value":"La comunidad de fans que se centra, incorpora o detalla animales antropomorfizados."},{"@language":"de","@value":"Die Fangemeinde, die sich auf anthropomorphisierte Tiercharaktere konzentriert, diese einbezieht oder detailliert darstellt."},{"@language":"nl","@value":"De fangemeenschap die zich richt op, incorporeert of details geeft over antropomorfe dieren"},{"@language":"sv","@value":"Gemenskap av fans som fokuserar på, inkluderar eller skildrar antropomorfa djur."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002156"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0002165"},{"@id":"https://homosaurus.org/v5/homoit0002166"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2017003411"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002199","dc:identifier":"homoit0002199","skos:prefLabel":[{"@language":"en","@value":"Shipping in fandom"},{"@language":"es","@value":"Shippeo en el fandom"},{"@language":"nl","@value":"Relaties in fandom"},{"@language":"sv","@value":"Shippning inom fandom"}],"skos:altLabel":[{"@language":"es","@value":"Shipping en el fandom"},{"@language":"sv","@value":"Shipping inom fandom"}],"rdfs:comment":[{"@language":"en","@value":"Term used to describe fans' desire to see certain characters in sexual or romantic relationships, as well as the practice of pairing those characters in fanworks. The terms \"shipping\" and \"ship\" come from \"relationship.\""},{"@language":"es","@value":"Término utilizado para describir el deseo de los fans de ver a ciertos personajes en relaciones sexuales o románticas, así como la práctica de emparejar a esos personajes en obras de fans. Los términos \"shipping\" y \"ship\" provienen de \"relationship\" en inglés."},{"@language":"nl","@value":"Term die wordt gebruikt om de wens van fans te beschrijven om bepaalde personages in seksuele of romantische relaties te zien, evenals de praktijk om die personages in fan-uitingen te koppelen. De termen \"shipping\" en \"ship\" komen van \"relationship\""},{"@language":"sv","@value":"Term som beskriver fans önskan att se vissa karaktärer i sexuella eller romantiska relationer samt praktiken att para ihop dem i fanverk. Termerna shipping och ship kommer från relationship."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002156"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0002189"},{"@id":"https://homosaurus.org/v5/homoit0002198"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0002180"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002203","dc:identifier":"homoit0002203","skos:prefLabel":[{"@language":"en","@value":"Slash fandom"},{"@language":"es","@value":"Fandom slash"},{"@language":"nl","@value":"Slash fandom"},{"@language":"sv","@value":"Slash fandom"}],"skos:altLabel":[{"@language":"en","@value":"Slash fan community"},{"@language":"es","@value":"Comunidad fan slash"},{"@language":"es","@value":"Comunidad de fans slash"}],"rdfs:comment":[{"@language":"en","@value":"The fan community that focuses on, incorporates, or details relationships between two characters of the same sex or gender (usually fictional, with \"Real person fiction\" as an exception). Historically used for male-male couples only, but is now used more broadly; includes femslash fandom."},{"@language":"es","@value":"La comunidad de fans que se centra sobre, incorpora o detalla las relaciones entre dos personajes del mismo sexo o género (normalmente ficticios, con la excepción de \"ficción de personas reales\"). Históricamente se utilizaba únicamente para parejas de hombres, pero ahora se utiliza de forma más amplia; incluye fandom de femslash."},{"@language":"nl","@value":"De fan-gemeenschap die zich richt op of details geeft over relaties tussen twee personages van hetzelfde geslacht of gender (meestal fictief, met 'fictie over echte personen' als uitzondering). Van oudsher alleen gebruikt voor man-man koppels, maar wordt nu breder gebruikt; inclusief femslash fandom"},{"@language":"sv","@value":"Fangemenskap som fokuserar på eller beskriver relationer mellan två karaktärer av samma kön eller könsidentitet, vanligtvis fiktiva men ibland verkliga (till exempel i så kallad real person fiction). Termen användes ursprungligen för man/man-par men används nu bredare och inkluderar femslash-fandom."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002156"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0002200"},{"@id":"https://homosaurus.org/v5/homoit0002202"},{"@id":"https://homosaurus.org/v5/homoit0002204"},{"@id":"https://homosaurus.org/v5/homoit0002205"},{"@id":"https://homosaurus.org/v5/homoit0002208"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0002221"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002176","dc:identifier":"homoit0002176","skos:prefLabel":[{"@language":"en","@value":"Kink in fandom"},{"@language":"es","@value":"Kink en el fandom"},{"@language":"nl","@value":"Kink in fandom"},{"@language":"sv","@value":"Kink inom fandom"}],"skos:altLabel":[{"@language":"en","@value":"Kink in fan communities"},{"@language":"es","@value":"Kink en comunidades de fans"}],"rdfs:comment":[{"@language":"en","@value":"Representations of non-conventional or marginalized sexual practices in fanfiction."},{"@language":"es","@value":"Representación de prácticas sexuales no convencionales o marginadas en el fanfiction."},{"@language":"nl","@value":"Representatie van niet-conventionele of gemarginaliseerde seksuele praktijken in fanfictie"},{"@language":"sv","@value":"Skildringar av icke-konventionella eller marginaliserade sexuella praktiker i fanfiction."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002160"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0002181"},{"@id":"https://homosaurus.org/v5/homoit0002186"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002187","dc:identifier":"homoit0002187","skos:prefLabel":[{"@language":"en","@value":"One true pairing"},{"@language":"es","@value":"One true pairing"},{"@language":"nl","@value":"Favoriete koppels"},{"@language":"sv","@value":"One true pairing"}],"skos:altLabel":[{"@language":"en","@value":"OTP"},{"@language":"es","@value":"OTP"},{"@language":"nl","@value":"OTP"},{"@language":"sv","@value":"OTP"}],"rdfs:comment":[{"@language":"en","@value":"Slang term referring to a fan's primary \"ship\" or preferred relationship within a fandom."},{"@language":"es","@value":"Término de la jerga que se refiere al \"ship\" principal de un fan o a la relación preferida dentro de un fandom. Siglas en inglés para \"una pareja única\" o \"una pareja veradera.\""},{"@language":"nl","@value":"Argot term die verwijst naar het primaire koppel (\"ship\") of voorkeursrelatie van een fan binnen een fandom"},{"@language":"sv","@value":"Slangterm som syftar på en fans främsta favoritrelation inom en fandom, ofta kallad ”ship”."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002189"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0002160"},{"@id":"https://homosaurus.org/v5/homoit0002177"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002200","dc:identifier":"homoit0002200","skos:prefLabel":[{"@language":"en","@value":"Slash (Genre)"},{"@language":"es","@value":"Slash (género)"},{"@language":"nl","@value":"Slash (Genre)"},{"@language":"sv","@value":"Slash (genre)"}],"skos:altLabel":{"@language":"es","@value":"Slash"},"rdfs:comment":[{"@language":"en","@value":"A genre of fanworks in which two or more characters of the same sex or gender are placed in sexual or romantic situations with one another. Slash fanworks are commonly erotic or pornographic. While the term \"slash\" has historically been used for male/male couples only, it has been recently been broadened to include LGBTQ+ relationships other than those between two men."},{"@language":"es","@value":"Un género de obras de fans en el que dos o más personajes del mismo sexo o género son colocados en situaciones sexuales o románticas entre sí. Las obras de fans Slash son comúnmente eróticas o pornográficas. Si bien el término \"slash\" se ha utilizado históricamente solo para relaciones entre hombres, recientemente se ha ampliado para incluir relaciones LGBTQ+ distintas de aquellas entre dos hombres."},{"@language":"nl","@value":"Een genre van fanwerken waarin twee of meer personages van hetzelfde geslacht of gender in seksuele of romantische situaties met elkaar worden geplaatst. Slash-fanwerken zijn vaak erotisch of pornografisch. Hoewel de term 'slash' in het verleden alleen voor man/man koppels werd gebruikt, is het onlangs uitgebreid met andere LHBTQ+-relaties dan die uitsluitend tussen twee mannen"},{"@language":"sv","@value":"En genre av fanverk där två eller flera karaktärer av samma kön eller könsidentitet placeras i sexuella eller romantiska sammanhang med varandra. Slash-fanverk är ofta erotiska eller pornografiska. Termen slash användes historiskt för man/man-par men har senare utvidgats till att även omfatta andra hbtq+-relationer."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002203"},"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0002162"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002164","dc:identifier":"homoit0002164","skos:prefLabel":[{"@language":"ja","@value":"Fujoshi"},{"@language":"es","@value":"Fujoshi"},{"@language":"ja","@value":"腐女子"},{"@language":"de","@value":"Fujoshi"},{"@language":"nl","@value":"Fujoshi"},{"@language":"sv","@value":"Fujoshi"}],"rdfs:comment":[{"@language":"en","@value":"Japanese word that literally translates to \"rotten girl\" and is used to describe young women who enjoy media or fanworks focused on romantic or sexual relationships between men. Some fans self-identify as fujoshis, typically as a form of playful self-deprecation, but it can also be considered derogatory."},{"@language":"es","@value":"Palabra japonesa que se traduce literalmente como \"niña podrida\" y se utiliza para describir a mujeres jóvenes que disfrutan de los medios o de las obras de fans centradas en las relaciones románticas o sexuales entre hombres. Algunos fanáticos se autoidentifican como fujoshis, generalmente como una forma de autodesprecio juguetón, pero también puede considerarse despectivo."},{"@language":"ja","@value":"文字通り「腐った女子」を意味する日本語で、男性同士の恋愛や性的関係を描いたメディアやファン作品を楽しむ若い女性を指す言葉。一部のファンは、主に冗談めかした自虐的な意味合いで自らを「腐女子」と称することがあるが、蔑称と見なされることもある。"},{"@language":"de","@value":"Japanisches Wort, das wörtlich übersetzt „verkommenes Mädchen“ bedeutet und verwendet wird, um junge Frauen zu beschreiben, die Medien oder Fanfiction mögen, die sich auf romantische oder sexuelle Beziehungen zwischen Männern konzentrieren. Einige Fans bezeichnen sich selbst als Fujoshis, in der Regel als eine Form der spielerischen Selbstironie, aber es kann auch als abwertend angesehen werden."},{"@language":"nl","@value":"Japans woord dat letterlijk \"rotte meid\" betekent en wordt gebruikt om jonge vrouwen te beschrijven die genieten van media of fanwerken gericht op romantische of seksuele relaties tussen mannen. Sommige fans beschouwen zichzelf als fujoshi's, meestal als een vorm van speelse zelfspot, maar het kan ook als denigrerend worden beschouwd"},{"@language":"sv","@value":"Japanskt ord som bokstavligen betyder ”rutten tjej” och används för att beskriva unga kvinnor som gillar media eller fanverk med romantiska eller sexuella relationer mellan män. Vissa fans identifierar sig själva som fujoshis, ofta som en form av lekfull självironi, men termen kan också uppfattas som nedsättande."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002218"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002175","dc:identifier":"homoit0002175","skos:prefLabel":[{"@language":"en","@value":"Intersex people in fandom"},{"@language":"es","@value":"Personas intersex en fandom"},{"@language":"de","@value":"Inter* Personen im Fandom"},{"@language":"nl","@value":"Intersekse personen in fandom"},{"@language":"sv","@value":"Intersexpersoner inom fandom"}],"skos:altLabel":{"@language":"de","@value":"inter* Menschen im Fandom"},"rdfs:comment":[{"@language":"en","@value":"The participation and inclusion of intersex people in fan communities."},{"@language":"es","@value":"La participación e inclusión de personas intersex en las comunidades de fans."},{"@language":"de","@value":"Die Teilnahme und Einbeziehung inter* Personen in Fan-Communitys."},{"@language":"nl","@value":"De participatie en inclusie van intersekse personen in fan-gemeenschappen"},{"@language":"sv","@value":"Intersexpersoners deltagande och inkludering i fangemenskaper."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0002171"},{"@id":"https://homosaurus.org/v5/homoit0002181"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002198","dc:identifier":"homoit0002198","skos:prefLabel":[{"@language":"en","@value":"Ship names in fandom"},{"@language":"es","@value":"Nombres de ship en el fandom"},{"@language":"nl","@value":"Relatienamen in fandom"},{"@language":"sv","@value":"Ship-namn inom fandom"}],"skos:altLabel":[{"@language":"en","@value":"Pairing names in fandom"},{"@language":"es","@value":"Ship names en el fandom"},{"@language":"sv","@value":"Shipnames inom fandom"}],"rdfs:comment":[{"@language":"en","@value":"Names used to describe common pairings in fandom. Ship names are often portmanteaus of the names of two (or more) characters in the ship (e.g., Spirk for Spock and Kirk)."},{"@language":"es","@value":"Nombres utilizados para describir emparejamientos comunes en el fandom. Los nombres de los \"ships\" suelen ser combinaciones de los nombres de dos (o más) personajes del \"ship\" (por ejemplo, \"Spirk\" para Spock y Kirk)."},{"@language":"nl","@value":"Namen die worden gebruikt om gemeenschappelijke koppels in fandom te beschrijven. Relatienamen zijn vaak samentrekkingen van de namen van twee (of meer) personages in de relatie (bijvoorbeeld Spirk voor Spock en Kirk)"},{"@language":"sv","@value":"Namn som används för att beskriva vanliga parbildningar i fandom. Ship-namn är ofta teleskopord av två (eller flera) karaktärers namn i parbildningen, till exempel Spirk för Spock och Kirk."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002199"},"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0002177"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002206","dc:identifier":"homoit0002206","skos:prefLabel":[{"@language":"en","@value":"Slash manips"},{"@language":"es","@value":"Manips slash"},{"@language":"nl","@value":"Slash manips"},{"@language":"sv","@value":"Slash manips"}],"skos:altLabel":[{"@language":"es","@value":"Manipulaciones fotográficas slash"},{"@language":"es","@value":"Slash manips"},{"@language":"es","@value":"Manipulaciones slash"}],"rdfs:comment":[{"@language":"en","@value":"Fan-created photo manipulations or deepfakes depicting sexual or romantic relationships between characters from various media properties. Typically erotic or pornographic in nature. Historically used for male-male couples only, but is now used more broadly; includes femslash manips."},{"@language":"es","@value":"Manipulaciones fotográficas creadas por fans o deepfakes que representan relaciones sexuales o románticas entre personajes de diversos medios de comunicación. Suele ser de naturaleza erótica o pornográfica. Históricamente se utilizaba solo para parejas hombre-hombre, pero ahora se utiliza de forma más amplia; incluye manips femslash."},{"@language":"nl","@value":"Door fans gemaakte fotomanipulaties of deepfakes die seksuele of romantische relaties tussen personages uit verschillende media-uitingen weergeven. Typisch erotisch of pornografisch van aard. Van oudsher alleen gebruikt voor man-man koppels, maar wordt nu breder gebruikt; inclusief femslash manips"},{"@language":"sv","@value":"Fanproducerade fotomanipulationer eller deepfakes som visar sexuella eller romantiska relationer mellan karaktärer från olika medier. Dessa är vanligtvis erotiska eller pornografiska. Termen användes historiskt för man/man-par men inkluderar numera även femslash-manips."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002204"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002209","dc:identifier":"homoit0002209","skos:prefLabel":[{"@language":"en","@value":"Slash vidding"},{"@language":"es","@value":"Vidding slash"},{"@language":"nl","@value":"Slash vidding"},{"@language":"sv","@value":"Slash-vidding"}],"skos:altLabel":{"@language":"es","@value":"Slash vidding"},"rdfs:comment":[{"@language":"en","@value":"Creating videos about sexual or romantic relationships between same-sex or -gender couples using scenes from television, movies, or video games. Historically used for male-male couples only, but is now used more broadly; includes femslash vidding."},{"@language":"es","@value":"Creación de vídeos sobre relaciones sexuales o románticas entre parejas del mismo sexo o género utilizando escenas de televisión, películas o videojuegos. Históricamente se utilizaba sólo para parejas hombre-hombre, pero ahora se utiliza más ampliamente; incluye el femslash vidding."},{"@language":"nl","@value":"Video's maken over seksuele of romantische relaties tussen koppels van hetzelfde geslacht of hetzelfde gender met behulp van scènes uit televisie, films of videogames. Van oudsher alleen gebruikt voor man-man koppels, maar wordt nu breder gebruikt; inclusief femslash vidding"},{"@language":"sv","@value":"Att skapa videor om sexuella eller romantiska relationer mellan samkönade eller samkönsidentifierade par med hjälp av scener från tv, film eller datorspel. Termen användes historiskt för man/man-par men inkluderar numera även femslash-vidding."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002204"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0003662"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002225","dc:identifier":"homoit0002225","skos:prefLabel":[{"@language":"en","@value":"Parents of non-binary people"},{"@language":"es","@value":"Madres y padres de personas no binarias"},{"@language":"nl","@value":"Ouders van non-binaire personen"},{"@language":"sv","@value":"Föräldrar till ickebinära"}],"skos:altLabel":[{"@language":"en","@value":"Non-binary people's parents"},{"@language":"en","@value":"Nonbinary people's parents"},{"@language":"en","@value":"Parents of nonbinary people"},{"@language":"es","@value":"Madres de personas no binarias"},{"@language":"es","@value":"Padres de personas no binarias"}],"rdfs:comment":[{"@language":"en","@value":"Individuals who have one or more non-binary child."},{"@language":"es","@value":"Personas actual como padres de una o más personas no binarias. Para padres que son non binarios, utilice el término \"madres y padres no binarios\""},{"@language":"nl","@value":"Personen die een of meer non-binaire kinderen hebben"},{"@language":"sv","@value":"Personer som har ett eller flera ickebinära barn."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002224"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000421"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-19"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002742","dc:identifier":"homoit0002742","skos:prefLabel":[{"@language":"en","@value":"Parents of intersex people"},{"@language":"es","@value":"Madres y padres de personas intersexuales"},{"@language":"nl","@value":"Ouders van intersekse personen"},{"@language":"sv","@value":"Föräldrar till intersexpersoner"}],"skos:altLabel":[{"@language":"en","@value":"Intersex people's parents"},{"@language":"es","@value":"Padres de intersexuales"},{"@language":"es","@value":"Padres de personas intersex"}],"rdfs:comment":[{"@language":"en","@value":"People who act as parents to one or more intersex person. For parents who are themselves intersex, use the term \"intersex parents.\""},{"@language":"es","@value":"Personas que actúan como padres de una o más personas intersexuales. Para padres que son intersexuales, utilice el término \"madres y padres intersexuales\"."},{"@language":"nl","@value":"Personen die als ouders optreden voor een of meer intersekse personen. Voor ouders die zelf intersekse zijn, dient de term 'intersekse-ouders' gebruikt te worden."},{"@language":"sv","@value":"Personer som fungerar som föräldrar till en eller flera intersexpersoner. För föräldrar som själva är intersex, använd termen ”Intersexföräldrar”."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002224"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000421"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-27"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002910","dc:identifier":"homoit0002910","skos:prefLabel":[{"@language":"en","@value":"Parents of asexual people"},{"@language":"es","@value":"Madres y padres de personas asexuales"},{"@language":"nl","@value":"Ouders van aseksuele personen"},{"@language":"sv","@value":"Föräldrar till asexuella"}],"skos:altLabel":[{"@language":"en","@value":"Asexual people's parents"},{"@language":"es","@value":"Padres de personas asexuales"},{"@language":"es","@value":"Madres de personas asexuales"}],"rdfs:comment":[{"@language":"en","@value":"People who act as parents to one or more asexual person. For parents who are themselves asexual, use the term \"Asexual parents.\""},{"@language":"es","@value":"Personas que actúan como padres de una o más personas asexuales. Para padres que son asexuales, utilice el término \"madres y padres asexuales\"."},{"@language":"nl","@value":"Personen die optreden als ouders van één of meer aseksuele personen. Voor ouders die zelf aseksueel zijn, dient de term 'Aseksuele ouders' gebruikt te worden."},{"@language":"sv","@value":"Personer som fungerar som föräldrar till en eller flera asexuella personer. För föräldrar som själva är asexuella, använd termen ”Asexuella föräldrar”."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002224"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000421"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-29"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004230","dc:identifier":"homoit0004230","skos:prefLabel":[{"@language":"en","@value":"Two-Spirit people with substance use disorders"},{"@language":"nl","@value":"Two-Spirit people met een stoornis in middelengebruik"},{"@language":"sv","@value":"Two-spirit-personer med substansbrukssyndrom"}],"skos:altLabel":[{"@language":"en","@value":"Two-Spirit people with substance issues"},{"@language":"en","@value":"Two Spirit people with substance use disorders"},{"@language":"en","@value":"Two-Spirited people with substance use disorders"},{"@language":"en","@value":"Two Spirited people with substance use disorders"},{"@language":"en","@value":"2S people with alcohol substance disorders"}],"rdfs:comment":[{"@language":"en","@value":"Two-Spirit people who have been diagnosed with or regard themselves as having a substance use disorder, a medical condition that involves a pattern of substance use that is difficult to control, negatively impacts the individual's life, and results in withdrawal symptoms upon cessation. Only use to refer to individuals who describe themselves as having a substance use disorder. Follow the individual's preference for \"use disorder\" or \"addiction\" whenever possible."},{"@language":"nl","@value":"LHBTQ+-personen bij wie een stoornis in het middelengebruik is vastgesteld of dit bij zichzelf hebben vastgesteld, een medische aandoening die gepaard gaat met een patroon van middelengebruik dat moeilijk onder controle te houden is, een negatieve invloed heeft op het leven van het individu en resulteert in ontwenningsverschijnselen bij het stoppen. Alleen gebruiken om te verwijzen naar personen die zichzelf beschrijven als iemand met een stoornis in het middelengebruik. Volg waar mogelijk de voorkeur van het individu voor \"stoornis in het gebruik\" of \"verslaving\"."},{"@language":"sv","@value":"Two-spirit-personer som har diagnostiserats med eller själva uppfattar sig ha ett substansbrukssyndrom, ett medicinskt tillstånd som innebär ett substansbruk som är svårt att kontrollera, påverkar individens liv negativt och kan leda till abstinenssymtom vid avbrott. Används endast för personer som själva beskriver sig som att de har ett substansbrukssyndrom. Följ individens eget språkbruk när det gäller om de föredrar termen substansbrukssyndrom eller beroende."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0004225"},{"@id":"https://homosaurus.org/v5/homoit0004228"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0002226"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2025-04-24"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004226","dc:identifier":"homoit0004226","skos:prefLabel":[{"@language":"en","@value":"Two-Spirit people who use substances for medical purposes"},{"@language":"nl","@value":"Two-Spirit people die middelen gebruiken voor medische doeleinden"},{"@language":"sv","@value":"Two-spirit-personer som använder substanser i medicinskt syfte"}],"skos:altLabel":[{"@language":"en","@value":"Two Spirit people who use substances for medical purposes"},{"@language":"en","@value":"Two-Spirited people who use substances for medical purposes"},{"@language":"en","@value":"Two Spirited people who use substances for medical purposes"},{"@language":"en","@value":"2S people who use substances for medical purposes"}],"rdfs:comment":[{"@language":"en","@value":"Two-Spirit people who use substances (that are typically deemed harmful or are subject to legal restriction, such as drugs and alcohol) in order to manage pain and other symptoms related to a medical condition or disability."},{"@language":"nl","@value":"Two-Spirit people die middelen gebruiken (die doorgaans als schadelijk worden beschouwd of waarvoor wettelijke beperkingen gelden, zoals drugs en alcohol) om pijn en andere symptomen te beheersen die verband houden met een medische aandoening of handicap."},{"@language":"sv","@value":"Two-spirit-personer som använder substanser (såsom alkohol eller droger) för att hantera smärta och andra symtom kopplade till en sjukdom eller funktionsnedsättning."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0004225"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0002229"},{"@id":"https://homosaurus.org/v5/homoit0002682"},{"@id":"https://homosaurus.org/v5/homoit0002694"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2025-04-24"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002232","dc:identifier":"homoit0002232","skos:prefLabel":[{"@language":"en","@value":"Gujarati lesbians"},{"@language":"es","@value":"Lesbianas guyaratí"},{"@language":"nl","@value":"Gujarati lesbische vrouwen"},{"@language":"sv","@value":"Lesbiska gujarater"}],"skos:altLabel":{"@language":"en","@value":"Lesbian Gujaratis"},"rdfs:comment":[{"@language":"en","@value":"Lesbians who reside in or are descended from those indigenous to the Indian state of Gujarat."},{"@language":"es","@value":"Lesbianas que residen en o son descendientes de las personas indígenas del estado indio de Gujarat. "},{"@language":"nl","@value":"Lesbische vrouwen die wonen in of afstammen van de inheemse bevolking van de Indiase deelstaat Gujarat"},{"@language":"sv","@value":"Lesbiska som bor i eller härstammar från ursprungsbefolkningen i den indiska delstaten Gujarat."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002231"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-20"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002233","dc:identifier":"homoit0002233","skos:prefLabel":[{"@language":"en","@value":"Gujarati gay men"},{"@language":"es","@value":"Hombres gay guyaratí"},{"@language":"nl","@value":"Gujarati homomannen"},{"@language":"sv","@value":"Gujaratiska bögar"}],"skos:altLabel":[{"@language":"en","@value":"Gay Gujarati men"},{"@language":"en","@value":"Gay Gujaratis"}],"rdfs:comment":[{"@language":"en","@value":"Gay men who reside in or are descended from those indigenous to the Indian state of Gujarat."},{"@language":"es","@value":"Hombres gay que residen en o son descendientes de las personas indígenas del estado indio de Gujarat. "},{"@language":"nl","@value":"Homomannen die wonen in of afstammen van de inheemse bevolking van de Indiase deelstaat Gujarat"},{"@language":"sv","@value":"Bögar som bor i eller härstammar från ursprungsbefolkningen i den indiska delstaten Gujarat."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002231"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-20"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002234","dc:identifier":"homoit0002234","skos:prefLabel":[{"@language":"en","@value":"Gujarati bisexual people"},{"@language":"es","@value":"Personas bisexuales guyaratí"},{"@language":"nl","@value":"Gujarati biseksuele personen"},{"@language":"sv","@value":"Bisexuella gujarater"}],"skos:altLabel":[{"@language":"en","@value":"Bisexual Gujarati people"},{"@language":"en","@value":"Bisexual Gujaratis"},{"@language":"es","@value":"Personas guyaratí bisexuales"},{"@language":"nl","@value":"Gujarati biseksuelen"}],"rdfs:comment":[{"@language":"en","@value":"Bisexual people who reside in or are descended from those indigenous to the Indian state of Gujarat."},{"@language":"es","@value":"Personas bisexuales que residen en o son descendientes de las personas indígenas del estado indio de Gujarat."},{"@language":"nl","@value":"Biseksuele personen die wonen in of afstammen van de inheemse bevolking van de Indiase deelstaat Gujarat"},{"@language":"sv","@value":"Bisexuella personer som bor i eller härstammar från ursprungsbefolkningen i den indiska delstaten Gujarat."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002231"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-20"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002235","dc:identifier":"homoit0002235","skos:prefLabel":[{"@language":"en","@value":"Gujarati transgender people"},{"@language":"es","@value":"Personas transgénero guyaratí"},{"@language":"nl","@value":"Gujarati transgender personen"},{"@language":"sv","@value":"Gujaratiska transpersoner"}],"skos:altLabel":[{"@language":"en","@value":"Trangender Gujaratis"},{"@language":"en","@value":"Transgender Gujarati people"},{"@language":"es","@value":"Personas guyaratí transgénero"}],"rdfs:comment":[{"@language":"en","@value":"Transgender people who reside in or are descended from those indigenous to the Indian state of Gujarat."},{"@language":"es","@value":"Personas transgénero que residen en o son descendientes de las personas indígenas del estado indio de Gujarat."},{"@language":"nl","@value":"Transgender personen die wonen in of afstammen van de inheemse bevolking van de Indiase deelstaat Gujarat"},{"@language":"sv","@value":"Transpersoner som bor i eller härstammar från ursprungsbefolkningen i den indiska delstaten Gujarat."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002231"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-20"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002236","dc:identifier":"homoit0002236","skos:prefLabel":[{"@language":"en","@value":"Gujarati asexual people"},{"@language":"es","@value":"Personas asexuales guyaratí"},{"@language":"nl","@value":"Gujarati aseksuele personen"},{"@language":"sv","@value":"Asexuella gujarater"}],"skos:altLabel":[{"@language":"en","@value":"Asexual Gujarati people"},{"@language":"en","@value":"Asexual Gujaratis"},{"@language":"es","@value":"Personas guyaratí asexuales"}],"rdfs:comment":[{"@language":"en","@value":"Asexual people who reside in or are descended from those indigeno