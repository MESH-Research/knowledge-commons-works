urus.org/v5/homoit0000022"},{"@id":"https://homosaurus.org/v5/homoit0000075"},{"@id":"https://homosaurus.org/v5/homoit0000103"},{"@id":"https://homosaurus.org/v5/homoit0000217"},{"@id":"https://homosaurus.org/v5/homoit0000302"},{"@id":"https://homosaurus.org/v5/homoit0000609"},{"@id":"https://homosaurus.org/v5/homoit0000705"},{"@id":"https://homosaurus.org/v5/homoit0001267"},{"@id":"https://homosaurus.org/v5/homoit0001295"},{"@id":"https://homosaurus.org/v5/homoit0001297"},{"@id":"https://homosaurus.org/v5/homoit0001299"},{"@id":"https://homosaurus.org/v5/homoit0003052"},{"@id":"https://homosaurus.org/v5/homoit0003082"},{"@id":"https://homosaurus.org/v5/homoit0003084"},{"@id":"https://homosaurus.org/v5/homoit0003113"},{"@id":"https://homosaurus.org/v5/homoit0003129"},{"@id":"https://homosaurus.org/v5/homoit0003140"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh95000216"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000404"},"dc:replaces":{"@id":"http://homosaurus.org/v2/fetishism"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003052","dc:identifier":"homoit0003052","skos:prefLabel":[{"@language":"en","@value":"Power exchange"},{"@language":"es","@value":"Intercambio de poder"},{"@language":"nl","@value":"Machtsuitwisseling"},{"@language":"sv","@value":"Maktutbyte"}],"skos:altLabel":[{"@language":"en","@value":"D \u0026 S"},{"@language":"en","@value":"D and S"},{"@language":"en","@value":"D\u0026s"},{"@language":"en","@value":"D/s"},{"@language":"en","@value":"Dom and sub"},{"@language":"en","@value":"Dom-sub"},{"@language":"en","@value":"Dominance and submission"},{"@language":"en","@value":"Domination and submission"},{"@language":"en","@value":"M/s"},{"@language":"en","@value":"Master/slave lifestyle"},{"@language":"en","@value":"Master/slave"},{"@language":"en","@value":"Submission and dominance"},{"@language":"en","@value":"Submission and domination"},{"@language":"es","@value":"Dom-sub"},{"@language":"es","@value":"Dominación y sumisión"},{"@language":"es","@value":"D\u0026S"},{"@language":"es","@value":"Dom y sub"},{"@language":"es","@value":"Amo y esclavo"},{"@language":"es","@value":"Amo/esclavo"},{"@language":"es","@value":"Estilo de vida amo/esclavo"},{"@language":"nl","@value":"Dominantie en onderdanigheid"},{"@language":"nl","@value":"Meester/slaaf"},{"@language":"nl","@value":"Meester/slaaf levensstijl"},{"@language":"nl","@value":"onderdanigheid en dominantie"}],"rdfs:comment":[{"@language":"en","@value":"Consensual exchange of power between two or more people as a feature of their relationship or during erotic activity."},{"@language":"es","@value":"Intercambio consensual de poder entre dos o más personas como característica de su relación o durante una actividad erótica."},{"@language":"nl","@value":"Consensuele machtsuitwisseling tussen twee of meer mensen als kenmerk van hun relatie of tijdens erotische activiteit."},{"@language":"sv","@value":"Ömsesidigt samtyckt maktutbyte mellan två eller fler personer som en del av deras relation eller under erotiska aktiviteter."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001304"},"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0003060"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000022"},{"@id":"https://homosaurus.org/v5/homoit0000219"},{"@id":"https://homosaurus.org/v5/homoit0000363"},{"@id":"https://homosaurus.org/v5/homoit0000442"},{"@id":"https://homosaurus.org/v5/homoit0000705"},{"@id":"https://homosaurus.org/v5/homoit0000999"},{"@id":"https://homosaurus.org/v5/homoit0001242"},{"@id":"https://homosaurus.org/v5/homoit0001318"},{"@id":"https://homosaurus.org/v5/homoit0001376"},{"@id":"https://homosaurus.org/v5/homoit0001637"},{"@id":"https://homosaurus.org/v5/homoit0003068"},{"@id":"https://homosaurus.org/v5/homoit0003070"},{"@id":"https://homosaurus.org/v5/homoit0003084"},{"@id":"https://homosaurus.org/v5/homoit0003139"},{"@id":"https://homosaurus.org/v5/homoit0003851"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001241"},"dc:issued":{"@type":"xsd:date","@value":"2023-12-15"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003062","dc:identifier":"homoit0003062","skos:prefLabel":[{"@language":"en","@value":"Diapers (Erotic)"},{"@language":"de","@value":"Windeln (Erotik)"},{"@language":"es","@value":"Pañales (erótico)"},{"@language":"nl","@value":"Luiers"},{"@language":"sv","@value":"Blöjor (erotiskt)"}],"skos:altLabel":[{"@language":"de","@value":"Windelfetisch"},{"@language":"sv","@value":"Diapers (erotiskt)"}],"rdfs:comment":[{"@language":"en","@value":"Absorbent material wrapped around a person’s butt and between their legs to absorb urine and feces; typically used in ageplay."},{"@language":"de","@value":"Absorbierendes Material, das um den Hintern und zwischen den Beinen einer Person gewickelt wird, um Urin und Kot aufzunehmen; wird häufig beim Ageplay verwendet."},{"@language":"es","@value":"Material absorbente envuelto alrededor del trasero de una persona y entre sus piernas para absorber la orina y las heces; usualmente utilizado en juegos de edad."},{"@language":"nl","@value":"Absorberend materiaal dat rond de kont en tussen de benen wordt gewikkeld om urine en uitwerpselen te absorberen; wordt voornamelijk gebruikt bij leeftijdsspelletjes."},{"@language":"sv","@value":"Absorberande material som lindas runt stjärten och mellan benen för att ta upp urin och avföring. Används ofta inom ageplay."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0003059"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000022"},{"@id":"https://homosaurus.org/v5/homoit0000597"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000404"},"dc:issued":{"@type":"xsd:date","@value":"2023-12-18"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001267","dc:identifier":"homoit0001267","skos:prefLabel":[{"@language":"en","@value":"Sex (Act)"},{"@language":"es","@value":"Sexo (acto)"},{"@language":"nl","@value":"Seks"},{"@language":"sv","@value":"Sex"}],"rdfs:comment":[{"@language":"en","@value":"The act of engaging in a physical and/or mental interaction with another person or object with the specific intent to elicit sexual arousal or climax."},{"@language":"es","@value":"El acto de participar en una interacción física y/o mental con otra persona u objeto con la intención específica de provocar excitación sexual o clímax."},{"@language":"nl","@value":"De handeling van het aangaan van een fysieke en/of mentale interactie met een andere persoon of object, met de specifieke bedoeling om seksuele opwinding of climax te bereiken"},{"@language":"sv","@value":"Handlingen att interagera fysiskt och/eller mentalt med en annan person eller ett objekt med uttryckt syfte att uppnå sexuell upphetsning eller orgasm."}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000043"},{"@id":"https://homosaurus.org/v5/homoit0000049"},{"@id":"https://homosaurus.org/v5/homoit0000075"},{"@id":"https://homosaurus.org/v5/homoit0000081"},{"@id":"https://homosaurus.org/v5/homoit0000212"},{"@id":"https://homosaurus.org/v5/homoit0000239"},{"@id":"https://homosaurus.org/v5/homoit0000280"},{"@id":"https://homosaurus.org/v5/homoit0000293"},{"@id":"https://homosaurus.org/v5/homoit0000309"},{"@id":"https://homosaurus.org/v5/homoit0000319"},{"@id":"https://homosaurus.org/v5/homoit0000402"},{"@id":"https://homosaurus.org/v5/homoit0000456"},{"@id":"https://homosaurus.org/v5/homoit0000459"},{"@id":"https://homosaurus.org/v5/homoit0000588"},{"@id":"https://homosaurus.org/v5/homoit0000593"},{"@id":"https://homosaurus.org/v5/homoit0000597"},{"@id":"https://homosaurus.org/v5/homoit0000662"},{"@id":"https://homosaurus.org/v5/homoit0000691"},{"@id":"https://homosaurus.org/v5/homoit0000988"},{"@id":"https://homosaurus.org/v5/homoit0001000"},{"@id":"https://homosaurus.org/v5/homoit0001028"},{"@id":"https://homosaurus.org/v5/homoit0001033"},{"@id":"https://homosaurus.org/v5/homoit0001039"},{"@id":"https://homosaurus.org/v5/homoit0001046"},{"@id":"https://homosaurus.org/v5/homoit0001109"},{"@id":"https://homosaurus.org/v5/homoit0001110"},{"@id":"https://homosaurus.org/v5/homoit0001242"},{"@id":"https://homosaurus.org/v5/homoit0001246"},{"@id":"https://homosaurus.org/v5/homoit0001251"},{"@id":"https://homosaurus.org/v5/homoit0001257"},{"@id":"https://homosaurus.org/v5/homoit0001281"},{"@id":"https://homosaurus.org/v5/homoit0001282"},{"@id":"https://homosaurus.org/v5/homoit0001342"},{"@id":"https://homosaurus.org/v5/homoit0001487"},{"@id":"https://homosaurus.org/v5/homoit0001667"},{"@id":"https://homosaurus.org/v5/homoit0001669"},{"@id":"https://homosaurus.org/v5/homoit0002289"},{"@id":"https://homosaurus.org/v5/homoit0003073"},{"@id":"https://homosaurus.org/v5/homoit0003124"},{"@id":"https://homosaurus.org/v5/homoit0003132"},{"@id":"https://homosaurus.org/v5/homoit0003133"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000302"},{"@id":"https://homosaurus.org/v5/homoit0000442"},{"@id":"https://homosaurus.org/v5/homoit0000609"},{"@id":"https://homosaurus.org/v5/homoit0000967"},{"@id":"https://homosaurus.org/v5/homoit0000974"},{"@id":"https://homosaurus.org/v5/homoit0001266"},{"@id":"https://homosaurus.org/v5/homoit0001284"},{"@id":"https://homosaurus.org/v5/homoit0001292"},{"@id":"https://homosaurus.org/v5/homoit0001306"},{"@id":"https://homosaurus.org/v5/homoit0001315"},{"@id":"https://homosaurus.org/v5/homoit0001325"},{"@id":"https://homosaurus.org/v5/homoit0002219"}],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85120549"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001267"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sexAct"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000023","dc:identifier":"homoit0000023","skos:prefLabel":[{"@language":"hil","@value":"Agî"},{"@language":"es","@value":"Agî"},{"@language":"de","@value":"Agî"},{"@language":"nl","@value":"Agi"},{"@language":"sv","@value":"Agî"}],"skos:altLabel":[{"@language":"hil","@value":"Agi"},{"@language":"es","@value":"Agi"},{"@language":"de","@value":"Agi"}],"rdfs:comment":[{"@language":"en","@value":"Filipino word that translates to both hermaphrodite and a gay slur."},{"@language":"es","@value":"Palabra filipina que se traduce tanto como hermafrodita o como insulto contra los hombres gay."},{"@language":"de","@value":"Philippinisches Wort, das sowohl Hermaphrodit als auch eine schwule Beleidigung bedeuten kann"},{"@language":"nl","@value":"Filipijns woord dat zowel hermafrodiet als scheldwoord voor homo's betekent"},{"@language":"sv","@value":"Filippinskt ord som både används med betydelsen ’hermafrodit’ och som en nedsättande term för bögar."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000322"},{"@id":"https://homosaurus.org/v5/homoit0001560"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000091"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/agi"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001560","dc:identifier":"homoit0001560","skos:prefLabel":[{"@language":"en","@value":"Slurs"},{"@language":"es","@value":"Términos peyorativos"},{"@language":"nl","@value":"Scheldnamen"},{"@language":"sv","@value":"Skällsord"}],"skos:altLabel":[{"@language":"es","@value":"Insultos"},{"@language":"es","@value":"Slurs"}],"rdfs:comment":[{"@language":"en","@value":"Insulting or discriminating remarks, innuendos, or names intended to demoralize a person, typically by disparaging that person's identity or social group. Generally, for a term to be considered a slur, it must be derogatory towards a particular person or group, it must be used to subordinate them within some structure of power relations, and the derogated person or group must be defined by an intrinsic property such as their race, sexual orientation, gender identity, etc. This category includes terms considered slurs at any point in their usage. Therefore, some of these terms may no longer be considered universally derogatory, may be in common usage, or may be selectively reclaimed by certain groups."},{"@language":"es","@value":"Comentarios, insinuaciones o nombres insultantes o discriminatorios destinados a desmoralizar a una persona, generalmente menospreciando su identidad o grupo social. Generalmente, para que un término se considere peyorativo, debe ser despectivo hacia una persona o grupo en particular, debe usarse para subordinarles dentro de alguna estructura de relaciones de poder, y la persona o grupo derogado debe estar definido por una propiedad intrínseca como su raza, orientación sexual, identidad de género, etc. Esta categoría incluye términos considerados insultos en cualquier momento de su uso. Por lo tanto, es posible que algunos de estos términos ya no se consideren universalmente despectivos, pueden ser de uso común o pueden ser reclamados selectivamente por ciertos grupos."},{"@language":"nl","@value":"Beledigende of discriminerende opmerkingen, toespelingen of namen die bedoeld zijn om een persoon te kwetsen, meestal door de identiteit of sociale groep van die persoon in diskrediet te brengen. Om als scheldnaam te kunnen worden beschouwd, moet een term in het algemeen denigrerend zijn tegenover een bepaalde persoon of groep, moet hij worden gebruikt om hem of haar ondergeschikt te maken binnen een bepaalde structuur van machtsverhoudingen, en moet de persoon of groep die wordt gedenigreerd, worden gedefinieerd door een intrinsieke eigenschap, zoals zoals hun ras, seksuele geaardheid, genderidentiteit, enz. Deze categorie omvat termen die op elk moment in het gebruik ervan als beledigend worden beschouwd. Daarom kunnen sommige van deze termen niet langer als universeel denigrerend worden beschouwd, algemeen worden gebruikt of selectief worden herwonnen door bepaalde groepen."},{"@language":"sv","@value":"Nedsättande eller diskriminerande uttalanden, antydningar eller benämningar som syftar till att förminska en person genom att kränka dennes identitet eller sociala tillhörighet. För att betraktas som en nedsättande term måste uttrycket vara nedlåtande mot en viss grupp eller individ, användas för att underordna dem i ett maktförhållande och riktas mot någon inneboende egenskap såsom ras, sexuell läggning eller könsidentitet. Denna kategori inkluderar termer som vid någon tidpunkt betraktats som nedsättande. Vissa av dem kan ha återtagits av vissa grupper eller vara i allmänt bruk."}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000023"},{"@id":"https://homosaurus.org/v5/homoit0000037"},{"@id":"https://homosaurus.org/v5/homoit0000090"},{"@id":"https://homosaurus.org/v5/homoit0000091"},{"@id":"https://homosaurus.org/v5/homoit0000096"},{"@id":"https://homosaurus.org/v5/homoit0000098"},{"@id":"https://homosaurus.org/v5/homoit0000101"},{"@id":"https://homosaurus.org/v5/homoit0000246"},{"@id":"https://homosaurus.org/v5/homoit0000384"},{"@id":"https://homosaurus.org/v5/homoit0000418"},{"@id":"https://homosaurus.org/v5/homoit0000695"},{"@id":"https://homosaurus.org/v5/homoit0002230"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000336"},{"@id":"https://homosaurus.org/v5/homoit0000356"},{"@id":"https://homosaurus.org/v5/homoit0000611"},{"@id":"https://homosaurus.org/v5/homoit0001108"},{"@id":"https://homosaurus.org/v5/homoit0001317"},{"@id":"https://homosaurus.org/v5/homoit0001559"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/slurs"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-03"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000091","dc:identifier":"homoit0000091","skos:prefLabel":[{"@language":"fil","@value":"Bakla"},{"@language":"es","@value":"Bakla"},{"@language":"de","@value":"Bakla"},{"@language":"nl","@value":"Bakla"},{"@language":"sv","@value":"Bakia"}],"rdfs:comment":[{"@language":"en","@value":"Filipino word for people who are assigned male at birth who adopt feminine mannerisms; often considered a third gender."},{"@language":"es","@value":"Palabra filipina para personas asignadas al sexo masculino al nacer que adoptan gestos femeninos; a menudo consideradas un tercer género."},{"@language":"de","@value":"Philippinischer Begriff für Personen, denen bei der Geburt ein männliches Geschlecht zugeschrieben wurde, die sich jedoch auf feminine Weise verhalten; wird oft als drittes Geschlecht betrachtet."},{"@language":"nl","@value":"Filipijns woord voor mensen die bij de geboorte als man zijn toegewezen en die vrouwelijke maniertjes aannemen; vaak beschouwd als een derde geslacht"},{"@language":"sv","@value":"Filippinsk term för personer som tilldelats manligt kön vid födseln och som antar feminina manér. Betraktas ofta som ett tredje kön."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000322"},{"@id":"https://homosaurus.org/v5/homoit0001560"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000023"},{"@id":"https://homosaurus.org/v5/homoit0000101"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bakla"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001026","dc:identifier":"homoit0001026","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ movement"},{"@language":"es","@value":"Movimiento LGBTQ+"},{"@language":"nl","@value":"LHBTQ+-beweging"},{"@language":"sv","@value":"Hbtq+-rörelsen"}],"skos:altLabel":[{"@language":"en","@value":"Movement (LGBTQ)"},{"@language":"es","@value":"Movimento (LGBTQ)"}],"rdfs:comment":[{"@language":"en","@value":"Refers to various social and political movements aimed at securing equity and equal representation for LGBTQ+ people."},{"@language":"es","@value":"Se refiere a varios movimientos sociales y políticos destinados a garantizar la equidad y la representación equitativa de las personas LGBTQ+."},{"@language":"nl","@value":"Verwijst naar verschillende sociale en politieke bewegingen die gericht zijn op het waarborgen van gelijkheid en gelijke kansen voor LHBTQ+-personen."},{"@language":"sv","@value":"Samlingsterm för sociala och politiska rörelser som verkar för hbtq+-personers rättigheter, jämlikhet och inflytande i samhället."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001322"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000162"},{"@id":"https://homosaurus.org/v5/homoit0000510"},{"@id":"https://homosaurus.org/v5/homoit0000672"},{"@id":"https://homosaurus.org/v5/homoit0000753"},{"@id":"https://homosaurus.org/v5/homoit0001187"},{"@id":"https://homosaurus.org/v5/homoit0001423"},{"@id":"https://homosaurus.org/v5/homoit0002796"},{"@id":"https://homosaurus.org/v5/homoit0004427"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000024"},{"@id":"https://homosaurus.org/v5/homoit0000276"},{"@id":"https://homosaurus.org/v5/homoit0000538"},{"@id":"https://homosaurus.org/v5/homoit0001905"},{"@id":"https://homosaurus.org/v5/homoit0002713"},{"@id":"https://homosaurus.org/v5/homoit0003695"},{"@id":"https://homosaurus.org/v5/homoit0000851"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001322"},"dc:replaces":{"@id":"http://homosaurus.org/v2/movementLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000660","dc:identifier":"homoit0000660","skos:prefLabel":[{"@language":"en-us","@value":"LGBTQ+ information centers"},{"@language":"es","@value":"Centros de información LGBTQ+"},{"@language":"nl","@value":"LHBTQ+-informatiecentra"},{"@language":"sv","@value":"Hbtq+-informationscentrum"},{"@language":"en-gb","@value":"LGBTQ+ information centres"}],"skos:altLabel":{"@language":"sv","@value":"Informationscentrum för hbtq+-personer"},"rdfs:comment":[{"@language":"en","@value":"Institutions providing education, support, and information about LGBTQ+ issues and LGBTQ+ communities to LGBTQ+ people."},{"@language":"es","@value":"Una institución que localiza y compila información para la comunidad LGBTQ+ en una base de datos central a la que el público puede acceder."},{"@language":"nl","@value":"Instellingen die voorlichting, ondersteuning en informatie verstrekken over LHBTQ+-thema's en LHBTQ+-gemeenschappen aan LHBTQ+-personen."},{"@language":"sv","@value":"En institution som samlar och sammanställer information för hbtq+-gemenskapen i en offentlig databas."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000830"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000026"},{"@id":"https://homosaurus.org/v5/homoit0000147"},{"@id":"https://homosaurus.org/v5/homoit0000490"},{"@id":"https://homosaurus.org/v5/homoit0000737"},{"@id":"https://homosaurus.org/v5/homoit0001179"},{"@id":"https://homosaurus.org/v5/homoit0001409"},{"@id":"https://homosaurus.org/v5/homoit0002747"},{"@id":"https://homosaurus.org/v5/homoit0002793"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000661"},{"@id":"https://homosaurus.org/v5/homoit0002696"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000830"},"dc:replaces":{"@id":"http://homosaurus.org/v2/informationCentresLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000830","dc:identifier":"homoit0000830","skos:prefLabel":[{"@language":"en-us","@value":"LGBTQ+ centers"},{"@language":"es","@value":"Centros LGBTQ+"},{"@language":"nl","@value":"LHBTQ+-centra"},{"@language":"sv","@value":"Hbtq+-centers"},{"@language":"en-gb","@value":"LGBTQ+ centres"}],"rdfs:comment":[{"@language":"en","@value":"Spaces dedicated for use by members of LGBTQ+ communities engaging in various activities, including education, health and wellness services, community support and outreach, etc. Use a more specific term if possible."},{"@language":"es","@value":"Espacios dedicados para el uso de miembros de comunidades LGBTQ+ que participan de diversas actividades, incluidas la educación, los servicios de salud y el bienestar, el apoyo y el alcance comunitario, etc. Utilícese un término más específico de ser posible."},{"@language":"nl","@value":"Ruimtes die speciaal zijn bedoeld voor gebruik door leden van LHBTQ+-gemeenschappen die zich bezighouden met verschillende activiteiten, waaronder onderwijs, gezondheids- en welzijnsdienstverlening, gemeenschapsondersteuning en outreach, enz. Gebruik indien mogelijk een specifiekere term."},{"@language":"sv","@value":"Lokaler avsedda för användning av hbtq+-personer i samband med aktiviteter såsom utbildning, hälsa, gemenskapsstöd och opinionsbildning. Använd mer specifik term om möjligt."}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000298"},{"@id":"https://homosaurus.org/v5/homoit0000660"},{"@id":"https://homosaurus.org/v5/homoit0000876"},{"@id":"https://homosaurus.org/v5/homoit0000964"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000830"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQCentres"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000661","dc:identifier":"homoit0000661","skos:prefLabel":[{"@language":"en","@value":"Information provision"},{"@language":"es","@value":"Suministro de información"},{"@language":"nl","@value":"Voorlichting"},{"@language":"sv","@value":"Informationsförmedling"}],"rdfs:comment":[{"@language":"en","@value":"Process by which information is provided to individuals or communities."},{"@language":"es","@value":"Proceso mediante el cual se proporciona información a personas o comunidades."},{"@language":"nl","@value":"Proces waarmee informatie wordt verstrekt aan individuen of gemeenschappen."},{"@language":"sv","@value":"Processen att förmedla information till individer eller grupper."}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000027"},{"@id":"https://homosaurus.org/v5/homoit0000877"},{"@id":"https://homosaurus.org/v5/homoit0001271"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000660"},{"@id":"https://homosaurus.org/v5/homoit0003617"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000661"},"dc:replaces":{"@id":"http://homosaurus.org/v2/informationProvision"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001251","dc:identifier":"homoit0001251","skos:prefLabel":[{"@language":"en","@value":"Safer sex"},{"@language":"es","@value":"Sexo más seguro"},{"@language":"nl","@value":"Veilig vrijen"},{"@language":"sv","@value":"Säkrare sex"}],"skos:altLabel":[{"@language":"nl","@value":"Veilige seks"},{"@language":"sv","@value":"Säkert sex"}],"rdfs:comment":[{"@language":"en","@value":"A set of practices aimed to minimize the risk of STI transmission, including but not limited to using condoms and dental dams, taking PrEP, and participating in regular STI testing."},{"@language":"es","@value":"Un conjunto de prácticas destinadas a minimizar el riesgo de transmisión de ITS, que incluye, entre otras, el uso de condones y protectores dentales, la toma de PrEP y la participación en pruebas periódicas de ITS."},{"@language":"nl","@value":"Een reeks praktijken gericht op het minimaliseren van het risico op overdracht van soa's, inclusief maar niet beperkt tot het gebruik van condooms en beflapjes, het nemen van PrEP en deelname aan reguliere soa-tests."},{"@language":"sv","@value":"En uppsättning praktiker som syftar till att minska risken för överföring av könssjukdomar, inklusive men inte begränsat till användning av kondomer och slicklappar, användning av PrEP och regelbunden testning för sexuellt överförbara infektioner."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001267"},{"@id":"https://homosaurus.org/v5/homoit0001299"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000027"},{"@id":"https://homosaurus.org/v5/homoit0000299"},{"@id":"https://homosaurus.org/v5/homoit0000346"},{"@id":"https://homosaurus.org/v5/homoit0000700"},{"@id":"https://homosaurus.org/v5/homoit0001239"},{"@id":"https://homosaurus.org/v5/homoit0001252"},{"@id":"https://homosaurus.org/v5/homoit0001287"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001267"},"dc:replaces":{"@id":"http://homosaurus.org/v2/saferSex"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001271","dc:identifier":"homoit0001271","skos:prefLabel":[{"@language":"en","@value":"Sex education"},{"@language":"es","@value":"Educación sexual"},{"@language":"nl","@value":"Seksuele voorlichting"},{"@language":"sv","@value":"Sexualundervisning"}],"skos:altLabel":[{"@language":"sv","@value":"Sexualkunskap"},{"@language":"sv","@value":"Sexualupplysning"}],"rdfs:comment":[{"@language":"en","@value":"Instruction about sexual health and sexuality, including topics such as consent, safer sex, transmission of STIs, and reproduction."},{"@language":"es","@value":"Instrucción sobre la salud sexual y la sexualidad, incluyendo temas como consentimiento, sexo más seguro, transmisión de ITS y reproducción."},{"@language":"nl","@value":"Voorlichting over seksuele gezondheid en seksualiteit, met onderwerpen als toestemming, safe seks, overdracht van soa's en voortplanting."},{"@language":"sv","@value":"Undervisning om sexuell hälsa och sexualitet, inklusive ämnen som samtycke, säkrare sex, överföring av könssjukdomar och reproduktion."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000661"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000027"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85120630"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000661"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sexEducation"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001294","dc:identifier":"homoit0001294","skos:prefLabel":[{"@language":"en","@value":"Sexual health"},{"@language":"es","@value":"Salud sexual"},{"@language":"nl","@value":"Seksuele gezondheid"},{"@language":"sv","@value":"Sexuell hälsa"}],"rdfs:comment":[{"@language":"en","@value":"State of physical, emotional, mental, and social well being in relation to sexuality. This includes one’s ability to have responsible, satisfying, and safer sex free of violence or coercion. "},{"@language":"es","@value":"Estado de bienestar físico, emocional, mental y social en relación con la sexualidad. Esto incluye la capacidad de tener relaciones sexuales responsables, satisfactorias y seguras, libres de violencia o coerción."},{"@language":"nl","@value":"Staat van fysiek, emotioneel, mentaal en sociaal welzijn in relatie tot seksualiteit. Dit omvat iemands vermogen om verantwoorde, bevredigende en veilige seks te hebben zonder geweld of dwang."},{"@language":"sv","@value":"Ett tillstånd av fysiskt, känslomässigt, mentalt och socialt välbefinnande i relation till sexualitet. Det inkluderar förmågan att ha ansvarsfullt, tillfredsställande och säkrare sex fritt från våld eller tvång."}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000027"},{"@id":"https://homosaurus.org/v5/homoit0001291"},{"@id":"https://homosaurus.org/v5/homoit0001292"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85063528"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001294"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sexualHealth"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000901","dc:identifier":"homoit0000901","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ memorials"},{"@language":"es","@value":"Memoriales LGBTQ+"},{"@language":"nl","@value":"LHBTQ+-herdenkingen"},{"@language":"sv","@value":"Hbtq+-minnesmärken"}],"skos:altLabel":[{"@language":"en","@value":"LGBTQ memorials"},{"@language":"es","@value":"Memoriales LGBTQ"},{"@language":"sv","@value":"Minnesmärken (hbtq+)"}],"rdfs:comment":[{"@language":"en","@value":"Projects, events, monuments, and sculptures created to memorialize or celebrate LGBTQ+ people, communities, or events."},{"@language":"es","@value":"Proyectos, eventos, monumentos y esculturas creadas para conmemorar o celebrar a personas, comunidades o eventos LGBTQ+."},{"@language":"nl","@value":"Projecten, evenementen, monumenten en sculpturen die zijn gemaakt om LHBTQ+-personen, -gemeenschappen of -evenementen te herdenken of te vieren."},{"@language":"sv","@value":"Projekt, evenemang, monument och skulpturer skapade för att minnas eller hylla hbtq+-personer, gemenskaper eller händelser."}],"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0001408"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000028"},{"@id":"https://homosaurus.org/v5/homoit0000029"},{"@id":"https://homosaurus.org/v5/homoit0002260"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000901"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQMemorials"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001004","dc:identifier":"homoit0001004","skos:prefLabel":[{"@language":"en","@value":"Medical care"},{"@language":"es","@value":"Asistencia médica"},{"@language":"nl","@value":"Medische zorg"},{"@language":"sv","@value":"Hälso- och sjukvård"}],"skos:altLabel":[{"@language":"es","@value":"Atención medica"},{"@language":"sv","@value":"Medicinsk vård"}],"rdfs:comment":[{"@language":"en","@value":"Organized measures taken for the maintenance or improvement of health via the prevention, diagnosis, treatment, or cure of disease, illness, injury, or other condition."},{"@language":"es","@value":"Medidas organizadas tomadas para el mantenimiento o la mejora de la salud mediante la prevención, diagnóstico, tratamiento o cura de enfermedades, dolencias, lesiones u otras condiciones."},{"@language":"nl","@value":"Georganiseerde maatregelen genomen voor het behoud of de verbetering van de gezondheid door middel van het voorkomen, diagnosticeren, behandelen of genezen van een ziekte, verwonding of andere aandoening."},{"@language":"sv","@value":"Organiserade åtgärder för att upprätthålla eller förbättra hälsa genom att förebygga, diagnostisera, behandla eller bota sjukdomar, skador eller andra tillstånd."}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000029"},{"@id":"https://homosaurus.org/v5/homoit0000561"},{"@id":"https://homosaurus.org/v5/homoit0001006"},{"@id":"https://homosaurus.org/v5/homoit0001366"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000364"},{"@id":"https://homosaurus.org/v5/homoit0001005"},{"@id":"https://homosaurus.org/v5/homoit0002844"},{"@id":"https://homosaurus.org/v5/homoit0004455"},{"@id":"https://homosaurus.org/v5/homoit0004465"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85082871"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001004"},"dc:replaces":{"@id":"http://homosaurus.org/v2/medicalCare"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000614","dc:identifier":"homoit0000614","skos:prefLabel":[{"@language":"en","@value":"Health care for LGBTQ+ people"},{"@language":"es","@value":"Asistencia médica para las personas LGBTQ+"},{"@language":"de","@value":"Gesundheitsversorgung für LGBTQ+-Personen"},{"@language":"nl","@value":"Gezondheidszorg voor LHBTQ+-personen"},{"@language":"sv","@value":"Hälso- och sjukvård (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"Medical care for LGBTQ people"},{"@language":"en","@value":"Health care for LGBTQ people"},{"@language":"es","@value":"Asistencia médica para las personas (LGBTQ) ||Cuidado de la salud para las personas LGBTQ"},{"@language":"es","@value":"Cuidado medico para personas LGBTQ"},{"@language":"es","@value":"Atención medica para las personas LGBTQ+"}],"rdfs:comment":[{"@language":"en","@value":"Organized measures taken for the maintenance or improvement of health via the prevention, diagnosis, treatment, and/or cure of disease, illness, injury, or other conditions; use in reference to health care addressing the particular needs of LGBTQ+ individuals or communities."},{"@language":"es","@value":"Medidas organizadas tomadas para el mantenimiento o la mejora de la salud a través de la prevención, el diagnóstico, el tratamiento y/o la cura de enfermedades, dolencias, lesiones u otras condiciones; utilícese en referencia a la atención médica que aborda las necesidades particulares de personas o comunidades LGBTQ+."},{"@language":"de","@value":"Organisierte Maßnahmen zur Erhaltung oder Verbesserung der Gesundheit durch Prävention, Diagnose, Behandlung und/oder Heilung von Krankheiten, Beschwerden, Verletzungen oder anderen Gesundheitszuständen; zu verwenden im Zusammenhang mit der Gesundheitsversorgung, die auf die Bedürfnisse von LGBTQ+-Personen oder -Gemeinschaften ausgerichtet ist."},{"@language":"nl","@value":"Georganiseerde maatregelen die worden genomen voor het behoud of de verbetering van de gezondheid door middel van het voorkomen, diagnosticeren, behandelen of genezen van ziekten, verwondingen of andere aandoeningen; gebruik met betrekking tot gezondheidszorg die inspeelt op de specifieke behoeften van LHBTQ+-personen of -gemeenschappen."},{"@language":"sv","@value":"Organiserade insatser för att bevara eller förbättra hälsa genom att förebygga, diagnosticera, behandla och/eller bota sjukdomar, skador eller andra tillstånd. Används för att beskriva hälso- och sjukvård som möter hbtq+-personers särskilda behov."}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000226"},{"@id":"https://homosaurus.org/v5/homoit0001012"},{"@id":"https://homosaurus.org/v5/homoit0001113"},{"@id":"https://homosaurus.org/v5/homoit0001360"},{"@id":"https://homosaurus.org/v5/homoit0003361"},{"@id":"https://homosaurus.org/v5/homoit0003514"},{"@id":"https://homosaurus.org/v5/homoit0003657"},{"@id":"https://homosaurus.org/v5/homoit0004347"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000030"},{"@id":"https://homosaurus.org/v5/homoit0000876"},{"@id":"https://homosaurus.org/v5/homoit0003504"},{"@id":"https://homosaurus.org/v5/homoit0003694"},{"@id":"https://homosaurus.org/v5/homoit0003932"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000614"},"dc:replaces":{"@id":"http://homosaurus.org/v2/healthCareForLGBTQPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000836","dc:identifier":"homoit0000836","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ clubs and organizations"},{"@language":"ja","@value":"LGBTQ+のサークル・団体"},{"@language":"es","@value":"Clubes y organizaciones LGBTQ+"},{"@language":"nl","@value":"LHBTQ+-clubs en organisaties"},{"@language":"sv","@value":"Hbtq+-föreningar"}],"skos:altLabel":[{"@language":"en","@value":"LGBTQ+ clubs"},{"@language":"en","@value":"Clubs (LGBTQ)"},{"@language":"en","@value":"LGBTQ+ organizations"},{"@language":"en","@value":"Organizations (LGBTQ)"},{"@language":"en","@value":"Clubs and organizations (LGBTQ)"},{"@language":"ja","@value":"LGBTQ+のサークル"},{"@language":"ja","@value":"サークル (LGBTQ)"},{"@language":"ja","@value":"LGBTQ+の団体"},{"@language":"ja","@value":"団体 (LGBTQ)"},{"@language":"ja","@value":"サークル・団体 (LGBTQ)"},{"@language":"es","@value":"Clubes LGBTQ"},{"@language":"es","@value":"Clubs LGBTQ"},{"@language":"nl","@value":"Clubs en organisaties (LHBTQ+)"},{"@language":"nl","@value":"LHBTQ+-clubs"},{"@language":"nl","@value":"LHBTQ+-organisaties"},{"@language":"nl","@value":"Organisaties (LHBTQ+)"},{"@language":"sv","@value":"Hbtq+-klubbar"}],"rdfs:comment":[{"@language":"en","@value":"Organized clubs and groups composed primarily of LGBTQ+ people."},{"@language":"ja","@value":"主にLGBTQ+の人々で構成される組織化されたサークルやグループ。"},{"@language":"es","@value":"Grupos u organizaciones de personas LGBTQ+ dedicadas a un interés o una actividad particular."},{"@language":"nl","@value":"Georganiseerde clubs en groepen die voornamelijk bestaan ​​uit LHBTQ+-personen."},{"@language":"sv","@value":"Grupper eller organisationer av hbtq+-personer med ett gemensamt intresse eller syfte."}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000826"},{"@id":"https://homosaurus.org/v5/homoit0000906"},{"@id":"https://homosaurus.org/v5/homoit0000950"},{"@id":"https://homosaurus.org/v5/homoit0000951"},{"@id":"https://homosaurus.org/v5/homoit0003104"},{"@id":"https://homosaurus.org/v5/homoit0000856"},{"@id":"https://homosaurus.org/v5/homoit0003836"},{"@id":"https://homosaurus.org/v5/homoit0003837"},{"@id":"https://homosaurus.org/v5/homoit0003838"},{"@id":"https://homosaurus.org/v5/homoit0003839"},{"@id":"https://homosaurus.org/v5/homoit0003840"},{"@id":"https://homosaurus.org/v5/homoit0003841"},{"@id":"https://homosaurus.org/v5/homoit0003842"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000833"},{"@id":"https://homosaurus.org/v5/homoit0000030"},{"@id":"https://homosaurus.org/v5/homoit0001061"},{"@id":"https://homosaurus.org/v5/homoit0003843"}],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh00003132"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000836"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQClubs"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001830","dc:identifier":"homoit0001830","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ periodicals"},{"@language":"es","@value":"Revistas LGBTQ+"},{"@language":"nl","@value":"LHBTQ+-periodieken"},{"@language":"sv","@value":"Hbtq+-periodika"}],"skos:altLabel":[{"@language":"en","@value":"LGBTQ+ serials"},{"@language":"en","@value":"Periodicals (LGBTQ)"},{"@language":"en","@value":"Serials (LGBTQ)"}],"rdfs:comment":[{"@language":"en","@value":"Publications or serials by or about LGBTQ+ people; use a more specific term if possible."},{"@language":"es","@value":"Publicaciones o series escritas por o sobre personas LGBTQ+; utilícese un término más específico de ser posible."},{"@language":"nl","@value":"(Seriële) publicaties van of over LHBTQ+-personen; gebruik indien mogelijk een meer specifieke term"},{"@language":"sv","@value":"Tryckta eller digitala publikationer som publiceras regelbundet och skapade av eller för hbtq+-personer. Använd mer specifik term om möjligt."}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000031"},{"@id":"https://homosaurus.org/v5/homoit0000896"},{"@id":"https://homosaurus.org/v5/homoit0001041"},{"@id":"https://homosaurus.org/v5/homoit0001042"},{"@id":"https://homosaurus.org/v5/homoit0004306"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001144"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001830"},"dc:issued":{"@type":"xsd:date","@value":"2022-02-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001132","dc:identifier":"homoit0001132","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ press"},{"@language":"es","@value":"Prensa LGBTQ+"},{"@language":"nl","@value":"LHBTQ+-pers"},{"@language":"sv","@value":"Hbtq+-press"}],"skos:altLabel":[{"@language":"en","@value":"Press (LGBTQ)"},{"@language":"es","@value":"Prensa (LGBTQ)"}],"rdfs:comment":[{"@language":"en","@value":"Newspapers, magazines, or other publishing outlets aimed at LGBTQ+ audiences and/or operated by LGBTQ+ people."},{"@language":"es","@value":"Periódicos, revistas u otros medios editoriales dirigidos a audiencias LGBTQ+ y/o operados por personas LGBTQ+."},{"@language":"nl","@value":"Kranten, tijdschriften of andere publicaties gericht op een LHBTQ+-publiek en/of gerund door LHBTQ+-personen."},{"@language":"sv","@value":"Tidningar, tidskrifter eller andra publikationer riktade till hbtq+-personer och/eller drivna av hbtq+-personer."}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000177"},{"@id":"https://homosaurus.org/v5/homoit0000521"},{"@id":"https://homosaurus.org/v5/homoit0000766"},{"@id":"https://homosaurus.org/v5/homoit0000896"},{"@id":"https://homosaurus.org/v5/homoit0000923"},{"@id":"https://homosaurus.org/v5/homoit0000965"},{"@id":"https://homosaurus.org/v5/homoit0001041"},{"@id":"https://homosaurus.org/v5/homoit0001042"},{"@id":"https://homosaurus.org/v5/homoit0001200"},{"@id":"https://homosaurus.org/v5/homoit0001436"},{"@id":"https://homosaurus.org/v5/homoit0002804"},{"@id":"https://homosaurus.org/v5/homoit0002936"},{"@id":"https://homosaurus.org/v5/homoit0003933"},{"@id":"https://homosaurus.org/v5/homoit0004632"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000031"},{"@id":"https://homosaurus.org/v5/homoit0000216"},{"@id":"https://homosaurus.org/v5/homoit0000827"},{"@id":"https://homosaurus.org/v5/homoit0000972"},{"@id":"https://homosaurus.org/v5/homoit0002719"},{"@id":"https://homosaurus.org/v5/homoit0004621"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001132"},"dc:replaces":{"@id":"http://homosaurus.org/v2/pressLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000920","dc:identifier":"homoit0000920","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ phobia"},{"@language":"es","@value":"Fobia LGBTQ+"},{"@language":"nl","@value":"LHBTQ+-fobie"},{"@language":"sv","@value":"Hbtq+-fobi"}],"skos:altLabel":[{"@language":"en","@value":"LGBTQ phobia"},{"@language":"es","@value":"Fobia LGBTQ"}],"rdfs:comment":[{"@language":"en","@value":"Antagonism or disgust directed towards LGBTQ+ identities or people due to their sexuality or gender, perceived or actual. LGBTQ+ phobia can include denial of the existence of certain LGBTQ+ identities, stereotypes, verbal harassment, and physical violence."},{"@language":"es","@value":"Antagonismo o disgusto dirigido hacia identidades o personas LGBTQ+ debido a su sexualidad o género, percibido o real. La fobia LGBTQ+ puede incluir la negación de la existencia de ciertas identidades LGBTQ+, estereotipos, acoso verbal y violencia física."},{"@language":"nl","@value":"Antagonisme of walging gericht tegen LHBTQ+-identiteiten of personen vanwege hun seksualiteit of gender, waargenomen of feitelijk. LHBTQ+-fobie kan bestaan uit ontkenning van het bestaan van bepaalde LHBTQ+-identiteiten, stereotypen, verbale intimidatie en fysiek geweld."},{"@language":"sv","@value":"Fientlighet eller avsky riktad mot hbtq+-identiteter eller personer på grund av faktisk eller upplevd könsidentitet eller sexualitet. Hbtq+-fobi kan omfatta förnekelse av vissa identiteter, stereotyper, verbala trakasserier och fysiskt våld."}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000117"},{"@id":"https://homosaurus.org/v5/homoit0000565"},{"@id":"https://homosaurus.org/v5/homoit0000646"},{"@id":"https://homosaurus.org/v5/homoit0000666"},{"@id":"https://homosaurus.org/v5/homoit0000803"},{"@id":"https://homosaurus.org/v5/homoit0001229"},{"@id":"https://homosaurus.org/v5/homoit0001467"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000032"},{"@id":"https://homosaurus.org/v5/homoit0000228"},{"@id":"https://homosaurus.org/v5/homoit0001885"},{"@id":"https://homosaurus.org/v5/homoit0002590"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000920"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQPhobia"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000954","dc:identifier":"homoit0000954","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ symbols"},{"@language":"es","@value":"Símbolos LGBTQ+"},{"@language":"nl","@value":"LHBTQ+-symbolen"},{"@language":"sv","@value":"Hbtq+-symboler"}],"skos:altLabel":[{"@language":"en","@value":"LGBTQ symbols"},{"@language":"es","@value":"Símbolos LGBTQ"}],"rdfs:comment":[{"@language":"en","@value":"Characters, signs, or objects used to represent LGBTQ+ people, identities, communities, and/or specific historical events."},{"@language":"es","@value":"Personajes, símbolos u objetos utilizados para representar personas, identidades, comunidades y/o eventos históricos específicos LGBTQ+."},{"@language":"nl","@value":"Personages, tekens of objecten die worden gebruikt om LHBTQ+-personen, identiteiten, gemeenschappen en/of specifieke historische gebeurtenissen te representeren."},{"@language":"sv","@value":"Symboler, tecken eller objekt som representerar hbtq+-personer, identiteter, gemenskaper och/eller särskilda historiska händelser."}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000034"},{"@id":"https://homosaurus.org/v5/homoit0000453"},{"@id":"https://homosaurus.org/v5/homoit0000609"},{"@id":"https://homosaurus.org/v5/homoit0000696"},{"@id":"https://homosaurus.org/v5/homoit0000698"},{"@id":"https://homosaurus.org/v5/homoit0001116"},{"@id":"https://homosaurus.org/v5/homoit0003246"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000954"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQSymbols"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000035","dc:identifier":"homoit0000035","skos:prefLabel":[{"@language":"mi","@value":"Akava'ine"},{"@language":"es","@value":"Akava'ine"},{"@language":"de","@value":"Akava'ine"},{"@language":"nl","@value":"Akava'ine"},{"@language":"sv","@value":"Akava'ine"}],"rdfs:comment":[{"@language":"en","@value":"A Cook Islands Māori word referring to transgender people of Māori descent from the Cook Islands."},{"@language":"es","@value":"Una palabra maorí de las Islas Cook que se refiere a las personas transgénero de ascendencia maorí de las Islas Cook."},{"@language":"de","@value":"Ein Begriff der Māori der Cook-Inseln, der sich auf Transgender-Personen mit Māori-Abstammung von den Cook-Inseln bezieht."},{"@language":"nl","@value":"Een Cook Islands Māori woord dat verwijst naar transgenders van Māori afkomst van de Cook Eilanden"},{"@language":"sv","@value":"Ett ord på maori från Cooköarna som refererar till transpersoner med maorisk härkomst från Cooköarna."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000322"},{"@id":"https://homosaurus.org/v5/homoit0002653"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/akavaine"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002653","dc:identifier":"homoit0002653","skos:prefLabel":[{"@language":"en","@value":"MVPFAFF+"},{"@language":"es","@value":"MVPFAFF+"},{"@language":"nl","@value":"MVPFAFF+"},{"@language":"sv","@value":"MVPFAFF+"},{"@language":"fij","@value":"MVPFAFF+"},{"@language":"haw","@value":"MVPFAFF+"},{"@language":"niu","@value":"MVPFAFF+"},{"@language":"pmy","@value":"MVPFAFF+"},{"@language":"rar","@value":"MVPFAFF+"},{"@language":"smo","@value":"MVPFAFF+"},{"@language":"tah","@value":"MVPFAFF+"},{"@language":"ton","@value":"MVPFAFF+"}],"rdfs:comment":[{"@language":"en","@value":"Acronym used to describe Pasifika/Pacific Islander gender diverse identities as a group. The acronym includes Māhū (Hawai'i and Tahiti), Vaka sa lewa lewa (Fiji), Palopa (Papua New Guinea), Fa’afafine (Samoa), Akava’ine (Rarotonga), Fakaleitī (Tonga), Fakafifine (Niue), and more."},{"@language":"es","@value":"Acrónimo utilizado para describir las diversas identidades de género de los pasifika/isleños del Pacífico como grupo. El acrónimo incluye māhū (Hawái y Tahití), vaka sa lewa lewa (Fiyi), palopa (Papúa Nueva Guinea), va'afafine (Samoa), akava'ine (Rarotonga), fakaleitī (Tonga), fakafifine (Niue), etc."},{"@language":"nl","@value":"Acroniem dat wordt gebruikt om de genderdiversiteit van Pasifika/Pacific Islander als groep te beschrijven. Het acroniem omvat Māhū (Hawai'i en Tahiti), Vaka sa lewa lewa (Fiji), Palopa (Papoea-Nieuw-Guinea), Fa'afafine (Samoa), Akava'ine (Rarotonga), Fakaleitī (Tonga), Fakafifine (Niue) , en meer."},{"@language":"sv","@value":"Akronym som används för att beskriva könsvariationer hos personer från Stillahavsöarna (Pasifika). Akronymen inkluderar māhū (Hawai'i och Tahiti), vaka sa lewa lewa (Fiji), palopa (Papua Nya Guinea), fa’afafine (Samoa), akava’ine (Rarotonga), fakaleitī (Tonga), fakafifine (Niue) och fler."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000322"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000035"},{"@id":"https://homosaurus.org/v5/homoit0000413"},{"@id":"https://homosaurus.org/v5/homoit0000419"},{"@id":"https://homosaurus.org/v5/homoit0000979"},{"@id":"https://homosaurus.org/v5/homoit0001499"},{"@id":"https://homosaurus.org/v5/homoit0001502"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-26"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000036","dc:identifier":"homoit0000036","skos:prefLabel":[{"@language":"en","@value":"Sadomasochism"},{"@language":"es","@value":"Sadomasoquismo"},{"@language":"nl","@value":"Sadomasochisme"},{"@language":"sv","@value":"Sadomasochism"}],"skos:altLabel":[{"@language":"en","@value":"Algolagnia"},{"@language":"en","@value":"S\u0026M"},{"@language":"en","@value":"SM"},{"@language":"en","@value":"Sexual Torture"},{"@language":"es","@value":"Tortura sexual"},{"@language":"es","@value":"S\u0026M"},{"@language":"es","@value":"SM"},{"@language":"es","@value":"Algolagnia"},{"@language":"nl","@value":"S\u0026M"},{"@language":"nl","@value":"Seksuele marteling"},{"@language":"nl","@value":"SM"}],"rdfs:comment":[{"@language":"en","@value":"Eroticization of pain and intense sensation."},{"@language":"es","@value":"Erotización del dolor y la sensación intensa."},{"@language":"nl","@value":"Erotisering van pijn en intense sensatie."},{"@language":"sv","@value":"Erotisering av smärta och intensiv stimulans."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000442"},{"@id":"https://homosaurus.org/v5/homoit0001300"}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000997"},{"@id":"https://homosaurus.org/v5/homoit0001250"},{"@id":"https://homosaurus.org/v5/homoit0003110"},{"@id":"https://homosaurus.org/v5/homoit0003130"},{"@id":"https://homosaurus.org/v5/homoit0003131"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001295"},{"@id":"https://homosaurus.org/v5/homoit0001318"},{"@id":"https://homosaurus.org/v5/homoit0001319"},{"@id":"https://homosaurus.org/v5/homoit0003084"},{"@id":"https://homosaurus.org/v5/homoit0003116"},{"@id":"https://homosaurus.org/v5/homoit0003141"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85120740"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000404"},"dc:replaces":{"@id":"http://homosaurus.org/v2/SM"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001300","dc:identifier":"homoit0001300","skos:prefLabel":[{"@language":"en","@value":"Sexual preference"},{"@language":"es","@value":"Preferencias sexuales"},{"@language":"nl","@value":"Seksuele voorkeur"},{"@language":"sv","@value":"Sexuell preferens"}],"rdfs:comment":[{"@language":"en","@value":"An enduring pattern of sexual attraction towards a certain sex or multiple sexes, as well as characterizations, objects, situational fantasies, or behaviors; generally understood to be either or both biologically determined and culturally and/or sociologically dictated."},{"@language":"es","@value":"Patrón duradero de atracción sexual hacia un sexo determinado o múltiples sexos, así como hacia caracterizaciones, objetos, fantasías situacionales o comportamientos; generalmente se entiende que está determinado tanto biológicamente como cultural y/o sociológicamente."},{"@language":"nl","@value":"Een blijvend patroon van seksuele aantrekking tot een bepaald geslacht of meerdere geslachten, evenals karakteriseringen, objecten, situationele fantasieën of gedrag; algemeen begrepen als ofwel of beide biologisch bepaald en cultureel en/of sociologisch gedicteerd"},{"@language":"sv","@value":"En varaktig tendens till sexuell attraktion mot ett visst kön eller flera kön samt till specifika karaktärer, objekt, situationella fantasier eller beteenden. Ses oftast som biologiskt grundad och/eller kulturellt eller sociologiskt formad."}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000036"},{"@id":"https://homosaurus.org/v5/homoit0000344"},{"@id":"https://homosaurus.org/v5/homoit0000442"},{"@id":"https://homosaurus.org/v5/homoit0000997"},{"@id":"https://homosaurus.org/v5/homoit0001081"},{"@id":"https://homosaurus.org/v5/homoit0001094"},{"@id":"https://homosaurus.org/v5/homoit0001250"},{"@id":"https://homosaurus.org/v5/homoit0001304"},{"@id":"https://homosaurus.org/v5/homoit0001558"},{"@id":"https://homosaurus.org/v5/homoit0001814"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000242"},{"@id":"https://homosaurus.org/v5/homoit0000303"},{"@id":"https://homosaurus.org/v5/homoit0001095"},{"@id":"https://homosaurus.org/v5/homoit0001286"},{"@id":"https://homosaurus.org/v5/homoit0001287"},{"@id":"https://homosaurus.org/v5/homoit0001290"},{"@id":"https://homosaurus.org/v5/homoit0001295"},{"@id":"https://homosaurus.org/v5/homoit0001296"},{"@id":"https://homosaurus.org/v5/homoit0001297"},{"@id":"https://homosaurus.org/v5/homoit0001298"},{"@id":"https://homosaurus.org/v5/homoit0001302"},{"@id":"https://homosaurus.org/v5/homoit0001311"},{"@id":"https://homosaurus.org/v5/homoit0001315"},{"@id":"https://homosaurus.org/v5/homoit0001493"},{"@id":"https://homosaurus.org/v5/homoit0001556"},{"@id":"https://homosaurus.org/v5/homoit0001915"},{"@id":"https://homosaurus.org/v5/homoit0001917"},{"@id":"https://homosaurus.org/v5/homoit0003738"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh91005179"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001300"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sexualPreference"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000997","dc:identifier":"homoit0000997","skos:prefLabel":[{"@language":"en","@value":"Masochism"},{"@language":"es","@value":"Masoquismo"},{"@language":"nl","@value":"Masochisme"},{"@language":"sv","@value":"Masochism"}],"rdfs:comment":[{"@language":"en","@value":"Erotic or sexual enjoyment of pain and intense sensations. "},{"@language":"es","@value":"Disfrute erótico o sexual del dolor y de sensaciones intensas."},{"@language":"nl","@value":"Erotisch of seksueel genieten van pijn en intense sensaties."},{"@language":"sv","@value":"Erotisk eller sexuell njutning av smärta och starka fysiska upplevelser."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000036"},{"@id":"https://homosaurus.org/v5/homoit0001300"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001250"},{"@id":"https://homosaurus.org/v5/homoit0001295"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85081828"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000404"},"dc:replaces":{"@id":"http://homosaurus.org/v2/masochism"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001250","dc:identifier":"homoit0001250","skos:prefLabel":[{"@language":"en","@value":"Sadism"},{"@language":"es","@value":"Sadismo"},{"@language":"nl","@value":"Sadisme"},{"@language":"sv","@value":"Sadism"}],"rdfs:comment":[{"@language":"en","@value":"Erotic or sexual enjoyment of the application of pain or intense sensations. Derived from the literary works of the Marquis de Sade."},{"@language":"es","@value":"Preferencia sexual o fetiche relacionado con la dominación o con diversas prácticas de BDSM, incluido el dolor, la humillación y el sufrimiento. Derivado de las obras literarias del Marqués de Sade."},{"@language":"nl","@value":"Erotisch of seksueel genot van het toebrengen van pijn of intense sensaties. Afgeleid van de literaire werken van de markies de Sade."},{"@language":"sv","@value":"Sexuell eller erotisk njutning av att tillgoga smärta eller intensiv stimulans. Termen härstammar från den franske författaren Marquis de Sade."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000036"},{"@id":"https://homosaurus.org/v5/homoit0001300"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000997"},{"@id":"https://homosaurus.org/v5/homoit0001295"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85116425"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000404"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sadism"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003110","dc:identifier":"homoit0003110","skos:prefLabel":[{"@language":"en","@value":"Genital torture"},{"@language":"es","@value":"Tortura genital"},{"@language":"de","@value":"Genitalfolter"},{"@language":"nl","@value":"Genitale marteling"},{"@language":"sv","@value":"Genital tortyr"}],"skos:altLabel":[{"@language":"en","@value":"CBT"},{"@language":"en","@value":"Cock and ball torture"},{"@language":"en","@value":"Pussy torture"},{"@language":"de","@value":"CBT"},{"@language":"de","@value":"Penis- und Hodenfolter"},{"@language":"de","@value":"Vaginalfolter"},{"@language":"sv","@value":"Genital torture"}],"rdfs:comment":[{"@language":"en","@value":"A kink activity involving application of pain, intense sensation, or constriction to the genitals."},{"@language":"es",