homosaurus.org/v5/homoit0003124"},{"@id":"https://homosaurus.org/v5/homoit0003132"},{"@id":"https://homosaurus.org/v5/homoit0003133"},{"@id":"https://homosaurus.org/v5/homoit0003709"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000302"},{"@id":"https://homosaurus.org/v5/homoit0000442"},{"@id":"https://homosaurus.org/v5/homoit0000595"},{"@id":"https://homosaurus.org/v5/homoit0000609"},{"@id":"https://homosaurus.org/v5/homoit0001266"},{"@id":"https://homosaurus.org/v5/homoit0001306"},{"@id":"https://homosaurus.org/v5/homoit0001315"},{"@id":"https://homosaurus.org/v5/homoit0001325"},{"@id":"https://homosaurus.org/v5/homoit0001641"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85120576"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001299"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sexualPractices"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000076","dc:identifier":"homoit0000076","skos:prefLabel":[{"@language":"en","@value":"Ass fucking"},{"@language":"es","@value":"Dar por culo"},{"@language":"de","@value":"Arschficken"},{"@language":"nl","@value":"Kontneuken"},{"@language":"sv","@value":"Anala samlag"}],"skos:altLabel":[{"@language":"en","@value":"Butt fucking"},{"@language":"es","@value":"Coger por el culo"},{"@language":"es","@value":"Coger por culo"},{"@language":"es","@value":"Dar por culo"},{"@language":"es","@value":"Tomar por culo"},{"@language":"es","@value":"Culear"}],"rdfs:comment":[{"@language":"en","@value":"The sexual act of penetrating an individual's anus with a penis or dildo."},{"@language":"es","@value":"Acto sexual que consiste en penetrar el ano de una persona con un pene o un consolador."},{"@language":"de","@value":"Der sexuelle Akt des Penetrierens des Anus einer Person mit einem Penis oder Dildo."},{"@language":"nl","@value":"De seksuele handeling van het penetreren van de anus van een persoon met een penis of dildo."},{"@language":"sv","@value":"Sexuell praktik där en penis eller en dildo förs in i anus."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000043"},{"@id":"https://homosaurus.org/v5/homoit0000459"}],"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0000099"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000293"},{"@id":"https://homosaurus.org/v5/homoit0003107"},{"@id":"https://homosaurus.org/v5/homoit0003124"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001267"},"dc:replaces":{"@id":"http://homosaurus.org/v2/assFucking"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000233","dc:identifier":"homoit0000233","skos:prefLabel":[{"@language":"en","@value":"Butt plugs"},{"@language":"es","@value":"Plugs anales"},{"@language":"de","@value":"Analplugs"},{"@language":"nl","@value":"Butt plugs"},{"@language":"sv","@value":"Buttpluggar"}],"skos:altLabel":[{"@language":"en","@value":"Anal dilators"},{"@language":"en","@value":"Anal inserts"},{"@language":"en","@value":"Anal plugs"},{"@language":"en","@value":"Buttplugs"},{"@language":"es","@value":"Dilatadores anales"},{"@language":"es","@value":"Enchufe anal"},{"@language":"es","@value":"Tapón anal"},{"@language":"de","@value":"Buttplugs"},{"@language":"de","@value":"Butt-Plugs"},{"@language":"de","@value":"Anal-Plugs"}],"rdfs:comment":[{"@language":"en","@value":"A sex toy designed to be inserted into the anus for sexual stimulation or pleasure. Butt plugs tend to be shorter than dildos and have a flared base that prevents them from being lost in the rectum."},{"@language":"es","@value":"Un juguete sexual diseñado para insertarse en el ano para estimulación o placer sexual. Los plugs anales tienden a ser más cortos que los consoladores y tienen una base acampanada que evita que se pierdan en el recto."},{"@language":"de","@value":"Ein Sexspielzeug, das zur sexuellen Stimulation oder zum Vergnügen in den Anus eingeführt werden kann. Analplugs sind in der Regel kürzer als Dildos und haben eine aufgeweitete Basis, die verhindert, dass sie im Rektum verloren gehen."},{"@language":"nl","@value":"Seksspeeltjes ontworpen om in het rectum te worden ingebracht voor seksueel genot. Buttplugs zijn meestal korter dan dildo's en hebben een uitlopende basis die voorkomt dat ze verloren gaan in het rectum."},{"@language":"sv","@value":"En sexleksak som är utformad för att föras in i anus för sexuell stimulering eller njutning. Buttplugar är oftast kortare än dildos och har en utvidgad bas för att förhindra att de glider in i ändtarmen."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001266"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000043"},{"@id":"https://homosaurus.org/v5/homoit0000081"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001266"},"dc:replaces":{"@id":"http://homosaurus.org/v2/buttplugs"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003124","dc:identifier":"homoit0003124","skos:prefLabel":[{"@language":"en","@value":"Douching"},{"@language":"de","@value":"Intimdusche"},{"@language":"es","@value":"Douching"},{"@language":"nl","@value":"Douchen"},{"@language":"sv","@value":"Intimdusch"}],"skos:altLabel":[{"@language":"de","@value":"Intimspülung"},{"@language":"es","@value":"Ducha vaginal"},{"@language":"es","@value":"Lavado anal"},{"@language":"es","@value":"Lavado vaginal"},{"@language":"sv","@value":"Douching"}],"rdfs:comment":[{"@language":"en","@value":"The use of a device (called a douche or enema) to introduce a stream of liquid into either the rectum or vagina. Can be used for sexual or erotic purposes."},{"@language":"de","@value":"Die Verwendung eines Geräts namens Intimdusche oder Einlauf, um eine Flüssigkeit entweder in den Enddarm oder die Vagina einzuführen. Kann für sexuelle oder erotische Zwecke verwendet werden."},{"@language":"es","@value":"El uso de un dispositivo (llamado ducha vaginal o enema) para introducir un chorro de líquido en el recto o la vagina. Puede utilizarse con fines sexuales o eróticos."},{"@language":"nl","@value":"Het gebruik van een hulpmiddel (een douche of klysma genoemd) om een stroom vloeistof in het rectum of de vagina te brengen. Kan gebruikt worden voor seksuele of erotische doeleinden."},{"@language":"sv","@value":"Användning av ett redskap (kallat dusch eller lavemang) för att föra in en vätskesström i ändtarmen eller slidan. Kan användas i sexuella eller erotiska syften."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000442"},{"@id":"https://homosaurus.org/v5/homoit0001267"},{"@id":"https://homosaurus.org/v5/homoit0001299"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000043"},{"@id":"https://homosaurus.org/v5/homoit0000076"},{"@id":"https://homosaurus.org/v5/homoit0000081"},{"@id":"https://homosaurus.org/v5/homoit0000293"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000404"},"dc:issued":{"@type":"xsd:date","@value":"2023-12-20"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000044","dc:identifier":"homoit0000044","skos:prefLabel":[{"@language":"en","@value":"Androgen insensitivity syndrome"},{"@language":"es","@value":"Síndrome de insensibilidad a los andrógenos"},{"@language":"de","@value":"Androgeninsensitivitätssyndrom"},{"@language":"nl","@value":"Androgeen ongevoeligheidssyndroom"},{"@language":"sv","@value":"Androgenokänslighetssyndrom"}],"skos:altLabel":[{"@language":"en","@value":"AIS"},{"@language":"en","@value":"Goldberg-Maxwell syndrome"},{"@language":"en","@value":"Male androgen insensitivity syndrome"},{"@language":"es","@value":"SIA"},{"@language":"es","@value":"Síndrome Goldberg-Maxwell"},{"@language":"es","@value":"Síndrome de insensibilidad a los andrógenos masculinos"},{"@language":"de","@value":"AIS"},{"@language":"de","@value":"Androgen-Resistenz-Syndrom"},{"@language":"de","@value":"Androgenresistenz-Syndrom"},{"@language":"de","@value":"Goldberg-Maxwell-Syndrom"},{"@language":"de","@value":"Morris-Syndrom"},{"@language":"de","@value":"Syndrom der testikulären Feminisierung (TFM)"},{"@language":"sv","@value":"Androgeninsensitivitetssyndrom"}],"rdfs:comment":[{"@language":"en","@value":"People born with AIS have XY chromosomes and testes, and their bodies have varying levels of insensitivity to androgens (including testosterone). This means that their cells do not respond typically to the testosterone that they produce. Like other variations in sex characteristics, AIS is a spectrum, with the subcategories of complete (CAIS), partial (PAIS), and mild androgen insensitivity (MAIS). The term \"male androgen insensitivity syndrome\" should not be used to describe this variation because many people with AIS are women."},{"@language":"es","@value":"Las personas que nacen con AIS (por sus siglas en inglés) [or use the Spanish acronym, SIA. This applies to its usage throughout the definition.] tienen cromosomas XY y testículos, y sus cuerpos tienen distintos niveles de insensibilidad a los andrógenos (incluida la testosterona). Esto significa que sus células no responden de forma regular a la testosterona que producen. Al igual que otras variaciones en las características sexuales, la AIS es un espectro, con las subcategorías de insensibilidad completa (CAIS), parcial (PAIS) y leve a los andrógenos (MAIS). El término \"síndrome de insensibilidad masculina a los andrógenos\" no debe utilizarse para describir esta variación ya que muchas personas con AIS son mujeres."},{"@language":"de","@value":"Menschen, die mit AIS geboren werden, haben XY-Chromosomen und Hoden, und ihr Körper ist in unterschiedlichem Masse unempfindlich gegenüber Androgenen (einschließlich Testosteron). Das bedeutet, dass ihre Zellen untypisch auf das von ihnen produzierte Testosteron reagieren. Wie bei anderen Variationen der Geschlechtsmerkmale handelt es sich bei der AIS um ein Spektrum mit den Unterkategorien vollständige (CAIS), teilweise (PAIS) und leichte Androgeninsensitivität (MAIS). Der Begriff „männliches Androgeninsensitivitätssyndrom“ sollte nicht verwendet werden, um diese Variation zu beschreiben, da viele Menschen mit AIS Frauen sind."},{"@language":"nl","@value":"Een genetische aandoening die personen met XY-chromosomen treft, waardoor cellen gedeeltelijk of volledig niet meer kunnen reageren op androgenen, waardoor de ontwikkeling van mannelijke genitaliën of secundaire geslachtskenmerken wordt belemmerd of voorkomen."},{"@language":"sv","@value":"Personer som föds med androgenokänslighetssyndrom har XY-kromosomer och testiklar, men deras kroppar har varierande grad av okänslighet för androgener (inklusive testosteron). Det innebär att deras celler inte svarar typiskt på det testosteron de producerar. Liksom andra variationer i könskarakteristika är Androgenokänslighetssyndrom ett spektrum med underkategorierna fullständig (CAIS), partiell (PAIS) och mild androgenokänslighet (MAIS). Termen ”manligt androgenokänslighetssyndrom” bör inte användas för att beskriva denna variation eftersom många personer med androgenokänslighetssyndrom är kvinnor."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000669"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0001079"},{"@id":"https://homosaurus.org/v5/homoit0002830"},{"@id":"https://homosaurus.org/v5/homoit0002866"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001269"},"dc:replaces":{"@id":"http://homosaurus.org/v2/androgenInsensitivitySyndrome"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001079","dc:identifier":"homoit0001079","skos:prefLabel":[{"@language":"en","@value":"Partial androgen insensitivity syndrome"},{"@language":"es","@value":"Síndrome de insensibilidad andrógena parcial"},{"@language":"nl","@value":"Partieel androgeen ongevoeligheidssyndroom"},{"@language":"sv","@value":"Partiell androgenresistens"}],"skos:altLabel":[{"@language":"en","@value":"PAIS"},{"@language":"es","@value":"SIAP"},{"@language":"es","@value":"Síndrome de insensibilidad androgénica parcial"},{"@language":"es","@value":"Síndrome de insensibilidad parcial a los andrógeno"},{"@language":"sv","@value":"PAIS"},{"@language":"sv","@value":"Partiell androgenresistenssyndrom"}],"rdfs:comment":[{"@language":"en","@value":"People with partial androgen insensitivity (PAIS) have some response to testosterone, but not as much as is typical for people with XY chromosomes without androgen insensitivity. People with PAIS may be born with testes that are undescended or partially descended and with genital differences such as a vaginal opening that is shallower than typical, a phallus that may be perceived as a large clitoris or a small penis, and variations affecting their urethra. They might also be born with genitals that look more like a penis or like a vulva and vagina. In adolescence, people with PAIS may develop some features that are associated with a typical testosterone puberty and others that are associated with a typical estrogen puberty since their body responds to some of the testosterone that their gonads produce while the rest is converted into estrogen."},{"@language":"es","@value":"Las personas con insensibilidad parcial a los andrógenos (PAIS, por sus siglas en inglés) tienen cierta respuesta a la testosterona, pero no tanta como es típica de las personas con cromosomas XY sin insensibilidad a los andrógenos. Las personas con PAIS pueden nacer con testículos no descendidos o parcialmente descendidos y con diferencias genitales, como una apertura vaginal menos profunda de lo normal, un falo que puede percibirse como un clítoris grande o un pene pequeño y variaciones que afectan la uretra. También pueden nacer con genitales que se parecen más a un pene o a una vulva y vagina. En la adolescencia, las personas con PAIS pueden desarrollar algunas características asociadas con una pubertad típica de testosterona y otras asociadas con una pubertad típica de estrógeno, ya que su cuerpo responde a parte de la testosterona que producen sus gónadas mientras el resto se convierte en estrógeno."},{"@language":"nl","@value":"Een genetische aandoening die resulteert in het gedeeltelijk onvermogen van het lichaam om te reageren op androgenen, wat de ontwikkeling van geslachtsorganen en secundaire geslachtskenmerken van mannen beïnvloedt."},{"@language":"sv","@value":"Personer med partiell androgenresistens (PAIS) reagerar delvis på testosteron, men inte i samma utsträckning som personer med en X- och en Y-kromosom (46XY) utan androgenresistens. De kan födas med testiklar som är ofullständigt nedstigna, samt med genitala variationer såsom ett grunt vaginalöppnande, en penis som kan tolkas som en stor klitoris eller liten penis, och variationer i urinrörets placering. De kan även födas med könsorgan som liknar en penis eller en vulva och vagina. I puberteten kan personer med PAIS utveckla vissa drag typiska för testosteronpåverkan och andra typiska för östrogenpåverkan, eftersom kroppen delvis svarar på det testosteron som produceras medan resten omvandlas till östrogen."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000044"},{"@id":"https://homosaurus.org/v5/homoit0000669"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001269"},"dc:replaces":{"@id":"http://homosaurus.org/v2/partialAndrogenInsensitivitySyndrome"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002830","dc:identifier":"homoit0002830","skos:prefLabel":[{"@language":"en","@value":"Complete gonadal dysgenesis"},{"@language":"es","@value":"Disgenesia gonadal completa"},{"@language":"de","@value":"Gonadendysgenesie, 46, XY-Typ"},{"@language":"nl","@value":"Volledige gonadale dysgenesie"},{"@language":"sv","@value":"Complete gonadal dysgenesis"}],"skos:altLabel":[{"@language":"en","@value":"Pure gonadal dysgenesis"},{"@language":"es","@value":"Síndrome de Swyer"},{"@language":"de","@value":"Swyer-Syndrom"},{"@language":"nl","@value":"Pure gonadale dysgenesie"},{"@language":"sv","@value":"Komplett gonadaldysgenesi"}],"rdfs:comment":[{"@language":"en","@value":"People with complete gonadal dysgenesis are born with XX or XY chromosomes and gonadal tissue that has not developed into testicles or ovaries (also known as streak gonads). They are generally born with a vulva and vagina, and they will not usually develop secondary sex characteristics at puberty because streak gonads do not produce hormones."},{"@language":"es","@value":"Las personas con disgenesia gonadal completa nacen con cromosomas XX o XY y con tejido gonadal que no se ha desarrollado en testículos u ovarios (también conocido como gónadas rayadas). Tienden a nacer con vulva y vagina, y usualmente no desarrollan características sexuales secundarias en la pubertad porque las gónadas rayadas no producen hormonas."},{"@language":"de","@value":"Menschen mit vollständiger Gonadendysgenesie werden mit XX- oder XY-Chromosomen und Gonadengewebe geboren, das sich nicht zu Hoden oder Eierstöcken entwickelt hat (auch als Streak-Gonaden bezeichnet). Sie werden in der Regel mit einer Vulva und einer Vagina geboren und entwickeln in der Pubertät normalerweise keine sekundären Geschlechtsmerkmale, da Streak-Gonaden keine Hormone produzieren."},{"@language":"nl","@value":"Personen met complete gonadale dysgenesie worden geboren met XX- of XY-chromosomen en gonadaal weefsel dat zich niet heeft ontwikkeld tot testikels of eierstokken (ook wel streak gonads genoemd). Ze worden over het algemeen geboren met een vulva en vagina en ontwikkelen meestal geen secundaire geslachtskenmerken in de puberteit omdat de streak gonaden geen hormonen produceren."},{"@language":"sv","@value":"Personer med complete gonadal dysgenesis föds med två X-kromosomer (46XX) eller en X- och en Y-kromosom (46XY) och gonadvävnad som inte har utvecklats till testiklar eller äggstockar (även kallat strim-gonader). De föds vanligtvis med en vulva och vagina och utvecklar sällan sekundära könskaraktäristika vid puberteten eftersom strim-gonaderna inte producerar hormoner."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000044"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001269"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002866","dc:identifier":"homoit0002866","skos:prefLabel":[{"@language":"en","@value":"Mild androgen insensitivity syndrome"},{"@language":"es","@value":"Síndrome de insensibilidad androgénica leve"},{"@language":"nl","@value":"Mild androgeen ongevoeligheidssyndroom"},{"@language":"sv","@value":"Mild androgen insensitivity syndrome (MAIS)"}],"skos:altLabel":[{"@language":"en","@value":"MAIS"},{"@language":"es","@value":"MAIS"},{"@language":"sv","@value":"Mild androgenokänslighet (MAIS)"}],"rdfs:comment":[{"@language":"en","@value":"People with mild androgen insensitivity syndrome (MAIS) respond to testosterone at a somewhat reduced level compared to typical levels, which means that they will usually be born with a penis (which may or may not be smaller than typical) and will later develop secondary sex characteristics associated with a typical testosterone puberty. Because their bodies convert a small amount of their naturally produced androgens into estrogen, they may have visible variations in features, such as the amount of facial hair, body hair, or muscle tone they develop. They may also experience some breast development during puberty."},{"@language":"es","@value":"Las personas con síndrome de insensibilidad androgénica leve (MAIS, por sus siglas en inglés) responden a la testosterona a un nivel algo reducido en comparación con los niveles típicos, lo que significa que generalmente nacerán con un pene (que puede o no ser más pequeño de lo típico) y luego desarrollarán características sexuales secundarias asociadas con una pubertad típica de testosterona. Debido a que sus cuerpos convierten una pequeña cantidad de los andrógenos producidos naturalmente en estrógeno, pueden tener variaciones visibles en sus rasgos, como la cantidad de vello facial, vello corporal o el tono muscular que desarrollen. También pueden experimentar cierto desarrollo mamario durante la pubertad."},{"@language":"nl","@value":"Personen met het milde androgeen ongevoeligheidssyndroom (MAIS) reageren op een enigszins verlaagd niveau op testosteron in vergelijking met normale niveaus, wat betekent dat ze meestal worden geboren met een penis (die al dan niet kleiner is dan normaal) en later secundaire geslachtskenmerken zullen ontwikkelen, typerend voor testosteron-puberteit. Omdat hun lichaam een kleine hoeveelheid van hun natuurlijk geproduceerde androgenen omzet in oestrogeen, kunnen ze zichtbare variaties in kenmerken vertonen, zoals de hoeveelheid gezichtshaar, lichaamshaar of spiertonus die ze ontwikkelen. Ze kunnen tijdens de puberteit ook enige borstontwikkeling ervaren."},{"@language":"sv","@value":"Personer med Mild androgen insensitivity syndrome (MAIS) reagerar på testosteron i något reducerad grad jämfört med det som är typiskt på grund av en mutation i androgenreceptorerna. De föds vanligtvis med penis (som kan vara mindre än genomsnittet) och utvecklar sekundära könskarakteristika i linje med testosteronstyrd pubertet. Eftersom kroppen omvandlar en del av de producerade androgenerna till östrogen kan vissa utveckla exempelvis mindre mängd kroppsbehåring eller muskler samt viss bröstutveckling under puberteten."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000044"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001269"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000045","dc:identifier":"homoit0000045","skos:prefLabel":[{"@language":"en","@value":"Androgynous people"},{"@language":"es","@value":"Personas andróginas"},{"@language":"de","@value":"Androgyne Personen"},{"@language":"fr","@value":"Personnes androgynes"},{"@language":"sv","@value":"Androgyna personer"}],"rdfs:comment":[{"@language":"en","@value":"People who have a non-binary gender that includes masculine and feminine traits."},{"@language":"es","@value":"Personas que tienen un género no binario que incluye rasgos masculinos y femeninos."},{"@language":"de","@value":"Eine Personen, deren Gender-Präsentation, gemessen an gesellschaftlichen Geschlechternormen, weder eindeutig männlich noch eindeutig weiblich erscheint."},{"@language":"fr","@value":"Personne dont l'expression sociale de genre (apparence) est non binaire, ou qui se situe dans l'éventail entre féminité et masculinité."},{"@language":"sv","@value":"Personer med en ickebinär könsidentitet som inkluderar både maskulina och feminina drag."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001378"},{"@id":"https://homosaurus.org/v5/homoit0001817"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000047"},{"@id":"https://homosaurus.org/v5/homoit0001048"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/androgynousPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000047","dc:identifier":"homoit0000047","skos:prefLabel":[{"@language":"en","@value":"Androgyny"},{"@language":"es","@value":"Androginia"},{"@language":"de","@value":"Androgynität"},{"@language":"fr","@value":"Androgynie"},{"@language":"nl","@value":"Androgynie"},{"@language":"sv","@value":"Androgynitet"}],"rdfs:comment":[{"@language":"en","@value":"The combination of masculine and feminine characteristics."},{"@language":"es","@value":"La combinación de características masculinas y femeninas."},{"@language":"de","@value":"Gemessen an gesellschaftlichen Geschlechternormen weder eindeutig männlich noch eindeutig weiblich."},{"@language":"fr","@value":"Combinaison de caractéristiques dites masculines et féminines dans l'expression de genre."},{"@language":"sv","@value":"Kombinationen av maskulina och feminina egenskaper."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000568"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000045"},{"@id":"https://homosaurus.org/v5/homoit0000389"},{"@id":"https://homosaurus.org/v5/homoit0000562"},{"@id":"https://homosaurus.org/v5/homoit0000577"},{"@id":"https://homosaurus.org/v5/homoit0000995"},{"@id":"https://homosaurus.org/v5/homoit0001756"}],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85004920"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/androgyny"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000046","dc:identifier":"homoit0000046","skos:prefLabel":[{"@language":"he","@value":"Androgynos"},{"@language":"es","@value":"Androgynos"},{"@language":"de","@value":"Androgynos"},{"@language":"nl","@value":"Androgynos"},{"@language":"sv","@value":"Androgynos"}],"rdfs:comment":[{"@language":"en","@value":"Israeli term used in Rabbinical literature to describe both an intersex mythological creature and refer to a legal condition."},{"@language":"es","@value":"Término griego utilizado en la literatura rabínica para describir tanto una criatura mitológica intersexual como para referirse a una condición legal."},{"@language":"de","@value":"Israelischer Begriff, der in der rabbinischen Literatur verwendet wird, um sowohl ein mythologisches inter* Wesen zu beschreiben, als auch auf einen rechtlichen Zustand hinzuweisen."},{"@language":"nl","@value":"Israëlische term die in de rabbijnse literatuur wordt gebruikt om zowel een intersekse mythologisch wezen te beschrijven als te verwijzen naar een wettige conditie"},{"@language":"sv","@value":"En israelisk term som används i rabbinsk litteratur för att beskriva både en mytologisk intersexvarelse och en juridisk kategori."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000322"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000618"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/androgynos"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000618","dc:identifier":"homoit0000618","skos:prefLabel":[{"@language":"en","@value":"Intersex people"},{"@language":"de","@value":"Inter* Personen"},{"@language":"es","@value":"Personas intersexuales"},{"@language":"nl","@value":"Intersekse personen"},{"@language":"sv","@value":"Intersexpersoner"}],"skos:altLabel":[{"@language":"en","@value":"Hermaphrodites"},{"@language":"en","@value":"Intersexuals"},{"@language":"en","@value":"Hermaphroditic people"},{"@language":"en","@value":"Intersex-identified people"},{"@language":"en","@value":"Intersexual people"},{"@language":"de","@value":"inter* Menschen"},{"@language":"es","@value":"Hermafroditas"},{"@language":"es","@value":"Personas hermafroditas"},{"@language":"es","@value":"Intersexuales"},{"@language":"es","@value":"Personas intersex"}],"rdfs:comment":[{"@language":"en","@value":"Individuals born with variations in their genitalia, hormones, internal anatomy, and/or chromosomes that do not fully or exclusively conform to medical or social expectations for males or females. Only use to describe people who describe themselves as intersex."},{"@language":"de","@value":"Personen, die mit Abweichungen an ihren Genitalien, Hormonen oder ihrer inneren Antomie geboren wurden, die nicht vollständig oder ausschließlich den medizinischen Erwartungen für Männer oder Frauen entsprechen. Nur zu verwenden, um Personen zu beschreiben, die sich als inter* identifizieren."},{"@language":"es","@value":"Personas que nacen con variaciones en sus genitales, hormonas, anatomía interna y/o cromosomas que no se conforman total o exclusivamente a las expectativas médicas o sociales para hombres o mujeres. Utilícese únicamente para describir a personas que se describen como intersex."},{"@language":"nl","@value":"Personen wiens genitaliën, hormonen, interne anatomie en/of chromosomen niet volledig of uitsluitend voldoen aan de medische of sociale verwachtingen voor mannen of vrouwen; alleen gebruiken om mensen te beschrijven die zichzelf identificeren als intersekse."},{"@language":"sv","@value":"Personer som är födda med variationer i genitalier, hormoner, inre anatomi och/eller kromosomer som inte helt eller uteslutande motsvarar medicinska eller sociala förväntningar på vad som är manligt eller kvinnligt. Används endast för personer som själva identifierar sig som intersex."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000915"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000668"},{"@id":"https://homosaurus.org/v5/homoit0000674"},{"@id":"https://homosaurus.org/v5/homoit0002825"},{"@id":"https://homosaurus.org/v5/homoit0003039"},{"@id":"https://homosaurus.org/v5/homoit0003225"},{"@id":"https://homosaurus.org/v5/homoit0004638"},{"@id":"https://homosaurus.org/v5/homoit0004643"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000046"},{"@id":"https://homosaurus.org/v5/homoit0000352"},{"@id":"https://homosaurus.org/v5/homoit0000669"},{"@id":"https://homosaurus.org/v5/homoit0000670"},{"@id":"https://homosaurus.org/v5/homoit0000671"},{"@id":"https://homosaurus.org/v5/homoit0000672"},{"@id":"https://homosaurus.org/v5/homoit0000673"},{"@id":"https://homosaurus.org/v5/homoit0001759"},{"@id":"https://homosaurus.org/v5/homoit0001763"},{"@id":"https://homosaurus.org/v5/homoit0001767"},{"@id":"https://homosaurus.org/v5/homoit0001822"},{"@id":"https://homosaurus.org/v5/homoit0002744"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2007003860"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/intersexPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000568","dc:identifier":"homoit0000568","skos:prefLabel":[{"@language":"en","@value":"Gender expression"},{"@language":"es","@value":"Expresión de género"},{"@language":"de","@value":"Geschlechtsausdruck"},{"@language":"fr","@value":"Expression de genre"},{"@language":"nl","@value":"Genderexpressie"},{"@language":"sv","@value":"Könsuttryck"}],"skos:altLabel":{"@language":"de","@value":"Genderausdruck"},"rdfs:comment":[{"@language":"en","@value":"Term used to describe the way individuals express their gender identity through their appearance and behaviors, including gestures, movement, dress, and grooming."},{"@language":"es","@value":"Término utilizado para describir la forma en que las personas expresan su identidad de género a través de su apariencia y comportamientos, incluidos gestos, movimientos, vestimenta y arreglo personal."},{"@language":"de","@value":"Begriff zur Beschreibung der Art und Weise, wie Personen ihre Geschlechtsidentität durch ihr Erscheinungsbild und ihr Verhalten ausdrücken, einschliesslich Gesten, Bewegungen, Kleidung und Körperpflege."},{"@language":"fr","@value":"Manière dont une personne exprime son genre. Cela peut inclure ses comportements et son apparence, comme ses choix vestimentaires, sa coiffure, le port de maquillage, son langage corporel et sa voix. L'expression de genre est indépendante du sexe assigné à la naissance et n'est pas nécessairement liée à l'identité de genre telle que vécue personnellement et intimement."},{"@language":"nl","@value":"Term die wordt gebruikt om de manier te beschrijven waarop gender extern wordt gepresenteerd, onder meer door iemands uiterlijk en gedrag."},{"@language":"sv","@value":"Term för hur en person uttrycker sin könsidentitet genom utseende och beteenden, inklusive gester, rörelsemönster, klädstil och kroppsvård."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000560"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000047"},{"@id":"https://homosaurus.org/v5/homoit0000114"},{"@id":"https://homosaurus.org/v5/homoit0000289"},{"@id":"https://homosaurus.org/v5/homoit0000318"},{"@id":"https://homosaurus.org/v5/homoit0000366"},{"@id":"https://homosaurus.org/v5/homoit0000367"},{"@id":"https://homosaurus.org/v5/homoit0000389"},{"@id":"https://homosaurus.org/v5/homoit0000395"},{"@id":"https://homosaurus.org/v5/homoit0000562"},{"@id":"https://homosaurus.org/v5/homoit0000564"},{"@id":"https://homosaurus.org/v5/homoit0000576"},{"@id":"https://homosaurus.org/v5/homoit0000606"},{"@id":"https://homosaurus.org/v5/homoit0000995"},{"@id":"https://homosaurus.org/v5/homoit0001067"},{"@id":"https://homosaurus.org/v5/homoit0001469"},{"@id":"https://homosaurus.org/v5/homoit0001476"},{"@id":"https://homosaurus.org/v5/homoit0001496"},{"@id":"https://homosaurus.org/v5/homoit0001756"},{"@id":"https://homosaurus.org/v5/homoit0001790"},{"@id":"https://homosaurus.org/v5/homoit0001816"},{"@id":"https://homosaurus.org/v5/homoit0001820"},{"@id":"https://homosaurus.org/v5/homoit0001821"},{"@id":"https://homosaurus.org/v5/homoit0001852"},{"@id":"https://homosaurus.org/v5/homoit0001899"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000105"},{"@id":"https://homosaurus.org/v5/homoit0000231"},{"@id":"https://homosaurus.org/v5/homoit0000321"},{"@id":"https://homosaurus.org/v5/homoit0000326"},{"@id":"https://homosaurus.org/v5/homoit0000440"},{"@id":"https://homosaurus.org/v5/homoit0000566"},{"@id":"https://homosaurus.org/v5/homoit0000567"},{"@id":"https://homosaurus.org/v5/homoit0000571"},{"@id":"https://homosaurus.org/v5/homoit0000577"},{"@id":"https://homosaurus.org/v5/homoit0000581"},{"@id":"https://homosaurus.org/v5/homoit0001063"},{"@id":"https://homosaurus.org/v5/homoit0001145"},{"@id":"https://homosaurus.org/v5/homoit0001148"},{"@id":"https://homosaurus.org/v5/homoit0001479"},{"@id":"https://homosaurus.org/v5/homoit0001508"},{"@id":"https://homosaurus.org/v5/homoit0002256"},{"@id":"https://homosaurus.org/v5/homoit0002589"},{"@id":"https://homosaurus.org/v5/homoit0002699"},{"@id":"https://homosaurus.org/v5/homoit0002700"},{"@id":"https://homosaurus.org/v5/homoit0003066"},{"@id":"https://homosaurus.org/v5/homoit0003126"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2011002609"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/genderExpression"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000389","dc:identifier":"homoit0000389","skos:prefLabel":[{"@language":"en","@value":"Femininities"},{"@language":"es","@value":"Feminidades"},{"@language":"de","@value":"Weiblichkeit"},{"@language":"nl","@value":"Femininiteiten"},{"@language":"sv","@value":"Femininitet"}],"skos:altLabel":[{"@language":"en","@value":"Effeminacy"},{"@language":"en","@value":"Femininity"},{"@language":"es","@value":"Feminidad"},{"@language":"de","@value":"Femininität"},{"@language":"nl","@value":"Vrouwelijkheid"}],"rdfs:comment":[{"@language":"en","@value":"Culture-specific sets of attributes, behaviors, and roles generally associated with women or girls."},{"@language":"es","@value":"Conjuntos de atributos, comportamientos y roles específicos de una cultura que se asocian generalmente con las mujeres o las niñas."},{"@language":"de","@value":"Kulturspezifische Merkmale, Verhaltensweisen und Rollen, die im Allgemeinen mit Frauen oder Mädchen assoziiert werden."},{"@language":"nl","@value":"Cultuurspecifieke sets van attributen, gedragingen en rollen die over het algemeen worden geassocieerd met vrouwen of meisjes"},{"@language":"sv","@value":"Kulturspecifika uppsättningar av egenskaper, beteenden och roller som vanligtvis förknippas med kvinnor eller flickor."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000568"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0001821"},{"@id":"https://homosaurus.org/v5/homoit0002043"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000047"},{"@id":"https://homosaurus.org/v5/homoit0000440"},{"@id":"https://homosaurus.org/v5/homoit0000577"},{"@id":"https://homosaurus.org/v5/homoit0000995"},{"@id":"https://homosaurus.org/v5/homoit0001382"}],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85047739"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/femininity"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000562","dc:identifier":"homoit0000562","skos:prefLabel":[{"@language":"en","@value":"Gender bending"},{"@language":"es","@value":"Transgresión de género"},{"@language":"de","@value":"Gender-bending"},{"@language":"nl","@value":"Gender bending"},{"@language":"sv","@value":"Genderbending"}],"skos:altLabel":{"@language":"de","@value":"Gender-Bending"},"rdfs:comment":[{"@language":"en","@value":"The practice of transgressing or \"bending\" expected gender roles, which often involves adopting or exaggerating stereotypically feminine or masculine traits to expose them as artificial. Gender bending is similar to drag, though drag is often associated with artistic or stage performances, whereas gender bending is typically enacted in everyday life."},{"@language":"es","@value":"La práctica de transgredir o \"doblar\" los roles de género esperados, lo que a menudo implica adoptar o exagerar rasgos estereotípicamente femeninos o masculinos para exponerlos como artificiales. La transgresión de género es similar al drag, aunque el drag se asocia, a menudo, con representaciones artísticas o escénicas, mientras que la transgresión de género suele representarse en la vida cotidiana."},{"@language":"de","@value":"Die Praxis, erwartete Geschlechterrollen zu überschreiten oder zu „verbiegen“, was oft mit der Übernahme oder Übertreibung stereotypisch weiblicher oder männlicher Eigenschaften einhergeht, um diese als künstlich zu entlarven. Gender-bending ähnelt Drag, wobei Drag oft mit künstlerischen Auftritten oder Bühnenaufführungen in Verbindung gebracht wird, während Gender-bending typischerweise im Alltag praktiziert wird."},{"@language":"nl","@value":"De praktijk van het overtreden of \"bending\" van verwachte genderrollen, wat vaak inhoudt dat stereotiepe vrouwelijke of mannelijke eigenschappen worden aangenomen of overdreven om ze als kunstmatig te ontmaskeren. Gender bending is vergelijkbaar met drag, hoewel drag vaak wordt geassocieerd met artistieke of toneelvoorstellingen, terwijl gender bending doorgaans in het dagelijks leven plaats vindt."},{"@language":"sv","@value":"Praktiken att bryta mot eller ”böja” förväntade könsroller, ofta genom att anta eller överdriva stereotypiskt feminina eller maskulina drag för att avslöja dessa som sociala konstruktioner. Liknar drag, men drag är ofta förknippat med scenkonst, medan genderbending vanligen förekommer i vardagen."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000568"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000047"},{"@id":"https://homosaurus.org/v5/homoit0000577"},{"@id":"https://homosaurus.org/v5/homoit0001756"},{"@id":"https://homosaurus.org/v5/homoit0001816"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/genderBending"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000577","dc:identifier":"homoit0000577","skos:prefLabel":[{"@language":"en","@value":"Gender roles"},{"@language":"es","@value":"Roles de género"},{"@language":"fr","@value":"Rôles de genre"},{"@language":"nl","@value":"Genderrollen"},{"@language":"sv","@value":"Könsroller"}],"skos:altLabel":[{"@language":"es","@value":"Papeles de género"},{"@language":"fr","@value":"Rôles genrés"}],"rdfs:comment":[{"@language":"en","@value":"Socially-determined rules or standards for gendered behaviors. Some LGBTQ+ people identify with gender roles that exist outside of the gender binary (e.g., butches, femmes, twinks, bears). Use the term \"Gender role stereotypes\" to describe widely held but oversimplified or offensive ideas regarding gender roles."},{"@language":"es","@value":"Reglas o estándares socialmente determinados para los comportamientos de género. Algunas personas LGBTQ+ se identifican con roles de género que existen fuera del binario de género (por ejemplo, marimachas, femmes, twinks, osos). Utilícese el término \"Estereotipos de roles de género\" para describir ideas generalizadas pero demasiado simplificadas u ofensivas sobre los roles de género."},{"@language":"fr","@value":"Ensemble des comportements, des attitudes, des occupations et des intérêts légitimes ou attendus, que les normes culturelles prévalant dans une société déterminent comme étant appropriés à un genre. Certaines personnes LGBTQ+ s'identifient à des rôles de genre qui existent en dehors du système binaire du genre."},{"@language":"nl","@value":"Sociaal bepaalde regels of normen voor verwacht gendergerelateerd gedrag."},{"@language":"sv","@value":"Socialt definierade regler eller normer för könskodade beteenden. Vissa hbtq+-personer identifierar sig med könsroller som ligger utanför könsbinariteten (t.ex. butch, femme, twink, björn). Använd termen ”Stereotypa könsroller” för att beskriva allmänt spridda men förenklade eller kränkande föreställningar om könsroller."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001241"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000105"},{"@id":"https://homosaurus.org/v5/homoit0000231"},{"@id":"https://homosaurus.org/v5/homoit0000321"},{"@id":"https://homosaurus.org/v5/homoit0000326"},{"@id":"https://homosaurus.org/v5/homoit0000440"},{"@id":"https://homosaurus.org/v5/homoit0000655"},{"@id":"https://homosaurus.org/v5/homoit0001063"},{"@id":"https://homosaurus.org/v5/homoit0001313"},{"@id":"https://homosaurus.org/v5/homoit0001374"},{"@id":"https://homosaurus.org/v5/homoit0001479"},{"@id":"https://homosaurus.org/v5/homoit0001508"},{"@id":"https://homosaurus.org/v5/homoit0002589"},{"@id":"https://homosaurus.org/v5/homoit0003506"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000047"},{"@id":"https://homosaurus.org/v5/homoit0000389"},{"@id":"https://homosaurus.org/v5/homoit0000562"},{"@id":"https://homosaurus.org/v5/homoit0000563"},{"@id":"https://homosaurus.org/v5/homoit0000568"},{"@id":"https://homosaurus.org/v5/homoit0000571"},{"@id":"https://homosaurus.org/v5/homoit0000575"},{"@id":"https://homosaurus.org/v5/homoit0000576"},{"@id":"https://homosaurus.org/v5/homoit0000995"},{"@id":"https://homosaurus.org/v5/homoit0001756"},{"@id":"https://homosaurus.org/v5/homoit0001816"},{"@id":"https://homosaurus.org/v5/homoit0001817"},{"@id":"https://homosaurus.org/v5/homoit0001899"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85120663"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001241"},"dc:replaces":{"@id":"http://homosaurus.org/v2/genderRoles"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000995","dc:identifier":"homoit0000995","skos:prefLabel":[{"@language":"en","@value":"Masculinities"},{"@language":"es","@value":"Masculinidades"},{"@language":"fr","@value":"Masculinités"},{"@language":"nl","@value":"Masculiniteiten"},{"@language":"sv","@value":"Maskulinitet"}],"skos:altLabel":[{"@language":"en","@value":"Masculinity"},{"@language":"es","@value":"Masculinidad"}],"rdfs:comment":[{"@language":"en","@value":"Culture-specific sets of attributes, behaviors, and roles generally associated with men or boys."},{"@language":"es","@value":"Conjuntos de atributos, comportamientos y roles específicos de una cultura generalmente asociados con hombres o niños."},{"@language":"fr","@value":"Ensemble d'attributs, de comportements et de rôles propres à une culture et généralement associés aux hommes ou aux garçons au sein d'une société."},{"@language":"nl","@value":"Cultuurspecifieke sets van attributen, gedragingen en rollen die over het algemeen worden geassocieerd met mannen of jongens"},{"@language":"sv","@value":"Kulturspecifika attribut, beteenden och roller som i allmänhet förknippas med män eller pojkar."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000568"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000432"},{"@id":"https://homosaurus.org/v5/homoit0001377"},{"@id":"https://homosaurus.org/v5/homoit0001820"},{"@id":"https://homosaurus.org/v5/homoit0002061"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000047"},{"@id":"https://homosaurus.org/v5/homoit0000231"},{"@id":"https://homosaurus.org/v5/homoit0000389"},{"@id":"https://homosaurus.org/v5/homoit0000577"},{"@id":"https://homosaurus.org/v5/homoit0000655"},{"@id":"https://homosaurus.org/v5/homoit0000978"},{"@id":"https://homosaurus.org/v5/homoit0001466"},{"@id":"https://homosaurus.org/v5/homoit0001508"}],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85081797"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/masculinity"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001756","dc:identifier":"homoit0001756","skos:prefLabel":[{"@language":"en","@value":"Gender creative"},{"@language":"es","@value":"Género creativo"},{"@language":"fr","@value":"Genre créatif"},{"@language":"nl","@value":"Gender creatief"},{"@language":"sv","@value":"Könskreativitet"}],"skos:altLabel":[{"@language":"fr","@value":"Créativité de genre"},{"@language":"fr","@value":"Au genre créatif"},{"@language":"fr","@value":"Au genre non conforme"},{"@language":"fr","@value":"Jeunes identités créatives"},{"@language":"fr","@value":"Créatif de genre"},{"@language":"fr","@value":"Créative de genre"}],"rdfs:comment":[{"@language":"en","@value":"Term used to describe people, typically children, who do not conform to traditional gender norms and instead creatively interweave their internal and external experiences to understand their gender identity and expression. May also be used to describe a way of raising children outside of traditional gender norms."},{"@language":"es","@value":"Término utilizado para describir a personas, generalmente niños, que no se ajustan a las normas de género tradicionales y, en cambio, entrelazan creativamente sus experiencias internas y externas para comprender su identidad y expresión de género. También puede utilizarse para describir una forma de criar a los niños fuera de las normas tradicionales de género."},{"@language":"fr","@value":"Personnes, généralement des enfants, qui ne se conforment pas aux normes binaires de genre et qui, au contraire, entrecroisent de manière créative leurs expériences internes et externes pour comprendre leur identité et leur expression de genre. Peut également être utilisé pour décrire une façon d'élever les enfants en dehors des normes traditionnelles de genre."},{"@language":"nl","@value":"Term die wordt gebruikt om mensen te beschrijven, meestal kinderen, die niet voldoen aan de traditionele gendernormen en in plaats daarvan op creatieve wijze hun interne en externe ervaringen met elkaar verweven om hun genderidentiteit en -expressie te begrijpen; kan ook worden gebruikt om een manier te beschrijven om kinderen op te voeden buiten de traditionele gendernormen"},{"@language":"sv","@value":"Term som används för att beskriva personer, ofta barn, som inte följer traditionella könsnormer och i stället kreativt väver samman sina inre och yttre erfarenheter för att förstå sin könsidentitet och sitt könsuttryck. Kan också användas för att beskriva ett sätt att uppfostra barn utanför traditionella könsnormer."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000568"},{"@id":"https://homosaurus.org/v5/homoit0000571"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000047"},{"@id":"https://homosaurus.org/v5/homoit0000256"},{"@id":"https://homosaurus.org/v5/homoit0000562"},{"@id":"https://homosaurus.org/v5/homoit0000574"},{"@id":"https://homosaurus.org/v5/homoit0000577"},{"@id":"https://homosaurus.org/v5/homoit0001521"},{"@id":"https://homosaurus.org/v5/homoit0001922"},{"@id":"https://homosaurus.org/v5/homoit0002222"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2021-11-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000048","dc:identifier":"homoit0000048","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ Anglicans"},{"@language":"es","@value":"Anglicanos LGBTQ+"},{"@language":"ja","@value":"LGBTQ+の英国国教会信徒"},{"@language":"nl","@value":"LHBTQ+-anglicanen"},{"@language":"sv","@value":"Anglikaner (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"Anglicans (LGBTQ)"},{"@language":"en","@value":"LGBTQ Church of England"},{"@language":"en","@value":"LGBTQ Episcopalians"},{"@language":"en","@value":"LGBTQ Anglicans"}],"rdfs:comment":[{"@language":"en","@value":"LGBTQ+ people who are Anglican."},{"@language":"en","@value":"英国国教会の信徒であるLGBTQ+の人々。"},{"@language":"es","@value":"Personas LGBTQ+ que son anglicanas."},{"@language":"ja","@value":"英国国教会の信徒であるLGBTQ+の人々。"},{"@language":"nl","@value":"LHBTQ+-personen die Anglicaans zijn"},{"@language":"sv","@value":"Hbtq+-personer som är anglikaner, det vill säga medlemmar i Anglikanska kyrkan, som är statskyrka i Storbritannien."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001137"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000928"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQAnglicans"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001137","dc:identifier":"homoit0001137","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ Protestants"},{"@language":"es","@value":"Protestantes LGBTQ+"},{"@language":"ja","@value":"LGBTQ+のプロテスタント"},{"@language":"nl","@value":"LHBTQ+-protestanten"},{"@language":"sv","@value":"Protestanter (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"Protestants (LGBTQ)"},{"@language":"es","@value":"Protestantes (LGBTQ)"},{"@language":"ja","@value":"プロテスタント（LGBTQ）"}],"rdfs:comment":[{"@language":"en","@value":"LGBTQ+ people who are members of the Protestant Church."},{"@language":"es","@value":"Personas LGBTQ+ que son miembros de la Iglesia protestante."},{"@language":"ja","@value":"プロテスタント教会の信徒であるLGBTQ+の人々。"},{"@language":"nl","@value":"LHBTQ+-personen die lid zijn van een Protestantse Kerk."},{"@language":"sv","@value":"Hbtq+-personer som är medlemmar i protestantiska kyrkor."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000265"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000048"},{"@id":"https://homosaurus.org/v5/homoit0000097"},{"@id":"https://homosaurus.org/v5/homoit0000179"},{"@id":"https://homosaurus.org/v5/homoit0000237"},{"@id":"https://homosaurus.org/v5/homoit0000526"},{"@id":"https://homosaurus.org/v5/homoit0000770"},{"@id":"https://homosaurus.org/v5/homoit0000926"},{"@id":"https://homosaurus.org/v5/homoit0001202"},{"@id":"https://homosaurus.org/v5/homoit0001439"},{"@id":"https://homosaurus.org/v5/homoit0002978"},{"@id":"https://homosaurus.org/v5/homoit0002984"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000928"},"dc:replaces":{"@id":"http://homosaurus.org/v2/protestantsLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000928","dc:identifier":"homoit0000928","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ religious people"},{"@language":"es","@value":"Personas religiosas LGBTQ+"},{"@language":"nl","@value":"LHBTQ+-gelovigen"},{"@language":"sv","@value":"Religiösa hbtq+-personer"}],"skos:altLabel":[{"@language":"en","@value":"LGBTQ+ religions"},{"@language":"es","@value":"Religiones LGBTQ+"},{"@language":"sv","@value":"Troende (hbtq+)"}],"rdfs:comment":[{"@language":"en","@value":"LGBTQ+ people who belong to a religion or hold religious beliefs. For LGBTQ+ people who hold spiritual beliefs or engage in spiritual practices but do not belong to an organized religion, use the term \"LGBTQ+ spiritual people.\""},{"@language":"es","@value":"Personas LGBTQ+ que pertenecen a una religión o tienen creencias religiosas. Para las personas LGBTQ+ que tienen creencias espirituales o sostienen prácticas espirituales pero que no pertenecen a una religión organizada, utilícese el término \"personas espirituales LGBTQ+\"."},{"@language":"nl","@value":"LGBTQ+ mensen die tot een religie behoren of religieuze overtuigingen hebben. Voor LHBTQ+-personen die spirituele overtuigingen hebben of zich bezighouden met spirituele praktijken maar niet tot een georganiseerde religie behoren, gebruik je de term LHBTQ+-spirituele personen."},{"@language":"sv","@value":"Hbtq+-personer som tillhör en religion eller har religiös tro. För hbtq+-personer med andlig övertygelse utan koppling till organiserad religion, använd termen ”Andliga hbtq+-personer”."}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000225"},{"@id":"https://homosaurus.org/v5/homoit0000265"},{"@id":"https://homosaurus.org/v5/homoit0000300"},{"@id":"https://homosaurus.org/v5/homoit0000633"},{"@id":"https://homosaurus.org/v5/homoit0000682"},{"@id":"https://homosaurus.org/v5/homoit0000939"},{"@id":"https://homosaurus.org/v5/homoit0000940"},{"@id":"https://homosaurus.org/v5/homoit0000955"},{"@id":"https://homosaurus.org/v5/homoit0001032"},{"@id":"https://homosaurus.org/v5/homoit0001069"},{"@id":"https://homosaurus.org/v5/homoit0003347"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000082"},{"@id":"https://homosaurus.org/v5/homoit0000948"},{"@id":"https://homosaurus.org/v5/homoit0001218"},{"@id":"https://homosaurus.org/v5/homoit0003609"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000928"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQReligions"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000969","dc:identifier":"homoit0000969","skos:prefLabel":[{"@language":"en","@value":"Licking"},{"@language":"es","@value":"Langüetear"},{"@language":"nl","@value":"Likken"},{"@language":"sv","@value":"Slicksex"}],"skos:altLabel":[{"@language":"es","@value":"Lamer"},{"@language":"es","@value":"Lengüetear"}],"rdfs:comment":[{"@language":"en","@value":"To touch or pass over with the tongue to moisten or taste; use to describe licking associated in the context of sexual practices or sexual arousal. "},{"@language":"es","@value":"Tocar o pasar con la lengua para humedecer o saborear; utilícese para describir el acto de lamer en relación al contexto de prácticas sexuales o de excitación sexual."},{"@language":"nl","@value":"Iets of iemand aanraken met de tong om te bevochtigen of te proeven; gebruiken om acties te beschrijven die verband houden met seksuele praktijken of seksuele opwinding."},{"@language":"sv","@value":"Att röra vid eller föra tungan över något för att fukta eller smaka. Används för att beskriva slickande i samband med sexuella praktiker eller sexuell upphetsning."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000593"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000049"},{"@id":"https://homosaurus.org/v5/homoit0000239"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001267"},"dc:replaces":{"@id":"http://homosaurus.org/v2/licking"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000593","dc:identifier":"homoit0000593","skos:prefLabel":[{"@language":"en","@value":"Oral sex"},{"@language":"es","@value":"Sexo oral"},{"@language":"fr","@value":"Sexe oral"},{"@language":"nl","@value":"Orale seks"},{"@language":"sv","@value":"Oralsex"}],"skos:altLabel":[{"@language":"en","@value":"Giving head"},{"@language":"en","@value":"Going down"},{"@language":"es","@value":"Mamar"},{"@language":"es","@value":"Mamada"},{"@language":"sv","@value":"Munsex"}],"rdfs:comment":[{"@language":"en","@value":"Sexual activities performed using the mouth."},{"@language":"es","@value":"Actividades sexuales realizadas utilizando la boca."},{"@language":"fr","@value":"Activités sexuelles pratiquées avec la bouche."},{"@language":"nl","@value":"Seksuele activiteiten uitgevoerd met de mond."},{"@language":"sv","@value":"Sexuella aktiviteter som utförs med munnen."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001267"},{"@id":"https://homosaurus.org/v5/homoit0001299"}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000212"},{"@id":"https://homosaurus.org/v5/homoit0000239"},{"@id":"https://homosaurus.org/v5/homoit0000691"},{"@id":"https://homosaurus.org/v5/homoit0000969"},{"@id":"https://homosaurus.org/v5/homoit0002578"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000049"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85095239"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001267"},"dc:replaces":{"@id":"http://homosaurus.org/v2/oralSex"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000050","dc:identifier":"homoit0000050","skos:prefLabel":[{"@language":"en","@value":"Anonymous sex"},{"@language":"es","@value":"Sexo anónimo"},{"@language":"de","@value":"Anonymer Sex"},{"@language":"nl","@value":"Anonieme seks"},{"@language":"sv","@value":"Anonymt sex"}],"rdfs:comment":[{"@language":"en","@value":"Sexual encounters between two or more people who do not know one another, typically with no expectation of future communication or interaction."},{"@language":"es","@value":"Encuentros sexuales entre dos o más personas que no se conocen, generalmente sin expectativas de comunicación o interacción futura."},{"@language":"de","@value":"Sexuelle Begegnungen zwischen zwei oder mehreren Personen, die sich nicht kennen, in der Regel ohne die Erwartung einer zukünftigen Kommunikation oder Interaktion."},{"@language":"nl","@value":"Seksuele ontmoetingen tussen twee of meer personen die elkaar niet kennen, meestal zonder verwachting van toekomstige communicatie of interactie."},{"@language":"sv","@value":"Sexuella möten mellan två eller fler personer som inte känner varandra, vanligtvis utan förväntan om framtida kontakt eller interaktion."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001299"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000242"},{"@id":"https://homosaurus.org/v5/homoit0000309"},{"@id":"https://homosaurus.org/v5/homoit0000319"},{"@id":"https://homosaurus.org/v5/homoit0000974"},{"@id":"https://homosaurus.org/v5/homoit0001302"},{"@id":"https://homosaurus.org/v5/homoit0001306"},{"@id":"https://homosaurus.org/v5/homoit0001357"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001299"},"dc:replaces":{"@id":"http://homosaurus.org/v2/anonymousSex"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000242","dc:identifier":"homoit0000242","skos:prefLabel":[{"@language":"en","@value":"Casual sex"},{"@language":"es","@value":"Sexo casual"},{"@language":"de","@value":"Gelegenheitssex"},{"@language":"nl","@value":"Wisselende seksuele contacten"},{"@language":"sv","@value":"Tillfälligt sex"}],"skos:altLabel":[{"@language":"en","@value":"Promiscuity"},{"@language":"es","@value":"Promiscuidad"},{"@language":"de","@value":"Zwangloser Sex"},{"@language":"de","@value":"Ungezwungener Sex"},{"@language":"de","@value":"Beiläufiger Sex"}],"rdfs:comment":[{"@language":"en","@value":"Intermittent or isolated sexual encounters between two or more people, typically occurring outside of romantic relationships or other forms of commitment, emotional attachment, or familiarity."},{"@language":"es","@value":"Encuentros sexuales intermitentes o aislados entre dos o más personas, que generalmente ocurren fuera de relaciones románticas u otras formas de compromiso, apego emocional o familiaridad."},{"@language":"de","@value":"Gelegentliche oder einmalige sexuelle Begegnungen zwischen zwei oder mehreren Personen, die in der Regel außerhalb von romantischen Beziehungen oder anderen Formen der Beziehung, emotionalen Bindung oder Vertrautheit stattfinden."},{"@language":"nl","@value":"Onregelmatige of geïsoleerde seksuele ontmoetingen tussen twee of meer personen, meestal buiten romantische relaties of andere vormen van verbintenis, emotionele gehechtheid of vertrouwdheid."},{"@language":"sv","@value":"Tillfälliga eller enstaka sexuella möten mellan två eller flera personer, vanligtvis utanför romantiska relationer och andra former av känslomässig anknytning."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001299"},{"@id":"https://homosaurus.org/v5/homoit0001302"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000050"},{"@id":"https://homosaurus.org/v5/homoit0000319"},{"@id":"https://homosaurus.org/v5/homoit0000603"},{"@id":"https://homosaurus.org/v5/homoit0001272"},{"@id":"https://homosaurus.org/v5/homoit0001300"},{"@id":"https://homosaurus.org/v5/homoit0001306"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001299"},"dc:replaces":{"@id":"http://homosaurus.org/v2/casualSex"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000309","dc:identifier":"homoit0000309","skos:prefLabel":[{"@language":"en","@value":"Cottaging (Gay culture)"},{"@language":"es","@value":"Cottaging (Cultura gay)"},{"@language":"de","@value":"Cottaging (schwule Kontext)"},{"@language":"nl","@value":"Pisbaklopen"},{"@language":"sv","@value":"Cottaging (bögkultur)"}],"skos:altLabel":[{"@language":"en","@value":"Cottaging"},{"@language":"es","@value":"Cottaging"}],"rdfs:comment":[{"@language":"en","@value":"UK slang term commonly used in gay communities to describe the practice of engaging in anonymous sex in a public bathroom or cruising for sexual partners there. "},{"@language":"es","@value":"Término de la jerga británica comúnmente utilizado en las comunidades gay para describir la práctica de tener relaciones sexuales anónimas en un baño público o buscar parejas sexuales allí."},{"@language":"de","@value":"Britischer Slangbegriff in der Schwulenszene, um die Praxis des anonymen Sex in öffentlichen Toiletten oder die Suche nach Sexualpartnern dort zu beschreiben."},{"@language":"sv","@value":"Brittisk slangterm som ofta används i böggemenskaper för att beskriva anonyma sexuella möten på offentliga toaletter eller cruising efter sexpartners där."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001267"},{"@id":"https://homosaurus.org/v5/homoit0001299"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000050"},{"@id":"https://homosaurus.org/v5/homoit0000308"},{"@id":"https://homosaurus.org/v5/homoit0000319"},{"@id":"https://homosaurus.org/v5/homoit0001142"},{"@id":"https://homosaurus.org/v5/homoit0001357"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001267"},"dc:replaces":{"@id":"http://homosaurus.org/v2/cottaging"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000319","dc:identifier":"homoit0000319","skos:prefLabel":[{"@language":"en","@value":"Cruising (LGBTQ+ culture)"},{"@language":"es","@value":"Cruising (Cultura LGBTQ+)"},{"@language":"de","@value":"Cruising"},{"@language":"nl","@value":"Cruising"},{"@language":"sv","@value":"Cruising (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"Cruising"},{"@language":"es","@value":"Cancaneo"},{"@language":"sv","@value":"Parkraggande"},{"@language":"sv","@value":"Parkraggning"}],"rdfs:comment":[{"@language":"en","@value":"Walking or driving about a locality in search of a sex partner, typically to engage in casual sex."},{"@language":"es","@value":"Caminar o conducir por una localidad en busca de una pareja sexual, generalmente para tener relaciones sexuales casuales."},{"@language":"de","@value":"Durch eine Gegend zu Fuß gehen oder mit dem Auto fahren, um einen Sexualpartner zu suchen, in der Regel für Gelegenheitssex."},{"@language":"sv","@value":"Att gå eller köra runt i ett område i sökandet efter en sexpartner, vanligtvis för att ha tillfälligt sex."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001267"},{"@id":"https://homosaurus.org/v5/homoit0001299"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000050"},{"@id":"https://homosaurus.org/v5/homoit0000242"},{"@id":"https://homosaurus.org/v5/homoit0000309"},{"@id":"https://homosaurus.org/v5/homoit0000900"},{"@id":"https://homosaurus.org/v5/homoit0001142"},{"@id":"https://homosaurus.org/v5/homoit0001357"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2008000915"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001267"},"dc:replaces":{"@id":"http://homosaurus.org/v2/cruising"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000974","dc:identifier":"homoit0000974","skos:prefLabel":[{"@language":"en","@value":"Sex locations"},{"@language":"es","@value":"Lugares de sexo"},{"@language":"nl","@value":"Sekslocaties"},{"@language":"sv","@value":"Sexställen"}],"skos:altLabel":[{"@language":"en","@value":"Locations for sex"},{"@language":"es","@value":"Ubicaciones para sexo"},{"@language":"es","@value":"Locaciones para sexo"},{"@language":"sv","@value":"Sexplatser"}],"rdfs:comment":[{"@language":"en","@value":"Places where people engage in sexual activities, including private and public spaces."},{"@language":"es","@value":"Lugares donde las personas participan en actividades sexuales, incluidos espacios públicos y privados."},{"@language":"nl","@value":"Plaatsen waar mensen seksuele activiteiten ontplooien, inclusief privé- en openbare ruimtes."},{"@language":"sv","@value":"Platser där människor har sex, både privata och offentliga utrymmen."}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000087"},{"@id":"https://homosaurus.org/v5/homoit0000308"},{"@id":"https://homosaurus.org/v5/homoit0000475"},{"@id":"https://homosaurus.org/v5/homoit0001272"},{"@id":"https://homosaurus.org/v5/homoit0001358"},{"@id":"https://homosaurus.org/v5/homoit0003079"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000050"},{"@id":"https://homosaurus.org/v5/homoit0000900"},{"@id":"https://homosaurus.org/v5/homoit0001142"},{"@id":"https://homosaurus.org/v5/homoit0001267"},{"@id":"https://homosaurus.org/v5/homoit0001306"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000974"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sexLocations"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001302","dc:identifier":"homoit0001302","skos:prefLabel":[{"@language":"en","@value":"Sexual relationships"},{"@language":"es","@value":"Relaciones sexuales"},{"@language":"nl","@value":"Seksuele relaties"},{"@language":"sv","@value":"Sexuella relationer"}],"rdfs:comment":[{"@language":"en","@value":"Ongoing connections between two or more individuals involving sexual behaviors or activities."},{"@language":"es","@value":"Conexiones continuas entre dos o más personas que involucran comportamientos o actividades sexuales."},{"@language":"nl","@value":"Voortdurende banden tussen twee of meer personen met betrekking tot seksueel gedrag of seksuele activiteiten."},{"@language":"sv","@value":"Pågående relationer, som involverar sexuella handlingar, mellan två eller flera personer."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001237"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000242"},{"@id":"https://homosaurus.org/v5/homoit0000976"},{"@id":"https://homosaurus.org/v5/homoit0001019"},{"@id":"https://homosaurus.org/v5/homoit0001124"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000050"},{"@id":"https://homosaurus.org/v5/homoit0000344"},{"@id":"https://homosaurus.org/v5/homoit0000458"},{"@id":"https://homosaurus.org/v5/homoit0000895"},{"@id":"https://homosaurus.org/v5/homoit0001080"},{"@id":"https://homosaurus.org/v5/homoit0001081"},{"@id":"https://homosaurus.org/v5/homoit0001300"},{"@id":"https://homosaurus.org/v5/homoit0001632"},{"@id":"https://homosaurus.org/v5/homoit0001633"},{"@id":"https://homosaurus.org/v5/homoit0001636"},{"@id":"https://homosaurus.org/v5/homoit0001916"},{"@id":"https://homosaurus.org/v5/homoit0001917"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001237"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sexualRelationships"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001306","dc:identifier":"homoit0001306","skos:prefLabel":[{"@language":"en","@value":"Sexuality"},{"@language":"es","@value":"Sexualidad"},{"@language":"nl","@value":"Seksualiteit"},{"@language":"sv","@value":"Sexualitet"}],"rdfs:comment":[{"@language":"en","@value":"Term used to describe the ways in which individuals experience and express themselves sexually, including the types of people and practices they are sexually interested in."},{"@language":"es","@value":"Término utilizado para describir las formas en que las personas experimentan y se expresan sexualmente, incluidos los tipos de personas y prácticas que les interesan sexualmente."},{"@language":"nl","@value":"De manier waarop individuen zichzelf seksueel ervaren en uiten, inclusief in welke personen en praktijken ze seksueel geïnteresseerd zijn."},{"@language":"sv","@value":"Term som beskriver hur individer upplever och uttrycker sin sexualitet inklusive vilka typer av personer och praktiker de är sexuellt intresserade av."}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000263"},{"@id":"https://homosaurus.org/v5/homoit0001061"},{"@id":"https://homosaurus.org/v5/homoit0003613"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000050"},{"@id":"https://homosaurus.org/v5/homoit0000242"},{"@id":"https://homosaurus.org/v5/homoit0000325"},{"@id":"https://homosaurus.org/v5/homoit0000404"},{"@id":"https://homosaurus.org/v5/homoit0000579"},{"@id":"https://homosaurus.org/v5/homoit0000603"},{"@id":"https://homosaurus.org/v5/homoit0000656"},{"@id":"https://homosaurus.org/v5/homoit0000967"},{"@id":"https://homosaurus.org/v5/homoit0000974"},{"@id":"https://homosaurus.org/v5/homoit0001142"},{"@id":"https://homosaurus.org/v5/homoit0001262"},{"@id":"https://homosaurus.org/v5/homoit0001266"},{"@id":"https://homosaurus.org/v5/homoit0001267"},{"@id":"https://homosaurus.org/v5/homoit0001272"},{"@id":"https://homosaurus.org/v5/homoit0001280"},{"@id":"https://homosaurus.org/v5/homoit0001281"},{"@id":"https://homosaurus.org/v5/homoit0001282"},{"@id":"https://homosaurus.org/v5/homoit0001284"},{"@id":"https://homosaurus.org/v5/homoit0001286"},{"@id":"https://homosaurus.org/v5/homoit0001291"},{"@id":"https://homosaurus.org/v5/homoit0001292"},{"@id":"https://homosaurus.org/v5/homoit0001297"},{"@id":"https://homosaurus.org/v5/homoit0001299"},{"@id":"https://homosaurus.org/v5/homoit0001301"},{"@id":"https://homosaurus.org/v5/homoit0001304"},{"@id":"https://homosaurus.org/v5/homoit0001315"},{"@id":"https://homosaurus.org/v5/homoit0001806"},{"@id":"https://homosaurus.org/v5/homoit0001901"},{"@id":"https://homosaurus.org/v5/homoit0003738"},{"@id":"https://homosaurus.org/v5/homoit0004234"}],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85120549"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001306"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sexuality"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001357","dc:identifier":"homoit0001357","skos:prefLabel":[{"@language":"en","@value":"Tearoom sex"},{"@language":"es","@value":"Tearoom sex"},{"@language":"nl","@value":"Pisbakseks"},{"@language":"sv","@value":"Sex på offentliga toaletter"}],"rdfs:comment":[{"@language":"en","@value":"U.S. slang term that refers to anonymous sex in a public bathroom or the practice of cruising for sexual partners in public bathrooms."},{"@language":"es","@value":"Término de la jerga estadounidense que se refiere al sexo anónimo en un baño público o la práctica de buscar parejas sexuales en baños públicos."},{"@language":"sv","@value":"Praktiken att ha sex på offentliga toaletter eller att söka sexuella partners i sådana miljöer."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001299"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000050"},{"@id":"https://homosaurus.org/v5/homoit0000309"},{"@id":"https://homosaurus.org/v5/homoit0000319"},{"@id":"https://homosaurus.org/v5/homoit0001142"},{"@id":"https://homosaurus.org/v5/homoit0001358"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2008001734"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001299"},"dc:replaces":{"@id":"http://homosaurus.org/v2/tearoomSex"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000051","dc:identifier":"homoit0000051","skos:prefLabel":[{"@language":"en","@value":"Anti-bisexual discrimination"},{"@language":"es","@value":"Discriminación anti-bisexual"},{"@language":"de","@value":"Diskriminierung von bisexuellen Personen"},{"@language":"nl","@value":"Anti-biseksuele discriminatie"},{"@language":"sv","@value":"Diskriminering av bisexuella"}],"skos:altLabel":[{"@language":"de","@value":"Antibisexuelle Diskriminierung"},{"@language":"de","@value":"Anti-bisexuelle Diskriminierung"}],"rdfs:comment":[{"@language":"en","@value":"The unjust or prejudicial treatment of bisexual people due to their sexual identity; may include the denial of legal rights, employment, and housing."},{"@language":"es","@value":"El trato injusto o perjudicial hacia personas bisexuales por su identidad sexual; puede incluir la negación de derechos legales, empleo y vivienda."},{"@language":"de","@value":"Die ungerechte oder vorurteilsbehaftete Behandlung bisexueller Menschen aufgrund ihrer sexuellen Identität; kann die Verweigerung von gesetzlichen Rechten, Beschäftigung und Wohnraum beinhalten."},{"@language":"nl","@value":"De onrechtvaardige of nadelige behandeling op basis van vooroordelen van biseksuele personen vanwege hun seksuele identiteit; kan de ontkenning van wettelijke rechten, werkgelegenheid en huisvesting omvatten."},{"@language":"sv","@value":"Systematiskt orättvist eller fördomsfull behandling av bisexuella personer på grund av deras identitet, uttryck eller tillhörighet, vilket kan ta sig uttryck i begränsad tillgång till arbete, bostad eller rättsligt erkännande."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000356"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000117"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000356"},"dc:replaces":{"@id":"http://homosaurus.org/v2/antiBisexualDiscrimination"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000356","dc:identifier":"homoit0000356","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ discrimination"},{"@language":"es","@value":"Discriminación LGBTQ+"},{"@language":"ja","@value":"LGBTQ+への差別"},{"@language":"nl","@value":"LHBTQ+-discriminatie"},{"@language":"sv","@value":"Diskriminering av hbtq+-personer"}],"skos:altLabel":[{"@language":"en","@value":"Discrimination (LGBTQ)"},{"@language":"es","@value":"Discriminación (LGBTQ)"},{"@language":"ja","@value":"差別（LGBTQ）"}],"rdfs:comment":[{"@language":"en","@value":"The unjust or prejudicial treatment of LGBTQ+ people or communities due to their sexual or gender identities; may include the denial of legal rights, employment, and housing."},{"@language":"es","@value":"El trato injusto o perjudicial hacia personas o comunidades LGBTQ+ debido a sus identidades sexuales o de género; puede incluir la negación de derechos legales, empleo y vivienda."},{"@language":"ja","@value":"性的指向や性自認を理由とした、LGBTQ+の人々やコミュニティに対する不当または偏見に基づく扱い。これには、法的権利の剥奪、雇用や住居の機会の拒否などが含まれる。"},{"@language":"nl","@value":"De onrechtvaardige of nadelige behandeling op basis van vooroordelen van LHBTQ+-personen of -gemeenschappen vanwege hun seksuele of genderidentiteit; kan de ontkenning van wettelijke rechten, werkgelegenheid en huisvesting omvatten."},{"@language":"sv","@value":"Systematiskt orättvist eller fördomsfull behandling av hbtq+-personer på grund av deras identitet, uttryck eller tillhörighet, vilket kan ta sig uttryck i begränsad tillgång till arbete, bostad eller rättsligt erkännande."}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000051"},{"@id":"https://homosaurus.org/v5/homoit0000055"},{"@id":"https://homosaurus.org/v5/homoit0000057"},{"@id":"https://homosaurus.org/v5/homoit0000060"},{"@id":"https://homosaurus.org/v5/homoit0000062"},{"@id":"https://homosaurus.org/v5/homoit0001885"},{"@id":"https://homosaurus.org/v5/homoit0001893"},{"@id":"https://homosaurus.org/v5/homoit0002899"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000053"},{"@id":"https://homosaurus.org/v5/homoit0000112"},{"@id":"https://homosaurus.org/v5/homoit0000611"},{"@id":"https://homosaurus.org/v5/homoit0000701"},{"@id":"https://homosaurus.org/v5/homoit0001108"},{"@id":"https://homosaurus.org/v5/homoit0001532"},{"@id":"https://homosaurus.org/v5/homoit0001535"},{"@id":"https://homosaurus.org/v5/homoit0001555"},{"@id":"https://homosaurus.org/v5/homoit0001560"},{"@id":"https://homosaurus.org/v5/homoit0001561"},{"@id":"https://homosaurus.org/v5/homoit0002379"},{"@id":"https://homosaurus.org/v5/homoit0003691"},{"@id":"https://homosaurus.org/v5/homoit0004332"},{"@id":"https://homosaurus.org/v5/homoit0004335"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000356"},"dc:replaces":{"@id":"http://homosaurus.org/v2/discriminationLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000117","dc:identifier":"homoit0000117","skos:prefLabel":[{"@language":"en","@value":"Biphobia"},{"@language":"es","@value":"Bifobia"},{"@language":"de","@value":"Biphobie"},{"@language":"fr","@value":"Biphobie"},{"@language":"nl","@value":"Bifobie"},{"@language":"sv","@value":"Bifobi"}],"skos:altLabel":{"@language":"de","@value":"Bifeindlichkeit"},"rdfs:comment":[{"@language":"en","@value":"Antagonism or disgust directed toward bisexuality as an identity or bisexual people due to their sexuality. Biphobia can include denial of the existence of bisexuality, stereotypes, verbal harassment, and physical violence."},{"@language":"es","@value":"Antagonismo o repugnancia dirigida hacia la bisexualidad como identidad o hacia las personas bisexuales por su sexualidad. La bifobia puede incluir la negación de la existencia de la bisexualidad, los estereotipos, el acoso verbal y la violencia física."},{"@language":"de","@value":"Feindseligkeit oder Abscheu gegenüber Bisexualität als Identität oder gegenüber bisexuellen Personen aufgrund ihrer Sexualität. Biphobie kann die Leugnung der Existenz von Bisexualität, Stereotypen, verbale Belästigung und körperliche Gewalt umfassen."},{"@language":"fr","@value":"Antagonisme ou dégoût à l'égard de la bisexualité en tant qu'identité ou des personnes bisexuelles en raison de leur sexualité. La biphobie peut inclure le déni de l'existence de la bisexualité, les stéréotypes, le harcèlement et la violence physique."},{"@language":"nl","@value":"Antagonisme of afkeer gericht tegen biseksualiteit als identiteit of biseksuele mensen vanwege hun seksualiteit. Bifobie kan bestaan uit ontkenning van het bestaan van biseksualiteit, stereotypen, verbale intimidatie en fysiek geweld."},{"@language":"sv","@value":"Fientlighet eller avsmak riktad mot bisexualitet som identitet eller mot bisexuella personer på grund av deras sexualitet. Bifobi kan innefatta förnekelse av bisexualitetens existens, stereotyper, verbala trakasserier och fysiskt våld."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000920"},"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0002592"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000051"},{"@id":"https://homosaurus.org/v5/homoit0000052"},{"@id":"https://homosaurus.org/v5/homoit0000170"},{"@id":"https://homosaurus.org/v5/homoit0000619"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2012001037"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000920"},"dc:replaces":{"@id":"http://homosaurus.org/v2/biphobia"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000052","dc:identifier":"homoit0000052","skos:prefLabel":[{"@language":"en","@value":"Anti-bisexual violence"},{"@language":"es","@value":"Violencia anti-bisexual"},{"@language":"de","@value":"Gewalt gegen bisexuelle Personen"},{"@language":"nl","@value":"Anti-biseksueel geweld"},{"@language":"sv","@value":"Våld mot bisexuella"}],"skos:altLabel":[{"@language":"de","@value":"Antibisexuelle Gewalt"},{"@language":"de","@value":"Anti-bisexuelle Gewalt"}],"rdfs:comment":[{"@language":"en","@value":"Behavior involving physical force intended to harm or kill bisexual people on the basis of their identity. "},{"@language":"es","@value":"Comportamiento que involucra fuerza física destinada a hacer daño o a matar a personas bisexuales por su identidad."},{"@language":"de","@value":"Verhalten, das körperliche Gewalt beinhaltet und darauf abzielt, bisexuelle Menschen aufgrund ihrer Identität zu verletzen oder zu töten."},{"@language":"nl","@value":"Gedrag met fysiek geweld bedoeld om biseksuele personen te verwonden of te doden vanwege hun identiteit."},{"@language":"sv","@value":"Beteenden som innefattar fysiskt våld avsett att skada eller döda bisexuella personer på grund av deras identitet."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000059"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000109"},{"@id":"https://homosaurus.org/v5/homoit0000117"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000059"},"dc:replaces":{"@id":"http://homosaurus.org/v2/antiBisexualViolence"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000059","dc:identifier":"homoit0000059","skos:prefLabel":[{"@language":"en","@value":"Anti-LGBTQ+ violence"},{"@language":"es","@value":"Violencia anti-LGBTQ+"},{"@language":"de","@value":"Gewalt gegen LGBTQ+-Personen"},{"@language":"nl","@value":"Anti-LHBTQ+-geweld"},{"@language":"sv","@value":"Våld mot hbtq+-personer"}],"skos:altLabel":[{"@language":"en","@value":"Anti-LGBTQ violence"},{"@language":"es","@value":"Violencia anti-LGBTQ"},{"@language":"de","@value":"Anti-LGBTQ+ Gewalt"}],"rdfs:comment":[{"@language":"en","@value":"Behavior involving physical force intended to harm or kill LGBTQ+ people on the basis of their identity. "},{"@language":"es","@value":"Comportamiento que involucra fuerza física destinada a hacer daño o a matar a personas LGBTQ+ en base a su identidad."},{"@language":"de","@value":"Verhalten, das körperliche Gewalt beinhaltet und darauf abzielt, LQBTQ+-Menschen aufgrund ihrer Identität zu schädigen oder zu töten."},{"@language":"nl","@value":"Gedrag met fysiek geweld bedoeld om LHBTQ+-personen te verwonden of te doden vanwege hun identiteit."},{"@language":"sv","@value":"Beteenden som innefattar fysiskt våld avsett att skada eller döda hbtq+-personer på grund av deras identitet."}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000052"},{"@id":"https://homosaurus.org/v5/homoit0000056"},{"@id":"https://homosaurus.org/v5/homoit0000058"},{"@id":"https://homosaurus.org/v5/homoit0000061"},{"@id":"https://homosaurus.org/v5/homoit0000063"},{"@id":"https://homosaurus.org/v5/homoit0000641"},{"@id":"https://homosaurus.org/v5/homoit0000855"},{"@id":"https://homosaurus.org/v5/homoit0001769"},{"@id":"https://homosaurus.org/v5/homoit0001770"},{"@id":"https://homosaurus.org/v5/homoit0002378"},{"@id":"https://homosaurus.org/v5/homoit0002900"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000613"},{"@id":"https://homosaurus.org/v5/homoit0000958"},{"@id":"https://homosaurus.org/v5/homoit0000959"},{"@id":"https://homosaurus.org/v5/homoit0001108"},{"@id":"https://homosaurus.org/v5/homoit0001293"},{"@id":"https://homosaurus.org/v5/homoit0001305"},{"@id":"https://homosaurus.org/v5/homoit0001348"}],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh88006552"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000059"},"dc:replaces":{"@id":"http://homosaurus.org/v2/antiLGBTQViolence"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000109","dc:identifier":"homoit0000109","skos:prefLabel":[{"@language":"en","@value":"Hate crimes"},{"@language":"es","@value":"Crímenes de odio"},{"@language":"de","@value":"Hassverbrechen"},{"@language":"nl","@value":"Haatmisdrijven"},{"@language":"sv","@value":"Hatbrott"}],"skos:altLabel":[{"@language":"en","@value":"Bias-related crimes"},{"@language":"de","@value":"Hasskriminalität"}],"rdfs:comment":[{"@language":"en","@value":"Criminal acts motivated by the victim’s actual or perceived race, nationality, religion, sexual identity, gender identity, or ability status."},{"@language":"es","@value":"Actos delictivos motivados por la raza, nacionalidad, religión, identidad sexual, identidad de género o estado de capacidad real o percibido de la víctima."},{"@language":"de","@value":"Straftaten, deren Motiv die (vermeintliche) ethnische Zugehörigkeit, Nationalität, Religion, sexuelle Identität, Geschlechtsidentität oder Behinderung des Opfers ist."},{"@language":"nl","@value":"Criminele handelingen of pogingen tot criminele handelingen gemotiveerd door of gebaseerd op het werkelijke of vermeende ras, nationaliteit, religie, seksuele identiteit, genderidentiteit of handicap van het slachtoffer."},{"@language":"sv","@value":"Brott som begås med motiv kopplat till offrets faktiska eller uppfattade ras, nationalitet, religion, sexuella identitet, könsidentitet eller funktionsnivå."}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000052"},{"@id":"https://homosaurus.org/v5/homoit0000056"},{"@id":"https://homosaurus.org/v5/homoit0000058"},{"@id":"https://homosaurus.org/v5/homoit0000061"},{"@id":"https://homosaurus.org/v5/homoit0000063"},{"@id":"https://homosaurus.org/v5/homoit0000112"},{"@id":"https://homosaurus.org/v5/homoit0000341"},{"@id":"https://homosaurus.org/v5/homoit0000613"},{"@id":"https://homosaurus.org/v5/homoit0000641"},{"@id":"https://homosaurus.org/v5/homoit0001769"},{"@id":"https://homosaurus.org/v5/homoit0001770"},{"@id":"https://homosaurus.org/v5/homoit0002900"},{"@id":"https://homosaurus.org/v5/homoit0003787"},{"@id":"https://homosaurus.org/v5/homoit0003788"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh90002645"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000109"},"dc:replaces":{"@id":"http://homosaurus.org/v2/hateCrimes"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000053","dc:identifier":"homoit0000053","skos:prefLabel":[{"@language":"en","@value":"Anti-discrimination law"},{"@language":"es","@value":"Leyes anti-discriminación"},{"@language":"de","@value":"Antidiskriminierungsgesetz"},{"@language":"nl","@value":"Anti-discriminatiewetgeving"},{"@language":"sv","@value":"Diskrimineringslagstiftning"}],"rdfs:comment":[{"@language":"en","@value":"Legislation designed to prevent employment, housing, education, and other forms of discrimination against protected groups of people."},{"@language":"es","@value":"Legislación diseñada para prevenir la discriminación de empleo, vivienda, educación y otras formas de discriminación contra grupos protegidos de personas."},{"@language":"de","@value":"Gesetzgebung zur Verhinderung von Diskriminierung geschützter Personengruppen in den Bereichen Beschäftigung, Wohnen, Bildung und anderen Formen der Diskriminierung."},{"@language":"nl","@value":"Wetgeving om discriminatie van beschermde groepen personen te voorkomen bij werk, huisvesting, onderwijs, etc."},{"@language":"sv","@value":"Lagstiftning som syftar till att förhindra diskriminering av skyddade grupper i arbetsliv, på bostadsmarknaden, inom utbildning och i andra samhällsområden."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000702"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000356"},{"@id":"https://homosaurus.org/v5/homoit0001141"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh93005719"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000702"},"dc:replaces":{"@id":"http://homosaurus.org/v2/anti-discriminationLaw"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000702","dc:identifier":"homoit0000702","skos:prefLabel":[{"@language":"en","@value":"Law"},{"@language":"es","@value":"Derecho"},{"@language":"de","@value":"Recht"},{"@language":"nl","@value":"Wetgeving"},{"@language":"sv","@value":"Lagar"}],"skos:altLabel":[{"@language":"en","@value":"Legislation"},{"@language":"es","@value":"Legislación"},{"@language":"es","@value":"Ley"},{"@language":"es","@value":"Leyes"},{"@language":"de","@value":"Rechtswesen"},{"@language":"de","@value":"Gesetz"},{"@language":"de","@value":"Gesetzgebung"},{"@language":"de","@value":"Rechtsordnung"},{"@language":"sv","@value":"Lagstiftning"}],"rdfs:comment":[{"@language":"en","@value":"System of rules or conduct recognized and legally enforced within a country or community."},{"@language":"es","@value":"Sistema de reglas o conductas reconocidas y legalmente aplicadas dentro de un país o una comunidad."},{"@language":"de","@value":"Ein System von Regeln oder Verhaltensweisen, das innerhalb eines Landes oder einer Gemeinschaft anerkannt ist und rechtlich durchgesetzt wird."},{"@language":"nl","@value":"Systeem van regels of gedrag dat wordt erkend en wettelijk wordt gehandhaafd binnen een land of gemeenschap."},{"@language":"sv","@value":"Ett system av regler eller normer för beteende som erkänns och upprätthålls juridiskt inom ett land eller en gemenskap."}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000053"},{"@id":"https://homosaurus.org/v5/homoit0000311"},{"@id":"https://homosaurus.org/v5/homoit0000313"},{"@id":"https://homosaurus.org/v5/homoit0000918"},{"@id":"https://homosaurus.org/v5/homoit0001139"},{"@id":"https://homosaurus.org/v5/homoit0001492"},{"@id":"https://homosaurus.org/v5/homoit0003499"},{"@id":"https://homosaurus.org/v5/homoit0003772"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000712"},{"@id":"https://homosaurus.org/v5/homoit0000893"},{"@id":"https://homosaurus.org/v5/homoit0001482"},{"@id":"https://homosaurus.org/v5/homoit0004414"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85075119"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000702"},"dc:replaces":{"@id":"http://homosaurus.org/v2/law"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001141","dc:identifier":"homoit0001141","skos:prefLabel":[{"@language":"en","@value":"Public facilities"},{"@language":"es","@value":"Instalaciones públicas"},{"@language":"nl","@value":"Openbare faciliteiten"},{"@language":"sv","@value":"Offentliga anläggningar"}],"rdfs:comment":[{"@language":"en","@value":"Buildings, recreational areas, and other types of properties that are owned and maintained by state or local government and are thus available for use by the public."},{"@language":"es","@value":"Edificios, áreas recreativas y otros tipos de propiedades que pertenecen a y son mantenidas por el gobierno estatal o local y, por lo tanto, están disponibles para el uso del público."},{"@language":"nl","@value":"Gebouwen, recreatiegebieden en andere soorten bezittingen die eigendom zijn van en worden onderhouden door de staat of lokale overheid en die dus beschikbaar zijn voor gebruik door het publiek."},{"@language":"sv","@value":"Byggnader, rekreationsområden och andra typer av fastigheter som ägs och förvaltas av stat eller kommun och som är tillgängliga för allmänheten."}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000248"},{"@id":"https://homosaurus.org/v5/homoit0000975"},{"@id":"https://homosaurus.org/v5/homoit0001140"},{"@id":"https://homosaurus.org/v5/homoit0001143"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000053"},{"@id":"https://homosaurus.org/v5/homoit0000062"},{"@id":"https://homosaurus.org/v5/homoit0001139"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85108620"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001141"},"dc:replaces":{"@id":"http://homosaurus.org/v2/publicFacilities"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000054","dc:identifier":"homoit0000054","skos:prefLabel":[{"@language":"en","@value":"Anti-feminism"},{"@language":"es","@value":"Anti-feminismo"},{"@language":"de","@value":"Antifeminismus"},{"@language":"nl","@value":"Anti-feminisme"},{"@language":"sv","@value":"Antifeminism"}],"skos:altLabel":{"@language":"de","@value":"Anti-Feminismus"},"rdfs:comment":[{"@language":"en","@value":"Opposition to some or all forms of feminism."},{"@language":"es","@value":"Oposición a algunas o todas las formas del feminismo."},{"@language":"de","@value":"Ablehnung einiger oder aller Formen des Feminismus."},{"@language":"nl","@value":"Verzet tegen sommige of alle vormen van feminisme"},{"@language":"sv","@value":"Motstånd mot vissa eller alla former av feminism."}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000437"},{"@id":"https://homosaurus.org/v5/homoit0001133"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh96004456"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000054"},"dc:replaces":{"@id":"http://homosaurus.org/v2/anti-feminism"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000437","dc:identifier":"homoit0000437","skos:prefLabel":[{"@language":"en","@value":"Feminism"},{"@language":"es","@value":"Feminismo"},{"@language":"de","@value":"Feminismus"},{"@language":"nl","@value":"Feminisme"},{"@language":"sv","@value":"Feminism"}],"rdfs:comment":[{"@language":"en","@value":"Collection of movements aimed at defining, establishing, and defending equal political, economic, and social rights and equal opportunities for women."},{"@language":"es","@value":"Conjunto de movimientos que buscan definir, establecer y defender la igualdad de derechos políticos, económicos y sociales y la igualdad de oportunidades para las mujeres."},{"@language":"de","@value":"Gesamtheit der Bewegungen, die darauf abzielen, gleiche politische, wirtschaftliche und soziale Rechte sowie Chancengleichheit für Frauen zu definieren, zu etablieren und zu verteidigen."},{"@language":"nl","@value":"Verzameling van bewegingen gericht op het definiëren, vestigen en verdedigen van gelijke politieke, economische en sociale rechten en gelijke kansen voor vrouwen"},{"@language":"sv","@value":"Samling av rörelser som syftar till att formulera, etablera och försvara lika politiska, ekonomiska och sociala rättigheter samt lika möjligheter för kvinnor."}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000387"},{"@id":"https://homosaurus.org/v5/homoit0000444"},{"@id":"https://homosaurus.org/v5/homoit0000622"},{"@id":"https://homosaurus.org/v5/homoit0000741"},{"@id":"https://homosaurus.org/v5/homoit0001230"},{"@id":"https://homosaurus.org/v5/homoit0001260"},{"@id":"https://homosaurus.org/v5/homoit0002270"},{"@id":"https://homosaurus.org/v5/homoit0002271"},{"@id":"https://homosaurus.org/v5/homoit0002274"},{"@id":"https://homosaurus.org/v5/homoit0002275"},{"@id":"https://homosaurus.org/v5/homoit0003101"},{"@id":"https://homosaurus.org/v5/homoit0003765"},{"@id":"https://homosaurus.org/v5/homoit0003767"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000054"},{"@id":"https://homosaurus.org/v5/homoit0000438"},{"@id":"https://homosaurus.org/v5/homoit0001505"},{"@id":"https://homosaurus.org/v5/homoit0001509"},{"@id":"https://homosaurus.org/v5/homoit0001516"},{"@id":"https://homosaurus.org/v5/homoit0002039"},{"@id":"https://homosaurus.org/v5/homoit0002290"},{"@id":"https://homosaurus.org/v5/homoit0003157"},{"@id":"https://homosaurus.org/v5/homoit0003158"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85047741"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000437"},"dc:replaces":{"@id":"http://homosaurus.org/v2/feminism"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001133","dc:identifier":"homoit0001133","skos:prefLabel":[{"@language":"en","@value":"Social privilege"},{"@language":"es","@value":"Privilegio social"},{"@language":"nl","@value":"Sociaal privilege"},{"@language":"sv","@value":"Sociala privilegier"}],"skos:altLabel":{"@language":"sv","@value":"Privilegier (socialt)"},"rdfs:comment":[{"@language":"en","@value":"Special rights or immunities granted to specific people or groups that are used to falsely homogenize or discriminate against other people or groups."},{"@language":"es","@value":"Derechos o inmunidades especiales otorgadas a personas o grupos específicos que se utilizan para homogeneizar o discriminar falsamente a otras personas o grupos."},{"@language":"nl","@value":"Een speciaal recht of immuniteit toegekend aan een specifieke persoon of groep die wordt gebruikt om andere mensen of groepen valselijk te homogeniseren of te discrimineren"},{"@language":"sv","@value":"Särskilda rättigheter eller privilegier som tilldelas vissa individer eller grupper och som används för att felaktigt homogenisera eller diskriminera mot andra."}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000054"},{"@id":"https://homosaurus.org/v5/homoit0000243"},{"@id":"https://homosaurus.org/v5/homoit0000302"},{"@id":"https://homosaurus.org/v5/homoit0000381"},{"@id":"https://homosaurus.org/v5/homoit0000416"},{"@id":"https://homosaurus.org/v5/homoit0000417"},{"@id":"https://homosaurus.org/v5/homoit0000598"},{"@id":"https://homosaurus.org/v5/homoit0000622"},{"@id":"https://homosaurus.org/v5/homoit0000667"},{"@id":"https://homosaurus.org/v5/homoit0000675"},{"@id":"https://homosaurus.org/v5/homoit0000860"},{"@id":"https://homosaurus.org/v5/homoit0000999"},{"@id":"https://homosaurus.org/v5/homoit0001017"},{"@id":"https://homosaurus.org/v5/homoit0001018"},{"@id":"https://homosaurus.org/v5/homoit0001230"},{"@id":"https://homosaurus.org/v5/homoit0001376"},{"@id":"https://homosaurus.org/v5/homoit0001377"},{"@id":"https://homosaurus.org/v5/homoit0002271"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2017003293"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001133"},"dc:replaces":{"@id":"http://homosaurus.org/v2/socialPrivilege"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000055","dc:identifier":"homoit0000055","skos:prefLabel":[{"@language":"en","@value":"Anti-gay discrimination"},{"@language":"es","@value":"Discriminación anti-gay"},{"@language":"de","@value":"Schwulenfeindliche Diskriminierung"},{"@language":"nl","@value":"Anti-homo discriminatie"},{"@language":"sv","@value":"Diskriminering av bögar"}],"skos:altLabel":[{"@language":"de","@value":"Homosexuellenfeindliche Diskriminierung"},{"@language":"de","@value":"Antihomosexuelle Diskriminierung"},{"@language":"de","@value":"Anti-Homosexuellen-Diskriminierung"},{"@language":"de","@value":"Diskriminierung von Homosexuellen"},{"@language":"de","@value":"Diskriminierung von schwulen Männern"},{"@language":"de","@value":"Diskriminierung von schwulen Personen"},{"@language":"sv","@value":"Diskriminering av homosexuella män"}],"rdfs:comment":[{"@language":"en","@value":"The unjust or prejudicial treatment of gay men due to their sexual identity; may include the denial of legal rights, employment, and housing."},{"@language":"es","@value":"El trato injusto o perjudicial hacia hombres gay por su identidad sexual; puede incluir la negación de derechos legales, empleo y vivienda."},{"@language":"de","@value":"Die ungerechte oder vorurteilsbehaftete Behandlung schwuler Männer aufgrund ihrer sexuellen Identität; kann die Verweigerung von gesetzlichen Rechten, Beschäftigung und Wohnraum beinhalten."},{"@language":"nl","@value":"De onrechtvaardige of nadelige behandeling op basis van vooroordelen van homomannen vanwege hun seksuele identiteit; kan de ontkenning van wettelijke rechten, werkgelegenheid en huisvesting omvatten."},{"@language":"sv","@value":"Systematiskt orättvist eller fördomsfull behandling av bögar på grund av deras identitet, uttryck eller tillhörighet, vilket kan ta sig uttryck i begränsad tillgång till arbete, bostad eller rättsligt erkännande."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000356"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000646"},"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh88006552"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000356"},"dc:replaces":{"@id":"http://homosaurus.org/v2/antiGayDiscrimination"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000646","dc:identifier":"homoit0000646","skos:prefLabel":[{"@language":"en","@value":"Homophobia"},{"@language":"es","@value":"Homofobia"},{"@language":"de","@value":"Homophobie"},{"@language":"nl","@value":"Homofobie"},{"@language":"sv","@value":"Homofobi"}],"rdfs:comment":[{"@language":"en","@value":"Antagonism or disgust directed towards homosexuality as an identity or men who are perceived to be or are actually gay. Homophobia can include denial of the existence of homosexuality, stereotypes, verbal harassment, and physical violence. This term is often used colloquially to encompass all LGBTQ+ phobia."},{"@language":"es","@value":"Antagonismo o disgusto dirigido hacia la homosexualidad como identidad o hacia los hombres que son percibidos como o que realmente son gay. La homofobia puede incluir la negación de la existencia de la homosexualidad, los estereotipos, el acoso verbal y la violencia física. Este término se utiliza a menudo de forma coloquial para abarcar toda la fobia LGBTQ+."},{"@language":"de","@value":"Ablehnung oder Ekel gegenüber Homosexualität als Identität oder gegenüber Männern, die als schwul wahrgenommen werden oder es tatsächlich sind. Homophobie kann die Leugnung der Existenz von Homosexualität, Stereotypisierung, verbale Belästigung und körperliche Gewalt umfassen. Dieser Begriff wird umgangssprachlich oft verwendet, um alle Formen von LGBTQ+-Phobie zu bezeichnen."},{"@language":"nl","@value":"Antagonisme of afkeer gericht tegen homoseksualiteit als identiteit of tegen homomannen vanwege hun seksualiteit, waargenomen of feitelijk. Homofobie kan bestaan uit ontkenning van het bestaan van homoseksualiteit, stereotypen, verbale intimidatie en fysiek geweld. Deze term wordt in de volksmond vaak gebruikt om alle LHBTQ+-fobieën te omvatten"},{"@language":"sv","@value":"Motvilja, fientlighet eller äckel riktat mot homosexualitet som identitet eller mot män som uppfattas som eller faktiskt är homosexuella. Homofobi kan ta sig uttryck i förnekande av att homosexualitet existerar, stereotypa föreställningar, verbala trakasserier och fysiskt våld. Termen används ofta i vardagligt språkbruk som ett samlingsbegrepp för negativa attityder och handlingar riktade mot hbtq+-personer i stort."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000920"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000391"},{"@id":"https://homosaurus.org/v5/homoit0002174"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000055"},{"@id":"https://homosaurus.org/v5/homoit0000056"},{"@id":"https://homosaurus.org/v5/homoit0000506"},{"@id":"https://homosaurus.org/v5/homoit0000619"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh88006552"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000920"},"dc:replaces":{"@id":"http://homosaurus.org/v2/homophobia"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000056","dc:identifier":"homoit0000056","skos:prefLabel":[{"@language":"en","@value":"Anti-gay violence"},{"@language":"es","@value":"Violencia anti-gay"},{"@language":"de","@value":"Schwulenfeindliche Gewalt"},{"@language":"nl","@value":"Anti-homogeweld"},{"@language":"sv","@value":"Våld mot bögar"}],"skos:altLabel":[{"@language":"en","@value":"Gay bashing"},{"@language":"es","@value":"Gay bashing"},{"@language":"de","@value":"Homosexuellenfeindliche Gewalt"},{"@language":"de","@value":"Antihomosexuelle Gewalt"},{"@language":"de","@value":"Anti-Homosexuelle-Gewalt"},{"@language":"de","@value":"Gewalt gegen Homosexuelle"},{"@language":"de","@value":"Gewalt gegen schwulen Männern"},{"@language":"de","@value":"Gewalt gegen schwulen Personen"},{"@language":"de","@value":"Gay Bashing"},{"@language":"sv","@value":"Våld mot homosexuella män"}],"rdfs:comment":[{"@language":"en","@value":"Behavior involving physical force intended to harm or kill gay men on the basis of their identity. "},{"@language":"es","@value":"Comportamiento que involucra fuerza física destinada a hacer daño o a matar a hombres gay en base a su identidad."},{"@language":"de","@value":"Verhalten, bei dem körperliche Gewalt angewendet wird, um schwule Männer aufgrund ihrer Identität zu verletzen oder zu töten."},{"@language":"nl","@value":"Gedrag met fysiek geweld bedoeld om homomannen te verwonden of te doden vanwege hun identiteit."},{"@language":"sv","@value":"Beteenden som innefattar fysiskt våld avsett att skada eller döda bögar på grund av deras identitet."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000059"},"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0000449"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000109"},{"@id":"https://homosaurus.org/v5/homoit0000646"}],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2005020376"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000059"},"dc:replaces":{"@id":"http://homosaurus.org/v2/anti-gayViolence"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000449","dc:identifier":"homoit0000449","skos:prefLabel":[{"@language":"en","@value":"Forced castration"},{"@language":"es","@value":"Castración forzada"},{"@language":"de","@value":"Zwangskastration"},{"@language":"nl","@value":"Gedwongen castratie"},{"@language":"sv","@value":"Tvångskastrering"}],"skos:altLabel":{"@language":"de","@value":"Zwangssterilisation"},"rdfs:comment":[{"@language":"en","@value":"Forced or coerced removal of the testes or use of the testes, typically through surgical or chemical means, enacted by legal authorities or as a hate crime."},{"@language":"es","@value":"Extirpación forzada o bajo coacción de los testículos o la utilización de los mismos, normalmente por medios quirúrgicos o químicos, por las autoridades legales o como crimen de odio."},{"@language":"de","@value":"Zwangsentfernung der Hoden, in der Regel durch chirurgische oder chemische Mittel, durchgeführt durch Justizbehörden oder als Hassverbrechen."},{"@language":"sv","@value":"Ofrivilligt eller framtvingat avlägsnande av testiklarna eller påverkan på testiklarnas funktion, vanligtvis genom kirurgiska eller kemiska metoder, genomfört av rättsliga myndigheter eller som ett hatbrott."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000056"},{"@id":"https://homosaurus.org/v5/homoit0000241"}],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85128028"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000059"},"dc:replaces":{"@id":"http://homosaurus.org/v2/forcedCastration"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000057","dc:identifier":"homoit0000057","skos:prefLabel":[{"@language":"en","@value":"Anti-lesbian discrimination"},{"@language":"es","@value":"Discriminación anti-lesbiana"},{"@language":"de","@value":"Lesbenfeindliche Diskriminierung"},{"@language":"nl","@value":"Anti-lesbische discriminatie"},{"@language":"sv","@value":"Diskriminering av lesbiska"}],"skos:altLabel":[{"@language":"de","@value":"Anti-lesbische Diskriminierung"},{"@language":"de","@value":"Diskriminierung von Lesben"},{"@language":"de","@value":"Diskriminierung von lesbischen Frauen"},{"@language":"de","@value":"Diskriminierung von lesbischen Personen"}],"rdfs:comment":[{"@language":"en","@value":"The unjust or prejudicial treatment of lesbians due to their sexual identity; may include the denial of legal rights, employment, and housing."},{"@language":"es","@value":"El trato injusto o perjudicial hacia las lesbianas por su identidad sexual; puede incluir la negación de derechos legales, empleo y vivienda."},{"@language":"de","@value":"Die ungerechte oder vorurteilsbehaftete Behandlung von Lesben aufgrund ihrer sexuellen Identität; kann die Verweigerung von Rechtsansprüchen, Beschäftigung und Wohnraum beinhalten."},{"@language":"nl","@value":"De onrechtvaardige of nadelige behandeling op basis van vooroordelen van lesbische vrouwen vanwege hun seksuele identiteit; kan de ontkenning van wettelijke rechten, werkgelegenheid en huisvesting omvatten."},{"@language":"sv","@value":"Systematiskt orättvist eller fördomsfull behandling av lesbiska på grund av deras identitet, uttryck eller tillhörighet, vilket kan ta sig uttryck i begränsad tillgång till arbete, bostad eller rättsligt erkännande."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000356"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000803"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000356"},"dc:replaces":{"@id":"http://homosaurus.org/v2/antiLesbianDiscrimination"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000803","dc:identifier":"homoit0000803","skos:prefLabel":[{"@language":"en","@value":"Lesbophobia"},{"@language":"es","@value":"Lesbofobia"},{"@language":"nl","@value":"Lesbofobie"},{"@language":"sv","@value":"Lesbofobi"}],"rdfs:comment":[{"@language":"en","@value":"Antagonism or disgust directed towards lesbianism as an identity or lesbians due to their sexuality, perceived or actual. Lesbophobia can include denial of the existence of lesbianism, stereotypes, verbal harassment, and physical violence."},{"@language":"es","@value":"Antagonismo o repugnancia hacia el lesbianismo como identidad o hacia las lesbianas por su sexualidad, percibida o real. La lesbofobia puede incluir la negación de la existencia del lesbianismo, estereotipos, acoso verbal y violencia física."},{"@language":"nl","@value":"Antagonisme of afkeer gericht tegen lesbische vrouwen wegens hun identiteit of seksualiteit, waargenomen of feitelijk. Lesbofobie kan bestaan uit ontkenning van het bestaan van lesbische vrouwen, stereotypen, verbale intimidatie en fysiek geweld"},{"@language":"sv","@value":"Fientlighet eller avsky riktad mot lesbiskhet som identitet eller mot lesbiska på grund av deras faktiska eller upplevda sexualitet. Lesbofobi kan innefatta förnekande av lesbiskas existens, stereotyper, verbala trakasserier och fysiskt våld."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000920"},"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0002591"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000057"},{"@id":"https://homosaurus.org/v5/homoit0000058"},{"@id":"https://homosaurus.org/v5/homoit0000556"},{"@id":"https://homosaurus.org/v5/homoit0000619"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000920"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbophobia"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000058","dc:identifier":"homoit0000058","skos:prefLabel":[{"@language":"en","@value":"Anti-lesbian violence"},{"@language":"es","@value":"Violencia anti-lesbiana"},{"@language":"de","@value":"Lesbenfeindliche Gewalt"},{"@language":"nl","@value":"Anti-lesbisch geweld"},{"@language":"sv","@value":"Våld mot lesbiska"}],"skos:altLabel":[{"@language":"en","@value":"Lesbian bashing"},{"@language":"es","@value":"Lesbian bashing"},{"@language":"de","@value":"Anti-lesbische Gewalt"},{"@language":"de","@value":"Gewalt gegen Lesben"},{"@language":"de","@value":"Gewalt gegen lesbische Frauen"},{"@language":"de","@value":"Gewalt gegen lesbische Personen"}],"rdfs:comment":[{"@language":"en","@value":"Behavior involving physical force intended to harm or kill lesbians on the basis of their identity. "},{"@language":"es","@value":"Comportamiento que involucra fuerza física destinada a hacer daño o a matar a lesbianas por su identidad."},{"@language":"de","@value":"Verhaltensweisen, die körperliche Gewalt beinhalten und darauf abzielen, Lesben aufgrund ihrer Identität zu verletzen oder zu töten."},{"@language":"nl","@value":"Gedrag met fysiek geweld bedoeld om lesbische vrouwen te verwonden of te doden vanwege hun identiteit."},{"@language":"sv","@value":"Beteenden som innefattar fysiskt våld avsett att skada eller döda lesbiska på grund av deras identitet."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000059"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000109"},{"@id":"https://homosaurus.org/v5/homoit0000556"},{"@id":"https://homosaurus.org/v5/homoit0000803"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000059"},"dc:replaces":{"@id":"http://homosaurus.org/v2/anti-lesbianViolence"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000061","dc:identifier":"homoit0000061","skos:prefLabel":[{"@language":"en","@value":"Anti-queer violence"},{"@language":"es","@value":"Violencia anti-queer"},{"@language":"de","@value":"Queerfeindliche Gewalt"},{"@language":"nl","@value":"Anti-queer geweld"},{"@language":"sv","@value":"Våld mot queera personer"}],"skos:altLabel":[{"@language":"de","@value":"Anti-queere Gewalt"},{"@language":"de","@value":"Antiqueere Gewalt"},{"@language":"de","@value":"Gewalt gegen queere Personen"}],"rdfs:comment":[{"@language":"en","@value":"Behavior involving physical force intended to harm or kill queer people on the basis of their identity. "},{"@language":"es","@value":"Comportamiento que involucra fuerza física con el fin de dañar o matar a personas queer por su identidad."},{"@language":"de","@value":"Verhalten, das körperliche Gewalt beinhaltet und darauf abzielt, queere Menschen aufgrund ihrer Identität zu verletzen oder zu töten."},{"@language":"nl","@value":"Gedrag met fysiek geweld bedoeld om queer personen te verwonden of te doden vanwege hun identiteit."},{"@language":"sv","@value":"Beteenden som innefattar fysiskt våld avsett att skada eller döda queera personer på grund av deras identitet."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000059"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000109"},{"@id":"https://homosaurus.org/v5/homoit0001229"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000059"},"dc:replaces":{"@id":"http://homosaurus.org/v2/antiQueerViolence"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000063","dc:identifier":"homoit0000063","skos:prefLabel":[{"@language":"en","@value":"Anti-transgender violence"},{"@language":"de","@value":"Transfeindliche Gewalt"},{"@language":"es","@value":"Violencia anti-transgénero"},{"@language":"nl","@value":"Anti-transgender geweld"},{"@language":"sv","@value":"Våld mot transpersoner"}],"skos:altLabel":[{"@language":"de","@value":"Anti-trans-Gewalt"},{"@language":"es","@value":"Violencia anti-trans"}],"rdfs:comment":[{"@language":"en","@value":"Behavior involving physical force intended to harm or kill transgender people on the basis of their identity. "},{"@language":"de","@value":"Verhalten, das körperliche Gewalt einschließt und darauf abzielt, trans Personen aufgrund ihrer Identität zu verletzen oder zu töten."},{"@language":"es","@value":"Comportamiento que involucra fuerza física destinada a hacer daño o a matar a personas transgénero por su identidad."},{"@language":"nl","@value":"Gedrag met fysiek geweld bedoeld om transgender personen te verwonden of te doden vanwege hun identiteit."},{"@language":"sv","@value":"Beteenden som innefattar fysiskt våld avsett att skada eller döda transpersoner på grund av deras identitet."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000059"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000109"},{"@id":"https://homosaurus.org/v5/homoit0001467"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2010014446"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000059"},"dc:replaces":{"@id":"http://homosaurus.org/v2/anti-transgenderViolence"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000641","dc:identifier":"homoit0000641","skos:prefLabel":[{"@language":"en","@value":"Murders of LGBTQ+ people"},{"@language":"es","@value":"Asesinatos de personas LGBTQ+"},{"@language":"nl","@value":"Moorden op LHBTQ+-personen"},{"@language":"sv","@value":"Mord på hbtq+-personer"}],"skos:altLabel":[{"@language":"en","@value":"Homicides of LGBTQ people"},{"@language":"en","@value":"Murders of LGBTQ people"},{"@language":"es","@value":"Homicidios de personas LGBTQ+"}],"rdfs:comment":[{"@language":"en","@value":"Intentional killing of LGBTQ+ people due to their gender and/or sexual identities."},{"@language":"es","@value":"Asesinato intencional de personas LGBTQ+ debido a su género y/o identidad sexual."},{"@language":"nl","@value":"Opzettelijke moord op LHBTQ+-personen vanwege hun gender en/of seksuele identiteit."},{"@language":"sv","@value":"Avsiktligt dödande av hbtq+-personer på grund av deras könsidentitet och/eller sexuella identitet."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000059"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000109"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000059"},"dc:replaces":{"@id":"http://homosaurus.org/v2/murdersOfLGBTQPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000855","dc:identifier":"homoit0000855","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ domestic violence"},{"@language":"ja","@value":"LGBTQ+に関するドメスティック・バイオレンス"},{"@language":"es","@value":"Violencia doméstica LGBTQ+"},{"@language":"nl","@value":"LHBTQ+-huiselijk geweld"},{"@language":"sv","@value":"Våld i nära relationer (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"LGBTQ domestic violence"},{"@language":"ja","@value":"LGBTQに関するドメスティック・バイオレンス"},{"@language":"es","@value":"Violencia de pareja LGBTQ"}],"rdfs:comment":[{"@language":"en","@value":"Acts of violence and abuse directed toward individuals in private, domestic settings; can be used to describe singular or repeated incidents."},{"@language":"ja","@value":"私的な家庭内において個人に対して行われる暴力や虐待の行為。単発的な出来事や繰り返される出来事を指す場合に用いられる。"},{"@language":"es","@value":"Actos de violencia y abuso dirigidos a personas en entornos domésticos y privados; se puede utilizar para describir incidentes singulares o repetidos."},{"@language":"nl","@value":"Daden van geweld en misbruik gericht tegen individuen in privé, huiselijke situaties; kan worden gebruikt om eenmalige of herhaalde incidenten te beschrijven."},{"@language":"sv","@value":"Våldsamma eller kränkande handlingar som sker i nära relationer eller hushåll där en eller flera parter är hbtq+-personer. Kan beskriva både enstaka och återkommande fall."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000059"},{"@id":"https://homosaurus.org/v5/homoit0001305"}],"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0000675"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000302"},{"@id":"https://homosaurus.org/v5/homoit0000938"},{"@id":"https://homosaurus.org/v5/homoit0000959"},{"@id":"https://homosaurus.org/v5/homoit0001083"},{"@id":"https://homosaurus.org/v5/homoit0001285"},{"@id":"https://homosaurus.org/v5/homoit0001311"},{"@id":"https://homosaurus.org/v5/homoit0001351"}],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2005020201"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000059"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQDomesticViolence"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001769","dc:identifier":"homoit0001769","skos:prefLabel":[{"@language":"en","@value":"Anti-Two-Spirit violence"},{"@language":"de","@value":"Anti-Two-Spirit-Gewalt"},{"@language":"es","@value":"Violencia anti-dos espíritus"},{"@language":"nl","@value":"Anti-Two-Spirit geweld"},{"@language":"sv","@value":"Våld mot Two-spirit-personer"}],"skos:altLabel":[{"@language":"en","@value":"Anti-2S violence"},{"@language":"en","@value":"Anti-Two Spirit violence"},{"@language":"en","@value":"Anti-Two Spirited violence"},{"@language":"en","@value":"Anti-Two-Spirited violence"},{"@language":"de","@value":"Two-Spirit-feindliche Gewalt"},{"@language":"de","@value":"2S-feindliche Diskriminierung"},{"@language":"es","@value":"Violencia hacia personas dos espíritus"},{"@language":"es","@value":"Violencia anti dos espíritus"},{"@language":"es","@value":"Violencia hacia dos espíritus"}],"rdfs:comment":[{"@language":"en","@value":"Behavior involving physical force intended to harm or kill Two-Spirit people on the basis of their identity. "},{"@language":"de","@value":"Verhalten, das körperliche Gewalt einschließt und darauf abzielt,Two-Spirit Personen aufgrund ihrer Identität zu verletzen oder zu töten."},{"@language":"es","@value":"Comportamiento que involucra fuerza física destinada a hacer daño o a matar a personas Dos Espíritus por su identidad."},{"@language":"nl","@value":"Geweld tegen two-spirit people vanwege hun identiteit"},{"@language":"sv","@value":"Beteenden som innefattar fysiskt våld avsett att skada eller döda Two-spirit-personer på grund av deras identitet."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000059"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000109"},{"@id":"https://homosaurus.org/v5/homoit0004620"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000059"},"dc:issued":{"@type":"xsd:date","@value":"2021-11-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001770","dc:identifier":"homoit0001770","skos:prefLabel":[{"@language":"en","@value":"Anti-intersex violence"},{"@language":"de","@value":"Gewalt gegen inter* Personen"},{"@language":"es","@value":"Violencia anti-intersexual"},{"@language":"nl","@value":"Anti-intersekse geweld"},{"@language":"sv","@value":"Våld mot intersexpersoner"}],"skos:altLabel":[{"@language":"de","@value":"Antiinter* Diskriminierung"},{"@language":"de","@value":"Anti-intersex* Diskriminierung"},{"@language":"de","@value":"Antiintersex* Diskriminierung"},{"@language":"de","@value":"Anti-inter* Diskriminierung"},{"@language":"es","@value":"Violencia anti-intersex"}],"rdfs:comment":[{"@language":"en","@value":"Behavior involving physical force intended to harm or kill intersex people because they are intersex."},{"@language":"de","@value":"Verhalten, das körperliche Gewalt beinhaltet und darauf abzielt, inter* Menschen zu schädigen oder zu töten, weil sie inter* sind."},{"@language":"es","@value":"Comportamiento que involucra fuerza física destinada a hacer daño o a matar a personas intersexuales por su identidad."},{"@language":"nl","@value":"Gedrag met fysiek geweld bedoeld om intersekse personen te verwonden of te doden vanwege hun identiteit."},{"@language":"sv","@value":"Beteenden som innefattar fysiskt våld avsett att skada eller döda intersexpersoner på grund av att de är intersex."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000059"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000109"},{"@id":"https://homosaurus.org/v5/homoit0000666"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000059"},"dc:issued":{"@type":"xsd:date","@value":"2021-11-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002378","dc:identifier":"homoit0002378","skos:prefLabel":[{"@language":"en","@value":"Police violence toward LGBTQ+ people "},{"@language":"es","@value":"Violencia policial hacia personas LGBTQ+"},{"@language":"nl","@value":"Politiegeweld tegen LHBTQ+-personen"},{"@language":"sv","@value":"Polisvåld mot hbtq+-personer"}],"skos:altLabel":[{"@language":"en","@value":"Police abuse toward LGBTQ+ people"},{"@language":"en","@value":"Police torture of LGBTQ+ people"},{"@language":"es","@value":"Abuso policial contra personas LGBTQ+"},{"@language":"es","@value":"Tortura policial contra personas LGBTQ+"},{"@language":"nl","@value":"Politiemisbruik jegens LHBTQ+-personen"}],"rdfs:comment":[{"@language":"en","@value":"Any of various forms of police violence aimed toward LGBTQ+ people."},{"@language":"es","@value":"Cualquiera de las diversas formas de violencia policial dirigida hacia personas LGBTQ+."},{"@language":"nl","@value":"Elke vorm van politiegeweld gericht tegen LHBTQ+-personen."},{"@language":"sv","@value":"Olika former av polisvåld riktat mot hbtq+-personer."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000059"},{"@id":"https://homosaurus.org/v5/homoit0002373"}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0002381"},{"@id":"https://homosaurus.org/v5/homoit0002395"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000059"},"dc:issued":{"@type":"xsd:date","@value":"2023-01-13"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002900","dc:identifier":"homoit0002900","skos:prefLabel":[{"@language":"en","@value":"Anti-asexual violence"},{"@language":"es","@value":"Violencia anti-asexual"},{"@language":"de","@value":"Gewalt gegen asexuelle Personen"},{"@language":"nl","@value":"Anti-aseksueel geweld"},{"@language":"sv","@value":"Våld mot asexuella"}],"skos:altLabel":[{"@language":"de","@value":"Antiasexuelle Gewalt"},{"@language":"de","@value":"Anti-asexuelle Gewalt"}],"rdfs:comment":[{"@language":"en","@value":"Behavior involving physical force intended to harm or kill asexual people on the basis of their identity."},{"@language":"es","@value":"Comportamiento que involucra fuerza física destinada a hacer daño o a matar a personas asexuales por su identidad."},{"@language":"de","@value":"Verhalten, bei dem körperliche Gewalt angewendet wird, um asexuelle Menschen aufgrund ihrer Identität zu verletzen oder zu töten."},{"@language":"nl","@value":"Gedrag waarbij fysiek geweld betrokken is, bedoeld om aseksuele personen te schaden of te doden vanwege hun identiteit."},{"@language":"sv","@value":"Beteenden som innefattar fysiskt våld avsett att skada eller döda asexuella personer på grund av deras identitet."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000059"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000109"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000059"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-29"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000613","dc:identifier":"homoit0000613","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ victims of hate crimes"},{"@language":"es","@value":"Víctimas LGBTQ+ de crímenes de odio"},{"@language":"fr","@value":"Personnes LGBTQ+ victimes de crimes haineux"},{"@language":"nl","@value":"LHBTQ+-slachtoffers van haatmisdrijven"},{"@language":"sv","@value":"Hatbrottsoffer (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"Hate crime victims (LGBTQ)"},{"@language":"en","@value":"Victims of hate crimes (LGBTQ)"},{"@language":"sv","@value":"Hbtq+-personer som är offer för hatbrott"}],"rdfs:comment":[{"@language":"en","@value":"LGBTQ+ people who have experienced hate crimes and may or may not have survived; follow the individual's preference for \"victims\" or \"survivors\" whenever possible."},{"@language":"es","@value":"Personas LGBTQ+ que han sufrido crímenes de odio y pueden o no haber sobrevivido; siga la preferencia de la persona sobre el uso de \"víctimas\" o \"sobrevivientes\" siempre que sea posible."},{"@language":"fr","@value":"Personnes LGBTQ+ qui ont été victimes de crimes haineux et qui peuvent ou non avoir survécu; respecter la préférence de la personne concernée entre les termes « victimes » ou « survivantes » dans la mesure du possible."},{"@language":"nl","@value":"LHBTQ+-personen die haatmisdrijven hebben meegemaakt en het al dan niet hebben overleefd; volg waar mogelijk de voorkeur van het individu voor \"slachtoffers\" of \"overlevenden\""},{"@language":"sv","@value":"Hbtq+-personer som har utsatts för hatbrott och som kan ha överlevt eller inte. Följ individens preferens för att använda ”offer” eller ”överlevare” när det är möjligt."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000312"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000196"},{"@id":"https://homosaurus.org/v5/homoit0000551"},{"@id":"https://homosaurus.org/v5/homoit0000792"},{"@id":"https://homosaurus.org/v5/homoit0001221"},{"@id":"https://homosaurus.org/v5/homoit0001349"},{"@id":"https://homosaurus.org/v5/homoit0001456"},{"@id":"https://homosaurus.org/v5/homoit0002895"},{"@id":"https://homosaurus.org/v5/homoit0002948"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000059"},{"@id":"https://homosaurus.org/v5/homoit0000109"},{"@id":"https://homosaurus.org/v5/homoit0002732"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/victimsOfHateCrimesLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000958","dc:identifier":"homoit0000958","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ victims of rape"},{"@language":"es","@value":"Víctimas LGBTQ+ de violación"},{"@language":"fr","@value":"Personnes LGBTQ+ victimes de viol"},{"@language":"nl","@value":"LHBTQ+-slachtoffers van verkrachting"},{"@language":"sv","@value":"Våldtäktsoffer (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"LGBTQ victims of rape"},{"@language":"en","@value":"Rape victims (LGBTQ)"},{"@language":"en","@value":"Victims of rape (LGBTQ)"},{"@language":"sv","@value":"Offer för våldtäkt (hbtq+)"}],"rdfs:comment":[{"@language":"en","@value":"LGBTQ+ people who have experienced rape and may or may not have survived; follow the individual's preference for \"victims\" or \"survivors\" whenever possible."},{"@language":"es","@value":"Personas LGBTQ+ que han sufrido una violación y pueden o no haber sobrevivido; siga la preferencia de la persona sobre el uso de \"víctimas\" o \"sobrevivientes\" siempre que sea posible."},{"@language":"fr","@value":"Personnes LGBTQ+ qui ont été victimes de viol et qui peuvent ou non avoir survécu; respecter la préférence de la personne concernée entre les termes « victimes » ou « survivantes » dans la mesure du possible."},{"@language":"nl","@value":"LHBTQ+-personen die verkrachting hebben meegemaakt en het al dan niet hebben overleefd; volg waar mogelijk de voorkeur van het individu voor \"slachtoffers\" of \"overlevenden\""},{"@language":"sv","@value":"Hbtq+-personer som har utsatts för våldtäkt och som kan ha överlevt eller inte. Följ individens preferens för att använda ”offer” eller ”överlevare” när det är möjligt."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000312"},{"@id":"https://homosaurus.org/v5/homoit0000959"},{"@id":"https://homosaurus.org/v5/homoit0001305"}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000197"},{"@id":"https://homosaurus.org/v5/homoit0000552"},{"@id":"https://homosaurus.org/v5/homoit0000793"},{"@id":"https://homosaurus.org/v5/homoit0001222"},{"@id":"https://homosaurus.org/v5/homoit0001350"},{"@id":"https://homosaurus.org/v5/homoit0001457"},{"@id":"https://homosaurus.org/v5/homoit0002855"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000059"},{"@id":"https://homosaurus.org/v5/homoit0000302"},{"@id":"https://homosaurus.org/v5/homoit0001307"},{"@id":"https://homosaurus.org/v5/homoit0002195"},{"@id":"https://homosaurus.org/v5/homoit0002733"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/victimsOfRapeLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000959","dc:identifier":"homoit0000959","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ victims of sexual abuse"},{"@language":"es","@value":"Víctimas LGBTQ+ de abuso sexual"},{"@language":"fr","@value":"Personnes LGBTQ+ victimes d'abus sexuels"},{"@language":"nl","@value":"LHBTQ+-slachtoffers van seksueel misbruik"},{"@language":"sv","@value":"Offer för sexuella övergrepp (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"Sexual abuse victims (LGBTQ)"},{"@language":"en","@value":"Sexual violence victims (LGBTQ)"},{"@language":"en","@value":"Victims of sex crimes (LGBTQ)"},{"@language":"en","@value":"Victims of sexual abuse (LGBTQ)"},{"@language":"fr","@value":"Personnes LGBTQ+ victimes de violences sexuelles"},{"@language":"fr","@value":"Personnes LGBTQ+ victimes d'agressions sexuelles"},{"@language":"nl","@value":"LHBTQ+-slachtoffers van seksueel geweld"},{"@language":"sv","@value":"Personer utsatta för sexuella övergrepp (hbtq+)"}],"rdfs:comment":[{"@language":"en","@value":"LGBTQ+ people who have experienced sexual abuse and may or may not have survived; follow the individual's preference for \"victims\" or \"survivors\" whenever possible."},{"@language":"es","@value":"Personas LGBTQ+ que han sufrido abuso sexual y pueden o no haber sobrevivido; siga la preferencia de la persona sobre el uso de \"víctimas\" o \"sobrevivientes\" siempre que sea posible."},{"@language":"fr","@value":"Personnes LGBTQ+ ayant vécu de l'abus sexuel et qui peuvent ou non y avoir survécu; respecter la préférence de la personne concernée entre les termes « victimes » ou « survivantes » dans la mesure du possible."},{"@language":"nl","@value":"LHBTQ+-personen die seksueel misbruik hebben meegemaakt en het al dan niet hebben overleefd; volg waar mogelijk de voorkeur van het individu voor \"slachtoffers\" of \"overlevenden\"."},{"@language":"sv","@value":"Hbtq+-personer som har utsatts för sexuella övergrepp och som kan ha överlevt eller inte. Följ individens preferens för att använda ”offer” eller ”överlevare” när det är möjligt."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000312"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000198"},{"@id":"https://homosaurus.org/v5/homoit0000550"},{"@id":"https://homosaurus.org/v5/homoit0000794"},{"@id":"https://homosaurus.org/v5/homoit0000885"},{"@id":"https://homosaurus.org/v5/homoit0000958"},{"@id":"https://homosaurus.org/v5/homoit0001223"},{"@id":"https://homosaurus.org/v5/homoit0001307"},{"@id":"https://homosaurus.org/v5/homoit0001351"},{"@id":"https://homosaurus.org/v5/homoit0001458"},{"@id":"https://homosaurus.org/v5/homoit0002856"},{"@id":"https://homosaurus.org/v5/homoit0002949"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000059"},{"@id":"https://homosaurus.org/v5/homoit0000302"},{"@id":"https://homosaurus.org/v5/homoit0000855"},{"@id":"https://homosaurus.org/v5/homoit0000938"},{"@id":"https://homosaurus.org/v5/homoit0002195"},{"@id":"https://homosaurus.org/v5/homoit0002734"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/victimsOfSexualAbuseLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001108","dc:identifier":"homoit0001108","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ persecutions"},{"@language":"es","@value":"Persecuciones LGBTQ+"},{"@language":"nl","@value":"LHBTQ+-vervolgingen"},{"@language":"sv","@value":"Förföljelse av hbtq+-personer"}],"skos:altLabel":[{"@language":"en","@value":"Persecutions (LGBTQ)"},{"@language":"es","@value":"Persecuciones (LGBTQ)"}],"rdfs:comment":[{"@language":"en","@value":"Systematic mistreatment of LGBTQ+ people on the basis of their gender or sexual identities."},{"@language":"es","@value":"Maltrato sistemático a personas LGBTQ+ por su género o identidad sexual."},{"@language":"nl","@value":"Systematische mishandeling van LHBTQ+-personen op basis van hun gender of seksuele identiteit."},{"@language":"sv","@value":"Systematisk orättvis eller kränkande behandling av hbtq+-personer på grund av deras könsidentitet eller sexuella identitet."}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000850"},{"@id":"https://homosaurus.org/v5/homoit0001103"},{"@id":"https://homosaurus.org/v5/homoit0001104"},{"@id":"https://homosaurus.org/v5/homoit0001105"},{"@id":"https://homosaurus.org/v5/homoit0001106"},{"@id":"https://homosaurus.org/v5/homoit0001107"},{"@id":"https://homosaurus.org/v5/homoit0002744"},{"@id":"https://homosaurus.org/v5/homoit0002912"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000059"},{"@id":"https://homosaurus.org/v5/homoit0000068"},{"@id":"https://homosaurus.org/v5/homoit0000356"},{"@id":"https://homosaurus.org/v5/homoit0000580"},{"@id":"https://homosaurus.org/v5/homoit0000701"},{"@id":"https://homosaurus.org/v5/homoit0000927"},{"@id":"https://homosaurus.org/v5/homoit0001482"},{"@id":"https://homosaurus.org/v5/homoit0001560"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001108"},"dc:replaces":{"@id":"http://homosaurus.org/v2/persecutionsLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001293","dc:identifier":"homoit0001293","skos:prefLabel":[{"@language":"en","@value":"Sexual harassment"},{"@language":"es","@value":"Acoso sexual"},{"@language":"nl","@value":"Seksuele intimidatie"},{"@language":"sv","@value":"Sexuella trakasserier"}],"rdfs:comment":[{"@language":"en","@value":"Unwelcome behavior of a sexual nature, including unwanted advances or requests for sexual favors."},{"@language":"es","@value":"Comportamiento no deseado de naturaleza sexual, incluidos insinuaciones no deseadas o pedidos de favores sexuales."},{"@language":"nl","@value":"Ongewenst gedrag van seksuele aard, inclusief ongewenste avances of verzoeken om seksuele gunsten."},{"@language":"sv","@value":"Oönskat beteende av sexuell natur, inklusive ovälkomna närmanden eller begäran om sexuella handlingar."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000611"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000059"},{"@id":"https://homosaurus.org/v5/homoit0000675"},{"@id":"https://homosaurus.org/v5/homoit0001278"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85120735"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000611"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sexualHarassment"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001305","dc:identifier":"homoit0001305","skos:prefLabel":[{"@language":"en","@value":"Sexual violence"},{"@language":"es","@value":"Violencia sexual"},{"@language":"nl","@value":"Seksueel geweld"},{"@language":"sv","@value":"Sexuellt våld"}],"rdfs:comment":[{"@language":"en","@value":"Sexual acts or attempts to coerce sexual acts that involve the use of non-consensual violence. This term encompasses sexual assault, rape, and sexual abuse."},{"@language":"es","@value":"Actos sexuales o intentos de coercer a actos sexuales que impliquen el uso de violencia no consentida. Este término abarca la agresión sexual, la violación y el abuso sexual."},{"@language":"nl","@value":"Seksuele handelingen of pogingen om seksuele handelingen af te dwingen waarbij gebruik wordt gemaakt van niet-consensueel geweld. Deze term omvat aanranding, verkrachting en seksueel misbruik."},{"@language":"sv","@value":"Sexuella handlingar eller försök att tvinga till sexuella handlingar som innebär användning av icke-samtyckt våld. Termen omfattar sexuella övergrepp, våldtäkt och sexuellt utnyttjande."}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000306"},{"@id":"https://homosaurus.org/v5/homoit0000855"},{"@id":"https://homosaurus.org/v5/homoit0000938"},{"@id":"https://homosaurus.org/v5/homoit0000958"},{"@id":"https://homosaurus.org/v5/homoit0001285"},{"@id":"https://homosaurus.org/v5/homoit0003433"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000059"},{"@id":"https://homosaurus.org/v5/homoit0002195"},{"@id":"https://homosaurus.org/v5/homoit0003444"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85120572"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001305"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sexualViolence"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001348","dc:identifier":"homoit0001348","skos:prefLabel":[{"@language":"en","@value":"Survivors of anti-LGBTQ+ violence"},{"@language":"es","@value":"Sobrevivientes de violencia anti-LGBTQ+"},{"@language":"nl","@value":"Overlevenden van anti-LHBTQ+ geweld"},{"@language":"sv","@value":"Hatbrottsöverlevare (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"Survivors of anti-LGBTQ violence"},{"@language":"es","@value":"Sobrevivientes de violencia anti-LGBTQ"}],"rdfs:comment":[{"@language":"en","@value":"People who have experienced and survived anti-LGBTQ+ violence; follow individuals’ preference for “victims” or “survivors” whenever possible."},{"@language":"es","@value":"Personas que han sufrido y sobrevivido la violencia anti-LGBTQ+; siga la preferencia de la persona sobre el uso de \"víctimas\" o \"sobrevivientes\" siempre que sea posible"},{"@language":"nl","@value":"Personen die anti-LHBTQ+-geweld hebben meegemaakt en overleefd; volg waar mogelijk de voorkeur van individuen voor \"slachtoffers\" of \"overlevenden\"."},{"@language":"sv","@value":"Personer som har utsatts för och överlevt anti-hbtq+-våld. Följ individens eget språkbruk om de föredrar termen offer eller överlevare."}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000059"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001348"},"dc:replaces":{"@id":"http://homosaurus.org/v2/survivorsOfAntiLGBTQViolence"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000060","dc:identifier":"homoit0000060","skos:prefLabel":[{"@language":"en","@value":"Anti-queer discrimination"},{"@language":"es","@value":"Discriminación anti-queer"},{"@language":"de","@value":"Queerfeindliche Diskriminierung"},{"@language":"nl","@value":"Anti-queer discriminatie"},{"@language":"sv","@value":"Diskriminering av queera personer"}],"skos:altLabel":[{"@language":"de","@value":"Anti-queere Diskriminierung"},{"@language":"de","@value":"Antiqueere Diskriminierung"},{"@language":"de","@value":"Diskriminierung von queeren Personen"}],"rdfs:comment":[{"@language":"en","@value":"The unjust or prejudicial treatment of queer people due to their identity; may include the denial of legal rights, employment, and housing."},{"@language":"es","@value":"El trato injusto o perjudicial hacia las personas queer por su identidad; puede incluir la negación de derechos legales, empleo y vivienda."},{"@language":"de","@value":"Die ungerechte oder vorurteilsbehaftete Behandlung von queeren Menschen aufgrund ihrer Identität; kann die Verweigerung von gesetzlichen Rechten, Beschäftigung und Wohnraum beinhalten."},{"@language":"nl","@value":"De onrechtvaardige of nadelige behandeling op basis van vooroordelen van queer personen vanwege hun identiteit; kan de ontkenning van wettelijke rechten, werkgelegenheid en huisvesting omvatten."},{"@language":"sv","@value":"Systematiskt orättvist eller fördomsfull behandling av queera personer på grund av deras identitet, uttryck eller tillhörighet, vilket kan ta sig uttryck i begränsad tillgång till arbete, bostad eller rättsligt erkännande."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000356"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001229"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000356"},"dc:replaces":{"@id":"http://homosaurus.org/v2/antiQueerDiscrimination"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001229","dc:identifier":"homoit0001229","skos:prefLabel":[{"@language":"en","@value":"Queerphobia"},{"@language":"es","@value":"Queerfobia"},{"@language":"nl","@value":"Queerfobie"},{"@language":"sv","@value":"Queerfobi"}],"skos:altLabel":{"@language":"es","@value":"Cuirfobia"},"rdfs:comment":[{"@language":"en","@value":"Antagonism or disgust directed towards queerness as an identity or queer people due to their identity, perceived or actual. Queerphobia can include denial of the existence of queerness, stereotypes, verbal harassment, and physical violence."},{"@language":"es","@value":"Antagonismo o disgusto dirigido hacia lo queer como identidad o hacia las personas queer debido a su identidad, percibida o real. La queerfobia puede incluir la negación de la existencia de lo queer, estereotipos, acoso verbal y violencia física."},{"@language":"nl","@value":"Antagonisme of walging gericht tegen queerheid als identiteit of queer personen vanwege hun identiteit, waargenomen of actueel. Queerfobie kan bestaan uit ontkenning van het bestaan van queerheid, stereotypen, verbale intimidatie en fysiek geweld."},{"@language":"sv","@value":"Fientlighet eller avsky riktad mot queera identiteter eller queera personer, oavsett om identiteten är verklig eller upplevd. Queerfobi kan ta sig uttryck i förnekelse, stereotyper, verbala trakasserier och fysiskt våld."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000920"},"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0002594"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000060"},{"@id":"https://homosaurus.org/v5/homoit0000061"},{"@id":"https://homosaurus.org/v5/homoit0000619"},{"@id":"https://homosaurus.org/v5/homoit0001195"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000920"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerphobia"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000062","dc:identifier":"homoit0000062","skos:prefLabel":[{"@language":"en","@value":"Anti-transgender discrimination"},{"@language":"es","@value":"Discriminación anti-transgénero"},{"@language":"de","@value":"Transfeindliche Diskriminierung"},{"@language":"nl","@value":"Anti-transgender discriminatie"},{"@language":"sv","@value":"Diskriminering av transpersoner"}],"skos:altLabel":[{"@language":"de","@value":"Antitrans Diskriminierung"},{"@language":"de","@value":"Anti-trans Diskriminierung"},{"@language":"de","@value":"Diskriminierung von trans Personen"}],"rdfs:comment":[{"@language":"en","@value":"The unjust or prejudicial treatment of transgender people (or others perceived to be transgressing gender norms) due to their gender identity and/or expression; may include the denial of legal rights, employment, and housing."},{"@language":"es","@value":"El trato injusto o perjudicial hacia las personas transgénero (u otras personas percibidas como transgresoras de las normas de género) por su identidad y/o expresión de género; puede incluir la negación de derechos legales, empleo y vivienda."},{"@language":"de","@value":"Die ungerechte oder vorurteilsbehaftete Behandlung von trans Personen (oder anderen Personen, die als abweichend von der Geschlechternorm wahrgenommen werden) aufgrund ihrer Geschlechtsidentität und/oder ihres Geschlechtsausdrucks; dies kann die Verweigerung von gesetzlichen Rechten, Beschäftigung und Wohnraum beinhalten."},{"@language":"nl","@value":"De onrechtvaardige of nadelige behandeling op basis van vooroordelen van transgender personen (of anderen die worden gezien als overtreders van gendernormen) vanwege hun genderidentiteit en/of genderexpressie; kan de ontkenning van wettelijke rechten, werkgelegenheid en huisvesting omvatten."},{"@language":"sv","@value":"Systematiskt orättvist eller fördomsfull behandling av transpersoner (eller andra som uppfattas bryta mot könsnormer) på grund av deras könsidentitet och/eller könsuttryck vilket kan ta sig uttryck i begränsad tillgång till arbete, bostad eller rättsligt erkännande."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000356"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000336"},{"@id":"https://homosaurus.org/v5/homoit0001819"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001006"},{"@id":"https://homosaurus.org/v5/homoit0001139"},{"@id":"https://homosaurus.org/v5/homoit0001140"},{"@id":"https://homosaurus.org/v5/homoit0001141"},{"@id":"https://homosaurus.org/v5/homoit0001467"},{"@id":"https://homosaurus.org/v5/homoit0001516"},{"@id":"https://homosaurus.org/v5/homoit0001892"},{"@id":"https://homosaurus.org/v5/homoit0001903"},{"@id":"https://homosaurus.org/v5/homoit0003158"},{"@id":"https://homosaurus.org/v5/homoit0003499"},{"@id":"https://homosaurus.org/v5/homoit0003737"},{"@id":"https://homosaurus.org/v5/homoit0004327"}],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2010012303"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000356"},"dc:replaces":{"@id":"http://homosaurus.org/v2/antiTransgenderDiscrimination"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000336","dc:identifier":"homoit0000336","skos:prefLabel":[{"@language":"en","@value":"Deadnaming"},{"@language":"es","@value":"Deadnaming"},{"@language":"de","@value":"Deadnaming"},{"@language":"fr","@value":"Morinommer"},{"@language":"nl","@value":"Deadnaming"},{"@language":"sv","@value":"Dödnamna"}],"skos:altLabel":[{"@language":"es","@value":"Uso del nombre muerto"},{"@language":"es","@value":"Uso del nombre pasado"},{"@language":"es","@value":"Necrónimo"},{"@language":"es","@value":"Necronombre"},{"@language":"sv","@value":"Deadnaming"}],"rdfs:comment":[{"@language":"en","@value":"The act of using or referring to a person’s assigned name rather than their chosen name, commonly with malicious intent."},{"@language":"es","@value":"El acto de usar o hacer referencia al nombre asignado de una persona en lugar de utilizar su nombre elegido, comúnmente con intenciones maliciosas."},{"@language":"de","@value":"Die Verwendung oder Bezugnahme auf den zugewiesenen Namen einer Person anstelle ihres selbst gewählten Namens, häufig in böswilliger Absicht."},{"@language":"fr","@value":"Désigner une personne avec le prénom qui lui a été assigné à la naissance plutôt qu'avec le prénom qu'elle a choisi."},{"@language":"nl","@value":"Verwijzen naar de toegewezen naam van een persoon in plaats van de gekozen naam, vaak met kwade bedoelingen"},{"@language":"sv","@value":"Handlingen att använda eller hänvisa till en persons tilldelade namn istället för deras valda namn, vanligtvis med ont uppsåt."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000062"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001016"},{"@id":"https://homosaurus.org/v5/homoit0001065"},{"@id":"https://homosaurus.org/v5/homoit0001560"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000356"},"dc:replaces":{"@id":"http://homosaurus.org/v2/deadnaming"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001819","dc:identifier":"homoit0001819","skos:prefLabel":[{"@language":"en","@value":"Trans exclusivity"},{"@language":"es","@value":"Exclusión trans"},{"@language":"nl","@value":"Trans exclusiviteit"},{"@language":"sv","@value":"Transexkludering"}],"skos:altLabel":[{"@language":"en","@value":"Trans exclusion"},{"@language":"en","@value":"Trans exclusive"},{"@language":"en","@value":"Trans-exclusive"},{"@language":"nl","@value":"Trans exclusief"},{"@language":"nl","@value":"Trans-exclusief"}],"rdfs:comment":[{"@language":"en","@value":"The practice or policy of denying equal access and support to trans people."},{"@language":"es","@value":"La práctica o política de negar la igualdad de acceso y apoyo a las personas trans."},{"@language":"nl","@value":"De praktijk of het beleid om transgender personen gelijke toegang en ondersteuning te ontzeggen."},{"@language":"sv","@value":"Praktik eller policy som innebär att transpersoner nekas lika tillgång och stöd."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000062"},{"@id":"https://homosaurus.org/v5/homoit0002291"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001139"},{"@id":"https://homosaurus.org/v5/homoit0001467"},{"@id":"https://homosaurus.org/v5/homoit0001516"},{"@id":"https://homosaurus.org/v5/homoit0003499"},{"@id":"https://homosaurus.org/v5/homoit0003737"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000356"},"dc:issued":{"@type":"xsd:date","@value":"2022-02-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001006","dc:identifier":"homoit0001006","skos:prefLabel":[{"@language":"en-us","@value":"Medicalization"},{"@language":"es","@value":"Medicalización"},{"@language":"nl","@value":"Medicalisering"},{"@language":"sv","@value":"Medikalisering"},{"@language":"en-gb","@value":"Medicalisation"}],"skos:altLabel":{"@language":"sv","@value":"Patologisering"},"rdfs:comment":[{"@language":"en","@value":"Process by which human conditions and experiences come to be defined and treated as medical conditions and thus become the subject of medical study, diagnosis, prevention, and/or treatment. Use in reference to non-medical problems, such as LGBTQ+ identities and practices, that have been wrongly treated as medical issues."},{"@language":"es","@value":"Proceso por el cual las condiciones y experiencias humanas pasan a definirse y tratarse como condiciones médicas y, por tanto, a convertirse en objeto de estudio, diagnóstico, prevención y/o tratamiento médico. Utilícese en referencia a problemas no médicos, tales como identidades y prácticas LGBTQ+, que han sido erróneamente tratadas como problemas médicos."},{"@language":"nl","@value":"Proces waarbij menselijke condities en problemen worden gedefinieerd en behandeld als medische aandoeningen en zo het onderwerp worden van medische studie, diagnose, preventie of behandeling. Gebruik met betrekking tot niet-medische problemen, zoals LHBTQ+-identiteiten en -praktijken, die ten onrechte als medisch zijn behandeld."},{"@language":"sv","@value":"Processen där mänskliga erfarenheter och tillstånd felaktigt definieras som medicinska tillstånd och därmed blir föremål för medicinska studier, diagnoser, behandling eller förebyggande åtgärder. Används för att beskriva hur t.ex. hbtq+-identiteter felaktigt behandlats som medicinska problem."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001004"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000395"},{"@id":"https://homosaurus.org/v5/homoit0000572"},{"@id":"https://homosaurus.org/v5/homoit0000669"},{"@id":"https://homosaurus.org/v5/homoit0001296"},{"@id":"https://homosaurus.org/v5/homoit0001463"},{"@id":"https://homosaurus.org/v5/homoit0001468"},{"@id":"https://homosaurus.org/v5/homoit0001469"},{"@id":"https://homosaurus.org/v5/homoit0003910"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000062"},{"@id":"https://homosaurus.org/v5/homoit0000357"},{"@id":"https://homosaurus.org/v5/homoit0000567"},{"@id":"https://homosaurus.org/v5/homoit0001268"},{"@id":"https://homosaurus.org/v5/homoit0001320"},{"@id":"https://homosaurus.org/v5/homoit0002835"},{"@id":"https://homosaurus.org/v5/homoit0002841"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2016000450"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001004"},"dc:replaces":{"@id":"http://homosaurus.org/v2/medicalisation"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001139","dc:identifier":"homoit0001139","skos:prefLabel":[{"@language":"en","@value":"Bathroom bans"},{"@language":"de","@value":"Bathroom Bans"},{"@language":"es","@value":"Prohibición del acceso a baños"},{"@language":"nl","@value":"Toiletverboden"},{"@language":"sv","@value":"Toalettförbud för transpersoner"}],"skos:altLabel":[{"@language":"en","@value":"Changing room bans"},{"@language":"en","@value":"Locker room bans"},{"@language":"en","@value":"Restroom bans"},{"@language":"de","@value":"Toilettenzugangsverbote"},{"@language":"de","@value":"Toilettenverweise"},{"@language":"es","@value":"Prohibiciones de acceso a baños"},{"@language":"es","@value":"Prohibiciones de baños"},{"@language":"es","@value":"Prohibición del acceso a vestidores"},{"@language":"nl","@value":"Kleedkamer-verboden"},{"@language":"nl","@value":"Kleedruimte-verboden"},{"@language":"sv","@value":"Toalettregler"},{"@language":"sv","@value":"Toalettbestämmelser"},{"@language":"sv","@value":"Bathroom bans"}],"rdfs:comment":[{"@language":"en","@value":"Laws or policies instituted to prevent trans and non-binary individuals from using public bathrooms and facilities, such as locker rooms, shower rooms, changing rooms, and other sex-segregated spaces, on the basis of their gender identity."},{"@language":"de","@value":"Gesetze oder politische Maßnahmen, die trans und nichtbinäre Personen aufgrund ihrer Geschlechtsidentität daran hindern, öffentliche Toiletten und Einrichtungen wie Umkleideräume, Duschen, Umkleidekabinen und andere geschlechtergetrennte Räume zu benutzen"},{"@language":"es","@value":"Leyes o políticas instituidas para evitar que las personas trans y no binarias utilicen baños e instalaciones públicas como vestidores, duchas, vestuarios y otros espacios segregados por sexo, en función de su identidad de género."},{"@language":"nl","@value":"Wetten of beleidsmaatregelen die zijn ingesteld om te voorkomen dat trans- en non-binaire personen gebruikmaken van openbare toiletten en faciliteiten, zoals kleedkamers, kleedruimtes, doucheruimtes en andere ruimtes waar de seksen gescheiden zijn, op basis van hun genderidentiteit."},{"@language":"sv","@value":"Lagar eller policyer som införs för att förhindra transpersoner och ickebinära personer från att använda offentliga toaletter och faciliteter, såsom omklädningsrum, duschar, provhytter och andra könsuppdelade utrymmen, baserat på deras könsidentitet."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0003499"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000248"},{"@id":"https://homosaurus.org/v5/homoit0000975"},{"@id":"https://homosaurus.org/v5/homoit0001140"},{"@id":"https://homosaurus.org/v5/homoit0001141"},{"@id":"https://homosaurus.org/v5/homoit0001143"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000702"},"dc:replaces":{"@id":"http://homosaurus.org/v2/publicBathroomBills"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001140","dc:identifier":"homoit0001140","skos:prefLabel":[{"@language":"en","@value":"Public bathrooms"},{"@language":"es","@value":"Baños públicos"},{"@language":"nl","@value":"Openbare toiletten"},{"@language":"sv","@value":"Offentliga toaletter"}],"skos:altLabel":[{"@language":"en","@value":"Public restrooms"},{"@language":"en","@value":"Toilets"},{"@language":"es","@value":"Baños||"}],"rdfs:comment":[{"@language":"en","@value":"Rooms or small buildings with one or more toilets (or urinals) available for use by the general public or by customers or employees of a business."},{"@language":"es","@value":"Habitaciones o pequeños edificios con uno o más inodoros (o urinarios) disponibles para el uso del público en general o de clientes o empleados de un negocio."},{"@language":"sv","@value":"Rum eller små byggnader med en eller flera toaletter (eller urinoarer) som är tillgängliga för allmänheten eller för kunder och anställda i en verksamhet."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001141"},"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0000595"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000062"},{"@id":"https://homosaurus.org/v5/homoit0000308"},{"@id":"https://homosaurus.org/v5/homoit0001090"},{"@id":"https://homosaurus.org/v5/homoit0001139"},{"@id":"https://homosaurus.org/v5/homoit0001358"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85108627"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001141"},"dc:replaces":{"@id":"http://homosaurus.org/v2/publicBathrooms"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001467","dc:identifier":"homoit0001467","skos:prefLabel":[{"@language":"en","@value":"Transphobia"},{"@language":"es","@value":"Transfobia"},{"@language":"nl","@value":"Transfobie"},{"@language":"sv","@value":"Transfobi"}],"rdfs:comment":[{"@language":"en","@value":"Antagonism or disgust directed toward trans individuals (or others perceived to be transgressing gender norms) due to their gender identity and/or expression. Transphobia can include denial of the existence of trans identities, stereotypes, verbal harassment, and physical violence."},{"@language":"es","@value":"Antagonismo o disgusto dirigido hacia personas trans (u otras personas percibidas como transgresoras de las normas de género) debido a su identidad y/o expresión de género. La transfobia puede incluir la negación de la existencia de identidades trans, estereotipos, acoso verbal y violencia física."},{"@language":"nl","@value":"Antagonisme of afkeer gericht tegen trans-individuen (of anderen die worden gezien als personen die gendernormen overtreden) vanwege hun genderidentiteit en/of -expressie. Transfobie kan bestaan uit ontkenning van het bestaan van trans-identiteiten, stereotypen, verbale intimidatie en fysiek geweld."},{"@language":"sv","@value":"Fientlighet eller avsky riktad mot transpersoner eller andra som uppfattas bryta mot könsnormer, på grund av deras könsidentitet och/eller könsuttryck. Transfobi kan omfatta förnekelse av transidentiteter, stereotyper, verbala trakasserier och fysiskt våld."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000920"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0002212"},{"@id":"https://homosaurus.org/v5/homoit0002593"},{"@id":"https://homosaurus.org/v5/homoit0003158"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000062"},{"@id":"https://homosaurus.org/v5/homoit0000063"},{"@id":"https://homosaurus.org/v5/homoit0000619"},{"@id":"https://homosaurus.org/v5/homoit0001378"},{"@id":"https://homosaurus.org/v5/homoit0001819"},{"@id":"https://homosaurus.org/v5/homoit0001892"},{"@id":"https://homosaurus.org/v5/homoit0001903"},{"@id":"https://homosaurus.org/v5/homoit0003499"},{"@id":"https://homosaurus.org/v5/homoit0003737"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2010012303"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000920"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transphobia"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001516","dc:identifier":"homoit0001516","skos:prefLabel":[{"@language":"en","@value":"Womyn"},{"@language":"es","@value":"Womyn"},{"@language":"de","@value":"Womyn"},{"@language":"nl","@value":"Womyn"},{"@language":"sv","@value":"Womyn"}],"rdfs:comment":[{"@language":"en","@value":"A spelling of \"woman\" or \"women\" that first appeared in print in 1976 and is used in certain feminist circles to avoid having the suffix of \"men.\"  Some contemporary transgender activists have criticized use of the word \"womyn\" due to its prevalence in trans-exclusionary radical feminist (TERF) circles following the exclusion of trans women from the Michigan Womyn’s Music Festival."},{"@language":"es","@value":"Una grafía de \"woman\" o \"women\" (que en español significa \"mujer\" o \"mujeres\") que apareció impresa por primera vez en 1976 y se utiliza en ciertos círculos feministas para evitar tener el sufijo \"men\" (que en español significa \"hombres\"). Algunos activistas transgénero contemporáneos han criticado el uso de la palabra \"womyn\" debido a su prevalencia en los círculos feministas radicales transexclusivos (TERF) tras la exclusión de las mujeres trans del Festival de Música Womyn de Michigan."},{"@language":"de","@value":"Eine Schreibweise von „woman“ oder „women“, die erstmals 1976 in gedruckter Form erschien und in bestimmten feministischen Kreisen verwendet wird, um die Endung „men“ zu vermeiden. Einige zeitgenössische Transgender-Aktivisten haben die Verwendung des Wortes „womyn“ kritisiert, da es in Kreisen der trans-ausschließenden radikalen Feministinnen (TERF) nach dem Ausschluss von Transfrauen vom Michigan Womyn’s Music Festival weit verbreitet ist."},{"@language":"nl","@value":"Een spelling in de USA van \"vrouw\" of \"vrouwen\" die voor het eerst in druk verscheen in 1976 en die in bepaalde feministische kringen wordt gebruikt; sommige hedendaagse transgender-activisten hebben kritiek geuit op het gebruik van het woord \"womyn\" vanwege de prevalentie ervan in trans-uitgesloten radicale feministische (TERF) kringen na de uitsluiting van transvrouwen van het Michigan Womyn's Music Festival"},{"@language":"sv","@value":"Ett sätt att stava ”woman” eller ”women” som först användes i tryck 1976 och som används i vissa feministiska kretsar för att undvika ändelsen ”-men”. Vissa samtida transaktivister har kritiserat användningen av ”womyn” eftersom ordet förekommer i transuteslutande radikalfeministiska (TERF) sammanhang, särskilt i samband med uteslutningen av transkvinnor från Michigan Womyn’s Music Festival."}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000062"},{"@id":"https://homosaurus.org/v5/homoit0000437"},{"@id":"https://homosaurus.org/v5/homoit0001230"},{"@id":"https://homosaurus.org/v5/homoit0001505"},{"@id":"https://homosaurus.org/v5/homoit0001509"},{"@id":"https://homosaurus.org/v5/homoit0001515"},{"@id":"https://homosaurus.org/v5/homoit0001819"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85147274"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001516"},"dc:replaces":{"@id":"http://homosaurus.org/v2/womyn"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001892","dc:identifier":"homoit0001892","skos:prefLabel":[{"@language":"en","@value":"Transmisogyny"},{"@language":"es","@value":"Transmisoginia"},{"@language":"nl","@value":"Transmisogynie"},{"@language":"sv","@value":"Transmisogyni"}],"rdfs:comment":[{"@language":"en","@value":"The intersection of transphobia and misogyny as directed toward trans women and transfeminine people."},{"@language":"es","@value":"La intersección de la transfobia y la misoginia dirigida hacia las mujeres trans y las personas transfemeninas."},{"@language":"nl","@value":"De intersectie van transfobie en misogynie, gericht op transvrouwen en transfeminine personen"},{"@language":"sv","@value":"Skärningspunkten mellan transfobi och misogyni riktad mot transkvinnor och transfeminina personer."}],"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0003158"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000062"},{"@id":"https://homosaurus.org/v5/homoit0000112"},{"@id":"https://homosaurus.org/v5/homoit0001017"},{"@id":"https://homosaurus.org/v5/homoit0001467"},{"@id":"https://homosaurus.org/v5/homoit0001903"},{"@id":"https://homosaurus.org/v5/homoit0001904"},{"@id":"https://homosaurus.org/v5/homoit0002273"},{"@id":"https://homosaurus.org/v5/homoit0002274"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001892"},"dc:issued":{"@type":"xsd:date","@value":"2022-02-24"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001903","dc:identifier":"homoit0001903","skos:prefLabel":[{"@language":"en","@value":"Transmisogynoir"},{"@language":"es","@value":"Transmisoginoir"},{"@language":"nl","@value":"Transmisogynoir"},{"@language":"sv","@value":"Transmisogynoir"}],"rdfs:comment":[{"@language":"en","@value":"Term coined by coined by Trudy of the womanist blog Gradient Lair to describe the intersection of transphobia, misogyny, and anti-Black racism as directed toward Black trans women."},{"@language":"es","@value":"Término acuñado por Trudy del blog mujerista Gradient Lair para describir la intersección de la transfobia, la misoginia y el racismo anti-negro dirigido hacia las mujeres trans negras."},{"@language":"nl","@value":"Term bedacht door Trudy van de womanistische blog Gradient Lair om de intersectie van transfobie, vrouwenhaat en anti-zwart racisme te beschrijven, gericht op zwarte transvrouwen"},{"@language":"sv","@value":"Term myntad av Trudy från den womanistiska (en term inom svart feministisk teoribildning) bloggen Gradient Lair för att beskriva skärningspunkten mellan transfobi, misogyni och antimuslimsk rasism riktad mot svarta transkvinnor."}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000062"},{"@id":"https://homosaurus.org/v5/homoit0000112"},{"@id":"https://homosaurus.org/v5/homoit0001017"},{"@id":"https://homosaurus.org/v5/homoit0001467"},{"@id":"https://homosaurus.org/v5/homoit0001892"},{"@id":"https://homosaurus.org/v5/homoit0001902"},{"@id":"https://homosaurus.org/v5/homoit0001904"},{"@id":"https://homosaurus.org/v5/homoit0002038"},{"@id":"https://homosaurus.org/v5/homoit0002257"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001903"},"dc:issued":{"@type":"xsd:date","@value":"2022-03-29"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003158","dc:identifier":"homoit0003158","skos:prefLabel":[{"@language":"en","@value":"Trans-exclusionary radical feminism"},{"@language":"es","@value":"Feminismo radical trans-excluyente"},{"@language":"nl","@value":"Trans-uitsluitend radicaal feminisme"},{"@language":"sv","@value":"Transexkluderande radikalfeminism"}],"skos:altLabel":[{"@language":"en","@value":"Gender critical feminism"},{"@language":"en","@value":"TERF ideology"},{"@language":"en","@value":"Trans-exclusionary feminism"},{"@language":"es","@value":"Ideología TERF"},{"@language":"es","@value":"Femismo trans-excluyente"},{"@language":"es","@value":"Feminismo crítico de género"},{"@language":"nl","@value":"TERF ideologie"},{"@language":"nl","@value":"Trans-uitsluitend feminisme"}],"rdfs:comment":[{"@language":"en","@value":"A transphobic and transantagonistic ideology that rejects trans and gender diverse identities and rights, and believes that recognition of these identities and rights constitutes discrimination and oppression towards cisgender women. Though originally considered a fringe offshoot of feminism, trans-exclusionary radical feminist groups have formed alliances with right-wing, far-right extremists, and anti-feminist organizations in order to spread misinformation and further anti-trans sentiment and legislation. "},{"@language":"es","@value":"Una ideología transfóbica y transantagonista que rechaza las identidades y los derechos trans y de género diverso, y cree que el reconocimiento de estas identidades y estos derechos constituye discriminación y opresión hacia las mujeres cisgénero. Aunque originalmente se les consideró una rama marginal del feminismo, los grupos feministas radicales trans-excluyente han formado alianzas con organizaciones antifeministas, de derecha y de extrema derecha para difundir información errónea y promover el sentimiento y la legislación anti-trans."},{"@language":"nl","@value":"Een transfobe en transantagonistische ideologie die trans- en genderdiverse identiteiten en rechten verwerpt en gelooft dat erkenning van deze identiteiten en rechten discriminatie en onderdrukking van cisgender vrouwen inhoudt. Hoewel oorspronkelijk beschouwd als een marginale uitloper van het feminisme, hebben trans-uitsluitende radicaal-feministische groepen allianties gevormd met rechtse, radicaalrechtse extremisten en antifeministische organisaties om misinformatie te verspreiden en anti-trans sentiment en wetgeving te bevorderen."},{"@language":"sv","@value":"En transfobisk och transfientlig ideologi som förnekar transpersoners och könsöverskridande individers existens och rättigheter samt hävdar att erkännandet av dessa innebär diskriminering och förtryck av ciskvinnor. Även om rörelsen ursprungligen betraktades som en perifer gren av feminismen har grupper inom denna ideologi bildat allianser med högerextrema, antifeministiska och konservativa aktörer i syfte att sprida desinformation och driva transfientlig politik."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000115"},{"@id":"https://homosaurus.org/v5/homoit0000565"},{"@id":"https://homosaurus.org/v5/homoit0001467"},{"@id":"https://homosaurus.org/v5/homoit0001892"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000062"},{"@id":"https://homosaurus.org/v5/homoit0000437"},{"@id":"https://homosaurus.org/v5/homoit0001260"},{"@id":"https://homosaurus.org/v5/homoit0001885"},{"@id":"https://homosaurus.org/v5/homoit0003157"},{"@id":"https://homosaurus.org/v5/homoit0003737"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001365"},"dc:issued":{"@type":"xsd:date","@value":"2024-01-02"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003499","dc:identifier":"homoit0003499","skos:prefLabel":[{"@language":"en","@value":"Anti-transgender legislation"},{"@language":"de","@value":"Transfeindliche Gesetze"},{"@language":"es","@value":"Leyes anti-transgénero"},{"@language":"nl","@value":"Anti-transgender wetgeving"},{"@language":"sv","@value":"Antitranslagstiftning"}],"skos:altLabel":[{"@language":"en","@value":"Anti-trans law-making"},{"@language":"en","@value":"Anti-trans legislation"},{"@language":"en","@value":"Anti-transgender law-making"},{"@language":"de","@value":"Anti-trans-Gesetzgebung"},{"@language":"de","@value":"Transfeindliche Gesetzgebung"},{"@language":"es","@value":"Leyes anti-trans"},{"@language":"es","@value":"Leyes anti trans"},{"@language":"es","@value":"Leyes antitrans"},{"@language":"es","@value":"Leyes anti-transgénero"},{"@language":"es","@value":"Leyes anti transgénero"},{"@language":"es","@value":"Leyes antitransgénero"}],"rdfs:comment":[{"@language":"en","@value":"Efforts to propose, enact, amend, or strike down laws as a means of restricting the legal rights of transgender people. This includes legislation regarding access to gender-affirming healthcare, participation in sporting events, administrative and judicial procedures such as sex and name registration, and policies affecting the medical treatment, education, and mental health care of transgender youth."},{"@language":"de","@value":"Bemühungen, Gesetze vorzuschlagen, zu erlassen, zu ändern oder aufzuheben, um die gesetzlichen Rechte von trans Personen einzuschränken. Dazu gehören Gesetze, die den Zugang zu geschlechtsangleichender Gesundheitsfürsorge, die Teilnahme an Sportveranstaltungen, Verwaltungs- und Gerichtsverfahren wie die Eintragung von Geschlecht und Namen sowie Maßnahmen, die sich auf die medizinische Behandlung, Bildung und mentale Gesundheitsfürsorge von Transgender-Jugendlichen auswirken, betreffen."},{"@language":"es","@value":"Esfuerzos para proponer, promulgar, modificar o derogar leyes como medio para restringir los derechos legales de las personas transgénero. Esto incluye la legislación sobre el acceso a servicios de salud que afirmen el género, la participación en eventos deportivos, los procedimientos administrativos y judiciales como el registro de sexo y nombre, y las políticas que afectan el tratamiento médico, la educación y la atención de salud mental de lxs jóvenes transgénero."},{"@language":"nl","@value":"Pogingen om wetten voor te stellen, af te kondigen, te wijzigen of af te schaffen als middel om de wettelijke rechten van transgender personen te beperken. Dit omvat wetgeving met betrekking tot toegang tot genderbevestigende gezondheidszorg, deelname aan sportevenementen, administratieve en gerechtelijke procedures zoals geslachts- en naamregistratie, en beleid dat van invloed is op de medische behandeling, het onderwijs en de geestelijke gezondheidszorg van transgenderjongeren."},{"@language":"sv","@value":"Insatser för att föreslå, införa, ändra eller upphäva lagar, i syfte att begränsa transpersoners juridiska rättigheter. Detta inkluderar lagstiftning rörande tillgång till könsbekräftande vård, deltagande i idrott, administrativa och rättsliga processer såsom juridiskt kön och namnbyte samt policyer som påverkar unga transpersoners medicinska behandling, utbildning och psykiska hälsa."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000702"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0001139"},{"@id":"https://homosaurus.org/v5/homoit0003502"},{"@id":"https://homosaurus.org/v5/homoit0003503"},{"@id":"https://homosaurus.org/v5/homoit0003504"},{"@id":"https://homosaurus.org/v5/homoit0003510"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000062"},{"@id":"https://homosaurus.org/v5/homoit0000314"},{"@id":"https://homosaurus.org/v5/homoit0001467"},{"@id":"https://homosaurus.org/v5/homoit0001819"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000702"},"dc:issued":{"@type":"xsd:date","@value":"2024-07-31"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003737","dc:identifier":"homoit0003737","skos:prefLabel":[{"@language":"en","@value":"Anti-gender movement"},{"@language":"nl","@value":"Anti-genderbeweging"},{"@language":"sv","@value":"Antigenusrörelsen"}],"skos:altLabel":[{"@language":"en","@value":"Gender critical movement"},{"@language":"sv","@value":"Genuskritiska rörelsen"}],"rdfs:comment":[{"@language":"en","@value":"A movement that opposes what is referred to as \"gender ideology,\" or the belief that gender is a social construct that exists on a spectrum. Members of the anti-gender movement oppose the visibility, acceptance, and civil and reproductive rights of trans, non-binary, intersex, Two-Spirit, gender diverse, and gender non-conforming people."},{"@language":"nl","@value":"Een beweging die zich verzet tegen wat 'genderideologie' wordt genoemd, of het geloof dat gender een sociaal construct is dat bestaat op een spectrum. Leden van de anti-genderbeweging verzetten zich tegen de zichtbaarheid, acceptatie en burgerlijke en reproductieve rechten van trans, non-binaire, interseksuele, Two-Spirit, genderdiverse en gender-non-conforme mensen."},{"@language":"sv","@value":"En rörelse som motsätter sig det som benämns som ”genusideologi” eller uppfattningen att kön är en social konstruktion som existerar på ett spektrum. Medlemmar i antigenusrörelsen motsätter sig synligheten, acceptansen samt de civila och reproduktiva rättigheterna för transpersoner, ickebinära personer, intersexpersoner, Two-spirit-personer, könsvarierade och könsavvikande personer."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001322"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0003158"},{"@id":"https://homosaurus.org/v5/homoit0001819"},{"@id":"https://homosaurus.org/v5/homoit0001467"},{"@id":"https://homosaurus.org/v5/homoit0000062"},{"@id":"https://homosaurus.org/v5/homoit0001893"},{"@id":"https://homosaurus.org/v5/homoit0001885"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001322"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004327","dc:identifier":"homoit0004327","skos:prefLabel":[{"@language":"en","@value":"Detrans people"},{"@language":"nl","@value":"Detrans personen"},{"@language":"sv","@value":"Personer som detransitionerat"}],"skos:altLabel":[{"@language":"en","@value":"Detransitioners"},{"@language":"sv","@value":"Detransitionerande personer"},{"@language":"sv","@value":"Detransitionerade personer"},{"@language":"sv","@value":"Detranspersoner"}],"rdfs:comment":[{"@language":"en","@value":"People who cease or reverse the social and/or medical process of gender transitioning for any reason, including health concerns, lack of support, economic issues, personal safety, stigma, and a changing understanding of or relationship to their gender. Detransitioning may be temporary or permanent. Detrans people may still identify as trans or under the trans umbrella. Only use for people who self-identify as detrans or detransitioners."},{"@language":"nl","@value":"Personen die om welke reden dan ook stoppen met het sociale en/of medische proces van gendertransitie of dit terugdraaien. Redenen kunnen zijn gezondheidsproblemen, gebrek aan steun, economische problemen, persoonlijke veiligheid, stigma en een veranderend begrip van of relatie tot hun gender. Detransitie kan tijdelijk of permanent zijn. Detrans personen kunnen zich nog steeds identificeren als trans of onder de transparaplu vallen. Alleen gebruiken voor personen die zichzelf identificeren als detrans of detransitioners."},{"@language":"sv","@value":"Personer som upphör med eller återgår från en könstransition, socialt och/eller medicinskt, oavsett skäl. Orsakerna kan inkludera hälsoskäl, bristande stöd, ekonomiska skäl, personlig säkerhet eller en förändrad förståelse för - eller relation till - den egna könstillhörigheten. Detransition kan vara tillfällig eller permanent. Detransitionerande personer kan fortfarande identifiera sig som trans eller under transparaplyet. Används endast för personer som identifierar sig som detrans eller detransitionerande."}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001834"},{"@id":"https://homosaurus.org/v5/homoit0001464"},{"@id":"https://homosaurus.org/v5/homoit0001835"},{"@id":"https://homosaurus.org/v5/homoit0001836"},{"@id":"https://homosaurus.org/v5/homoit0001378"},{"@id":"https://homosaurus.org/v5/homoit0000062"},{"@id":"https://homosaurus.org/v5/homoit0003504"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0004327"},"dc:issued":{"@type":"xsd:date","@value":"2026-02-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000064","dc:identifier":"homoit0000064","skos:prefLabel":[{"@language":"en","@value":"Aphallia"},{"@language":"es","@value":"Afalia"},{"@language":"de","@value":"Aphallie"},{"@language":"nl","@value":"Aphallia"},{"@language":"sv","@value":"Penil agenesi"}],"skos:altLabel":[{"@language":"en","@value":"Penile agenesis"},{"@language":"de","@value":"Penisagenesie"},{"@language":"sv","@value":"Aphallia"}],"rdfs:comment":[{"@language":"en","@value":"People with aphallia have XY chromosomes, testes, and are born without a penis. They produce typical levels of testosterone, and they develop secondary sex characteristics associated with a typical testosterone puberty during adolescence."},{"@language":"es","@value":"Las personas con afalia tienen cromosomas XY, testículos y nacen sin pene. Producen niveles típicos de testosterona y desarrollan características sexuales secundarias asociadas a una pubertad típica con testosterona durante la adolescencia."},{"@language":"de","@value":"Menschen mit Aphallie haben XY-Chromosomen, Hoden und werden ohne Penis geboren. Sie produzieren die üblichen Mengen an Testosteron und entwickeln sekundäre Geschlechtsmerkmale, die mit einer typischen Testosteron-Pubertät in der Jugend assoziiert sind."},{"@language":"nl","@value":"Medische term voor een misvorming bij de geboorte waarbij de fallus (penis of clitoris) afwezig is"},{"@language":"sv","@value":"Personer med aphalia har en X- och en Y-kromosom (46XY), testiklar och föds utan penis. De producerar typiska nivåer av testosteron och utvecklar sekundära könskarakteristika kopplade till en typisk testosteronstyrd pubertet under tonåren."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000669"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001269"},"dc:replaces":{"@id":"http://homosaurus.org/v2/aphallia"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000065","dc:identifier":"homoit0000065","skos:prefLabel":[{"@language":"ta","@value":"Aravani"},{"@language":"de","@value":"Aravani"},{"@language":"es","@value":"Aravani"},{"@language":"nl","@value":"Aravani"},{"@language":"sv","@value":"Aravani"}],"skos:altLabel":[{"@language":"ta","@value":"Aruvani"},{"@language":"de","@value":"Hijra"},{"@language":"de","@value":"Aruvani"},{"@language":"de","@value":"Jagappa"},{"@language":"es","@value":"Aruvani"}],"rdfs:comment":[{"@language":"en","@value":"Indian term for people who identify as women trapped in male bodies; many prefer other terms, such as hijra or thirunangai."},{"@language":"de","@value":"Indische Bezeichnung für Menschen, die sich als Frauen identifizieren, die in einem männlichen Körper gefangen sind; viele bevorzugen andere Bezeichnungen, z.B. Hijra oder Thirunangai."},{"@language":"es","@value":"Término indio para personas que se autoidentificancomo mujeres atrapadas en cuerpos masculinos; muches prefieren otros términos, como hijra o thirunangai."},{"@language":"nl","@value":"Indiase term voor mensen die zich identificeren als vrouw, gevangen in een mannelijke lichaam; velen geven misschien de voorkeur aan de term hijra of thirunangai"},{"@language":"sv","@value":"Indisk term för personer som identifierar sig som kvinnor fångade i manliga kroppar. Många föredrar andra termer, såsom hijra eller thirunangai."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000322"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000632"},{"@id":"https://homosaurus.org/v5/homoit0001370"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/aravani"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000632","dc:identifier":"homoit0000632","skos:prefLabel":[{"@language":"hil","@value":"Hijras"},{"@language":"es","@value":"Hijras"},{"@language":"de","@value":"Hijras"},{"@language":"nl","@value":"Hijra's"},{"@language":"sv","@value":"Hijras"}],"skos:altLabel":{"@language":"de","@value":"Jagappa"},"rdfs:comment":[{"@language":"en","@value":"Hindi word used in South Asia to refer to people assigned male at birth who identify as women or “not-men.”"},{"@language":"es","@value":"Palabra hindi utilizada en el sur de Asia para referirse a personas asignadas al sexo masculino al nacer que se autoidentifican como mujeres o \"no hombres\"."},{"@language":"de","@value":"Ein in Südasien gebräuchlicher Hindi-Begriff für Menschen, denen bei der Geburt das männliche Geschlecht zugewiesen wurde, die sich jedoch als Frauen oder „Nicht-Männer“ identifizieren."},{"@language":"nl","@value":"Hindi-woord dat in Zuid-Azië wordt gebruikt om te verwijzen naar mensen die bij de geboorte als man zijn toegewezen en zich identificeren als vrouw of 'niet-man'"},{"@language":"sv","@value":"Hinditerm som används i Sydasien för att beskriva personer som tilldelats manligt kön vid födseln men som identifierar sig som kvinnor eller ”icke-män”."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000322"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000065"},{"@id":"https://homosaurus.org/v5/homoit0000240"},{"@id":"https://homosaurus.org/v5/homoit0000246"},{"@id":"https://homosaurus.org/v5/homoit0000684"},{"@id":"https://homosaurus.org/v5/homoit0000688"},{"@id":"https://homosaurus.org/v5/homoit0000690"},{"@id":"https://homosaurus.org/v5/homoit0000694"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/hijra"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001370","dc:identifier":"homoit0001370","skos:prefLabel":[{"@language":"ta","@value":"Thirunangai"},{"@language":"es","@value":"Thirunangai"},{"@language":"nl","@value":"Thirunangai"},{"@language":"sv","@value":"Thirunangai"}],"rdfs:comment":[{"@language":"en","@value":"Regional term in Tamil Nadu, India for people assigned male at birth who identify as women."},{"@language":"es","@value":"Término regional en Tamil Nadu, la India, para las personas asignadas al sexo masculino al nacer y que se autoidentifican como mujeres."},{"@language":"nl","@value":"Regionale term in Tamil Nadu, India voor mensen die bij de geboorte als man zijn toegewezen en zich als vrouw identificeren"},{"@language":"sv","@value":"Regional term i Tamil Nadu, Indien för personer som tilldelats manligt kön vid födseln och identifierar sig som kvinnor."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000322"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000065"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/thirunangai"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000066","dc:identifier":"homoit0000066","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ archives"},{"@language":"es","@value":"Archivos LGBTQ+"},{"@language":"ja","@value":"LGBTQ+のアーカイヴ"},{"@language":"fr","@value":"Archives LGBTQ+"},{"@language":"nl","@value":"LHBTQ+-archieven"},{"@language":"sv","@value":"Hbtq+-arkiv"}],"skos:altLabel":[{"@language":"en","@value":"LGBTQ archives"},{"@language":"en","@value":"Archives (LGBTQ)"},{"@language":"es","@value":"Archivos LGBTQ"},{"@language":"es","@value":"Archivos (LGBTQ)"},{"@language":"ja","@value":"LGBTQのアーカイヴ"},{"@language":"ja","@value":"アーカイヴ（LGBTQ）"},{"@language":"sv","@value":"Arkiv (hbtq+)"}],"rdfs:comment":[{"@language":"en","@value":"Collections of records and materials relating to LGBTQ+ people or LGBTQ+ communities; can include a variety of organizations and institutions from community to government archives."},{"@language":"es","@value":"Colecciones de registros y materiales relacionados con personas LGBTQ+ o comunidades LGBTQ+; puede incluir una variedad de organizaciones e instituciones, desde archivos comunitarios hasta gubernamentales."},{"@language":"ja","@value":"LGBTQ+の人々やLGBTQ+コミュニティに関連する記録や資料のコレクション。これには、地域コミュニティから政府の公文書館に至るまで、様々な組織や機関の資料が含まれる。"},{"@language":"fr","@value":"Collections d'archives et de documents relatifs aux personnes LGBTQ+ ou aux communautés LGBTQ+; peut inclure une variété d'organisations et d'institutions, des archives communautaires aux archives gouvernementales."},{"@language":"nl","@value":"Verzamelingen van dossiers en materialen met betrekking tot LHBTQ+-personen of LHBTQ+-gemeenschappen; kan een verscheidenheid aan organisaties en instellingen omvatten, van gemeenschapsarchieven tot overheidsarchieven."},{"@language":"sv","@value":"Samlingar av arkivmaterial och dokument relaterade till hbtq+-personer eller hbtq+-gemenskaper. Kan omfatta arkiv hos allt från lokala gemenskaper till statliga institutioner."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001755"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000128"},{"@id":"https://homosaurus.org/v5/homoit0000469"},{"@id":"https://homosaurus.org/v5/homoit0000719"},{"@id":"https://homosaurus.org/v5/homoit0001156"},{"@id":"https://homosaurus.org/v5/homoit0001389"},{"@id":"https://homosaurus.org/v5/homoit0002759"},{"@id":"https://homosaurus.org/v5/homoit0002776"},{"@id":"https://homosaurus.org/v5/homoit0003608"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000968"},{"@id":"https://homosaurus.org/v5/homoit0002677"},{"@id":"https://homosaurus.org/v5/homoit0004328"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001755"},"dc:replaces":{"@id":"http://homosaurus.org/v2/archivesLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001755","dc:identifier":"homoit0001755","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ cultural heritage institutions"},{"@language":"es","@value":"Instituciones de legado cultural LGBTQ+"},{"@language":"ja","@value":"LGBTQ+関連の文化施設"},{"@language":"nl","@value":"LHBTQ+-cultureel erfgoedinstellingen"},{"@language":"sv","@value":"Hbtq+-kulturarvsinstitutioner"}],"skos:altLabel":[{"@language":"en","@value":"Cultural heritage institutions (LGBTQ)"},{"@language":"en","@value":"GLAM (LGBTQ)"},{"@language":"en","@value":"GLAMS (LGBTQ)"},{"@language":"en","@value":"LGBTQ+ GLAM"},{"@language":"en","@value":"LGBTQ+ GLAMS"},{"@language":"es","@value":"Instituciones de legado cultural (LGBTQ)"},{"@language":"ja","@value":"文化施設 (LGBTQ)"},{"@language":"nl","@value":"GLAM (LHBTQ+)"},{"@language":"nl","@value":"GLAMS (LHBTQ+)"},{"@language":"nl","@value":"LHBTQ+-GLAM"},{"@language":"nl","@value":"LHBTQ+-GLAMS"},{"@language":"sv","@value":"GLAM (hbtq+)"}],"rdfs:comment":[{"@language":"en","@value":"A broad grouping term for galleries, libraries, archives, museums, and special collections (GLAMS) that hold materials primarily pertaining to LGBTQ+ people or intended for use by LGBTQ+ people."},{"@language":"es","@value":"Un término amplio para agrupar a galerías, bibliotecas, archivos, museos y colecciones especiales (GLAMS, por sus siglas en inglés) que contienen materiales principalmente relacionados con personas LGBTQ+ o destinados a ser utilizados por personas LGBTQ+."},{"@language":"ja","@value":"主にLGBTQ+の人々に関連する資料を所蔵している、あるいはLGBTQ+の人々の利用を目的としている美術館、図書館、公文書館、博物館、および特別コレクション（GLAMS）を総称する用語。"},{"@language":"nl","@value":"Een brede verzamelnaam voor galerieën, bibliotheken, archieven, musea en speciale collecties (GLAMS) die materialen bevatten die voornamelijk betrekking hebben op LHBTQ+-ers of bedoeld zijn voor gebruik door LHBTQ+-ers"},{"@language":"sv","@value":"Ett samlingsbegrepp för gallerier, bibliotek, arkiv, museer och specialsamlingar (GLAM) som innehåller material som främst rör hbtq+-personer eller är avsett för hbtq+-personer."}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000066"},{"@id":"https://homosaurus.org/v5/homoit0000968"},{"@id":"https://homosaurus.org/v5/homoit0001030"},{"@id":"https://homosaurus.org/v5/homoit0001813"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000070"},{"@id":"https://homosaurus.org/v5/homoit0000816"},{"@id":"https://homosaurus.org/v5/homoit0000972"},{"@id":"https://homosaurus.org/v5/homoit0001363"},{"@id":"https://homosaurus.org/v5/homoit0001831"},{"@id":"https://homosaurus.org/v5/homoit0002260"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001755"},"dc:issued":{"@type":"xsd:date","@value":"2021-11-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000128","dc:identifier":"homoit0000128","skos:prefLabel":[{"@language":"en","@value":"Bisexual archives"},{"@language":"es","@value":"Archivos bisexuales"},{"@language":"de","@value":"Bisexuelle Archive"},{"@language":"fr","@value":"Archives bisexuelles"},{"@language":"nl","@value":"Biseksuele archieven"},{"@language":"sv","@value":"Bisexuella arkiv"}],"skos:altLabel":{"@language":"de","@value":"Bisexuellen-Archiv"},"rdfs:comment":[{"@language":"en","@value":"Collections of records and materials relating to bisexual people or bisexual communities; can include a variety of organizations and institutions from community to government archives."},{"@language":"es","@value":"Colecciones de registros y materiales relacionados con personas bisexuales o comunidades bisexuales; pueden incluir una variedad de organizaciones e instituciones, desde archivos comunitarios hasta gubernamentales."},{"@language":"de","@value":"Sammlungen von Aufzeichnungen und Materialien, die sich auf bisexuelle Menschen oder bisexuelle Gemeinschaften beziehen; kann eine Vielzahl von Organisationen und Institutionen umfassen, von Community- bis zu Staatsarchiven."},{"@language":"fr","@value":"Collections d'archives et de documents relatifs aux personnes bisexuelles ou aux communautés bisexuelles; peut inclure une variété d'organisations et d'institutions, des archives communautaires aux archives gouvernementales."},{"@language":"nl","@value":"Verzamelingen van dossiers en materialen met betrekking tot biseksuele personen of biseksuele gemeenschappen; kan een verscheidenheid aan organisaties en instellingen omvatten, van gemeenschapsarchieven tot overheidsarchieven."},{"@language":"sv","@value":"Samlingar av arkivmaterial och dokument relaterade till bisexuella personer eller bisexuella gemenskaper. Kan omfatta arkiv hos allt från lokala gemenskaper till statliga institutioner."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000066"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001755"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualArchives"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000469","dc:identifier":"homoit0000469","skos:prefLabel":[{"@language":"en","@value":"Gay archives"},{"@language":"es","@value":"Archivos gay"},{"@language":"de","@value":"Schwule Archive"},{"@language":"fr","@value":"Archives gaies"},{"@language":"nl","@value":"Homo-archieven"},{"@language":"sv","@value":"Bögarkiv"}],"skos:altLabel":[{"@language":"de","@value":"Schwulen-Archive"},{"@language":"fr","@value":"Archives gays"},{"@language":"fr","@value":"Archives homosexuelles"}],"rdfs:comment":[{"@language":"en","@value":"Collections of records and materials relating to gay men or gay communities; can include a variety of organizations and institutions from community to government archives."},{"@language":"es","@value":"Colecciones de registros y materiales relacionados con hombres gay o comunidades gay; puede incluir una variedad de organizaciones e instituciones, desde archivos comunitarios hasta gubernamentales."},{"@language":"de","@value":"Sammlungen von Aufzeichnungen und Materialien, die sich auf schwule Männer oder schwule Gemeinschaften beziehen; kann eine Vielzahl von Organisationen und Institutionen umfassen, von Community- bis zu Staatsarchiven."},{"@language":"fr","@value":"Collections d'archives et de documents relatifs aux hommes gais ou aux communautés gaies; peut inclure une variété d'organisations et d'institutions allant des archives communautaires aux archives gouvernementales."},{"@language":"nl","@value":"Verzamelingen van dossiers en materialen met betrekking tot homomannen of homo-gemeenschappen; kan een verscheidenheid aan organisaties en instellingen omvatten, van gemeenschapsarchieven tot overheidsarchieven."},{"@language":"sv","@value":"Samlingar av arkivmaterial och dokument relaterade till bögar eller deras gemenskaper. Kan omfatta arkiv hos allt från lokala gemenskaper till statliga institutioner."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000066"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001755"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayArchives"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000719","dc:identifier":"homoit0000719","skos:prefLabel":[{"@language":"en","@value":"Lesbian archives"},{"@language":"es","@value":"Archivos lésbicos"},{"@language":"de","@value":"Lesbische Archive"},{"