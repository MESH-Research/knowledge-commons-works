ark anknytning till Karibien. Används endast för personer som identifierar sig som afrokaribier."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000017"},{"@id":"https://homosaurus.org/v5/homoit0002764"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-09-29"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000018","dc:identifier":"homoit0000018","skos:prefLabel":[{"@language":"en","@value":"Afro-European LGBTQ+ people"},{"@language":"de","@value":"Afroeuropäische LGBTQ+-Personen"},{"@language":"es","@value":"Personas LGBTQ+ afroeuropeas"},{"@language":"nl","@value":"Afro-Europese LHBTQ+-personen"},{"@language":"sv","@value":"Afroeuropeiska hbtq+-personer"}],"skos:altLabel":[{"@language":"en","@value":"Afro-European people (LGBTQ)"},{"@language":"en","@value":"Afro-Europeans (LGBTQ)"},{"@language":"en","@value":"LGBTQ+ Afro-European people"},{"@language":"en","@value":"LGBTQ+ Afro-Europeans"},{"@language":"de","@value":"LGBTQ+- afroeuropäische Personen"},{"@language":"es","@value":"Afroeuropeos LGBTQ+"},{"@language":"es","@value":"Personas afroeuropeas LGBTQ+"},{"@language":"es","@value":"Afroeuropeos (LGBTQ)"},{"@language":"es","@value":"Afroeuropeas LGBTQ+"},{"@language":"es","@value":"Afroeuropeas (LGBTQ)"},{"@language":"es","@value":"Personas LGBTQ+ afroeuropexs"},{"@language":"nl","@value":"Afro-Europese personen (LHBTQ+)"},{"@language":"nl","@value":"LHBTQ+ Afro-Europeanen"},{"@language":"nl","@value":"LHBTQ+ Afro-Europese personen"}],"rdfs:comment":[{"@language":"en","@value":"LGBTQ+ people of African descent born in European countries or LGBTQ+ people born in African countries who live in or have a strong connection to Europe. Only use for individuals who self-identify as Afro-European."},{"@language":"de","@value":"LGBTQ+-Personen afrikanischer Abstammung, die in europäischen Ländern geboren sind, oder LGBTQ+-Personen, die in afrikanischen Ländern geboren sind und in Europa leben oder eine starke Verbindung zu Europa haben. Nur für Personen verwenden, die sich selbst als afroeuropäisch bezeichnen."},{"@language":"es","@value":"Personas LGBTQ+ de ascendencia africana nacidas en países europeos o personas LGBTQ+ nacidas en países africanos que viven en Europa o tienen una fuerte conexión con Europa. Utilícese únicamente para personas que se identifiquen como afroeuropeas."},{"@language":"nl","@value":"LHBTQ+-personen van Afrikaanse afkomst geboren in Europese landen of LHBTQ+-personen geboren in Afrikaanse landen die wonen in of een sterke band hebben met Europa. Gebruik voor personen die zichzelf identificeren als Afro-Europeaan."},{"@language":"sv","@value":"Hbtq+-personer av afrikansk härkomst födda i europeiska länder eller hbtq+-personer födda i afrikanska länder som bor i eller har en stark anknytning till Europa. Använd endast för personer som identifierar sig som afroeuropéer."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000208"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000126"},{"@id":"https://homosaurus.org/v5/homoit0000466"},{"@id":"https://homosaurus.org/v5/homoit0000717"},{"@id":"https://homosaurus.org/v5/homoit0001154"},{"@id":"https://homosaurus.org/v5/homoit0001387"},{"@id":"https://homosaurus.org/v5/homoit0002896"},{"@id":"https://homosaurus.org/v5/homoit0002959"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/afroEuropeansLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000126","dc:identifier":"homoit0000126","skos:prefLabel":[{"@language":"en","