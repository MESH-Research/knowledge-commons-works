":"Grijsromantische personen die autistisch zijn."},{"@language":"sv","@value":"Gråromantiska personer som är autistiska."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0003004"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-10-27"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003033","dc:identifier":"homoit0003033","skos:prefLabel":[{"@language":"en","@value":"Aromantic college students "},{"@language":"de","@value":"Aromantische Hochschulstudierende"},{"@language":"es","@value":"Estudiantes universitarios arrománticos"},{"@language":"nl","@value":"Aromantische studenten"},{"@language":"sv","@value":"Aromantiska collegestudenter"}],"skos:altLabel":{"@language":"es","@value":"Universitarios arrománticos"},"rdfs:comment":[{"@language":"en","@value":"Aromantic people who are attending college."},{"@language":"de","@value":"Aromantische Personen, die eine Hochschule besuchen. Achtung: Das US-amerikanische College entspricht nicht exakt der Hochschule im deutschen Sprachraum, wird aber häufig als Hochschule übersetzt."},{"@language":"es","@value":"Personas arrománticas que asisten a la universidad."},{"@language":"nl","@value":"Aromantische personen die naar de universiteit gaan."},{"@language":"sv","@value":"Aromantiska personer som studerar vid college."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0003041"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0003032"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-12-05"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003041","dc:ide