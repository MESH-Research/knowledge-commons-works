genetic parents of a child or children placed for adoption."},{"@language":"es","@value":"Padres y/o madres biológicos o genéticos del niño o niños dados en adopción."},{"@language":"de","@value":"Biologische oder genetische Eltern eines Kindes oder von Kindern, die zur Adoption freigegeben wurden."},{"@language":"fr","@value":"Parents biologiques d'un·e ou de plusieurs enfants; peut aussi être utilisé dans un contexte d'adoption."},{"@language":"nl","@value":"Biologische of genetische ouders van het ter adoptie geplaatste kind of de kinderen."},{"@language":"sv","@value":"Biologiska eller genetiska föräldrar till ett eller flera barn som har placerats för adoption."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000587"},{"@id":"https://homosaurus.org/v5/homoit0002372"}],"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0000821"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000010"},{"@id":"https://homosaurus.org/v5/homoit0000116"},{"@id":"https://homosaurus.org/v5/homoit0000809"},{"@id":"https://homosaurus.org/v5/homoit0000812"},{"@id":"https://homosaurus.org/v5/homoit0000819"},{"@id":"https://homosaurus.org/v5/homoit0000843"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85014394"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000420"},"dc:replaces":{"@id":"http://homosaurus.org/v2/birthParents"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000812","dc:identifier":"homoit0000812","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ adoptive parents"},{"@language":"es","@value":"Madres y padres adoptivos LGBTQ+"},{"@language":"ja","@value":"LGBTQ+の養親"},{"@language":"nl","@value":"LHBTQ+-adoptieouders"},{"@language":"sv","@value":"Adoptivföräldrar (hbtq+)"}],"skos:altLabel":[{"@langua