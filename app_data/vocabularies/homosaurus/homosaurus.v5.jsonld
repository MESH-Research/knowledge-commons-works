.org/v5/homoit0001867"},{"@id":"https://homosaurus.org/v5/homoit0001878"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-02-17"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001867","dc:identifier":"homoit0001867","skos:prefLabel":[{"@language":"en","@value":"Lesbian Deaf people"},{"@language":"es","@value":"Personas lesbianas sordas"},{"@language":"nl","@value":"Dove lesbische vrouwen"},{"@language":"sv","@value":"Lesbiska döva"}],"skos:altLabel":[{"@language":"en","@value":"Deaf lesbians"},{"@language":"es","@value":"Sordas lesbianas"},{"@language":"sv","@value":"Döva lesbiska"}],"rdfs:comment":[{"@language":"en","@value":"Lesbians with significant or total hearing loss. Some but not all Deaf people prefer to capitalize Deaf in recognition of the cultural and linguistic identity they share with other Deaf people."},{"@language":"es","@value":"Lesbianas con pérdida auditiva significativa o total. Algunas personas sordas, pero no todas, prefieren escribir “Sorda/o” con mayúscula  en reconocimiento de la identidad cultural y lingüística que comparten con otras personas sordas."},{"@language":"nl","@value":"Lesbische vrouwen met aanzienlijk of totaal gehoorverlies."},{"@language":"sv","@value":"Lesbiska med betydande eller total hörselförlust."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001855"},{"@id":"https://homosaurus.org/v5/homoit0001866"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001861"},{"@id":"https://homosaurus.org/v5/homoit0001878"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-02-17"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001880","dc:identifier":"homoit0001880","skos:prefLabel":[{"@language":"en","@value":"Lesbians with chronic illnesses"},{"@language":"es","@value":"Lesbianas con enfermedades crónicas"},{"@language":"nl","@value":"Lesbische vrouwen met chronische ziekten"},{"@language":"sv","@value":"Lesbiska med kronisk sjukdom"}],"skos:altLabel":[{"@language":"en","@value":"Chronically ill lesbians"},{"@language":"es","@value":"Lesbianas enfermas crónicas"},{"@language":"es","@value":"Enfermas crónicas lesbianas"},{"@language":"sv","@value":"Kroniskt sjuka lesbiska"}],"rdfs:comment":[{"@language":"en","@value":"Lesbians who have long-term health conditions that require continued medical attention and/or significantly impact or limit daily life; some but not all people with chronic illnesses consider themselves disabled."},{"@language":"es","@value":"Lesbianas que tienen condiciones de salud a largo plazo que requieren atención médica continua y/o impactan o limitan significativamente la vida diaria; algunas, pero no todas, las personas con enfermedades crónicas se consideran discapacitadas."},{"@language":"nl","@value":"Lesbische vrouwen met langdurige gezondheidsproblemen die voortdurende medische aandacht vereisen en/of het dagelijks leven aanzienlijk beïnvloeden of beperken; sommige, maar niet alle personen met chronische ziekten beschouwen zichzelf als gehandicapt"},{"@language":"sv","@value":"Lesbiska med långvariga hälsotillstånd som kräver kontinuerlig medicinsk behandling och/eller har en betydande påverkan på eller begränsar det dagliga livet. Vissa, men inte alla, personer med kroniska sjukdomar identifierar sig som personer med funktionsnedsättning."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001879"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001855"},{"@id":"https://homosaurus.org/v5/homoit0001886"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"d