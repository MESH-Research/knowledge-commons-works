."},{"@language":"de","@value":"Frisch geoutete Persone, insbesondere frisch geoutete schwule Männer."},{"@language":"fr","@value":"Personnes qui viennent de sortir du placard, en particulier les hommes gais."},{"@language":"nl","@value":"Personen die net uit de kast zijn gekomen, vooral homomannen die net uit de kast zijn gekomen."},{"@language":"sv","@value":"Nyutkomna bögar."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000506"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000088"},{"@id":"https://homosaurus.org/v5/homoit0000295"},{"@id":"https://homosaurus.org/v5/homoit0001065"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/babyGay"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000295","dc:identifier":"homoit0000295","skos:prefLabel":[{"@language":"en","@value":"Coming out"},{"@language":"es","@value":"Salir del clóset"},{"@language":"de","@value":"Coming-out"},{"@language":"nl","@value":"Coming out"},{"@language":"sv","@value":"Komma ut"}],"skos:altLabel":[{"@language":"es","@value":"Salir del armario"},{"@language":"de","@value":"Rauskommen"}],"rdfs:comment":[{"@language":"en","@value":"Process of accepting and sharing one’s sexual or gender identity with oneself and/or others."},{"@language":"es","@value":"Proceso de aceptar y compartir la propia identidad sexual o de género con uno mismo y/o con los demás."},{"@language":"de","@value":"Prozess der Akzeptanz und Offenlegung der eigenen sexuellen Identität oder Geschlechtsidentität gegenüber sich selbst und/oder anderen."},{"@language":"nl","@value":"Proces van het accepteren en delen van iemands seksuele of genderidentiteit met zichzelf en/of anderen."},{"@language":"sv","@value":"Processen att acceptera och dela med sig av sin sexuella läggning eller könsidentitet till sig själv och/eller andra."}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000088"},{"@id":"https://homosaurus.org/v5/homoit0000089"},{"@id":"https://homosaurus.org/v5/homoit0000285"},{"@id":"https://homosaurus.org/v5/homoit0000286"},{"@id":"https://homosaurus.org/v5/homoit0000287"},{"@id":"https://homosaurus.org/v5/homoit0000288"},{"@id":"https://homosaurus.org/v5/homoit0001065"},{"@id":"https://homosaurus.org/v5/homoit0001261"},{"@id":"https://homosaurus.org/v5/homoit0001783"},{"@id":"https://homosaurus.org/v5/homoit0001784"},{"@id":"https://homosaurus.org/v5/homoit0001785"},{"@id":"https://homosaurus.org/v5/homoit0001786"},{"@id":"https://homosaurus.org/v5/homoit0001787"},{"@id":"https://homosaurus.org/v5/homoit0002905"},{"@id":"https://homosaurus.org/v5/homoit0003509"}],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh90005890"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000295"},"dc:replaces":{"@id":"http://homosaurus.org/v2/comingOut"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001065","dc:identifier":"homoit0001065","skos:prefLabel":[{"@language":"en","@value":"Outing (LGBTQ+ culture)"},{"@language":"es","@value":"Outing (cultura LGBTQ+)"},{"@language":"nl","@value":"Outing"},{"@language":"sv","@value":"Outning"}],"skos:altLabel":[{"@language":"en","@value":"Outing"},{"@language":"es","@value":"Outing"},{"@language":"es","@value":"Sacar del armario"},{"@language":"es","@value":"Sacar del clóset"}],"rdfs:comment":[{"@language":"en","@value":"The act of disclosing a person's sexual or gender identity without that person's consent."},{"@language":"es","@value":"El acto de revelar la identidad sexual o de género de una persona sin el consentimiento de esa persona."},{"@language":"nl","@value":"Het onthullen van iemands seksuele oriëntatie of genderidentiteit zonder toestemming van die persoon."},{"@language":"sv","@value":"Att avslöja en persons sexualitet eller könsidentitet utan personens samtycke."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000853"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000088"},{"@id":"https://homosaurus.org/v5/homoit0000089"},{"@id":"https://homosaurus.org/v5/homoit0000285"},{"@id":"https://homosaurus.org/v5/homoit0000286"},{"@id":"https://homosaurus.org/v5/homoit0000287"},{"@id":"https://homosaurus.org/v5/homoit0000288"},{"@id":"https://homosaurus.org/v5/homoit0000295"},{"@id":"https://homosaurus.org/v5/homoit0000336"},{"@id":"https://homosaurus.org/v5/homoit0001261"},{"@id":"https://homosaurus.org/v5/homoit0001783"},{"@id":"https://homosaurus.org/v5/homoit0001784"},{"@id":"https://homosaurus.org/v5/homoit0001785"},{"@id":"https://homosaurus.org/v5/homoit0001786"},{"@id":"https://homosaurus.org/v5/homoit0001787"},{"@id":"https://homosaurus.org/v5/homoit0002392"},{"@id":"https://homosaurus.org/v5/homoit0002905"}],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh93002177"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000006"},"dc:replaces":{"@id":"http://homosaurus.org/v2/outing"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000506","dc:identifier":"homoit0000506","skos:prefLabel":[{"@language":"en","@value":"Gay men"},{"@language":"de","@value":"Schwule Männer"},{"@language":"es","@value":"Hombres gay"},{"@language":"nl","@value":"Homomannen"},{"@language":"sv","@value":"Bögar"}],"skos:altLabel":[{"@language":"en","@value":"Gays"},{"@language":"de","@value":"Homosexuelle Männer"},{"@language":"de","@value":"Gays"},{"@language":"es","@value":"Gays"},{"@language":"sv","@value":"Gaymän"},{"@language":"sv","@value":"Homosexuella män"}],"rdfs:comment":[{"@language":"en","@value":"Men who self-identify as gay and belong to gay communities. Predominately used to describe men who are exclusively or primarily romantically and/or sexually attracted to other men. While \"gay\" is often used as an identifier by people of all genders, this term specifically refers to gay men."},{"@language":"de","@value":"Männer, die sich selbst als schwul identifizieren und zu schwulen Gemeinschaften gehören. Wird vorwiegend verwendet, um Männer zu beschreiben, die ausschließlich oder hauptsächlich romantisch und/oder sexuell zu anderen Männern hingezogen sind. Während „gay” oft als Identifikationsbegriff von Menschen aller Geschlechter verwendet wird, bezieht sich dieser Begriff speziell auf schwule Männer."},{"@language":"es","@value":"Hombres que se autoidentifican como gay y pertenecen a comunidades gay. Se utiliza predominantemente para describir a hombres que se sienten exclusiva o principalmente atraídos romántica y/o sexualmente a otros hombres. Si bien \"gay\" se utiliza a menudo como identificador para personas de todos los géneros, este término se refiere específicamente a los hombres gay."},{"@language":"nl","@value":"Mannen die zichzelf identificeren als homo en tot homogemeenschappen behoren. De term is voornamelijk gebruikt om mannen te beschrijven die zich uitsluitend of voornamelijk romantisch en/of seksueel aangetrokken voelen tot andere mannen. Hoewel homo vaak wordt gebruikt als identificatiemiddel door mensen van alle geslachten, verwijst deze term specifiek naar homomannen."},{"@language":"sv","@value":"Män som identifierar sig som homosexuella och tillhör böggemenskaper. Används främst för att beskriva män som är uteslutande eller huvudsakligen romantiskt och/eller sexuellt attraherade av andra män."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000915"},{"@id":"https://homosaurus.org/v5/homoit0001008"},{"@id":"https://homosaurus.org/v5/homoit0001297"}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000089"},{"@id":"https://homosaurus.org/v5/homoit0000105"},{"@id":"https://homosaurus.org/v5/homoit0000284"},{"@id":"https://homosaurus.org/v5/homoit0000286"},{"@id":"https://homosaurus.org/v5/homoit0000492"},{"@id":"https://homosaurus.org/v5/homoit0000978"},{"@id":"https://homosaurus.org/v5/homoit0001055"},{"@id":"https://homosaurus.org/v5/homoit0001063"},{"@id":"https://homosaurus.org/v5/homoit0001145"},{"@id":"https://homosaurus.org/v5/homoit0001148"},{"@id":"https://homosaurus.org/v5/homoit0001479"},{"@id":"https://homosaurus.org/v5/homoit0001508"},{"@id":"https://homosaurus.org/v5/homoit0003037"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000418"},{"@id":"https://homosaurus.org/v5/homoit0000479"},{"@id":"https://homosaurus.org/v5/homoit0000481"},{"@id":"https://homosaurus.org/v5/homoit0000485"},{"@id":"https://homosaurus.org/v5/homoit0000496"},{"@id":"https://homosaurus.org/v5/homoit0000499"},{"@id":"https://homosaurus.org/v5/homoit0000509"},{"@id":"https://homosaurus.org/v5/homoit0000544"},{"@id":"https://homosaurus.org/v5/homoit0000646"},{"@id":"https://homosaurus.org/v5/homoit0000647"},{"@id":"https://homosaurus.org/v5/homoit0001009"},{"@id":"https://homosaurus.org/v5/homoit0001104"},{"@id":"https://homosaurus.org/v5/homoit0001258"},{"@id":"https://homosaurus.org/v5/homoit0002170"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85061798"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayMen"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000090","dc:identifier":"homoit0000090","skos:prefLabel":[{"@language":"fil","@value":"Bading"},{"@language":"es","@value":"Bading"},{"@language":"de","@value":"Bading"},{"@language":"nl","@value":"Bading"},{"@language":"sv","@value":"Bading"}],"rdfs:comment":[{"@language":"en","@value":"Derogatory Filipino term referring to gay men who crossdress."},{"@language":"es","@value":"Término filipino despectivo que se refiere a los hombres gay que se transforman. "},{"@language":"de","@value":"Abwertende philippinische Bezeichnung für schwule Männer, die Crossdressing praktizieren."},{"@language":"nl","@value":"Denigrerende Filippijnse term die verwijst naar homoseksuele crossdressers"},{"@language":"sv","@value":"Nedsättande filippinsk term som syftar på bögar som crossdressar."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000322"},{"@id":"https://homosaurus.org/v5/homoit0001560"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bading"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000101","dc:identifier":"homoit0000101","skos:prefLabel":[{"@language":"ceb","@value":"Bayot"},{"@language":"es","@value":"Bayot"},{"@language":"de","@value":"Bayot"},{"@language":"nl","@value":"Bayot"},{"@language":"sv","@value":"Bayot"}],"skos:altLabel":{"@language":"de","@value":"Bayet"},"rdfs:comment":[{"@language":"en","@value":"Derogatory Cebuano term used in the Philippines to describe effeminate gay men or masculine women."},{"@language":"es","@value":"Término despectivo cebuano utilizado en Filipinas para referirse a los hombres gay afeminados o a las mujeres masculinas."},{"@language":"de","@value":"Abfälliger Begriff der Sprache Cebuano, der auf den Philippinen verwendet wird, um verweichlichte schwule Männer oder maskuline Frauen zu beschreiben."},{"@language":"nl","@value":"Denigrerende Cebuano-term die in de Filippijnen wordt gebruikt voor feminiene homomannen of mannelijke vrouwen"},{"@language":"sv","@value":"Nedsättande cebuansk term som används på Filippinerna för att beskriva feminina bögar eller maskulina kvinnor."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000322"},{"@id":"https://homosaurus.org/v5/homoit0001560"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000091"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bayot"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000092","dc:identifier":"homoit0000092","skos:prefLabel":[{"@language":"en","@value":"Ball culture"},{"@language":"es","@value":"Cultura del ball"},{"@language":"de","@value":"Ballroom-Szene"},{"@language":"nl","@value":"Ball cultuur"},{"@language":"sv","@value":"Ballroomkultur"}],"skos:altLabel":[{"@language":"en","@value":"Ballroom community"},{"@language":"en","@value":"Ballroom culture"},{"@language":"en","@value":"Ballroom scene"},{"@language":"en","@value":"Drag ball culture"},{"@language":"en","@value":"House-ballroom culture"},{"@language":"es","@value":"Comunidad ballroom"},{"@language":"es","@value":"Cultura ball"},{"@language":"es","@value":"Cultura ballroom"},{"@language":"es","@value":"Escena ballroom"},{"@language":"es","@value":"Cultura drag ball"},{"@language":"es","@value":"Cultura de casas ballroom"},{"@language":"de","@value":"Ballroom-Gemeinschaft"},{"@language":"de","@value":"Ballroom-Kultur"},{"@language":"de","@value":"House-Ballroom-Kultur"},{"@language":"de","@value":"Drag-ball-Kultur"},{"@language":"nl","@value":"Ballroom gemeenschap"},{"@language":"nl","@value":"Ballroom scene"},{"@language":"nl","@value":"Drag ball cultuur"},{"@language":"nl","@value":"House-ballroom cultuur"},{"@language":"sv","@value":"Ball culture"}],"rdfs:comment":[{"@language":"en","@value":"A subculture that emerged in early 20th century New York City in which primarily African-American and Latin American LGBTQ+ people perform and compete for various prizes."},{"@language":"es","@value":"Subcultura surgida en la ciudad de Nueva York a principios del siglo XX en la que personas LGBTQ+ principalmente afroamericanas y latinoamericanas actúan y compiten por diversos premios."},{"@language":"de","@value":"Eine im frühen 20. Jahrhundert in New York City entstandene Subkultur, in der vor allem afroamerikanische und lateinamerikanische LGBTQ+-Personen auftreten und um verschiedene Preise konkurrieren."},{"@language":"nl","@value":"Een subcultuur die ontstond in het begin van de 20e eeuw in New York City, waarin voornamelijk Afro-Amerikaanse en Latijns-Amerikaanse LGBTQ+-ers optreden en strijden om verschillende prijzen"},{"@language":"sv","@value":"En subkultur som uppstod i början av 1900-talet i New York där framför allt afroamerikanska och latinamerikanska hbtq+-personer uppträder, kallat \"walk\", och tävlar om olika priser."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001345"},"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0000094"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000095"},{"@id":"https://homosaurus.org/v5/homoit0000368"},{"@id":"https://homosaurus.org/v5/homoit0000370"},{"@id":"https://homosaurus.org/v5/homoit0001295"},{"@id":"https://homosaurus.org/v5/homoit0001494"},{"@id":"https://homosaurus.org/v5/homoit0001900"},{"@id":"https://homosaurus.org/v5/homoit0003505"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/ballCulture"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000094","dc:identifier":"homoit0000094","skos:prefLabel":[{"@language":"en","@value":"Ballroom families"},{"@language":"es","@value":"Familias de ballroom"},{"@language":"de","@value":"Ballroom-Familien"},{"@language":"nl","@value":"Ballroom families"},{"@language":"sv","@value":"Ballroomfamiljer"}],"skos:altLabel":[{"@language":"en","@value":"Ballroom houses"},{"@language":"es","@value":"Casas de ballroom"},{"@language":"de","@value":"Ballroomhäuser"},{"@language":"de","@value":"Ballroom houses"},{"@language":"de","@value":"Ballroomfamilien"},{"@language":"sv","@value":"Ballroom houses"},{"@language":"sv","@value":"Ballroomhus"}],"rdfs:comment":[{"@language":"en","@value":"In ball culture, ballroom families (or houses) are chosen families headed by and named after established community members (e.g., the House of Xtravaganza); heads of ballroom families are typically called \"mothers\" or \"fathers,\" while members are termed \"children\" and \"siblings.\""},{"@language":"es","@value":"En la cultura del baile, las familias (o casas) de ballroom son familias elegidas encabezadas por miembros establecidos de la comunidad y que reciben su nombre de ellos (por ejemplo, la Casa de Xtravaganza); a los cabezas de familia de baile se les suele llamar \"madres\" o \"padres\", mientras que a los miembros se les denomina \"hijos\" y \"hermanos\"."},{"@language":"de","@value":"In der Ballroom-Kultur sind Ballroomfamilien (oder Häuser) gewählte Familien, die von etablierten Mitgliedern der Gemeinschaft geleitet und nach ihnen benannt werden (z. B. das House of Xtravaganza); die Anführer:innen von Ballfamilien werden in der Regel „Mütter“ oder „Väter“ genannt, während die Mitglieder als „Kinder\" und „Geschwister“ bezeichnet werden."},{"@language":"nl","@value":"In de 'ball cultuur' zijn ballroom families (of huizen) gekozen families onder leiding van en vernoemd naar gevestigde leden van de gemeenschap (bijvoorbeeld het Huis van Xtravaganza); hoofden van ballroom families worden meestal 'moeders' of 'vaders' genoemd, terwijl leden 'kinderen' en 'broers en zussen' worden genoemd."},{"@language":"sv","@value":"Inom ballroomkulturen är ballroomfamiljer (eller ”hus”/”houses”) valda familjer ledda av och namngivna efter etablerade medlemmar i gemenskapen (t.ex. House of Xtravaganza). Ledare för dessa familjer kallas vanligtvis ”mammor” eller ”pappor”, medan medlemmarna benämns som ”barn” och ”syskon”."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000092"},{"@id":"https://homosaurus.org/v5/homoit0000834"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000371"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/ballroomFamilies"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000368","dc:identifier":"homoit0000368","skos:prefLabel":[{"@language":"en","@value":"Drag balls"},{"@language":"es","@value":"Bailes de drag"},{"@language":"de","@value":"Dragballs"},{"@language":"nl","@value":"Drag balls"},{"@language":"sv","@value":"Dragbaler"}],"skos:altLabel":[{"@language":"es","@value":"Drag balls"},{"@language":"es","@value":"Balls de drag"},{"@language":"de","@value":"Dragbälle"},{"@language":"de","@value":"Drag balls"}],"rdfs:comment":[{"@language":"en","@value":"Events that are part of the drag ball subculture that emerged in early 20th-century New York City among primarily African-American and Latin American LGBTQ+ people. During a drag ball, individuals \"walk\" or perform for prizes."},{"@language":"es","@value":"Eventos que forman parte de la subcultura de bailes de drag que surgió a principios del siglo XX en la ciudad de Nueva York entre personas LGBTQ+ principalmente afroamericanas y latinoamericanas. Durante un drag ball, las personas \"caminan\" o actúan para ganar premios."},{"@language":"de","@value":"Veranstaltungen, die Teil der Dragball-Subkultur sind, die ihren Ursprung im New York City des frühen 20. Jahrhunderts hatte und vor allem von afroamerikanischen und lateinamerikanischen LGBTQ+ Personen geprägt war. Während eines Drag Balls “laufen” (“walk” im Englischen) und treten Teilnehmer:innen für Preise auf."},{"@language":"nl","@value":"Evenementen die deel uitmaken van de dragball-subcultuur die ontstond in het begin van de 20e eeuw in New York City onder voornamelijk Afro-Amerikaanse en Latijns-Amerikaanse LHBTQ+-ers; tijdens een drag ball \"lopen\" individuen of treden op voor prijzen."},{"@language":"sv","@value":"Evenemang inom drag ball-subkulturen som uppstod i början av 1900-talet i New York bland framför allt afroamerikanska och latinamerikanska hbtq+-personer. Under en dragbal uppträder deltagare eller ”går” på scen för att tävla om priser."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000861"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000092"},{"@id":"https://homosaurus.org/v5/homoit0000367"},{"@id":"https://homosaurus.org/v5/homoit0000370"},{"@id":"https://homosaurus.org/v5/homoit0001494"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh94008099"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000861"},"dc:replaces":{"@id":"http://homosaurus.org/v2/dragBalls"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000370","dc:identifier":"homoit0000370","skos:prefLabel":[{"@language":"en","@value":"Drag community"},{"@language":"es","@value":"Comunidad drag"},{"@language":"de","@value":"Drag-Gemeinschaft"},{"@language":"fr","@value":"Communauté drag"},{"@language":"nl","@value":"Drag gemeenschap"},{"@language":"sv","@value":"Draggemenskaper"}],"skos:altLabel":[{"@language":"de","@value":"Drag-Community"},{"@language":"sv","@value":"Dracommunityn"}],"rdfs:comment":[{"@language":"en","@value":"Groups of people (typically drag performers) with a shared interest in drag performances and culture."},{"@language":"es","@value":"Grupos de personas (usualmente artistas drag) con un interés compartido en las presentaciones y la cultura drag."},{"@language":"de","@value":"Gruppen von Personen, die in der Regel Drag-Künstler:innen sind, die ein gemeinsames Interesse an Drag-Veranstaltungen und -Kultur haben."},{"@language":"fr","@value":"Groupes de personnes (généralement des artistes drags) qui partagent un intérêt pour les spectacles et la culture drag."},{"@language":"nl","@value":"Groepen personen (meestal drag-artiesten) met een gedeelde interesse in drag-optredens en cultuur."},{"@language":"sv","@value":"Grupper av personer (ofta dragartister) med ett gemensamt intresse för dragframträdanden och dragkultur."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000297"},"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0000371"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000092"},{"@id":"https://homosaurus.org/v5/homoit0000367"},{"@id":"https://homosaurus.org/v5/homoit0000368"},{"@id":"https://homosaurus.org/v5/homoit0000369"},{"@id":"https://homosaurus.org/v5/homoit0000373"},{"@id":"https://homosaurus.org/v5/homoit0000375"},{"@id":"https://homosaurus.org/v5/homoit0001900"},{"@id":"https://homosaurus.org/v5/homoit0001906"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000297"},"dc:replaces":{"@id":"http://homosaurus.org/v2/dragCommunity"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001494","dc:identifier":"homoit0001494","skos:prefLabel":[{"@language":"en","@value":"Voguing"},{"@language":"es","@value":"Voguing"},{"@language":"nl","@value":"Voguing"},{"@language":"sv","@value":"Voguing"}],"skos:altLabel":[{"@language":"en","@value":"Vogueing"},{"@language":"es","@value":"Vogueing"},{"@language":"sv","@value":"Old way"},{"@language":"sv","@value":"New way"},{"@language":"sv","@value":"Vogue femme"}],"rdfs:comment":[{"@language":"en","@value":"A highly stylized form of dance originating in the Harlem ballroom scene in the 1980s and 1990s."},{"@language":"es","@value":"Una forma de danza muy estilizada que se originó en la escena de ballroom de Harlem en las décadas de 1980 y 1990."},{"@language":"nl","@value":"Een zeer gestileerde dansvorm die zijn oorsprong vond in de ballroomscene in Harlem in de jaren tachtig en negentig van de 20e eeuw."},{"@language":"sv","@value":"En starkt stiliserad dansform som uppstod inom Harlems ballroomscen under 1980- och 1990-talen."}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000092"},{"@id":"https://homosaurus.org/v5/homoit0000367"},{"@id":"https://homosaurus.org/v5/homoit0000368"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh93002691"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001494"},"dc:replaces":{"@id":"http://homosaurus.org/v2/voguing"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001900","dc:identifier":"homoit0001900","skos:prefLabel":[{"@language":"en","@value":"Reading (LGBTQ+ culture)"},{"@language":"es","@value":"Lectura (cultura LGBTQ+)"},{"@language":"nl","@value":"Reading (LHBTQ+-cultuur)"},{"@language":"sv","@value":"Läsning (hbtq+-kultur)"}],"skos:altLabel":[{"@language":"es","@value":"Reading (cultura LGBTQ+)"},{"@language":"sv","@value":"Reading (hbtq+-kultur)"}],"rdfs:comment":[{"@language":"en","@value":"Slang term used in drag and ballroom communities to describe the act of playfully or wittily insulting someone's appearance or behavior; described by drag queen Dorian Corey as \"the art form of the insult.\" "},{"@language":"es","@value":"Término de la jerga utilizado en las comunidades de drag y ballroom para describir el acto de insultar de manera jocosa o ingeniosa la apariencia o el comportamiento de alguien; descrito por la drag queen Dorian Corey como \"el arte del insulto\"."},{"@language":"nl","@value":"Argot-term die wordt gebruikt in drag- en ballroomgemeenschappen om speels of geestig iemands uiterlijk of gedrag te beledigen; beschreven door drag queen Dorian Corey als \"de kunstvorm van het beledigen\""},{"@language":"sv","@value":"Slanguttryck från drag- och ballroomkulturer för att vitsigt eller skarpt kommentera någons utseende eller beteende. Beskrivs som ”en konstform av förolämpningar”."}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000092"},{"@id":"https://homosaurus.org/v5/homoit0000370"},{"@id":"https://homosaurus.org/v5/homoit0001233"},{"@id":"https://homosaurus.org/v5/homoit0002192"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001900"},"dc:issued":{"@type":"xsd:date","@value":"2022-02-28"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003505","dc:identifier":"homoit0003505","skos:prefLabel":[{"@language":"en","@value":"Kiki (Social Gathering)"},{"@language":"es","@value":"Kiki (reunión social)"},{"@language":"nl","@value":"Kiki (Sociaal samenzijn)"},{"@language":"sv","@value":"Kiki"}],"skos:altLabel":[{"@language":"en","@value":"Kikiing (Social gathering)"},{"@language":"en","@value":"Kiking (Social gathering)"},{"@language":"es","@value":"Kiki"},{"@language":"nl","@value":"Kiking (Sociaal samenzijn)"}],"rdfs:comment":[{"@language":"en","@value":"A slang term to describe a gathering of friends for the purpose of chatting and gossiping. The term evolved out of the 1990s ballroom scene in New York City and was further popularized by the 2012 song \"Let's Have a Kiki\" by the Scissor Sisters. Do not conflate with the term \"Ky-ky (Gender role),\" sometimes also spelled \"Kiki,\" which refers to lesbians who do not identify as either butches or femmes."},{"@language":"es","@value":"Término de la jerga para describir una reunión de amigos con el fin de charlar y chismear. El término surgió en la década de 1990 en los salones de ballroom de Nueva York y se popularizó con la canción de 2012 «Let's Have a Kiki» de Scissor Sisters. No confundir con el término «Ky-ky (rol de género)», a veces también deletreado «Kiki», que se refiere a lesbianas que no se identifican ni como marimachos ni como femmes."},{"@language":"nl","@value":"Een term om een ​​samenzijn van vrienden te beschrijven met als doel te kletsen en roddelen. De term is ontstaan ​​in de ballroom scene in New York City in de jaren 1990 en werd verder gepopulariseerd door het nummer \"Let's Have a Kiki\" uit 2012 van de Scissor Sisters. Verwar de term niet met \"Ky-ky (Genderrol)\", soms ook gespeld als \"Kiki\", wat verwijst naar lesbische vrouwen die zich niet identificeren als butches of femmes."},{"@language":"sv","@value":"Slangterm som beskriver en vänskaplig samling för att prata och skvallra. Termen uppstod i New Yorks ballroom-scen på 1990-talet och blev mer känd genom låten Let's Have a Kiki (2012) av Scissor Sisters. Bör inte förväxlas med termen Ky-ky (identitet) (ibland även stavat Kiki), som avser lesbiska som inte identifierar sig som butch eller femme."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001317"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000092"},{"@id":"https://homosaurus.org/v5/homoit0000455"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001317"},"dc:issued":{"@type":"xsd:date","@value":"2024-07-31"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000093","dc:identifier":"homoit0000093","skos:prefLabel":[{"@language":"en","@value":"Ballgags"},{"@language":"de","@value":"Ballknebel"},{"@language":"es","@value":"Mordazas de bola"},{"@language":"fr","@value":"Baillon boule"},{"@language":"nl","@value":"Ballgags"},{"@language":"sv","@value":"Disciplinbollar"}],"skos:altLabel":[{"@language":"es","@value":"Mordazas de boca"},{"@language":"sv","@value":"Ballgags"},{"@language":"sv","@value":"Gags"},{"@language":"sv","@value":"Bollgags"},{"@language":"sv","@value":"Munkavle"}],"rdfs:comment":[{"@language":"en","@value":"Silicone, rubber, or other types of balls that are strapped in a person’s mouth to prevent them from speaking, typically during sex."},{"@language":"de","@value":"Kugeln aus Silikon, Gummi oder anderen Materialien, die einer Person um den Mund geschnallt werden, um sie am Sprechen zu hindern, in der Regel beim Sex."},{"@language":"es","@value":"Pelotas de silicona, goma u otros materiales atadas a la boca de una persona para impedirle hablar, usualmente durante el sexo."},{"@language":"fr","@value":"Boules en silicone, en caoutchouc ou autres types de boules qui sont attachées dans la bouche d'une personne pour l'empêcher de parler, généralement pendant les rapports sexuels."},{"@language":"nl","@value":"Siliconen, rubberen of andere soorten ballen vastgebonden in de mond van een persoon om te voorkomen dat ze praten."},{"@language":"sv","@value":"Kulor av silikon, gummi eller andra material som spänns fast i en persons mun för att hindra dem från att tala, vanligtvis under sex."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001266"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001266"},"dc:replaces":{"@id":"http://homosaurus.org/v2/ballgags"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000834","dc:identifier":"homoit0000834","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ chosen families"},{"@language":"es","@value":"Familias escogidas LGBTQ+"},{"@language":"ja","@value":"LGBTQ+の選んだ家族"},{"@language":"nl","@value":"LHBTQ+-gekozen families"},{"@language":"sv","@value":"Valda familjer (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"LGBTQ chosen families"},{"@language":"es","@value":"Familia de elección LGBTQ+"},{"@language":"es","@value":"Familias elegidas LGBTQ+"},{"@language":"ja","@value":"LGBTQの選んだ家族"}],"rdfs:comment":[{"@language":"en","@value":"Groups of LGBTQ+ people who have intentionally chosen to nurture, support, and love one another as family, whether or not they have biological or legal relationships."},{"@language":"es","@value":"Grupos de personas LGBTQ+ que han elegido intencionalmente cuidarse, apoyarse y amarse unas a otras como familia, tengan o no relaciones biológicas o legales."},{"@language":"ja","@value":"生物学的または法的な関係があるかどうかにかかわらず、家族として互いを育み、支え合い、愛し合うことを自ら選んだLGBTQ+の人々のグループ。"},{"@language":"nl","@value":"Groepen LHBTQ+-personen die er bewust voor hebben gekozen om elkaar als familie te koesteren, te ondersteunen en lief te hebben, ongeacht of ze biologische of juridische relaties hebben of niet."},{"@language":"sv","@value":"Grupper av hbtq+-personer som valt att skapa familj med varandra genom att ge omsorg, stöd och kärlek – oavsett biologisk eller juridisk relation."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000420"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000094"},{"@id":"https://homosaurus.org/v5/homoit0000371"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000420"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQChosenFamilies"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000371","dc:identifier":"homoit0000371","skos:prefLabel":[{"@language":"en","@value":"Drag families"},{"@language":"es","@value":"Familias drag"},{"@language":"de","@value":"Drag-Familien"},{"@language":"nl","@value":"Drag families"},{"@language":"sv","@value":"Dragfamiljer"}],"rdfs:comment":[{"@language":"en","@value":"Groups of drag performers who share a community and typically live in close quarters with one another. Drag families are headed by drag mothers or drag fathers, with other members termed drag daughters and sons. Members of a drag family typically use the same last name as their drag mother or father (e.g., Xtravaganza) in social contexts or while performing."},{"@language":"es","@value":"Grupos de artistas drag que comparten una comunidad y usualmente viven cerca unos de otros. Las familias drag están encabezadas por madres drag o padres drag, y otros miembros se denominan hijas e hijos drag. Los miembros de una familia drag suelen utilizar el mismo apellido que su madre o padre drag (por ejemplo, Xtravaganza) en contextos sociales o mientras se presentan."},{"@language":"de","@value":"Gruppen von Drag-Künstler:innen, die eine Gemeinschaft bilden und oft auf engem Raum zusammenleben. Drag-Familien werden von Drag-Müttern oder Drag-Vätern angeführt, während andere Mitglieder als Drag-Töchter und Drag-Söhne bezeichnet werden. Mitglieder einer Drag-Familie verwenden häufig denselben Nachnamen wie ihre Drag-Mutter oder ihren Drag-Vater (z. B. Xtravaganza) in sozialen Kontexten oder beim Auftreten."},{"@language":"nl","@value":"Groepen dragartiesten die een gemeenschap delen en doorgaans dicht bij elkaar wonen. Drag-families worden geleid door drag-moeders of drag-vaders, terwijl andere leden drag-dochters en -zonen worden genoemd. Leden van een drag-familie gebruiken doorgaans dezelfde achternaam als hun drag-moeder of -vader (bijv. Xtravaganza) in sociale contexten of tijdens optredens."},{"@language":"sv","@value":"Grupper av dragartister som delar gemenskap och ofta bor nära varandra. Dragfamiljer leds av en dragmamma eller dragpappa, medan övriga medlemmar kallas dragdöttrar och dragsöner. Medlemmarna använder ofta samma efternamn som sin dragförälder (t.ex. Xtravaganza) i sociala sammanhang eller vid framträdanden."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000370"},{"@id":"https://homosaurus.org/v5/homoit0000420"},{"@id":"https://homosaurus.org/v5/homoit0000834"}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000372"},{"@id":"https://homosaurus.org/v5/homoit0000374"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000094"},{"@id":"https://homosaurus.org/v5/homoit0000373"},{"@id":"https://homosaurus.org/v5/homoit0000375"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000297"},"dc:replaces":{"@id":"http://homosaurus.org/v2/dragFamilies"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000878","dc:identifier":"homoit0000878","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ historical terms"},{"@language":"es","@value":"Términos históricos LGBTQ+"},{"@language":"nl","@value":"LHBTQ+-historische termen"},{"@language":"sv","@value":"Historiska termer (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"LGBTQ historical terms"},{"@language":"es","@value":"Términos históricos LGBTQ"},{"@language":"sv","@value":"Föråldrade begrepp (hbtq+)"},{"@language":"sv","@value":"Föråldrade ord (hbtq+)"},{"@language":"sv","@value":"Föråldrade termer (hbtq+)"},{"@language":"sv","@value":"Historiska begrepp (hbtq+)"}],"rdfs:comment":[{"@language":"en","@value":"Historical terms for LGBTQ+ people, identities, and practices that are now considered outdated and/or offensive."},{"@language":"es","@value":"Términos históricos para personas, identidades y prácticas LGBTQ+ que ahora se consideran obsoletos y/u ofensivos."},{"@language":"nl","@value":"Termen die verouderd zijn"},{"@language":"sv","@value":"Historiska termer för hbtq+-personer, identiteter och praktiker som i dag kan anses föråldrade och/eller kränkande."}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000095"},{"@id":"https://homosaurus.org/v5/homoit0000098"},{"@id":"https://homosaurus.org/v5/homoit0000218"},{"@id":"https://homosaurus.org/v5/homoit0000227"},{"@id":"https://homosaurus.org/v5/homoit0000284"},{"@id":"https://homosaurus.org/v5/homoit0000326"},{"@id":"https://homosaurus.org/v5/homoit0000395"},{"@id":"https://homosaurus.org/v5/homoit0000396"},{"@id":"https://homosaurus.org/v5/homoit0000418"},{"@id":"https://homosaurus.org/v5/homoit0000436"},{"@id":"https://homosaurus.org/v5/homoit0000454"},{"@id":"https://homosaurus.org/v5/homoit0000645"},{"@id":"https://homosaurus.org/v5/homoit0000648"},{"@id":"https://homosaurus.org/v5/homoit0000677"},{"@id":"https://homosaurus.org/v5/homoit0000986"},{"@id":"https://homosaurus.org/v5/homoit0001094"},{"@id":"https://homosaurus.org/v5/homoit0001095"},{"@id":"https://homosaurus.org/v5/homoit0001258"},{"@id":"https://homosaurus.org/v5/homoit0001296"},{"@id":"https://homosaurus.org/v5/homoit0001325"},{"@id":"https://homosaurus.org/v5/homoit0001470"},{"@id":"https://homosaurus.org/v5/homoit0001472"},{"@id":"https://homosaurus.org/v5/homoit0001484"},{"@id":"https://homosaurus.org/v5/homoit0001564"},{"@id":"https://homosaurus.org/v5/homoit0001669"},{"@id":"https://homosaurus.org/v5/homoit0001822"},{"@id":"https://homosaurus.org/v5/homoit0001895"},{"@id":"https://homosaurus.org/v5/homoit0001980"},{"@id":"https://homosaurus.org/v5/homoit0002230"},{"@id":"https://homosaurus.org/v5/homoit0003816"},{"@id":"https://homosaurus.org/v5/homoit0003817"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0002260"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000878"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQHistoricalTerms"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000978","dc:identifier":"homoit0000978","skos:prefLabel":[{"@language":"en","@value":"Macho men"},{"@language":"es","@value":"Hombres macho"},{"@language":"nl","@value":"Machomannen"},{"@language":"sv","@value":"Machobögar"}],"skos:altLabel":[{"@language":"en","@value":"Machos"},{"@language":"es","@value":"Machos"},{"@language":"nl","@value":"Macho's"}],"rdfs:comment":[{"@language":"en","@value":"Subculture of gay men who display characteristics associated with machismo (e.g., masculine pride, self-reliance, physical strength). Though \"macho men\" can be used more broadly, this term refers to gay men who embrace machismo and traditional masculinity through their dress and behavior."},{"@language":"es","@value":"Subcultura de hombres gay que muestran características asociadas con el machismo (por ejemplo, el orgullo masculino, la autosuficiencia, la fuerza física). Aunque \"hombres machos\" puede utilizarse de forma más amplia, este término se refiere a hombres gay que abrazan el machismo y la masculinidad tradicional a través de su vestimenta y comportamiento."},{"@language":"nl","@value":"Subcultuur van homomannen die kenmerken vertonen die geassocieerd worden met machismo (bijvoorbeeld mannelijke trots, zelfredzaamheid, fysieke kracht). Hoewel \"machoman\" breder kan worden gebruikt, verwijst deze term naar homomannen die machismo en traditionele mannelijkheid omarmen door middel van hun kleding en gedrag."},{"@language":"sv","@value":"En subkultur av bögar som uttrycker drag av machismo, som maskulinitet, självständighet och fysisk styrka. Termen används här för bögar som omfamnar traditionell maskulinitet genom klädstil och beteende."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000506"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000095"},{"@id":"https://homosaurus.org/v5/homoit0000655"},{"@id":"https://homosaurus.org/v5/homoit0000995"},{"@id":"https://homosaurus.org/v5/homoit0002148"},{"@id":"https://homosaurus.org/v5/homoit0002149"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/machoMen"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001009","dc:identifier":"homoit0001009","skos:prefLabel":[{"@language":"en","@value":"Men who have sex with men"},{"@language":"es","@value":"Hombres que tienen sexo con hombres"},{"@language":"nl","@value":"Mannen die seks hebben met mannen"},{"@language":"sv","@value":"Män som har sex med män"}],"skos:altLabel":[{"@language":"en","@value":"MSM"},{"@language":"sv","@value":"MSM"}],"rdfs:comment":[{"@language":"en","@value":"Men who engage in sexual activity with other men, whether or not they identify as gay or bisexual."},{"@language":"es","@value":"Hombres que participan de actividades sexuales con otros hombres, se autoidentifiquen o no como gay o bisexuales."},{"@language":"nl","@value":"Mannen die seksuele activiteiten aangaan met andere mannen, ongeacht of ze zich identificeren als homo of biseksueel."},{"@language":"sv","@value":"Män som har sex med män, oavsett om de identifierar sig som homosexuella, bisexuella eller inte."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000915"},{"@id":"https://homosaurus.org/v5/homoit0001008"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000095"},{"@id":"https://homosaurus.org/v5/homoit0000160"},{"@id":"https://homosaurus.org/v5/homoit0000365"},{"@id":"https://homosaurus.org/v5/homoit0000506"},{"@id":"https://homosaurus.org/v5/homoit0001254"},{"@id":"https://homosaurus.org/v5/homoit0001297"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/menWhoHaveSexWithMen"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002017","dc:identifier":"homoit0002017","skos:prefLabel":[{"@language":"en","@value":"Chicano/a/x gay men"},{"@language":"es","@value":"Hombres gay chicanos"},{"@language":"de","@value":"Schwule Chicanos"},{"@language":"nl","@value":"Chicano/a/x homomannen"},{"@language":"sv","@value":"Bögar som är Chicano/a/x"}],"skos:altLabel":[{"@language":"en","@value":"Chicano gay men"},{"@language":"en","@value":"Chicanx gay men"},{"@language":"en","@value":"Gay Chicanos"},{"@language":"en","@value":"Gay Chicanx men"},{"@language":"en","@value":"Gay Chicanxs"},{"@language":"es","@value":"Chicanos gay"},{"@language":"es","@value":"Gays chicanos"},{"@language":"de","@value":"Schwule Chicano-Männer"},{"@language":"de","@value":"Schwule chicano Männer"},{"@language":"de","@value":"Chicano schwule Männer"},{"@language":"nl","@value":"Chicanx homomannen"},{"@language":"nl","@value":"Homo Chicanos"},{"@language":"nl","@value":"Homo Chicanx mannen"},{"@language":"nl","@value":"Homo Chicanxs"},{"@language":"sv","@value":"Chicano/a/x-bögar"}],"rdfs:comment":[{"@language":"en","@value":"Gay men of Mexican descent born in the United States; only use to describe people who self-identify as Chicano, Chicana, or Chicanx. Do not conflate with Latino/a/x or Hispanic people."},{"@language":"es","@value":"Hombres gay de ascendencia mexicana nacidos en Estados Unidos; utilícese únicamente para describir a personas que se autoidentifiquen como chicanas. No se debe confundir con latinos/a/x o hispanos."},{"@language":"de","@value":"Schwule Männer mexikanischer Abstammung, die in den Vereinigten Staaten geboren sind; nur zur Beschreibung von Personen verwenden, die sich selbst als Chicano bezeichnen. Nicht mit Latino Hispanoamerikaner gleichsetzen."},{"@language":"nl","@value":"Homomannen van Mexicaanse afkomst geboren in de Verenigde Staten; alleen gebruiken om mensen te beschrijven die zichzelf identificeren als Chicano, Chicana of Chicanx. Niet verwarren met Latino/a/x of Hispanic"},{"@language":"sv","@value":"Bögar av mexikanskt ursprung födda i USA. Används endast för personer som själva identifierar sig som chicano, chicana eller chicanx. Ska inte förväxlas med latino/a/x eller spansktalande personer."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002007"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000095"},"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh91001712"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-05-11"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000096","dc:identifier":"homoit0000096","skos:prefLabel":[{"@language":"tsg","@value":"Bantut"},{"@language":"es","@value":"Bantut"},{"@language":"de","@value":"Bantut"},{"@language":"nl","@value":"Bantut"},{"@language":"sv","@value":"Bantut"}],"rdfs:comment":[{"@language":"en","@value":"Filipino term for gay men who assume the clothes and/or mannerisms of women."},{"@language":"es","@value":"Término filipino para referirse a un hombre gay que adopta la vestimenta y/o los gestos de una mujer."},{"@language":"de","@value":"Philippinischer Begriff für schwule Männer, die die Kleidung und/oder das Verhalten von Frauen übernehmen"},{"@language":"nl","@value":"Filipijnse term voor een homoseksuele man die de kleding en/of maniertjes van vrouwen aanneemt"},{"@language":"sv","@value":"Filippinsk term för bögar som klär sig i kvinnokläder och/eller antar feminina manér."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000322"},{"@id":"https://homosaurus.org/v5/homoit0001560"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bantut"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000097","dc:identifier":"homoit0000097","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ Baptists"},{"@language":"es","@value":"Bautistas LGBTQ+"},{"@language":"ja","@value":"LGBTQ+のバプテスト信徒"},{"@language":"nl","@value":"LHBTQ+-baptisten"},{"@language":"sv","@value":"Baptister (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"Baptists (LGBTQ)"},{"@language":"en","@value":"LGBTQ Baptists"}],"rdfs:comment":[{"@language":"en","@value":"LGBTQ+ people who are Baptist."},{"@language":"es","@value":"Personas LGBTQ+ que son bautistas."},{"@language":"ja","@value":"キリスト教バプテスト派のLGBTQ+の人々。"},{"@language":"sv","@value":"Hbtq+-personer som är baptister."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001137"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000928"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQBaptists"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000098","dc:identifier":"homoit0000098","skos:prefLabel":[{"@language":"en","@value":"Berdache"},{"@language":"es","@value":"Berdache"},{"@language":"de","@value":"Berdache"},{"@language":"nl","@value":"Berdache"},{"@language":"sv","@value":"Berdache"}],"skos:altLabel":[{"@language":"en","@value":"Bardache"},{"@language":"es","@value":"Berdache"},{"@language":"es","@value":"Bardache"}],"rdfs:comment":[{"@language":"en","@value":"An offensive term developed by settler anthropologists to broadly describe Indigenous people expressing mixed gender roles; only use in historical contexts."},{"@language":"es","@value":"Término ofensivo desarrollado por antropólogos colonizadores para describir ampliamente a los indígenas que expresan roles mixtos de género; utilícese únicamente en contextos históricos."},{"@language":"de","@value":"Ein beleidigender Begriff, der von Siedler-Anthropologen entwickelt wurde, um im weitesten Sinne indigene Menschen zu beschreiben, die gemischte Geschlechterrollen zum Ausdruck bringen; wird nur in historischen Kontexten verwendet."},{"@language":"sv","@value":"En nedsättande term skapad av västerländska antropologer för att generellt beskriva ursprungsfolk som uttrycker blandade könsroller. Bör endast användas i historiska sammanhang."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000878"},{"@id":"https://homosaurus.org/v5/homoit0001560"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001037"},{"@id":"https://homosaurus.org/v5/homoit0001480"},{"@id":"https://homosaurus.org/v5/homoit0001914"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000878"},"dc:replaces":{"@id":"http://homosaurus.org/v2/berdache"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001037","dc:identifier":"homoit0001037","skos:prefLabel":[{"@language":"en","@value":"Native American LGBTQ+ people"},{"@language":"es","@value":"Personas LGBTQ+ nativoamericanas"},{"@language":"nl","@value":"Indiaans-Amerikaanse LHBTQ+-personen"},{"@language":"sv","@value":"Ursprungsamerikanska hbtq+-personer"}],"skos:altLabel":[{"@language":"en","@value":"American Indians (LGBTQ)"},{"@language":"en","@value":"Native Americans (LGBTQ)"},{"@language":"en","@value":"American Indian LGBTQ+ people"},{"@language":"en","@value":"LGBTQ+ American Indians"},{"@language":"en","@value":"LGBTQ+ Native Americans"},{"@language":"es","@value":"Personas nativoamericanas LGBTQ+"},{"@language":"nl","@value":"Amerikaanse Indianen (LHBTQ+)"},{"@language":"nl","@value":"LHBTQ+ Amerikaanse indianen"},{"@language":"nl","@value":"LHBTQ+ Native Americans"},{"@language":"nl","@value":"Native Americans (LHBTQ+)"}],"rdfs:comment":[{"@language":"en","@value":"People who are part of the Native peoples of the continental United States and Canada (excluding Inuit people) and self-identity as LGBTQ+. Use more specific terms when available."},{"@language":"es","@value":"Personas LGBTQ+ que son nativoamericanas o parte de los pueblos indígenas de Norteamérica; utilícese únicamente para personas que se autoidentifiquen como nativoamericanas y LGBTQ+."},{"@language":"nl","@value":"LGBTQ+-personen die Native American zijn, of deel uitmaken van de inheemse volkeren van Noord-Amerika; alleen gebruiken voor personen die zichzelf identificeren als Native American en LGBTQ+."},{"@language":"sv","@value":"Personer som tillhör ursprungsfolken i det kontinentala USA och Kanada (exklusive inuiter) och som identifierar sig som hbtq+. Använd mer specifika termer där det är möjligt."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000886"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000165"},{"@id":"https://homosaurus.org/v5/homoit0000513"},{"@id":"https://homosaurus.org/v5/homoit0000758"},{"@id":"https://homosaurus.org/v5/homoit0001190"},{"@id":"https://homosaurus.org/v5/homoit0001426"},{"@id":"https://homosaurus.org/v5/homoit0002925"},{"@id":"https://homosaurus.org/v5/homoit0002964"},{"@id":"https://homosaurus.org/v5/homoit0003422"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000098"},{"@id":"https://homosaurus.org/v5/homoit0001480"},{"@id":"https://homosaurus.org/v5/homoit0001809"},{"@id":"https://homosaurus.org/v5/homoit0001810"},{"@id":"https://homosaurus.org/v5/homoit0001914"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/nativeAmericansLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001914","dc:identifier":"homoit0001914","skos:prefLabel":[{"@language":"en","@value":"Two-Spirit identity"},{"@language":"es","@value":"Identidad dos espíritus"},{"@language":"nl","@value":"Two-Spirit identiteit"},{"@language":"sv","@value":"Two-spirit-identitet"}],"skos:altLabel":[{"@language":"en","@value":"2S identity"},{"@language":"en","@value":"Two Spirit identity"},{"@language":"en","@value":"Two Spirited identity"},{"@language":"en","@value":"Two-Spirited identity"}],"rdfs:comment":[{"@language":"en","@value":"Identity term used by Indigenous people in North America to reconnect with the multiple gender and sexual roles in Indigenous cultures."},{"@language":"es","@value":"Término de identidad utilizado por las comunidades indígenas de Norteamérica para reconectar con los múltiples roles de género y sexuales de las culturas indígenas."},{"@language":"nl","@value":"Identiteit-term die wordt gebruikt door inheemse volkeren in Noord-Amerika om opnieuw contact te maken met meerdere gender- en seksuele rollen in inheemse culturen"},{"@language":"sv","@value":"Identitetsterm som används av nordamerikanska urfolk för att återknyta till mångfalden av könsroller och sexuella roller i urfolkskulturer."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000322"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000098"},{"@id":"https://homosaurus.org/v5/homoit0001037"},{"@id":"https://homosaurus.org/v5/homoit0002581"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2022-03-29"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001239","dc:identifier":"homoit0001239","skos:prefLabel":[{"@language":"en-us","@value":"Risk behaviors"},{"@language":"es","@value":"Conductas de riesgo"},{"@language":"nl","@value":"Risicogedrag"},{"@language":"sv","@value":"Sexuella riskbeteenden"},{"@language":"en-gb","@value":"Risk behaviours"}],"rdfs:comment":[{"@language":"en","@value":"Behaviors that may put someone at increased risk of contracting HIV or STIs."},{"@language":"es","@value":"Comportamientos que pueden poner a alguien en mayor riesgo de contraer VIH o ITS."},{"@language":"nl","@value":"met betrekking tot soa's en hiv/aids"},{"@language":"sv","@value":"Beteenden som ökar risken för att få hiv eller andra könssjukdomar."}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000099"},{"@id":"https://homosaurus.org/v5/homoit0003129"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001251"},{"@id":"https://homosaurus.org/v5/homoit0001287"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85114203"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001239"},"dc:replaces":{"@id":"http://homosaurus.org/v2/riskBehaviours"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000100","dc:identifier":"homoit0000100","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ bars"},{"@language":"es","@value":"Bares LGBTQ+"},{"@language":"nl","@value":"LHBTQ+-bars"},{"@language":"sv","@value":"Hbtq+-barer"}],"skos:altLabel":[{"@language":"en","@value":"Bars (LGBTQ)"},{"@language":"es","@value":"Bares (LGBTQ)"}],"rdfs:comment":[{"@language":"en","@value":"Drinking establishments that primarily cater to LGBTQ+ people."},{"@language":"es","@value":"Establecimientos que sirven alcohol y son frecuentados principalmente por personas LGBTQ+."},{"@language":"nl","@value":"Drinkgelegenheden die zich voornamelijk richten op LHBTQ+-personen."},{"@language":"sv","@value":"Barer eller uteställen som främst besöks av hbtq+-personer."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000900"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000133"},{"@id":"https://homosaurus.org/v5/homoit0000369"},{"@id":"https://homosaurus.org/v5/homoit0000474"},{"@id":"https://homosaurus.org/v5/homoit0000724"},{"@id":"https://homosaurus.org/v5/homoit0001161"},{"@id":"https://homosaurus.org/v5/homoit0001394"},{"@id":"https://homosaurus.org/v5/homoit0001553"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000909"},{"@id":"https://homosaurus.org/v5/homoit0000925"},{"@id":"https://homosaurus.org/v5/homoit0002384"},{"@id":"https://homosaurus.org/v5/homoit0004294"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000900"},"dc:replaces":{"@id":"http://homosaurus.org/v2/barsLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000900","dc:identifier":"homoit0000900","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ meeting places"},{"@language":"es","@value":"Espacios de encuentro LGBTQ+"},{"@language":"nl","@value":"LHBTQ+-ontmoetingsplaatsen"},{"@language":"sv","@value":"Hbtq+-mötesplatser"}],"skos:altLabel":[{"@language":"en","@value":"LGBTQ meeting places"},{"@language":"es","@value":"Espacios de reunión LGBTQ+"},{"@language":"es","@value":"Espacios de encuentro LGBTQ"},{"@language":"es","@value":"Espacios de reunión LGBTQ"}],"rdfs:comment":[{"@language":"en","@value":"Physical or online spaces in which LGBTQ+ people meet."},{"@language":"es","@value":"Espacios físicos o en línea en los que se encuentran personas LGBTQ+."},{"@language":"nl","@value":"Fysieke of online ruimtes waar LHBTQ+-personen elkaar kunnen ontmoeten."},{"@language":"sv","@value":"Fysiska eller digitala mötesplatser för hbtq+-personer."}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000100"},{"@id":"https://homosaurus.org/v5/homoit0000104"},{"@id":"https://homosaurus.org/v5/homoit0000298"},{"@id":"https://homosaurus.org/v5/homoit0003699"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000319"},{"@id":"https://homosaurus.org/v5/homoit0000846"},{"@id":"https://homosaurus.org/v5/homoit0000847"},{"@id":"https://homosaurus.org/v5/homoit0000861"},{"@id":"https://homosaurus.org/v5/homoit0000909"},{"@id":"https://homosaurus.org/v5/homoit0000946"},{"@id":"https://homosaurus.org/v5/homoit0000974"},{"@id":"https://homosaurus.org/v5/homoit0001142"},{"@id":"https://homosaurus.org/v5/homoit0002157"},{"@id":"https://homosaurus.org/v5/homoit0002166"},{"@id":"https://homosaurus.org/v5/homoit0002202"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000900"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQMeetingPlaces"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000133","dc:identifier":"homoit0000133","skos:prefLabel":[{"@language":"en","@value":"Bisexual bars"},{"@language":"es","@value":"Bares bisexuales"},{"@language":"de","@value":"Bisexuelle Bars"},{"@language":"nl","@value":"Biseksuele bars"},{"@language":"sv","@value":"Bisexuella barer"}],"skos:altLabel":{"@language":"es","@value":"Barras bisexuales"},"rdfs:comment":[{"@language":"en","@value":"Drinking establishments that primarily cater to bisexual people."},{"@language":"es","@value":"Establecimientos para beber que atienden principalmente a personas bisexuales."},{"@language":"de","@value":"Lokale bzw. Trinklokale oder Gaststätten, die sich in erster Linie an bisexuelle Menschen wenden."},{"@language":"nl","@value":"Drinkgelegenheden die zich primair richten op biseksuele personen."},{"@language":"sv","@value":"Barer eller uteställen som främst riktar sig till bisexuella personer."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000100"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000170"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000900"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualBars"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000369","dc:identifier":"homoit0000369","skos:prefLabel":[{"@language":"en","@value":"Drag bars"},{"@language":"es","@value":"Bares drag"},{"@language":"de","@value":"Drag-Bars"},{"@language":"nl","@value":"Drag bars"},{"@language":"sv","@value":"Dragbarer"}],"skos:altLabel":{"@language":"de","@value":"Dragbars"},"rdfs:comment":[{"@language":"en","@value":"Establishments (typically serving alcohol) that host drag shows or other events featuring drag performers."},{"@language":"es","@value":"Establecimientos (que usualmente sirven alcohol) que presentan espectáculos de drag u otros eventos con artistas drag."},{"@language":"de","@value":"Betriebe, die in der Regel Alkohol anbieten, die Drag-Shows oder andere Veranstaltungen veranstalten, in denen Drag-Künstler:innen auftreten."},{"@language":"nl","@value":"Drinkgelegenheden die dragshows of andere evenementen organiseren met dragartiesten."},{"@language":"sv","@value":"Barer eller uteställen som arrangerar dragshower eller andra evenemang med dragartister."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000100"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000367"},{"@id":"https://homosaurus.org/v5/homoit0000370"},{"@id":"https://homosaurus.org/v5/homoit0000925"},{"@id":"https://homosaurus.org/v5/homoit0003359"},{"@id":"https://homosaurus.org/v5/homoit0003360"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000900"},"dc:replaces":{"@id":"http://homosaurus.org/v2/dragBars"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000724","dc:identifier":"homoit0000724","skos:prefLabel":[{"@language":"en","@value":"Lesbian bars"},{"@language":"es","@value":"Bares lésbicos"},{"@language":"de","@value":"Lesbenbars"},{"@language":"nl","@value":"Lesbische bars"},{"@language":"sv","@value":"Lesbiska barer"}],"skos:altLabel":{"@language":"de","@value":"Lesbische Bars"},"rdfs:comment":[{"@language":"en","@value":"Drinking establishments that primarily cater to lesbians."},{"@language":"es","@value":"Establecimientos de bebidas que atienden principalmente a lesbianas."},{"@language":"de","@value":"Lokale bzw. Trinklokale oder Gaststätten, die sich in erster Linie an Lesben wenden."},{"@language":"nl","@value":"Drinkgelegenheden die zich voornamelijk richten op lesbische vrouwen."},{"@language":"sv","@value":"Barer eller uteställen som främst vänder sig till lesbiska."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000100"},"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0003719"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000733"},{"@id":"https://homosaurus.org/v5/homoit0000925"},{"@id":"https://homosaurus.org/v5/homoit0004649"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2001007148"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000900"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianBars"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001161","dc:identifier":"homoit0001161","skos:prefLabel":[{"@language":"en","@value":"Queer bars"},{"@language":"es","@value":"Bares queer"},{"@language":"nl","@value":"Queer bars"},{"@language":"sv","@value":"Queera barer"}],"rdfs:comment":[{"@language":"en","@value":"Drinking establishments that primarily cater to queer people."},{"@language":"es","@value":"Establecimientos de bebidas que atienden principalmente a personas queer."},{"@language":"nl","@value":"Drinkgelegenheden die zich voornamelijk richten op queer personen."},{"@language":"sv","@value":"Barer eller uteställen som främst vänder sig till queera personer."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000100"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001170"},{"@id":"https://homosaurus.org/v5/homoit0004650"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000900"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerBars"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001394","dc:identifier":"homoit0001394","skos:prefLabel":[{"@language":"en","@value":"Transgender bars"},{"@language":"es","@value":"Bares transgénero"},{"@language":"nl","@value":"Transgender bars"},{"@language":"sv","@value":"Transbarer"}],"rdfs:comment":[{"@language":"en","@value":"Drinking establishments that primarily cater to transgender people."},{"@language":"es","@value":"Establecimientos de bebidas que atienden principalmente a personas transgénero."},{"@language":"nl","@value":"Drinkgelegenheden die zich voornamelijk richten op transgender personen."},{"@language":"sv","@value":"Barer eller uteställen som i första hand vänder sig till transpersoner."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000100"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0004652"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000900"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transgenderBars"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000909","dc:identifier":"homoit0000909","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ night life"},{"@language":"es","@value":"Vida nocturna LGBTQ+"},{"@language":"nl","@value":"LHBTQ+-uitgaansleven"},{"@language":"sv","@value":"Uteliv (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"LGBTQ night life"},{"@language":"es","@value":"Vida nocturna (LGBTQ)"}],"rdfs:comment":[{"@language":"en","@value":"Nighttime social activities and entertainment catering to LGBTQ+ people, often located at bars and clubs."},{"@language":"es","@value":"Actividades sociales nocturnas y entretenimiento para personas LGBTQ+, a menudo ubicadas en bares y discotecas."},{"@language":"nl","@value":"Nachtelijke sociale activiteiten en vermaak voor LHBTQ+-personen, vaak in bars en clubs."},{"@language":"sv","@value":"Sociala aktiviteter och nöjesverksamhet som riktar sig till hbtq+-personer, ofta förlagda till barer och klubbar."}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000475"},{"@id":"https://homosaurus.org/v5/homoit0000488"},{"@id":"https://homosaurus.org/v5/homoit0004649"},{"@id":"https://homosaurus.org/v5/homoit0004650"},{"@id":"https://homosaurus.org/v5/homoit0004651"},{"@id":"https://homosaurus.org/v5/homoit0004652"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000100"},{"@id":"https://homosaurus.org/v5/homoit0000892"},{"@id":"https://homosaurus.org/v5/homoit0000900"},{"@id":"https://homosaurus.org/v5/homoit0000930"},{"@id":"https://homosaurus.org/v5/homoit0002385"},{"@id":"https://homosaurus.org/v5/homoit0004294"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000909"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQNightLife"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000925","dc:identifier":"homoit0000925","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ pubs"},{"@language":"es","@value":"Pubs LGBTQ+"},{"@language":"nl","@value":"LHBTQ+-café's"},{"@language":"sv","@value":"Hbtq+-pubar"}],"skos:altLabel":[{"@language":"en","@value":"LGBTQ public houses"},{"@language":"en","@value":"LGBTQ pubs"},{"@language":"es","@value":"Tabernas LGBTQ+"},{"@language":"sv","@value":"Pubar (hbtq+)"}],"rdfs:comment":[{"@language":"en","@value":"A drinking establishment that serves food and acts as a community gathering place; use in reference to pubs that primarily cater to LGBTQ+ people."},{"@language":"es","@value":"Un establecimiento de bebidas que sirve comida y funge como lugar de encuentro comunitario; utilícese en referencia a pubs que atienden principalmente a personas LGBTQ+."},{"@language":"nl","@value":"Een drinkgelegenheid die ook eten serveert en fungeert als ontmoetingsplaats voor de gemeenschap; gebruik om te verwijzen naar café's die zich voornamelijk richten op LHBTQ+-personen."},{"@language":"sv","@value":"Uteställe med matservering som också fungerar som mötesplats. Används för pubar som främst vänder sig till hbtq+-personer."}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000100"},{"@id":"https://homosaurus.org/v5/homoit0000369"},{"@id":"https://homosaurus.org/v5/homoit0000474"},{"@id":"https://homosaurus.org/v5/homoit0000724"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000925"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQPubs"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002384","dc:identifier":"homoit0002384","skos:prefLabel":[{"@language":"en","@value":"Police raids on LGBTQ+ bars"},{"@language":"es","@value":"Redadas policiales en bares LGBTQ+"},{"@language":"nl","@value":"Politie-invallen in LHBTQ+-bars"},{"@language":"sv","@value":"Polisräder mot hbtq+-barer"}],"skos:altLabel":[{"@language":"es","@value":"Redadas policiales en bars LGBTQ+"},{"@language":"sv","@value":"Polisrazzior mot hbtq+-barer"}],"rdfs:comment":[{"@language":"en","@value":"Unexpected and unannounced entry into and searches of drinking establishments owned or frequented by LGBTQ+ people by law enforcement officers with the aim of using surprise to seize evidence or arrest suspects. Police raids may be undertaken legally using a search warrant or through exigent circumstances, such as probable cause, though the latter is highly subjective and civilians often have little resources to appeal illegal raids."},{"@language":"es","@value":"Redadas policiales en bares afiliados o relacionados con comunidades e identidades LGBTQ+."},{"@language":"nl","@value":"Politie-invallen in LGBTQ+-gelieerde of -gerelateerde bars."},{"@language":"sv","@value":"Oannonserade och oväntade intrång i och genomsökningar av uteställen som ägs av eller frekventeras av hbtq+-personer, genomförda av poliser i syfte att överraska för att beslagta bevis eller gripa misstänkta. Polisräder kan genomföras lagligt med stöd av husrannsakan eller genom påstådda brådskande omständigheter, till exempel sannolika skäl, vilket är subjektivt och ofta ger begränsade möjligheter för civila att överklaga olagliga räder."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002381"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000100"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000611"},"dc:issued":{"@type":"xsd:date","@value":"2023-01-13"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004294","dc:identifier":"homoit0004294","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ bar signs"},{"@language":"ja","@value":"LGBTQ+バーの看板"},{"@language":"nl","@value":"LHBTQ+-uithangborden van bars"},{"@language":"sv","@value":"Skyltar för hbtq+-barer"}],"skos:altLabel":[{"@language":"en","@value":"LGBTQ+ club signs"},{"@language":"ja","@value":"LGBTQ+クラブの看板"}],"rdfs:comment":[{"@language":"en","@value":"Visual displays such as signs, banners, and other graphics advertising drinking establishments that primarily cater to LGBTQ+ people. Signs may be exterior and/or interior to the business."},{"@language":"ja","@value":"LGBTQ+の人々を主な対象とする飲酒施設を宣伝する看板、バナー、その他のグラフィックなどの視覚的表示物。看板は、店舗の外装および／または内装に設置される場合がある。"},{"@language":"nl","@value":"Visuele uitingen zoals borden, spandoeken en andere grafische elementen die reclame maken voor horecagelegenheden die zich voornamelijk richten op LHBTQ+-personen. Borden kunnen zowel aan de buiten- als binnenkant van het bedrijf worden geplaatst."},{"@language":"sv","@value":"Visuella skyltar, banderoller och annan grafik som marknadsför barer och liknande som främst riktar sig till hbtq+-personer. Skyltarna kan vara placerade både utanför och inne i verksamheten."}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000100"},{"@id":"https://homosaurus.org/v5/homoit0000909"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0004294"},"dc:issued":{"@type":"xsd:date","@value":"2026-02-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000103","dc:identifier":"homoit0000103","skos:prefLabel":[{"@language":"en","@value":"Kink community"},{"@language":"es","@value":"Comunidad kink"},{"@language":"nl","@value":"Kink gemeenschap"},{"@language":"sv","@value":"Kink-gemenskap"}],"skos:altLabel":[{"@language":"sv","@value":"Kink-communityn"},{"@language":"sv","@value":"Kinkster-gemenskap"},{"@language":"sv","@value":"Kinkster-community"}],"rdfs:comment":[{"@language":"en","@value":"A broad term including all communities of people interested in kinks and fetishes, including or overlapping with certain subcultures such as the leather community and rubber and latex communities. "},{"@language":"es","@value":"Grupos de personas que comparten una preferencia por las actividades eróticas y sexuales que involucran la restricción, la dominación, la sumisión, el sadismo y/o el masoquismo."},{"@language":"nl","@value":"Een brede term die alle gemeenschappen omvat van mensen die geïnteresseerd zijn in kink en fetisj, inclusief of overlappend met bepaalde subculturen zoals de leergemeenschap en rubber- en latexgemeenschappen."},{"@language":"sv","@value":"Ett brett begrepp som innefattar alla gemenskaper av personer med intresse för kink och fetischer, inklusive subkulturer som läder-, gummi- och latexgemenskaper."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000297"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000363"},{"@id":"https://homosaurus.org/v5/homoit0000442"},{"@id":"https://homosaurus.org/v5/homoit0000705"},{"@id":"https://homosaurus.org/v5/homoit0001353"},{"@id":"https://homosaurus.org/v5/homoit0001376"},{"@id":"https://homosaurus.org/v5/homoit0003084"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000297"},"dc:replaces":{"@id":"http://homosaurus.org/v2/BDSMCommunity"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000297","dc:identifier":"homoit0000297","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ communities"},{"@language":"es","@value":"Comunidades LGBTQ+"},{"@language":"ja","@value":"LGBTQ+コミュニティ"},{"@language":"nl","@value":"LHBTQ+-gemeenschappen"},{"@language":"sv","@value":"Hbtq+-gemenskaper"}],"skos:altLabel":[{"@language":"en","@value":"Communities (LGBTQ)"},{"@language":"es","@value":"Comunidades (LGBTQ)"},{"@language":"sv","@value":"Hbtq+-communities"}],"rdfs:comment":[{"@language":"en","@value":"Groups of LGBTQ+ people who share interests or interact regularly, typically living in some proximity."},{"@language":"es","@value":"Grupos de personas LGBTQ+ que comparten intereses o interactúan regularmente y que generalmente viven en cierta proximidad."},{"@language":"ja","@value":"共通の関心事を持っていたり、定期的に交流したりするLGBTQ+の人々のグループで、通常は近隣に住んでいる。"},{"@language":"nl","@value":"Een groep van interacterende mensen, die in enige nabijheid wonen"},{"@language":"sv","@value":"Grupper av hbtq+-personer som delar intressen eller har regelbunden kontakt, oftast med geografisk närhet."}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000103"},{"@id":"https://homosaurus.org/v5/homoit0000143"},{"@id":"https://homosaurus.org/v5/homoit0000370"},{"@id":"https://homosaurus.org/v5/homoit0000485"},{"@id":"https://homosaurus.org/v5/homoit0000705"},{"@id":"https://homosaurus.org/v5/homoit0000733"},{"@id":"https://homosaurus.org/v5/homoit0000842"},{"@id":"https://homosaurus.org/v5/homoit0001170"},{"@id":"https://homosaurus.org/v5/homoit0001247"},{"@id":"https://homosaurus.org/v5/homoit0001403"},{"@id":"https://homosaurus.org/v5/homoit0001878"},{"@id":"https://homosaurus.org/v5/homoit0002773"},{"@id":"https://homosaurus.org/v5/homoit0002931"},{"@id":"https://homosaurus.org/v5/homoit0003032"},{"@id":"https://homosaurus.org/v5/homoit0003698"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000298"},{"@id":"https://homosaurus.org/v5/homoit0000558"},{"@id":"https://homosaurus.org/v5/homoit0001811"},{"@id":"https://homosaurus.org/v5/homoit0003699"},{"@id":"https://homosaurus.org/v5/homoit0003911"}],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2014000538"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000297"},"dc:replaces":{"@id":"http://homosaurus.org/v2/communitiesLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000363","dc:identifier":"homoit0000363","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ dominatrices"},{"@language":"ja","@value":"LGBTQ+のドミナ"},{"@language":"es","@value":"Dominatrices LGBTQ+"},{"@language":"nl","@value":"LHBTQ+-dominatrices"},{"@language":"sv","@value":"Dominatrixer (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"Dominatrices (LGBTQ)"},{"@language":"en","@value":"LGBTQ+ D-types"},{"@language":"en","@value":"LGBTQ+ Dommes"},{"@language":"en","@value":"LGBTQ+ Mistresses"},{"@language":"ja","@value":"ドミナ（LGBTQ）"},{"@language":"ja","@value":"LGBTQ+のDタイプ"},{"@language":"es","@value":"Amas LGBTQ+"},{"@language":"es","@value":"Dominatrices (LGBTQ)"},{"@language":"sv","@value":"Dominor (hbtq+)"}],"rdfs:comment":[{"@language":"en","@value":"The person who takes on the position of authority or power in a power exchange relationship or kink activity. Most commonly used by feminine identified people and professional dominants."},{"@language":"ja","@value":"パワー・エクスチェンジの関係やフェチプレイにおいて、権威や支配の立場を担う人。主に女性的なアイデンティティを持つ人やプロのドミナントによって使用される。"},{"@language":"es","@value":"Mujeres que desempeñan un papel dominante en las actividades de BDSM; utilícese para dominatrices que se autoidentifiquen como LGBTQ+."},{"@language":"nl","@value":"Vrouwen die een dominante rol spelen in BDSM-activiteiten; gebruik voor dominatrices die zich identificeren als LHBTQ+."},{"@language":"sv","@value":"Hbtq+-personer som intar en dominant roll inom BDSM och/eller i maktutbytesrelationer med en dominant/underordnad dynamik. Termen används främst av feminint identifierade personer."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001637"},{"@id":"https://homosaurus.org/v5/homoit0003084"}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000148"},{"@id":"https://homosaurus.org/v5/homoit0000738"},{"@id":"https://homosaurus.org/v5/homoit0001175"},{"@id":"https://homosaurus.org/v5/homoit0001410"},{"@id":"https://homosaurus.org/v5/homoit0002990"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000103"},{"@id":"https://homosaurus.org/v5/homoit0000705"},{"@id":"https://homosaurus.org/v5/homoit0000999"},{"@id":"https://homosaurus.org/v5/homoit0001018"},{"@id":"https://homosaurus.org/v5/homoit0001318"},{"@id":"https://homosaurus.org/v5/homoit0003052"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001637"},"dc:replaces":{"@id":"http://homosaurus.org/v2/dominatricesLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000705","dc:identifier":"homoit0000705","skos:prefLabel":[{"@language":"en","@value":"Leather community"},{"@language":"de","@value":"Lederszene"},{"@language":"es","@value":"Comunidad leather"},{"@language":"nl","@value":"Leer gemeenschap"},{"@language":"sv","@value":"Lädergemenskaper"}],"skos:altLabel":[{"@language":"en","@value":"Leather scene"},{"@language":"en","@value":"Leather lifestyle"},{"@language":"en","@value":"Leather"},{"@language":"de","@value":"Ledercommunity"},{"@language":"es","@value":"Comunidad cuero"},{"@language":"sv","@value":"Läderscenen"},{"@language":"sv","@value":"Läderkulturen"},{"@language":"sv","@value":"Lädercommunityn"}],"rdfs:comment":[{"@language":"en","@value":"An LGBTQ+ subculture that celebrates sexual freedom, kinks and fetishes with its own fashions (especially leather garments), clubs, and events."},{"@language":"de","@value":"Eine LGBTQ+-Subkultur, die sexuelle Freiheit, sexuelle Vorlieben und Fetische mit eigener Mode (insbesondere Lederbekleidung), Clubs und Veranstaltungen zelebriert."},{"@language":"es","@value":"Subcultura LGBTQ+ que celebra la libertad sexual, los kinks y los fetiches con su propia moda (especialmente prendas de cuero), clubes y eventos."},{"@language":"sv","@value":"En hbtq+-förknippad subkultur som firar normbrytande sexualitet och sexuell frihet. Subkulturen är förknippad med särskilda uttryck såsom läderkläder, särskilda klubbar och evenemang."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000297"},{"@id":"https://homosaurus.org/v5/homoit0001345"}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000217"},{"@id":"https://homosaurus.org/v5/homoit0000706"},{"@id":"https://homosaurus.org/v5/homoit0000707"},{"@id":"https://homosaurus.org/v5/homoit0000708"},{"@id":"https://homosaurus.org/v5/homoit0000709"},{"@id":"https://homosaurus.org/v5/homoit0000710"},{"@id":"https://homosaurus.org/v5/homoit0001145"},{"@id":"https://homosaurus.org/v5/homoit0003083"},{"@id":"https://homosaurus.org/v5/homoit0003086"},{"@id":"https://homosaurus.org/v5/homoit0003087"},{"@id":"https://homosaurus.org/v5/homoit0003088"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000103"},{"@id":"https://homosaurus.org/v5/homoit0000363"},{"@id":"https://homosaurus.org/v5/homoit0000442"},{"@id":"https://homosaurus.org/v5/homoit0000906"},{"@id":"https://homosaurus.org/v5/homoit0000999"},{"@id":"https://homosaurus.org/v5/homoit0001247"},{"@id":"https://homosaurus.org/v5/homoit0001318"},{"@id":"https://homosaurus.org/v5/homoit0001553"},{"@id":"https://homosaurus.org/v5/homoit0003052"},{"@id":"https://homosaurus.org/v5/homoit0003059"},{"@id":"https://homosaurus.org/v5/homoit0003065"},{"@id":"https://homosaurus.org/v5/homoit0003080"},{"@id":"https://homosaurus.org/v5/homoit0003084"},{"@id":"https://homosaurus.org/v5/homoit0003104"},{"@id":"https://homosaurus.org/v5/homoit0003106"},{"@id":"https://homosaurus.org/v5/homoit0003140"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000297"},"dc:replaces":{"@id":"http://homosaurus.org/v2/leatherCommunity"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001353","dc:identifier":"homoit0001353","skos:prefLabel":[{"@language":"en","@value":"Switches (Sex)"},{"@language":"es","@value":"Versátiles"},{"@language":"nl","@value":"Switches (Seks)"},{"@language":"sv","@value":"Switchar (sex)"}],"skos:altLabel":[{"@language":"en","@value":"Switches"},{"@language":"es","@value":"Vers"},{"@language":"es","@value":"Switch"}],"rdfs:comment":[{"@language":"en","@value":"Slang term for individuals who alternate between being the giving partner and the receiving partner in sexual encounters; typically used as a noun (e.g., \"They're a switch\")."},{"@language":"es","@value":"Término de la jerga para personas que alternan entre ser la pareja que da y la que recibe en encuentros sexuales; normalmente se utiliza como sustantivo (por ejemplo, \"Él es versátil\")."},{"@language":"nl","@value":"Argot term voor personen die afwisselend de \"gevende partner\" en de \"ontvangende partner\" zijn in seksuele ontmoetingen; meestal gebruikt als zelfstandig naamwoord (bijvoorbeeld \"Ze zijn een switch\")"},{"@language":"sv","@value":"Slangterm för personer som växlar mellan att vara den givande och den mottagande parten vid sex. Används oftast som substantiv, till exempel: ”Hen är switch”."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001295"},{"@id":"https://homosaurus.org/v5/homoit0001304"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000103"},{"@id":"https://homosaurus.org/v5/homoit0000219"},{"@id":"https://homosaurus.org/v5/homoit0001376"},{"@id":"https://homosaurus.org/v5/homoit0001779"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001295"},"dc:replaces":{"@id":"http://homosaurus.org/v2/switches"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001376","dc:identifier":"homoit0001376","skos:prefLabel":[{"@language":"en","@value":"Tops (Sex)"},{"@language":"es","@value":"Tops (sexo)"},{"@language":"nl","@value":"Tops (Seks)"},{"@language":"sv","@value":"Toppar (sex)"}],"skos:altLabel":[{"@language":"en","@value":"Pitchers (Sex)"},{"@language":"en","@value":"Pitchers"},{"@language":"en","@value":"Tops"},{"@language":"es","@value":"Activo"},{"@language":"sv","@value":"Aktiv (sex)"}],"rdfs:comment":[{"@language":"en","@value":"Slang term for individuals who act as the giving partner in sexual encounters."},{"@language":"es","@value":"Término de la jerga para personas que asumen el rol de pareja que da en encuentros sexuales."},{"@language":"nl","@value":"Argot term voor personen die optreden als de dominante partner in seksuele praktijken"},{"@language":"sv","@value":"Slangterm för personer som tar den givande rollen vid sexuella möten. Vanlig term i bögsammanhang för en person som vill inta den ”aktiva” rollen vid sex, vilket förväntas bestå av att ge penetration och få oralsex."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001295"},{"@id":"https://homosaurus.org/v5/homoit0001304"}],"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0001018"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000103"},{"@id":"https://homosaurus.org/v5/homoit0000219"},{"@id":"https://homosaurus.org/v5/homoit0000999"},{"@id":"https://homosaurus.org/v5/homoit0001133"},{"@id":"https://homosaurus.org/v5/homoit0001318"},{"@id":"https://homosaurus.org/v5/homoit0001353"},{"@id":"https://homosaurus.org/v5/homoit0001779"},{"@id":"https://homosaurus.org/v5/homoit0002197"},{"@id":"https://homosaurus.org/v5/homoit0003052"},{"@id":"https://homosaurus.org/v5/homoit0003084"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001295"},"dc:replaces":{"@id":"http://homosaurus.org/v2/tops"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000104","dc:identifier":"homoit0000104","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ beaches"},{"@language":"es","@value":"Playas LGBTQ+"},{"@language":"ja","@value":"LGBTQ+向けのビーチ"},{"@language":"nl","@value":"LHBTQ+-stranden"},{"@language":"sv","@value":"Hbtq+-stränder"}],"skos:altLabel":[{"@language":"en","@value":"Beaches (LGBTQ)"},{"@language":"es","@value":"Playas (LGBTQ)"},{"@language":"ja","@value":"ビーチ (LGBTQ)"}],"rdfs:comment":[{"@language":"en","@value":"Beaches set aside for use by LGBTQ+ people or beaches known to be frequented by LGBTQ+ people."},{"@language":"es","@value":"Playas reservadas para el uso de personas LGBTQ+ o playas conocidas por ser frecuentadas por personas LGBTQ+."},{"@language":"ja","@value":"LGBTQ+の人々が利用するために確保されたビーチ、またはLGBTQ+の人々がよく訪れることで知られるビーチ。"},{"@language":"nl","@value":"Stranden die gereserveerd zijn voor gebruik door LHBTQ+-mensen of stranden waarvan bekend is dat ze vaak worden bezocht door LHBTQ+-mensen."},{"@language":"sv","@value":"Stränder som är avsedda för hbtq+-personer eller som är kända för att ofta besökas av hbtq+-personer."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000900"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000134"},{"@id":"https://homosaurus.org/v5/homoit0000476"},{"@id":"https://homosaurus.org/v5/homoit0000725"},{"@id":"https://homosaurus.org/v5/homoit0001050"},{"@id":"https://homosaurus.org/v5/homoit0001162"},{"@id":"https://homosaurus.org/v5/homoit0001395"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000900"},"dc:replaces":{"@id":"http://homosaurus.org/v2/beachesLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000134","dc:identifier":"homoit0000134","skos:prefLabel":[{"@language":"en","@value":"Bisexual beaches"},{"@language":"es","@value":"Playas bisexuales"},{"@language":"de","@value":"Bisexuelle Strände"},{"@language":"nl","@value":"Biseksuele stranden"},{"@language":"sv","@value":"Bisexuella stränder"}],"rdfs:comment":[{"@language":"en","@value":"Beaches set aside for use by bisexual people or beaches known to be frequented by bisexual people."},{"@language":"es","@value":"Playas reservadas para el uso de personas bisexuales o playas conocidas por ser frecuentadas por personas bisexuales."},{"@language":"de","@value":"Strände, die für bisexuelle Menschen reserviert sind, oder Strände, die bekanntermaßen von bisexuellen Menschen besucht werden."},{"@language":"nl","@value":"Stranden die gereserveerd zijn voor gebruik door biseksuelen of stranden waarvan bekend is dat ze bezocht worden door biseksuelen."},{"@language":"sv","@value":"Stränder som är avsedda för bisexuella personer eller som är kända för att ofta besökas av bisexuella personer."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000104"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000170"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000900"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualBeaches"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000476","dc:identifier":"homoit0000476","skos:prefLabel":[{"@language":"en","@value":"Gay beaches"},{"@language":"es","@value":"Playas gay"},{"@language":"de","@value":"Schwule Strände"},{"@language":"nl","@value":"Homostranden"},{"@language":"sv","@value":"Bögstränder"}],"skos:altLabel":[{"@language":"de","@value":"Gay-Strände"},{"@language":"de","@value":"Schwulenstrände"},{"@language":"sv","@value":"Homosexuella manliga stränder"}],"rdfs:comment":[{"@language":"en","@value":"Beaches set aside for use by gay men or beaches known to be frequented by gay men."},{"@language":"es","@value":"Playas reservadas para el uso de hombres gay o playas conocidas por ser frecuentadas por hombres gay."},{"@language":"de","@value":"Strände, die für schwule Männer reserviert sind, oder Strände, die bekanntermaßen von schwulen Männern besucht werden."},{"@language":"nl","@value":"Stranden die gereserveerd zijn voor gebruik door homomannen of stranden waarvan bekend is dat ze bezocht worden door homomannen."},{"@language":"sv","@value":"Stränder som är avsedda för bögar eller som är kända för att ofta besökas av bögar."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000104"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000900"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayBeaches"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000725","dc:identifier":"homoit0000725","skos:prefLabel":[{"@language":"en","@value":"Lesbian beaches"},{"@language":"es","@value":"Playas lésbicas"},{"@language":"de","@value":"Lesbenstrände"},{"@language":"nl","@value":"Lesbische stranden"},{"@language":"sv","@value":"Lesbiska stränder"}],"skos:altLabel":{"@language":"de","@value":"Lesbische Strände"},"rdfs:comment":[{"@language":"en","@value":"Beaches set aside for use by lesbians or beaches known to be frequented by lesbians."},{"@language":"es","@value":"Playas reservadas para el uso de lesbianas o playas conocidas por ser frecuentadas por lesbianas."},{"@language":"de","@value":"Strände, die für Lesben reserviert sind, oder Strände, die bekanntermaßen von Lesben besucht werden."},{"@language":"nl","@value":"Stranden die gereserveerd zijn voor gebruik door lesbische vrouwen of stranden waarvan bekend is dat ze bezocht worden door lesbische vrouwen."},{"@language":"sv","@value":"Stränder som är avsedda för lesbiska eller som är kända för att ofta besökas av lesbiska."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000104"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000900"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianBeaches"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001050","dc:identifier":"homoit0001050","skos:prefLabel":[{"@language":"en","@value":"Nude beaches"},{"@language":"es","@value":"Playas nudistas"},{"@language":"nl","@value":"Naaktstranden"},{"@language":"sv","@value":"Nakenbad"}],"rdfs:comment":[{"@language":"en","@value":"Beaches that permit nudity."},{"@language":"es","@value":"Playas que permiten la desnudez."},{"@language":"nl","@value":"Stranden die naakt zijn toestaan, al dan niet officieel"},{"@language":"sv","@value":"Stränder där nakenhet är tillåten."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000104"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001038"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh98001012"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000900"},"dc:replaces":{"@id":"http://homosaurus.org/v2/nudeBeaches"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001162","dc:identifier":"homoit0001162","skos:prefLabel":[{"@language":"en","@value":"Queer beaches"},{"@language":"es","@value":"Playas queer"},{"@language":"nl","@value":"Queer stranden"},{"@language":"sv","@value":"Queera stränder"}],"rdfs:comment":[{"@language":"en","@value":"Beaches set aside for use by queer people or beaches known to be frequented by queer people."},{"@language":"es","@value":"Playas reservadas para el uso de personas queer o playas conocidas por ser frecuentadas por personas queer."},{"@language":"nl","@value":"Stranden die gereserveerd zijn voor gebruik door queer personen of stranden waarvan bekend is dat ze bezocht worden door queer personen."},{"@language":"sv","@value":"Stränder som är avsedda för queera personer eller som är kända för att ofta besökas av queera personer."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000104"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000900"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerBeaches"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001395","dc:identifier":"homoit0001395","skos:prefLabel":[{"@language":"en","@value":"Transgender beaches"},{"@language":"es","@value":"Playas transgénero"},{"@language":"nl","@value":"Transgender stranden"},{"@language":"sv","@value":"Stränder för transpersoner"}],"skos:altLabel":{"@language":"es","@value":"Playas trans"},"rdfs:comment":[{"@language":"en","@value":"Beaches set aside for use by transgender people or beaches known to be frequented by transgender people."},{"@language":"es","@value":"Playas reservadas para uso por personas transgénero o playas conocidas por ser frecuentadas por personas transgénero."},{"@language":"nl","@value":"Stranden die gereserveerd zijn voor gebruik door transgender personen of stranden waarvan bekend is dat ze bezocht worden door transgender personen."},{"@language":"sv","@value":"Stränder som är avsedda för transpersoner eller som är kända för att ofta besökas av transpersoner."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000104"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000900"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transgenderBeaches"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000105","dc:identifier":"homoit0000105","skos:prefLabel":[{"@language":"en","@value":"Bears (Gay culture)"},{"@language":"de","@value":"Bären (schwuler Kontext)"},{"@language":"es","@value":"Bears (Cultura gay)"},{"@language":"fr","@value":"Ours (culture gaie)"},{"@language":"nl","@value":"Beren"},{"@language":"sv","@value":"Björnar (bögkultur)"}],"skos:altLabel":[{"@language":"en","@value":"Bear men"},{"@language":"en","@value":"Bears"},{"@language":"de","@value":"Bears"},{"@language":"es","@value":"Hombres osos"},{"@language":"es","@value":"Osos"},{"@language":"es","@value":"Bears"},{"@language":"fr","@value":"Bears"}],"rdfs:comment":[{"@language":"en","@value":"Slang used in the U.S. and other English speaking countries to describe hairy and large or muscular gay men."},{"@language":"de","@value":"Slang, der in den USA und anderen englischsprachigen Ländern verwendet wird, um haarige und große oder muskulöse schwule Männer zu beschreiben. Wird auch im deutschsprachigen Raum verwendet."},{"@language":"es","@value":"Jerga utilizada en Estados Unidos y otros países angloparlantes para describir a hombres gay peludos y grandes o musculosos."},{"@language":"fr","@value":"Hommes gais caractérisés par une forte pilosité et une corpulence forte ou musclée. Terme d'argot utilisé dans la communauté gaie."},{"@language":"nl","@value":"(Amerikaans) jargon dat wordt gebruikt om harige en stevige of gespierde homomannen te beschrijven"},{"@language":"sv","@value":"Slang som används för att beskriva håriga och stora eller muskulösa bögar."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000487"},{"@id":"https://homosaurus.org/v5/homoit0000506"},{"@id":"https://homosaurus.org/v5/homoit0000577"},{"@id":"https://homosaurus.org/v5/homoit0001295"}],"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0000321"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000267"},{"@id":"https://homosaurus.org/v5/homoit0000568"},{"@id":"https://homosaurus.org/v5/homoit0000598"},{"@id":"https://homosaurus.org/v5/homoit0001063"},{"@id":"https://homosaurus.org/v5/homoit0001145"},{"@id":"https://homosaurus.org/v5/homoit0001508"},{"@id":"https://homosaurus.org/v5/homoit0002148"},{"@id":"https://homosaurus.org/v5/homoit0002149"},{"@id":"https://homosaurus.org/v5/homoit0003718"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2004007474"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bears"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000487","dc:identifier":"homoit0000487","skos:prefLabel":[{"@language":"en","@value":"Gay culture"},{"@language":"es","@value":"Cultura gay"},{"@language":"de","@value":"Schwule Kultur"},{"@language":"nl","@value":"Homocultuur"},{"@language":"sv","@value":"Bögkultur"}],"skos:altLabel":[{"@language":"de","@value":"Schwulenkultur"},{"@language":"sv","@value":"Homosexuell manlig kultur"}],"rdfs:comment":[{"@language":"en","@value":"Use to describe cultural experiences shared by members of gay communities or products of gay culture (e.g., art and media created by and for gay men, activism focused on gay issues, slang commonly used in gay communities, etc.)."},{"@language":"es","@value":"Utilícese para describir experiencias culturales compartidas por miembros de comunidades gay o productos de la cultura gay (p. ej., arte y medios creados por y para hombres gay, activismo centrado en cuestiones gay, jerga comúnmente utilizada en comunidades gay, etc.)."},{"@language":"de","@value":"Bezieht sich auf kulturelle Erfahrungen, die Mitglieder der Schwulengemeinschaft teilen, oder auf Produkte der Schwulenkultur (z. B. Kunst und Medien, die von und für schwule Männer geschaffen wurden, Aktivismus mit Schwerpunkt auf schwulen Themen, in Schwulengemeinschaften gebräuchliche Slangausdrücke usw.)."},{"@language":"nl","@value":"Gebruik om culturele ervaringen te beschrijven die worden gedeeld door leden van homogemeenschappen of producten van homocultuur (bijv. kunst en media gemaakt door en voor homomannen, activisme gericht op homokwesties, jargon dat veel wordt gebruikt in homogemeenschappen, enz.)."},{"@language":"sv","@value":"Kulturella erfarenheter som delas av medlemmar i böggemenskaper eller produkter av bögkultur, till exempel konst och media skapade av och för bögar, aktivism fokuserad på bögfrågor, och slang som används i böggemenskaper."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001831"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000105"},{"@id":"https://homosaurus.org/v5/homoit0000267"},{"@id":"https://homosaurus.org/v5/homoit0000321"},{"@id":"https://homosaurus.org/v5/homoit0000535"},{"@id":"https://homosaurus.org/v5/homoit0001063"},{"@id":"https://homosaurus.org/v5/homoit0001145"},{"@id":"https://homosaurus.org/v5/homoit0001148"},{"@id":"https://homosaurus.org/v5/homoit0001479"},{"@id":"https://homosaurus.org/v5/homoit0001508"},{"@id":"https://homosaurus.org/v5/homoit0001788"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000238"},{"@id":"https://homosaurus.org/v5/homoit0001295"},{"@id":"https://homosaurus.org/v5/homoit0001654"},{"@id":"https://homosaurus.org/v5/homoit0001832"},{"@id":"https://homosaurus.org/v5/homoit0001833"},{"@id":"https://homosaurus.org/v5/homoit0002230"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2004003369"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayCulture"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000321","dc:identifier":"homoit0000321","skos:prefLabel":[{"@language":"en","@value":"Cubs (Gay culture)"},{"@language":"es","@value":"Cachorros (Cultura gay)"},{"@language":"de","@value":"Cubs"},{"@language":"fr","@value":"Oursons (culture gaie)"},{"@language":"nl","@value":"Ongelikte beren"},{"@language":"sv","@value":"Cubs (bögkultur)"}],"skos:altLabel":[{"@language":"en","@value":"Cubs"},{"@language":"es","@value":"Cubs (Cultura gay)"},{"@language":"es","@value":"Cubs"},{"@language":"de","@value":"Cubs"},{"@language":"fr","@value":"Cubs"}],"rdfs:comment":[{"@language":"en","@value":"Slang commonly used in gay communities in the United States to describe younger, heavy-set gay men, usually with hairy bodies and facial hair."},{"@language":"es","@value":"Jerga comúnmente utilizada en las comunidades gay de Estados Unidos para describir a hombres gay más jóvenes y corpulentos, generalmente con cuerpos peludos y vello facial."},{"@language":"de","@value":"In der Schwulenszene gebräuchlicher Slangbegriff für jüngere, kräftig gebaute schwule Männer, die in der Regel einen behaarten Körper und Bartwuchs haben."},{"@language":"fr","@value":"Jeunes hommes gais caractérisés par une forte pilosité et une corpulence forte ou musclée. Terme d'argot utilisé dans la communauté gaie."},{"@language":"nl","@value":"Jongere, zwaargebouwde masculiene mannen, meestal met harige lichamen en gezichtshaar; wordt vaak gebruikt in de homocultuur"},{"@language":"sv","@value":"Slang som ofta används i böggemenskaper i USA för att beskriva yngre, kraftiga bögar, vanligtvis med hårig kropp och ansiktsbehåring."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000105"},{"@id":"https://homosaurus.org/v5/homoit0000487"},{"@id":"https://homosaurus.org/v5/homoit0000577"},{"@id":"https://homosaurus.org/v5/homoit0001508"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000568"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/cubs"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000267","dc:identifier":"homoit0000267","skos:prefLabel":[{"@language":"en","@value":"Chubs (Gay culture)"},{"@language":"es","@value":"Chubs (cultura gay)"},{"@language":"de","@value":"Chubs"},{"@language":"nl","@value":"Chubs (homomannen)"},{"@language":"sv","@value":"Chubs (bögkultur)"}],"skos:altLabel":[{"@language":"en","@value":"Chubs (Gay men)"},{"@language":"en","@value":"Chubs"},{"@language":"es","@value":"Chubs (hombres gay)"},{"@language":"es","@value":"Chubs"}],"rdfs:comment":[{"@language":"en","@value":"Slang term used in gay communities (primarily in the United States) to describe larger or heavy-set gay men."},{"@language":"es","@value":"Término de la jerga utilizado en las comunidades gay (principalmente en los Estados Unidos) para describir a hombres gay más grandes o corpulentos."},{"@language":"de","@value":"Umgangssprachlicher Begriff, der in Schwulengemeinschaften (vor allem in den Vereinigten Staaten) verwendet wird, um größere oder kräftig gebaute schwule Männer zu beschreiben."},{"@language":"nl","@value":"Amerikaanse argot-term voor grotere of zwaargebouwde homomannen"},{"@language":"sv","@value":"Slangterm som används i böggemenskaper (främst i USA) för att beskriva större eller kraftigt byggda bögar."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000487"},{"@id":"https://homosaurus.org/v5/homoit0001295"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000105"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/chubsGayMen"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000598","dc:identifier":"homoit0000598","skos:prefLabel":[{"@language":"en","@value":"Goldilocks (Gay culture)"},{"@language":"es","@value":"Ricitos de oro (cultura gay)"},{"@language":"nl","@value":"Goldilocks"},{"@language":"sv","@value":"Goldilocks (bögkultur)"}],"skos:altLabel":[{"@language":"en","@value":"Goldilocks"},{"@language":"es","@value":"Mariliendres"}],"rdfs:comment":[{"@language":"en","@value":"US slang term for heterosexual women who are friends with gay men in the bear community and socialize in bear spaces."},{"@language":"es","@value":"Término de la jerga estadounidense para mujeres heterosexuales que son amigas de hombres gay en la comunidad de osos y socializan en espacios para osos."},{"@language":"sv","@value":"Amerikansk slangterm för heterosexuella kvinnor som är vänner med bögar i björngemenskapen och som umgås i björnmiljöer."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000629"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000105"},{"@id":"https://homosaurus.org/v5/homoit0000381"},{"@id":"https://homosaurus.org/v5/homoit0000416"},{"@id":"https://homosaurus.org/v5/homoit0000455"},{"@id":"https://homosaurus.org/v5/homoit0001133"},{"@id":"https://homosaurus.org/v5/homoit0001788"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000627"},"dc:replaces":{"@id":"http://homosaurus.org/v2/goldilocks"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001063","dc:identifier":"homoit0001063","skos:prefLabel":[{"@language":"en","@value":"Otters (Gay culture)"},{"@language":"es","@value":"Nutrias (cultura gay)"},{"@language":"nl","@value":"Otters"},{"@language":"sv","@value":"Uttrar (bögkultur)"}],"skos:altLabel":[{"@language":"en","@value":"Otter men"},{"@language":"en","@value":"Otters"},{"@language":"es","@value":"Chicos nutrias"},{"@language":"es","@value":"Otters"},{"@language":"es","@value":"Nutrias"},{"@language":"sv","@value":"Otters (bögkultur)"}],"rdfs:comment":[{"@language":"en","@value":"U.S. slang term term for gay men who blend the physical and social traits of bears and twinks."},{"@language":"es","@value":"Término de la jerga estadounidense para referirse a hombres gay que combinan los rasgos físicos y sociales de los osos y los twinks."},{"@language":"nl","@value":"Argot-term voor homoseksuele mannen die de fysieke en sociale eigenschappen van beren en twinks mengen."},{"@language":"sv","@value":"Slangterm i USA för bögar som kombinerar egenskaper som förknippas med både ”björnar” och ”twinks”, alltså smala och håriga bögar."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000487"},{"@id":"https://homosaurus.org/v5/homoit0000506"},{"@id":"https://homosaurus.org/v5/homoit0000577"},{"@id":"https://homosaurus.org/v5/homoit0001295"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000105"},{"@id":"https://homosaurus.org/v5/homoit0000568"},{"@id":"https://homosaurus.org/v5/homoit0001145"},{"@id":"https://homosaurus.org/v5/homoit0001508"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/otters"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001145","dc:identifier":"homoit0001145","skos:prefLabel":[{"@language":"en","@value":"Pups (Roleplay)"},{"@language":"es","@value":"Cachorros (juego de roles)"},{"@language":"nl","@value":"Pups"},{"@language":"sv","@value":"Pups (rollspel)"}],"skos:altLabel":[{"@language":"en","@value":"Puppers"},{"@language":"en","@value":"Puppies"},{"@language":"es","@value":"Pups (Roleplay)"},{"@language":"es","@value":"Cachorros"},{"@language":"es","@value":"Perritos"},{"@language":"es","@value":"Perrito faldero"},{"@language":"nl","@value":"Puppies"}],"rdfs:comment":[{"@language":"en","@value":"Individuals who take on the pup or puppy role in puppy play, a form of animal roleplay that is often but not always associated with BDSM and kink communities."},{"@language":"es","@value":"Personas que asumen el rol de cachorro o perrito en el juego de cachorros, una forma de juego de roles de animales que a menudo, aunque no siempre, se asocia con el BDSM y las comunidades kink."},{"@language":"nl","@value":"Personen die de rol van pup of puppy op zich nemen bij puppy play, een vorm van rollenspel met dieren die vaak, maar niet altijd, wordt geassocieerd met BDSM en kinkgemeenschappen."},{"@language":"sv","@value":"Personer som tar på sig rollen som valp i så kallad puppy play, en form av djurrollspel som ofta men inte alltid är kopplat till BDSM- och kinkvärlden."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000487"},{"@id":"https://homosaurus.org/v5/homoit0000506"},{"@id":"https://homosaurus.org/v5/homoit0000705"},{"@id":"https://homosaurus.org/v5/homoit0001242"},{"@id":"https://homosaurus.org/v5/homoit0001295"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000105"},{"@id":"https://homosaurus.org/v5/homoit0000568"},{"@id":"https://homosaurus.org/v5/homoit0001063"},{"@id":"https://homosaurus.org/v5/homoit0003083"},{"@id":"https://homosaurus.org/v5/homoit0003086"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/pups"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001508","dc:identifier":"homoit0001508","skos:prefLabel":[{"@language":"en","@value":"Wolves (Gay culture)"},{"@language":"es","@value":"Wolves (Cultura gay)"},{"@language":"nl","@value":"Wolven"},{"@language":"sv","@value":"Vargar (bögkultur)"}],"skos:altLabel":[{"@language":"en","@value":"Wolves"},{"@language":"es","@value":"Lobos"},{"@language":"es","@value":"Lobos (Cultura gay)"},{"@language":"sv","@value":"Wolves (bögkultur)"}],"rdfs:comment":[{"@language":"en","@value":"U.S. slang term for heavy-set, masculine gay men who are often characterized as having hairy bodies and facial hair; typically used for individuals who are more aggressive and overtly masculine than bears."},{"@language":"es","@value":"Término de la jerga estadounidense para hombres gay masculinos y corpulentos que a menudo se caracterizan por tener cuerpos peludos y vello facial; normalmente se utiliza para personas que son más agresivas y abiertamente masculinas que los osos."},{"@language":"nl","@value":"Zware, masculiene mannen, vaak gekenmerkt door harige lichamen en gezichtshaar, doorgaans agressiever en openlijk mannelijker dan hun tegenhanger, Beren"},{"@language":"sv","@value":"Amerikansk slangterm för kraftiga, maskulina bögar som ofta kännetecknas av kroppsbehåring och skäggväxt. Används vanligtvis för personer som är mer aggressiva och uttalat maskulina än så kallade björnar."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000487"},{"@id":"https://homosaurus.org/v5/homoit0000506"},{"@id":"https://homosaurus.org/v5/homoit0000577"},{"@id":"https://homosaurus.org/v5/homoit0001295"}],"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0000321"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000105"},{"@id":"https://homosaurus.org/v5/homoit0000568"},{"@id":"https://homosaurus.org/v5/homoit0000995"},{"@id":"https://homosaurus.org/v5/homoit0001063"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/wolves"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002148","dc:identifier":"homoit0002148","skos:prefLabel":[{"@language":"ja","@value":"Bara"},{"@language":"es","@value":"Bara"},{"@language":"de","@value":"Bara"},{"@language":"nl","@value":"Bara"},{"@language":"sv","@value":"Bara (genre)"}],"rdfs:comment":[{"@language":"en","@value":"A genre of Japanese art created primarily by gay men for other gay men that emphasizes masculinity, muscles, body fat, and hair (similar to Bears and Gym subculture in the United States)."},{"@language":"es","@value":"Género de arte japonés creado principalmente por hombres gay para otros hombres gay que enfatiza la masculinidad, los músculos, la grasa corporal y el vello (similar a la subcultura de los osos y los gimnasios en los Estados Unidos)."},{"@language":"de","@value":"Ein Genre der japanischen Kunst, das hauptsächlich von schwulen Männern für andere schwule Männer produziert wird und Männlichkeit, Muskeln, Körperfett und Behaarung in den Mittelpunkt stellt (ähnlich wie die Bären- und Gym-Subkultur in Europa)."},{"@language":"nl","@value":"Een genre in Japanse kunst dat voornamelijk door homomannen wordt gemaakt voor andere homomannen en dat de nadruk legt op mannelijkheid, spieren, lichaamsvet en haar (vergelijkbaar met de subcultuur Bears en Gym in de Verenigde Staten)"},{"@language":"sv","@value":"En japansk konstgenre skapad främst av bögar för andra bögar, där maskulinitet, muskler, kroppsfett och kroppsbehåring betonas (liknande björn- och gym-subkulturen i USA)."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002149"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000105"},{"@id":"https://homosaurus.org/v5/homoit0000978"},{"@id":"https://homosaurus.org/v5/homoit0001654"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002149","dc:identifier":"homoit0002149","skos:prefLabel":[{"@language":"en","@value":"Bara fandom"},{"@language":"es","@value":"Fandom bara"},{"@language":"de","@value":"Bara-Fangemeinde"},{"@language":"nl","@value":"Bara fandom"},{"@language":"sv","@value":"Bara-fandom"},{"@language":"ja","@value":"Bara fandom"}],"rdfs:comment":[{"@language":"en","@value":"The fan community that focuses on, incorporates, or details the relationships of characters from bara manga and anime."},{"@language":"es","@value":"La comunidad de fans que se centra sobre, incorpora o detalla las relaciones de personajes del manga y del anime bara."},{"@language":"de","@value":"Die Fangemeinde, die sich auf die Beziehungen von Figuren aus Bara-Manga und Anime fokussiert oder detailliert behandelt."},{"@language":"nl","@value":"De fangemeenschap die zich richt op, of details geeft over de relaties van personages uit bara manga en anime"},{"@language":"sv","@value":"Fankulturen som fokuserar på, inkluderar eller beskriver relationerna mellan karaktärer från bara-manga och anime."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002144"},"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0002148"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000105"},{"@id":"https://homosaurus.org/v5/homoit0000978"},{"@id":"https://homosaurus.org/v5/homoit0001654"},{"@id":"https://homosaurus.org/v5/homoit0002170"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003718","dc:identifier":"homoit0003718","skos:prefLabel":[{"@language":"en","@value":"Bear bars"},{"@language":"nl","@value":"Berenbars"},{"@language":"sv","@value":"Björnbarer"}],"rdfs:comment":[{"@language":"en","@value":"Drinking establishments that primarily cater to gay men who identify as bears, or hairy and large or muscular."},{"@language":"nl","@value":"Bars die zich voornamelijk richten op homomannen die zich identificeren als beren, of harig en groot of gespierd."},{"@language":"sv","@value":"Barer eller uteställen som främst vänder sig till bögar som identifierar sig som björnar, det vill säga håriga och stora eller muskulösa."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000474"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000105"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000900"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001366","dc:identifier":"homoit0001366","skos:prefLabel":[{"@language":"en","@value":"Therapies"},{"@language":"es","@value":"Terapias"},{"@language":"nl","@value":"Therapieën"},{"@language":"sv","@value":"Terapier och behandlingar"}],"skos:altLabel":{"@language":"es","@value":"Tipos de terapia"},"rdfs:comment":[{"@language":"en","@value":"Treatments addressing impairments, illnesses, diseases, or disorders through counseling and rehabilitation."},{"@language":"es","@value":"Tratamientos que abordan discapacidades, enfermedades, dolencias o trastornos a través del asesoramiento y la rehabilitación."},{"@language":"nl","@value":"Behandelingen gericht op stoornissen, ziekten of aandoeningen door middel van counseling en revalidatie."},{"@language":"sv","@value":"Terapier och behandlingar som ges genom rådgivning och rehabilitering."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001004"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000106"},{"@id":"https://homosaurus.org/v5/homoit0000303"},{"@id":"https://homosaurus.org/v5/homoit0000317"},{"@id":"https://homosaurus.org/v5/homoit0000394"},{"@id":"https://homosaurus.org/v5/homoit0000617"},{"@id":"https://homosaurus.org/v5/homoit0001007"},{"@id":"https://homosaurus.org/v5/homoit0001274"},{"@id":"https://homosaurus.org/v5/homoit0001496"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001012"},{"@id":"https://homosaurus.org/v5/homoit0003990"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85085490"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001004"},"dc:replaces":{"@id":"http://homosaurus.org/v2/therapies"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000108","dc:identifier":"homoit0000108","skos:prefLabel":[{"@language":"en","@value":"Bi+ people"},{"@language":"de","@value":"Bi+-Personen"},{"@language":"es","@value":"Personas bi+"},{"@language":"fr","@value":"Personnes Bi+"},{"@language":"nl","@value":"Bi+ personen"},{"@language":"sv","@value":"Bi+-personer"}],"skos:altLabel":{"@language":"es","@value":"Bi+"},"rdfs:comment":[{"@language":"en","@value":"Individuals who are not exclusively sexually and/or romantically attracted to individuals of a single biological sex (includes bisexual, queer, pansexual, and fluid identities)."},{"@language":"de","@value":"Personen, die sich sexuell und/oder romantisch nicht ausschließlich zu Personen eines einzigen biologischen Geschlechts hingezogen fühlen (einschließlich bisexueller, queerer, pansexueller und fluider Identitäten)."},{"@language":"es","@value":"Personas que no sienten una atracción sexual y/o romántica exclusiva por personas de un único sexo biológico (incluye las identidades bisexuales, queer, pansexuales y fluidas)."},{"@language":"fr","@value":"Personnes qui ne sont pas exclusivement attirées sexuellement et romantiquement par des personnes d'un seul sexe biologique (y compris les bisexuels, les queers, les pansexuels et les identités fluides)."},{"@language":"nl","@value":"Personen die zich niet uitsluitend seksueel en/of romantisch aangetrokken voelen tot personen van een enkel biologische geslacht (inclusief biseksuele, queer, panseksuele en vloeibare identiteiten)"},{"@language":"sv","@value":"Personer som inte enbart är sexuellt och/eller romantiskt attraherade av personer av ett enda biologiskt kön (inkluderar bisexuella, queera, pansexuella och flytande identiteter)."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000915"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000170"},{"@id":"https://homosaurus.org/v5/homoit0001073"},{"@id":"https://homosaurus.org/v5/homoit0001195"},{"@id":"https://homosaurus.org/v5/homoit0001919"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001297"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bi+People"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000170","dc:identifier":"homoit0000170","skos:prefLabel":[{"@language":"en","@value":"Bisexual people"},{"@language":"de","@value":"Bisexuelle Personen"},{"@language":"es","@value":"Personas bisexuales"},{"@language":"fr","@value":"Personnes bisexuelles"},{"@language":"nl","@value":"Biseksuele personen"},{"@language":"sv","@value":"Bisexuella"}],"skos:altLabel":[{"@language":"en","@value":"Bisexuals"},{"@language":"de","@value":"Bisexuelle"},{"@language":"de","@value":"Bi-Personen"},{"@language":"es","@value":"Bisexuales"}],"rdfs:comment":[{"@language":"en","@value":"Individuals who are romantically and/or sexually attracted to more than one gender and who identify as bisexual; do not use to describe pansexual or polysexual people unless they also use the term bisexual."},{"@language":"de","@value":"Personen, die sich romantisch und/oder sexuell zu mehr als einem Geschlecht hingezogen fühlen und sich als bisexuell identifizieren; nicht zur Beschreibung von pansexuellen oder polysexuellen Personen verwenden, es sei denn, diese verwenden auch den Begriff bisexuell."},{"@language":"es","@value":"Personas que se sienten atraídas romántica y/o sexualmente por más de un género y que se autoidentifican como bisexuales; no se debe utilizar para describir a personas pansexuales o polisexuales a menos que también utilicen el término bisexual."},{"@language":"fr","@value":"Personnes qui sont attirées romantiquement et sexuellement envers plus d'un genre et qui s'identifient comme bisexuelles."},{"@language":"nl","@value":"Personen die zich romantisch en/of seksueel aangetrokken voelen tot meer dan één gender en die zich identificeren als biseksueel; niet gebruiken om panseksuele of polyseksuele personen te beschrijven, tenzij ze ook de term biseksueel gebruiken"},{"@language":"sv","@value":"Personer som är romantiskt och/eller sexuellt attraherade av mer än ett kön och som identifierar sig som bisexuella. Används inte för att beskriva pansexuella eller polysexuella personer om de inte också använder termen bisexuell."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000108"},{"@id":"https://homosaurus.org/v5/homoit0000915"},{"@id":"https://homosaurus.org/v5/homoit0001297"}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000140"},{"@id":"https://homosaurus.org/v5/homoit0000160"},{"@id":"https://homosaurus.org/v5/homoit0000169"},{"@id":"https://homosaurus.org/v5/homoit0000192"},{"@id":"https://homosaurus.org/v5/homoit0000202"},{"@id":"https://homosaurus.org/v5/homoit0000285"},{"@id":"https://homosaurus.org/v5/homoit0001054"},{"@id":"https://homosaurus.org/v5/homoit0003035"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000117"},{"@id":"https://homosaurus.org/v5/homoit0000133"},{"@id":"https://homosaurus.org/v5/homoit0000134"},{"@id":"https://homosaurus.org/v5/homoit0000136"},{"@id":"https://homosaurus.org/v5/homoit0000139"},{"@id":"https://homosaurus.org/v5/homoit0000143"},{"@id":"https://homosaurus.org/v5/homoit0000144"},{"@id":"https://homosaurus.org/v5/homoit0000150"},{"@id":"https://homosaurus.org/v5/homoit0000153"},{"@id":"https://homosaurus.org/v5/homoit0000173"},{"@id":"https://homosaurus.org/v5/homoit0000204"},{"@id":"https://homosaurus.org/v5/homoit0001073"},{"@id":"https://homosaurus.org/v5/homoit0001103"},{"@id":"https://homosaurus.org/v5/homoit0001531"},{"@id":"https://homosaurus.org/v5/homoit0002150"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh93003390"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001073","dc:identifier":"homoit0001073","skos:prefLabel":[{"@language":"en","@value":"Pansexual people"},{"@language":"es","@value":"Personas pansexuales"},{"@language":"nl","@value":"Panseksuele personen"},{"@language":"sv","@value":"Pansexuella"}],"skos:altLabel":[{"@language":"en","@value":"Omnisexual"},{"@language":"es","@value":"Omnisexual"}],"rdfs:comment":[{"@language":"en","@value":"Individuals who self-identify as pansexual, meaning that they are sexually attracted to people of all genders. Some but not all pansexual people also identify as \"gender-blind\" because gender is insignificant or irrelevant in determining their attraction."},{"@language":"es","@value":"Personas que se identifican como pansexuales, lo que significa que se sienten atraídas sexualmente por personas de todos los géneros. Algunas personas pansexuales, pero no todas, también se identifican como \"ciegas al género\", porque el género les es insignificante o irrelevante para determinar su atracción."},{"@language":"nl","@value":"Individuen die zichzelf identificeren als panseksueel, wat betekent dat ze zich seksueel aangetrokken voelen tot mensen van alle genders. Sommige, maar niet alle, panseksuele mensen identificeren zich ook als \"genderblind\" omdat gender onbelangrijk of niet relevant is bij het bepalen van hun aantrekkingskracht."},{"@language":"sv","@value":"Personer som identifierar sig som pansexuella, det vill säga att de är sexuellt attraherade av personer oavsett kön. Vissa, men inte alla, pansexuella beskriver sig även som ”könsblinda”, eftersom kön är irrelevant i deras attraktion."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000108"},{"@id":"https://homosaurus.org/v5/homoit0000915"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000170"},{"@id":"https://homosaurus.org/v5/homoit0001381"},{"@id":"https://homosaurus.org/v5/homoit0001531"},{"@id":"https://homosaurus.org/v5/homoit0001926"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/pansexualPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001195","dc:identifier":"homoit0001195","skos:prefLabel":[{"@language":"en","@value":"Queer people"},{"@language":"es","@value":"Personas queer"},{"@language":"nl","@value":"Queer personen"},{"@language":"sv","@value":"Queera personer"}],"rdfs:comment":[{"@language":"en","@value":"Individuals who identify with non-normative gender and/or sexual identities, typically people who are not heterosexual and/or are not cisgender. Only use for people who identify as queer."},{"@language":"es","@value":"Personas que se identifican con identidades sexuales y/o de género no normativas, generalmente personas que no son heterosexuales y/o cisgénero. Utilícese únicamente para personas que se autoidentifiquen como queer."},{"@language":"nl","@value":"Personen die zich identificeren met niet-normatieve gender- en/of seksuele identiteiten, meestal personen die niet heteroseksueel en/of niet cisgender zijn. Alleen gebruiken voor personen die zich als queer identificeren."},{"@language":"sv","@value":"Personer som identifierar sig med icke-normativa köns- och/eller sexualitetsidentiteter, vanligtvis personer som inte är heterosexuella och/eller inte cispersoner. Används endast för personer som själva identifierar sig som queera."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000108"},{"@id":"https://homosaurus.org/v5/homoit0000915"},{"@id":"https://homosaurus.org/v5/homoit0001559"}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000582"},{"@id":"https://homosaurus.org/v5/homoit0001185"},{"@id":"https://homosaurus.org/v5/homoit0001215"},{"@id":"https://homosaurus.org/v5/homoit0001220"},{"@id":"https://homosaurus.org/v5/homoit0001227"},{"@id":"https://homosaurus.org/v5/homoit0001785"},{"@id":"https://homosaurus.org/v5/homoit0001809"},{"@id":"https://homosaurus.org/v5/homoit0003044"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001077"},{"@id":"https://homosaurus.org/v5/homoit0001106"},{"@id":"https://homosaurus.org/v5/homoit0001166"},{"@id":"https://homosaurus.org/v5/homoit0001176"},{"@id":"https://homosaurus.org/v5/homoit0001178"},{"@id":"https://homosaurus.org/v5/homoit0001194"},{"@id":"https://homosaurus.org/v5/homoit0001229"},{"@id":"https://homosaurus.org/v5/homoit0001921"},{"@id":"https://homosaurus.org/v5/homoit0002193"},{"@id":"https://homosaurus.org/v5/homoit0002577"},{"@id":"https://homosaurus.org/v5/homoit0002588"},{"@id":"https://homosaurus.org/v5/homoit0003823"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001919","dc:identifier":"homoit0001919","skos:prefLabel":[{"@language":"en","@value":"Polysexual people"},{"@language":"es","@value":"Personas polisexuales"},{"@language":"fr","@value":"Personnes polysexuelles"},{"@language":"nl","@value":"Polyseksuele personen"},{"@language":"sv","@value":"Polysexuella personer"}],"skos:altLabel":[{"@language":"en","@value":"Polysexuals"},{"@language":"es","@value":"Polisexuales"}],"rdfs:comment":[{"@language":"en","@value":"Individuals who experience sexual attraction to more than one gender; includes bisexual and pansexual people."},{"@language":"es","@value":"Personas que sienten atracción sexual por más de un género; incluye personas bisexuales y pansexuales."},{"@language":"fr","@value":"Personnes attirées sexuellement par des personnes de plusieurs genres, incluant des personnes bisexuelles et pansexuelles."},{"@language":"nl","@value":"Personen die seksuele aantrekking tot meer dan één gender ervaren; omvat biseksuele en panseksuele mensen"},{"@language":"sv","@value":"Personer som upplever sexuell attraktion till mer än ett kön. Inkluderar bisexuella och pansexuella personer."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000108"},{"@id":"https://homosaurus.org/v5/homoit0000915"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000204"},{"@id":"https://homosaurus.org/v5/homoit0001558"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-03-31"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000112","dc:identifier":"homoit0000112","skos:prefLabel":[{"@language":"en","@value":"Intolerance towards LGBTQ+ people"},{"@language":"es","@value":"Intolerancia hacia personas LGBTQ+"},{"@language":"nl","@value":"Intolerantie tegenover LHBTQ+-personen"},{"@language":"sv","@value":"Intolerans mo hbtq+-personer"}],"skos:altLabel":[{"@language":"en","@value":"Bigotry towards LGBTQ people"},{"@language":"en","@value":"Prejudice towards LGBTQ people"},{"@language":"en","@value":"Intolerance towards LGBTQ people"}],"rdfs:comment":[{"@language":"en","@value":"Unwillingness to accept or affirm LGBTQ+ people or their identities in attitude or practice."},{"@language":"es","@value":"Renuencia a aceptar o afirmar a las personas LGBTQ+ o sus identidades en actitud o en práctica."},{"@language":"nl","@value":"Onwil om LHBTQ+-personen of hun identiteit in houding of praktijk te accepteren of te bevestigen."},{"@language":"sv","@value":"Ovillighet att acceptera eller bekräfta hbtq+-personer eller deras identiteter i attityd eller handling."}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000109"},{"@id":"https://homosaurus.org/v5/homoit0000341"},{"@id":"https://homosaurus.org/v5/homoit0000356"},{"@id":"https://homosaurus.org/v5/homoit0000643"},{"@id":"https://homosaurus.org/v5/homoit0001015"},{"@id":"https://homosaurus.org/v5/homoit0001017"},{"@id":"https://homosaurus.org/v5/homoit0001561"},{"@id":"https://homosaurus.org/v5/homoit0001885"},{"@id":"https://homosaurus.org/v5/homoit0001892"},{"@id":"https://homosaurus.org/v5/homoit0001893"},{"@id":"https://homosaurus.org/v5/homoit0001903"},{"@id":"https://homosaurus.org/v5/homoit0002899"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000112"},"dc:replaces":{"@id":"http://homosaurus.org/v2/intoleranceTowardsLGBTQPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000341","dc:identifier":"homoit0000341","skos:prefLabel":[{"@language":"en","@value":"Hate speech"},{"@language":"es","@value":"Discurso de odio"},{"@language":"de","@value":"Hassrede"},{"@language":"nl","@value":"Haat zaaien"},{"@language":"sv","@value":"Hatpropaganda"}],"skos:altLabel":[{"@language":"en","@value":"Defamation against groups"},{"@language":"en","@value":"Group defamation"},{"@language":"en","@value":"Group libel"},{"@language":"de","@value":"Diffamierung von Gruppen"},{"@language":"de","@value":"Verleumdung von Gruppen"},{"@language":"de","@value":"Gruppenbeleidigung"},{"@language":"nl","@value":"Laster tegen groepen"},{"@language":"nl","@value":"Smaad tegen groepen"}],"rdfs:comment":[{"@language":"en","@value":"Any form of expression (written or verbal) with the intention to vilify, humiliate, or incite hatred against a individual or group of people on the basis of their actual or perceived race, religion, nationality, sexual identity, gender identity, or ability status."},{"@language":"es","@value":"Cualquier forma de expresión (escrita o verbal) con la intención de vilipendiar, humillar o incitar al odio contra una persona o grupo de personas por su raza, religión, nacionalidad, identidad sexual, identidad de género o estado de capacidad real o percibido. "},{"@language":"de","@value":"Jede Form des Ausdrucks (schriftlich oder mündlich), die darauf abzielt, eine Person oder eine Gruppe von Menschen aufgrund ihrer (vermeintlichen) ethnischen Zugehörigkeit, Religion, Nationalität, sexuellen Identität, Geschlechtsidentität oder Behinderung zu diffamieren, zu demütigen oder Hass gegen sie zu schüren."},{"@language":"nl","@value":"Elke vorm van expressie (schriftelijk of mondeling) met de bedoeling om een groep personen of een individu te belasteren, te vernederen of aan te zetten tot haat op basis van hun werkelijke of vermeende ras, religie, nationaliteit, seksuele identiteit, genderidentiteit of handicap"},{"@language":"sv","@value":"Alla former av uttryck (skriftliga eller muntliga) som syftar till att förnedra, hetsa mot eller skapa hat mot en individ eller grupp baserat på faktisk eller uppfattad ras, religion, nationalitet, sexuell identitet, könsidentitet eller funktionsnivå."}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000109"},{"@id":"https://homosaurus.org/v5/homoit0000112"},{"@id":"https://homosaurus.org/v5/homoit0000850"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh93004962"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000341"},"dc:replaces":{"@id":"http://homosaurus.org/v2/hateSpeech"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003787","dc:identifier":"homoit0003787","skos:prefLabel":[{"@language":"en","@value":"Anti-sex worker violence"},{"@language":"nl","@value":"Anti-sekswerker geweld"},{"@language":"sv","@value":"Våld mot sexarbetare"}],"skos:altLabel":[{"@language":"en","@value":"Violence against sex workers"},{"@language":"en","@value":"Anti sex worker violence"},{"@language":"en","@value":"Anti-prostitute violence"},{"@language":"en","@value":"Anti prostitute violence"},{"@language":"en","@value":"Violence against prostitutes"},{"@language":"nl","@value":"Geweld tegen sekswerkers"},{"@language":"sv","@value":"Våld mot prostituerade"}],"rdfs:comment":[{"@language":"en","@value":"Behavior involving physical force intended to harm or kill sex workers on the basis of their work or identity as a sex worker."},{"@language":"nl","@value":"Gedrag waarbij fysiek geweld wordt gebruikt met als doel sekswerkers te verwonden of te doden op basis van hun werk of identiteit als sekswerker."},{"@language":"sv","@value":"Beteende som involverar fysiskt våld med avsikt att skada eller döda sexarbetare/personer i prostitution på grund av deras arbete eller identitet som sexarbetare/personer i prostitution."}],"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0003788"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000109"},{"@id":"https://homosaurus.org/v5/homoit0003786"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0003787"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-30"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003788","dc:identifier":"homoit0003788","skos:prefLabel":[{"@language":"en","@value":"Murder of sex workers"},{"@language":"nl","@value":"Moorden op sekswerkers"},{"@language":"sv","@value":"Mord på sexarbetare och personer i prostitution"}],"skos:altLabel":[{"@language":"en","@value":"Murder of prostitutes"},{"@language":"sv","@value":"Mord på sexarbetare"},{"@language":"sv","@value":"Mord på personer i prostitution"}],"rdfs:comment":[{"@language":"en","@value":"Intentional killing of sex workers on the basis of their work or identity as a sex worker."},{"@language":"nl","@value":"Het opzettelijk doden van sekswerkers op basis van hun werk of identiteit als sekswerker."},{"@language":"sv","@value":"Avsiktligt dödande av sexarbetare och/eller personer i prostitution på grund av deras yrke eller identitet som sexarbetare och/eller personer i prostitution."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0003787"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000109"},{"@id":"https://homosaurus.org/v5/homoit0003786"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0003787"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-30"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000110","dc:identifier":"homoit0000110","skos:prefLabel":[{"@language":"en","@value":"Bigender identity"},{"@language":"es","@value":"Identidad bigénero"},{"@language":"de","@value":"Bigender-Identität"},{"@language":"fr","@value":"Identité bigenre"},{"@language":"nl","@value":"Bigender identiteit"},{"@language":"sv","@value":"Bigender-identitet"}],"rdfs:comment":[{"@language":"en","@value":"Term used to describe the identities of people who have two genders."},{"@language":"es","@value":"Término utilizado para describir la identidad de personas que tienen dos géneros."},{"@language":"de","@value":"Bezeichnung für die Identität von Menschen, die zwei Geschlechter haben."},{"@language":"fr","@value":"Terme utilisé pour décrire l'identité des personnes qui ont deux genres."},{"@language":"sv","@value":"Term som används för att beskriva identiteter hos personer som har två kön."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000571"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000111"},{"@id":"https://homosaurus.org/v5/homoit0000569"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bigenderIdentity"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000111","dc:identifier":"homoit0000111","skos:prefLabel":[{"@language":"en","@value":"Bigender people"},{"@language":"es","@value":"Personas bigénero"},{"@language":"de","@value":"Bigender-Personen"},{"@language":"fr","@value":"Personnes bigenres"},{"@language":"nl","@value":"Bigender personen"},{"@language":"sv","@value":"Bigender-personer"}],"rdfs:comment":[{"@language":"en","@value":"People who identify as any two genders, either simultaneously or more fluidly."},{"@language":"es","@value":"Personas que seautoidentificancon dos géneros, ya sea simultáneamente o de forma más fluida."},{"@language":"de","@value":"Personen, die sich gleichzeitig oder eher fließend mit zwei Geschlechtern identifizieren."},{"@language":"fr","@value":"Personnes qui s'identifient à deux genres, soit simultanément, soit de manière plus fluide."},{"@language":"nl","@value":"Mensen die zich identificeren met twee geslachten/genders, gelijktijdig of als twee afzonderlijke persona's"},{"@language":"sv","@value":"Personer som identifierar sig med två kön, antingen samtidigt eller mer flytande."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001378"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000110"},{"@id":"https://homosaurus.org/v5/homoit0000570"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bigenderPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000569","dc:identifier":"homoit0000569","skos:prefLabel":[{"@language":"en","@value":"Genderfluid identity"},{"@language":"de","@value":"Genderfluide Identität"},{"@language":"es","@value":"Identidad de género fluido"},{"@language":"fr","@value":"Identité de genre fluide"},{"@language":"nl","@value":"Genderfluïde identiteit"},{"@language":"sv","@value":"Genderfluid-identitet"}],"skos:altLabel":[{"@language":"en","@value":"Genderfluidity"},{"@language":"de","@value":"Genderfluid-Identität"},{"@language":"de","@value":"Genderfluidität"},{"@language":"es","@value":"Identidad genderfluid"},{"@language":"es","@value":"Identidad de género variable"}],"rdfs:comment":[{"@language":"en","@value":"A gender identity in which an individual's gender varies over time and across circumstances; some genderfluid people may identify as a mixture of more than one gender simultaneously."},{"@language":"de","@value":"Eine Geschlechtsidentität, bei der das Geschlecht einer Person im Laufe der Zeit und je nach Umständen variiert; einige genderfluide Personen können sich gleichzeitig als eine Mischung aus mehr als einem Geschlecht identifizieren."},{"@language":"es","@value":"Una identidad de género en la que el género de una persona varía con el tiempo y según las circunstancias; algunas personas de género fluido pueden identificarse como una mezcla de más de un género simultáneamente."},{"@language":"fr","@value":"Identité de genre selon laquelle le genre d'une personne change dans le temps et selon les circonstances; certaines personnes fluides dans le genre peuvent s'identifier comme un mélange de plus d'un genre simultanément."},{"@language":"nl","@value":"Een genderidentiteit waarin het geslacht van een persoon in de loop van de tijd en tussen omstandigheden varieert; sommige genderfluïde mensen kunnen zich identificeren als een mengsel van meer dan één geslacht tegelijk"},{"@language":"sv","@value":"En könsidentitet där en individs kön varierar över tid och i olika sammanhang. Vissa genderfluid-personer kan identifiera sig med flera kön samtidigt."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000571"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000110"},{"@id":"https://homosaurus.org/v5/homoit0000570"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/genderfluid"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000570","dc:identifier":"homoit0000570","skos:prefLabel":[{"@language":"en","@value":"Genderfluid people"},{"@language":"es","@value":"Personas de género fluido"},{"@language":"de","@value":"Genderfluide Personen"},{"@language":"fr","@value":"Personnes fluides dans le genre"},{"@language":"nl","@value":"Genderfluïde personen"},{"@language":"sv","@value":"Genderfluid-personer"}],"skos:altLabel":{"@language":"de","@value":"Genderfluid-Personen"},"rdfs:comment":[{"@language":"en","@value":"People who identify as different genders at different times, including multiple genders at once or none at all. Only use to describe people who self-identify as genderfluid."},{"@language":"es","@value":"Personas que se identifican con diferentes géneros en diferentes momentos, incluidos varios géneros a la vez o ninguno en absoluto. Utilícese únicamente para describir a personas que se autoidentifiquen como de género fluido."},{"@language":"de","@value":"Personen, die sich zu unterschiedlichen Zeiten als verschiedene Geschlechter identifizieren, einschliesslich mehrerer Geschlechter gleichzeitig oder keines Geschlechts. Nur verwenden, um Personen zu beschreiben, die sich selbst als genderfluid identifizieren."},{"@language":"fr","@value":"Personnes dont le genre change dans le temps et selon les circonstances. Leur genre peut varier dans le temps, correspondre à plusieurs genres à la fois, ou à aucun. Utilisé uniquement pour décrire les personnes qui s'identifient comme fluides dans le genre."},{"@language":"nl","@value":"Personen die zich op verschillende momenten als verschillende genders identificeren, inclusief meerdere genders tegelijk of helemaal geen. Alleen gebruiken om personen te beschrijven die zichzelf identificeren als genderfluïde."},{"@language":"sv","@value":"Personer som identifierar sig med olika kön vid olika tidpunkter, inklusive flera kön samtidigt eller inget kön alls. Används endast för att beskriva personer som själva identifierar sig som genderfluid."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001378"},{"@id":"https://homosaurus.org/v5/homoit0001817"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000111"},{"@id":"https://homosaurus.org/v5/homoit0000569"},{"@id":"https://homosaurus.org/v5/homoit0000571"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/genderfluidPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000643","dc:identifier":"homoit0000643","skos:prefLabel":[{"@language":"en","@value":"Homonationalism"},{"@language":"es","@value":"Homonacionalismo"},{"@language":"de","@value":"Homonationalismus"},{"@language":"nl","@value":"Homonationalisme"},{"@language":"sv","@value":"Homonationalism"}],"rdfs:comment":[{"@language":"en","@value":"Favorable association between a nationalist ideology and LGBTQ+ people or their rights."},{"@language":"es","@value":"Asociación favorable entre una ideología nacionalista y las personas LGBTQ+ o sus derechos."},{"@language":"de","@value":"Eine positive Assoziation zwischen einer nationalistischen Ideologie und LGBTQ+-Personen oder deren Rechten."},{"@language":"sv","@value":"Positiv koppling mellan nationalistisk ideologi och hbtq+-personer eller deras rättigheter."}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000112"},{"@id":"https://homosaurus.org/v5/homoit0001117"},{"@id":"https://homosaurus.org/v5/homoit0001323"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000643"},"dc:replaces":{"@id":"http://homosaurus.org/v2/homonationalism"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001015","dc:identifier":"homoit0001015","skos:prefLabel":[{"@language":"en","@value":"Misandry"},{"@language":"es","@value":"Misandria"},{"@language":"nl","@value":"Misandrie"},{"@language":"sv","@value":"Misandri"}],"rdfs:comment":[{"@language":"en","@value":"Hate or dislike of men or boys."},{"@language":"es","@value":"Odio o desagrado hacia los hombres o los niños."},{"@language":"nl","@value":"haat of afkeer van mannen of jongens"},{"@language":"sv","@value":"Hat eller ogillande riktat mot män eller pojkar."}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000112"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh89000857"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001015"},"dc:replaces":{"@id":"http://homosaurus.org/v2/misandry"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001017","dc:identifier":"homoit0001017","skos:prefLabel":[{"@language":"en","@value":"Misogyny"},{"@language":"es","@value":"Misoginia"},{"@language":"fr","@value":"Misogynie"},{"@language":"nl","@value":"Misogynie"},{"@language":"sv","@value":"Misogyni"}],"rdfs:comment":[{"@language":"en","@value":"Hate or dislike of women or girls."},{"@language":"es","@value":"Odio o desagrado hacia las mujeres o las niñas."},{"@language":"fr","@value":"La haine ou l'aversion pour les femmes ou les filles."},{"@language":"nl","@value":"haat of afkeer van vrouwen of meisjes"},{"@language":"sv","@value":"Hat eller ogillande riktat mot kvinnor eller flickor."}],"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0002183"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000112"},{"@id":"https://homosaurus.org/v5/homoit0001133"},{"@id":"https://homosaurus.org/v5/homoit0001892"},{"@id":"https://homosaurus.org/v5/homoit0001903"},{"@id":"https://homosaurus.org/v5/homoit0001904"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85086002"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001017"},"dc:replaces":{"@id":"http://homosaurus.org/v2/misogyny"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001561","dc:identifier":"homoit0001561","skos:prefLabel":[{"@language":"en","@value":"Stigma"},{"@language":"es","@value":"Estigma"},{"@language":"nl","@value":"Stigma"},{"@language":"sv","@value":"Stigma"}],"rdfs:comment":[{"@language":"en","@value":"Widespread disapproval of a group of people or set of behaviors based on preconceived ideas."},{"@language":"es","@value":"Desaprobación generalizada de un grupo de personas o de un conjunto de conductas basada en ideas preconcebidas."},{"@language":"nl","@value":"Wijdverbreide afkeuring van een groep personen of een reeks gedragingen op basis van vooropgezette ideeën."},{"@language":"sv","@value":"Utbrett ogillande av en grupp människor eller ett visst beteende baserat på förutfattade meningar."}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000112"},{"@id":"https://homosaurus.org/v5/homoit0000356"},{"@id":"https://homosaurus.org/v5/homoit0000534"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85128107"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001561"},"dc:replaces":{"@id":"http://homosaurus.org/v2/stigma"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-03"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001885","dc:identifier":"homoit0001885","skos:prefLabel":[{"@language":"en","@value":"Anti-Two-Spirit discrimination"},{"@language":"de","@value":"Anti-Two-Spirit-Diskriminierung"},{"@language":"es","@value":"Discriminación anti-dos espíritus"},{"@language":"nl","@value":"Anti-Two-Spirit discriminatie"},{"@language":"sv","@value":"Diskriminering av Two-spirit-personer"}],"skos:altLabel":[{"@language":"en","@value":"Anti-2S discrimination"},{"@language":"en","@value":"Anti-Two Spirit discrimination"},{"@language":"en","@value":"Anti-Two Spirited discrimination"},{"@language":"en","@value":"Anti-Two-Spirited discrimination"},{"@language":"de","@value":"Two-Spirit-feindliche Diskriminierung"},{"@language":"de","@value":"2S-feindliche Diskriminierung"},{"@language":"es","@value":"Discriminación dos espíritus"},{"@language":"es","@value":"Anti dos espiritus"},{"@language":"es","@value":"Discriminación anti-2S"},{"@language":"es","@value":"Anti 2S"},{"@language":"es","@value":"Discriminación hacia dos espíritus"},{"@language":"es","@value":"Discriminación hacia personas dos espíritus"}],"rdfs:comment":[{"@language":"en","@value":"The unjust or prejudicial treatment of Two-Spirit people due to their identity; may include the denial of legal rights, employment, and housing."},{"@language":"de","@value":"Die ungerechte oder voreingenommene Behandlung von Two-Spirit-Personen aufgrund ihrer Identität; kann die Verweigerung von gesetzlichen Rechten, Arbeitsplätzen und Wohnraum mit einschließen."},{"@language":"es","@value":"El trato injusto o perjudicial hacia las personas Dos Espíritus por su identidad; puede incluir la negación de derechos legales, empleo y vivienda."},{"@language":"nl","@value":"De onrechtvaardige of nadelige behandeling van Two-Spirit-people vanwege hun identiteit; kan de ontkenning van wettelijke rechten, werkgelegenheid en huisvesting omvatten"},{"@language":"sv","@value":"Systematiskt orättvist eller fördomsfull behandling av Two-spirit-personer vilket kan ta sig uttryck i begränsad tillgång till arbete, bostad eller rättsligt erkännande."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000356"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000112"},{"@id":"https://homosaurus.org/v5/homoit0000920"},{"@id":"https://homosaurus.org/v5/homoit0003158"},{"@id":"https://homosaurus.org/v5/homoit0003737"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000356"},"dc:issued":{"@type":"xsd:date","@value":"2022-02-17"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001893","dc:identifier":"homoit0001893","skos:prefLabel":[{"@language":"en","@value":"Anti-intersex discrimination"},{"@language":"de","@value":"Diskriminierung von inter* Personen"},{"@language":"es","@value":"Discriminación anti-intersexual"},{"@language":"nl","@value":"Anti-intersekse discriminatie"},{"@language":"sv","@value":"Diskriminering av intersexpersoner"}],"skos:altLabel":[{"@language":"de","@value":"Antiinter* Diskriminierung"},{"@language":"de","@value":"Anti-intersex* Diskriminierung"},{"@language":"de","@value":"Antiintersex* Diskriminierung"},{"@language":"de","@value":"Anti-inter* Diskriminierung"},{"@language":"es","@value":"Discriminación anti-intersex"}],"rdfs:comment":[{"@language":"en","@value":"The unjust or prejudicial treatment of intersex people due to the fact that they are intersex; may include the denial of legal rights, employment, and housing."},{"@language":"de","@value":"Die ungerechte oder vorurteilsbehaftete Behandlung von inter* Menschen aufgrund der Tatsache, dass sie inter* sind; kann die Verweigerung von gesetzlichen Rechten, Beschäftigung und Wohnraum beinhalten."},{"@language":"es","@value":"El trato injusto o perjudicial hacia las personas intersexuales por el hecho de ser intersex; puede incluir la negación de derechos legales, empleo y vivienda."},{"@language":"nl","@value":"De onrechtvaardige of op vooroordelen gebaseerde behandeling van intersekse personen vanwege hun identiteit; kan de ontkenning van wettelijke rechten, werkgelegenheid en huisvesting omvatten"},{"@language":"sv","@value":"Systematiskt orättvist eller fördomsfull behandling av intersexpersoner på grund av deras identitet, uttryck eller tillhörighet, vilket kan ta sig uttryck i begränsad tillgång till arbete, bostad eller rättsligt erkännande."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000356"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000112"},{"@id":"https://homosaurus.org/v5/homoit0000666"},{"@id":"https://homosaurus.org/v5/homoit0003737"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2016001192"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000356"},"dc:issued":{"@type":"xsd:date","@value":"2022-02-28"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002899","dc:identifier":"homoit0002899","skos:prefLabel":[{"@language":"en","@value":"Anti-asexual discrimination"},{"@language":"es","@value":"Discriminación anti-asexual"},{"@language":"de","@value":"Diskriminierung von asexuellen Personen"},{"@language":"nl","@value":"Anti-aseksuele discriminatie"},{"@language":"sv","@value":"Diskriminering av asexuella"}],"skos:altLabel":[{"@language":"de","@value":"Antiasexuelle Diskriminierung"},{"@language":"de","@value":"Anti-asexuelle Diskriminierung"}],"rdfs:comment":[{"@language":"en","@value":"The unjust or prejudicial treatment of asexual people due to their sexual identity; may include the denial of legal rights, employment, and housing."},{"@language":"es","@value":"El trato injusto o perjudicial hacia personas asexuales por su identidad sexual; puede incluir la negación de derechos legales, empleo y vivienda."},{"@language":"de","@value":"Die ungerechte oder vorurteilsbehaftete Behandlung asexueller Menschen aufgrund ihrer sexuellen Identität; kann die Verweigerung von gesetzlichen Rechten, Beschäftigung und Wohnraum beinhalten."},{"@language":"nl","@value":"De onrechtvaardige of vooroordelende behandeling van aseksuele personen vanwege hun seksuele identiteit; kan de ontkenning van wettelijke rechten, werkgelegenheid en huisvesting omvatten."},{"@language":"sv","@value":"Systematiskt orättvist eller fördomsfull behandling av asexuella personer på grund av deras identitet, uttryck eller tillhörighet, vilket kan ta sig uttryck i begränsad tillgång till arbete, bostad eller rättsligt erkännande."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000356"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000112"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000356"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-29"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000113","dc:identifier":"homoit0000113","skos:prefLabel":[{"@language":"tl","@value":"Binabae"},{"@language":"es","@value":"Binabae"},{"@language":"de","@value":"Binabea"},{"@language":"nl","@value":"Binabae"},{"@language":"sv","@value":"Binabae"}],"rdfs:comment":[{"@language":"en","@value":"Tagalog term for individuals who possess both male and female traits."},{"@language":"es","@value":"Término tagalog para designar a una persona con rasgos tanto masculinos como femeninos."},{"@language":"de","@value":"Tagalog-Begriff für Personen, die nach gesellschaftlichen und medizinischen Normvorstellungen weibliche und männlichen Merkmale aufweisen."},{"@language":"nl","@value":"Filipijnse term voor een persoon met zowel mannelijke als vrouwelijke eigenschappen"},{"@language":"sv","@value":"Tagalog-term för individer som har både manliga och kvinnliga egenskaper."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000322"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/binabae"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000114","dc:identifier":"homoit0000114","skos:prefLabel":[{"@language":"en","@value":"Binding (Chest)"},{"@language":"es","@value":"Fajarse el pecho"},{"@language":"de","@value":"Abbinden (Brust)"},{"@language":"fr","@value":"Compression de la poitrine"},{"@language":"nl","@value":"Afbinden (borsten)"},{"@language":"sv","@value":"Binding (bröstkorg)"}],"skos:altLabel":[{"@language":"es","@value":"Binding"},{"@language":"es","@value":"Faja"},{"@language":"es","@value":"Práctica de fajado de pecho"},{"@language":"es","@value":"Vendarse el pecho"},{"@language":"de","@value":"Binding"}],"rdfs:comment":[{"@language":"en","@value":"The act of flattening or concealing the chest area with a tight fitting shirt, strap, or similar material; often practiced by transgender men and transmasculine people."},{"@language":"es","@value":"El acto de aplanar u ocultar la zona del pecho con una camisa ajustada, una correa o un material similar; suele practicarse por hombres transgénero o personas transmasculinas."},{"@language":"de","@value":"Der Akt des Kompromierens des Brustgewebes mit einem enganliegenden Shirt, Band oder ähnlichem; wird häufig von trans Männern oder transmaskulinen Personen gemacht."},{"@language":"fr","@value":"Aplatir ou de dissimuler la poitrine avec une chemise moulante, une sangle ou un matériau similaire; souvent pratiqué par les hommes trans et les personnes transmasculines."},{"@language":"nl","@value":"De handeling van het afvlakken of verbergen van de borst met een nauwsluitend shirt, riem of soortgelijk materiaal; binding wordt vaak uitgevoerd door transmannelijke individuen"},{"@language":"sv","@value":"Att platta till eller dölja bröstområdet med hjälp av åtsittande tröja, band eller liknande material. En praktik som oftast används av transmän och transmaskulina personer."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000568"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000222"},{"@id":"https://homosaurus.org/v5/homoit0000436"},{"@id":"https://homosaurus.org/v5/homoit0001643"},{"@id":"https://homosaurus.org/v5/homoit0001840"},{"@id":"https://homosaurus.org/v5/homoit0001852"},{"@id":"https://homosaurus.org/v5/homoit0003118"},{"@id":"https://homosaurus.org/v5/homoit0003815"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bindingChest"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000222","dc:identifier":"homoit0000222","skos:prefLabel":[{"@language":"en","@value":"Breast"},{"@language":"es","@value":"Seno"},{"@language":"de","@value":"Brust"},{"@language":"nl","@value":"Borst"},{"@language":"sv","@value":"Bröst"}],"skos:altLabel":[{"@language":"en","@value":"Boobs"},{"@language":"en","@value":"Bosoms"},{"@language":"en","@value":"Bosom"},{"@language":"en","@value":"Tits"},{"@language":"en","@value":"Titties"},{"@language":"en","@value":"Boob"},{"@language":"en","@value":"Breasts"},{"@language":"en","@value":"Tit"},{"@language":"en","@value":"Titty"},{"@language":"es","@value":"Mamas"},{"@language":"es","@value":"Teta"},{"@language":"es","@value":"Tetas"},{"@language":"es","@value":"Bubis"},{"@language":"es","@value":"Chichis"},{"@language":"de","@value":"Brüste"},{"@language":"de","@value":"Busen"},{"@language":"de","@value":"Möpse"},{"@language":"de","@value":"Titten"},{"@language":"de","@value":"Titte"},{"@language":"de","@value":"Vorbau"},{"@language":"nl","@value":"Boezems"},{"@language":"nl","@value":"Borsten"},{"@language":"nl","@value":"Pram"},{"@language":"nl","@value":"Prammen"},{"@language":"nl","@value":"Tiet"},{"@language":"nl","@value":"Tieten"},{"@language":"nl","@value":"Tietjes"}],"rdfs:comment":[{"@language":"en","@value":"One of the two soft, protruding organs on an individual's chest."},{"@language":"es","@value":"Uno de los dos órganos blandos que sobresalen del pecho de una persona."},{"@language":"de","@value":"Eines der beiden weichen, hervorstehenden Organe auf der Brust einer Person."},{"@language":"nl","@value":"Een van de twee zachte, uitstekende organen op de borst van een persoon."},{"@language":"sv","@value":"De mjuka, utstickande organen på en individs bröst."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000401"},{"@id":"https://homosaurus.org/v5/homoit0001259"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000114"},{"@id":"https://homosaurus.org/v5/homoit0001620"},{"@id":"https://homosaurus.org/v5/homoit0001621"},{"@id":"https://homosaurus.org/v5/homoit0001622"},{"@id":"https://homosaurus.org/v5/homoit0001623"},{"@id":"https://homosaurus.org/v5/homoit0001630"},{"@id":"https://homosaurus.org/v5/homoit0001631"},{"@id":"https://homosaurus.org/v5/homoit0001639"},{"@id":"https://homosaurus.org/v5/homoit0003118"},{"@id":"https://homosaurus.org/v5/homoit0003130"},{"@id":"https://homosaurus.org/v5/homoit0003132"},{"@id":"https://homosaurus.org/v5/homoit0003133"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85016677"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000401"},"dc:replaces":{"@id":"http://homosaurus.org/v2/breasts"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000436","dc:identifier":"homoit0000436","skos:prefLabel":[{"@language":"en","@value":"FtMs"},{"@language":"es","@value":"FTMs"},{"@language":"de","@value":"FzM"},{"@language":"nl","@value":"FtMs"},{"@language":"sv","@value":"FtM"}],"skos:altLabel":[{"@language":"en","@value":"Females transitioning to males"},{"@language":"en","@value":"FtM transsexuals"},{"@language":"en","@value":"F2Ms"},{"@language":"en","@value":"Transsexual men"},{"@language":"en","@value":"Female-to-male"},{"@language":"es","@value":"F2Ms"},{"@language":"es","@value":"Mujer-a-hombre"},{"@language":"es","@value":"Mujeres transicionando a hombres"},{"@language":"es","@value":"Transexuales FTM"},{"@language":"es","@value":"Hombres transexuales"},{"@language":"nl","@value":"FtM transseksuelen"},{"@language":"nl","@value":"Transseksuele mannen"},{"@language":"nl","@value":"Vrouw naar man"}],"rdfs:comment":[{"@language":"en","@value":"FtM (female-to-male) is a mostly historical term which has been largely replaced by “trans men.” This is due in part to the term's role in the medicalization of transgender people and the assumption that trans men were previously “female” and have become “male” (typically through hormones and/or surgery)."},{"@language":"es","@value":"FtM (del inglés \"female-to-male\", traducido como \"de mujer a hombre\") es un término mayoritariamente histórico que ha sido reemplazado en gran medida por \"hombres trans\". Esto se debe, en parte, al rol del término en la medicalización de las personas transgénero y a la suposición de que los hombres trans antes eran “femeninos” y se han convertido en “masculinos” (generalmente, a través de hormonas y/o cirugía)."},{"@language":"de","@value":"FzM (Frau-zu-Mann) ist ein größtenteils historischer Begriff, der weitgehend durch den Begriff „trans Mann“ ersetzt wurde. Dies ist teilweise auf die Rolle des Begriffs bei der Medikalisierung von trans Personen und auf die hinter \"MzF\" stehende Annahme zurückzuführen, dass Transmänner zuvor „weiblich“ gewesen und (typischerweise durch Hormone und/oder Operationen) „männlich“ geworden seien. Der Begriff spielt also dem gängigen transfeindlichen Narrativ zu, trans Männer seien erst nach der Einnahme von Hormonen und nach Operationen als Männer anzusehen."},{"@language":"nl","@value":"FtM (female-to-male) is een grotendeels historische term die grotendeels is vervangen door 'transmannen'. Dit is gedeeltelijk te wijten aan het verband tussen de term en de medicalisering van transgenders en de veronderstelling dat een transman \"vrouwelijk\" was en \"mannelijk\" is geworden (meestal door hormonen en/of chirurgie)"},{"@language":"sv","@value":"FtM (female-to-male) är en huvudsakligen historisk term som till stor del har ersatts av “transmän”. Det beror delvis på termens roll i den medicinska behandlingen av transpersoner och antagandet att transmän tidigare varit “kvinnor” och har “blivit män” (ofta genom hormoner och/eller kirurgi)."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000878"},{"@id":"https://homosaurus.org/v5/homoit0001381"},{"@id":"https://homosaurus.org/v5/homoit0001643"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000114"},{"@id":"https://homosaurus.org/v5/homoit0000224"},{"@id":"https://homosaurus.org/v5/homoit0000457"},{"@id":"https://homosaurus.org/v5/homoit0000986"},{"@id":"https://homosaurus.org/v5/homoit0001027"},{"@id":"https://homosaurus.org/v5/homoit0001362"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000878"},"dc:replaces":{"@id":"http://homosaurus.org/v2/FtMs"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001840","dc:identifier":"homoit0001840","skos:prefLabel":[{"@language":"en","@value":"Top surgery"},{"@language":"es","@value":"Cirugía de pecho"},{"@language":"nl","@value":"Top chirurgie"},{"@language":"sv","@value":"Toppkirurgi"}],"skos:altLabel":[{"@language":"es","@value":"Cirugía superior"},{"@language":"sv","@value":"Top surgery"}],"rdfs:comment":[{"@language":"en","@value":"Colloquial term for gender-affirming surgical alterations of the chest."},{"@language":"es","@value":"Término coloquial para las alteraciones quirúrgicas del tórax que afirman el género."},{"@language":"nl","@value":"Informele term voor genderbevestigende chirurgische veranderingen van de borst"},{"@language":"sv","@value":"Vardaglig term för könsbekräftande kirurgi av bröstkorg eller bröst."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000561"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0001620"},{"@id":"https://homosaurus.org/v5/homoit0001631"},{"@id":"https://homosaurus.org/v5/homoit0001841"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000114"},{"@id":"https://homosaurus.org/v5/homoit0000584"},{"@id":"https://homosaurus.org/v5/homoit0001465"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001004"},"dc:issued":{"@type":"xsd:date","@value":"2022-02-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001852","dc:identifier":"homoit0001852","skos:prefLabel":[{"@language":"en","@value":"Stand-to-Pee devices"},{"@language":"es","@value":"Aparatos para orinar de pie"},{"@language":"nl","@value":"Hulpmiddelen voor staand plassen"},{"@language":"sv","@value":"STP"}],"skos:altLabel":[{"@language":"en","@value":"STP devices"},{"@language":"en","@value":"STPs"},{"@language":"en","@value":"Stand to pee devices"},{"@language":"es","@value":"Aparatos para mear de pie"},{"@language":"sv","@value":"Stand to pee"}],"rdfs:comment":[{"@language":"en","@value":"Devices designed to allow individuals to pee while standing up; often used by trans men or transmasculine people to pee in public urinals without risking their safety."},{"@language":"es","@value":"Dispositivos diseñados para permitir a las personas orinar de pie; a menudo utilizados por hombres trans o personas transmasculinas para orinar en urinarios públicos sin arriesgar su seguridad."},{"@language":"nl","@value":"Hulpmiddelen die zijn ontworpen om individuen in staat te stellen staand te plassen; vaak gebruikt door transmannen of transmasculiene personen om in openbare urinoirs te plassen zonder hun eigen veiligheid in gevaar te brengen"},{"@language":"sv","@value":"Redskap utformade för att möjliggöra att personer kissar stående. Används ofta av transmän eller transmaskulina personer för att kunna använda offentliga urinoarer utan att riskera sin säkerhet."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000568"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000114"},{"@id":"https://homosaurus.org/v5/homoit0001846"},{"@id":"https://homosaurus.org/v5/homoit0001894"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2022-02-15"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003118","dc:identifier":"homoit0003118","skos:prefLabel":[{"@language":"en","@value":"Chest"},{"@language":"es","@value":"Pecho"},{"@language":"de","@value":"Brust"},{"@language":"nl","@value":"Borstkas"},{"@language":"sv","@value":"Bröstpartiet"}],"skos:altLabel":[{"@language":"es","@value":"Tórax"},{"@language":"sv","@value":"Bröstkorg"}],"rdfs:comment":[{"@language":"en","@value":"A gender-inclusive term for the upper area of the torso, can be used if the person has breasts or not."},{"@language":"es","@value":"Término inclusivo de género para la zona superior del torso; se puede utilizar para personas con o sin senos."},{"@language":"de","@value":"Ein geschlechtsneutraler Begriff für den oberen Bereich des Oberkörpers, der unabhängig davon verwendet werden kann, ob die Person Brüste hat oder nicht."},{"@language":"nl","@value":"Een genderinclusieve term voor het bovengedeelte van de torso, kan worden gebruikt als een persoon borsten heeft of niet."},{"@language":"sv","@value":"En könsneutral term för den övre delen av överkroppen, kan användas oavsett om personen har bröst eller inte."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000401"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000114"},{"@id":"https://homosaurus.org/v5/homoit0000222"},{"@id":"https://homosaurus.org/v5/homoit0001621"},{"@id":"https://homosaurus.org/v5/homoit0001841"},{"@id":"https://homosaurus.org/v5/homoit0003132"},{"@id":"https://homosaurus.org/v5/homoit0003133"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000401"},"dc:issued":{"@type":"xsd:date","@value":"2023-12-20"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003815","dc:identifier":"homoit0003815","skos:prefLabel":[{"@language":"en","@value":"Binders (Chest)"},{"@language":"nl","@value":"Binders (Borst)"},{"@language":"sv","@value":"Binders"}],"skos:altLabel":{"@language":"en","@value":"Chest binders"},"rdfs:comment":[{"@language":"en","@value":"Tight-fitting shirts, straps, or similar materials worn to flatten or conceal the chest area, often by transgender men and transmasculine people."},{"@language":"nl","@value":"Strak zittende shirts, banden of soortgelijke materialen die gedragen worden om de borst af te vlakken of te verbergen, vaak door transmannen en transmasculiene personen."},{"@language":"sv","@value":"Åtsittande tröjor, band eller liknande material som bärs för att platta till eller dölja bröstområdet, oftast använda av transmän och transmaskulina personer."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000289"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000114"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2024-11-27"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000115","dc:identifier":"homoit0000115","skos:prefLabel":[{"@language":"en","@value":"Essentialism"},{"@language":"es","@value":"Esencialismo"},{"@language":"de","@value":"Essentialismus"},{"@language":"nl","@value":"Essentialisme"},{"@language":"sv","@value":"Essentialism"}],"skos:altLabel":[{"@language":"en","@value":"Biological essentialism"},{"@language":"es","@value":"Esencialismo biológico"},{"@language":"de","@value":"Biologischer Essentialismus"}],"rdfs:comment":[{"@language":"en","@value":"The practice of defining certain categories through a set of supposed universal or fixed characteristics or traits (e.g., defining women in terms of \"female\" genitalia)."},{"@language":"es","@value":"La práctica de definir ciertas categorías a través de un conjunto de características o rasgos supuestamente universales o fijos (por ejemplo, definir a las mujeres en términos de genitales \"femeninos\")."},{"@language":"de","@value":"Die Praxis, bestimmte Kategorien anhand einer Reihe vermeintlich universeller oder fester Merkmale oder Eigenschaften zu definieren (z. B. die Definition von Frauen anhand ihrer „weiblichen” Genitalien)."},{"@language":"nl","@value":"De praktijk van het definiëren van bepaalde categorieën door middel van een reeks veronderstelde universele of vaste kenmerken of eigenschappen (bijvoorbeeld het definiëren van vrouwen in termen van \"vrouwelijke\" genitaliën)."},{"@language":"sv","@value":"Praktiken att definiera vissa kategorier genom påstått universella eller fasta egenskaper eller kännetecken (t.ex. att definiera kvinnor utifrån ”kvinnliga” genitalier)."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001365"},"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0003158"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001219"},{"@id":"https://homosaurus.org/v5/homoit0001295"},{"@id":"https://homosaurus.org/v5/homoit0001320"},{"@id":"https://homosaurus.org/v5/homoit0003519"}],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85044919"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001365"},"dc:replaces":{"@id":"http://homosaurus.org/v2/essentialism"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001365","dc:identifier":"homoit0001365","skos:prefLabel":[{"@language":"en","@value":"Theories"},{"@language":"es","@value":"Teorías"},{"@language":"nl","@value":"Theorieën"},{"@language":"sv","@value":"Teorier"}],"skos:altLabel":[{"@language":"es","@value":"Teoría"},{"@language":"nl","@value":"Deconstructivisme"}],"rdfs:comment":[{"@language":"en","@value":"Systems of ideas intended to explain a particular phenomenon."},{"@language":"es","@value":"Sistemas de ideas destinados a explicar un fenómeno particular."},{"@language":"nl","@value":"Systeem van ideeën, bedoeld om een bepaald fenomeen te verklaren."},{"@language":"sv","@value":"Idésystem som syftar till att förklara ett visst fenomen."}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000115"},{"@id":"https://homosaurus.org/v5/homoit0000408"},{"@id":"https://homosaurus.org/v5/homoit0001219"},{"@id":"https://homosaurus.org/v5/homoit0001320"},{"@id":"https://homosaurus.org/v5/homoit0001902"},{"@id":"https://homosaurus.org/v5/homoit0002039"},{"@id":"https://homosaurus.org/v5/homoit0002272"},{"@id":"https://homosaurus.org/v5/homoit0003515"},{"@id":"https://homosaurus.org/v5/homoit0003520"},{"@id":"https://homosaurus.org/v5/homoit0003616"},{"@id":"https://homosaurus.org/v5/homoit0003989"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001365"},"dc:replaces":{"@id":"http://homosaurus.org/v2/theories"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001219","dc:identifier":"homoit0001219","skos:prefLabel":[{"@language":"en","@value":"Queer theory"},{"@language":"es","@value":"Teoría queer"},{"@language":"nl","@value":"Queer theory"},{"@language":"sv","@value":"Queerteori"}],"skos:altLabel":{"@language":"sv","@value":"Queerstudier"},"rdfs:comment":[{"@language":"en","@value":"Field of critical theory that emerged in the 1990s out of queer studies and women's studies. Queer theory involves the study and theorization of gender and sexual practices and identities that exist outside of heterosexuality and which challenge heteronormativity and essentialism."},{"@language":"es","@value":"Campo de la teoría crítica que surgió en la década de 1990 a partir de los estudios queer y los estudios de la mujer. La teoría queer implica el estudio y la teorización de las prácticas e identidades sexuales y de género que existen fuera de la heterosexualidad y que desafían la heteronormatividad y el esencialismo."},{"@language":"nl","@value":"Gebied van de kritische theorie dat in de jaren negentig opkwam uit queerstudies en vrouwenstudies. Queer theory omvat de studie en theoretisering van gender- en seksuele praktijken en identiteiten die bestaan buiten heteroseksualiteit en die heteronormativiteit en essentialisme uitdagen"},{"@language":"sv","@value":"Kritiskt teoretiskt fält som växte fram under 1990-talet ur queerstudier och kvinnostudier. Queerteori omfattar studier och teoretisering av kön och sexuella praktiker och identiteter som existerar utanför heterosexualitet och som utmanar heteronormativitet och essentialism."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001365"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0002042"},{"@id":"https://homosaurus.org/v5/homoit0003614"},{"@id":"https://homosaurus.org/v5/homoit0003615"},{"@id":"https://homosaurus.org/v5/homoit0003707"},{"@id":"https://homosaurus.org/v5/homoit0003823"},{"@id":"https://homosaurus.org/v5/homoit0003826"},{"@id":"https://homosaurus.org/v5/homoit0003987"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000115"},{"@id":"https://homosaurus.org/v5/homoit0000579"},{"@id":"https://homosaurus.org/v5/homoit0001149"},{"@id":"https://homosaurus.org/v5/homoit0001210"},{"@id":"https://homosaurus.org/v5/homoit0001218"},{"@id":"https://homosaurus.org/v5/homoit0001320"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2006001835"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001365"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerTheory"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001320","dc:identifier":"homoit0001320","skos:prefLabel":[{"@language":"en","@value":"Social constructionism"},{"@language":"es","@value":"Construccionismo social"},{"@language":"nl","@value":"Sociaal constructivisme"},{"@language":"sv","@value":"Socialkonstruktivism"}],"rdfs:comment":[{"@language":"en","@value":"Belief or theory that categories of gender, sexual orientation, and ethnicity are cultural constructs rather than intrinsic categories of nature."},{"@language":"es","@value":"Creencia o teoría de que las categorías de género, orientación sexual y etnicidad son construcciones culturales y no categorías intrínsecas de la naturaleza."},{"@language":"nl","@value":"kennistheorie die stelt dat veel categorieën, zoals gender, seksuele oriëntatie en etniciteit, in werkelijkheid sociale en culturele constructies zijn"},{"@language":"sv","@value":"Föreställningen eller teorin att bland annat kön, sexuell läggning och etnicitet är kulturella konstruktioner snarare än naturliga kategorier."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001365"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000115"},{"@id":"https://homosaurus.org/v5/homoit0001006"},{"@id":"https://homosaurus.org/v5/homoit0001219"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2009007835"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001365"},"dc:replaces":{"@id":"http://homosaurus.org/v2/socialConstructionism"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003519","dc:identifier":"homoit0003519","skos:prefLabel":[{"@language":"en","@value":"Patriarchy"},{"@language":"es","@value":"Patriarcado"},{"@language":"nl","@value":"Patriarchaat"},{"@language":"sv","@value":"Patriarkat"}],"skos:altLabel":[{"@language":"en","@value":"Androcracy"},{"@language":"es","@value":"Androcracia"}],"rdfs:comment":[{"@language":"en","@value":"A cultural system in which positions of dominance and privilege are held by men, while women and other gender minorities are largely excluded from access to power."},{"@language":"es","@value":"Sistema cultural donde los hombres ocupan posiciones de dominio y privilegio, mientras que las mujeres y otras minorías de género quedan excluidas, en gran medida, del acceso al poder."},{"@language":"nl","@value":"Een cultureel systeem waarin dominante en bevoorrechte posities worden bekleed door mannen, terwijl vrouwen en andere genderminderheden grotendeels worden uitgesloten van toegang tot macht."},{"@language":"sv","@value":"Ett kulturellt system där makt och privilegier koncentreras till män, medan kvinnor och könsminoriteter till stor del exkluderas från tillgång till inflytande."}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000115"},{"@id":"https://homosaurus.org/v5/homoit0000565"},{"@id":"https://homosaurus.org/v5/homoit0001278"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85098727"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0003519"},"dc:issued":{"@type":"xsd:date","@value":"2024-07-31"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000116","dc:identifier":"homoit0000116","skos:prefLabel":[{"@language":"en","@value":"Biological parenthood"},{"@language":"es","@value":"Maternidad y paternidad biológica"},{"@language":"de","@value":"Biologische Elternschaft"},{"@language":"nl","@value":"Biologisch ouderschap"},{"@language":"sv","@value":"Biologiskt föräldraskap"}],"skos:altLabel":[{"@language":"es","@value":"Maternidad biológica"},{"@language":"es","@value":"Paternidad biológica"}],"rdfs:comment":[{"@language":"en","@value":"The experience of being a biological parent to a child. This relationship can be genetic, gestational, or both."},{"@language":"es","@value":"Persona que tiene una relación biológica con un hijo o hijos. Esta relación puede ser genética, gestacional o ambas."},{"@language":"de","@value":"Die Erfahrung, biologischer Elternteil eines Kindes zu sein. Diese Beziehung kann genetisch, schwangerschaftsbedingt oder beides sein."},{"@language":"nl","@value":"De ervaring om een biologische ouder te zijn van een kind. Deze relatie kan genetisch, zwangerschapsgebonden of beide zijn."},{"@language":"sv","@value":"Erfarenheten av att vara biologisk förälder till ett barn. Denna relation kan vara genetisk, gestationell (att vara den bärande föräldern) eller båda."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000819"},{"@id":"https://homosaurus.org/v5/homoit0000914"}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000583"},{"@id":"https://homosaurus.org/v5/homoit0000587"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000121"},{"@id":"https://homosaurus.org/v5/homoit0000364"},{"@id":"https://homosaurus.org/v5/homoit0000451"},{"@id":"https://homosaurus.org/v5/homoit0001001"},{"@id":"https://homosaurus.org/v5/homoit0001093"},{"@id":"https://homosaurus.org/v5/homoit0002621"},{"@id":"https://homosaurus.org/v5/homoit0002623"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000420"},"dc:replaces":{"@id":"http://homosaurus.org/v2/biologicalParenthood"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000819","dc:identifier":"homoit0000819","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ biological parents"},{"@language":"ja","@value":"LGBTQ+の生物学的親"},{"@language":"es","@value":"Padres y madres biológicos LGBTQ+"},{"@language":"nl","@value":"LHBTQ+-biologische ouders"},{"@language":"sv","@value":"Biologiska föräldrar (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"LGBTQ biological parents"},{"@language":"ja","@value":"LGBTQの生物学的親"},{"@language":"es","@value":"Padres y madres biológicos LGBTQ"}],"rdfs:comment":[{"@language":"en","@value":"Biological or genetic parents who are LGBTQ+ people. For adoption contexts, use LGBTQ+ birth parents."},{"@language":"ja","@value":"LGBTQ+である生物学的または遺伝的な親。養子縁組の文脈では、「LGBTQ+の生みの親」という表現を使用する。"},{"@language":"es","@value":"Padres biológicos o genéticos que son personas LGBTQ+. Para contextos de adopción, utilícese padres biológicos LGBTQ+."},{"@language":"nl","@value":"Biologische of genetische ouders die LHBTQ+-personen zijn. Gebruik voor adoptiecontexten LGBTQ+ geboorte-ouders."},{"@language":"sv","@value":"Biologiska eller genetiska föräldrar som är hbtq+-personer. Vid adoption används termen ”Förstaföräldrar (hbtq+)”."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000420"},{"@id":"https://homosaurus.org/v5/homoit0001075"}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000116"},{"@id":"https://homosaurus.org/v5/homoit0000583"},{"@id":"https://homosaurus.org/v5/homoit0000587"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000121"},{"@id":"https://homosaurus.org/v5/homoit0000864"},{"@id":"https://homosaurus.org/v5/homoit0000914"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000420"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQBiologicalParents"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000583","dc:identifier":"homoit0000583","skos:prefLabel":[{"@language":"en","@value":"Genetic parenthood"},{"@language":"es","@value":"Maternidad y paternidad genética"},{"@language":"de","@value":"Genetische Elternschaft"},{"@language":"nl","@value":"Genetisch ouderschap"},{"@language":"sv","@value":"Biologiskt föräldraskap"}],"skos:altLabel":[{"@language":"es","@value":"Paternidad genética"},{"@language":"es","@value":"Maternidad genetica"},{"@language":"de","@value":"Biologische Elternschaft"}],"rdfs:comment":[{"@language":"en","@value":"The experience of parenthood as felt by parents who passed on genetic material to their child or children."},{"@language":"es","@value":"La experiencia de la maternidad y paternidad tal como la sienten los padres que transmitieron material genético a su hijo o hijos."},{"@language":"de","@value":"Die Erfahrung des Elternseins, wie sie von Eltern empfunden wird, die ihr genetisches Material an ihr Kind oder ihre Kinder weitergegeben haben."},{"@language":"sv","@value":"Föräldraskap såsom det upplevs av föräldrar som fört vidare sitt genetiska material till barnet eller barnen."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000116"},{"@id":"https://homosaurus.org/v5/homoit0000819"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000364"},{"@id":"https://homosaurus.org/v5/homoit0000390"},{"@id":"https://homosaurus.org/v5/homoit0000587"},{"@id":"https://homosaurus.org/v5/homoit0000914"},{"@id":"https://homosaurus.org/v5/homoit0002621"},{"@id":"https://homosaurus.org/v5/homoit0002623"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000420"},"dc:replaces":{"@id":"http://homosaurus.org/v2/geneticParenthood"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000587","dc:identifier":"homoit0000587","skos:prefLabel":[{"@language":"en","@value":"Gestational parenthood"},{"@language":"es","@value":"Maternidad y paternidad gestacional"},{"@language":"de","@value":"Gestationelle Elternschaft"},{"@language":"nl","@value":"Zwangerschap en ouderschap"},{"@language":"sv","@value":"Bärande föräldraskap"}],"skos:altLabel":[{"@language":"es","@value":"Maternidad gestacional"},{"@language":"es","@value":"Paternidad gestacional"},{"@language":"de","@value":"Schwangerschafts-Elternschaft"}],"rdfs:comment":[{"@language":"en","@value":"The experience of parenthood as felt by a person whose uterus was utilized to nurture and develop an embryo into a baby."},{"@language":"es","@value":"La experiencia de la paternidad y/o maternidad tal como la siente una persona cuyo útero fue utilizado para nutrir y desarrollar un embrión hasta convertirlo en un bebé."},{"@language":"de","@value":"Die Erfahrung der Elternschaft, wie sie von einer Person empfunden wird, deren Gebärmutter dazu diente, einen Embryo zu einem Baby heranzuwachsen."},{"@language":"nl","@value":"De ervaring van ouderschap zoals gevoeld door een persoon wiens baarmoeder werd gebruikt om een embryo tot een baby te voeden en te ontwikkelen."},{"@language":"sv","@value":"Föräldraskap såsom det upplevs av en person vars livmoder användes för att bära och utveckla ett embryo till en bebis."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000116"},{"@id":"https://homosaurus.org/v5/homoit0000819"}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000121"},{"@id":"https://homosaurus.org/v5/homoit0001347"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000583"},{"@id":"https://homosaurus.org/v5/homoit0002627"},{"@id":"https://homosaurus.org/v5/homoit0002628"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000420"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gestationalParenthood"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000364","dc:identifier":"homoit0000364","skos:prefLabel":[{"@language":"en","@value":"Donors"},{"@language":"es","@value":"Donantes"},{"@language":"de","@value":"Spender:innen"},{"@language":"nl","@value":"Donoren"},{"@language":"sv","@value":"Donater (medicin)"}],"skos:altLabel":[{"@language":"de","@value":"Spender"},{"@language":"de","@value":"Spenderinnen"}],"rdfs:comment":[{"@language":"en","@value":"Individuals who donate their own biological materials, typically gametes (e.g., sperm or eggs), organs, or blood."},{"@language":"es","@value":"Personas que donan sus propios materiales biológicos, normalmente gametos (p. ej., esperma u óvulos), órganos o sangre."},{"@language":"de","@value":"Personen, die ihr eigenes biologisches Material spenden, in der Regel Keimzellen (z. B. Sperma oder Eizellen), Organe oder Blut."},{"@language":"nl","@value":"Personen die iets geven of doneren; vaak gebruikt om personen te beschrijven die bloed, sperma of organen doneren."},{"@language":"sv","@value":"Individer som donerar sitt eget biologiska material, vanligtvis könsceller (t.ex. spermier eller ägg), organ eller blod."}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000390"},{"@id":"https://homosaurus.org/v5/homoit0000824"},{"@id":"https://homosaurus.org/v5/homoit0001336"},{"@id":"https://homosaurus.org/v5/homoit0002616"},{"@id":"https://homosaurus.org/v5/homoit0002624"},{"@id":"https://homosaurus.org/v5/homoit0002625"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000116"},{"@id":"https://homosaurus.org/v5/homoit0000583"},{"@id":"https://homosaurus.org/v5/homoit0000843"},{"@id":"https://homosaurus.org/v5/homoit0000918"},{"@id":"https://homosaurus.org/v5/homoit0001004"},{"@id":"https://homosaurus.org/v5/homoit0002621"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000364"},"dc:replaces":{"@id":"http://homosaurus.org/v2/donors"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001001","dc:identifier":"homoit0001001","skos:prefLabel":[{"@language":"en","@value":"Motherhood"},{"@language":"es","@value":"Maternidad"},{"@language":"nl","@value":"Moederschap"},{"@language":"sv","@value":"Moderskap"}],"skos:altLabel":{"@language":"en","@value":"Maternity"},"rdfs:comment":[{"@language":"en","@value":"The state, condition, or fact of being a mother."},{"@language":"es","@value":"El estado, la condición o el hecho de ser madre."},{"@language":"nl","@value":"De staat, toestand of het feit van het moeder zijn"},{"@language":"sv","@value":"Tillståndet eller erfarenheten av att vara mamma."}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000116"},{"@id":"https://homosaurus.org/v5/homoit0000811"},{"@id":"https://homosaurus.org/v5/homoit0000864"},{"@id":"https://homosaurus.org/v5/homoit0000871"},{"@id":"https://homosaurus.org/v5/homoit0000905"},{"@id":"https://homosaurus.org/v5/homoit0000914"},{"@id":"https://homosaurus.org/v5/homoit0001021"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85087522"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001001"},"dc:replaces":{"@id":"http://homosaurus.org/v2/motherhood"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001093","dc:identifier":"homoit0001093","skos:prefLabel":[{"@language":"en","@value":"Fatherhood"},{"@language":"es","@value":"Paternidad"},{"@language":"de","@value":"Vaterschaft"},{"@language":"nl","@value":"Vaderschap"},{"@language":"sv","@value":"Faderskap"}],"skos:altLabel":{"@language":"en","@value":"Paternity"},"rdfs:comment":[{"@language":"en","@value":"The experience of acting as a father, including the responsibilities involved in fathering and raising children."},{"@language":"es","@value":"La experiencia de actuar como padre, incluidas las responsabilidades que implica la paternidad y la crianza de los hijos."},{"@language":"de","@value":"Die Erfahrung, als Vater zu handeln, einschließlich der mit der Vaterschaft und der Kindererziehung verbundenen Verantwortlichkeiten."},{"@language":"nl","@value":"De ervaring van het optreden als vader, inclusief de verantwoordelijkheden die gepaard gaan met het vaderschap en de opvoeding van kinderen."},{"@language":"sv","@value":"Erfarenheten av att vara pappa, inklusive ansvar för att fostra och uppfostra barn."}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000116"},{"@id":"https://homosaurus.org/v5/homoit0000423"},{"@id":"https://homosaurus.org/v5/homoit0000811"},{"@id":"https://homosaurus.org/v5/homoit0000864"},{"@id":"https://homosaurus.org/v5/homoit0000871"},{"@id":"https://homosaurus.org/v5/homoit0000914"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh89006293"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001093"},"dc:replaces":{"@id":"http://homosaurus.org/v2/fatherhood"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002621","dc:identifier":"homoit0002621","skos:prefLabel":[{"@language":"en","@value":"Donor siblings "},{"@language":"es","@value":"Hermanos de donación"},{"@language":"de","@value":"Spendergeschwister"},{"@language":"nl","@value":"Donor broers en zussen"},{"@language":"sv","@value":"Donatorssyskon"}],"skos:altLabel":{"@language":"de","@value":"Spender-Geschwister"},"rdfs:comment":[{"@language":"en","@value":"People who are biologically related to one another through a shared donor."},{"@language":"es","@value":"Personas que están relacionadas biológicamente entre sí a través de un donante compartido."},{"@language":"de","@value":"Personen, die durch einen gemeinsamen Spender biologisch verwandt sind."},{"@language":"nl","@value":"Personen die biologisch verwant zijn aan elkaar via een gedeelde donor."},{"@language":"sv","@value":"Personer som är biologiskt besläktade med varandra genom en gemensam donator."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001310"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000116"},{"@id":"https://homosaurus.org/v5/homoit0000364"},{"@id":"https://homosaurus.org/v5/homoit0000583"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000421"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002623","dc:identifier":"homoit0002623","skos:prefLabel":[{"@language":"en","@value":"Half-siblings "},{"@language":"de","@value":"Halbgeschwister"},{"@language":"es","@value":"Medios hermanos y hermanas"},{"@language":"nl","@value":"Halfbroers en halfzussen"},{"@language":"sv","@value":"Halvsyskon"}],"skos:altLabel":[{"@language":"en","@value":"Half siblings"},{"@language":"es","@value":"Medio hermanos"},{"@language":"es","@value":"Medio hermanas"}],"rdfs:comment":[{"@language":"en","@value":"Siblings who are biologically related through one but not all of their parents."},{"@language":"de","@value":"Geschwister, die durch einen, aber nicht beide Elternteile biologisch miteinander verwandt sind."},{"@language":"es","@value":"Hermanos que están relacionados biológicamente a través de uno, pero no todos, sus padres y/o madres."},{"@language":"nl","@value":"Broers en zussen die biologisch verwant zijn via één, maar niet via alle ouders."},{"@language":"sv","@value":"Syskon som är biologiskt släkt genom endast en av föräldrarna."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001310"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000116"},{"@id":"https://homosaurus.org/v5/homoit0000583"},{"@id":"https://homosaurus.org/v5/homoit0002349"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000421"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000420","dc:identifier":"homoit0000420","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ families"},{"@language":"es","@value":"Familias LGBTQ+"},{"@language":"ja","@value":"LGBTQ+の家族"},{"@language":"fr","@value":"Familles LGBTQ+"},{"@language":"nl","@value":"LHBTQ+-gezinnen"},{"@language":"sv","@value":"Hbtq+-familjer"}],"skos:altLabel":[{"@language":"en","@value":"Families (LGBTQ)"},{"@language":"ja","@value":"家族 (LGBTQ)"},{"@language":"fr","@value":"Familles de personnes LGBTQ+"}],"rdfs:comment":[{"@language":"en","@value":"Families, whether biological, adoptive, or chosen, in which one or more individuals identify as LGBTQ+."},{"@language":"es","@value":"Familias, ya sean biológicas, adoptivas o elegidas, en las que una o más personas se autoidentifican como LGBTQ+."},{"@language":"ja","@value":"実の家族、養子縁組による家族、あるいは自ら選んだ家族を問わず、その中に1人以上がLGBTQ+であると自認している家族。"},{"@language":"fr","@value":"Familles biologiques, adoptives ou choisies, dans lesquelles une ou plusieurs personnes s'identifient comme LGBTQ+."},{"@language":"nl","@value":"Gezinnen, biologisch, adoptief of gekozen, waarin een of meer individuen zich identificeren als LHBTQ+."},{"@language":"sv","@value":"Familjer – biologiska, adoptiva eller valda – där en eller flera personer identifierar sig som hbtq+."}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000150"},{"@id":"https://homosaurus.org/v5/homoit0000371"},{"@id":"https://homosaurus.org/v5/homoit0000491"},{"@id":"https://homosaurus.org/v5/homoit0000740"},{"@id":"https://homosaurus.org/v5/homoit0000810"},{"@id":"https://homosaurus.org/v5/homoit0000812"},{"@id":"https://homosaurus.org/v5/homoit0000819"},{"@id":"https://homosaurus.org/v5/homoit0000834"},{"@id":"https://homosaurus.org/v5/homoit0000870"},{"@id":"https://homosaurus.org/v5/homoit0000872"},{"@id":"https://homosaurus.org/v5/homoit0001075"},{"@id":"https://homosaurus.org/v5/homoit0001083"},{"@id":"https://homosaurus.org/v5/homoit0001176"},{"@id":"https://homosaurus.org/v5/homoit0001412"},{"@id":"https://homosaurus.org/v5/homoit0001757"},{"@id":"https://homosaurus.org/v5/homoit0001758"},{"@id":"https://homosaurus.org/v5/homoit0001759"},{"@id":"https://homosaurus.org/v5/homoit0002586"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000809"},{"@id":"https://homosaurus.org/v5/homoit0000811"},{"@id":"https://homosaurus.org/v5/homoit0000864"},{"@id":"https://homosaurus.org/v5/homoit0000871"},{"@id":"https://homosaurus.org/v5/homoit0000914"},{"@id":"https://homosaurus.org/v5/homoit0000945"},{"@id":"https://homosaurus.org/v5/homoit0001310"},{"@id":"https://homosaurus.org/v5/homoit0002584"},{"@id":"https://homosaurus.org/v5/homoit0002585"},{"@id":"https://homosaurus.org/v5/homoit0003920"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000420"},"dc:replaces":{"@id":"http://homosaurus.org/v2/familiesLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002592","dc:identifier":"homoit0002592","skos:prefLabel":[{"@language":"en","@value":"Internalized biphobia"},{"@language":"es","@value":"Bifobia internalizada"},{"@language":"nl","@value":"Geïnternaliseerde bifobie"},{"@language":"sv","@value":"Internaliserad bifobi"}],"rdfs:comment":[{"@language":"en","@value":"The phenomenon in which bisexual people internalize or adopt biphobic beliefs (i.e., negative perceptions of and intolerance toward bisexual people and bisexuality) as a result of being raised or socialized within a biphobic environment or culture."},{"@language":"es","@value":"El fenómeno a través del cual las personas bisexuales internalizan o adoptan creencias bifóbicas (es decir, percepciones negativas e intolerancia hacia las personas bisexuales y la bisexualidad) como resultado de haber sido criadas o socializadas dentro de un entorno o una cultura bifóbica."},{"@language":"nl","@value":"Het fenomeen waarbij biseksuele personen bifobe overtuigingen internaliseren of overnemen (d.w.z. negatieve percepties van en intolerantie jegens biseksuele personen en biseksualiteit) als gevolg van het feit dat ze zijn opgegroeid of gesocialiseerd in een bifobe omgeving of cultuur. ​"},{"@language":"sv","@value":"Företeelsen att bisexuella personer internaliserar eller anammar bifobiska föreställningar – det vill säga negativa uppfattningar om och intolerans mot bisexuella personer och bisexualitet – till följd av att ha vuxit upp eller socialiserats i en bifobisk miljö eller kultur."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000117"},{"@id":"https://homosaurus.org/v5/homoit0002590"}],"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0003094"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000920"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000619","dc:identifier":"homoit0000619","skos:prefLabel":[{"@language":"en","@value":"Heterosexism"},{"@language":"es","@value":"Heterosexismo"},{"@language":"de","@value":"Heterosexismus"},{"@language":"nl","@value":"Heteroseksisme"},{"@language":"sv","@value":"Heterosexism"}],"skos:altLabel":[{"@language":"en","@value":"Heterocentrism"},{"@language":"es","@value":"Heterocentrismo"},{"@language":"de","@value":"Heterozentrismus"}],"rdfs:comment":[{"@language":"en","@value":"Discrimination, prejudice, or bias against non-heterosexual people based on the assumption or belief that heterosexuality is the only normal or natural expression of sexual identity."},{"@language":"es","@value":"Discriminación, prejuicio o bias en contra de personas no heterosexuales basado en la suposición o creencia de que la heterosexualidad es la única expresión normal o natural de la identidad sexual."},{"@language":"de","@value":"Diskriminierung, Vorurteile oder Voreingenommenheit gegenüber nicht-heterosexuellen Menschen, die auf der Annahme oder Überzeugung beruhen, dass Heterosexualität die einzig normale oder natürliche Ausdrucksform der sexuellen Identität sei."},{"@language":"nl","@value":"Discriminatie, vooroordelen of vooringenomenheid jegens niet-heteroseksuele mensen op basis van de aanname of overtuiging dat heteroseksualiteit de enige normale en/of natuurlijke uitdrukking van seksuele identiteit is."},{"@language":"sv","@value":"Diskriminering, fördomar eller negativ särbehandling av personer som inte är heterosexuella, baserat på föreställningen att heterosexualitet är det enda normala eller naturliga uttrycket för sexuell identitet."}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000117"},{"@id":"https://homosaurus.org/v5/homoit0000411"},{"@id":"https://homosaurus.org/v5/homoit0000620"},{"@id":"https://homosaurus.org/v5/homoit0000631"},{"@id":"https://homosaurus.org/v5/homoit0000646"},{"@id":"https://homosaurus.org/v5/homoit0000666"},{"@id":"https://homosaurus.org/v5/homoit0000803"},{"@id":"https://homosaurus.org/v5/homoit0001229"},{"@id":"https://homosaurus.org/v5/homoit0001278"},{"@id":"https://homosaurus.org/v5/homoit0001467"},{"@id":"https://homosaurus.org/v5/homoit0003989"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh93002513"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000619"},"dc:replaces":{"@id":"http://homosaurus.org/v2/heterosexism"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000119","dc:identifier":"homoit0000119","skos:prefLabel":[{"@language":"en","@value":"Birth certificates"},{"@language":"es","@value":"Certificados de nacimiento"},{"@language":"de","@value":"Geburtsurkunde"},{"@language":"fr","@value":"Certificats de naissance"},{"@language":"nl","@value":"Geboorteakten"},{"@language":"sv","@value":"Födelseattest"}],"skos:altLabel":[{"@language":"fr","@value":"Certificats de naissance"},{"@language":"sv","@value":"Födelsebevis"}],"rdfs:comment":[{"@language":"en","@value":"Legal documents issued to record an individual’s birth, typically including identifying information such as the individual's name, assigned gender or sex, date and location of birth, and parentage."},{"@language":"es","@value":"Documentos legales expedidos para registrar el nacimiento de una persona, que suelen incluir información identificativa como el nombre de la persona, el sexo o género asignado, la fecha y el lugar de nacimiento y el parentesco."},{"@language":"de","@value":"Rechtliche Dokumente, die ausgestellt werden, um die Geburt einer Person zu dokumentieren. Sie enthalten in der Regel identifizierende Informationen wie den Namen der Person, das ihr zugewiesene Geschlecht, Datum und Ort der Geburt und die Elternschaft."},{"@language":"fr","@value":"Documents officiels qui reproduisent les principales mentions contenues dans l'acte de naissance d'une personne, soit le nom, le prénom et le sexe de l'enfant, le lieu, la date et l'heure de sa naissance, les prénoms et noms de ses parents, le numéro d'inscription au registre de l'état civil et la date de délivrance du certificat."},{"@language":"nl","@value":"Juridische documenten die zijn uitgegeven om de geboorte van een persoon vast te leggen, meestal inclusief identificerende informatie zoals de naam van de persoon, het toegewezen gender of geslacht, geboortedatum en -plaats en ouderschap."},{"@language":"sv","@value":"Juridiska dokument som utfärdas för att registrera en individs födelse, vanligtvis inkluderande identifierande information såsom namn, tilldelat kön eller könsmarkör, födelsedatum och plats samt föräldraskap. Födelseattester utfärdas inte i Sverige."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001053"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000118"},{"@id":"https://homosaurus.org/v5/homoit0000573"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000120"},{"@id":"https://homosaurus.org/v5/homoit0000247"},{"@id":"https://homosaurus.org/v5/homoit0000311"},{"@id":"https://homosaurus.org/v5/homoit0001005"},{"@id":"https://homosaurus.org/v5/homoit0001324"},{"@id":"https://homosaurus.org/v5/homoit0001465"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85014366"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000712"},"dc:replaces":{"@id":"http://homosaurus.org/v2/birthCertificates"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000918","dc:identifier":"homoit0000918","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ personal and family law"},{"@language":"es","@value":"Derecho personal y familiar LGBTQ+"},{"@language":"nl","@value":"LHBTQ+-personen-en familierecht"},{"@language":"sv","@value":"Person- och familjerätt (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"LGBTQ personal and family law"},{"@language":"es","@value":"Leyes personales y familiares LGBTQ"}],"rdfs:comment":[{"@language":"en","@value":"Legal regulations and laws addressing changes to LGBTQ people’s legal names or gender markers, as well as LGBTQ people’s family relationships, including cohabitation, marriage, adoption, parent-child relationships, divorce, and child custody."},{"@language":"es","@value":"Regulaciones legales y leyes que abordan cambios en los nombres legales o marcadores de género de las personas LGBTQ, así como en las relaciones familiares de las personas LGBTQ, incluida la cohabitación, el matrimonio, la adopción, las relaciones entre padres e hijos, el divorcio y la custodia de los hijos."},{"@language":"nl","@value":"Familierecht heeft betrekking op familierelaties, waaronder samenwonen, huwelijk, adoptie, ouder-kindrelaties, echtscheiding en voogdij over kinderen; wettelijke naam- en geslachtsmarkeringswijzigingen vallen ook binnen dit rechtsgebied"},{"@language":"sv","@value":"Rättsliga regler och lagstiftning som rör ändringar av hbtq+-personers juridiska namn eller könsmarkörer samt hbtq+-personers familjerelationer, inklusive samboförhållanden, äktenskap, adoption, relationer mellan föräldrar och barn, skilsmässa och vårdnad om barn."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000702"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000247"},{"@id":"https://homosaurus.org/v5/homoit0000992"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000118"},{"@id":"https://homosaurus.org/v5/homoit0000254"},{"@id":"https://homosaurus.org/v5/homoit0000274"},{"@id":"https://homosaurus.org/v5/homoit0000304"},{"@id":"https://homosaurus.org/v5/homoit0000360"},{"@id":"https://homosaurus.org/v5/homoit0000361"},{"@id":"https://homosaurus.org/v5/homoit0000364"},{"@id":"https://homosaurus.org/v5/homoit0000675"},{"@id":"https://homosaurus.org/v5/homoit0000809"},{"@id":"https://homosaurus.org/v5/homoit0000811"},{"@id":"https://homosaurus.org/v5/homoit0001053"},{"@id":"https://homosaurus.org/v5/homoit0001074"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000702"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQPersonalAndFamilyLaw"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000712","dc:identifier":"homoit0000712","skos:prefLabel":[{"@language":"en","@value":"Legal status"},{"@language":"de","@value":"Rechtstatus"},{"@language":"es","@value":"Estatus legal"},{"@language":"nl","@value":"Rechtspositie"},{"@language":"sv","@value":"Rättsstatus"}],"skos:altLabel":{"@language":"de","@value":"Legaler Status"},"rdfs:comment":[{"@language":"en","@value":"The status or standing of an individual or thing within a certain legal jurisdiction, including the individual's or thing's legal rights and privileges; typically used in reference to citizenship or marriage."},{"@language":"de","@value":"Der Status oder die Stellung einer Person oder Sache innerhalb eines bestimmten Rechtsraums, einschließlich der gesetzlichen Rechte und Privilegien dieser Person oder Sache; wird typischerweise im Zusammenhang mit der Staatsbürgerschaft oder der Ehe verwendet."},{"@language":"es","@value":"El estatus o la posición de una persona o cosa dentro de una determinada jurisdicción legal, incluidos los derechos y privilegios legales de la persona o cosa; normalmente se utiliza en referencia a la ciudadanía o al matrimonio."},{"@language":"nl","@value":"De status of positie van een persoon of zaak binnen een bepaald rechtsgebied, inclusief de wettelijke rechten en privileges van de persoon of zaak; vaak gebruikt in verwijzing naar staatsburgerschap of huwelijk."},{"@language":"sv","@value":"En individs eller ett objekts rättsliga status eller ställning inom en viss jurisdiktion, inklusive juridiska rättigheter och skyldigheter. Används ofta i relation till medborgarskap eller äktenskap."}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000883"},{"@id":"https://homosaurus.org/v5/homoit0001053"},{"@id":"https://homosaurus.org/v5/homoit0001074"},{"@id":"https://homosaurus.org/v5/homoit0001082"},{"@id":"https://homosaurus.org/v5/homoit0001100"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000274"},{"@id":"https://homosaurus.org/v5/homoit0000348"},{"@id":"https://homosaurus.org/v5/homoit0000702"},{"@id":"https://homosaurus.org/v5/homoit0000927"},{"@id":"https://homosaurus.org/v5/homoit0000989"},{"@id":"https://homosaurus.org/v5/homoit0001482"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh99004999"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000712"},"dc:replaces":{"@id":"http://homosaurus.org/v2/legalStatus"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001053","dc:identifier":"homoit0001053","skos:prefLabel":[{"@language":"en","@value":"Official documentation"},{"@language":"es","@value":"Documentación oficial"},{"@language":"nl","@value":"Officiële documenten"},{"@language":"sv","@value":"Officiell dokumentation"}],"rdfs:comment":[{"@language":"en","@value":"Legal documents issued by a government or institution to individuals that include identifying information and, typically, grant certain legal or governmental rights and responsibilities (e.g., driver's license, birth certificate, passport)."},{"@language":"es","@value":"Documentos legales expedidos por un gobierno o una institución a personas que incluyen información identificativa y, normalmente, conceden ciertos derechos y responsabilidades legales o gubernamentales (por ejemplo, permiso de conducir, certificado de nacimiento, pasaporte)."},{"@language":"nl","@value":"Juridische documenten uitgegeven door een overheid of instelling aan personen die identificeerbare informatie bevatten en, doorgaans, bepaalde wettelijke of overheidsrechten en verantwoordelijkheden verlenen (bijv. rijbewijs, geboorteakte, paspoort)."},{"@language":"sv","@value":"Officiella handlingar utfärdade av stat eller institution som innehåller identifikationsuppgifter och vanligtvis medför vissa juridiska eller statliga rättigheter och skyldigheter. Exempel är körkort, födelseattest och pass."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000712"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000119"},{"@id":"https://homosaurus.org/v5/homoit0000247"},{"@id":"https://homosaurus.org/v5/homoit0000275"},{"@id":"https://homosaurus.org/v5/homoit0000277"},{"@id":"https://homosaurus.org/v5/homoit0000311"},{"@id":"https://homosaurus.org/v5/homoit0000360"},{"@id":"https://homosaurus.org/v5/homoit0000377"},{"@id":"https://homosaurus.org/v5/homoit0000991"},{"@id":"https://homosaurus.org/v5/homoit0000993"},{"@id":"https://homosaurus.org/v5/homoit0001005"},{"@id":"https://homosaurus.org/v5/homoit0001092"},{"@id":"https://homosaurus.org/v5/homoit0001324"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000274"},{"@id":"https://homosaurus.org/v5/homoit0000362"},{"@id":"https://homosaurus.org/v5/homoit0000883"},{"@id":"https://homosaurus.org/v5/homoit0000918"},{"@id":"https://homosaurus.org/v5/homoit0000990"},{"@id":"https://homosaurus.org/v5/homoit0001815"},{"@id":"https://homosaurus.org/v5/homoit0001853"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000712"},"dc:replaces":{"@id":"http://homosaurus.org/v2/officialDocumentation"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000573","dc:identifier":"homoit0000573","skos:prefLabel":[{"@language":"en","@value":"Gender markers"},{"@language":"es","@value":"Indicadores de género"},{"@language":"de","@value":"Geschlechtseinträge"},{"@language":"nl","@value":"Gender-aanduidingen"},{"@language":"sv","@value":"Könsmarkörer"}],"skos:altLabel":[{"@language":"de","@value":"Geschlechtsmarker"},{"@language":"de","@value":"Geschlechtsangaben"}],"rdfs:comment":[{"@language":"en","@value":"Markers used to designate an individual's gender on official documentation, including passports, birth certificates, driver’s licenses, etc. Different jurisdictions vary significantly in the number and types of gender markers they allow on official documentation."},{"@language":"es","@value":"Marcadores utilizados para designar el género de una persona en la documentación oficial, incluidos pasaportes, certificados de nacimiento, licencias de conducir, etc. Diferentes jurisdicciones varían significativamente en la cantidad y los tipos de marcadores de género que permiten en la documentación oficial."},{"@language":"de","@value":"Kennzeichnungen, die verwendet werden, um das Geschlecht einer Person auf offiziellen Dokumenten zu bezeichnen, einschliesslich Pässen, Geburtsurkunden, Führerscheinen usw. Verschiedene Rechtsordnungen unterscheiden sich erheblich in der Anzahl und den Arten von Geschlechtseinträgen, die sie auf offiziellen Dokumenten zulassen."},{"@language":"nl","@value":"Aanduiding van het gender van een persoon op officiële documentatie, waaronder paspoorten, geboorteaktes, rijbewijzen, enz. Verschillende rechtsgebieden verschillen aanzienlijk in het aantal en de soorten gender-aanduidingen die ze toestaan op officiële documentatie."},{"@language":"sv","@value":"Markörer som används för att ange en persons kön i officiella handlingar, såsom pass, födelseattester och körkort. Olika jurisdiktioner skiljer sig avsevärt åt när det gäller antalet och typerna av könsmarkörer som tillåts i officiella handlingar."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000119"},{"@id":"https://homosaurus.org/v5/homoit0000377"},{"@id":"https://homosaurus.org/v5/homoit0001092"}],"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0002884"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000120"},{"@id":"https://homosaurus.org/v5/homoit0000311"},{"@id":"https://homosaurus.org/v5/homoit0001005"},{"@id":"https://homosaurus.org/v5/homoit0001324"},{"@id":"https://homosaurus.org/v5/homoit0001378"},{"@id":"https://homosaurus.org/v5/homoit0001465"},{"@id":"https://homosaurus.org/v5/homoit0003503"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000712"},"dc:replaces":{"@id":"http://homosaurus.org/v2/genderMarkers"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000247","dc:identifier":"homoit0000247","skos:prefLabel":[{"@language":"en","@value":"Legal name change"},{"@language":"es","@value":"Cambio de nombre legal"},{"@language":"de","@value":"Offizielle Namensänderung"},{"@language":"nl","@value":"Wettelijke naamswijziging"},{"@language":"sv","@value":"Namnbyte"}],"skos:altLabel":[{"@language":"en","@value":"Change of name"},{"@language":"es","@value":"Cambio de nombre"},{"@language":"sv","@value":"Namnändring"}],"rdfs:comment":[{"@language":"en","@value":"The process by which an individual adopts a new name on legal or government-issued documents."},{"@language":"es","@value":"El proceso mediante el cual una persona adopta un nombre nuevo en documentos legales o emitidos por el gobierno."},{"@language":"de","@value":"Das Verfahren, durch das eine Person in amtlichen oder von Behörden ausgestellten Dokumenten einen neuen Namen annimmt."},{"@language":"sv","@value":"Processen där en individ byter namn i juridiska eller statliga dokument."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000918"},{"@id":"https://homosaurus.org/v5/homoit0001053"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000119"},{"@id":"https://homosaurus.org/v5/homoit0000377"},{"@id":"https://homosaurus.org/v5/homoit0000990"},{"@id":"https://homosaurus.org/v5/homoit0001092"},{"@id":"https://homosaurus.org/v5/homoit0001324"},{"@id":"https://homosaurus.org/v5/homoit0003503"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000702"},"dc:replaces":{"@id":"http://homosaurus.org/v2/legalNameChange"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000311","dc:identifier":"homoit0000311","skos:prefLabel":[{"@language":"en","@value":"Court orders"},{"@language":"es","@value":"Órdenes de la corte"},{"@language":"de","@value":"Gerichtsbeschluss"},{"@language":"nl","@value":"Gerechtelijke uitspraken"},{"@language":"sv","@value":"Domstolsbeslut"}],"skos:altLabel":[{"@language":"es","@value":"Orden judicial"},{"@language":"es","@value":"Mandato judicial"},{"@language":"de","@value":"Gerichtliche Anordnung"}],"rdfs:comment":[{"@language":"en","@value":"Proclamations by a judge or panel of judges requiring or authorizing specific actions (e.g., court orders approving or denying requests for name or gender marker changes)."},{"@language":"es","@value":"Proclamaciones de un juez o de un panel de jueces que requieren o autorizan acciones específicas (por ejemplo, órdenes judiciales que aprueban o deniegan solicitudes de cambios de nombre o marcador de género)."},{"@language":"de","@value":"Richterliche Erklärungen, die bestimmte Maßnahmen vorschreiben oder genehmigen (z.B. Gerichtsbeschlüsse zur Genehmigung oder Ablehnung von Anträgen auf Änderung des Namens oder des Geschlechtsmerkmals)."},{"@language":"nl","@value":"Uitspraken door een rechter of een panel van rechters die specifieke acties van partijen in een rechtszaak vereisen of autoriseren (bijv. gerechtelijke bevelen die verzoeken om naam- of geslachtsmarkeringswijzigingen goedkeuren of afwijzen)"},{"@language":"sv","@value":"Domstolsbeslut där en domare eller en grupp domare kräver eller godkänner specifika åtgärder (t.ex. beslut som beviljar eller avslår ansökningar om namn- eller könsmarkörsändringar)."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000702"},{"@id":"https://homosaurus.org/v5/homoit0001053"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000119"},{"@id":"https://homosaurus.org/v5/homoit0000377"},{"@id":"https://homosaurus.org/v5/homoit0000573"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000702"},"dc:replaces":{"@id":"http://homosaurus.org/v2/courtOrders"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001005","dc:identifier":"homoit0001005","skos:prefLabel":[{"@language":"en","@value":"Medical practitioners' statements"},{"@language":"es","@value":"Declaraciones de los médicos"},{"@language":"nl","@value":"Medische verklaringen"},{"@language":"sv","@value":"Läkarutlåtanden (könsidentitet)"}],"rdfs:comment":[{"@language":"en","@value":"Official documents from medical practitioners (e.g., doctors, nurses, therapists) diagnosing a patient's gender dysphoria and, typically, recommending gender-affirming healthcare; sometimes required for an individual's gender-affirming healthcare to be covered under insurance or for an individual to legally change their name or gender marker."},{"@language":"es","@value":"Documentos oficiales de profesionales médicos (por ejemplo, doctores, enfermeras, terapeutas) que diagnostican la disforia de género de un paciente y, por lo general, recomiendan atención médica de afirmación de género; a veces es requerido para que el seguro cubra la atención médica de afirmación de género de una persona o para que una persona cambie legalmente su nombre o marcador de género."},{"@language":"nl","@value":"Officiële documenten van artsen (bijv. artsen, verpleegkundigen, therapeuten) die genderdysforie diagnosticeren en, doorgaans, genderbevestigende gezondheidszorg aanbevelen; soms vereist om de genderbevestigende gezondheidszorg van een persoon door een verzekering te dekken, of voor een persoon om zijn naam of gender wettelijk te wijzigen."},{"@language":"sv","@value":"Officiella intyg från vårdgivare (t.ex. läkare, sjuksköterskor, terapeuter) som diagnostiserar könsdysfori och vanligtvis rekommenderar könsbekräftande vård. Sådana intyg krävs ibland för att vård ska täckas av sjukförsäkringar eller för att en person ska kunna ändra namn eller juridiskt kön."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001053"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000119"},{"@id":"https://homosaurus.org/v5/homoit0000377"},{"@id":"https://homosaurus.org/v5/homoit0000573"},{"@id":"https://homosaurus.org/v5/homoit0001004"},{"@id":"https://homosaurus.org/v5/homoit0001465"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000712"},"dc:replaces":{"@id":"http://homosaurus.org/v2/medicalPractitionersStatements"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001324","dc:identifier":"homoit0001324","skos:prefLabel":[{"@language":"en","@value":"Social security cards"},{"@language":"es","@value":"Tarjetas de seguro social"},{"@language":"nl","@value":"Basisregistratie personen"},{"@language":"sv","@value":"Id-kort"}],"skos:altLabel":[{"@language":"sv","@value":"Identitetshandlingar"},{"@language":"sv","@value":"Identitetskort"},{"@language":"sv","@value":"Legitimationer"},{"@language":"sv","@value":"Id:n"}],"rdfs:comment":[{"@language":"en","@value":"Official documents issued by governments that ascribe unique numeral identifiers to citizens to track their income and determine retirement benefits. "},{"@language":"es","@value":"Documentos oficiales emitidos por gobiernos que atribuyen identificadores numéricos únicos a los ciudadanos para realizar un seguimiento de sus ingresos y determinar los beneficios de jubilación."},{"@language":"nl","@value":"Registratie door overheden met persoonsgegevens van burgers. Iedereen die zich laat inschrijven in de Basisregistratie Personen (BRP) krijgt een burgerservicenummer (BSN), een uniek persoonsgebonden nummer, dat onder andere gebruikt wordt om het inkomen en pensioen van iemand te bepalen en voor belastingdoeleinden"},{"@language":"sv","@value":"Officiella dokument som utfärdas av statliga myndigheter och innehåller unika identifikationsnummer."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001053"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000119"},{"@id":"https://homosaurus.org/v5/homoit0000247"},{"@id":"https://homosaurus.org/v5/homoit0000377"},{"@id":"https://homosaurus.org/v5/homoit0000573"},{"@id":"https://homosaurus.org/v5/homoit0001465"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000712"},"dc:replaces":{"@id":"http://homosaurus.org/v2/socialSecurityCards"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000271","dc:identifier":"homoit0000271","skos:prefLabel":[{"@language":"en","@value":"Cisgender people"},{"@language":"de","@value":"Cis Personen"},{"@language":"es","@value":"Personas cisgénero"},{"@language":"fr","@value":"Personnes cisgenres"},{"@language":"nl","@value":"Cisgender personen"},{"@language":"sv","@value":"Cispersoner"}],"skos:altLabel":[{"@language":"en","@value":"Cis people"},{"@language":"es","@value":"Personas cis"},{"@language":"es","@value":"Cis"}],"rdfs:comment":[{"@language":"en","@value":"Individuals whose gender identity matches the gender or sex they were assigned at birth."},{"@language":"de","@value":"Personen, deren Geschlechtsidentität mit dem Geschlecht übereinstimmt, das ihnen bei der Geburt zugewiesen wurde."},{"@language":"es","@value":"Personas cuya identidad de género coincide con el género o sexo que les fue asignado al nacer."},{"@language":"fr","@value":"Personnes dont l'identité de genre correspond au genre ou au sexe qui leur a été assigné à la naissance."},{"@language":"nl","@value":"Personen wiens genderidentiteit overeenkomt met het gender of geslacht dat hen bij de geboorte is toegewezen."},{"@language":"sv","@value":"Individer vars könsidentitet överensstämmer med det kön de tilldelades vid födseln."}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000270"},{"@id":"https://homosaurus.org/v5/homoit0000272"},{"@id":"https://homosaurus.org/v5/homoit0002281"},{"@id":"https://homosaurus.org/v5/homoit0002282"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000120"},{"@id":"https://homosaurus.org/v5/homoit0000273"},{"@id":"https://homosaurus.org/v5/homoit0000322"},{"@id":"https://homosaurus.org/v5/homoit0000571"},{"@id":"https://homosaurus.org/v5/homoit0001008"},{"@id":"https://homosaurus.org/v5/homoit0001378"},{"@id":"https://homosaurus.org/v5/homoit0001509"},{"@id":"https://homosaurus.org/v5/homoit0001652"},{"@id":"https://homosaurus.org/v5/homoit0001653"},{"@id":"https://homosaurus.org/v5/homoit0001925"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2016000684"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000271"},"dc:replaces":{"@id":"http://homosaurus.org/v2/cisgenderPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000567","dc:identifier":"homoit0000567","skos:prefLabel":[{"@language":"en","@value":"Gender dysphoria"},{"@language":"es","@value":"Disforia de género"},{"@language":"de","@value":"Geschlechtsdysphorie"},{"@language":"nl","@value":"Genderdysforie"},{"@language":"sv","@value":"Könsdysfori"}],"skos:altLabel":[{"@language":"de","@value":"Gender-Dysphorie"},{"@language":"de","@value":"Geschlechts-Dysphorie"}],"rdfs:comment":[{"@language":"en","@value":"A psychological diagnosis (replacing the outdated and offensive \"gender identity disorder\") used to describe the sense of unease or dissatisfaction an individual feels as a result of incongruence between their gender identity and their assigned gender, gender expression, and/or the way their gender is perceived by others. This term is also used colloquially by individuals to describe the discomfort and distress they experience as a result of this incongruence. Though gender dysphoria is often associated with trans people, people of any identity may experience gender dysphoria when they do not feel \"right\" in their body or the way their gender is being expressed."},{"@language":"es","@value":"Un diagnóstico psicológico (que reemplaza al término anticuado y ofensivo de \"trastorno de identidad de género\") utilizado para describir la sensación de malestar o insatisfacción que siente una persona como resultado de la incongruencia entre su identidad de género y su género asignado, su expresión de género y/o la forma en que su género es percibido por otras personas. Este término también se utiliza coloquialmente por personas para describir el malestar y la angustia que experimentan como resultado de esta incongruencia. Aunque la disforia de género a menudo se asocia con las personas trans, las personas de cualquier identidad pueden experimentar disforia de género cuando no se sienten \"bien\" con su cuerpo o con la forma en que se expresan su género."},{"@language":"de","@value":"Eine psychologische Diagnose (die den veralteten und beleidigenden Begriff „Geschlechtsidentitätsstörung” ersetzt), die verwendet wird, um das Gefühl des Unbehagens oder der Unzufriedenheit zu beschreiben, das eine Person aufgrund der Diskrepanz zwischen ihrer Geschlechtsidentität und ihrem zugewiesenen Geschlecht, ihrem Geschlechtsausdruck und/oder der Art und Weise, wie ihr Geschlecht von anderen wahrgenommen wird, empfindet. Dieser Begriff wird auch umgangssprachlich von Personen verwendet, um das Unbehagen und die Belastung zu beschreiben, die sie aufgrund dieser Diskrepanz empfinden. Obwohl Geschlechtsdysphorie oft mit trans Personen in Verbindung gebracht wird, können Menschen jeder Identität Geschlechtsdysphorie empfinden, wenn sie sich in ihrem Körper oder in der Art und Weise, wie ihr Geschlecht ausgedrückt wird, nicht „richtig“ fühlen."},{"@language":"nl","@value":"Een psychologische diagnose (ter vervanging van de verouderde en aanstootgevende term 'genderidentiteitsstoornis') die wordt gebruikt om het gevoel van onbehagen of ontevredenheid te beschrijven dat een individu voelt als gevolg van incongruentie tussen zijn genderidentiteit en het toegewezen gender, genderexpressie en/of de manier waarop zijn gender wordt waargenomen door anderen. Deze term wordt ook in de volksmond door individuen gebruikt om het ongemak en leed te beschrijven dat ze ervaren als gevolg van deze incongruentie. Hoewel genderdysforie vaak wordt geassocieerd met transgender personen, kunnen mensen van welke identiteit dan ook genderdysforie ervaren wanneer ze zich niet \"goed\" voelen in hun lichaam of de manier waarop hun gender wordt uitgedrukt."},{"@language":"sv","@value":"En psykologisk diagnos (som ersätter den föråldrade och stigmatiserande ”könsidentitetsstörning”) som beskriver den obehagskänsla eller otillfredsställelse en individ upplever på grund av att könsidentiteten inte stämmer överens med det tilldelade könet, könsuttrycket och/eller hur omgivningen uppfattar könet. Termen används också informellt av personer för att beskriva det obehag och den stress som uppstår i detta glapp. Även om könsdysfori ofta kopplas till transpersoner, kan personer med olika könsidentiteter uppleva könsdysfori om de inte känner att kroppen eller könsuttrycket stämmer överens med deras identitet."}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0002699"},{"@id":"https://homosaurus.org/v5/homoit0002700"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000120"},{"@id":"https://homosaurus.org/v5/homoit0000567"},{"@id":"https://homosaurus.org/v5/homoit0000568"},{"@id":"https://homosaurus.org/v5/homoit0000571"},{"@id":"https://homosaurus.org/v5/homoit0000572"},{"@id":"https://homosaurus.org/v5/homoit0001006"},{"@id":"https://homosaurus.org/v5/homoit0002256"},{"@id":"https://homosaurus.org/v5/homoit0003910"},{"@id":"https://homosaurus.org/v5/homoit0003984"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000567"},"dc:replaces":{"@id":"http://homosaurus.org/v2/genderDysphoria"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002256","dc:identifier":"homoit0002256","skos:prefLabel":[{"@language":"en","@value":"Gender euphoria"},{"@language":"es","@value":"Euforia de género"},{"@language":"de","@value":"Geschlechtseuphorie"},{"@language":"nl","@value":"Gender euforie"},{"@language":"sv","@value":"Könseufori"}],"skos:altLabel":[{"@language":"de","@value":"Gender-Euphorie"},{"@language":"de","@value":"Geschlechts-Euphorie"}],"rdfs:comment":[{"@language":"en","@value":"The powerful feeling of joy and comfort an individual experiences when their assigned gender, gender expression, and/or the way their gender is perceived by themselves and others aligns with their gender identity. Though gender euphoria is often associated with trans people, people of any identity may experience gender euphoria when they feel that their gender has been seen and affirmed, or when they feel \"right\" in their body and the way their gender is being expressed."},{"@language":"es","@value":"El poderoso sentimiento de alegría y consuelo que una persona experimenta cuando su género asignado, su expresión de género y/o la forma en que la propia persona y las demás personas perciben su género se alinea con su identidad de género. Aunque la euforia de género a menudo se asocia con las personas trans, las personas de cualquier identidad pueden experimentar euforia de género cuando sienten que su género ha sido visto y afirmado, o cuando se sienten \"bien\" con su cuerpo y la forma en que se expresa su género."},{"@language":"de","@value":"Das starke Gefühl der Freude und des Wohlbefindens, das eine Person empfindet, wenn ihr zugewiesenes Geschlecht, ihr Geschlechtsausdruck und/oder die Art und Weise, wie ihr Geschlecht von ihr selbst und anderen wahrgenommen wird, mit ihrer Geschlechtsidentität übereinstimmen. Obwohl Geschlechtseuphorie oft mit trans Personen in Verbindung gebracht wird, können Personen jeder Identität Geschlechtseuphorie empfinden, wenn sie das Gefühl haben, dass ihr Geschlecht gesehen und bestätigt wird, oder wenn sie sich in ihrem Körper und in der Art und Weise, wie ihr Geschlecht zum Ausdruck kommt, „richtig“ fühlen."},{"@language":"nl","@value":"Het krachtige gevoel van vreugde en troost dat een persoon ervaart wanneer hun toegewezen gender, genderexpressie en/of de manier waarop hun gender door henzelf en anderen wordt waargenomen, overeenkomt met hun genderidentiteit. Hoewel gendereuforie vaak wordt geassocieerd met transgender personen, kunnen personen van welke identiteit dan ook gendereuforie ervaren wanneer ze het gevoel hebben dat hun gender wordt gezien en bevestigd, of wanneer ze zich \"goed\" voelen in hun lichaam en de manier waarop hun gender tot uiting komt."},{"@language":"sv","@value":"Den starka känslan av glädje och trygghet en individ upplever när det tilldelade könet, könsuttrycket och/eller hur könet uppfattas av personen själv och andra överensstämmer med könsidentiteten. Även om könseufori ofta förknippas med transpersoner, kan personer med vilken könsidentitet som helst uppleva könseufori när de känner sig sedda och bekräftade i sin könsidentitet, eller när kroppen och könsuttrycket upplevs som ”rätt”."}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000120"},{"@id":"https://homosaurus.org/v5/homoit0000567"},{"@id":"https://homosaurus.org/v5/homoit0000568"},{"@id":"https://homosaurus.org/v5/homoit0000571"},{"@id":"https://homosaurus.org/v5/homoit0002699"},{"@id":"https://homosaurus.org/v5/homoit0002700"},{"@id":"https://homosaurus.org/v5/homoit0003193"},{"@id":"https://homosaurus.org/v5/homoit0003708"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0002256"},"dc:issued":{"@type":"xsd:date","@value":"2022-09-09"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000821","dc:identifier":"homoit0000821","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ birth parents"},{"@language":"es","@value":"Madres y padres biológicos LGBTQ+"},{"@language":"ja","@value":"LGBTQ+の実親"},{"@language":"nl","@value":"LHBTQ+-geboorteouders"},{"@language":"sv","@value":"Förstaföräldrar (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"LGBTQ birth parents"},{"@language":"es","@value":"Padres biológicos LGBTQ+"},{"@language":"es","@value":"Madres biológicos LGBTQ+"},{"@language":"ja","@value":"LGBTQの実親"},{"@language":"sv","@value":"Bioföräldrar (hbtq+)"}],"rdfs:comment":[{"@language":"en","@value":"In an adoption context, biological or genetic parents who are LGBTQ+ people."},{"@language":"es","@value":"Padres y/o madres biológicos o genéticos de un niño o niños dados en adopción."},{"@language":"ja","@value":"養子縁組の文脈において、LGBTQ+である実の親または遺伝的な親。"},{"@language":"nl","@value":"In een adoptiecontext, biologische of genetische ouders die LHBTQ+-personen zijn."},{"@language":"sv","@value":"Hbtq+-personer som är biologiska eller genetiska föräldrar till ett barn eller flera barn som har placerats för adoption."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000121"},{"@id":"https://homosaurus.org/v5/homoit0000809"},{"@id":"https://homosaurus.org/v5/homoit0001075"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000420"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQBirthParents"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000147","dc:identifier":"homoit0000147","skos:prefLabel":[{"@language":"en-us","@value":"Bisexual information centers"},{"@language":"de","@value":"Bisexuelle Informationszentren"},{"@language":"es","@value":"Centros de información bisexual"},{"@language":"nl","@value":"Biseksuele informatiecentra"},{"@language":"sv","@value":"Bisexuella informationscentrum"},{"@language":"en-gb","@value":"Bisexual information centres"}],"skos:altLabel":[{"@language":"de","@value":"Informationszentren für Bisexuelle"},{"@language":"de","@value":"Anlaufstellen für Bisexuelle"},{"@language":"de","@value":"Bi-Infocenter"},{"@language":"de","@value":"Informationszentren für Bisexualität"},{"@language":"de","@value":"Anlaufstellen für Bisexualität"},{"@language":"de","@value":"Infocenter für Bisexualität"},{"@language":"sv","@value":"Informationscentrum för bisexuella"}],"rdfs:comment":[{"@language":"en","@value":"Institutions providing education, support, and information about bisexuality and bisexual communities to bisexual people."},{"@language":"de","@value":"Einrichtungen, die bisexuellen Menschen Bildung, Unterstützung und Informationen über bisexuelle Themen und bisexuelle Gemeinschaften bieten."},{"@language":"es","@value":"Instituciones que brindan educación, apoyo e información sobre la bisexualidad y comunidades bisexuales a personas bisexuales."},{"@language":"nl","@value":"Instellingen die voorlichting, ondersteuning en informatie verstrekken over biseksualiteit en biseksuele gemeenschappen aan biseksuele mensen"},{"@language":"sv","@value":"Institutioner som tillhandahåller utbildning, stöd och information om bisexualitet och bisexuella gemenskaper för bisexuella personer."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000660"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000122"},{"@id":"https://homosaurus.org/v5/homoit0000162"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000830"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualInformationCentres"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000162","dc:identifier":"homoit0000162","skos:prefLabel":[{"@language":"en","@value":"Bisexual movement"},{"@language":"de","@value":"Bisexuelle Bewegung"},{"@language":"es","@value":"Movimiento bisexual"},{"@language":"nl","@value":"Bi-beweging"},{"@language":"sv","@value":"Bisexuella rörelser"}],"skos:altLabel":[{"@language":"de","@value":"Bi-Bewegung"},{"@language":"de","@value":"Bisexualitätsbewegung"}],"rdfs:comment":[{"@language":"en","@value":"Umbrella term for activism focused on the rights of bisexual people and issues faced by bisexual communities."},{"@language":"de","@value":"Sammelbegriff für Aktivismus, der sich auf die Rechte bisexueller Menschen und die Probleme bisexueller Gemeinschaften konzentriert."},{"@language":"es","@value":"Término general para el activismo centrado en los derechos de las personas bisexuales y los problemas que enfrentan las comunidades bisexuales."},{"@language":"nl","@value":"Overkoepelende term voor activisme gericht op de rechten van biseksuele problemen en zaken waarmee biseksuele gemeenschappen worden geconfronteerd"},{"@language":"sv","@value":"Samlingsterm för aktivism med fokus på bisexuella personers rättigheter och de frågor som påverkar bisexuellas gemenskaper."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001026"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000122"},{"@id":"https://homosaurus.org/v5/homoit0000147"},{"@id":"https://homosaurus.org/v5/homoit0000177"},{"@id":"https://homosaurus.org/v5/homoit0003936"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001322"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualMovement"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000183","dc:identifier":"homoit0000183","skos:prefLabel":[{"@language":"en","@value":"Bisexual rights"},{"@language":"de","@value":"Bisexuelle Rechte"},{"@language":"es","@value":"Derechos bisexuales"},{"@language":"nl","@value":"Biseksuele rechten"},{"@language":"sv","@value":"Bisexuella rättigheter"}],"rdfs:comment":[{"@language":"en","@value":"Legal, social, or ethical principles of freedom or entitlement held by bisexual people."},{"@language":"de","@value":"Rechtliche, soziale oder ethische Prinzipien der Freiheit oder des Anspruchs, die von bisexuellen Personen vertreten werden."},{"@language":"es","@value":"Principios legales, sociales o éticos de libertad o derecho que tienen las personas bisexuales."},{"@language":"nl","@value":"Wettelijke, sociale of ethische principes van vrijheid of rechten van biseksuele personen"},{"@language":"sv","@value":"Juridiska, sociala eller etiska principer om frihet eller rättigheter för bisexuella personer."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000276"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000122"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000652"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualRights"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000135","dc:identifier":"homoit0000135","skos:prefLabel":[{"@language":"en","@value":"Black bisexual people"},{"@language":"es","@value":"Personas bisexuales negras"},{"@language":"de","@value":"Schwarze bisexuelle Personen"},{"@language":"nl","@value":"Zwarte biseksuele personen"},{"@language":"sv","@value":"Svarta bisexuella personer"}],"skos:altLabel":[{"@language":"en","@value":"Bisexual Black people"},{"@language":"es","@value":"Personas negras bisexuales"},{"@language":"de","@value":"Bisexuelle schwarze Personen"},{"@language":"nl","@value":"Zwarte biseksuelen"}],"rdfs:comment":[{"@language":"en","@value":"Black people who are bisexual. Use only for individuals who self-identity as Black. Follow the individual’s preference for African American or Black whenever possible."},{"@language":"es","@value":"Personas negras que son bisexuales. Utilícese únicamente para personas que se autoidentifiquen como negras. Siga la preferencia de la persona sobre el uso de \"afroamericanos\" o \"negros\" siempre que sea posible."},{"@language":"de","@value":"Schwarze Menschen, die bisexuell sind. Nur für Personen verwenden, die sich selbst als schwarz identifizieren. Nach Möglichkeit der Präferenz der Person für „Afroamerikaner” oder „schwarz” folgen."},{"@language":"nl","@value":"Zwarte mensen die biseksueel zijn. Alleen gebruiken voor personen die zichzelf als zwart identificeren. Volg waar mogelijk de voorkeur van de persoon voor een Afrikaanse diaspora-identiteit of een zwarte identiteit."},{"@language":"sv","@value":"Svarta personer som är bisexuella. Används endast för individer som själva identifierar sig som svarta. Följ individens preferens för att använda svart eller diasporaidentitet som t.ex. afroeuropé när det är möjligt."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000208"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000123"},{"@id":"https://homosaurus.org/v5/homoit0000124"},{"@id":"https://homosaurus.org/v5/homoit0000125"},{"@id":"https://homosaurus.org/v5/homoit0000126"},{"@id":"https://homosaurus.org/v5/homoit0000127"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualBlackPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000136","dc:identifier":"homoit0000136","skos:prefLabel":[{"@language":"en","@value":"Bisexual bookshops"},{"@language":"de","@value":"Bisexuelle Buchhandlungen"},{"@language":"es","@value":"Librerías bisexuales"},{"@language":"nl","@value":"Biseksuele boekhandels"},{"@language":"sv","@value":"Bisexuella bokaffärer"}],"skos:altLabel":{"@language":"es","@value":"Tiendas de libros bisexuales"},"rdfs:comment":[{"@language":"en","@value":"Bookshops that sell materials intended for use by bisexual people or addressing topics related to bisexuality."},{"@language":"de","@value":"Buchhandlungen, die Materialien verkaufen, die für bisexuelle Personen bestimmt sind oder sich mit Themen befassen, die mit bisexuellen Erfahrungen zusammenhängen."},{"@language":"es","@value":"Librerías que venden materiales destinados a personas bisexuales o que abordan temas relacionados con la bisexualidad."},{"@language":"nl","@value":"Boekhandels die materialen verkopen die bedoeld zijn voor gebruik door biseksuele mensen of die onderwerpen behandelen die verband houden met biseksualiteit."},{"@language":"sv","@value":"Bokhandlar som säljer material riktat till bisexuella personer eller som behandlar ämnen relaterade till bisexualitet."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000216"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000170"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000216"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualBookshops"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000216","dc:identifier":"homoit0000216","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ bookshops"},{"@language":"es","@value":"Librerías LGBTQ+"},{"@language":"ja","@value":"LGBTQ+関連の書店"},{"@language":"nl","@value":"LHBTQ+-boekhandels"},{"@language":"sv","@value":"Hbtq+-bokaffärer"}],"skos:altLabel":[{"@language":"en","@value":"Bookstores (LGBTQ)"},{"@language":"en","@value":"Bookshops (LGBTQ)"},{"@language":"es","@value":"Liberías LGBTQ"},{"@language":"es","@value":"Tiendas de libros LGBTQ+"},{"@language":"es","@value":"Tiendas de libros LGBTQ"},{"@language":"ja","@value":"書店 (LGBTQ)"},{"@language":"nl","@value":"Boekwinkels (LHBTQ)"},{"@language":"sv","@value":"Hbtq+-bokhandlar"},{"@language":"sv","@value":"Bokhandlar (hbtq+)"},{"@language":"sv","@value":"Bokaffärer (hbtq+)"},{"@language":"sv","@value":"Boklådor (hbtq+)"}],"rdfs:comment":[{"@language":"en","@value":"Bookshops that sell materials intended for use by LGBTQ+ people or addressing LGBTQ+ topics."},{"@language":"es","@value":"Librerías que venden materiales destinados a personas LGBTQ+ o que abordan temas LGBTQ+."},{"@language":"ja","@value":"LGBTQ+の方を対象とした、あるいはLGBTQ+に関するテーマを取り扱った書籍や資料を販売する書店。"},{"@language":"nl","@value":"Boekhandels die materialen verkopen voor LHBTQ+-ers of die LHBTQ+-onderwerpen behandelen"},{"@language":"sv","@value":"Bokhandlar som säljer material riktat till hbtq+-personer eller som behandlar ämnen relaterade till hbtq+."}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000136"},{"@id":"https://homosaurus.org/v5/homoit0000478"},{"@id":"https://homosaurus.org/v5/homoit0000727"},{"@id":"https://homosaurus.org/v5/homoit0001164"},{"@id":"https://homosaurus.org/v5/homoit0001397"},{"@id":"https://homosaurus.org/v5/homoit0001511"},{"@id":"https://homosaurus.org/v5/homoit0002763"},{"@id":"https://homosaurus.org/v5/homoit0002966"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000827"},{"@id":"https://homosaurus.org/v5/homoit0001132"},{"@id":"https://homosaurus.org/v5/homoit0002681"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000216"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bookshopsLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000137","dc:identifier":"homoit0000137","skos:prefLabel":[{"@language":"en","@value":"Bisexual boys"},{"@language":"de","@value":"Bisexuelle Jungen"},{"@language":"es","@value":"Niños bisexuales"},{"@language":"nl","@value":"Biseksuele jongens"},{"@language":"sv","@value":"Bisexuella pojkar"}],"skos:altLabel":{"@language":"de","@value":"Bisexuelle Jungs"},"rdfs:comment":[{"@language":"en","@value":"Boys (typically children younger than 18) who are bisexual."},{"@language":"de","@value":"Jungen (in der Regel unter 18 Jahre), die bisexuell sind."},{"@language":"es","@value":"Niños menores de 18 años que se autoidentifican como bisexuales."},{"@language":"nl","@value":"Jongens (meestal kinderen jonger dan 18 jaar) die biseksueel zijn"},{"@language":"sv","@value":"Pojkar (vanligtvis barn eller unga under 18 år) som är bisexuella."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000140"