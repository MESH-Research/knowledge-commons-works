","@value":"LHBTQ+-personen die dansen, professioneel of als hobby."},{"@language":"sv","@value":"Hbtq+-personer som dansar, professionellt eller som hobby."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000915"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0003947"},{"@id":"https://homosaurus.org/v5/homoit0003948"},{"@id":"https://homosaurus.org/v5/homoit0003949"},{"@id":"https://homosaurus.org/v5/homoit0003950"},{"@id":"https://homosaurus.org/v5/homoit0003951"},{"@id":"https://homosaurus.org/v5/homoit0003952"},{"@id":"https://homosaurus.org/v5/homoit0003953"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0003954"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2025-04-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003965","dc:identifier":"homoit0003965","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ fashion designers"},{"@language":"ja","@value":"LGBTQ+のファッションデザイナー"},{"@language":"nl","@value":"LHBTQ+-modeontwerpers"},{"@language":"sv","@value":"Modedesigners (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"Fashion designers (LGBTQ)"},{"@language":"en","@value":"LGBTQ+ clothes designers"},{"@language":"en","@value":"LGBTQ+ clothing designers"},{"@language":"ja","@value":"ファッションデザイナー (LGBTQ)"},{"@language":"ja","@value":"LGBTQ+の衣服デザイナー"},{"@language":"ja","@value":"LGBTQ+の服飾デザイナー"},{"@language":"nl","@value":"Modeontwerpers (LHBTQ+)"}],"rdfs:comment":[{"@language":"en","@value":"LGBTQ+ people who design and create original clothing, accessories, and footwear."},{"@language":"ja","@value":"オリジナルの服、アクセサリー、靴をデザイン・制作するLGBTQ+の人々。"},{"@language":"nl","@value":"LHBTQ+-personen die originele kleding, accessoires en schoenen ontwerpen en creëren."},{"@language":"sv","@value":"Hbtq+-personer som desig