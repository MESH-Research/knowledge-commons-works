-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001032","dc:identifier":"homoit0001032","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ Muslims"},{"@language":"es","@value":"Musulmanes LGBTQ+"},{"@language":"ja","@value":"LGBTQ+のイスラム教徒"},{"@language":"de","@value":":GBTQ+-Muslim:innen"},{"@language":"nl","@value":"LHBTQ+-moslims"},{"@language":"sv","@value":"Muslimer (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"Muslims (LGBTQ)"},{"@language":"es","@value":"Musulmanes (LGBTQ)"},{"@language":"ja","@value":"イスラム教徒（LGBTQ）"}],"rdfs:comment":[{"@language":"en","@value":"LGBTQ+ people who are Muslim."},{"@language":"es","@value":"Personas LGBTQ+ que son musulmanas."},{"@language":"ja","@value":"イスラム教徒のLGBTQ+の人々。"},{"@language":"de","@value":"LGBTQ+-Personen, die muslimischen Glaubens sind."},{"@language":"nl","@value":"LHBTQ+-personen die moslim zijn."},{"@language":"sv","@value":"Hbtq+-personer som är muslimer."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000928"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000164"},{"@id":"https://homosaurus.org/v5/homoit0000512"},{"@id":"https://homosaurus.org/v5/homoit0000756"},{"@id":"https://homosaurus.org/v5/homoit0001189"},{"@id":"https://homosaurus.org/v5/homoit0001425"},{"@id":"https://homosaurus.org/v5/homoit0002976"},{"@id":"https://homosaurus.org/v5/homoit0002982"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000928"},"dc:replaces":{"@id":"http://homosaurus.org/v2/muslimsLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000165","dc:identifier":"homoit0000165","skos:prefLabel":[{"@language":"en","@value":"Native American bisexual people"},{"@language":"es","@value":"Personas bisexuales nativoamericanas"},{"@language":"nl","@value":"Indiaans-Amerikaanse biseksuele personen"},{"@language":"sv","@value":"Bisexuella ursprungsamerikaner"}],"skos:altLabel":[{"@language":"en","@value":"American Indian bisexual people"},{"@language":"en","@value":"Bisexual American Indians"},{"@language":"en","@value":"Bisexual Native Americans"},{"@language":"es","@value":"Personas nativoamericanas bisexuales"}],"rdfs:comment":[{"@language":"en","@value":"People who are part of the Native peoples of the continental United States and Canada (excluding Inuit people) and self-identity as bisexual. Use more specific terms when available."},{"@language":"es","@value":"Personas bisexuales que son nativoamericanas o parte de los pueblos indígenas de Norteamérica; utilícese únicamente para personas que se autoidentifiquen como nativoamericanas y bisexuales."},{"@language":"nl","@value":"Biseksuele personen die Native American zijn, of deel uitmaken van de inheemse volkeren van Noord-Amerika; alleen gebruiken voor personen die zichzelf identificeren als Native American en biseksueel."},{"@language":"sv","@value":"Personer som tillhör ursprungsfolken i det kontinentala USA och Kanada (exklusive inuiter) och som identifierar sig som bisexuella. Använd mer specifika termer där det är möjligt."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001037"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualNativeAmericans"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000166","dc:identifier":"homoit0000166","skos:prefLabel":[{"@language":"en","@value":"Bisexual newsletters"},{"@language":"de","@value":"Bisexuelle Newsletter"},{"@language":"es","@value":"Boletines bisexuales"},{"@language":"nl","@value":"Biseksuele nieuwsbrieven"},{"@language":"sv","@value":"Bisexuella nyhetsbrev"}],"rdfs:comment":[{"@language":"en","@value":"Serialized print or digital periodicals created by or for bisexual people, often with the purpose of sharing news and information related to bisexual communities and bisexual issues."},{"@language":"de","@value":"Regelmässig erscheinende gedruckte oder digitale Publikationen, die von oder für bisexuelle Menschen erstellt werden, oft mit dem Ziel, Nachrichten und Informationen über bisexuelle Gemeinschaften und bisexuelle Themen zu verbreiten."},{"@language":"es","@value":"Publicaciones impresas o digitales serializadas creadas por o para personas bisexuales, a menudo con el propósito de compartir noticias e información relacionada con comunidades bisexuales y temas bisexuales."},{"@language":"nl","@value":"Periodieke gedrukte of digitale tijdschriften gemaakt door of voor biseksuele mensen, vaak met als doel het delen van nieuws en informatie met betrekking tot biseksuele gemeenschappen en biseksuele kwesties"},{"@language":"sv","@value":"Seriella tryckta eller digitala tidskrifter skapade av eller för bisexuella personer, ofta i syfte att dela nyheter och information relaterad till bisexuella gemenskaper och bisexuella frågor."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000177"},{"@id":"https://homosaurus.org/v5/homoit0001041"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000167"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001132"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualNewsletters"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001041","dc:identifier":"homoit0001041","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ newsletters"},{"@language":"es","@value":"Boletines LGBTQ+"},{"@language":"nl","@value":"LHBTQ+-nieuwsbrieven"},{"@language":"sv","@value":"Nyhetsbrev (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"Newsletters (LGBTQ)"},{"@language":"es","@value":"Boletines (LGBTQ)"}],"rdfs:comment":[{"@language":"en","@value":"Print or digital periodicals created by or for LGBTQ+ people, often with the purpose of sharing community news and information about related issues."},{"@language":"es","@value":"Publicaciones periódicas impresas o digitales creadas por o para personas LGBTQ+, a menudo con el propósito de compartir noticias e información de la comunidad sobre temas relacionados."},{"@language":"nl","@value":"Gedrukte of digitale tijdschriften gemaakt door of voor LHBTQ+-personen, vaak met het doel om gemeenschapsnieuws en informatie over gerelateerde zaken te delen."},{"@language":"sv","@value":"Seriella tryckta eller digitala tidskrifter skapade av eller för hbtq+-personer, ofta i syfte att dela nyheter och information relaterad till hbtq+-frågor och hbtq+-gemenskaper."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001132"},{"@id":"https://homosaurus.org/v5/homoit0001830"}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000166"},{"@id":"https://homosaurus.org/v5/homoit0000514"},{"@id":"https://homosaurus.org/v5/homoit0000759"},{"@id":"https://homosaurus.org/v5/homoit0001191"},{"@id":"https://homosaurus.org/v5/homoit0001427"},{"@id":"https://homosaurus.org/v5/homoit0002797"},{"@id":"https://homosaurus.org/v5/homoit0002918"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0002714"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001132"},"dc:replaces":{"@id":"http://homosaurus.org/v2/newslettersLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000167","dc:identifier":"homoit0000167","skos:prefLabel":[{"@language":"en","@value":"Bisexual newspapers"},{"@language":"de","@value":"Bisexuelle Zeitungen"},{"@language":"es","@value":"Periódicos bisexuales"},{"@language":"nl","@value":"Biseksuele bladen"},{"@language":"sv","@value":"Bisexuella tidningar"}],"skos:altLabel":{"@language":"es","@value":"Diarios bisexuales"},"rdfs:comment":[{"@language":"en","@value":"Serialized print or digital publications about bisexuality or bisexual issues (and typically produced by bisexual people or organizations) that contain news, articles, columns, correspondence, and advertisements."},{"@language":"de","@value":"Fortlaufende gedruckte oder digitale Zeitungen über bisexuelle Menschen oder bisexuelle Themen (die in der Regel von bisexuellen Menschen oder bisexuellen Organisationen herausgegeben werden), die Nachrichten, Artikel, Kolumnen, Korrespondenz und Anzeigen enthalten."},{"@language":"es","@value":"Publicaciones impresas o digitales serializadas sobre la bisexualidad o temas bisexuales (y generalmente producidas por personas u organizaciones bisexuales) que contienen noticias, artículos, columnas, correspondencia y anuncios."},{"@language":"nl","@value":"Periodieke gedrukte of digitale publicaties over biseksuele personen en biseksuele kwesties (meestal geproduceerd door biseksuele personen of biseksuele organisaties) die nieuws, artikelen, columns, correspondentie en advertenties bevatten."},{"@language":"sv","@value":"Seriella tryckta eller digitala publikationer om bisexualitet eller bisexuella frågor (vanligtvis producerade av bisexuella personer eller organisationer) som innehåller nyheter, artiklar, krönikor, korrespondens och annonser."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000177"},{"@id":"https://homosaurus.org/v5/homoit0001042"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000166"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001132"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualNewspapers"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001042","dc:identifier":"homoit0001042","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ newspapers"},{"@language":"es","@value":"Periódicos LGBTQ+"},{"@language":"nl","@value":"LHBTQ+-nieuwsbladen"},{"@language":"sv","@value":"Hbtq+-tidningar"}],"skos:altLabel":[{"@language":"en","@value":"Newspapers (LGBTQ)"},{"@language":"es","@value":"Diarios LGBTQ+"},{"@language":"es","@value":"Diarios (LGBTQ)"},{"@language":"es","@value":"Periódicos (LGBTQ)"}],"rdfs:comment":[{"@language":"en","@value":"Serialized print or digital publications about LGBTQ+ people and LGBTQ+ issues (typically produced by LGBTQ+ people or LGBTQ+ organizations) that contain news, articles, columns, correspondence, and advertisements. "},{"@language":"es","@value":"Publicaciones impresas o digitales serializadas sobre personas LGBTQ+ y temas LGBTQ+ (normalmente producidas por personas LGBTQ+ u organizaciones LGBTQ+) que contienen noticias, artículos, columnas, correspondencia y anuncios."},{"@language":"nl","@value":"Periodieke gedrukte of digitale publicaties over LHBTQ+-personen en LHBTQ+-kwesties (meestal geproduceerd door LHBTQ+-personen of LHBTQ+-organisaties) die nieuws, artikelen, columns, correspondentie en advertenties bevatten."},{"@language":"sv","@value":"Seriella tryckta eller digitala publikationer om hbtq+-personer eller hbtq+-frågor (vanligtvis producerade av hbtq+-personer eller hbtq+-organisationer) som innehåller nyheter, artiklar, krönikor, korrespondens och annonser."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001132"},{"@id":"https://homosaurus.org/v5/homoit0001830"}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000167"},{"@id":"https://homosaurus.org/v5/homoit0000515"},{"@id":"https://homosaurus.org/v5/homoit0000760"},{"@id":"https://homosaurus.org/v5/homoit0000911"},{"@id":"https://homosaurus.org/v5/homoit0001192"},{"@id":"https://homosaurus.org/v5/homoit0001428"},{"@id":"https://homosaurus.org/v5/homoit0002798"},{"@id":"https://homosaurus.org/v5/homoit0002919"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0002715"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001132"},"dc:replaces":{"@id":"http://homosaurus.org/v2/newspapersLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000168","dc:identifier":"homoit0000168","skos:prefLabel":[{"@language":"en","@value":"Bisexual Pagans"},{"@language":"de","@value":"Bisexuelle Heid:innen"},{"@language":"es","@value":"Paganos bisexuales"},{"@language":"nl","@value":"Biseksuele paganisten"},{"@language":"sv","@value":"Bisexuella hedningar"}],"skos:altLabel":[{"@language":"de","@value":"Bisexuelle heidnische Personen"},{"@language":"sv","@value":"Bisexuella nyhedningar"}],"rdfs:comment":[{"@language":"en","@value":"Bisexual people who are members of polytheistic religions or other religions outside of the dominant culture that typically incorporate nature worship and/or the sacred feminine, such as Wicca, Druidry, Heathenry, etc. Use to describe bisexual people who self-identify as Pagan."},{"@language":"de","@value":"Bisexuelle Menschen, die polytheistischen Religionen oder anderen Religionen ausserhalb der vorherrschenden Kultur angehören, die typischerweise die Naturverehrung und/oder das heilige Weibliche beinhalten, wie Wicca, Druidentum, Heidentum usw. Wird verwendet, um bisexuelle Personen zu beschreiben, die sich selbst als heidnisch bezeichnen."},{"@language":"es","@value":"Personas bisexuales que son miembros de religiones politeístas u otras religiones fuera de la cultura dominante que típicamente incorporan el culto a la naturaleza y/o lo sagrado femenino, como la Wicca, el druidismo, el paganismo, etc. Utilícese para describir a las personas bisexuales que se autoidentifican como paganas."},{"@language":"nl","@value":"Biseksuele personen die lid zijn van polytheïstische religies of andere religies buiten de dominante cultuur die natuuraanbidding en/of het heilige vrouwelijke incorporeren, zoals Wicca, Druidendom, Heidendom, enz. Gebruik om biseksuele personen te beschrijven die zichzelf identificeren als Paganistisch."},{"@language":"sv","@value":"Bisexuella personer som tillhör polyteistiska religioner, eller andra religioner utanför den dominerande kulturen, som ofta innefattar naturdyrkan och/eller det heliga feminina, såsom wicca, druidism, hednisk tro m.m. Används för bisexuella som själva identifierar sig som hedningar."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001069"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001910"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000928"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualPagans"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001069","dc:identifier":"homoit0001069","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ Pagans"},{"@language":"es","@value":"Paganos LGBTQ+"},{"@language":"ja","@value":"LGBTQ+のペイガン"},{"@language":"nl","@value":"LHBTQ+-paganisten"},{"@language":"sv","@value":"Hedningar (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"Pagans (LGBTQ)"},{"@language":"en","@value":"ペイガン（LGBTQ）"},{"@language":"es","@value":"Paganos (LGBTQ)"},{"@language":"sv","@value":"Nyhedningar (hbtq+)"}],"rdfs:comment":[{"@language":"en","@value":"LGBTQ+ people who are members of polytheistic religions or other religions outside of the dominant culture that typically incorporate nature worship and/or the sacred feminine, such as Wicca, Druidry, Heathenry, etc. Use to describe LGBTQ+ people who self-identify as Pagan."},{"@language":"es","@value":"Personas LGBTQ+ que son miembros de religiones politeístas u otras religiones fuera de la cultura dominante que típicamente incorporan el culto a la naturaleza y/o lo sagrado femenino, como la Wicca, el druidismo, el paganismo, etc. Utilícese para describir a las personas LGBTQ+ que se autoidentifiquen como paganas."},{"@language":"ja","@value":"多神教や、ウィッカ、ドルイド教、ヘイセン教など、自然崇拝や「聖なる女性性」を取り入れることが一般的で、主流の宗教文化とは異なる宗教を信仰するLGBTQ+の人々。自らを「ペイガン」と自認するLGBTQ+の人々を指す言葉として用いられる。"},{"@language":"nl","@value":"LHBTQ+-personen die lid zijn van polytheïstische religies of andere religies buiten de dominante cultuur die natuuraanbidding en/of het heilige vrouwelijke incorporeren, zoals Wicca, Druidendom, Heidendom, enz. Gebruik om LHBTQ+-personen te beschrijven die zichzelf identificeren als Paganistisch."},{"@language":"sv","@value":"Hbtq+-personer som tillhör polyteistiska religioner, eller andra religioner utanför den dominerande kulturen, som ofta innefattar naturdyrkan och/eller det heliga feminina, såsom wicca, druidism, hednisk tro m.m. Används för hbtq+-personer som själva identifierar sig som hedningar."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000928"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000168"},{"@id":"https://homosaurus.org/v5/homoit0000516"},{"@id":"https://homosaurus.org/v5/homoit0000761"},{"@id":"https://homosaurus.org/v5/homoit0001193"},{"@id":"https://homosaurus.org/v5/homoit0001429"},{"@id":"https://homosaurus.org/v5/homoit0001907"},{"@id":"https://homosaurus.org/v5/homoit0002977"},{"@id":"https://homosaurus.org/v5/homoit0002983"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000596"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000928"},"dc:replaces":{"@id":"http://homosaurus.org/v2/pagansLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001910","dc:identifier":"homoit0001910","skos:prefLabel":[{"@language":"en","@value":"Bisexual witches"},{"@language":"de","@value":"Bisexuelle Hexen"},{"@language":"es","@value":"Brujxs bisexuales"},{"@language":"nl","@value":"Biseksuele heksen"},{"@language":"sv","@value":"Bisexuella häxor"}],"skos:altLabel":[{"@language":"en","@value":"Bisexual Wiccans"},{"@language":"de","@value":"Bisexuelle Wicca"},{"@language":"de","@value":"Bisexuelle Wicca-Anhänger:innen"},{"@language":"es","@value":"Wiccanos bisexuales"},{"@language":"es","@value":"Wiccanas bisexuales"},{"@language":"es","@value":"Brujas bisexuales"},{"@language":"es","@value":"Brujos bisexuales"}],"rdfs:comment":[{"@language":"en","@value":"Bisexual practitioners of Wicca or other Pagan religions who self-identify as witches."},{"@language":"de","@value":"Bisexuelle Anhänger:innen von Wicca oder anderen heidnischen Religionen, die sich selbst als Hexen bezeichnen."},{"@language":"es","@value":"Practicantes bisexuales de Wicca u otras religiones paganas que se autoidentifican como brujas."},{"@language":"nl","@value":"Biseksuele beoefenaars van Wicca of andere paganistische religies die zichzelf identificeren als heksen"},{"@language":"sv","@value":"Bisexuella personer som utövar wicca eller andra hedniska religioner och som identifierar sig som häxor."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001907"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000168"},{"@id":"https://homosaurus.org/v5/homoit0000596"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000928"},"dc:issued":{"@type":"xsd:date","@value":"2022-03-29"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001075","dc:identifier":"homoit0001075","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ parents"},{"@language":"es","@value":"Madres y padres LGBTQ+"},{"@language":"nl","@value":"LHBTQ+-ouders"},{"@language":"sv","@value":"Föräldrar (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"Parents (LGBTQ)"},{"@language":"es","@value":"Padres LGBTQ+"},{"@language":"es","@value":"Madres LGBTQ+"},{"@language":"sv","@value":"Hbtq+-föräldrar"}],"rdfs:comment":[{"@language":"en","@value":"LGBTQ+ people who are parents."},{"@language":"es","@value":"Personas LGBTQ+ que son padres y/o madres."},{"@language":"nl","@value":"LHBTQ+-personen die ouders zijn."},{"@language":"sv","@value":"Hbtq+-personer som är föräldrar."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000420"},{"@id":"https://homosaurus.org/v5/homoit0002372"}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000169"},{"@id":"https://homosaurus.org/v5/homoit0000492"},{"@id":"https://homosaurus.org/v5/homoit0000752"},{"@id":"https://homosaurus.org/v5/homoit0000812"},{"@id":"https://homosaurus.org/v5/homoit0000819"},{"@id":"https://homosaurus.org/v5/homoit0000821"},{"@id":"https://homosaurus.org/v5/homoit0000840"},{"@id":"https://homosaurus.org/v5/homoit0000872"},{"@id":"https://homosaurus.org/v5/homoit0000944"},{"@id":"https://homosaurus.org/v5/homoit0001194"},{"@id":"https://homosaurus.org/v5/homoit0001430"},{"@id":"https://homosaurus.org/v5/homoit0001761"},{"@id":"https://homosaurus.org/v5/homoit0001762"},{"@id":"https://homosaurus.org/v5/homoit0001763"},{"@id":"https://homosaurus.org/v5/homoit0002337"},{"@id":"https://homosaurus.org/v5/homoit0002343"},{"@id":"https://homosaurus.org/v5/homoit0002387"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000809"},{"@id":"https://homosaurus.org/v5/homoit0000811"},{"@id":"https://homosaurus.org/v5/homoit0000843"},{"@id":"https://homosaurus.org/v5/homoit0000864"},{"@id":"https://homosaurus.org/v5/homoit0000870"},{"@id":"https://homosaurus.org/v5/homoit0000914"},{"@id":"https://homosaurus.org/v5/homoit0002584"},{"@id":"https://homosaurus.org/v5/homoit0002586"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2006000228"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000420"},"dc:replaces":{"@id":"http://homosaurus.org/v2/parentsLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000202","dc:identifier":"homoit0000202","skos:prefLabel":[{"@language":"en","@value":"Bisexual women"},{"@language":"es","@value":"Mujeres bisexuales"},{"@language":"de","@value":"Bisexuelle Frauen"},{"@language":"nl","@value":"Biseksuele vrouwen"},{"@language":"sv","@value":"Bisexuella kvinnor"}],"skos:altLabel":{"@language":"en","@value":"Bi women"},"rdfs:comment":[{"@language":"en","@value":"Women who are bisexual. "},{"@language":"es","@value":"Personas bisexuales que seautoidentificancomo mujeres y que entienden su género en términos de las concepciones occidentales del ser mujer, la feminidad, y/o la femineidad."},{"@language":"de","@value":"Bisexuelle Personen, die sich selbst als Frauen bezeichnen und ihr Geschlecht im Sinne westlicher Vorstellungen von Frausein, Weiblichkeit und/oder Femininität verstehen."},{"@language":"nl","@value":"Biseksuele personen die zichzelf als vrouw identificeren en hun gender zien in termen van westerse opvattingen over vrouw zijn en vrouwelijkheid"},{"@language":"sv","@value":"Kvinnor som identifierar sig om bisexuella."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000170"},{"@id":"https://homosaurus.org/v5/homoit0001509"}],"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0001002"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001510"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh93002512"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualWomen"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000285","dc:identifier":"homoit0000285","skos:prefLabel":[{"@language":"en","@value":"Closeted bisexual people"},{"@language":"de","@value":"Ungeoutete bisexuelle Personen"},{"@language":"es","@value":"Personas bisexuales en el clóset"},{"@language":"nl","@value":"Biseksuele personen in de kast"},{"@language":"sv","@value":"Garderobsbisexuella"}],"skos:altLabel":[{"@language":"de","@value":"Nicht geoutete bisexuelle Personen"},{"@language":"es","@value":"Personas en el clóset bisexuales"}],"rdfs:comment":[{"@language":"en","@value":"Bisexual people who do not identify as such to others."},{"@language":"de","@value":"Bisexuelle Personen, die diese Identität vor anderen nicht preisgeben."},{"@language":"es","@value":"Personas bisexuales que no se autoidentifican como tales ante los demás."},{"@language":"nl","@value":"Biseksuelen die zich niet als zodanig identificeren bij anderen."},{"@language":"sv","@value":"Bisexuella personer som inte identifierar sig som sådana inför andra."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000170"},{"@id":"https://homosaurus.org/v5/homoit0001783"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000286"},{"@id":"https://homosaurus.org/v5/homoit0000287"},{"@id":"https://homosaurus.org/v5/homoit0000295"},{"@id":"https://homosaurus.org/v5/homoit0000365"},{"@id":"https://homosaurus.org/v5/homoit0001065"},{"@id":"https://homosaurus.org/v5/homoit0001261"},{"@id":"https://homosaurus.org/v5/homoit0001784"},{"@id":"https://homosaurus.org/v5/homoit0001785"},{"@id":"https://homosaurus.org/v5/homoit0002905"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/closetedBisexualPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001054","dc:identifier":"homoit0001054","skos:prefLabel":[{"@language":"en","@value":"Older bisexual people"},{"@language":"es","@value":"Personas mayores bisexuales"},{"@language":"nl","@value":"Biseksuele ouderen"},{"@language":"sv","@value":"Äldre bisexuella"}],"skos:altLabel":[{"@language":"es","@value":"Personas ancianas bisexuales"},{"@language":"es","@value":"Personas en su tercera edad bisexuales"},{"@language":"es","@value":"Personas de tercera edad bisexuales"}],"rdfs:comment":[{"@language":"en","@value":"Bisexual people who are advanced in age, typically over 60 years of age."},{"@language":"es","@value":"Personas bisexuales de edad avanzada, normalmente mayores de 60 años."},{"@language":"nl","@value":"Biseksuele personen met een hogere leeftijd, meestal ouder dan 60 jaar."},{"@language":"sv","@value":"Bisexuella personer som är äldre, vanligtvis över 60 års ålder."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000170"},{"@id":"https://homosaurus.org/v5/homoit0000393"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/olderBisexualPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003035","dc:identifier":"homoit0003035","skos:prefLabel":[{"@language":"en","@value":"Bisexual college students"},{"@language":"de","@value":"Bisexuelle Hochschulstudierende"},{"@language":"es","@value":"Estudiantes universitarios bisexuales"},{"@language":"nl","@value":"Biseksuele studenten"},{"@language":"sv","@value":"Bisexuella collegestudenter"}],"skos:altLabel":[{"@language":"es","@value":"Universitarios bisexuales"},{"@language":"es","@value":"Universitarias bisexuales"}],"rdfs:comment":[{"@language":"en","@value":"Bisexual people who are attending college."},{"@language":"de","@value":"Bisexuelle Personen, die eine Hochschule besuchen. Achtung: Das US-amerikanische College entspricht nicht exakt der Hochschule im deutschen Sprachraum, wird aber häufig als Hochschule übersetzt."},{"@language":"es","@value":"Personas bisexuales que asisten a la universidad."},{"@language":"sv","@value":"Bisexuella personer som studerar vid college."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000170"},{"@id":"https://homosaurus.org/v5/homoit0003041"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0003032"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-12-05"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000173","dc:identifier":"homoit0000173","skos:prefLabel":[{"@language":"en","@value":"Parents of bisexual people"},{"@language":"es","@value":"Madres y padres de personas bisexuales"},{"@language":"fr","@value":"Parents de personnes bisexuelles"},{"@language":"nl","@value":"Ouders van biseksuele personen"},{"@language":"sv","@value":"Föräldrar till bisexuella"}],"skos:altLabel":[{"@language":"en","@value":"Bisexual people’s parents"},{"@language":"es","@value":"Padres de personas bisexuales"},{"@language":"es","@value":"Madres de personas bisexuales"}],"rdfs:comment":[{"@language":"en","@value":"People who act as parents to one or more bisexual person. For parents who are themselves bisexual, use the term \"Bisexual parents.\""},{"@language":"es","@value":"Personas que actúan como padres de una o más personas bisexuales. Para padres que son bisexuales, utilice el término \"madres y padres bisexuales\"."},{"@language":"fr","@value":"Personnes qui assument le rôle de parent auprès d'une personne bisexuelle."},{"@language":"sv","@value":"Personer som fungerar som föräldrar till en eller flera bisexuella personer. För föräldrar som själva är bisexuella, använd termen ”Bisexuella föräldrar”."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002224"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000170"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000421"},"dc:replaces":{"@id":"http://homosaurus.org/v2/parentsOfBisexualPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000204","dc:identifier":"homoit0000204","skos:prefLabel":[{"@language":"en","@value":"Bisexuality"},{"@language":"es","@value":"Bisexualidad"},{"@language":"de","@value":"Bisexualität"},{"@language":"fr","@value":"Bisexualité"},{"@language":"nl","@value":"Biseksualiteit"},{"@language":"sv","@value":"Bisexualitet"}],"rdfs:comment":[{"@language":"en","@value":"Sexual identity that is defined as attraction to more than one gender; follow the individual's preference for bisexuality, pansexuality, or polysexuality whenever possible."},{"@language":"es","@value":"Identidad sexual que se define como atracción hacia más de un género; siga la preferencia de la persona sobre el uso de bisexualidad, pansexualidad o polisexualidad siempre que sea posible"},{"@language":"de","@value":"Sexuelle Identität, die als Anziehung zu mehr als einem Geschlecht definiert wird; möglichst der individuellen Präferenz für Bisexualität, Pansexualität oder Polysexualität folgen."},{"@language":"fr","@value":"Identité sexuelle définie comme une attirance envers plus d'un genre; privilégier le terme préféré par la personne concernée, soit bisexualité, pansexualité ou polysexualité, chaque fois que possible."},{"@language":"nl","@value":"Seksuele identiteit die wordt gedefinieerd als aantrekking tot meer dan één gender; volg waar mogelijk de voorkeur van het individu voor biseksualiteit, panseksualiteit of polyseksualiteit"},{"@language":"sv","@value":"Sexuell identitet som definieras som attraktion till mer än ett kön. Följ individens egen benämning av identiteten som bisexuell, pansexuell eller polysexuell när det är möjligt."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001298"},{"@id":"https://homosaurus.org/v5/homoit0001558"}],"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0003445"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000170"},{"@id":"https://homosaurus.org/v5/homoit0000647"},{"@id":"https://homosaurus.org/v5/homoit0000799"},{"@id":"https://homosaurus.org/v5/homoit0001919"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85014412"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001298"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexuality"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001103","dc:identifier":"homoit0001103","skos:prefLabel":[{"@language":"en","@value":"Persecution of bisexual people"},{"@language":"es","@value":"Persecución de personas bisexuales"},{"@language":"nl","@value":"Vervolging van biseksuele personen"},{"@language":"sv","@value":"Förföljelse av bisexuella"}],"rdfs:comment":[{"@language":"en","@value":"Systematic mistreatment of bisexual people on the basis of their sexual identity."},{"@language":"es","@value":"Maltrato sistemático a personas bisexuales por su identidad sexual."},{"@language":"nl","@value":"Systematische mishandeling van biseksuele personen op basis van hun seksuele identiteit."},{"@language":"sv","@value":"Systematisk förföljelse av bisexuella personer på grund av deras sexuella identitet."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001108"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000170"},{"@id":"https://homosaurus.org/v5/homoit0004466"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001108"},"dc:replaces":{"@id":"http://homosaurus.org/v2/persecutionOfBisexualPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001531","dc:identifier":"homoit0001531","skos:prefLabel":[{"@language":"en","@value":"Allosexuality"},{"@language":"es","@value":"Alosexualidad"},{"@language":"de","@value":"Allosexualität"},{"@language":"fr","@value":"Allosexualité"},{"@language":"nl","@value":"Alloseksualiteit"},{"@language":"sv","@value":"Allosexualitet"}],"skos:altLabel":{"@language":"fr","@value":"Altersexualité"},"rdfs:comment":[{"@language":"en","@value":"A sexual orientation generally characterized by the occurrence of sexual attraction or the desire for partnered sexual experiences."},{"@language":"es","@value":"Una orientación sexual generalmente caracterizada por la atracción sexual o el deseo de tener experiencias sexuales en pareja."},{"@language":"de","@value":"Eine sexuelle Orientierung, die allgemein durch das Auftreten sexueller Anziehung oder den Wunsch nach partnerschaftlicher sexueller Erfahrung charakterisiert wird."},{"@language":"fr","@value":"Orientation sexuelle caractérisée par une attirance sexuelle ou le désir de vivre des expériences sexuelles avec d'autres personnes."},{"@language":"sv","@value":"En sexuell läggning som generellt kännetecknas av förekomsten av sexuell attraktion eller önskan om sexuella upplevelser med en eller flera partner."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001298"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000170"},{"@id":"https://homosaurus.org/v5/homoit0000627"},{"@id":"https://homosaurus.org/v5/homoit0000648"},{"@id":"https://homosaurus.org/v5/homoit0001073"},{"@id":"https://homosaurus.org/v5/homoit0001535"},{"@id":"https://homosaurus.org/v5/homoit0001917"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001298"},"dc:replaces":{"@id":"http://homosaurus.org/v2/allosexuality"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-02"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000171","dc:identifier":"homoit0000171","skos:prefLabel":[{"@language":"en","@value":"Bisexual people in the military"},{"@language":"de","@value":"Bisexuelle Armeeangehörige"},{"@language":"es","@value":"Personas bisexuales en el ejército"},{"@language":"nl","@value":"Biseksueel militair personeel"},{"@language":"sv","@value":"Bisexuella inom militären"}],"skos:altLabel":[{"@language":"de","@value":"Bisexuelle Militärangehörige"},{"@language":"es","@value":"Personas bisexuales en las fuerzas armadas"}],"rdfs:comment":[{"@language":"en","@value":"Bisexual individuals serving in state and national armed forces."},{"@language":"de","@value":"Bisexuelle Personen, die in Streitkräften dienen"},{"@language":"es","@value":"Personas bisexuales que sirven en las fuerzas armadas estatales y nacionales."},{"@language":"nl","@value":"Biseksuele personen die dienen in staats- en nationale strijdkrachten."},{"@language":"sv","@value":"Bisexuella personer som tjänstgör inom nationella försvarsstyrkor."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001100"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000712"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualPeopleInTheMilitary"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001100","dc:identifier":"homoit0001100","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ people in the military"},{"@language":"es","@value":"Personas LGBTQ+ en el ejército"},{"@language":"de","@value":"LGBTQ+-Armeeangehörige"},{"@language":"nl","@value":"LHBTQ+-militair personeel"},{"@language":"sv","@value":"Hbtq+-personer i militären"}],"skos:altLabel":[{"@language":"en","@value":"People in the military (LGBTQ)"},{"@language":"es","@value":"Personas LGBTQ+ en las fuerzas armadas"},{"@language":"de","@value":"LGBTQ+-Militärangeörige"},{"@language":"sv","@value":"Soldater (hbtq+)"},{"@language":"sv","@value":"Militärer (hbtq+)"}],"rdfs:comment":[{"@language":"en","@value":"LGBTQ+ people serving in state and national armed forces."},{"@language":"es","@value":"Personas LGBTQ+ que sirven en las fuerzas armadas estatales y nacionales."},{"@language":"de","@value":"LGBTQ+-Personen, die in Streitkräften dienen."},{"@language":"nl","@value":"LHBTQ+-personen die dienen in staats- en nationale strijdkrachten."},{"@language":"sv","@value":"Hbtq+-personer som tjänstgör inom nationella försvarsstyrkor."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000712"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000171"},{"@id":"https://homosaurus.org/v5/homoit0000507"},{"@id":"https://homosaurus.org/v5/homoit0000800"},{"@id":"https://homosaurus.org/v5/homoit0001196"},{"@id":"https://homosaurus.org/v5/homoit0001431"},{"@id":"https://homosaurus.org/v5/homoit0002801"},{"@id":"https://homosaurus.org/v5/homoit0002921"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000862"},{"@id":"https://homosaurus.org/v5/homoit0002718"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2020006298"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000712"},"dc:replaces":{"@id":"http://homosaurus.org/v2/peopleInTheMilitaryLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000172","dc:identifier":"homoit0000172","skos:prefLabel":[{"@language":"en-us","@value":"Bisexual people of color"},{"@language":"de","@value":"Bisexuelle Personen of Color"},{"@language":"es","@value":"Personas bisexuales de color"},{"@language":"nl","@value":"Biseksuele personen van kleur"},{"@language":"sv","@value":"Bisexuella icke-vita"},{"@language":"en-gb","@value":"Bisexual people of colour"}],"skos:altLabel":[{"@language":"de","@value":"Bisexuelle People of Color"},{"@language":"de","@value":"Bisexuelle Menschen of Color"},{"@language":"de","@value":"Bisexuelle Menschen von Farbe"},{"@language":"de","@value":"Bisexuelle Personen von Farbe"},{"@language":"de","@value":"Bisexuelle PoC"},{"@language":"sv","@value":"Bisexuella POC"},{"@language":"sv","@value":"Bisexuella people of color"}],"rdfs:comment":[{"@language":"en","@value":"Primarily used in the United States, this term refers to bisexual people who are not white and who identify as people of color."},{"@language":"de","@value":"Bisexuelle Personen, die nicht weiß sind und sich als People of Color identifizieren."},{"@language":"es","@value":"Personas bisexuales que no son blancas y que se autoidentifican como personas de color."},{"@language":"nl","@value":"Biseksuele personen die niet wit zijn en die zich identificeren als personen van kleur."},{"@language":"sv","@value":"Bisexuella som inte är vita och som identifierar sig som icke-vita/people of color."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001101"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualPeopleOfColour"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002224","dc:identifier":"homoit0002224","skos:prefLabel":[{"@language":"en","@value":"Parents of LGBTQ+ people"},{"@language":"es","@value":"Madres y padres de personas LGBTQ+"},{"@language":"nl","@value":"Ouders van LHBTQ+-personen"},{"@language":"sv","@value":"Föräldrar till hbtq+-personer"}],"skos:altLabel":[{"@language":"en","@value":"LGBTQ people's parents"},{"@language":"en","@value":"LGBTQ+ people's parents"},{"@language":"en","@value":"Parents of LGBTQ people"},{"@language":"es","@value":"Padres de personas LGBTQ+"},{"@language":"es","@value":"Madres de personas LGBTQ+"}],"rdfs:comment":[{"@language":"en","@value":"Individuals who have one or more LGBTQ+ child."},{"@language":"es","@value":"Personas que actúan como padres de una o más personas LGBTQ+. Para padres que son LGBTQ+, utilice el término \"madres y padres LGBTQ+\""},{"@language":"nl","@value":"Personen die een of meer LHBTQ+-kinderen hebben"},{"@language":"sv","@value":"Personer som har ett eller flera hbtq+-barn."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002372"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000173"},{"@id":"https://homosaurus.org/v5/homoit0000509"},{"@id":"https://homosaurus.org/v5/homoit0000802"},{"@id":"https://homosaurus.org/v5/homoit0001077"},{"@id":"https://homosaurus.org/v5/homoit0001078"},{"@id":"https://homosaurus.org/v5/homoit0002225"},{"@id":"https://homosaurus.org/v5/homoit0002742"},{"@id":"https://homosaurus.org/v5/homoit0002910"}],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh90005864"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000421"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-19"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001118","dc:identifier":"homoit0001118","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ poetry"},{"@language":"es","@value":"Poesía LGBTQ+"},{"@language":"nl","@value":"LHBTQ+-poëzie"},{"@language":"sv","@value":"Hbtq+-poesi"}],"skos:altLabel":[{"@language":"en","@value":"Poetry (LGBTQ)"},{"@language":"es","@value":"Poesía (LGBTQ)"},{"@language":"sv","@value":"Poesi (hbtq+)"},{"@language":"sv","@value":"Lyrik (hbtq+)"},{"@language":"sv","@value":"Hbtq+-lyrik"}],"rdfs:comment":[{"@language":"en","@value":"Poetry about LGBTQ+ people or relating to LGBTQ+ issues."},{"@language":"es","@value":"Poesía sobre personas LGBTQ+ o relacionada con temas LGBTQ+."},{"@language":"nl","@value":"Literair werk, meestal in verzen geschreven, dat zich richt op LHBTQ+-personages, thema's of identiteit."},{"@language":"sv","@value":"Lyriska verk med fokus på hbtq+-karaktärer, teman eller identitet."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000972"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000174"},{"@id":"https://homosaurus.org/v5/homoit0000517"},{"@id":"https://homosaurus.org/v5/homoit0000762"},{"@id":"https://homosaurus.org/v5/homoit0001197"},{"@id":"https://homosaurus.org/v5/homoit0001433"},{"@id":"https://homosaurus.org/v5/homoit0002401"},{"@id":"https://homosaurus.org/v5/homoit0002403"},{"@id":"https://homosaurus.org/v5/homoit0002405"},{"@id":"https://homosaurus.org/v5/homoit0002408"},{"@id":"https://homosaurus.org/v5/homoit0002508"},{"@id":"https://homosaurus.org/v5/homoit0002536"},{"@id":"https://homosaurus.org/v5/homoit0002576"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001723"},{"@id":"https://homosaurus.org/v5/homoit0002630"},{"@id":"https://homosaurus.org/v5/homoit0002642"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/poetryLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002609","dc:identifier":"homoit0002609","skos:prefLabel":[{"@language":"en","@value":"Bisexual erotic art "},{"@language":"de","@value":"Bisexuelle erotische Kunst"},{"@language":"es","@value":"Arte erótico bisexual"},{"@language":"nl","@value":"Biseksuele erotische kunst"},{"@language":"sv","@value":"Bisexuell erotisk konst"}],"skos:altLabel":{"@language":"de","@value":"Erotische Bi-Kunst"},"rdfs:comment":[{"@language":"en","@value":"Erotic art, created by bisexual artists, depicting bisexual people, or that are regarded as important within bisexual culture."},{"@language":"de","@value":"Erotische Kunst von bisexuellen Künstler:innen, die bisexuelle Personen darstellen oder als wichtig innerhalb der bisexuellen Kultur angesehen werden."},{"@language":"es","@value":"Arte erótico, creado por artistas bisexuales, que representa a personas bisexuales o a personas consideradas importantes dentro de la cultura bisexual."},{"@language":"nl","@value":"Erotische kunst, gemaakt door biseksuele kunstenaars, die biseksuele personen afbeelden, of die als belangrijk worden beschouwd binnen de biseksuele cultuur."},{"@language":"sv","@value":"Erotisk konst skapad av konstnärer som är bisexuella, som avbildar bisexuella personer eller som anses betydelsefull inom bisexuell kultur."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002579"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000176"},{"@id":"https://homosaurus.org/v5/homoit0002548"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0002600"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002548","dc:identifier":"homoit0002548","skos:prefLabel":[{"@language":"en","@value":"Bisexual erotic films "},{"@language":"de","@value":"Bisexuelle erotische Filme"},{"@language":"es","@value":"Películas eróticas bisexuales"},{"@language":"nl","@value":"Biseksuele erotische films"},{"@language":"sv","@value":"Bisexuell erotisk film"}],"skos:altLabel":[{"@language":"de","@value":"Erotische Bi-Filme"},{"@language":"de","@value":"Bisexuelle Erotikfilme"},{"@language":"de","@value":"Bi-Erotikfiilme"}],"rdfs:comment":[{"@language":"en","@value":"Erotic films or movies, created by bisexual directors, depicting bisexual people, or that are regarded as important within bisexual culture."},{"@language":"de","@value":"Erotische Filme von bisexuellen Künstler:innen, die bisexuelle Personen darstellen oder als wichtig innerhalb der bisexuellen Kultur angesehen werden."},{"@language":"es","@value":"Filmes o películas eróticas, creadas por directores bisexuales, que representan a personas bisexuales o a personas consideradas importantes dentro de la cultura bisexual."},{"@language":"nl","@value":"Erotische films, gemaakt door biseksuele regisseurs, waarin biseksuele personen voorkomen of personen die als belangrijk worden beschouwd binnen de biseksuele cultuur."},{"@language":"sv","@value":"Erotiska filmer skapade av bisexuella regissörer, föreställande bisexuella personer eller betraktade som viktiga inom bisexuell kultur."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0002544"},{"@id":"https://homosaurus.org/v5/homoit0002609"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000176"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-12"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004625","dc:identifier":"homoit0004625","skos:prefLabel":{"@language":"en","@value":"Bisexual personals"},"skos:altLabel":[{"@language":"en","@value":"Bisexual personal ads"},{"@language":"en","@value":"Bisexual personal advertisements"},{"@language":"en","@value":"Bi personals"},{"@language":"en","@value":"Bi personal ads"},{"@language":"en","@value":"Bi personal advertisements"}],"rdfs:comment":{"@language":"en","@value":"A form of classified advertising for bisexual people interested in seeking connections around sex, romance, and/or community. The content of these ads focus largely on the type of arrangement sought and details or criteria about the writer and the type of person they are looking for (e.g. personality traits, physical looks, etc.). While bisexual personals are most commonly thought of as existing in print media, they also have existed online in spaces such as Craigslist."},"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0004621"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000182"},{"@id":"https://homosaurus.org/v5/homoit0000177"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0004621"},"dc:issued":{"@type":"xsd:date","@value":"2026-06-08"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-08"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000178","dc:identifier":"homoit0000178","skos:prefLabel":[{"@language":"en","@value":"Bisexual sex workers"},{"@language":"de","@value":"Bisexuelle Sexarbeiter:innen"},{"@language":"es","@value":"Trabajadores sexuales bisexuales"},{"@language":"nl","@value":"Biseksuele sekswerkers"},{"@language":"sv","@value":"Bisexuella sexarbetare"}],"skos:altLabel":[{"@language":"en","@value":"Bisexual prostitutes"},{"@language":"en","@value":"Bi sex workers"},{"@language":"en","@value":"Bi prostitutes"},{"@language":"en","@value":"Bisexual prostitution"},{"@language":"en","@value":"Bisexual sex work"},{"@language":"de","@value":"Bisexuelle Prostituierte"},{"@language":"de","@value":"Bi-Sexarbeiter:innen"},{"@language":"de","@value":"Bi-Prostituierte"},{"@language":"de","@value":"Bisexuelle Prostitution"},{"@language":"de","@value":"Bisexuelle Sexarbeit"},{"@language":"es","@value":"Prostitutos bisexuales"},{"@language":"es","@value":"Trabajadores sexuales bi"},{"@language":"es","@value":"Prostitutos bi"},{"@language":"es","@value":"Prostitución bisexual"},{"@language":"es","@value":"Trabajo sexual bisexual"},{"@language":"es","@value":"Prostitutas bisexuales"},{"@language":"es","@value":"Trabajadoras sexuales bi"},{"@language":"es","@value":"Prostitutas bi"},{"@language":"es","@value":"Trabajadoras sexuales bisexuales"}],"rdfs:comment":[{"@language":"en","@value":"Bisexual people who receive money or goods in exchange for sexual services, performances, or companionship. Use to describe bisexual people working across the broad spectrum of sex work."},{"@language":"de","@value":"Bisexuelle Personen, die Geld oder Waren als Gegenleistung für sexuelle Dienstleistungen, Darbietungen oder Gesellschaft erhalten. Verwenden, um bisexuelle Personen zu beschreiben, die im breiten Spektrum der Sexarbeit tätig sind."},{"@language":"es","@value":"Personas bisexuales que reciben dinero o bienes a cambio de servicios o actuaciones sexuales. Se utiliza para describir a las personas bisexuales que trabajan en el amplio espectro del trabajo sexual."},{"@language":"nl","@value":"Biseksuele personen die geld of goederen ontvangen in ruil voor seksuele diensten, optredens of gezelschap. Wordt gebruikt om biseksuele personen te beschrijven die werkzaam zijn in het brede spectrum van sekswerk."},{"@language":"sv","@value":"Bisexuella personer som tar emot pengar eller varor i utbyte mot sexuella handlingar, framträdanden eller sällskap. Vissa anser termen sexarbetare som kränkade och politiserad, medan andra identifierar sig med den. Se även \"Bisexuella i prostitution"}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001277"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0003758"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualProstitutes"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001277","dc:identifier":"homoit0001277","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ sex workers"},{"@language":"es","@value":"Trabajadores sexuales LGBTQ+"},{"@language":"nl","@value":"LHBTQ+-sekswerkers"},{"@language":"sv","@value":"Sexarbetare (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"LGBTQ+ prostitutes"},{"@language":"en","@value":"LGBTQ+ prostitution"},{"@language":"en","@value":"LGBTQ+ sex work"},{"@language":"en","@value":"Prostitutes (LGBTQ)"},{"@language":"en","@value":"Prostitution (LGBTQ)"},{"@language":"en","@value":"Sex work (LGBTQ)"},{"@language":"es","@value":"Trabajadores sexuales LGBTQ"},{"@language":"es","@value":"Prostitutos LGBTQ+"},{"@language":"es","@value":"Prostitutas LGBTQ+"},{"@language":"es","@value":"Prostitutxs LGBTQ+"},{"@language":"es","@value":"Trabajo sexual LGBTQ+"},{"@language":"nl","@value":"LHBTQ+-prostitué(e)s"},{"@language":"nl","@value":"LHBTQ+-sekswerk"},{"@language":"nl","@value":"Prostitutie (LHBTQ+)"},{"@language":"nl","@value":"Prostitué(e)s (LHBTQ+)"},{"@language":"nl","@value":"Sekswerk (LHBTQ+)"}],"rdfs:comment":[{"@language":"en","@value":"LGBTQ+ people who receive money or goods in exchange for sexual services, performances, or companionship. Use to describe LGBTQ+ people working across the broad spectrum of sex work."},{"@language":"es","@value":"Personas LGBTQ+ que reciben dinero o bienes a cambio de servicios o actuaciones sexuales. Utilícese para describir a las personas LGBTQ+ que trabajan en el amplio espectro del trabajo sexual."},{"@language":"nl","@value":"LHBTQ+-personen die geld of goederen ontvangen in ruil voor seksuele diensten, optredens of gezelschap. Wordt gebruikt om LHBTQ+-personen te beschrijven die in het brede spectrum van sekswerk werken."},{"@language":"sv","@value":"Hbtq+-personer som tar emot pengar eller varor i utbyte mot sexuella handlingar, framträdanden eller sällskap. Används för att beskriva hbtq+-personer som är verksamma inom det breda spektrumet av sexarbete. Vissa anser termen sexarbetare som kränkade och politiserad, medan andra identifierar sig med den. Se även \"Hbtq+-personer i prostitution\"."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0003758"},{"@id":"https://homosaurus.org/v5/homoit0000915"}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000178"},{"@id":"https://homosaurus.org/v5/homoit0000525"},{"@id":"https://homosaurus.org/v5/homoit0000768"},{"@id":"https://homosaurus.org/v5/homoit0001201"},{"@id":"https://homosaurus.org/v5/homoit0001437"},{"@id":"https://homosaurus.org/v5/homoit0003759"},{"@id":"https://homosaurus.org/v5/homoit0003760"},{"@id":"https://homosaurus.org/v5/homoit0003797"},{"@id":"https://homosaurus.org/v5/homoit0003798"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0003262"},{"@id":"https://homosaurus.org/v5/homoit0003761"},{"@id":"https://homosaurus.org/v5/homoit0003762"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0003758"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sexWorkersLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003758","dc:identifier":"homoit0003758","skos:prefLabel":[{"@language":"en","@value":"Sex workers"},{"@language":"nl","@value":"Sekswerkers"},{"@language":"sv","@value":"Sexarbetare"}],"skos:altLabel":[{"@language":"en","@value":"Prostitutes"},{"@language":"en","@value":"Hookers"},{"@language":"en","@value":"Hustlers"},{"@language":"en","@value":"Pros"},{"@language":"nl","@value":"Prostitué(e)s"}],"rdfs:comment":[{"@language":"en","@value":"People who receive money or goods in exchange for sexual services, performances, or companionship. Use to describe people working across the broad spectrum of sex work, and use more specific terms if possible"},{"@language":"nl","@value":"Personen die geld of goederen ontvangen in ruil voor seksuele diensten, optredens of gezelschap. Gebruik om mensen te beschrijven die in het brede spectrum van sekswerk werken, en gebruik indien mogelijk specifiekere termen."},{"@language":"sv","@value":"Personer som tar emot pengar eller varor i utbyte mot sexuella handlingar, framträdanden eller sällskap. Används för att beskriva personer som är verksamma inom det breda spektrumet av sexarbete. Vissa anser termen sexarbetare som kränkade och politiserad, medan andra identifierar sig med den. Se även \"Personer i prostitution\"."}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0001277"},{"@id":"https://homosaurus.org/v5/homoit0001111"},{"@id":"https://homosaurus.org/v5/homoit0001343"},{"@id":"https://homosaurus.org/v5/homoit0000433"},{"@id":"https://homosaurus.org/v5/homoit0000236"},{"@id":"https://homosaurus.org/v5/homoit0000406"},{"@id":"https://homosaurus.org/v5/homoit0003761