90"},{"@id":"https://homosaurus.org/v5/homoit0004491"},{"@id":"https://homosaurus.org/v5/homoit0004492"},{"@id":"https://homosaurus.org/v5/homoit0004493"},{"@id":"https://homosaurus.org/v5/homoit0004495"},{"@id":"https://homosaurus.org/v5/homoit0004496"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0003614"},{"@id":"https://homosaurus.org/v5/homoit0004494"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2026-03-03"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003592","dc:identifier":"homoit0003592","skos:prefLabel":[{"@language":"en","@value":"Queerplatonic relationships"},{"@language":"nl","@value":"Queerplatonische relaties"},{"@language":"sv","@value":"Queera platoniska relationer"}],"skos:altLabel":[{"@language":"en","@value":"QPR"},{"@language":"en","@value":"Queerplatonic partnerships"},{"@language":"en","@value":"QPP"},{"@language":"nl","@value":"QPR"},{"@language":"nl","@value":"Queerplatonische partnerschappen"}],"rdfs:comment":[{"@language":"en","@value":"A term that originated in aromantic and asexual spaces to describe committed intimate relationships between significant others that are not romantic in nature."},{"@language":"nl","@value":"Een term die zijn oorsprong vindt in de aromantische en aseksuele wereld om toegewijde, intieme relaties tussen partners te beschrijven die niet romantisch van aard zijn."},{"@language":"sv","@value":"En term som uppstod inom aromantiska och asexuella gemenskaper för att beskriva engagerade, intima, men inte romantiska, relationer."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001237"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000921"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001237"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-22"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000923","dc:identifier":"homoit0000923","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ porn magazines"},{"@language":"es","@value":"Revistas porno LGBTQ+"},{"@language":"nl","@value":"LHBTQ+-pornobladen"},{"@language":"sv","@value":"Hbtq+-porrtidningar"}],"skos:altLabel":[{"@language":"en","@value":"LGBTQ porn magazines"},{"@language":"es","@value":"Revistas pornográficas (LGBTQ)"},{"@language":"es","@value":"Revistas pornográficas LGBTQ+"}],"rdfs:comment":[{"@language":"en","@value":"Erotic or sexually explicit magazines featuring LGBTQ+ people."},{"@language":"es","@value":"Revistas eróticas o sexualmente explícitas protagonizadas por personas LGBTQ+."},{"@language":"nl","@value":"Erotische of seksueel expliciete tijdschriften voor LHBTQ+-personen."},{"@language":"sv","@value":"Erotiska eller sexuellt explicita tidskrifter med hbtq+-personer."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001132"},{"@id":"https://homosaurus.org/v5/homoit0003802"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001126"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001132"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQPornMagazines"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000926","dc:identifier":"homoit0000926","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ Quakers"},{"@language":"es","@value":"Cuáqueros LGBTQ+"},{"@language":"ja","@value":"LGBTQ+のクエーカー教徒"},{"@language":"nl","@value":"LHBTQ+-Quakers"},{"@language":"sv","@value":"Kväkare (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"LGBTQ Religious Society of Friends"},{"@language":"en","@value":"LGBTQ Society of Friends"},{"@language":"en","@value":"Quakers (LGBTQ)"},{"@language":"en","@value":"LGBTQ Quakers"},{"@language":"nl","@value":"LHBTQ+ Society of Friends"},{"@language":"nl","@value":"Quakers (LHBTQ+)"}],"rdfs:comment":[{"@language":"en","@value":"LGBTQ+ people who are Quakers."},{"@language":"es","@value":"Personas LGBTQ+ que son cuáqueras."},{"@language":"ja","@value":"クエーカー教徒であるLGBTQ+の人々。"},{"@language":"nl","@value":"LGBTQ+-personen die Quaker zijn."},{"@language":"sv","@value":"Hbtq+-personer som är kväkare."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001137"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000928"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQQuakers"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004520","dc:identifier":"homoit0004520","skos:prefLabel":{"@language":"en","@value":"LGBTQ+ forcibly displaced people"},"rdfs:comment":{"@language":"en","@value":"LGBTQ+ people who have been forced to flee their home or place of habitual residence due to war or armed conflict, persecution, violence, natural disasters, or other forms of conflict, regardless of whether they have crossed an international border."},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000927"},{"@id":"https://homosaurus.org/v5/homoit0001853"},{"@id":"https://homosaurus.org/v5/homoit0004519"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0004520"},"dc:issued":{"@type":"xsd:date","@value":"2026-05-18"},"dc:modified":{"@type":"xsd:date","@value":"2026-05-18"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000939","dc:identifier":"homoit0000939","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ shamans"},{"@language":"es","@value":"Chamanes LGBTQ+"},{"@language":"nl","@value":"LHBTQ+-sjamanisten"},{"@language":"sv","@value":"Shamaner (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"Shamans (LGBTQ)"},{"@language":"en","@value":"LGBTQ shamans"},{"@language":"es","@value":"Chamanes LGBTQ"},{"@language":"es","@value":"Chamanes (LGBTQ)"},{"@language":"sv","@value":"Schamaner (hbtq+)"}],"rdfs:comment":[{"@language":"en","@value":"LGBTQ+ people who are shamans either through traditional community practices or self-designation."},{"@language":"es","@value":"Personas LGBTQ+ que son chamanes ya sea a través de prácticas comunitarias tradicionales o por autodesignación."},{"@language":"nl","@value":"LHBTQ+-personen die sjamaan zijn, hetzij door traditionele gemeenschapspraktijken of door zelfbenoeming."},{"@language":"sv","@value":"Hbtq+-personer som är shamaner, antingen genom traditionella samhällsroller eller genom egenidentifikation."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000928"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000928"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQShamans"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000940","dc:identifier":"homoit0000940","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ Shintoists"},{"@language":"es","@value":"Sintoístas LGBTQ+"},{"@language":"ja","@value":"LGBTQ+の神道信者"},{"@language":"nl","@value":"LHBTQ+-shintoïsten"},{"@language":"sv","@value":"Shintoism (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"LGBTQ Shinto"},{"@language":"en","@value":"Shintoists (LGBTQ)"},{"@language":"en","@value":"LGBTQ Shintoists"},{"@language":"es","@value":"Sintoístas LGBTQ"},{"@language":"ja","@value":"LGBTQの神道信者"},{"@language":"ja","@value":"神道信者（LGBTQ）"}],"rdfs:comment":[{"@language":"en","@value":"LGBTQ+ people who are Shintoists."},{"@language":"es","@value":"Personas LGBTQ+ que son sintoístas."},{"@language":"ja","@value":"神道を信仰するLGBTQ+の人々。"},{"@language":"nl","@value":"LHBTQ+-personen die Shintoïst zijn."},{"@language":"sv","@value":"Hbtq+-personer som är shintoister."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000928"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000928"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQShintoists"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000955","dc:identifier":"homoit0000955","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ Taoists"},{"@language":"es","@value":"Taoístas LGBTQ+"},{"@language":"ja","@value":"LGBTQ+の道教徒"},{"@language":"nl","@value":"LHBTQ+-taoïsten"},{"@language":"sv","@value":"Taoister (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"Taoists (LGBTQ)"},{"@language":"en","@value":"LGBTQ Taoists"},{"@language":"en","@value":"LGBTQの道教徒"},{"@language":"es","@value":"Taoístas LGBTQ"},{"@language":"es","@value":"Taoístas (LGBTQ)"},{"@language":"ja","@value":"道教徒（LGBTQ）"}],"rdfs:comment":[{"@language":"en","@value":"LGBTQ+ people who are Taoists."},{"@language":"es","@value":"Personas LGBTQ+ que son taoístas."},{"@language":"ja","@value":"道教を信仰するLGBTQ+の人々。"},{"@language":"nl","@value":"LHBTQ+-personen die taoïst zijn."},{"@language":"sv","@value":"Hbtq+-personer som är taoister."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000928"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000928"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQTaoists"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003347","dc:identifier":"homoit0003347","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ Unitarian Universalists"},{"@language":"ja","@value":"LGBTQ+のユニテリアン・ユニバーサリスト"},{"@language":"es","@value":"Unitarios universalistas LGBTQ+"},{"@language":"nl","@value":"LHBTQ+-Unitarische Universalisten"},{"@language":"sv","@value":"Unitariska universalister (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"LGBTQ Unitarian Universalists"},{"@language":"en","@value":"Unitarian Universalist LGBTQ+ people"},{"@language":"ja","@value":"LGBTQユニテリアン・ユニバーサリスト"},{"@language":"es","@value":"Personas unitarias universalistas LGBTQ+"},{"@language":"es","@value":"Unitarias universalistas LGBTQ+"}],"rdfs:comment":[{"@language":"en","@value":"LGBTQ+ people who are members of the Unitarian Universalist church."},{"@language":"ja","@value":"ユニテリアン・ユニバーサリスト教会の会員であるLGBTQ+の人々。"},{"@language":"es","@value":"Personas LGBTQ+ que son miembros de la Iglesia Unitaria Universalista."},{"@language":"nl","@value":"LHBTQ+-personen die lid zijn van de Unitarian Universalist Church."},{"@language":"sv","@value":"Hbtq+-personer som är medlemmar i den främst amerikanska Unitarian Universalist-kyrkan."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000928"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0003348"},{"@id":"https://homosaurus.org/v5/homoit0003349"},{"@id":"https://homosaurus.org/v5/homoit0003350"},{"@id":"https://homosaurus.org/v5/homoit0003351"},{"@id":"https://homosaurus.org/v5/homoit0003352"},{"@id":"https://homosaurus.org/v5/homoit0003353"},{"@id":"https://homosaurus.org/v5/homoit0003354"},{"@id":"https://homosaurus.org/v5/homoit0003355"},{"@id":"https://homosaurus.org/v5/homoit0003356"},{"@id":"https://homosaurus.org/v5/homoit0003357"},{"@id":"https://homosaurus.org/v5/homoit0003358"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000928"},"dc:issued":{"@type":"xsd:date","@value":"2024-06-19"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000948","dc:identifier":"homoit0000948","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ spiritual people"},{"@language":"es","@value":"Personas espirituales LGBTQ+"},{"@language":"nl","@value":"LHBTQ+-spirituele personen"},{"@language":"sv","@value":"Andliga hbtq+-personer"}],"skos:altLabel":[{"@language":"en","@value":"LGBTQ+ spirituality"},{"@language":"es","@value":"Espiritualidad LGBTQ+"},{"@language":"es","@value":"Espirtualidad LGBTQ"},{"@language":"sv","@value":"Andlighet (hbtq+)"}],"rdfs:comment":[{"@language":"en","@value":"LGBTQ+ people who hold spiritual beliefs or engage in spiritual practices, typically involving an understanding of something greater than human existence, whether divine or cosmic in nature."},{"@language":"es","@value":"Personas LGBTQ+ que tienen creencias espirituales o participan en prácticas espirituales, que generalmente implican una comprensión de algo más grande que la existencia humana, ya sea de naturaleza divina o cósmica."},{"@language":"nl","@value":"LHBTQ+-personen die spirituele overtuigingen hebben of zich bezighouden met spirituele praktijken, meestal met begrip van iets dat groter is dan het menselijk bestaan, of het nu goddelijk of kosmisch van aard is."},{"@language":"sv","@value":"Hbtq+-personer som har andlig tro eller ägnar sig åt andliga praktiker, vanligtvis med en uppfattning om något större än den mänskliga existensen, vare sig det är gudomligt eller kosmiskt."}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000928"},{"@id":"https://homosaurus.org/v5/homoit0001218"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000948"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQSpirituality"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001218","dc:identifier":"homoit0001218","skos:prefLabel":[{"@language":"en","@value":"Queer theology"},{"@language":"es","@value":"Teología queer"},{"@language":"nl","@value":"Queer theologie"},{"@language":"sv","@value":"Queerteologi"}],"skos:altLabel":[{"@language":"en","@value":"Gay theology"},{"@language":"en","@value":"LGBTQ+ theology"},{"@language":"en","@value":"Lesbian theology"},{"@language":"es","@value":"Teología gay"},{"@language":"es","@value":"Teología LGBTQ+"},{"@language":"es","@value":"Teología lesbiana"},{"@language":"nl","@value":"Homotheologie"},{"@language":"nl","@value":"Lesbische theologie"},{"@language":"nl","@value":"LHBTQ+-theologie"}],"rdfs:comment":[{"@language":"en","@value":"A theological method that developed out of queer theory. Queer theology, which encompasses the previously commonly used terms gay theology and lesbian theology, can variously be understood as (1) theology done by, with, and for LGBTQ+ people according to their needs; (2) theology that purposefully opposes social and cultural norms surrounding gender and sexuality; and (3) theology that broadly challenges and deconstructs harmful historical boundaries."},{"@language":"es","@value":"Un método teológico que se desarrolló a partir de la teoría queer. La teología queer, que abarca los términos previa y comúnmente utilizados de teología gay y teología lesbiana, puede entenderse de diversas formas, como (1) teología realizada por, con y para personas LGBTQ+ de acuerdo a sus necesidades; (2) teología que se opone deliberadamente a las normas sociales y culturales con respecto al género y la sexualidad; y (3) teología que desafía y deconstruye de forma abarcadora fronteras históricas dañinas."},{"@language":"nl","@value":"Een theologische methode die voort komt uit de queer theory. Queer-theologie, die de voorheen veelgebruikte termen homotheologie en lesbische theologie omvat, kan op verschillende manieren worden opgevat als (1) theologie die wordt gedaan door, met en voor LHBTQ+-personen op basis van hun behoeften; (2) theologie die doelbewust de sociale en culturele normen rond gender en seksualiteit tegenwerkt; en (3) theologie die in grote lijnen schadelijke historische grenzen uitdaagt en deconstrueert"},{"@language":"sv","@value":"Teologisk metod som har utvecklats ur queerteori. Queerteologi, som även omfattar de tidigare vanligt förekommande termerna ”gay theology” och ”lesbian theology”, kan förstås som (1) teologi som bedrivs av, med och för hbtq+-personer utifrån deras behov, (2) teologi som medvetet motsätter sig sociala och kulturella normer kring kön och sexualitet och (3) teologi som i bred mening utmanar och dekonstruerar skadliga historiska gränsdragningar."}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000928"},{"@id":"https://homosaurus.org/v5/homoit0000948"},{"@id":"https://homosaurus.org/v5/homoit0001219"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2010014738"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001218"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerTheology"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000933","dc:identifier":"homoit0000933","skos:prefLabel":[{"@language":"en","@value":"Schools for LGBTQ+ youth"},{"@language":"es","@value":"Escuelas para la juventud LGBTQ+"},{"@language":"nl","@value":"Scholen voor LHBTQ+-jongeren"},{"@language":"sv","@value":"Skolor för hbtq+-ungdomar"}],"skos:altLabel":[{"@language":"en","@value":"LGBTQ schools"},{"@language":"en","@value":"Schools for LGBTQ youth"},{"@language":"es","@value":"Escuelas LGBTQ+"},{"@language":"es","@value":"Escuelas LGBTQ"}],"rdfs:comment":[{"@language":"en","@value":"Educational institutions providing instruction and resources specifically for LGBTQ+ youth."},{"@language":"es","@value":"Instituciones educativas que brindan instrucción y recursos específicamente para jóvenes LGBTQ+."},{"@language":"nl","@value":"Onderwijsinstellingen die instructie en middelen bieden specifiek voor LHBTQ+-jongeren."},{"@language":"sv","@value":"Utbildningsinstitutioner som erbjuder undervisning och resurser specifikt för hbtq+-ungdomar."}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001521"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000933"},"dc:replaces":{"@id":"http://homosaurus.org/v2/schoolsForLGBTQYouth"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001573","dc:identifier":"homoit0001573","skos:prefLabel":[{"@language":"en","@value":"Transgender science fiction"},{"@language":"es","@value":"Ciencia ficción transgénero"},{"@language":"de","@value":"trans Science-Fiction"},{"@language":"nl","@value":"Transgender science fiction"},{"@language":"sv","@value":"Science fiction om transpersoner och transteman"}],"skos:altLabel":[{"@language":"en","@value":"Trans science fiction"},{"@language":"sv","@value":"Sci fi om transpersoner och transteman"},{"@language":"sv","@value":"Sf om transpersoner och transteman"}],"rdfs:comment":[{"@language":"en","@value":"Genre of written works that depicts imaginative or futuristic concepts incorporating science, technology, space, time travel, and other speculative elements. Use for science fiction focusing on transgender characters or themes."},{"@language":"es","@value":"Obras literarias escritas sobre conceptos imaginativos o futuristas que incorporen la ciencia, la tecnología, el espacio, los viajes en el tiempo y otros elementos especulativos; utilícese en referencia a la ciencia ficción centrada en personajes y temas transgénero."},{"@language":"de","@value":"Werk über phantasievolle oder futuristische Konzepte, die Wissenschaft, Technologie, Raumfahrt, Zeitreisen und andere spekulative Elemente beinhalten; Verwendung in Bezug auf Science Fiction mit einem Schwerpunkt auf trans Charakteren oder Themen."},{"@language":"nl","@value":"Geschreven literair werk over fantasierijke of futuristische concepten waarin wetenschap, technologie, ruimte, tijdreizen en andere speculatieve elementen zijn verwerkt; gebruik in verwijzing naar science fiction gericht op transgender personages of thema's."},{"@language":"sv","@value":"Skönlitterära verk om imaginära eller futuristiska koncept som involverar vetenskap, teknologi, rymden, tidsresor och andra spekulativa element. Används för science fiction med transkaraktärer eller transfokuserade teman."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000934"},{"@id":"https://homosaurus.org/v5/homoit0001414"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transgenderScienceFiction"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-03"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001574","dc:identifier":"homoit0001574","skos:prefLabel":[{"@language":"en","@value":"Queer science fiction"},{"@language":"es","@value":"Ciencia ficción queer"},{"@language":"de","@value":"Queere Science-Fiction"},{"@language":"nl","@value":"Queer science fiction"},{"@language":"sv","@value":"Queer science fiction"}],"skos:altLabel":[{"@language":"sv"