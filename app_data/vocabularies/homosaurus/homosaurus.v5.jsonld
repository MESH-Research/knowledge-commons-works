inom fandom"}],"skos:altLabel":[{"@language":"en","@value":"Bisexuals in fandom"},{"@language":"de","@value":"Bisexuelle Personen im Fantum"},{"@language":"es","@value":"Bisexuales en fandom"}],"rdfs:comment":[{"@language":"en","@value":"The participation and inclusion of bisexual people in fan communities."},{"@language":"de","@value":"Die Teilnahme und Einbeziehung bisexueller Personen in Fan-Communitys."},{"@language":"es","@value":"La participación e inclusión de personas bisexuales en las comunidades de fans."},{"@language":"nl","@value":"De participatie en inclusie van biseksuele personen in fan-gemeenschappen"},{"@language":"sv","@value":"Bisexuellas deltagande och inkludering i fangemenskaper."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002181"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000151"},{"@id":"https://homosaurus.org/v5/homoit0000170"},{"@id":"https://homosaurus.org/v5/homoit0001726"},{"@id":"https://homosaurus.org/v5/homoit0001754"},{"@id":"https://homosaurus.org/v5/homoit0002506"},{"@id":"https://homosaurus.org/v5/homoit0002535"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002535","dc:identifier":"homoit0002535","skos:prefLabel":[{"@language":"en","@value":"Greyromantic fiction"},{"@language":"es","@value":"Ficción grisromántica"},{"@language":"nl","@value":"Grijsromantische fictie"},{"@language":"sv","@value":"Gråromantisk skönlitteratur"}],"skos:altLabel":{"@language":"sv","@value":"Greyromantic-skönlitteratur"},"rdfs:comment":[{"@language":"en","@value":"Genre of written works that depicts imagined events or people. Use for fiction focusing on greyromantic characters or themes.\t"},{"@language":"es","@value":"Obras escritas que describen eventos o personas imaginadas; utilícese en referencia a obras de ficción que se centran en personajes o temas grisrománticos."},{"@language":"nl","@value":"Geschreven werken waarin ingebeelde gebeurtenissen of mensen worden beschreven; gebruik met betrekking tot fictieve werken die zich richten op grijsromantische personages of thema's."},{"@language":"sv","@value":"Litterära verk som beskriver fiktiva händelser eller personer. Används för skönlitteratur med gråromantiska karaktärer eller teman."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000443"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0002517"},{"@id":"https://homosaurus.org/v5/homoit0002518"},{"@id":"https://homosaurus.org/v5/homoit0002520"},{"@id":"https://homosaurus.org/v5/homoit0002519"},{"@id":"https://homosaurus.org/v5/homoit0002516"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000151"},{"@id":"https://homosaurus.org/v5/homoit0001752"},{"@id":"https://homosaurus.org/v5/homoit0001754"},{"@id":"https://homosaurus.org/v5/homoit0002150"},{"@id":"https://homosaurus.org/v5/homoit0002534"},{"@id":"https://homosaurus.org/v5/homoit0002537"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-11"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000590","dc:identifier":"homoit0000590","skos:prefLabel":[{"@language":"en","@value":"Girls"},{"@language":"de","@value":"Mädchen"},{"@language":"es","@value":"Niñas"},{"@language":"fr","@value":"Filles"},{"@language":"nl","@value":"Meiden"},{"@language":"sv","@value":"Flickor"}],"skos:altLabel":{"@language":"sv","@value":"Tjejer"},"rdfs:comment":[{"@language":"en","@value":"Children or youth, typically younger than 18 years old, who identify as girls."},{"@language":"de","@value":"Kinder oder Jugendliche, in der Regel unter 18 Jahren, die sich als Mädchen identifizieren."},{"@language":"es","@value":"Niñas menores de 18 años que se autoidentifican como niñas."},{"@language":"fr","@value":"Enfants ou jeunes, généralement âgées de moins de 18 ans et qui s'identifient comme des filles."},{"@language":"nl","@value":"Kinderen of jongeren, doorgaans jonger dan 18 jaar, die zich identificeren als meiden."},{"@language":"sv","@value":"Barn eller ungdomar (vanligtvis under 18 år) som identifierar sig som flickor."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000255"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000152"},{"@id":"https://homosaurus.org/v5/homoit0000623"},{"@id":"https://homosaurus.org/v5/homoit0000743"},{"@id":"https://homosaurus.org/v5/homoit0001374"},{"@id":"https://homosaurus.org/v5/homoit0002284"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000563"},{"@id":"https://homosaurus.org/v5/homoit0000591"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85055012"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000421"},"dc:replaces":{"@id":"http://homosaurus.org/v2/girls"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004466","dc:identifier":"homoit0004466","skos:prefLabel":[{"@language":"en","@value":"Bisexual erasure"},{"@language":"nl","@value":"Biseksuele uitwissing"},{"@language":"sv","@value":"Osynliggörande av bisexualitet"}],"skos:altLabel":[{"@language":"en","@value":"Bi erasure"},{"@language":"en","@value":"Bisexual invisibility"},{"@language":"en","@value":"Bi invisibility"},{"@language":"nl","@value":"Bi uitwissing"},{"@language":"nl","@value":"Biseksuele onzichtbaarheid"},{"@language":"sv","@value":"Utsuddning av bisexualitet"},{"@language":"sv","@value":"Bi-erasure"},{"@language":"sv","@value":"Bisexuell radering"}],"rdfs:comment":[{"@language":"en","@value":"Denying, dismissing, and/or questioning the existence of bisexuality as a legitimate sexual orientation. Bisexual erasure also includes the pervasive mislabeling of bisexual people as either straight or gay based on the identity of their past and present partner(s) and/or claiming bisexual people are confused, straight and going through a phase, or in denial about being gay. This stigma occurs within and outside of LGBTQ+ communities, contributing to adverse mental health outcomes."},{"@language":"nl","@value":"Het ontkennen, afwijzen en/of in twijfel trekken van het bestaan ​​van biseksualiteit als een legitieme seksuele oriëntatie. Biseksuele uitwissing omvat ook het wijdverbreide verkeerd labelen van biseksuele mensen als hetero of homo op basis van de identiteit van hun vroegere en huidige partner(s) en/of de bewering dat biseksuele mensen in de war zijn, hetero zijn en een fase doormaken, of ontkennen dat ze homo zijn. Dit stigma komt voor binnen en buiten de LGBTQ+-gemeenschappen en draagt ​​bij aan negatieve gevolgen voor de geestelijke gezondheid."},{"@language":"sv","@value":"Att förneka, avfärda och/eller ifrågasätta bisexualitet som en legitim sexuell läggning. Osynliggörande av bisexualitet inkluderar även den utbredda felaktiga beteckningen av bisexuella personer som antingen heterosexuella eller homosexuella baserat på identiteten på deras tidigare och nuvarande partner(s) och/eller påståendet att bisexuella personer är förvirrade, heterosexuella och går igenom en fas, eller förnekar att de är homosexuella. Detta stigma förekommer både inom och utanför hbtq+-gemenskaper och bidrar till negativa psykiska hälsoeffekter."}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000153"},{"@id":"https://homosaurus.org/v5/homoit0001103"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0004466"},"dc:issued":{"@type":"xsd:date","@value":"2026-02-24"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000154","dc:identifier":"homoit0000154","skos:prefLabel":[{"@language":"en","@value":"Jewish bisexual people"},{"@language":"es","@value":"Personas bisexuales judías"},{"@language":"nl","@value":"Joodse biseksuele personen"},{"@language":"sv","@value":"Bisexuella judar"}],"skos:altLabel":[{"@language":"en","@value":"Bisexual Jews"},{"@language":"en","@value":"Jewish bisexuals"},{"@language":"es","@value":"Judíos bisexuales"},{"@language":"es","@value":"Bisexuales judíos"},{"@language":"nl","@value":"Joodse biseksuelen"},{"@language":"sv","@value":"Judiska bisexuella"}],"rdfs:comment":[{"@language":"en","@value":"Bisexual people who are Jewish."},{"@language":"es","@value":"Personas bisexuales que son judías."},{"@language":"nl","@value":"Biseksuele personen die joods zijn"},{"@language":"sv","@value":"Bisexuella personer som är judar."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000682"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2019000135"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualJews"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000682","dc:identifier":"homoit0000682","skos:prefLabel":[{"@language":"en","@value":"Jewish LGBTQ+ people"},{"@language":"es","@value":"Personas LGBTQ+ judías"},{"@language":"nl","@value":"Joodse LHBTQ+-personen"},{"@language":"sv","@value":"Judiska hbtq+-personer"}],"skos:altLabel":[{"@language":"en","@value":"Jews (LGBTQ)"},{"@language":"en","@value":"LGBTQ+ Jews"},{"@language":"es","@value":"Judíos (LGBTQ)"},{"@language":"es","@value":"Judíos (LGBTQ+)"},{"@language":"nl","@value":"LHBTQ+-Joden"}],"rdfs:comment":[{"@language":"en","@value":"LGBTQ+ people who are Jewish."},{"@language":"es","@value":"Personas LGBTQ + que son judías."},{"@language":"nl","@value":"LHBTQ+-personen die joods zijn"},{"@language":"sv","@value":"Hbtq+-personer som är judar."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000860"},{"@id":"https://homosaurus.org/v5/homoit0000928"}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000154"},{"@id":"https://homosaurus.org/v5/homoit0000497"},{"@id":"https://homosaurus.org/v5/homoit0000745"},{"@id":"https://homosaurus.org/v5/homoit0001180"},{"@id":"https://homosaurus.org/v5/homoit0001416"},{"@id":"https://homosaurus.org/v5/homoit0002767"},{"@id":"https://homosaurus.org/v5/homoit0002908"},{"@id":"https://homosaurus.org/v5/homoit0003411"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2008007442"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/jewsLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000155","dc:identifier":"homoit0000155","skos:prefLabel":[{"@language":"en","@value":"Latino/a/x bisexual people"},{"@language":"de","@value":"Bisexuelle Latino/-a/-x-Personen"},{"@language":"es","@value":"Personas bisexuales Latinx"},{"@language":"nl","@value":"Latino/a/x biseksuele personen"},{"@language":"sv","@value":"Bisexuella latines"}],"skos:altLabel":[{"@language":"en","@value":"Bisexual Latinas"},{"@language":"en","@value":"Bisexual Latine people"},{"@language":"en","@value":"Bisexual Latinos"},{"@language":"en","@value":"Bisexual Latinx people"},{"@language":"en","@value":"Latina bisexual people"},{"@language":"en","@value":"Latine bisexual people"},{"@language":"en","@value":"Latino bisexual people"},{"@language":"en","@value":"Latinx bisexual people"},{"@language":"de","@value":"Bisexuelle Latinos"},{"@language":"de","@value":"Bisexuelle Latinas"},{"@language":"de","@value":"Bisexuelle Latinx"},{"@language":"es","@value":"Personas Latinx bisexuales"},{"@language":"es","@value":"Latinos bisexuales"},{"@language":"es","@value":"Latinas bisexuales"},{"@language":"es","@value":"Latinx bisexuales"},{"@language":"es","@value":"Latines bisexuales"},{"@language":"nl","@value":"Biseksuele Latino's"},{"@language":"nl","@value":"Biseksuele Latinx personen"},{"@language":"nl","@value":"Latina biseksuelen"},{"@language":"nl","@value":"Latino biseksuelen"},{"@language":"nl","@value":"Latino/a/x biseksuelen"},{"@language":"nl","@value":"Latinx biseksuelen"},{"@language":"sv","@value":"Latino/a/x bisexuella"}],"rdfs:comment":[{"@language":"en","@value":"Latin American people who are bisexual; only use to describe individuals who self-identify as Latino, Latina, or Latinx. Do not conflate with Chicano/a/x or Hispanic."},{"@language":"de","@value":"Bisexuelle Personen lateinamerikanischer Herkunft; dieser Begriff bezieht sich ausschließlich auf Personen, die sich selbst als Latino, Latina oder Latinx bezeichnen. Nicht mit Chicano/a/x oder Hispanic zu verwechseln."},{"@language":"es","@value":"Personas latinoamericanas que son bisexuales; utilícese únicamente para describir a personas que se autoidentifican como latinos, latinas o latinxs. No debe confundirse con chicano/a/x o hispano/a/x."},{"@language":"nl","@value":"Latijns-Amerikaanse mensen die biseksueel zijn; alleen gebruiken om personen te beschrijven die zichzelf identificeren als Latino, Latina of Latinx. Niet verwarren met Chicano/a/x of Hispanic"},{"@language":"sv","@value":"Bisexuella personer som är latinamerikaner och som själva identifierar sig som latines (latino, latina eller latinx). Blanda inte ihop med chicano/a/x eller hispanic."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000253"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualLatinx"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000156","dc:identifier":"homoit0000156","skos:prefLabel":[{"@language":"en","@value":"Bisexual libraries"},{"@language":"de","@value":"Bisexuelle Bibliotheken"},{"@language":"es","@value":"Bibliotecas bisexuales"},{"@language":"nl","@value":"Biseksuele bibliotheken"},{"@language":"sv","@value":"Bisexuella bibliotek"}],"skos:altLabel":[{"@language":"de","@value":"Bibliotheken für Bisexuelle"},{"@language":"de","@value":"Bi-Bibliotheken"}],"rdfs:comment":[{"@language":"en","@value":"Libraries that hold materials primarily pertaining to bisexual people or intended for use by bisexual people."},{"@language":"de","@value":"Bibliotheken, die in erster Linie Materialien zu bisexuellen Menschen und Themen oder für die Nutzung durch bisexuelle Menschen bereithalten."},{"@language":"es","@value":"Bibliotecas que contienen materiales principalmente relacionados con personas bisexuales o destinados a personas bisexuales."},{"@language":"nl","@value":"Bibliotheken met materiaal dat voornamelijk betrekking heeft op biseksuele personen of bedoeld is voor gebruik door biseksuele personen"},{"@language":"sv","@value":"Bibliotek som samlar material som främst rör bisexuella personer eller är avsett att användas av bisexuella personer."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000968"},"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2021005780"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001755"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualLibraries"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000972","dc:identifier":"homoit0000972","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ literature"},{"@language":"es","@value":"Literatura LGBTQ+"},{"@language":"nl","@value":"LHBTQ+-letteren"},{"@language":"sv","@value":"Hbtq+-litteratur"}],"skos:altLabel":[{"@language":"en","@value":"Literature (LGBTQ)"},{"@language":"es","@value":"Literatura LGBTQ"},{"@language":"sv","@value":"Litteratur (hbtq+)"}],"rdfs:comment":[{"@language":"en","@value":"Written literary works featuring LGBTQ+ characters and themes."},{"@language":"es","@value":"Obras literarias escritas con personajes y temas LGBTQ+."},{"@language":"nl","@value":"Geschreven literaire werken over LHBTQ+-personages of LHBTQ+-thema's."},{"@language":"sv","@value":"Skrivna litterära verk om hbtq+-karaktärer och teman."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001831"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000157"},{"@id":"https://homosaurus.org/v5/homoit0000376"},{"@id":"https://homosaurus.org/v5/homoit0000443"},{"@id":"https://homosaurus.org/v5/homoit0000502"},{"@id":"https://homosaurus.org/v5/homoit0000750"},{"@id":"https://homosaurus.org/v5/homoit0001118"},{"@id":"https://homosaurus.org/v5/homoit0001183"},{"@id":"https://homosaurus.org/v5/homoit0001419"},{"@id":"https://homosaurus.org/v5/homoit0001522"},{"@id":"https://homosaurus.org/v5/homoit0002449"},{"@id":"https://homosaurus.org/v5/homoit0002467"},{"@id":"https://homosaurus.org/v5/homoit0002484"},{"@id":"https://homosaurus.org/v5/homoit0002507"},{"@id":"https://homosaurus.org/v5/homoit0002537"},{"@id":"https://homosaurus.org/v5/homoit0002750"},{"@id":"https://homosaurus.org/v5/homoit0003488"},{"@id":"https://homosaurus.org/v5/homoit0003822"},{"@id":"https://homosaurus.org/v5/homoit0003866"},{"@id":"https://homosaurus.org/v5/homoit0003911"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000816"},{"@id":"https://homosaurus.org/v5/homoit0000827"},{"@id":"https://homosaurus.org/v5/homoit0000891"},{"@id":"https://homosaurus.org/v5/homoit0000892"},{"@id":"https://homosaurus.org/v5/homoit0001132"},{"@id":"https://homosaurus.org/v5/homoit0001149"},{"@id":"https://homosaurus.org/v5/homoit0001602"},{"@id":"https://homosaurus.org/v5/homoit0001723"},{"@id":"https://homosaurus.org/v5/homoit0001755"},{"@id":"https://homosaurus.org/v5/homoit0002192"},{"@id":"https://homosaurus.org/v5/homoit0002710"},{"@id":"https://homosaurus.org/v5/homoit0003618"},{"@id":"https://homosaurus.org/v5/homoit0004018"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/literatureLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000174","dc:identifier":"homoit0000174","skos:prefLabel":[{"@language":"en","@value":"Bisexual poetry"},{"@language":"de","@value":"Bisexuelle Dichtung"},{"@language":"es","@value":"Poesía bisexual"},{"@language":"nl","@value":"Biseksuele poëzie"},{"@language":"sv","@value":"Bisexuell poesi"}],"skos:altLabel":[{"@language":"de","@value":"Bisexuelle Lyrik"},{"@language":"de","@value":"Bisexuelle Poesie"},{"@language":"sv","@value":"Bisexuell lyrik"}],"rdfs:comment":[{"@language":"en","@value":"Literary work, typically written in verse, that focuses on bisexual characters, themes, or identity."},{"@language":"de","@value":"Literarisches Werk, in der Regel in Versen geschrieben, das sich mit bisexuellen Charakteren, Themen oder bisexueller Identität beschäftigt."},{"@language":"es","@value":"Obras literarias, normalmente escritas en verso, que se centran en personajes, temas o identidades bisexuales."},{"@language":"nl","@value":"Literair werk, meestal in verzen geschreven, dat zich richt op biseksuele personages, thema's of identiteit."},{"@language":"sv","@value":"Lyriska verk med fokus på på bisexuella karaktärer, teman eller identitet."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001118"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000157"},{"@id":"https://homosaurus.org/v5/homoit0001726"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualPoetry"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004021","dc:identifier":"homoit0004021","skos:prefLabel":[{"@language":"en","@value":"Bisexual people in literature"},{"@language":"nl","@value":"Biseksuele personen in de literatuur"},{"@language":"sv","@value":"Bisexuella i litteraturen"}],"skos:altLabel":{"@language":"en","@value":"Bi people in literature"},"rdfs:comment":[{"@language":"en","@value":"The depiction of bisexual people in literature."},{"@language":"nl","@value":"Het weergeven van biseksuele personen in de literatuur."},{"@language":"sv","@value":"Skildringen av bisexuella i litteraturen."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0004018"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000157"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2025-04-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000158","dc:identifier":"homoit0000158","skos:prefLabel":[{"@language":"en","@value":"Mixed-orientation marriage"},{"@language":"es","@value":"Matrimonio de orientación mixta"},{"@language":"nl","@value":"Huwelijk met gemengde oriëntatie"},{"@language":"sv","@value":"Blandäktenskap (sexuell läggning)"}],"skos:altLabel":[{"@language":"en","@value":"Bisexual marriage"},{"@language":"es","@value":"Casamiento bisexual"},{"@language":"es","@value":"Casamiento de orientación mixta"},{"@language":"sv","@value":"Konventionsäktenskap"}],"rdfs:comment":[{"@language":"en","@value":"Marriages between individuals who do not share the same sexual orientation (e.g., bisexual-heterosexual marriage, allosexual-asexual marriage)."},{"@language":"es","@value":"Matrimonios entre personas que no comparten la misma orientación sexual (por ejemplo, matrimonio bisexual-heterosexual, matrimonio alosexual-asexual)."},{"@language":"nl","@value":"Huwelijken tussen personen die niet dezelfde seksuele oriëntatie hebben (bijv. biseksueel-heteroseksueel huwelijk, alloseksueel-aseksueel huwelijk)."},{"@language":"sv","@value":"Äktenskap mellan personer med olika sexuell läggning (t.ex. bisexuell och heterosexuell, allosexuell och asexuell)."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000990"},"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0004332"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000973"},"dc:replaces":{"@id":"http://homosaurus.org/v2/mixed-orientationMarriage"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000990","dc:identifier":"homoit0000990","skos:prefLabel":[{"@language":"en","@value":"Marriage"},{"@language":"es","@value":"Matrimonio"},{"@language":"nl","@value":"Huwelijk"},{"@language":"sv","@value":"Äktenskap"}],"skos:altLabel":{"@language":"es","@value":"Casamiento"},"rdfs:comment":[{"@language":"en","@value":"Legal union between two or more people in a personal relationship that may or may not grant certain economic, legal, and social rights."},{"@language":"es","@value":"Unión jurídica entre dos o más personas en una relación personal que puede o no otorgar ciertos derechos económicos, legales y sociales."},{"@language":"nl","@value":"Wettelijke verbintenis tussen twee of meer mensen in een persoonlijke relatie die al dan niet bepaalde economische, wettelijke en sociale rechten verleent."},{"@language":"sv","@value":"Juridisk samlevnadsform mellan två eller flera personer i en personlig relation, som kan ge vissa ekonomiska, juridiska eller sociala rättigheter."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000973"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000158"},{"@id":"https://homosaurus.org/v5/homoit0000296"},{"@id":"https://homosaurus.org/v5/homoit0000504"},{"@id":"https://homosaurus.org/v5/homoit0000625"},{"@id":"https://homosaurus.org/v5/homoit0000854"},{"@id":"https://homosaurus.org/v5/homoit0000937"},{"@id":"https://homosaurus.org/v5/homoit0000989"},{"@id":"https://homosaurus.org/v5/homoit0000991"},{"@id":"https://homosaurus.org/v5/homoit0000993"},{"@id":"https://homosaurus.org/v5/homoit0001514"},{"@id":"https://homosaurus.org/v5/homoit0004411"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000247"},{"@id":"https://homosaurus.org/v5/homoit0000274"},{"@id":"https://homosaurus.org/v5/homoit0000360"},{"@id":"https://homosaurus.org/v5/homoit0000362"},{"@id":"https://homosaurus.org/v5/homoit0000963"},{"@id":"https://homosaurus.org/v5/homoit0000992"},{"@id":"https://homosaurus.org/v5/homoit0001053"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85081416"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000973"},"dc:replaces":{"@id":"http://homosaurus.org/v2/marriage"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004332","dc:identifier":"homoit0004332","skos:prefLabel":[{"@language":"en","@value":"Lavender marriages"},{"@language":"nl","@value":"Lavender huwelijken"},{"@language":"sv","@value":"Lavendeläktenskap"}],"rdfs:comment":[{"@language":"en","@value":"Mixed-orientation marriages of convenience between men and women to provide safety and deniability around their homosexuality for one or both members of the marriage. This term was commonly used in the early 20th century to describe celebrity marriages, though it has been used more broadly since."},{"@language":"nl","@value":"Schijnhuwelijken tussen een man en een vrouw met gemengde seksuele oriëntatie, bedoeld om de homoseksualiteit van één of beide partners te verbergen en te ontkennen. Deze term werd in het begin van de 20e eeuw vaak gebruikt om huwelijken van beroemdheden te beschrijven, maar wordt sindsdien breder gebruikt."},{"@language":"sv","@value":"Äktenskap mellan en man och en kvinna med olika sexuella läggningar med syfte att skapa trygghet och en möjlighet att förneka homosexualitet hos en eller båda medlemmarna i äktenskapet. Termen användes i början av 1900-talet för att beskriva kändisäktenskap, även om den senare har använts i bredare bemärkelse."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000158"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000218"},{"@id":"https://homosaurus.org/v5/homoit0000356"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000973"},"dc:issued":{"@type":"xsd:date","@value":"2026-02-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000973","dc:identifier":"homoit0000973","skos:prefLabel":[{"@language":"en","@value":"Living arrangements"},{"@language":"es","@value":"Arreglos de vivienda"},{"@language":"nl","@value":"Leefvormen"},{"@language":"sv","@value":"Samlevnadsformer"}],"rdfs:comment":[{"@language":"en","@value":"Structure or composition of an individual's household or living environment, including the number of household members and their relationships to each other."},{"@language":"es","@value":"Estructura o composición del hogar o entorno de vida de una persona, incluido el número de miembros del hogar y sus relaciones entre sí."},{"@language":"nl","@value":"Structuur of samenstelling van het huishouden of de leefomgeving van een persoon, inclusief het aantal leden van het huishouden en hun onderlinge relaties."},{"@language":"sv","@value":"Sammansättning eller struktur av en individs hushåll eller boendemiljö, inklusive antal hushållsmedlemmar och deras relationer till varandra."}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000274"},{"@id":"https://homosaurus.org/v5/homoit0000362"},{"@id":"https://homosaurus.org/v5/homoit0000990"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000360"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000973"},"dc:replaces":{"@id":"http://homosaurus.org/v2/livingArrangements"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000159","dc:identifier":"homoit0000159","skos:prefLabel":[{"@language":"en","@value":"Bisexual dominants"},{"@language":"de","@value":"Bisexueller Dom"},{"@language":"es","@value":"Dominantes bisexuales"},{"@language":"nl","@value":"Biseksuele dominanten"},{"@language":"sv","@value":"Dominanta bisexuella"}],"skos:altLabel":[{"@language":"en","@value":"Bisexual masters"},{"@language":"de","@value":"Bisexueller Dominus"},{"@language":"de","@value":"Bisexuelle dominante Person"},{"@language":"de","@value":"Bi-Dominus"},{"@language":"de","@value":"Bi-Dom"},{"@language":"es","@value":"Amos bisexuales"}],"rdfs:comment":[{"@language":"en","@value":"Bisexual people who are part of the BDSM scene and assume the dominant role in sexual relationships with a dominant/submissive dynamic."},{"@language":"de","@value":"Bisexuelle Personen (in der Regel Männer), die Teil der BDSM-Szene sind und die dominante Rolle in sexuellen Beziehungen mit einer Master/Sklav:in-Dynamik übernehmen."},{"@language":"es","@value":"Personas bisexuales que forman parte de la escena BDSM y asumen el rol dominante en las relaciones sexuales con una dinámica dominante/sumisa."},{"@language":"nl","@value":"Biseksuele personen die deel uitmaken van de BDSM-scene en de dominante rol op zich nemen in seksuele relaties met een dominante/onderdanige dynamiek."},{"@language":"sv","@value":"Bisexuella personersom intar en dominant roll inom BDSM och/eller i maktutbytesrelationer med en dominant/underordnad dynamik."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000999"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0004605"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001295"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualMasters"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000999","dc:identifier":"homoit0000999","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ dominants"},{"@language":"ja","@value":"LGBTQ+の支配的立場"},{"@language":"es","@value":"Dominantes LGBTQ+"},{"@language":"nl","@value":"LHBTQ+-dominanten"},{"@language":"sv","@value":"Dominanta (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"Masters (LGBTQ)"},{"@language":"en","@value":"LGBTQ+ D-types"},{"@language":"en","@value":"LGBTQ+ Doms"},{"@language":"en","@value":"LGBTQ+ masters"},{"@language":"en","@value":"LGBTQ dominants"},{"@language":"en","@value":"Dominants (LGBTQ+)"},{"@language":"en","@value":"LGBTQの支配的立場"},{"@language":"ja","@value":"LGBTQ+のDタイプ"},{"@language":"ja","@value":"LGBTQの支配的立場"},{"@language":"es","@value":"Amos LGBTQ+"},{"@language":"es","@value":"Amos (LGBTQ+)"},{"@language":"nl","@value":"LHBTQ+-meesters"},{"@language":"nl","@value":"Meesters (LHBTQ+)"}],"rdfs:comment":[{"@language":"en","@value":"LGBTQ+ people who are part of the BDSM scene and assume the dominant role in sexual relationships with a dominant/submissive dynamic."},{"@language":"ja","@value":"BDSMシーンに属し、支配・服従の関係において支配的な役割を担うLGBTQ+の人々。"},{"@language":"es","@value":"La persona que asume la posición de autoridad o poder en una relación de intercambio de poder o actividad kink."},{"@language":"nl","@value":"De persoon die de positie van autoriteit of macht op zich neemt in een machtsuitwisselingsrelatie of kink-activiteit."},{"@language":"sv","@value":"Hbtq+-personersom intar en dominant roll inom BDSM och/eller i maktutbytesrelationer med en dominant/underordnad dynamik."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001295"},{"@id":"https://homosaurus.org/v5/homoit0001304"},{"@id":"https://homosaurus.org/v5/homoit0001637"},{"@id":"https://homosaurus.org/v5/homoit0003084"}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000159"},{"@id":"https://homosaurus.org/v5/homoit0000505"},{"@id":"https://homosaurus.org/v5/homoit0001184"},{"@id":"https://homosaurus.org/v5/homoit0001420"},{"@id":"https://homosaurus.org/v5/homoit0002991"},{"@id":"https://homosaurus.org/v5/homoit0003194"},{"@id":"https://homosaurus.org/v5/homoit0004601"},{"@id":"https://homosaurus.org/v5/homoit0004602"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000363"},{"@id":"https://homosaurus.org/v5/homoit0000705"},{"@id":"https://homosaurus.org/v5/homoit0001018"},{"@id":"https://homosaurus.org/v5/homoit0001133"},{"@id":"https://homosaurus.org/v5/homoit0001318"},{"@id":"https://homosaurus.org/v5/homoit0001376"},{"@id":"https://homosaurus.org/v5/homoit0003052"},{"@id":"https://homosaurus.org/v5/homoit0004611"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001295"},"dc:replaces":{"@id":"http://homosaurus.org/v2/mastersLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004605","dc:identifier":"homoit0004605","skos:prefLabel":{"@language":"en","@value":"Bisexual submissives"},"skos:altLabel":[{"@language":"en","@value":"Bi submissives"},{"@language":"en","@value":"Bisexual subs"},{"@language":"en","@value":"Bi subs"}],"rdfs:comment":{"@language":"en","@value":"Bisexual people who are part of the BDSM scene and assume the submissive role in sexual relationships with a dominant/submissive dynamic."},"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001318"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000159"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001295"},"dc:issued":{"@type":"xsd:date","@value":"2026-06-08"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-10"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000160","dc:identifier":"homoit0000160","skos:prefLabel":[{"@language":"en","@value":"Bisexual men"},{"@language":"de","@value":"Bisexuelle Männer"},{"@language":"es","@value":"Hombres bisexuales"},{"@language":"nl","@value":"Biseksuele mannen"},{"@language":"sv","@value":"Bisexuella män"}],"skos:altLabel":{"@language":"de","@value":"Männliche Bisexuelle"},"rdfs:comment":[{"@language":"en","@value":"Men who are bisexual."},{"@language":"de","@value":"Männer, die sich als bisexuell identizieren."},{"@language":"es","@value":"Hombres que se autoidentifican como bisexuales."},{"@language":"nl","@value":"Mannen die zich identificeren als biseksueel"},{"@language":"sv","@value":"Män som identifierar sig som bisexuella."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000170"},{"@id":"https://homosaurus.org/v5/homoit0001008"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001009"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh93002510"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualMen"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001008","dc:identifier":"homoit0001008","skos:prefLabel":[{"@language":"en","@value":"Men"},{"@language":"es","@value":"Hombres"},{"@language":"nl","@value":"Mannen"},{"@language":"sv","@value":"Män"}],"rdfs:comment":[{"@language":"en","@value":"People who are men."},{"@language":"es","@value":"Adultos que se  identifican como hombres y que entienden su género en términos de las concepciones occidentales de ser hombre, lo masculino y/o la masculinidad. El término normalmente se ha definido como humanos masculinos adultos, aunque no todos los hombres se identifican con el término \"masculino\" según el contexto en el que se utiliza."},{"@language":"nl","@value":"Volwassenen die zichzelf als man identificeren en hun gender zien in termen van westerse opvattingen over mannelijkheid, man zijn en/of masculiniteit. De term wordt doorgaans gedefinieerd als volwassen mannelijke personen, hoewel niet alle mannen zich identificeren met de term 'mannelijk', afhankelijk van de context waarin deze wordt gebruikt"},{"@language":"sv","@value":"Vuxna som identifierar sig som män och förstår sitt kön i termer av västerländska föreställningar om manlighet, manlighetens uttryck och maskulinitet. Termen har historiskt använts för vuxna manliga människor, men inte alla som identifierar sig som män identifierar sig med begreppet ”manlig” beroende på kontext."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000571"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000160"},{"@id":"https://homosaurus.org/v5/homoit0000270"},{"@id":"https://homosaurus.org/v5/homoit0000506"},{"@id":"https://homosaurus.org/v5/homoit0000626"},{"@id":"https://homosaurus.org/v5/homoit0001009"},{"@id":"https://homosaurus.org/v5/homoit0001643"},{"@id":"https://homosaurus.org/v5/homoit0002278"},{"@id":"https://homosaurus.org/v5/homoit0003223"},{"@id":"https://homosaurus.org/v5/homoit0004641"},{"@id":"https://homosaurus.org/v5/homoit0004642"},{"@id":"https://homosaurus.org/v5/homoit0004643"},{"@id":"https://homosaurus.org/v5/homoit0004644"},{"@id":"https://homosaurus.org/v5/homoit0001185"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000271"},{"@id":"https://homosaurus.org/v5/homoit0000322"},{"@id":"https://homosaurus.org/v5/homoit0000563"},{"@id":"https://homosaurus.org/v5/homoit0001378"},{"@id":"https://homosaurus.org/v5/homoit0001509"},{"@id":"https://homosaurus.org/v5/homoit0002182"},{"@id":"https://homosaurus.org/v5/homoit0004645"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85083510"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/men"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000161","dc:identifier":"homoit0000161","skos:prefLabel":[{"@language":"en","@value":"Bisexual mistresses (BDSM culture)"},{"@language":"de","@value":"Bisexuelle Mistresses"},{"@language":"es","@value":"Amas bisexuales"},{"@language":"nl","@value":"Biseksuele meesteressen (BDSM cultuur)"},{"@language":"sv","@value":"Bisexuella härskarinnor"}],"skos:altLabel":{"@language":"sv","@value":"Bisexuella mistresses"},"rdfs:comment":[{"@language":"en","@value":"Bisexual women who are part of the BDSM scene and assume the mistress role in sexual relationships with a mistress/submissive dynamic."},{"@language":"de","@value":"Bisexuelle Frauen, die Teil der BDSM-Szene sind und in sexuellen Beziehungen mit einer Mistress/Sklav:in-Dynamik die Rolle der Herrin übernehmen."},{"@language":"es","@value":"Mujeres bisexuales que forman parte de la escena BDSM y asumen el rol de ama en las relaciones sexuales con una dinámica ama/esclava."},{"@language":"nl","@value":"Biseksuele vrouwen die deel uitmaken van de BDSM-scene en de meesteresrol op zich nemen in seksuele relaties met een meesteres/onderdanige dynamiek"},{"@language":"sv","@value":"Bisexuella personer som intar en dominerande roll inom BDSM och/eller i maktutbytesrelationer med en härskarinna/undergiven-dynamik. Termen används främst av feminint identifierade personer."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001018"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000751"},{"@id":"https://homosaurus.org/v5/homoit0001186"},{"@id":"https://homosaurus.org/v5/homoit0001421"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001295"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualMistresses"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001018","dc:identifier":"homoit0001018","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ mistresses (BDSM culture)"},{"@language":"es","@value":"Amas LGBTQ+"},{"@language":"nl","@value":"LHBTQ+-meesteressen (BDSM cultuur)"},{"@lang