homosaurus.org/v5/homoit0003370"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2024-07-11"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003383","dc:identifier":"homoit0003383","skos:prefLabel":[{"@language":"en","@value":"Arab American lesbians"},{"@language":"de","@value":"Arabisch-amerikanische Lesben"},{"@language":"es","@value":"Lesbianas árabes estadounidenses"},{"@language":"nl","@value":"Arabisch-Amerikaanse lesbische vrouwen"},{"@language":"sv","@value":"Lesbiska arabamerikaner"}],"skos:altLabel":[{"@language":"en","@value":"Lesbian Arab American people"},{"@language":"en","@value":"Lesbian Arab Americans"},{"@language":"de","@value":"Lesbische arabisch-amerikanische Personen"},{"@language":"es","@value":"Árabes estadounidenses lesbianas"}],"rdfs:comment":[{"@language":"en","@value":"Lesbians who are descended from Arab peoples and were born in the United States, or lesbians born in Arab countries who live in or have a strong connection to the United States. Do not conflate with Muslim people."},{"@language":"de","@value":"Lesben, die von arabischen Völkern abstammen und in den Vereinigten Staaten geboren wurden, oder Lesben, die in arabischen Ländern geboren wurden und in den Vereinigten Staaten leben oder eine starke Verbindung zu diesen haben. Nicht zu verwechseln mit muslimischen Menschen."},{"@language":"es","@value":"Lesbianas que descienden de pueblos árabes y nacieron en los Estados Unidos, o lesbianas nacidas en países árabes que viven o tienen una fuerte conexión con los Estados Unidos. No se debe confundir con musulmanas."},{"@language":"nl","@value":"Lesbische vrouwen die afstammen van Arabische volkeren en geboren zijn in de Verenigde Staten, of lesbische vrouwen geboren in Arabische landen die in de Verenigde Staten wonen of er een sterke band mee hebben. Niet verwarren met moslims."},{"@language":"sv","@value":"Lesbiska som har arabiskt ursprung och är födda i USA, eller lesbiska födda i arabvärlden som bor i eller har en stark koppling till USA. Ska inte förväxlas med muslimer."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0003382"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2024-07-11"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003384","dc:identifier":"homoit0003384","skos:prefLabel":[{"@language":"en","@value":"Arab American gay men"},{"@language":"de","@value":"Arabisch-amerikanische schwule Männer"},{"@language":"es","@value":"Hombres gay árabes estadounidenses"},{"@language":"nl","@value":"Arabisch-Amerikaanse homomannen"},{"@language":"sv","@value":"Arabamerikanska bögar"}],"skos:altLabel":[{"@language":"en","@value":"Gay Arab American men"},{"@language":"en","@value":"Gay Arab Americans"},{"@language":"de","@value":"Schwule arabisch-amerikanische Männer"},{"@language":"es","@value":"Hombres árabes estadounidenses gay"},{"@language":"sv","@value":"Arabamerikanska bögar"}],"rdfs:comment":[{"@language":"en","@value":"Gay men who are descended from Arab peoples and were born in the United States, or gay men born in Arab countries who live in or have a strong connection to the United States. Do not conflate with Muslim people."},{"@language":"de","@value":"Schwule Männer, die von arabischen Völkern abstammen und in den Vereinigten Staaten geboren wurden, oder schwule Männer, die in arabischen Ländern geboren wurden und in den Vereinigten Staaten leben oder eine starke Verbindung zu diesen haben. Nicht zu verwechseln mit muslimischen Menschen."},{"@language":"es","@value":"Hombres gay que descienden de pueblos árabes y nacieron en 