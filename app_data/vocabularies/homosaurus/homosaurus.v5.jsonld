7"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0003033"},{"@id":"https://homosaurus.org/v5/homoit0003034"},{"@id":"https://homosaurus.org/v5/homoit0003035"},{"@id":"https://homosaurus.org/v5/homoit0003036"},{"@id":"https://homosaurus.org/v5/homoit0003037"},{"@id":"https://homosaurus.org/v5/homoit0003038"},{"@id":"https://homosaurus.org/v5/homoit0003039"},{"@id":"https://homosaurus.org/v5/homoit0003040"},{"@id":"https://homosaurus.org/v5/homoit0003042"},{"@id":"https://homosaurus.org/v5/homoit0003043"},{"@id":"https://homosaurus.org/v5/homoit0003044"},{"@id":"https://homosaurus.org/v5/homoit0003045"},{"@id":"https://homosaurus.org/v5/homoit0003046"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000297"},"dc:issued":{"@type":"xsd:date","@value":"2023-12-05"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003698","dc:identifier":"homoit0003698","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ punk community"},{"@language":"nl","@value":"LHBTQ+-punk gemeenschap"},{"@language":"sv","@value":"Punkgemenskaper (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"Punk community (LGBTQ)"},{"@language":"en","@value":"Punk scene (LGBTQ)"},{"@language":"en","@value":"Punk culture (LGBTQ)"},{"@language":"en","@value":"LGBTQ+ punk scene"},{"@language":"en","@value":"LGBTQ+ punk culture"},{"@language":"nl","@value":"LHBTQ+-punk scene"},{"@language":"nl","@value":"Punk cultuur (LHBTQ+)"},{"@language":"nl","@value":"Punk gemeenschap (LHBTQ+)"},{"@language":"nl","@value":"Punk scene (LHBTQ+)"},{"@language":"sv","@value":"Punk-communityn (hbtq+)"}],"rdfs:comment":[{"@language":"en","@value":"A subset of the punk community to which LGBTQ+ punks and allies belong. The punk community originated in the 1970s with punk rock music and is now associated with various music subgrenes, fashions, and ideologies."},{"@language":"nl","@value":"Een subgroep van de punkgemeenschap waartoe LHBTQ+-punkers en bondgenoten behoren. De punkgemeenschap ontstond in de jaren 70 met punkrockmuziek en wordt nu geassocieerd met verschillende muzieksubgrenes, modes en ideologieën."},{"@language":"sv","@value":"En del av punkgemenskapen som omfattar hbtq+-personer och allierade. Punkkulturen uppstod på 1970-talet med punkrocken och är idag kopplad till olika musikstilar, modeuttryck och ideologier."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000297"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001831"},{"@id":"https://homosaurus.org/v5/homoit0003697"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000297"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000558","dc:identifier":"homoit0000558","skos:prefLabel":[{"@language":"en-us","@value":"LGBTQ+ neighborhoods"},{"@language":"es","@value":"Barrios LGBTQ+"},{"@language":"nl","@value":"LHBTQ+-buurten"},{"@language":"sv","@value":"Hbtq+-kvarter"},{"@language":"en-gb","@value":"LGBTQ+ neighbourhoods"}],"skos:altLabel":[{"@language":"es","@value":"Vecindarios LGBTQ+"},{"@language":"es","@value":"Vecindarios LGBTQ"},{"@language":"sv","@value":"Gaykvarter"}],"rdfs:comment":[{"@language":"en","@value":"Districts or portions of towns or cities that are (typically unofficial) social and/or residential centers for LGBTQ+ people and communities."},{"@language":"es","@value":"Distritos o partes de pueblos o ciudades que son (usualmente de forma informal) centros sociales y/o residenciales para personas y comunidades LGBTQ+."},{"@language":"sv","@value":"Stadsdelar eller områden i städer som är (ofta informellt) sociala och/eller bostadsmässiga centra för hbtq+-personer och gemenskaper."}]