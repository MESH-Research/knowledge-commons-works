e":"sv","@value":"Döttrar som identifierar sig som intersex. Används endast för personer som själva identifierar sig som döttrar."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000330"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-09-29"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003241","dc:identifier":"homoit0003241","skos:prefLabel":[{"@language":"en","@value":"Two-Spirit daughters"},{"@language":"es","@value":"Hijas dos espíritus"},{"@language":"nl","@value":"Two-Spirit dochters"},{"@language":"sv","@value":"Two-spirit-döttrar"}],"skos:altLabel":[{"@language":"en","@value":"Two Spirit daughters"},{"@language":"en","@value":"Two Spirited daughters"},{"@language":"en","@value":"Two-Spirit daughters"},{"@language":"en","@value":"Two-Spirited daughters"}],"rdfs:comment":[{"@language":"en","@value":"Two-Spirit people who are daughters. Only use to describe individuals who identify as daughters."},{"@language":"es","@value":"Personas dos espíritus que son hijas. Utilícese únicamente para personas que se autoidentifican como hijas."},{"@language":"nl","@value":"Two-Spirit people die dochters zijn. Alleen te gebruiken om individuen te beschrijven die zich identificeren als dochters."},{"@language":"sv","@value":"Two-spirit-personer som är döttrar. Används endast för personer som själva identifierar sig som döttrar."}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000330"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0003241"},"dc:issued":{"@type":"xsd:date","@value":"2024-05-24"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000331","dc:id