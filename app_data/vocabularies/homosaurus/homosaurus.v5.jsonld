eller kulturer."}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0004306"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0004312"},"dc:issued":{"@type":"xsd:date","@value":"2026-02-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004323","dc:identifier":"homoit0004323","skos:prefLabel":[{"@language":"en","@value":"Non-binary podcasts"},{"@language":"nl","@value":"Non-binaire podcasts"},{"@language":"sv","@value":"Ickebinära poddar"}],"skos:altLabel":[{"@language":"en","@value":"Nonbinary podcasts"},{"@language":"sv","@value":"Ickebinära podcaster"}],"rdfs:comment":[{"@language":"en","@value":"A recorded series (primarily in audio, but sometimes with a video component) with recurring hosts that feature content about non-binary people and/or non-binary issues and that are available digitally for streaming or download. Podcasts are typically episodic and may feature different guests."},{"@language":"nl","@value":"Een opgenomen serie (voornamelijk audio, maar soms met een video-onderdeel) met terugkerende presentatoren die content presenteren over non-binaire personen en/of non-binaire thema's en die digitaal beschikbaar zijn om te streamen of te downloaden. Podcasts bestaan ​​doorgaans uit afleveringen en kunnen verschillende gasten hebben."},{"@language":"sv","@value":"Inspelade radioprogram (inslag av video kan förekomma) med återkommande programledare och innehåll om/för ickebinära personer och/eller ickebinära frågor som är digitalt tillgängliga genom streaming eller nedladdning. Poddar är vanligen uppdelade i episoder och kan ha olika gäster."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0004317"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0004317"},"dc:issued":{"@type":"xsd:date","@value":"2026-02-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004326","dc:identifier":"homoit0004326","skos:prefLabel":[{"@language":"en","@value":"Intersex podcasts"},{"@language":"nl","@value":"Intersekse podcasts"},{"@language":"sv","@value":"Intersexpoddar"}],"skos:altLabel":{"@language":"sv","@value":"Intersex-podcaster"},"rdfs:comment":[{"@language":"en","@value":"A recorded series (primarily in audio, but sometimes with a video component) with recurring hosts that feature content about intersex people and/or intersex issues and that are available digitally for streaming or download. Podcasts are typically episodic and may feature different guests."},{"@language":"nl","@value":"Een opgenomen serie (voornamelijk audio, maar soms met een video-onderdeel) met terugkerende presentatoren die content presenteren over intersekse personen en/of intersekse thema's en die digitaal beschikbaar zijn om te streamen of te downloaden. Podcasts bestaan ​​doorgaans uit afleveringen en kunnen verschillende gasten hebben."},{"@language":"sv","@value":"Inspelade radioprogram (inslag av video kan förekomma) med återkommande programledare och innehåll om/för intersexpersoner och/eller intersexfrågor som är digitalt tillgängliga genom streaming eller nedladdning. Poddar är vanligen uppdelade i episoder och kan ha olika gäster."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0004317"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0004317"},"dc:issued":{"@type":"xsd:date","@value":"2026-02-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004362","dc:identifier":"homoit0004362","skos:prefLabel":[{"@language":"en","@value":"Transgender grooms"},{"@language":"nl","@value":"Transgender bruidegoms"},{"@lang