lue":"Organized public or social occasions for greyromantic people and communities."},{"@language":"nl","@value":"Georganiseerde openbare of sociale bijeenkomsten voor grijsromantische personen en gemeenschappen."},{"@language":"sv","@value":"Organiserade offentliga eller sociala tillställningar för gråromantiska personer och gråromantiska gemenskaper."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000861"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000861"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-22"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003606","dc:identifier":"homoit0003606","skos:prefLabel":[{"@language":"en","@value":"Megasexual events"},{"@language":"nl","@value":"Megaseksuele evenementen"},{"@language":"sv","@value":"Megasexuella evenemang"}],"skos:altLabel":{"@language":"sv","@value":"Megasexuella event"},"rdfs:comment":[{"@language":"en","@value":"Organized public or social occasions for megasexual people and communities."},{"@language":"nl","@value":"Georganiseerde openbare of sociale bijeenkomsten voor megaseksuele personen en gemeenschappen."},{"@language":"sv","@value":"Organiserade offentliga eller sociala tillställningar för megasexuella personer och megasexuella gemenskaper."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000861"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000861"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-22"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003651","dc:identifier":"homoit0003651","skos:prefLabel":[{"@language":"en","@value":"Pride events"},{"@language":"nl","@value":"Pride evenementen"},{"@language":"sv","@value":"Pride-evenemang"}],"skos:altLabel":{"@language":"en","@value":"LGBTQ+ pride events"},"rdfs:comment":[{"@language":"en","@value":"Events that recognize and celebrate LGBTQ+ people and culture, thereby affirming the visibility, dignity, and diversity of LGBTQ+ communities."},{"@language":"nl","@value":"Evenementen die LHBTQ+-personen en -cultuur erkennen en vieren en zo de zichtbaarheid, waardigheid en diversiteit van LHBTQ+-gemeenschappen bevestigen."},{"@language":"sv","@value":"Evenemang som uppmärksammar och firar hbtq+-personer och hbtq+-kultur, och som bekräftar hbtq+-gemenskapernas synlighet, värdighet och mångfald."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000861"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0003652"},{"@id":"https://homosaurus.org/v5/homoit0003654"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0002386"},"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2010013029"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000861"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-22"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003656","dc:identifier":"homoit0003656","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ History Month"},{"@language":"nl","@value":"LHBTQ+-geschiedenismaand"},{"@language":"sv","@value":"Hbtq+-historiemånad"}],"skos:altLabel":{"@language":"en","@value":"Gay History Month"},"rdfs:comment":[{"@language":"en","@value":"An annual, month-long observance of LGBTQ+ history and related civil rights movements. The month in which LGBTQ+ History Month is observed differs depending on the country."},{"@language":"nl","@value":"Een jaarlijkse, maandlange aandacht voor LHBTQ+-geschiedenis en gerelateerde burgerrechtenbewegingen. De maand waarin de LHBTQ+-geschiedenismaand wordt gevierd, verschilt per land."},{"@language":"sv","@value":"En främst amerikansk företeelse med en årligen återkommande månadslångt uppmärksammande av hbtq+-historia och relaterade medborgarrättsrörelser. Vilken månad som hbtq+-historiemånaden infaller varierar beroende på land."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000861"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0002260"},{"@id":"https://homosaurus.org/v5/homoit0003654"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2016000166"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000861"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-22"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003734","dc:identifier":"homoit0003734","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ street fairs"},{"@language":"nl","@value":"LHBTQ+-straatfestivals"},{"@language":"sv","@value":"Gatufestivaler (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"Street fairs (LGBTQ)"},{"@language":"en","@value":"LGBTQ+ street festivals"},{"@language":"en","@value":"Street festivals (LGBTQ)"},{"@language":"en","@value":"LGBTQ+ block parties"},{"@language":"en","@value":"Block parties (LGBTQ)"},{"@language":"nl","@value":"LHBTQ+-buurtfeesten"},{"@language":"nl","@value":"LHBTQ+-straatfeesten"},{"@language":"nl","@value":"Straatfeesten (LHBTQ+)"},{"@language":"nl","@value":"Straatfestivals (LHBTQ+)"},{"@language":"sv","@value":"Gatufester (hbtq+)"}],"rdfs:comment":[{"@language":"en","@value":"Festivals held on public streets that celebrate the character of the surrounding neighborhood or community. Use to refer to street fairs specifically celebrating the local LGBTQ+ community."},{"@language":"nl","@value":"Festivals die op openbare straten worden gehouden en die het karakter van de omliggende buurt of gemeenschap vieren. Wordt gebruikt om te verwijzen naar festivals die specifiek de lokale LHBTQ+-gemeenschap vieren."},{"@language":"sv","@value":"Festivaler som hålls på offentliga gator och som uppmärksammar och firar den omgivande stadsdelens eller gemenskapens karaktär. Används för gatufestivaler som särskilt firar den lokala hbtq+-gemenskapen."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000861"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000861"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003735","dc:identifier":"homoit0003735","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ conferences"},{"@language":"ja","@value":"LGBTQ+関連の大会"},{"@language":"nl","@value":"LHBTQ+-congressen"},{"@language":"sv","@value":"Hbtq+-konferenser"}],"skos:altLabel":[{"@language":"en","@value":"Conferences (LGBTQ)"},{"@language":"en","@value":"LGBTQ+ conventions"},{"@language":"en","@value":"Conventions (LGBTQ)"},{"@language":"ja","@value":"大会 (LGBTQ)"},{"@language":"ja","@value":"LGBTQ+のコンベンション"},{"@language":"ja","@value":"コンベンション (LGBTQ)"},{"@language":"nl","@value":"Congressen (LHBTQ+)"},{"@language":"nl","@value":"LHBTQ+-conferenties"}],"rdfs:comment":[{"@language":"en","@value":"Large formal meetings or assemblies of LGBTQ+ people."},{"@language":"ja","@value":"LGBTQ+の人々による大規模な公式の会合や集会。"},{"@language":"nl","@value":"Grote formele bijeenkomsten of vergaderingen van LGBTQ+-mensen."},{"@language":"sv","@value":"Större formella möten eller sammankomster av hbtq+-personer."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000861"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000861"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002157","dc:identifier":"homoit0002157","skos:prefLabel":[{"@language":"en","@value":"Fandom conventions"},{"@language":"es","@value":"Convenciones de fandom"},{"@language":"de","@value":"Fandom-Conventions"},{"@language":"nl","@value":"Fandom conventies"},{"@language":"sv","@value":"Fandom-konvent"}],"skos:altLabel":[{"@language":"en","@value":"Fan cons"},{"@language":"en","@value":"Fan conventions"},{"@language":"en","@value":"Fandom cons"},{"@language":"es","@value":"Fan cons"},{"@language":"es","@value":"Cons de fans"},{"@language":"es","@value":"Convenciones fandom"},{"@language":"de","@value":"Fandom-Kongresse"},{"@language":"nl","@value":"Fan-conventies"},{"@language":"nl","@value":"Fandom-cons"}],"rdfs:comment":[{"@language":"en","@value":"Conventions dedicated to a particular fandom or fandom as a broad category."},{"@language":"es","@value":"Convenciones dedicadas a un fandom en particular o al fandom como categoría amplia."},{"@language":"de","@value":"Conventions, die sich einem bestimmten Fandom oder Fandom als breiter Kategorie widmen."},{"@language":"nl","@value":"Conventies gewijd aan een bepaald fandom of fandom als een brede categorie"},{"@language":"sv","@value":"Konvent som är tillägnade en viss fandom eller fandom som fenomen."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002156"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0002166"},{"@id":"https://homosaurus.org/v5/homoit0002202"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000861"},{"@id":"https://homosaurus.org/v5/homoit0000900"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002166","dc:identifier":"homoit0002166","skos:prefLabel":[{"@language":"en","@value":"Furry conventions"},{"@language":"es","@value":"Convenciones de furros"},{"@language":"de","@value":"Furry-Conventions"},{"@language":"nl","@value":"Furry conventies"},{"@language":"sv","@value":"Furrykonvent"}],"skos:altLabel":[{"@language":"en","@value":"Furry cons"},{"@language":"es","@value":"Furry cons"},{"@language":"de","@value":"Furry-Cons"}],"rdfs:comment":[{"@language":"en","@value":"Conventions for furries that focus on furry fanworks."},{"@language":"es","@value":"Convenciones para furros que se centran en obras de fans furro."},{"@language":"de","@value":"Conventions für Furries, die sich auf Furry-Fanwerke konzentrieren."},{"@language":"nl","@value":"Conventies voor furries die zich richten op furry fanwerken"},{"@language":"sv","@value":"Konvent för furries med fokus på fanverk inom furrykulturen."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0002157"},{"@id":"https://homosaurus.org/v5/homoit0002167"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000861"},{"@id":"https://homosaurus.org/v5/homoit0000900"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002202","dc:identifier":"homoit0002202","skos:prefLabel":[{"@language":"en","@value":"Slash conventions"},{"@language":"es","@value":"Convenciones slash"},{"@language":"nl","@value":"Slash conventies"},{"@language":"sv","@value":"Slash-konvent"}],"skos:altLabel":[{"@language":"en","@value":"Slash cons"},{"@language":"es","@value":"Cons slash"}],"rdfs:comment":[{"@language":"en","@value":"Conventions focused on slash, or fanworks depicting same-sex or same-gender couples that are typically erotic or pornographic in nature. Historically used for male-male couples only, but is now used more broadly; includes femslash conventions."},{"@language":"es","@value":"Convenciones centradas en slash, o fanworks que representan parejas del mismo sexo o del mismo género que son típicamente de naturaleza erótica o pornográfica. Históricamente se utilizaba únicamente para parejas de hombres, pero ahora se utiliza de forma más amplia; incluye convenciones del femslash."},{"@language":"nl","@value":"Conventies gericht op 'slash', of fan-uitingen die koppels van hetzelfde geslacht of hetzelfde gender afbeelden die typisch erotisch of pornografisch van aard zijn. Van oudsher alleen gebruikt voor man-man koppels, maar wordt nu breder gebruikt; omvat femslash-conventies"},{"@language":"sv","@value":"Konvent med fokus på slash eller fanverk som skildrar samkönade eller samkönsidentifierade par i erotiska eller pornografiska sammanhang. Termen användes ursprungligen för man/man-par men används numera i bredare bemärkelse och inkluderar även femslash-konvent."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0002157"},{"@id":"https://homosaurus.org/v5/homoit0002203"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000861"},{"@id":"https://homosaurus.org/v5/homoit0000900"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003601","dc:identifier":"homoit0003601","skos:prefLabel":[{"@language":"en","@value":"Two-Spirit events"},{"@language":"nl","@value":"Two-Spirit evenementen"},{"@language":"sv","@value":"Two-spirit-evenemang"}],"skos:altLabel":[{"@language":"en","@value":"Two Spirit events"},{"@language":"en","@value":"Two-Spirited events"},{"@language":"en","@value":"Two Spirited events"},{"@language":"en","@value":"2S events"},{"@language":"sv","@value":"Two-spirit-event"}],"rdfs:comment":[{"@language":"en","@value":"Organized public or social occasions for Two-Spirit people and communities."},{"@language":"nl","@value":"Georganiseerde openbare of sociale bijeenkomsten voor Two-Spirit people en -gemeenschappen."},{"@language":"sv","@value":"Organiserade offentliga eller sociala tillställningar för Two-spirit-personer och Two-spirit-gemenskaper."}],"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0003717"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000861"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0003601"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-22"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003607","dc:identifier":"homoit0003607","skos:prefLabel":[{"@language":"en","@value":"Women's events"},{"@language":"nl","@value":"Evenementen voor vrouwen"},{"@language":"sv","@value":"Kvinnoevenemang"}],"skos:altLabel":{"@language":"sv","@value":"Kvinno-events"},"rdfs:comment":[{"@language":"en","@value":"Organized public or social occasions for women."},{"@language":"nl","@value":"Georganiseerde openbare of sociale gelegenheden voor vrouwen."},{"@language":"sv","@value":"Organiserade offentliga eller sociala tillställningar för kvinnor."}],"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0001515"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000861"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0003607"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-22"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000862","dc:identifier":"homoit0000862","skos:prefLab