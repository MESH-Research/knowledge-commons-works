f vernauwing wordt uitgeoefend op de borsten."},{"@language":"sv","@value":"En sexuell aktivitet där intensiv sensorisk stimulans, smärta eller åtsnörning appliceras på brösten."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000036"},{"@id":"https://homosaurus.org/v5/homoit0003132"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000222"},{"@id":"https://homosaurus.org/v5/homoit0001046"},{"@id":"https://homosaurus.org/v5/homoit0001621"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000404"},"dc:issued":{"@type":"xsd:date","@value":"2023-12-20"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003131","dc:identifier":"homoit0003131","skos:prefLabel":[{"@language":"en","@value":"Nipple torture"},{"@language":"es","@value":"Tortura de pezones"},{"@language":"nl","@value":"Tepelmarteling"},{"@language":"sv","@value":"Bröstvårtstortyr"}],"skos:altLabel":[{"@language":"en","@value":"Nip torture"},{"@language":"es","@value":"Tortura de pezon"},{"@language":"sv","@value":"Nipple torture"}],"rdfs:comment":[{"@language":"en","@value":"A kink activity where intense sensation, pain, or constriction is applied to the nipples."},{"@language":"es","@value":"Una actividad kink en la que se aplica una sensación intensa, dolor o constricción en los pezones."},{"@language":"nl","@value":"Een kinkactiviteit waarbij intense sensatie, pijn of vernauwing wordt toegepast op de tepels."},{"@language":"sv","@value":"En kinkaktivitet som innebär att bröstvårtorna utsätts för smärta, tryck eller annan intensiv stimulans."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000036"},{"@id":"https://homosaurus.org/v5/homoit0001046"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001984"},{"@id":"https://homosaurus.org/v5/homoit0003132"}],"skos:hasTopConcept":{"@id":"https://homosaur