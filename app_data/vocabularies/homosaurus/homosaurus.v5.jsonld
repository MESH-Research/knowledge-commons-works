es","@value":"Trabajos en las artes escénicas que se centran en personajes, comunidades o problemas bisexuales."},{"@language":"sv","@value":"Scenkonstverk som fokuserar på bisexuella karaktärer, gemenskaper eller frågor."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001363"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000149"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001363"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualTheatre"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001726","dc:identifier":"homoit0001726","skos:prefLabel":[{"@language":"en","@value":"Bisexual authors"},{"@language":"es","@value":"Autores bisexuales"},{"@language":"de","@value":"Bisexuelle Autor:innen"},{"@language":"nl","@value":"Biseksuele auteurs"},{"@language":"sv","@value":"Bisexuella författare"}],"rdfs:comment":[{"@language":"en","@value":"Bisexual creators of written works."},{"@language":"es","@value":"Creadores de obras escritas conocidos por ser bisexuales."},{"@language":"de","@value":"Bisexuelle Verfasser:innen von schriftlichen Werken."},{"@language":"nl","@value":"Biseksuele makers van geschreven werken."},{"@language":"sv","@value":"Bisexuella skapare av skrivna verk."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001723"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000149"},{"@id":"https://homosaurus.org/v5/homoit0000151"},{"@id":"https://homosaurus.org/v5/homoit0000157"},{"@id":"https://homosaurus.org/v5/homoit0000174"},{"@id":"https://homosaurus.org/v5/homoit0001605"},{"@id":"https://homosaurus.org/v5/homoit0001732"},{"@id":"https://homosaurus.org/v5/homoit0002150"},{"@id":"https://homosaurus.org/v5/homoit0001617"},{"@id":"https://homosaurus.org/v5/homoit0003869"}],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh98006058"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2021-11-02"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000150","dc:identifier":"homoit0000150","skos:prefLabel":[{"@language":"en","@value":"Bisexual families"},{"@language":"de","@value":"Bisexuelle Familien"},{"@language":"es","@value":"Familias bisexuales"},{"@language":"fr","@value":"Familles bisexuelles"},{"@language":"nl","@value":"Biseksuele gezinnen"},{"@language":"sv","@value":"Bisexuella familjer"}],"skos:altLabel":{"@language":"de","@value":"Bi-Familien"},"rdfs:comment":[{"@language":"en","@value":"Families, whether biological, adoptive, or chosen, in which one or more individuals identify as bisexual."},{"@language":"de","@value":"Biologische, Adoptiv- oder Wahlfamilien, in denen sich eine oder mehrere Personen als bisexuell identifizieren."},{"@language":"es","@value":"Familias, ya sean biológicas, adoptivas o elegidas, en las que una o más personas se autoidentican como bisexuales."},{"@language":"fr","@value":"Familles biologiques, adoptives ou choisies, dans lesquelles une ou plusieurs personnes s'identifient comme bisexuelles."},{"@language":"nl","@value":"Gezinnen, biologisch, adoptief of gekozen, waarin een of meer individuen zich identificeren als biseksueel"},{"@language":"sv","@value":"Familjer – biologiska, adoptiva eller valda – där en eller flera personer identifierar sig som bisexuella."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000420"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000169"},{"@id":"https://homosaurus.org/v5/homoit0000170"},{"@id":"https://homosaurus.org/v5/homoit0000257"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000420"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualFamilies"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000169","dc:identifier":"homoit0000169","skos:prefLabel":[{"@language":"en","@value":"Bisexual parents"},{"@language":"de","@value":"Bisexuelle Eltern"},{"@language":"es","@value":"Madres y padres bisexuales"},{"@language":"nl","@value":"Biseksuele ouders"},{"@language":"sv","@value":"Bisexuella föräldrar"}],"skos:altLabel":[{"@language":"de","@value":"Bi-Eltern"},{"@language":"es","@value":"Madres bisexuales"},{"@language":"es","@value":"Padres bisexuales"}],"rdfs:comment":[{"@language":"en","@value":"Parents who are bisexual."},{"@language":"de","@value":"Eltern, die bisexuell sind."},{"@language":"es","@value":"Padres y/o madres que son bisexuales."},{"@language":"nl","@value":"Ouders die biseksueel zijn"},{"@language":"sv","@value":"Föräldrar som är bisexuella."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000170"},{"@id":"https://homosaurus.org/v5/homoit0001075"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000150"},{"@id":"https://homosaurus.org/v5/homoit0000257"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh98004191"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualParents"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000257","dc:identifier":"homoit0000257","skos:prefLabel":[{"@language":"en","@value":"Children of bisexual people"},{"@language":"de","@value":"Kinder von bisexuellen Personen"},{"@language":"es","@value":"Hijxs de personas bisexuales"},{"@language":"fr","@value":"Enfants de personnes bisexuelles"},{"@language":"nl","@value":"Kinderen van biseksuele personen"},{"@language":"sv","@value":"Barn till bisexuella personer"}],"skos:altLabel":[{"@language":"es","@value":"Hijas de personas bisexuales"},{"@language":"es","@value":"Hijos e hijas de personas bisexuales"},{"@language":"es","@value":"Hijos de personas bisexuales"}],"rdfs:comment":[{"@language":"en","@value":"Children who have one or more bisexual parent."},{"@language":"de","@value":"Kinder, die einen oder mehrere bisexuelle Elternteile haben."},{"@language":"es","@value":"Hijos o hijas que tienen uno o más madres o padres bisexuales."},{"@language":"fr","@value":"Enfants dont un ou plusieurs parents sont bisexuel·les."},{"@language":"nl","@value":"Kinderen die een of meer biseksuele ouders hebben"},{"@language":"sv","@value":"Barn som har en eller flera bisexuella föräldrar."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000260"},"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0001330"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000150"},{"@id":"https://homosaurus.org/v5/homoit0000169"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000421"},"dc:replaces":{"@id":"http://homosaurus.org/v2/childrenOfBisexualPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000443","dc:identifier":"homoit0000443","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ fiction"},{"@language":"es","@value":"Ficción LGBTQ+"},{"@language":"nl","@value":"LHBTQ+-fictie"},{"@language":"sv","@value":"Hbtq+-skönlitteratur"}],"skos:altLabel":[{"@language":"en","@value":"Fiction (LGBTQ)"},{"@language":"nl","@value":"LHBTQ+-verhalen"},{"@language":"sv","@value":"Skönlitteratur (hbtq+)"}],"rdfs:comment":[{"@language":"en","@value":"Genre of written works that depicts imagined events or people. Use for fiction focusing on LGBTQ+ characters or themes."},{"@language":"es","@value":"Obras de ficción con personajes o temas LGBTQ+."},{"@language":"nl","@value":"Fictie met LGBTQ+-personages of thema's."},{"@language":"sv","@value":"Litterära verk som beskriver fiktiva händelser eller personer. Används för skönlitteratur med hbtq+-karaktärer eller teman."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000972"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000151"},{"@id":"https://homosaurus.org/v5/homoit0000493"},{"@id":"https://homosaurus.org/v5/homoit0000742"},{"@id":"https://homosaurus.org/v5/homoit0000841"},{"@id":"https://homosaurus.org/v5/homoit0000852"},{"@id":"https://homosaurus.org/v5/homoit0000859"},{"@id":"https://homosaurus.org/v5/homoit0000865"},{"@id":"https://homosaurus.org/v5/homoit0000874"},{"@id":"https://homosaurus.org/v5/homoit0000934"},{"@id":"https://homosaurus.org/v5/homoit0001177"},{"@id":"https://homosaurus.org/v5/homoit0001414"},{"@id":"https://homosaurus.org/v5/homoit0001580"},{"@id":"https://homosaurus.org/v5/homoit0001586"},{"@id":"https://homosaurus.org/v5/homoit0001608"},{"@id":"https://homosaurus.org/v5/homoit0001752"},{"@id":"https://homosaurus.org/v5/homoit0001753"},{"@id":"https://homosaurus.org/v5/homoit0001754"},{"@id":"https://homosaurus.org/v5/homoit0002407"},{"@id":"https://homosaurus.org/v5/homoit0002506"},{"@id":"https://homosaurus.org/v5/homoit0002535"},{"@id":"https://homosaurus.org/v5/homoit0002565"},{"@id":"https://homosaurus.org/v5/homoit0004295"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000249"},{"@id":"https://homosaurus.org/v5/homoit0001723"},{"@id":"https://homosaurus.org/v5/homoit0001751"},{"@id":"https://homosaurus.org/v5/homoit0002153"},{"@id":"https://homosaurus.org/v5/homoit0002159"},{"@id":"https://homosaurus.org/v5/homoit0002179"},{"@id":"https://homosaurus.org/v5/homoit0002180"},{"@id":"https://homosaurus.org/v5/homoit0002188"},{"@id":"https://homosaurus.org/v5/homoit0002632"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/fictionLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004299","dc:identifier":"homoit0004299","skos:prefLabel":[{"@language":"en","@value":"Bisexual historical fiction"},{"@language":"nl","@value":"Biseksuele historische literatuur"},{"@language":"sv","@value":"Bisexuella historiska skildringar"}],"skos:altLabel":[{"@language":"en","@value":"Bi historical fiction"},{"@language":"sv","@value":"Bisexuella historiska romaner"}],"rdfs:comment":[{"@language":"en","@value":"Genre of written works that depicts events set during particular real historical events. Use for historical fiction focusing on bisexual characters or themes."},{"@language":"nl","@value":"Geschreven fictieve werken waarin het verhaal zich afspeelt tegen de achtergrond van specifieke, waargebeurde historische gebeurtenissen; gebruik in verwijzing naar historische fictie met biseksuele personages of thema's."},{"@language":"sv","@value":"Skönlitterära verk som utspelar sig i historisk tid, med verkliga händelser och miljöer. Används för historiska skildringar med fokus på bisexuella karaktärer eller teman."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000151"},{"@id":"https://homosaurus.org/v5/homoit0004295"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2026-02-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001583","dc:identifier":"homoit0001583","skos:prefLabel":[{"@language":"en","@value":"Bisexual horror fiction"},{"@language":"de","@value":"Bisexuelle Horror-Fiction"},{"@language":"es","@value":"Ficción de horror bisexual"},{"@language":"nl","@value":"Biseksuele horrorverhalen"},{"@language":"sv","@value":"Bisexuell skräck"}],"skos:altLabel":[{"@language":"en","@value":"Bi horror fiction"},{"@language":"de","@value":"Bi-Horror-Fiction"}],"rdfs:comment":[{"@language":"en","@value":"Genre of written works that intend to frighten, scare, or disgust. Use for horror fiction focusing on bisexual characters or themes."},{"@language":"de","@value":"Fiktionale Werke, die erschrecken, ängstigen oder abstoßen sollen; Verwendung in Bezug auf fiktionale Werke, die sich auf bisexuelle Charaktere oder Themen konzentrieren."},{"@language":"es","@value":"Obras de ficción escritas con la intención de asustar, atemorizar o provocar disgusto; utilícese en referencia a la ficción de horror centrada en personajes o temas bisexuales."},{"@language":"nl","@value":"Geschreven fictie bedoeld om angst aan te jagen, bang te maken of te walgen; gebruik om te verwijzen naar horrorfictie met biseksuele personages of thema's"},{"@language":"sv","@value":"Skönlitterära verk skrivna för att skrämma, oroa eller äckla. Används för skräcklitteratur med bisexuella karaktärer eller teman."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001580"},{"@id":"https://homosaurus.org/v5/homoit0000151"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualHorrorFiction"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-03"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001567","dc:identifier":"homoit0001567","skos:prefLabel":[{"@language":"en","@value":"Bisexual fantasy fiction"},{"@language":"de","@value":"Bisexuelle Fantasyliteratur"},{"@language":"es","@value":"Ficción fantástica bisexual"},{"@language":"nl","@value":"Biseksuele fantasy"},{"@language":"sv","@value":"Bisexuell fantasy"}],"skos:altLabel":[{"@language":"en","@value":"Bi fantasy fiction"},{"@language":"de","@value":"Bi-Fantasyliteratur"}],"rdfs:comment":[{"@language":"en","@value":"Genre of written works that depicts magical, fantastical, and/or supernatural elements. Use for fantasy fiction focusing on bisexual characters or themes."},{"@language":"de","@value":"Genre, das Magie und andere übernatürliche Phänomene als primäres Element der Handlung, des Themas und/oder des Schauplatzes verwendet; Verwendung für Fantasyliteratur, die sich auf bisexuelle Figuren oder Themen konzentriert."},{"@language":"es","@value":"Obras escritas que incluyan elementos mágicos o fantásticos; utilícese en referencia a ficción fantástica centrada en personajes o temas bisexuales."},{"@language":"nl","@value":"Geschreven werken met magische of fantastische elementen; gebruik om te verwijzen naar fantasy gericht op biseksuele personages of thema's"},{"@language":"sv","@value":"Genre som använder magi och andra övernaturliga fenomen som centrala inslag i handling, tema och/eller miljö. Används för fantasy med bisexuella karaktärer eller teman."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000865"},{"@id":"https://homosaurus.org/v5/homoit0000151"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualFantasyFiction"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-03"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001572","dc:identifier":"homoit0001572","skos:prefLabel":[{"@language":"en","@value":"Bisexual science fiction"},{"@language":"de","@value":"Bisexuelle Science-Fiction"},{"@language":"es","@value":"Ciencia ficción bisexual"},{"@language":"nl","@value":"Biseksuele science fiction"},{"@language":"sv","@value":"Bisexuell science fiction"}],"skos:altLabel":[{"@language":"en","@value":"Bi science fiction"},{"@language":"sv","@value":"Bisexuell sci fi"},{"@language":"sv","@value":"Bisexuell sf"}],"rdfs:comment":[{"@language":"en","@value":"Genre of written works that depicts imaginative or futuristic concepts incorporating science, technology, space, time travel, and other speculative elements. Use for science fiction focusing on bisexual characters or themes."},{"@language":"de","@value":"Werke über phantasievolle oder futuristische Konzepte, die Wissenschaft, Technologie, Raumfahrt, Zeitreisen und andere spekulative Elemente beinhalten; Verwendung in Bezug auf Science Fiction mit einem Schwerpunkt auf bisexuellen Charakteren oder Themen."},{"@language":"es","@value":"Obras literarias escritas sobre conceptos imaginativos o futuristas que incorporen la ciencia, la tecnología, el espacio, los viajes en el tiempo y otros elementos especulativos; utilícese en referencia a la ciencia ficción centrada en personajes o temas bisexuales."},{"@language":"nl","@value":"Geschreven literair werk over fantasierijke of futuristische concepten waarin wetenschap, technologie, ruimte, tijdreizen en andere speculatieve elementen zijn verwerkt; gebruik in verwijzing naar science fiction gericht op biseksuele personages of thema's."},{"@language":"sv","@value":"Skönlitterära verk om imaginära eller futuristiska koncept som involverar vetenskap, teknologi, rymden, tidsresor och andra spekulativa element. Används för science fiction med bisexuella karaktärer eller teman."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000934"},{"@id":"https://homosaurus.org/v5/homoit0000151"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualScienceFiction"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-03"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001577","dc:identifier":"homoit0001577","skos:prefLabel":[{"@language":"en","@value":"Bisexual mystery and detective fiction"},{"@language":"de","@value":"Bisexuelle Krimis und Detektivgeschichten"},{"@language":"es","@value":"Ficción bisexual de misterio y detectives"},{"@language":"nl","@value":"Biseksuele detectiveverhalen"},{"@language":"sv","@value":"Bisexuella deckare"}],"skos:altLabel":[{"@language":"en","@value":"Bi mystery and detective fiction"},{"@language":"de","@value":"Bisexuelle Krimis und Detektivromane"}],"rdfs:comment":[{"@language":"en","@value":"Genre of written works that depicts the investigation of crime or the work of detectives. Use for mystery and detective fiction focusing on bisexual characters or themes."},{"@language":"de","@value":"Geschriebene literarische Werke über die Aufklärung von Verbrechen oder die Arbeit von Detektiv:innen; Verwendung in Bezug auf Mystery- und Detektivromane mit Schwerpunkt auf bisexuelle Charakteren und Themen."},{"@language":"es","@value":"Obras literarias escritas sobre la investigación de crímenes o el trabajo de detectives; utilícese en referencia a la ficción de misterio y de detectives centrada en personajes y temas bisexuales."},{"@language":"nl","@value":"Geschreven literaire werken over misdaadonderzoek of het werk van rechercheurs; gebruik met verwijzing naar detectiveverhalen gericht op biseksuele personages of thema's"},{"@language":"sv","@value":"Skönlitterära verk om brottsutredningar eller detektivarbete. Används för deckare och mysterielitteratur med bisexuella karaktärer eller teman."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000852"},{"@id":"https://homosaurus.org/v5/homoit0000151"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualMysteryAndDetectiveFiction"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-03"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001752","dc:identifier":"homoit0001752","skos:prefLabel":[{"@language":"en","@value":"Intersex fiction"},{"@language":"es","@value":"Ficción intersexual"},{"@language":"nl","@value":"Intersekse fictie"},{"@language":"sv","@value":"Intersex-skönlitteratur"}],"skos:altLabel":{"@language":"es","@value":"Ficción intersex"},"rdfs:comment":[{"@language":"en","@value":"Genre of written works that depicts imagined events or people. Use for fiction focusing on intersex characters or themes."},{"@language":"es","@value":"Obras escritas de ficción que presentan personajes intersex o abordan temas intersex."},{"@language":"nl","@value":"Fictie met intersekse karakters of intersekse thema's"},{"@language":"sv","@value":"Litterära verk som beskriver fiktiva händelser eller personer. Används för skönlitteratur med intersex-karaktärer eller intersex-teman."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000443"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0002419"},{"@id":"https://homosaurus.org/v5/homoit0002428"},{"@id":"https://homosaurus.org/v5/homoit0002432"},{"@id":"https://homosaurus.org/v5/homoit0002435"},{"@id":"https://homosaurus.org/v5/homoit0002440"},{"@id":"https://homosaurus.org/v5/homoit0004301"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000151"},{"@id":"https://homosaurus.org/v5/homoit0000493"},{"@id":"https://homosaurus.org/v5/homoit0000827"},{"@id":"https://homosaurus.org/v5/homoit0001177"},{"@id":"https://homosaurus.org/v5/homoit0001414"},{"@id":"https://homosaurus.org/v5/homoit0001749"},{"@id":"https://homosaurus.org