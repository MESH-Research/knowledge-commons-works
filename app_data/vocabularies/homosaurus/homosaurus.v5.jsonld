value":"Vaginal fistning"}],"rdfs:comment":[{"@language":"en","@value":"Sexual practice of inserting a fist into a vagina."},{"@language":"es","@value":"Práctica sexual de introducir un puño en la vagina."},{"@language":"nl","@value":"Seksuele praktijk van het inbrengen van een vuist in een vagina"},{"@language":"sv","@value":"Sexuell praktik som innebär att en hel knytnäve förs in i en vagina."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000445"},{"@id":"https://homosaurus.org/v5/homoit0001487"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000042"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001299"},"dc:replaces":{"@id":"http://homosaurus.org/v2/vaginalFisting"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001299","dc:identifier":"homoit0001299","skos:prefLabel":[{"@language":"en","@value":"Sexual practices"},{"@language":"es","@value":"Prácticas sexuales"},{"@language":"nl","@value":"Seksuele praktijken"},{"@language":"sv","@value":"Sexuella praktiker"}],"rdfs:comment":[{"@language":"en","@value":"Activities associated with physical and/or mental sexual stimuli, including but not limited to intercourse and sexual pleasure."},{"@language":"es","@value":"Actividades asociadas con estímulos sexuales físicos y/o mentales, que incluyen, entre otros, las relaciones sexuales y el placer sexual."},{"@language":"nl","@value":"Activiteiten die verband houden met fysieke en/of mentale seksuele prikkels, inclusief maar niet beperkt tot geslachtsgemeenschap en seksueel genot"},{"@language":"sv","@value":"Aktiviteter kopplade till fysisk och/eller mental sexuell stimulans inklusive men inte begränsat till samlag och sexuell njutning."}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000043"},{"@id":"https://