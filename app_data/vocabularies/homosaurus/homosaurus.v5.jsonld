cept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004000","dc:identifier":"homoit0004000","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ people in visual art"},{"@language":"nl","@value":"LHBTQ+-personen in de beeldende kunst"},{"@language":"sv","@value":"Visuell konst (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"LGBTQ+ people in art"},{"@language":"sv","@value":"Hbtq+-personer i bildkonst"},{"@language":"sv","@value":"Bildkonst (hbtq+)"},{"@language":"sv","@value":"Hbtq+-personer i visuell konst"}],"rdfs:comment":[{"@language":"en","@value":"The depiction of LGBTQ+ people and communities in visual art, including painting, performance art, sculpture, photography, cinema, etc."},{"@language":"nl","@value":"De weergave van LHBTQ+-personen en -gemeenschappen in de beeldende kunst, zoals schilderkunst, performancekunst, beeldhouwkunst, fotografie, film, enz."},{"@language":"sv","@value":"Skildringen av hbtq+-personer och hbtq+-gemenskaper i bildkonst, inklusive måleri, performancekonst, skulptur, fotografi, film och andra visuella uttryck."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0003991"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0004001"},{"@id":"https://homosaurus.org/v5/homoit0004002"},{"@id":"https://homosaurus.org/v5/homoit0004003"},{"@id":"https://homosaurus.org/v5/homoit0004004"},{"@id":"https://homosaurus.org/v5/homoit0004005"},{"@id":"https://homosaurus.org/v5/homoit0004006"},{"@id":"https://homosaurus.org/v5/homoit0004007"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0004008"},"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2012004224"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2025-04-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004007","dc:identifier":"homoit0004007","skos:prefLabel":[{"@language":"en","@value":"Non-binary people in visual art"},{"@language":"nl","@value":"non-binaire personen in de beeldende kunst"},{"@language":"sv","@value":"Ickebinära i visuell konst"}],"skos:altLabel":[{"@language":"en","@value":"Nonbinary people in visual art"},{"@language":"en","@value":"Non-binary people in art"},{"@language":"en","@value":"Nonbinary people in art"},{"@language":"nl","@value":"nonbinaire personen in de beeldende kunst"},{"@language":"nl","@value":"nonbinaire personen in de kunst"},{"@language":"sv","@value":"Ickebinära i bildkonst"}],"rdfs:comment":[{"@language":"en","@value":"The depiction of non-binary people and communities in visual art, including painting, performance art, sculpture, photography, cinema, etc."},{"@language":"nl","@value":"De weergave van non-binaire personen en gemeenschappen in de beeldende kunst, zoals schilderkunst, performancekunst, beeldhouwkunst, fotografie, film, enz."},{"@language":"sv","@value":"Skildringen av ickebinära och ickebinära gemenskaper i bildkonst, inklusive måleri, performancekonst, skulptur, fotografi, film och andra visuella uttryck."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0004000"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2025-04-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004025","dc:identifier":"homoit0004025","skos:prefLabel":[{"@language":"en","@value":"Non-binary people in literature"},{"@language":"nl","@value":"Non-binaire personen in de literatuur"},{"@language":"sv","@value":"Ickebinära i litteraturen"}],"skos:altLabel":{"@language":"en","@value":"Nonbinary people in literature"},"rdfs:comment":[{"@language":"en","@value":"The depiction of non-binary people in literature."},{"@language":"nl","@value":"Het weergeven van non-binaire personen in de literatuur."},{"@language":"sv","@value":"Skildringen av ickebinära i litteraturen."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0004018"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2025-04-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004145","dc:identifier":"homoit0004145","skos:prefLabel":[{"@language":"en","@value":"Ainu lesbians"},{"@language":"ja","@value":"アイヌの女性同性愛者"},{"@language":"nl","@value":"Ainu lesbische vrouwen"},{"@language":"sv","@value":"Lesbiska ainu"}],"skos:altLabel":[{"@language":"en","@value":"Lesbian Ainu people"},{"@language":"en","@value":"アイヌのレズビアン"}],"rdfs:comment":[{"@language":"en","@value":"Lesbians who belong to the Ainu, an Indigenous ethnic group that has historically resided in Ainu Mosir, or the land of the Ainu, in what is now known as Japan. Only use to refer to people who self-identify as Ainu."},{"@language":"ja","@value":"現在、日本の北海道、および樺太、千島列島の「アイヌ・モシリ」（アイヌの土地）に古くから居住してきた先住民族であるアイヌに属する女性同性愛者（レズビアン）。アイヌとして自己認識している人々にのみ使用する。"},{"@language":"nl","@value":"Lesbische vrouwen die behoren tot de Ainu, een inheemse etnische groep die van oudsher in Ainu Mosir woonde, oftewel het land van de Ainu, in wat nu Japan heet. De term alleen gebruiken voor personen die zichzelf als Ainu identificeren."},{"@language":"sv","@value":"Lesbiska som tillhör ainufolket, ett urfolk med historisk hemvist i Ainu Mosir, ainufolkets traditionella landområde, i det som nu kallas Japan. Används endast för personer som identifierar sig som ainu."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0004144"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2025-04-24"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004146","dc:identifier":"homoit0004146","skos:prefLabel":[{"@language":"en","@value":"Ainu gay men"},{"@language":"en","@value":"アイヌの男性同性愛者"},{"@language":"nl","@value":"Ainu homomannen"},{"@language":"sv","@value":"Bögar som är ainu"}],"skos:altLabel":[{"@language":"en","@value":"Gay Ainu men"},{"@language":"ja","@value":"アイヌのゲイ"},{"@language":"sv","@value":"Homosexuella män som är ainu"}],"rdfs:comment":[{"@language":"en","@value":"Gay men who belong to the Ainu, an Indigenous ethnic group that has historically resided in Ainu Mosir, or the land of the Ainu, in what is now known as Japan. Only use to refer to people who self-identify as Ainu."},{"@language":"ja","@value":"現在、日本の北海道、および樺太、千島列島の「アイヌ・モシリ」（アイヌの土地）に古くから居住してきた先住民族であるアイヌに属する男性同性愛者（ゲイ）。アイヌとして自己認識している人々にのみ使用する。"},{"@language":"nl","@value":"Homomannen die behoren tot de Ainu, een inheemse etnische groep die van oudsher in Ainu Mosir woonde, oftewel het land van de Ainu, in wat nu Japan heet. De term alleen gebruiken voor personen die zichzelf als Ainu identificeren."},{"@language":"sv","@value":"Bögar som tillhör ainufolket, ett urfolk med historisk hemvist i Ainu Mosir, ainufolkets traditionella landområde, i det som nu kallas Japan. Används endast för personer som identifierar sig som ainu."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0004144"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2025-04-24"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004147","dc:identifier":"homoit0004147","skos:prefLa