.org/v5/homoit0000860"},{"@id":"https://homosaurus.org/v5/homoit0001101"}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0002119"},{"@id":"https://homosaurus.org/v5/homoit0002120"},{"@id":"https://homosaurus.org/v5/homoit0002121"},{"@id":"https://homosaurus.org/v5/homoit0002122"},{"@id":"https://homosaurus.org/v5/homoit0002123"},{"@id":"https://homosaurus.org/v5/homoit0002124"},{"@id":"https://homosaurus.org/v5/homoit0002125"},{"@id":"https://homosaurus.org/v5/homoit0003420"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-06-27"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002126","dc:identifier":"homoit0002126","skos:prefLabel":[{"@language":"en","@value":"Dogra LGBTQ+ people"},{"@language":"de","@value":"LGBTQ+-Dogra"},{"@language":"es","@value":"Personas LGBTQ+ dogra"},{"@language":"nl","@value":"Dogra LHBTQ+-personen"},{"@language":"sv","@value":"Hbtq+-personer som är dogra"}],"skos:altLabel":[{"@language":"en","@value":"Dogra people (LGBTQ)"},{"@language":"en","@value":"Dogras (LGBTQ)"},{"@language":"en","@value":"LGBTQ+ Dogra people"},{"@language":"en","@value":"LGBTQ+ Dogras"},{"@language":"de","@value":"LGBTQ+-Dogra-Personen"},{"@language":"de","@value":"Dogra-LGBTQ+-Personen"},{"@language":"es","@value":"Personas dogra LGBTQ+"},{"@language":"nl","@value":"LHBTQ+ Dogra's"}],"rdfs:comment":[{"@language":"en","@value":"LGBTQ+ people who are of the Dogra people of India and Pakistan and speak the Dogri language."},{"@language":"de","@value":"LGBTQ+-Personen, die zum Volk der Dogra in Indien und Pakistan gehören und die Sprache Dogri sprechen."},{"@language":"es","@value":"Personas LGBTQ+ que son de las personas dogra de India y Pakistán, y hablan el idioma dogrí."},{"@language":"nl","@value":"LHBTQ+-personen die tot de