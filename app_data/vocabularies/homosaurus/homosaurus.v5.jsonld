ies"},{"@language":"sv","@value":"Bisexuella relationer"}],"rdfs:comment":[{"@language":"en","@value":"Ongoing connections (romantic, sexual, or platonic) between two or more bisexual people."},{"@language":"de","@value":"Dauerhafte Beziehungen (romantisch, sexuell oder platonisch) zwischen zwei oder mehr bisexuellen Personen."},{"@language":"es","@value":"Conexiones continuas (románticas, sexuales o platónicas) entre dos o más personas bisexuales."},{"@language":"nl","@value":"Voortdurende connecties (romantisch, seksueel of platonisch) tussen twee of meer biseksuele personen."},{"@language":"sv","@value":"Pågående relationer, romantiska, sexuella eller platoniska, mellan två eller flera bisexuella personer."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001237"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000145"},{"@id":"https://homosaurus.org/v5/homoit0000529"},{"@id":"https://homosaurus.org/v5/homoit0000773"},{"@id":"https://homosaurus.org/v5/homoit0001205"},{"@id":"https://homosaurus.org/v5/homoit0001442"},{"@id":"https://homosaurus.org/v5/homoit0004625"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001237"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualRelationships"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000146","dc:identifier":"homoit0000146","skos:prefLabel":[{"@language":"en","@value":"Bisexual daughters"},{"@language":"es","@value":"Hijas bisexuales"},{"@language":"de","@value":"Bisexuelle Töchter"},{"@language":"nl","@value":"Biseksuele dochters"},{"@language":"sv","@value":"Bisexuella döttrar"}],"rdfs:comment":[{"@language":"en","@value":"Daughters who identify as bisexual."},{"@language":"es","@value":"Hijas que se autoidentifican como bisexuales."},{"@language":"de","@value":"Töchter, die sich als bisexuell identifizieren."},{"@language":"nl","@value":"Dochters die zich identificeren als biseksueel"},{"@language":"sv","@value":"Döttrar som identifierar sig som bisexuella."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000330"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualDaughters"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000330","dc:identifier":"homoit0000330","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ daughters"},{"@language":"es","@value":"Hijas LGBTQ+"},{"@language":"ja","@value":"LGBTQ+の娘"},{"@language":"fr","@value":"Filles LGBTQ+"},{"@language":"nl","@value":"LHBTQ+-dochters"},{"@language":"sv","@value":"Döttrar (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"Daughters (LGBTQ)"},{"@language":"es","@value":"Hijas (LGBTQ)"},{"@language":"ja","@value":"娘 (LGBTQ)"},{"@language":"sv","@value":"Hbtq+-döttrar"}],"rdfs:comment":[{"@language":"en","@value":"Daughters who identify as LGBTQ+."},{"@language":"es","@value":"Hijas que se autoidentifican como LGBTQ+."},{"@language":"ja","@value":"LGBTQ+であることを自認する娘。"},{"@language":"fr","@value":"Filles (lien de parenté) qui s'identifient comme LGBTQ+."},{"@language":"nl","@value":"Dochters die zich identificeren als LHBTQ+."},{"@language":"sv","@value":"Döttrar som identifierar sig som hbtq+-personer."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000915"},{"@id":"https://homosaurus.org/v5/homoit0002351"}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000146"},{"@id":"https://homosaurus.org/v5/homoit0000736"},{"@id":"https://homosaurus.org/v5/homoit0001173"},{"@id":"https://homosaurus.org/v5/homoit0001407"},{"@id":"https://homosaurus.org/v5/homoi