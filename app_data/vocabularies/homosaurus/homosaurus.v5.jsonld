xualCharacters"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000249","dc:identifier":"homoit0000249","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ characters"},{"@language":"es","@value":"Personajes LGBTQ+"},{"@language":"ja","@value":"LGBTQ+の登場人物"},{"@language":"nl","@value":"LHBTQ+-personages"},{"@language":"sv","@value":"Hbtq+-karaktärer"}],"skos:altLabel":[{"@language":"en","@value":"Characters (LGBTQ)"},{"@language":"es","@value":"Personajes (LGBTQ)"},{"@language":"ja","@value":"登場人物 (LGBTQ)"}],"rdfs:comment":[{"@language":"en","@value":"Characters in creative works who are LGBTQ+."},{"@language":"es","@value":"Personajes de obras creativas que son LGBTQ+."},{"@language":"ja","@value":"創作作品に登場するLGBTQ+の人物。"},{"@language":"nl","@value":"Personages in creatieve werken die LHBTQ+ zijn."},{"@language":"sv","@value":"Karaktärer i kreativa verk som är hbtq+-personer."}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000139"},{"@id":"https://homosaurus.org/v5/homoit0000481"},{"@id":"https://homosaurus.org/v5/homoit0000729"},{"@id":"https://homosaurus.org/v5/homoit0001166"},{"@id":"https://homosaurus.org/v5/homoit0001399"},{"@id":"https://homosaurus.org/v5/homoit0002770"},{"@id":"https://homosaurus.org/v5/homoit0002967"},{"@id":"https://homosaurus.org/v5/homoit0003660"},{"@id":"https://homosaurus.org/v5/homoit0003661"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000443"},{"@id":"https://homosaurus.org/v5/homoit0000869"},{"@id":"https://homosaurus.org/v5/homoit0001359"},{"@id":"https://homosaurus.org/v5/homoit0002687"},{"@id":"https://homosaurus.org/v5/homoit0003160"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000249"},"dc:replaces":{"@id":"http://homosaurus.org/v2/charactersLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000149","dc:identifier":"homoit0000149","skos:prefLabel":[{"@language":"en","@value":"Bisexual drama"},{"@language":"de","@value":"Bisexuelles Drama"},{"@language":"es","@value":"Drama bisexual"},{"@language":"nl","@value":"Biseksueel drama"},{"@language":"sv","@value":"Bisexuell dramatik"}],"skos:altLabel":[{"@language":"de","@value":"Bisexuelles Theaterstück"},{"@language":"de","@value":"Bisexuelles Bühnenstück"},{"@language":"de","@value":"Bi-Drama"},{"@language":"de","@value":"Bi-Bühnenstück"},{"@language":"de","@value":"Bi-Theaterstück"},{"@language":"sv","@value":"Bisexuell scenkonst"}],"rdfs:comment":[{"@language":"en","@value":"Works of fiction written to be performed; use in reference to dramatic works focusing on bisexual characters or themes."},{"@language":"de","@value":"Belletristische Werke, die für die Aufführung geschrieben wurden; Verwednung in Bezug auf dramatische Werke, die sich auf bisexuelle Charaktere oder Themen konzentrieren."},{"@language":"es","@value":"Obras de ficción escritas para ser puestas en escena; utilícese en referencia a obras dramáticas que se centran en personajes o temas bisexuales."},{"@language":"nl","@value":"Fictieve werken die zijn geschreven om uitgevoerd te worden; gebruiken om te verwijzen naar dramatische werken die zich richten op biseksuele personages of thema's"},{"@language":"sv","@value":"Fiktion avsedd för sceniskt framförande med bisexuella gestalter eller teman."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000376"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000139"},{"@id":"https://homosaurus.org/v5/homoit0000157"},{"@id":"https://homosaurus.org/v5/homoit0000194"},{"@id":"https://homosaurus.org/v5/homoit0001726"}],"skos:hasTopConcept":{"@id":"ht