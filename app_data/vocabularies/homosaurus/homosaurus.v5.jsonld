anischen Ländern geboren sind und in lateinamerikanischen Ländern leben oder eine starke Verbindung zu lateinamerikanischen Ländern haben. Nur für Personen verwenden, die sich selbst als afrolateinamerikanisch bezeichnen."},{"@language":"nl","@value":"Aseksuele mensen van Afrikaanse afkomst geboren in Latijns-Amerikaanse landen of aseksuele mensen geboren in Afrikaanse landen die in Latijns-Amerika wonen of daar een sterke band mee hebben. Alleen gebruiken voor personen die zichzelf identificeren als Afro-Latijns-Amerikaan."},{"@language":"sv","@value":"Asexuella personer av afrikansk härkomst födda i latinamerikanska länder eller asexuella personer födda i afrikanska länder som bor i eller har en stark anknytning till Latinamerika. Använd endast för personer som identifierar sig som afrolatinos."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000019"},{"@id":"https://homosaurus.org/v5/homoit0002334"},{"@id":"https://homosaurus.org/v5/homoit0002897"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-29"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002960","dc:identifier":"homoit0002960","skos:prefLabel":[{"@language":"en","@value":"Afro-Latin American intersex people"},{"@language":"es","@value":"Personas intersexuales afrolatinoamericanas"},{"@language":"de","@value":"Afrolateinamerikanische inter* Personen"},{"@language":"nl","@value":"Afro-Latijns-Amerikaanse intersekse personen"},{"@language":"sv","@value":"Afrolatinska intersexperson"}],"skos:altLabel":[{"@language":"en","@value":"Afro-Latina intersex people"},{"@language":"en","@value":"Afro-Latine intersex people"},{"@language":"en","@value":"Afro-Latino intersex people"},{"@language":"en","@value":"Afro-Latino/a/x intersex people"},{"@language":"en","@value":"Afro-Latinx intersex people"},{"@language":"en","@value":"Intersex Afro-Latin Americans"},{"@language":"en","@value":"Intersex Afro-Latinas"},{"@language":"en","@value":"Intersex Afro-Latine people"},{"@language":"en","@value":"Intersex Afro-Latinos"},{"@language":"en","@value":"Intersex Afro-Latinx people"},{"@language":"es","@value":"Intersex afrolatinoamericanos"},{"@language":"es","@value":"Personas afrolatinoamericanas intersex"},{"@language":"es","@value":"Personas intersex afrolatinoamericanas"},{"@language":"es","@value":"Personas afrolatinas intersex"},{"@language":"es","@value":"Personas intersex afrolatinas"},{"@language":"es","@value":"Intersex afrolatinos"},{"@language":"es","@value":"Afrolatinos intersex"},{"@language":"es","@value":"Intersex afrolatinxs"},{"@language":"es","@value":"Afrolatinxs intersex"},{"@language":"es","@value":"Intersex afrolatinas"},{"@language":"es","@value":"Afrolatinas intersex||"},{"@language":"de","@value":"Inter* afrolateinamerikanische Personen"},{"@language":"nl","@value":"Afro-Latine intersekse personen"},{"@language":"nl","@value":"Afro-Latino intersekse personen"},{"@language":"nl","@value":"Afro-Latino/a/x intersekse personen"},{"@language":"nl","@value":"Afro-Latinx intersekse personen"},{"@language":"nl","@value":"Intersekse Afro-Latijns-Amerikanen"},{"@language":"nl","@value":"Intersekse Afro-Latinas"},{"@language":"nl","@value":"Intersekse Afro-Latine personen"},{"@language":"nl","@value":"Intersekse Afro-Latinos"},{"@language":"nl","@value":"Intersekse Afro-Latinx personen"}],"rdfs:comment":[{"@language":"en","@value":"Intersex people of African descent born in Latin American countries or intersex people born in African countries who live in or have a strong connection to Latin America. Only use for individuals who self-identify as Afro-Latin American."},{"@language":"es","@value":"Personas intersexuales de ascendencia africana nacidas en países latinoamericanos o personas intersexuales nacidas en países africanos que viven o tienen una conexión fuerte con América Latina. Utilícese únicamente para personas que se identifiquen como afrolatinoamericanas."},{"@language":"de","@value":"Inter* Personen afrikanischer Abstammung, die in lateinamerikanischen Ländern geboren sind, oder inter* Personen, die in afrikanischen Ländern geboren sind und in lateinamerikanischen Ländern leben oder eine starke Verbindung zu lateinamerikanischen Ländern haben. Nur für Personen verwenden, die sich selbst als afrolateinamerikanisch bezeichnen."},{"@language":"nl","@value":"Intersekse mensen van Afrikaanse afkomst geboren in Latijns-Amerikaanse landen of intersekse mensen geboren in Afrikaanse landen die in Latijns-Amerika wonen of daar een sterke band mee hebben. Alleen gebruiken voor personen die zichzelf identificeren als Afro-Latijns-Amerikaan."},{"@language":"sv","@value":"Intersexpersoner av afrikansk härkomst födda i latinamerikanska länder eller intersexpersoner födda i afrikanska länder som bor i eller har en stark anknytning till Latinamerika. Använd endast för personer som identifierar sig som afrolatinos."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000019"},{"@id":"https://homosaurus.org/v5/homoit0002764"},{"@id":"https://homosaurus.org/v5/homoit0002769"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-09-29"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000020","dc:identifier":"homoit0000020","skos:prefLabel":[{"@language":"en","@value":"Age of consent"},{"@language":"es","@value":"Edad de consentimiento"},{"@language":"de","@value":"Schutzalter"},{"@language":"fr","@value":"Âge de consentement"},{"@language":"nl","@value":"Leeftijd voor seksuele meerderjarigheid"},{"@language":"sv","@value":"Sexuell myndighetsålder"}],"skos:altLabel":[{"@language":"de","@value":"Mündigkeitsalter"},{"@language":"fr","@value":"Âge du consentement"},{"@language":"fr","@value":"Majorité sexuelle"},{"@language":"sv","@value":"Samtyckesålder"},{"@language":"sv","@value":"Byxmyndighet"}],"rdfs:comment":[{"@language":"en","@value":"The age at which a person is considered legally competent to consent to sexual acts. The age of consent varies depending on the country, state, or culture."},{"@language":"es","@value":"La edad en la que una persona es considerada legalmente competente para consentir a actos sexuales. La edad de consentimiento varía según el país, el estado o la cultura."},{"@language":"de","@value":"Das Alter, in dem eine Person als rechtlich befähigt gilt, in sexuelle Handlungen einzuwilligen. Das Schutzalter variiert je nach Land, Staat oder Kultur."},{"@language":"fr","@value":"Âge auquel une personne peut légalement donner son consentement à des activités sexuelles."},{"@language":"nl","@value":"De leeftijd waarop een persoon wettelijk in staat wordt geacht om in te stemmen met seksuele handelingen; deze leeftijd varieert afhankelijk van het land, de staat of de cultuur"},{"@language":"sv","@value":"Åldern vid vilken en person anses juridiskt kapabel att ge samtycke till sexuella handlingar. Samtyckesåldern varierar beroende på land, plats eller kultur."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000302"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000663"},{"@id":"https://homosaurus.org/v5/homoit0001289"},{"@id":"https://homosaurus.org/v5/homoit0002215"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85002086"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000302"},"dc:replaces":{"@id":"http://homosaurus.org/v2/ageOfConsent"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000302","dc:identifier":"homoit0000302","skos:prefLabel":[{"@language":"en","@value":"Consent"},{"@language":"es","@value":"Consentimiento"},{"@language":"de","@value":"Konsens"},{"@language":"nl","@value":"Toestemming geven"},{"@language":"sv","@value":"Samtycke"}],"skos:altLabel":{"@language":"de","@value":"Einvernehmlichkeit"},"rdfs:comment":[{"@language":"en","@value":"Permission or agreement for a set of actions to occur, particularly in a sexual encounter and/or within a relational dynamic."},{"@language":"es","@value":"Permiso o acuerdo para que ocurra un conjunto de acciones, particularmente en un encuentro sexual y/o dentro de una dinámica relacional."},{"@language":"de","@value":"Erlaubnis oder Zustimmung für eine Reihe von Handlungen, insbesondere im Rahmen einer sexuellen Begegnung und/oder innerhalb einer Beziehungsdynamik."},{"@language":"nl","@value":"Toestemming of overeenkomst met name inzake een seksuele ontmoeting en/of binnen een relationele dynamiek"},{"@language":"sv","@value":"Tillåtande eller överenskommelse om att vissa handlingar får äga rum, särskilt i ett sexuellt sammanhang och/eller inom en relationell dynamik."}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000020"},{"@id":"https://homosaurus.org/v5/homoit0002844"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000241"},{"@id":"https://homosaurus.org/v5/homoit0000442"},{"@id":"https://homosaurus.org/v5/homoit0000855"},{"@id":"https://homosaurus.org/v5/homoit0000938"},{"@id":"https://homosaurus.org/v5/homoit0000958"},{"@id":"https://homosaurus.org/v5/homoit0000959"},{"@id":"https://homosaurus.org/v5/homoit0001123"},{"@id":"https://homosaurus.org/v5/homoit0001124"},{"@id":"https://homosaurus.org/v5/homoit0001133"},{"@id":"https://homosaurus.org/v5/homoit0001267"},{"@id":"https://homosaurus.org/v5/homoit0001299"},{"@id":"https://homosaurus.org/v5/homoit0002195"},{"@id":"https://homosaurus.org/v5/homoit0002215"}],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh98003848"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000302"},"dc:replaces":{"@id":"http://homosaurus.org/v2/consent"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000663","dc:identifier":"homoit0000663","skos:prefLabel":[{"@language":"en","@value":"Intergenerational relationships"},{"@language":"es","@value":"Relaciones intergeneracionales"},{"@language":"nl","@value":"Intergenerationele relaties"},{"@language":"sv","@value":"Intergenerationella relationer"}],"skos:altLabel":[{"@language":"sv","@value":"Förhållanden över generationsgränser"},{"@language":"sv","@value":"Intergenerationella förhållanden"},{"@language":"sv","@value":"Relationer över generationsgränser"},{"@language":"sv","@value":"Relationer med åldersskillnad"}],"rdfs:comment":[{"@language":"en","@value":"Ongoing connections (romantic, sexual, play, or platonic) between two or more people of different age groups or from different generations."},{"@language":"es","@value":"Conexiones continuas (románticas, sexuales, lúdicas o platónicas) entre dos o más personas de diferentes grupos de edad o de diferentes generaciones."},{"@language":"nl","@value":"Langer lopende connecties (romantisch, seksueel, spel of platonisch) tussen twee of meer mensen van verschillende leeftijdsgroepen of van verschillende generaties."},{"@language":"sv","@value":"Pågående relationer (romantiska, sexuella, kinkbaserade eller platoniska) mellan två eller flera personer från olika åldersgrupper eller generationer."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001237"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000020"},{"@id":"https://homosaurus.org/v5/homoit0001295"},{"@id":"https://homosaurus.org/v5/homoit0001636"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85067264"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001237"},"dc:replaces":{"@id":"http://homosaurus.org/v2/intergenerationalRelationships"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001289","dc:identifier":"homoit0001289","skos:prefLabel":[{"@language":"en","@value":"Sexual offenses laws"},{"@language":"es","@value":"Leyes sobre delitos sexuales"},{"@language":"nl","@value":"Zedelijkheidswetgeving"},{"@language":"sv","@value":"Sexualbrottslagstiftning"}],"skos:altLabel":[{"@language":"en","@value":"Sexual criminal codes"},{"@language":"es","@value":"Códigos criminales sexuales"},{"@language":"sv","@value":"Sexualstraffrätt"}],"rdfs:comment":[{"@language":"en","@value":"Legislation determining the kinds of sexual behaviors and activities that are legally permissible. Laws vary by jurisdiction but typically address crimes like sexual coercion, sexual assault, incest, and sex trafficking. Historically and in the present day, sexual offenses laws have also served to criminalize consensual but non-normative sexual practices, such as anal sex and homosexuality."},{"@language":"es","@value":"Legislación que determina los tipos de conductas y actividades sexuales que están legalmente permitidas. Las leyes varían según la jurisdicción, pero normalmente abordan delitos como la coerción sexual, la agresión sexual, el incesto y el tráfico sexual. Históricamente y en la actualidad, las leyes sobre delitos sexuales también han servido para criminalizar prácticas sexuales consensuales pero no normativas, como el sexo anal y la homosexualidad."},{"@language":"nl","@value":"Wetgeving die bepaalt welk seksueel gedrag en activiteiten wettelijk zijn toegestaan. Wetten verschillen per rechtsgebied, maar hebben doorgaans betrekking op misdrijven zoals seksuele dwang, aanranding, incest en sekshandel. Historisch gezien en in de huidige tijd hebben wetten op zedendelicten ook gediend om consensuele maar niet-normatieve seksuele praktijken, zoals anale seks en homoseksualiteit, strafbaar te stellen."},{"@language":"sv","@value":"Lagstiftning som reglerar vilka sexuella beteenden och handlingar som är tillåtna enligt lag. Lagarna varierar mellan olika rättssystem men omfattar ofta brott som sexuellt tvång, övergrepp, incest och människohandel för sexuella ändamål. Både historiskt och i nutid har sådan lagstiftning även använts för att kriminalisera samtyckta sexuella praktiker som avviker från normer, exempelvis analsex och homosexualitet."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000313"},"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0001326"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000020"},{"@id":"https://homosaurus.org/v5/homoit0002373"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000702"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sexualOffencesLaws"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002215","dc:identifier":"homoit0002215","skos:prefLabel":[{"@language":"en","@value":"Underage (Content warning)"},{"@language":"es","@value":"Menor de edad (Advertencia de contenido)"},{"@language":"nl","@value":"Minderjarig (Inhoudswaarschuwing)"},{"@language":"sv","@value":"Minderårig (innehållsvarning)"}],"rdfs:comment":[{"@language":"en","@value":"A content warning applied to fanworks to signal the depiction of people under the age of consent in sexual situations, either with other underage people or adults."},{"@language":"es","@value":"Advertencia de contenido aplicada a las obras de fans para señalar la representación de personas menores a la de edad de consentimiento en situaciones sexuales, ya sea con otras personas menores de edad o con personas adultas."},{"@language":"nl","@value":"Een inhoudswaarschuwing toegepast op fanwerken om de afbeelding van minderjarigen in seksuele situaties te signaleren, zowel met andere minderjarige mensen als met volwassenen"},{"@language":"sv","@value":"Innehållsvarning som används i fanverk för att signalera att minderåriga personer förekommer i sexuella situationer, antingen med andra minderåriga eller med vuxna."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001807"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000020"},{"@id":"https://homosaurus.org/v5/homoit0000302"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000021","dc:identifier":"homoit0000021","skos:prefLabel":[{"@language":"en","@value":"Agender people"},{"@language":"es","@value":"Personas agénero"},{"@language":"de","@value":"Agender Personen"},{"@language":"fr","@value":"Personnes agenres"},{"@language":"nl","@value":"Agender personen"},{"@language":"sv","@value":"Agenderpersoner"}],"rdfs:comment":[{"@language":"en","@value":"People who identify as not having a gender, or being genderless."},{"@language":"es","@value":"Personas que se autoidentifican como sin género."},{"@language":"de","@value":"Personen, sich als kein Gender habend identifizieren oder genderlos sind."},{"@language":"fr","@value":"Personnes qui ne ressentent pas d'identité de genre ou qui refusent totalement ou partiellement l'apposition d'une identité de genre."},{"@language":"sv","@value":"Personer som identifierar sig som könlösa eller som saknar kön."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001378"},{"@id":"https://homosaurus.org/v5/homoit0001817"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000571"},{"@id":"https://homosaurus.org/v5/homoit0001048"},{"@id":"https://homosaurus.org/v5/homoit0001927"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/agenderPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001378","dc:identifier":"homoit0001378","skos:prefLabel":[{"@language":"en","@value":"Transgender people"},{"@language":"es","@value":"Personas transgénero"},{"@language":"nl","@value":"Transgender personen"},{"@language":"sv","@value":"Transpersoner"}],"skos:altLabel":[{"@language":"en","@value":"Trans people"},{"@language":"en","@value":"Transgendered people"},{"@language":"en","@value":"Transpeople"},{"@language":"en","@value":"Trans-people"},{"@language":"en","@value":"Transgender-identified people"},{"@language":"en","@value":"Trans-identified people"},{"@language":"en","@value":"Trans* people"},{"@language":"es","@value":"Personas trans"},{"@language":"es","@value":"Personas trans*"},{"@language":"nl","@value":"Trans-personen"},{"@language":"nl","@value":"Transgender mensen"},{"@language":"nl","@value":"Transgenders"},{"@language":"nl","@value":"Transmensen"},{"@language":"nl","@value":"Transpersonen"}],"rdfs:comment":[{"@language":"en","@value":"Broad term for people who do not conform to their gender assigned at birth. Add more specific terms when possible."},{"@language":"es","@value":"Término amplio para personas que no se ajustan al género asignado al nacer. Agregue términos más específicos cuando sea posible."},{"@language":"nl","@value":"Brede term voor mensen die zich niet conformeren aan hun geslacht/gender dat bij de geboorte is toegewezen. Voeg indien mogelijk meer specifieke termen toe"},{"@language":"sv","@value":"Samlingsterm för personer som inte identifierar sig med det kön de tilldelades vid födseln. Använd mer specifika termer när det är möjligt."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000915"},{"@id":"https://homosaurus.org/v5/homoit0001817"}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000021"},{"@id":"https://homosaurus.org/v5/homoit0000045"},{"@id":"https://homosaurus.org/v5/homoit0000111"},{"@id":"https://homosaurus.org/v5/homoit0000342"},{"@id":"https://homosaurus.org/v5/homoit0000457"},{"@id":"https://homosaurus.org/v5/homoit0000570"},{"@id":"https://homosaurus.org/v5/homoit0001027"},{"@id":"https://homosaurus.org/v5/homoit0001048"},{"@id":"https://homosaurus.org/v5/homoit0001058"},{"@id":"https://homosaurus.org/v5/homoit0001072"},{"@id":"https://homosaurus.org/v5/homoit0001369"},{"@id":"https://homosaurus.org/v5/homoit0001381"},{"@id":"https://homosaurus.org/v5/homoit0001382"},{"@id":"https://homosaurus.org/v5/homoit0001400"},{"@id":"https://homosaurus.org/v5/homoit0001407"},{"@id":"https://homosaurus.org/v5/homoit0001413"},{"@id":"https://homosaurus.org/v5/homoit0001422"},{"@id":"https://homosaurus.org/v5/homoit0001430"},{"@id":"https://homosaurus.org/v5/homoit0001446"},{"@id":"https://homosaurus.org/v5/homoit0001452"},{"@id":"https://homosaurus.org/v5/homoit0001466"},{"@id":"https://homosaurus.org/v5/homoit0001474"},{"@id":"https://homosaurus.org/v5/homoit0001642"},{"@id":"https://homosaurus.org/v5/homoit0001643"},{"@id":"https://homosaurus.org/v5/homoit0001668"},{"@id":"https://homosaurus.org/v5/homoit0001784"},{"@id":"https://homosaurus.org/v5/homoit0003045"},{"@id":"https://homosaurus.org/v5/homoit0003226"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000120"},{"@id":"https://homosaurus.org/v5/homoit0000271"},{"@id":"https://homosaurus.org/v5/homoit0000288"},{"@id":"https://homosaurus.org/v5/homoit0000316"},{"@id":"https://homosaurus.org/v5/homoit0000317"},{"@id":"https://homosaurus.org/v5/homoit0000322"},{"@id":"https://homosaurus.org/v5/homoit0000396"},{"@id":"https://homosaurus.org/v5/homoit0000561"},{"@id":"https://homosaurus.org/v5/homoit0000566"},{"@id":"https://homosaurus.org/v5/homoit0000571"},{"@id":"https://homosaurus.org/v5/homoit0000572"},{"@id":"https://homosaurus.org/v5/homoit0000573"},{"@id":"https://homosaurus.org/v5/homoit0000574"},{"@id":"https://homosaurus.org/v5/homoit0000582"},{"@id":"https://homosaurus.org/v5/homoit0001008"},{"@id":"https://homosaurus.org/v5/homoit0001047"},{"@id":"https://homosaurus.org/v5/homoit0001049"},{"@id":"https://homosaurus.org/v5/homoit0001078"},{"@id":"https://homosaurus.org/v5/homoit0001089"},{"@id":"https://homosaurus.org/v5/homoit0001090"},{"@id":"https://homosaurus.org/v5/homoit0001107"},{"@id":"https://homosaurus.org/v5/homoit0001129"},{"@id":"https://homosaurus.org/v5/homoit0001131"},{"@id":"https://homosaurus.org/v5/homoit0001233"},{"@id":"https://homosaurus.org/v5/homoit0001399"},{"@id":"https://homosaurus.org/v5/homoit0001403"},{"@id":"https://homosaurus.org/v5/homoit0001404"},{"@id":"https://homosaurus.org/v5/homoit0001415"},{"@id":"https://homosaurus.org/v5/homoit0001431"},{"@id":"https://homosaurus.org/v5/homoit0001463"},{"@id":"https://homosaurus.org/v5/homoit0001464"},{"@id":"https://homosaurus.org/v5/homoit0001465"},{"@id":"https://homosaurus.org/v5/homoit0001467"},{"@id":"https://homosaurus.org/v5/homoit0001470"},{"@id":"https://homosaurus.org/v5/homoit0001509"},{"@id":"https://homosaurus.org/v5/homoit0001563"},{"@id":"https://homosaurus.org/v5/homoit0001780"},{"@id":"https://homosaurus.org/v5/homoit0001781"},{"@id":"https://homosaurus.org/v5/homoit0001818"},{"@id":"https://homosaurus.org/v5/homoit0001883"},{"@id":"https://homosaurus.org/v5/homoit0001918"},{"@id":"https://homosaurus.org/v5/homoit0001921"},{"@id":"https://homosaurus.org/v5/homoit0001922"},{"@id":"https://homosaurus.org/v5/homoit0002033"},{"@id":"https://homosaurus.org/v5/homoit0002211"},{"@id":"https://homosaurus.org/v5/homoit0004327"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2007003708"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transgenderPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001817","dc:identifier":"homoit0001817","skos:prefLabel":[{"@language":"en","@value":"Gender minorities"},{"@language":"es","@value":"Minorías de género"},{"@language":"fr","@value":"Minorités de genre"},{"@language":"nl","@value":"Genderminderheden"},{"@language":"sv","@value":"Könsminoriteter"}],"skos:altLabel":[{"@language":"en","@value":"Gender variance"},{"@language":"en","@value":"Gender variant people"},{"@language":"en","@value":"Non-normative genders"},{"@language":"fr","@value":"Diversité de genre"},{"@language":"nl","@value":"Gendervariantie"},{"@language":"nl","@value":"Niet-normatieve genders"}],"rdfs:comment":[{"@language":"en","@value":"Individuals whose gender identities and practices differ from those of the dominant culture. Use the term \"Sexual minorities\" for individuals whose sexual identities, orientations, and practices differ from those of the dominant culture."},{"@language":"es","@value":"Personas cuyas identidades y prácticas de género difieren de las de la cultura dominante. Utilícese el término \"minorías sexuales\" para personas cuyas identidades, orientaciones y prácticas sexuales difieren de las personas de la cultura dominante."},{"@language":"fr","@value":"Personnes dont l'identité et les pratiques de genre diffèrent de celles de la culture dominante."},{"@language":"nl","@value":"Personen wiens genderidentiteiten en -praktijken verschillen van die van de dominante cultuur; gebruik \"Seksuele minderheden\" voor personen wiens seksuele identiteit, oriëntaties en praktijken verschillen van die van de dominante cultuur"},{"@language":"sv","@value":"Personer vars könsidentitet och könsuttryck skiljer sig från den dominerande kulturens normer. Använd termen ”sexuella minoriteter” för att beskriva personer vars sexuella identiteter, läggningar eller praktiker skiljer sig från majoritetens."}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000021"},{"@id":"https://homosaurus.org/v5/homoit0000045"},{"@id":"https://homosaurus.org/v5/homoit0000316"},{"@id":"https://homosaurus.org/v5/homoit0000342"},{"@id":"https://homosaurus.org/v5/homoit0000570"},{"@id":"https://homosaurus.org/v5/homoit0000574"},{"@id":"https://homosaurus.org/v5/homoit0000582"},{"@id":"https://homosaurus.org/v5/homoit0001072"},{"@id":"https://homosaurus.org/v5/homoit0001378"},{"@id":"https://homosaurus.org/v5/homoit0001470"},{"@id":"https://homosaurus.org/v5/homoit0001474"},{"@id":"https://homosaurus.org/v5/homoit0001668"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000560"},{"@id":"https://homosaurus.org/v5/homoit0000566"},{"@id":"https://homosaurus.org/v5/homoit0000571"},{"@id":"https://homosaurus.org/v5/homoit0000577"},{"@id":"https://homosaurus.org/v5/homoit0000581"},{"@id":"https://homosaurus.org/v5/homoit0001297"},{"@id":"https://homosaurus.org/v5/homoit0001816"},{"@id":"https://homosaurus.org/v5/homoit0001829"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001817"},"dc:issued":{"@type":"xsd:date","@value":"2022-02-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000571","dc:identifier":"homoit0000571","skos:prefLabel":[{"@language":"en","@value":"Gender identity"},{"@language":"es","@value":"Identidad de género"},{"@language":"fr","@value":"Identité de genre"},{"@language":"nl","@value":"Genderidentiteit"},{"@language":"sv","@value":"Könsidentitet"}],"skos:altLabel":{"@language":"en","@value":"Gender-variant identity"},"rdfs:comment":[{"@language":"en","@value":"A person’s experience of having a particular gender, which may or may not correspond with the gender or sex they were assigned at birth. Not to be used to describe solely women’s experiences or women’s studies."},{"@language":"es","@value":"La experiencia de una persona de tener un género particular, que puede o no corresponder al género o sexo asignado al nacer."},{"@language":"fr","@value":"Expérience intime et profonde d'une personne par rapport à son genre, qui peut ou non correspondre au genre ou au sexe qui lui a été assigné à la naissance."},{"@language":"nl","@value":"De ervaring van een persoon om een bepaald geslacht te hebben, dat al dan niet overeenkomt met het geslacht dat deze persoon bij de geboorte is toegewezen"},{"@language":"sv","@value":"En persons erfarenhet av att ha ett visst kön, vilket kan – men inte måste – överensstämma med det kön eller den könstillhörighet som tilldelades vid födseln."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000560"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000078"},{"@id":"https://homosaurus.org/v5/homoit0000110"},{"@id":"https://homosaurus.org/v5/homoit0000322"},{"@id":"https://homosaurus.org/v5/homoit0000569"},{"@id":"https://homosaurus.org/v5/homoit0001008"},{"@id":"https://homosaurus.org/v5/homoit0001071"},{"@id":"https://homosaurus.org/v5/homoit0001415"},{"@id":"https://homosaurus.org/v5/homoit0001473"},{"@id":"https://homosaurus.org/v5/homoit0001509"},{"@id":"https://homosaurus.org/v5/homoit0001670"},{"@id":"https://homosaurus.org/v5/homoit0001756"},{"@id":"https://homosaurus.org/v5/homoit0001918"},{"@id":"https://homosaurus.org/v5/homoit0001920"},{"@id":"https://homosaurus.org/v5/homoit0001921"},{"@id":"https://homosaurus.org/v5/homoit0001922"},{"@id":"https://homosaurus.org/v5/homoit0001923"},{"@id":"https://homosaurus.org/v5/homoit0001925"},{"@id":"https://homosaurus.org/v5/homoit0001927"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000021"},{"@id":"https://homosaurus.org/v5/homoit0000271"},{"@id":"https://homosaurus.org/v5/homoit0000342"},{"@id":"https://homosaurus.org/v5/homoit0000563"},{"@id":"https://homosaurus.org/v5/homoit0000565"},{"@id":"https://homosaurus.org/v5/homoit0000566"},{"@id":"https://homosaurus.org/v5/homoit0000567"},{"@id":"https://homosaurus.org/v5/homoit0000568"},{"@id":"https://homosaurus.org/v5/homoit0000570"},{"@id":"https://homosaurus.org/v5/homoit0000577"},{"@id":"https://homosaurus.org/v5/homoit0000580"},{"@id":"https://homosaurus.org/v5/homoit0001016"},{"@id":"https://homosaurus.org/v5/homoit0001048"},{"@id":"https://homosaurus.org/v5/homoit0001295"},{"@id":"https://homosaurus.org/v5/homoit0001378"},{"@id":"https://homosaurus.org/v5/homoit0001463"},{"@id":"https://homosaurus.org/v5/homoit0001465"},{"@id":"https://homosaurus.org/v5/homoit0001563"},{"@id":"https://homosaurus.org/v5/homoit0001671"},{"@id":"https://homosaurus.org/v5/homoit0001817"},{"@id":"https://homosaurus.org/v5/homoit0002256"},{"@id":"https://homosaurus.org/v5/homoit0002699"},{"@id":"https://homosaurus.org/v5/homoit0002700"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh91003756"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:replaces":{"@id":"http://homosaurus.org/v2/genderIdentity"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001048","dc:identifier":"homoit0001048","skos:prefLabel":[{"@language":"en","@value":"Non-binary people"},{"@language":"es","@value":"Personas no binarias"},{"@language":"fr","@value":"Personnes non-binaires"},{"@language":"nl","@value":"Non-binaire personen"},{"@language":"sv","@value":"Ickebinära"}],"skos:altLabel":[{"@language":"en","@value":"Nonbinary people"},{"@language":"en","@value":"Enbies"},{"@language":"en","@value":"NB-ies"},{"@language":"es","@value":"Enbies"},{"@language":"es","@value":"No binarios"},{"@language":"fr","@value":"enby"},{"@language":"fr","@value":"NB"}],"rdfs:comment":[{"@language":"en","@value":"Individuals whose gender identity exists outside of the gender binary; only use to describe individuals who self-identify as non-binary."},{"@language":"es","@value":"Personas cuya identidad de género existe fuera del binario de género;  utilícese únicamente para describir a personas que se autoidentifiquen como no binarias."},{"@language":"fr","@value":"Personnes dont l'identité de genre se situe en dehors de la binarité de genre; à utiliser uniquement pour décrire les personnes qui s'identifient comme non-binaires."},{"@language":"nl","@value":"Personen wiens genderidentiteit zich buiten het genderbinaire bevindt; alleen gebruiken om personen te beschrijven die zichzelf identificeren als non-binair"},{"@language":"sv","@value":"Personer vars könsidentitet existerar utanför könsbinariteten. Används endast för personer som själva identifierar sig som ickebinära."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001378"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0002223"},{"@id":"https://homosaurus.org/v5/homoit0002387"},{"@id":"https://homosaurus.org/v5/homoit0003043"},{"@id":"https://homosaurus.org/v5/homoit0003227"},{"@id":"https://homosaurus.org/v5/homoit0004639"},{"@id":"https://homosaurus.org/v5/homoit0004644"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000021"},{"@id":"https://homosaurus.org/v5/homoit0000045"},{"@id":"https://homosaurus.org/v5/homoit0000566"},{"@id":"https://homosaurus.org/v5/homoit0000571"},{"@id":"https://homosaurus.org/v5/homoit0001652"},{"@id":"https://homosaurus.org/v5/homoit0001653"},{"@id":"https://homosaurus.org/v5/homoit0001670"},{"@id":"https://homosaurus.org/v5/homoit0001671"},{"@id":"https://homosaurus.org/v5/homoit0001920"},{"@id":"https://homosaurus.org/v5/homoit0002185"},{"@id":"https://homosaurus.org/v5/homoit0004617"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/nonBinaryPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001927","dc:identifier":"homoit0001927","skos:prefLabel":[{"@language":"en","@value":"Agender identity"},{"@language":"es","@value":"Identidad agénero"},{"@language":"de","@value":"Agender Identität"},{"@language":"nl","@value":"Agender identiteit"},{"@language":"sv","@value":"Agender-identitet"}],"rdfs:comment":[{"@language":"en","@value":"Identity term used to describe people who do not have genders or who identify with genderlessness."},{"@language":"es","@value":"Término de identidad utilizado para describir a personas que no tienen género o que se autoidentifiquen con la falta de género."},{"@language":"de","@value":"Identitätsbegriff für Personen, die kein Gender haben oder sich mit der Genderlosigkeit identifizieren."},{"@language":"nl","@value":"Identiteitsterm die wordt gebruikt om mensen te beschrijven die geen genders hebben of die zich identificeren met genderloos"},{"@language":"sv","@value":"Identitetsterm som används för att beskriva personer som inte har något kön eller som identifierar sig som könlösa."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000571"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000021"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2022-03-31"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000022","dc:identifier":"homoit0000022","skos:prefLabel":[{"@language":"en","@value":"Age play"},{"@language":"es","@value":"Juego de edades"},{"@language":"de","@value":"Ageplay"},{"@language":"fr","@value":"Orgasmes"},{"@language":"nl","@value":"Leeftijdsspel"},{"@language":"sv","@value":"Ageplay"}],"skos:altLabel":[{"@language":"en","@value":"ABDL"},{"@language":"en","@value":"Ageplay"},{"@language":"en","@value":"Infantilism"},{"@language":"es","@value":"Age play"},{"@language":"es","@value":"Ageplay"},{"@language":"es","@value":"Juegos con la edad"},{"@language":"de","@value":"ABDL"},{"@language":"sv","@value":"Age play"}],"rdfs:comment":[{"@language":"en","@value":"The act of roleplaying as people of different ages, usually as children, for fun or erotic enjoyment."},{"@language":"es","@value":"Una forma de juego de roles, típicamente sexual, que se da entre personas adultas que consienten en el que uno o más participantes representan una edad diferente a su edad biológica."},{"@language":"de","@value":"Rollenspiele in der Rolle von Personen unterschiedlichen Alters, meist als Kinder, zum Spaß oder zum erotischen Vergnügen."},{"@language":"fr","@value":"Apogées de l'excitation sexuelle, généralement caractérisées par des sensations de plaisir et des sensations physiques, notamment des contractions musculaires rapides, une augmentation de la pression artérielle et du rythme cardiaque, la libération d'endorphines et l'éjaculation."},{"@language":"nl","@value":"Rollenspel met mensen van verschillende leeftijden, meestal als kinderen, voor de lol of erotisch genot."},{"@language":"sv","@value":"Rollspel som innebär att personer antar rollen av en annan ålder, vanligtvis som barn, för nöjes skull eller erotisk njutning."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001242"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000442"},{"@id":"https://homosaurus.org/v5/homoit0003052"},{"@id":"https://homosaurus.org/v5/homoit0003062"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001267"},"dc:replaces":{"@id":"http://homosaurus.org/v2/ageplay"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001242","dc:identifier":"homoit0001242","skos:prefLabel":[{"@language":"en","@value":"Roleplay"},{"@language":"es","@value":"Juego de roles"},{"@language":"nl","@value":"Rollenspel"},{"@language":"sv","@value":"Rollspel"}],"rdfs:comment":[{"@language":"en","@value":"Practice in which one or more people take on a different identity or role to fulfill a desire or fantasy."},{"@language":"es","@value":"Práctica en la que una o más personas asumen una identidad o rol diferente para cumplir un deseo o una fantasía."},{"@language":"nl","@value":"Wanneer een of meer mensen een andere identiteit of rol aannemen om een wens of fantasie te vervullen."},{"@language":"sv","@value":"Rollspel där en eller flera personer antar en annan identitet för att uppfylla en önskan eller fantasi."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001267"},{"@id":"https://homosaurus.org/v5/homoit0003068"}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000022"},{"@id":"https://homosaurus.org/v5/homoit0000576"},{"@id":"https://homosaurus.org/v5/homoit0001145"},{"@id":"https://homosaurus.org/v5/homoit0003067"},{"@id":"https://homosaurus.org/v5/homoit0003082"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000217"},{"@id":"https://homosaurus.org/v5/homoit0001241"},{"@id":"https://homosaurus.org/v5/homoit0001295"},{"@id":"https://homosaurus.org/v5/homoit0001304"},{"@id":"https://homosaurus.org/v5/homoit0002165"},{"@id":"https://homosaurus.org/v5/homoit0002169"},{"@id":"https://homosaurus.org/v5/homoit0002207"},{"@id":"https://homosaurus.org/v5/homoit0003052"},{"@id":"https://homosaurus.org/v5/homoit0003063"},{"@id":"https://homosaurus.org/v5/homoit0003089"},{"@id":"https://homosaurus.org/v5/homoit0003125"},{"@id":"https://homosaurus.org/v5/homoit0003138"},{"@id":"https://homosaurus.org/v5/homoit0003139"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85114860"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001267"},"dc:replaces":{"@id":"http://homosaurus.org/v2/roleplay"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000442","dc:identifier":"homoit0000442","skos:prefLabel":[{"@language":"en","@value":"Kinks and fetishes"},{"@language":"es","@value":"Kinks y fetiches"},{"@language":"nl","@value":"Kinks en fetisjen"},{"@language":"sv","@value":"Kink och fetischism"}],"skos:altLabel":[{"@language":"en","@value":"BDSM"},{"@language":"en","@value":"Fetish"},{"@language":"en","@value":"Fetishism"},{"@language":"en","@value":"Kink"},{"@language":"nl","@value":"Fetisj"},{"@language":"nl","@value":"Fetisjisme"},{"@language":"nl","@value":"Kink"}],"rdfs:comment":[{"@language":"en","@value":"Sexual or erotic acts, objects, and situations that are considered to be unusual within a given society."},{"@language":"es","@value":"Actos, objetos y situaciones eróticas o sexuales que se consideran inusuales en determinadas sociedades."},{"@language":"nl","@value":"Seksuele of erotische handelingen, objecten en situaties die binnen een bepaalde samenleving als ongebruikelijk worden beschouwd."},{"@language":"sv","@value":"Sexuella eller erotiska handlingar, objekt och situationer som betraktas som ovanliga i ett visst samhälle."}],"skos:broader":[{"@id":