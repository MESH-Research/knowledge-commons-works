d":"https://homosaurus.org/v5/homoit0001812"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2024-07-11"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002291","dc:identifier":"homoit0002291","skos:prefLabel":[{"@language":"en","@value":"Inclusivity"},{"@language":"es","@value":"Inclusividad"},{"@language":"nl","@value":"Inclusiviteit"},{"@language":"sv","@value":"Inkludering"}],"skos:altLabel":[{"@language":"en","@value":"Inclusion"},{"@language":"en","@value":"Inclusive"},{"@language":"es","@value":"Inclusión"},{"@language":"es","@value":"Inclusivo"},{"@language":"nl","@value":"Inclusief"}],"rdfs:comment":[{"@language":"en","@value":"The practice or policy of providing equal access and support to groups of people who might otherwise be excluded or marginalized, such as LGBTQ+ people, people of color, disabled people, etc."},{"@language":"es","@value":"La práctica o política de brindar igualdad de acceso y apoyo a grupos de personas que, de otro modo, podrían quedar excluidas o marginadas, como las personas LGBTQ+, las personas de color, las personas discapacitadas, etc."},{"@language":"nl","@value":"De praktijk of het beleid om gelijke toegang en ondersteuning te bieden aan groepen personen die anders zouden worden uitgesloten of gemarginaliseerd, zoals LHBTQ+-personen, personen van kleur, personen met een handicap, etc."},{"@language":"sv","@value":"En praxis eller policy som syftar till att erbjuda lika tillgång och stöd till grupper som annars riskerar att uteslutas eller marginaliseras, såsom hbtq+-personer, personer med funktionsnedsättning eller personer från underordnat rasifierade grupper."}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0001818"},{"@id":"https://homosaurus.org/v5/homoit0001819"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0004335"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0002291"},"dc:issued":{"@type":"xsd:date","@value":"2022-11-10"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004306","dc:identifier":"homoit0004306","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ academic journals"},{"@language":"ja","@value":"LGBTQ+に関する学術雑誌"},{"@language":"nl","@value":"LHBTQ+-academische tijdschriften"},{"@language":"sv","@value":"Vetenskapliga tidskrifter (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"LGBTQ academic journals"},{"@language":"ja","@value":"LGBTQ関連の学術雑誌"}],"rdfs:comment":[{"@language":"en","@value":"Academic journals focusing on LGBTQ+ identities, issues, or cultures; use a more specific term if possible."},{"@language":"ja","@value":"LGBTQ+のアイデンティティ、課題、または文化に焦点を当てた学術雑誌。可能であれば、より具体的な用語を使用してください。"},{"@language":"nl","@value":"Academische tijdschriften die zich richten op LGBTQ+-identiteiten, -vraagstukken of -culturen; gebruik indien mogelijk een specifiekere term."},{"@language":"sv","@value":"Vetenskapliga tidskrifter med fokus på hbtq+-identiteter, frågor eller kulturer. Använd mer specifik term om möjligt."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001830"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0004307"},{"@id":"https://homosaurus.org/v5/homoit0004308"},{"@id":"https://homosaurus.org/v5/homoit0004309"},{"@id":"https://homosaurus.org/v5/homoit0004310"},{"@id":"https://homosaurus.org/v5/homoit0004311"},{"@id":"https://homosaurus.org/v5/homoit0004313"},{"@id":"https://homosaurus.org/v5/homoit0004314"},{"@id":"https://homosaurus.org/v5/homoit0004315"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0004312"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001830"},"dc:issued":{"@type":"xsd:date","@value":"2026-02-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002788","dc:identifier":"homoit0002788","skos:prefLabel":[{"@language":"en","@value":"Asexual culture"},{"@language":"es","@value":"Cultura asexual"},{"@language":"de","@value":"Asexuelle Kultur"},{"@language":"nl","@value":"Aseksuele cultuur"},{"@language":"sv","@value":"Asexuell kultur"}],"skos:altLabel":[{"@language":"de","@value":"Ace Kultur"},{"@language":"sv","@value":"Ace-kultur"}],"rdfs:comment":[{"@language":"en","@value":"Cultural experiences shared by members of asexual communities or products of asexual culture (e.g., art and media created by and for asexual people, activism focused on asexual issues, slang commonly used in asexual communities, etc.)."},{"@language":"es","@value":"Experiencias culturales compartidas por miembros de comunidades asexuales o productos de la cultura asexual (por ejemplo, arte y medios de comunicación creados por y para personas asexuales, activismo centrado en temas asexuales, jerga de uso común en comunidades asexuales, etc.)."},{"@language":"de","@value":"Kulturelle Erfahrungen, die von Mitgliedern asexueller Gemeinschaften geteilt werden, oder Produkte der asexuellen Kultur (z. B. Kunst und Medien, die von und für asexuelle Menschen geschaffen wurden, Aktivismus, der sich auf asexuelle Themen konzentriert, Slang, der in asexuellen Gemeinschaften häufig verwendet wird, usw.)."},{"@language":"nl","@value":"Gebruik om culturele ervaringen te beschrijven die worden gedeeld door leden van aseksuele gemeenschappen of producten van de aseksuele cultuur (bijv. kunst en media gemaakt door en voor aseksuele personen, activisme gericht op aseksuele kwesties, jargon dat vaak wordt gebruikt in aseksuele gemeenschappen, enz.)"},{"@language":"sv","@value":"Kulturella erfarenheter som delas av medlemmar i asexuella gemenskaper eller produkter av asexuell kultur, till exempel konst och media skapade av och för asexuella personer, aktivism fokuserad på asexuella frågor, och slang som används i asexuella gemenskaper."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001831"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0002789"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002970","dc:identifier":"homoit0002970","skos:prefLabel":[{"@language":"en","@value":"Intersex culture"},{"@language":"es","@value":"Cultura intersexual"},{"@language":"nl","@value":"Intersekse cultuur"},{"@language":"sv","@value":"Intersexkultur"}],"skos:altLabel":{"@language":"es","@value":"Cultura intersex"},"rdfs:comment":[{"@language":"en","@value":"Cultural experiences shared by members of intersex communities or products of intersex culture (e.g., art and media created by and for intersex people, activism focused on intersex issues, slang commonly used in intersex communities, etc.)."},{"@language":"es","@value":"Experiencias culturales compartidas por miembros de comunidades intersex o productos de la cultura intersex (por ejemplo, arte y medios creados por y para personas intersex, activismo centrado en cuestiones intersex, jerga comúnmente utilizada en comunidades intersex, etc.)."},{"@language":"nl","@value":"Culturele ervaringen die worden gedeeld door leden van intersekse gemeenschappen of producten van de intersekse cultuur (bijv. kunst en media gemaakt door en voor intersekse personen, activisme gericht op intersekse kwesties, jargon dat vaak wordt gebruikt in intersekse gemeenschappen, enz.)"},{"@language":"sv","@value":"Kulturella erfarenheter som delas av medlemmar i intersexgemenskaper eller produkter av intersexkultur, till exempel konst och medier skapade av och för intersexpersoner, aktivism med fokus på intersexfrågor eller slang som används inom intersexgemenskaper."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001831"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2023-09-29"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001855","dc:identifier":"homoit0001855","skos:prefLabel":[{"@language":"en","@value":"Lesbian disabled people"},{"@language":"es","@value":"Lesbianas discapacitadas"},{"@language":"nl","@value":"Gehandicapte lesbische vrouwen"},{"@language":"sv","@value":"Funktionsnedsatta lesbiska"}],"skos:altLabel":[{"@language":"en","@value":"Disabled lesbians"},{"@language":"en","@value":"Lesbians with disabilities"},{"@language":"es","@value":"Discapacitadas lesbianas"},{"@language":"es","@value":"Lesbianas con discapacidades"},{"@language":"nl","@value":"Lesbische vrouwen met een handicap"},{"@language":"sv","@value":"Funktionshindrade lesbiska"}],"rdfs:comment":[{"@language":"en","@value":"Lesbians who are disabled."},{"@language":"es","@value":"Lesbianas con discapacidad."},{"@language":"nl","@value":"Lesbische vrouwen die gehandicapt zijn"},{"@language":"sv","@value":"Lesbiska med funktionsnedsättning/funktionsnedsättningar."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001854"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0001861"},{"@id":"https://homosaurus.org/v5/homoit0001867"},{"@id":"https://homosaurus.org/v5/homoit0001872"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001880"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-02-15"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"}