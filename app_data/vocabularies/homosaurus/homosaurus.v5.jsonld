ren"},{"@language":"sv","@value":"Queera barn"}],"rdfs:comment":[{"@language":"en","@value":"Queer people who have not yet reached the age of adolescence."},{"@language":"es","@value":"Niños menores de 18 años que se identifican como queer."},{"@language":"fr","@value":"Personnes queers qui n'ont pas encore atteint l'adolescence."},{"@language":"nl","@value":"Queer personen die de leeftijd van adolescentie nog niet hebben bereikt."},{"@language":"sv","@value":"Queera personer som ännu inte har nått tonåren."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000256"},{"@id":"https://homosaurus.org/v5/homoit0001215"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001166"},{"@id":"https://homosaurus.org/v5/homoit0001178"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000421"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerChildren"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001307","dc:identifier":"homoit0001307","skos:prefLabel":[{"@language":"en","@value":"Sexually abused LGBTQ+ children"},{"@language":"es","@value":"Niños y niñas LGBTQ+ abusados sexualmente"},{"@language":"nl","@value":"Seksueel misbruikte LHBTQ+-kinderen"},{"@language":"sv","@value":"Hbtq+-barn utsatta för sexuella övergrepp"}],"skos:altLabel":[{"@language":"en","@value":"Sexually abused LGBTQ children"},{"@language":"es","@value":"Niños LGBTQ abusados sexualmente"},{"@language":"es","@value":"Niños y niñas abusados sexualmente (LGBTQ)"},{"@language":"es","@value":"Niñxs LGBTQ+ abusados sexualmente"},{"@language":"sv","@value":"Barn utsatta för sexuella övergrepp (hbtq+)"},{"@language":"sv","@value":"Hbtq+-barn som är offer för sexuella övergrepp"}],"rdfs:comment":[{"@language":"en","@value":"LGBTQ+ children younger than 18 years of age who are currently experiencing or have experienced sexual abuse."},{"@language":"es","@value":"Niños y niñas LGBTQ+ menores de 18 años que actualmente sufren o han sufrido abuso sexual."},{"@language":"nl","@value":"LHBTQ+-kinderen jonger dan 18 jaar die op dit moment seksueel misbruik ervaren of hebben meegemaakt."},{"@language":"sv","@value":"Hbtq+-barn under 18 år som för närvarande utsätts för eller tidigare har utsatts för sexuella övergrepp."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000256"},{"@id":"https://homosaurus.org/v5/homoit0000959"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000958"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000421"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sexuallyAbusedLGBTQChildren"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001400","dc:identifier":"homoit0001400","skos:prefLabel":[{"@language":"en","@value":"Transgender children"},{"@language":"es","@value":"Niños y niñas transgénero"},{"@language":"fr","@value":"Enfants trans"},{"@language":"nl","@value":"Transgender kinderen"},{"@language":"sv","@value":"Transbarn"}],"skos:altLabel":[{"@language":"es","@value":"Niñxs transgénero"},{"@language":"es","@value":"Niños y niñas trans"},{"@language":"es","@value":"Niñxs trans"},{"@language":"fr","@value":"Enfants transgenres"}],"rdfs:comment":[{"@language":"en","@value":"Transgender people who have not yet reached the age of adolescence."},{"@language":"es","@value":"Niñxs menores de 18 años que se autoidentifican como transgénero."},{"@language":"fr","@value":"Personnes trans qui n'ont pas encore atteint l'adolescence."},{"@language":"nl","@value":"Transgender personen die de leeftijd van de adolescentie nog niet hebben bereikt."},{"@language":"sv","@value":"Transpersoner som ännu inte har nått tonåren."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000256"},{"@id":"https://homosaurus.org/v5/homoit0001378"},{"@id":"https://homosaurus.org/v5/homoit0001452"}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0001407"},{"@id":"https://homosaurus.org/v5/homoit0001446"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001138"},{"@id":"https://homosaurus.org/v5/homoit0001399"},{"@id":"https://homosaurus.org/v5/homoit0001415"},{"@id":"https://homosaurus.org/v5/homoit0003502"},{"@id":"https://homosaurus.org/v5/homoit0003514"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2008003689"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000421"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transgenderChildren"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002222","dc:identifier":"homoit0002222","skos:prefLabel":[{"@language":"en","@value":"Non-binary children"},{"@language":"es","@value":"Niñxs no binarios"},{"@language":"nl","@value":"Non-binaire kinderen"},{"@language":"sv","@value":"Ickebinära barn"}],"skos:altLabel":[{"@language":"en","@value":"Non-binary kids"},{"@language":"en","@value":"Nonbinary children"},{"@language":"en","@value":"Nonbinary kids"},{"@language":"es","@value":"Niños y niñas no binarios"},{"@language":"es","@value":"Niños y niñas no binarixs"}],"rdfs:comment":[{"@language":"en","@value":"Non-binary people who have not yet reached the age of adolescence."},{"@language":"es","@value":"Niñxs menores de 18 años que se autoidentifican como no binarixs."},{"@language":"nl","@value":"Non-binaire personen die de leeftijd van adolescentie nog niet hebben bereikt"},{"@language":"sv","@value":"Ickebinära personer som ännu inte har nått tonåren."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000256"},{"@id":"https://homosaurus.org/v5/homoit0002223"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001756"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000421"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-19"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002362","dc:identifier":"homoit0002362","skos:prefLabel":[{"@language":"en","@value":"Lesbian children"},{"@language":"es","@value":"Niños y niñas lesbianas"},{"@language":"nl","@value":"Lesbische kinderen"},{"@language":"sv","@value":"Lesbiska barn"}],"skos:altLabel":[{"@language":"en","@value":"Lesbian kids"},{"@language":"es","@value":"Niñxs lesbianas"}],"rdfs:comment":[{"@language":"en","@value":"Lesbians who have not yet reached the age of adolescence."},{"@language":"es","@value":"Niños y niñas menores de 18 años que se autoidentifican como lesbianas."},{"@language":"nl","@value":"Lesbische vrouwen die de leeftijd van de adolescentie nog niet hebben bereikt."},{"@language":"sv","@value":"Lesbiska som ännu inte har nått tonåren."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000256"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000743"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000421"},"dc:issued":{"@type":"xsd:date","@value":"2022-12-13"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002363","dc:identifier":"homoit0002363","skos:prefLabel":[{"@language":"en","@value":"Gay children"},{"@language":"de","@value":"Schwule Kinder"},{"@language":"es","@value":"Niños y niñas gay"},{"@language":"nl","@value":"Homokinderen"},{"@language":"sv","@value":"Bögbarn"}],"skos:altLabel":[{"@language":"en","@value":"Gay kids"},{"@language":"es","@value":"Niñxs gay"},{"@language":"sv","@value":"Gaybarn"}],"rdfs:comment":[{"@language":"en","@value":"Gay people who have not yet reached the age of adolescence."},{"@language":"de","@value":"Schwule Personen, die die Volljährigkeit noch nicht erreicht haben."},{"@language":"es","@value":"Niños y niñas menores de 18 años que se autoidentifican como gay."},{"@language":"nl","@value":"Homomannen die de leeftijd van adolescentie nog niet hebben bereikt."},{"@language":"sv","@value":"Homosexuella pojkar som ännu inte har nått tonåren."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000256"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000479"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000421"},"dc:issued":{"@type":"xsd:date","@value":"2022-12-13"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002699","dc:identifier":"homoit0002699","skos:prefLabel":[{"@language":"en","@value":"Gender dysphoria in children"},{"@language":"es","@value":"Disforia de género en niños"},{"@language":"de","@value":"Geschlechtsdysphorie bei Kindern"},{"@language":"nl","@value":"Genderdysforie bij kinderen"},{"@language":"sv","@value":"Könsdysfori hos barn"}],"skos:altLabel":[{"@language":"de","@value":"Gender-Dysphorie bei Kindern"},{"@language":"de","@value":"Geschlechts-Dysphorie bei Kindern"}],"rdfs:comment":[{"@language":"en","@value":"A psychological diagnosis (replacing the outdated and offensive \"gender identity disorder\") used to describe the sense of unease or dissatisfaction an individual feels as a result of incongruence between their gender identity and their assigned gender, gender expression, and/or the way their gender is perceived by others. This term is also used colloquially by individuals to describe the discomfort and distress they experience as a result of this incongruence. Though gender dysphoria is often associated with trans people, people of any identity may experience gender dysphoria when they do not feel \"right\" in their body or the way their gender is being expressed. Use this particular term for works about children who experience or have experienced gender dysphoria."},{"@language":"es","@value":"Un diagnóstico psicológico (que reemplaza al término anticuado y ofensivo de \"trastorno de identidad de género\") utilizado para describir la sensación de malestar o insatisfacción que siente una persona como resultado de la incongruencia entre su identidad de género y su género asignado, su expresión de género y/o la forma en que su género es percibido por otras personas. Este término también se utiliza coloquialmente por personas para describir el malestar y la angustia que experimentan como resultado de esta incongruencia. Aunque la disforia de género a menudo se asocia con las personas trans, las personas de cualquier identidad pueden experimentar disforia de género cuando no se sienten \"bien\" con su cuerpo o con la forma en que se expresan su género. Utilícese este término particular para trabajos sobre niños que experimentan o han experimentado disforia de género."},{"@language":"de","@value":"Eine psychologische Diagnose (die den veralteten und beleidigenden Begriff „Geschlechtsidentitätsstörung” ersetzt), die verwendet wird, um das Gefühl des Unbehagens oder der Unzufriedenheit zu beschreiben, das eine Person aufgrund der Diskrepanz zwischen ihrer Geschlechtsidentität und ihrem zugewiesenen Geschlecht, ihrem Geschlechtsausdruck und/oder der Art und Weise, wie ihr Geschlecht von anderen wahrgenommen wird, empfindet. Dieser Begriff wird auch umgangssprachlich von Personen verwendet, um das Unbehagen und die Belastung zu beschreiben, die sie aufgrund dieser Diskrepanz empfinden. Obwohl Geschlechtsdysphorie oft mit trans Personen in Verbindung gebracht wird, können Menschen jeder Identität Geschlechtsdysphorie empfinden, wenn sie sich in ihrem Körper oder in der Art und Weise, wie ihr Geschlecht ausgedrückt wird, nicht „richtig“ fühlen. Dieser spezifische Begriff wird für Werke über Kinder verwendet, die Geschlechtsdysphorie erleben oder erlebt haben."},{"@language":"nl","@value":"Een psychologische diagnose (ter vervanging van het verouderde en aanstootgevende ‘genderidentiteitsstoornis’), die wordt gebruikt om het gevoel van onbehagen of ontevredenheid te beschrijven dat een individu voelt als gevolg van de incongruentie tussen hun genderidentiteit en de hun toegewezen gender, genderexpressie en/of de manier waarop hun gender door anderen wordt waargenomen. Deze term wordt ook in de volksmond door individuen gebruikt om het ongemak en de angst te beschrijven die zij ervaren als gevolg van deze incongruentie. Hoewel genderdysforie vaak wordt geassocieerd met transgender personen, kunnen personen van welke identiteit dan ook genderdysforie ervaren als ze zich niet 'goed' voelen in hun lichaam of in de manier waarop hun gender wordt uitgedrukt. Gebruik deze specifieke term voor werken over kinderen die genderdysforie ervaren of hebben ervaren. ​"},{"@language":"sv","@value":"En psykologisk diagnos (som ersätter den föråldrade och stigmatiserande ”könsidentitetsstörning”) som beskriver den obehagskänsla eller otillfredsställelse ett barn upplever på grund av att könsidentiteten inte stämmer överens med det tilldelade könet, könsuttrycket och/eller hur omgivningen uppfattar könet. Termen används också informellt av barn för att beskriva det obehag och den stress som uppstår i detta glapp."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000567"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000256"},{"@id":"https://homosaurus.org/v5/homoit0000568"},{"@id":"https://homosaurus.org/v5/homoit0000571"},{"@id":"https://homosaurus.org/v5/homoit0002256"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000567"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-27"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001330","dc:identifier":"homoit0001330","skos:prefLabel":[{"@language":"en","@value":"Sons of bisexual people"},{"@language":"es","@value":"Hijos de personas bisexuales"},{"@language":"fr","@value":"Fils de personnes bisexuelles"},{"@language":"nl","@value":"Zonen van biseksuele personen"},{"@language":"sv","@value":"Söner till bisexuella personer"}],"rdfs:comment":[{"@language":"en","@value":"Sons who have one or more bisexual parent. For sons who are themselves bisexual, use the term \"Bisexual sons.\""},{"@language":"es","@value":"Hijos que tienen uno o más padres bisexuales. Para los hijos que son bisexuales, utilice el término \"hijos bisexuales\"."},{"@language":"fr","@value":"Fils qui ont un ou plusieurs parents bisexuels."},{"@language":"nl","@value":"Zonen die een of meer biseksuele ouders hebben."},{"@language":"sv","@value":"Söner som har en eller flera bisexuella föräldrar. För söner som själva är bisexuella används termen ”Bisexuella söner”."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000257"},{"@id":"https://homosaurus.org/v5/homoit0002355"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000421"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sonsOfBisexualPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000258","dc:identifier":"homoit0000258","skos:prefLabel":[{"@language":"en","@value":"Children of gay men"},{"@language":"de","@value":"Kinder von schwulen Männern"},{"@language":"es","@value":"Hijxs de hombres gay"},{"@language":"fr","@value":"Enfants d'hommes gais"},{"@language":"nl","@value":"Kinderen van homomannen"},{"@language":"sv","@value":"Barn till bögar"}],"skos:altLabel":[{"@language":"es","@value":"Hijos e hijas de padres gay"},{"@language":"fr","@value":"Enfants d'hommes gays"},{"@language":"fr","@value":"Enfants d'homosexuels"}],"rdfs:comment":[{"@language":"en","@value":"Children who have one or more gay father."},{"@language":"de","@value":"Kinder, die einen oder mehrere schwule Väter haben."},{"@language":"es","@value":"Hijos o hijas que tienen uno o más padres gay."},{"@language":"fr","@value":"Enfants dont un ou plusieurs pères sont gais."},{"@language":"nl","@value":"Kinderen die een of meer homovaders hebben."},{"@language":"sv","@value":"Barn som har en eller flera homosexuella pappor."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000260"},"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0001331"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000491"},{"@id":"https://homosaurus.org/v5/homoit0000492"}],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85023551"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000421"},"dc:replaces":{"@id":"http://homosaurus.org/v2/childrenOfGayMen"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001331","dc:identifier":"homoit0001331","skos:prefLabel":[{"@language":"en","@value":"Sons of gay men"},{"@language":"es","@value":"Hijos de hombres gay"},{"@language":"fr","@value":"Fils d'hommes gais"},{"@language":"nl","@value":"Zonen van homomannen"},{"@language":"sv","@value":"Söner till bögar"}],"skos:altLabel":[{"@language":"fr","@value":"Fils d'homosexuels"},{"@language":"fr","@value":"Fils d'hommes gays"}],"rdfs:comment":[{"@language":"en","@v