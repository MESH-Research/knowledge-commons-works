verse who identify as greyromantic."},{"@language":"nl","@value":"Auteurs van geschreven of gesproken gedichten die zich identificeren als grijsromantisch."},{"@language":"sv","@value":"Skapare av poesi som identifierar sig som gråromantiska."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0003663"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-22"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003676","dc:identifier":"homoit0003676","skos:prefLabel":[{"@language":"en","@value":"Megasexual poets"},{"@language":"nl","@value":"Megaseksuele dichters"},{"@language":"sv","@value":"Megasexuella poeter"}],"rdfs:comment":[{"@language":"en","@value":"Creators of written or spoken verse who identify as megasexual."},{"@language":"nl","@value":"Auteurs van geschreven of gesproken gedichten die zich identificeren als megaseksueel."},{"@language":"sv","@value":"Skapare av poesi som identifierar sig som megasexuella."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0003663"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-22"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003678","dc:identifier":"homoit0003678","skos:prefLabel":[{"@language":"en","@value":"Lesbian television personalities"},{"@language":"nl","@value":"Lesbische televisiepersoonlijkheden"},{"@language":"sv","@value":"Lesbiska tv-profiler"}],"skos:altLabel":{"@language":"en","@value":"Lesbian TV personalities"},"rdfs:comment":[{"@language":"en","@value":"Lesbians who are well-known to the public through their appearances on televisio