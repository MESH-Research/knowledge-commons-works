homosaurus.org/v2/gayBars"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001272","dc:identifier":"homoit0001272","skos:prefLabel":[{"@language":"en","@value":"Sex parties"},{"@language":"es","@value":"Fiestas sexuales"},{"@language":"nl","@value":"Seksfeesten"},{"@language":"sv","@value":"Sexfester"}],"skos:altLabel":[{"@language":"sv","@value":"Sexpartyn"},{"@language":"sv","@value":"Orgier"}],"rdfs:comment":[{"@language":"en","@value":"Social gatherings or events, typically held in private residences or at sex clubs, in which participants engage in or observe group sexual activities."},{"@language":"es","@value":"Encuentros o eventos sociales, generalmente celebrados en residencias privadas o en clubes sexuales, donde quienes participan forman parte de u observan actividades sexuales grupales."},{"@language":"nl","@value":"Sociale samenkomsten of evenementen, meestal gehouden in privéwoningen of in seksclubs, waarbij deelnemers deelnemen aan seksuele groepsactiviteiten of deze observeren."},{"@language":"sv","@value":"Sociala sammankomster eller evenemang, vanligtvis i privata hem eller på sexklubbar, där deltagare deltar i eller observerar gruppsexaktiviteter."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000974"},"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0001252"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000087"},{"@id":"https://homosaurus.org/v5/homoit0000242"},{"@id":"https://homosaurus.org/v5/homoit0000603"},{"@id":"https://homosaurus.org/v5/homoit0001270"},{"@id":"https://homosaurus.org/v5/homoit0001306"},{"@id":"https://homosaurus.org/v5/homoit0003080"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000974"},"dc:replaces":{"@id":"http://homosaurus.org/v2/sexParties"},"dc:issued":{"@typ