62"},{"@id":"https://homosaurus.org/v5/homoit0001878"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2004001478"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-02-17"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001881","dc:identifier":"homoit0001881","skos:prefLabel":[{"@language":"en","@value":"Gay men with chronic illnesses"},{"@language":"de","@value":"Schwule Männer mit chronischen Krankheiten"},{"@language":"es","@value":"Hombres gay con enfermedades crónicas"},{"@language":"nl","@value":"Homomannen met chronische ziekten"},{"@language":"sv","@value":"Bögar med kronisk sjukdom"}],"skos:altLabel":[{"@language":"en","@value":"Chronically ill gay men"},{"@language":"de","@value":"Chronisch kranke schwule Männer"},{"@language":"de","@value":"Schwule chronisch kranke Männer"},{"@language":"es","@value":"Enfermos crónicos gay"},{"@language":"es","@value":"Hombres enfermos crónicos gay"},{"@language":"sv","@value":"Kroniskt sjuka bögar"},{"@language":"sv","@value":"Homosexuella män med kronisk sjukdom"},{"@language":"sv","@value":"Kroniskt sjuka homosexuella män"}],"rdfs:comment":[{"@language":"en","@value":"Gay men who have long-term health conditions that require continued medical attention and/or significantly impact or limit daily life; some but not all people with chronic illnesses consider themselves disabled."},{"@language":"de","@value":"Homosexuelle Männer, die unter langfristigen Gesundheitsproblemen leiden, die eine kontinuierliche medizinische Versorgung erfordern und/oder ihr tägliches Leben erheblich beeinträchtigen oder einschränken; einige, aber nicht alle Menschen mit chronischen Erkrankungen betrachten sich selbst als behindert."},{"@language":"es","@value":"Hombres gay que tienen condiciones de salud a largo plazo que requieren atención médica continua y/o impactan o limitan significativamente la vida diaria; algunas, pero no todas, las personas con enfermedades crónicas se consideran discapacitadas."},{"@language":"nl","@value":"Homomannen met langdurige gezondheidsproblemen die voortdurende medische aandacht vereisen en/of een significante impact hebben op het dagelijks leven of deze beperken; sommige, maar niet alle personen met chronische ziekten beschouwen zichzelf als gehandicapt"},{"@language":"sv","@value":"Bögar med långvariga hälsotillstånd som kräver kontinuerlig medicinsk behandling och/eller har en betydande påverkan på eller begränsar det dagliga livet. Vissa, men inte alla, personer med kroniska sjukdomar identifierar sig som personer med funktionsnedsättning."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001879"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001856"},{"@id":"https://homosaurus.org/v5/homoit0001887"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-02-17"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001863","dc:identifier":"homoit0001863","skos:prefLabel":[{"@language":"en","@value":"Bisexual hard of hearing people"},{"@language":"es","@value":"Personas bisexuales con problemas de audición"},{"@language":"nl","@value":"Hardhorende biseksuele personen"},{"@language":"sv","@value":"Bisexuella hörselskadade personer"}],"skos:altLabel":[{"@language":"en","@value":"Bisexual HoH people"},{"@language":"en","@value":"Bisexual hearing impaired people"},{"@language":"en","@value":"Hearing impaired bisexual people"},{"@language":"en","@value":"HoH bisexual people"},{"@language":"es","@value":"Personas bisexuales con dificultades de audición"},{"@language":"es","@value":"Personas bis