us.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003402","dc:identifier":"homoit0003402","skos:prefLabel":[{"@language":"en","@value":"Chicano/a/x non-binary people"},{"@language":"de","@value":"Nichtbinäre Chicanxs"},{"@language":"es","@value":"Personas no binarixs chicanas"},{"@language":"nl","@value":"Chicano/a/x non-binaire personen"},{"@language":"sv","@value":"Ickebinära chicano/a/x"}],"skos:altLabel":[{"@language":"en","@value":"Chicana non-binary people"},{"@language":"en","@value":"Chicano non-binary people"},{"@language":"en","@value":"Chicanx non-binary people"},{"@language":"en","@value":"Non-binary Chicanas"},{"@language":"en","@value":"Non-binary Chicanos"},{"@language":"en","@value":"Non-binary Chicanx people"},{"@language":"en","@value":"Nonbinary Chicanas"},{"@language":"en","@value":"Nonbinary Chicanos"},{"@language":"en","@value":"Nonbinary Chicanx people"},{"@language":"de","@value":"Nicht-binäre Chicanxs"},{"@language":"de","@value":"Nonbinäre Chicanxs"},{"@language":"de","@value":"Non-binäre Chicanxs"},{"@language":"es","@value":"Chicanxs no binarixs"},{"@language":"es","@value":"Personas chicanas no binarias"},{"@language":"nl","@value":"Chicano non-binaire personen"},{"@language":"nl","@value":"Chicano/a/x nonbinaire personen"},{"@language":"nl","@value":"Chicanx non-binaire personen"},{"@language":"nl","@value":"Non-binaire Chicana's"},{"@language":"nl","@value":"Non-binaire Chicano's"},{"@language":"nl","@value":"Non-binaire Chicanx"},{"@language":"nl","@value":"Nonbinaire Chicana's"},{"@language":"nl","@value":"Nonbinaire Chicano's"},{"@language":"nl","@value":"Nonbinaire Chicanx"}],"rdfs:comment":[{"@language":"en","@value":"Non-binary people of Mexican descent born in the United States; only use to describe people who self-identify as Chicano, Chicana, or Chicanx. Do not conflate with Latino/a/x or Hispanic people."},{"@language":"de","@value":"Nichtbinäre Personen mexikanischer Abstammung, die in d