s","@value":"GLBT"},{"@language":"ja","@value":"GLBT"}],"rdfs:comment":[{"@language":"en","@value":"Acronym used to describe lesbians, gay men, bisexual people, and transgender people as a group."},{"@language":"es","@value":"Acrónimo utilizado para describir a lesbianas, hombres gay, personas bisexuales y personas transgénero como grupo."},{"@language":"ja","@value":"レズビアン、ゲイ、バイセクシュアル、トランスジェンダーの人々を総称して指す略語。"},{"@language":"nl","@value":"Alleen gebruikt om lesbische vrouwen, homomannen, biseksuelen en transgender personen als een groep te beschrijven"},{"@language":"sv","@value":"Akronym som används för att beskriva homosexuella, bisexuella och transpersoner som grupp."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000805"},{"@id":"https://homosaurus.org/v5/homoit0000806"}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000703"},{"@id":"https://homosaurus.org/v5/homoit0000804"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000143"},{"@id":"https://homosaurus.org/v5/homoit0000485"},{"@id":"https://homosaurus.org/v5/homoit0000733"},{"@id":"https://homosaurus.org/v5/homoit0001403"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000805"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBT"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000804","dc:identifier":"homoit0000804","skos:prefLabel":[{"@language":"en","@value":"LGB"},{"@language":"es","@value":"LGB"},{"@language":"ja","@value":"LGB"},{"@language":"nl","@value":"LHB"},{"@language":"sv","@value":"Hb"}],"rdfs:comment":[{"@language":"en","@value":"Acronym used to describe lesbians, gay people, and bisexuals as a group. This acronym has often been used to exclude transgender people."},{"@language":"en","@value":"レズビアン、ゲイ、バイセクシュアルを総称して指す略語。この略語は、トランスジェンダーの人々を排除するために用いられることが多かった。"},{"@language":"es","@value":"Acrónimo utilizado para describir a lesbianas, hombres gay y personas bisexuales como grupo. Este acrónimo se ha utilizado a menudo para excluir a las personas transgénero."},{"@language":"nl","@value":"Alleen gebruikt om lesbische vrouwen, homomannen en biseksuelen als een groep te beschrijven; is gebruikt om transgender personen uit te sluiten"},{"@language":"sv","@value":"Akronym som används för att beskriva homosexuella och bisexuella som grupp. Akronymen har ofta använts på ett sätt som exkluderar transpersoner."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000594"},{"@id":"https://homosaurus.org/v5/homoit0000805"},{"@id":"https://homosaurus.org/v5/homoit0000806"},{"@id":"https://homosaurus.org/v5/homoit0000807"},{"@id":"https://homosaurus.org/v5/homoit0000882"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000143"},{"@id":"https://homosaurus.org/v5/homoit0000485"},{"@id":"https://homosaurus.org/v5/homoit0000733"},{"@id":"https://homosaurus.org/v5/homoit0001403"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000805"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGB"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000805","dc:identifier":"homoit0000805","skos:prefLabel":[{"@language":"en","@value":"LGBTI"},{"@language":"es","@value":"LGBTI"},{"@language":"ja","@value":"LGBTI"},{"@language":"nl","@value":"LHBTI"},{"@language":"sv","@value":"Hbti"}],"rdfs:comment":[{"@language":"en","@value":"Acronym used to describe lesbians, gay men, bisexual people, transgender people, and intersex people as a group."},{"@language":"es","@value":"Acrónimo utilizado para describir a lesbianas, hombres gay, personas bisexuales, personas transgénero e intersexuales como grupo."},{"@language":"ja","@value":"レズビアン、ゲイ、バイセクシュアル、トランスジェンダー、インターセックスの人々を総称して指す略語。"},{"@language":"nl","@value":"Alleen gebruikt om lesbische vrouwen, homomannen, biseksuelen, transgender personen en intersekse personen als groep te beschrijven"},{"@language":"sv","@value":"Akronym som används för att beskriva homosexuella, bisexuella, transpersoner och intersexpersoner som grupp."}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000594"},{"@id":"https://homosaurus.org/v5/homoit0000804"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000143"},{"@id":"https://homosaurus.org/v5/homoit0000485"},{"@id":"https://homosaurus.org/v5/homoit0000672"},{"@id":"https://homosaurus.org/v5/homoit0000733"},{"@id":"https://homosaurus.org/v5/homoit0001297"},{"@id":"https://homosaurus.org/v5/homoit0001403"},{"@id":"https://homosaurus.org/v5/homoit0001463"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000805"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTI"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000806","dc:identifier":"homoit0000806","skos:prefLabel":[{"@language":"en","@value":"LGBTQ"},{"@language":"es","@value":"LGBTQ"},{"@language":"ja","@value":"LGBTQ"},{"@language":"nl","@value":"LHBTQ"},{"@language":"sv","@value":"Hbtq"}],"rdfs:comment":[{"@language":"en","@value":"Acronym used to describe lesbians, gay men, bisexual people, transgender people, and queer people as a group."},{"@language":"es","@value":"Acrónimo utilizado para describir a lesbianas, hombres gay, personas bisexuales, personas transgénero y personas queer como grupo."},{"@language":"ja","@value":"レズビアン、ゲイ、バイセクシュアル、トランスジェンダー、クィアの人々を総称して指す略語。"},{"@language":"sv","@value":"Akronym som används för att beskriva homosexuella, bisexuella, transpersoner och queera personer som grupp."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000807"},{"@id":"https://homosaurus.org/v5/homoit0000882"}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000594"},{"@id":"https://homosaurus.org/v5/homoit0000804"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000143"},{"@id":"https://homosaurus.org/v5/homoit0000485"},{"@id":"https://homosaurus.org/v5/homoit0000733"},{"@id":"https://homosaurus.org/v5/homoit0001170"},{"@id":"https://homosaurus.org/v5/homoit0001403"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001789"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001789","dc:identifier":"homoit0001789","skos:prefLabel":[{"@language":"en","@value":"2SLGBTQ+"},{"@language":"es","@value":"2SLGBTQ+"},{"@language":"de","@value":"2SLGBTQ+"},{"@language":"fr","@value":"LGBTQ2+"},{"@language":"nl","@value":"2SLHBTQ+"},{"@language":"sv","@value":"2SLGBTQ+"}],"skos:altLabel":[{"@language":"en","@value":"LGBTQ2S+"},{"@language":"es","@value":"LGBTQ2S+"},{"@language":"de","@value":"LGBTQ2S+"},{"@language":"fr","@value":"Bispirituel, Lesbienne, Gay, Bisexuel, Transgenre, Queer et plus"},{"@language":"fr","@value":"2S, Lesbienne, Gay, Bi, Trans, Queer et plus"},{"@language":"fr","@value":"Bispirituel, Lesbienne, Gay, Bisexuel, Transgenre, Queer, Asexuel, Demisexuel, Asexué-gris, Pansexuel, Intersexe et plus"},{"@language":"fr","@value":"2S, Lesbienne, Gay, Bi, Trans, Queer, Ace, Demisexuel, Asexué-gris, Pan, Intersexe et plus"},{"@language":"sv","@value":"2SHBTQ+"}],"rdfs:comment":[{"@language":"en","@value":"Abbreviation used to describe Two-Spirit people, lesbians, gay men, bisexual people, transgender people, queer people, and other gender and sexual minorities as a group; commonly used in Canada to emphasize the particularities of Indigenous people's experiences."},{"@language":"es","@value":"Abreviatura utilizada para describir a las personas dos espíritus, lesbiana, gay, bisexuales, transgénero, queer y otras minorías sexuales y de género como grupo; comúnmente utilizada en Canadá para situar y centrar las experiencias particulares de las personas indígenas."},{"@language":"de","@value":"Abkürzung zur Bezeichnung von Two-Spirit-Personen, Lesben, Schwulen, Bisexuellen, Transgender-Personen, Queers und anderen geschlechtlichen und sexuellen Minderheiten als Gruppe; wird in Kanada häufig verwendet, um die Besonderheiten der Erfahrungen indigener Völker zu betonen."},{"@language":"fr","@value":"Acronyme qui désigne les personnes lesbiennes, gaies, bisexuelles, trans, queers ou en questionnement, bispirituelles et d'autres orientations sexuelles et identités de genre. Couramment utilisé au Canada pour souligner les particularités des expériences des peuples autochtones."},{"@language":"nl","@value":"Afkorting die wordt gebruikt om two-spirit people, lesbische vrouwen, homomannen, biseksuele personen, transgender personen, queer personen en andere gender- en seksuele minderheden als een groep te beschrijven; vaak gebruikt in Canada om de inheemse bevolking op de eerste plaats te zetten"},{"@language":"sv","@value":"Förkortning som används för att beskriva Two-spirit-personer, lesbiska, bögar, bisexuella, transpersoner, queera personer och andra köns- och sexuella minoriteter som en grupp. Vanligt förekommande i Kanada för att betona ursprungsfolkens specifika erfarenheter."}],"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0000807"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000143"},{"@id":"https://homosaurus.org/v5/homoit0000485"},{"@id":"https://homosaurus.org/v5/homoit0000733"},{"@id":"https://homosaurus.org/v5/homoit0001170"},{"@id":"https://homosaurus.org/v5/homoit0001403"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001789"},"dc:issued":{"@type":"xsd:date","@value":"2021-12-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000144","dc:identifier":"homoit0000144","skos:prefLabel":[{"@language":"en-us","@value":"Bisexual community centers"},{"@language":"es","@value":"Centros comunitarios bisexuales"},{"@language":"de","@value":"Bisexuelle Gemeinschaftszentren"},{"@language":"nl","@value":"Biseksuele centra"},{"@language":"sv","@value":"Bisexuella community centers"},{"@language":"en-gb","@value":"Bisexual community centres"}],"skos:altLabel":[{"@language":"sv","@value":"Föreningslokaler för bisexuella"},{"@language":"sv","@value":"Träffpunkter för bisexuella"}],"rdfs:comment":[{"@language":"en","@value":"Spaces in which people from bisexual communities meet for social, education, recreational, or organizing activities."},{"@language":"es","@value":"Espacios en los que personas de comunidades bisexuales se reúnen para actividades sociales, educativas, recreativas u organizativas."},{"@language":"de","@value":"Räume, in denen sich Personen aus bisexuellen Gemeinschaften zu sozialen, edukativen, freizeitlichen oder organisierten Aktivitäten treffen."},{"@language":"nl","@value":"Ruimten waar mensen uit biseksuele gemeenschappen elkaar ontmoeten voor sociale, educatieve, recreatieve of organisatieactiviteiten"},{"@language":"sv","@value":"Mötesplatser för bisexuella gemenskaper där personer träffas för sociala, utbildningsrelaterade, fritids- eller organisatoriska aktiviteter."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000298"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000170"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000830"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualCommunityCentres"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000298","dc:identifier":"homoit0000298","skos:prefLabel":[{"@language":"en-us","@value":"LGBTQ+ community centers"},{"@language":"es","@value":"Centros comunitarios LGBTQ+"},{"@language":"ja","@value":"LGBTQ+コミュニティセンター"},{"@language":"nl","@value":"LHBTQ+-gemeenschapscentra"},{"@language":"sv","@value":"Hbtq+-community centers"},{"@language":"en-gb","@value":"LGBTQ+ community centres"}],"skos:altLabel":[{"@language":"sv","@value":"Föreningslokaler för hbtq+-personer"},{"@language":"sv","@value":"Träffpunkt för hntq+-personer"}],"rdfs:comment":[{"@language":"en","@value":"Spaces in which people from LGBTQ+ communities meet for social, education, recreational, or organizing activities. "},{"@language":"es","@value":"Espacios en los que personas de comunidades LGBTQ+ se reúnen para realizar actividades sociales, educativas, recreativas u organizativas."},{"@language":"ja","@value":"LGBTQ+コミュニティの人々が、交流、教育、レクリエーション、または組織活動を行うために集まる場所。"},{"@language":"nl","@value":"Ruimtes waar mensen uit LHBTQ+-gemeenschappen elkaar ontmoeten voor sociale, educatieve, recreatieve of organisatieactiviteiten."},{"@language":"sv","@value":"Platser där personer från hbtq+-gemenskaper möts för sociala, utbildningsrelaterade, fritids- eller organisatoriska aktiviteter."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000830"},{"@id":"https://homosaurus.org/v5/homoit0000900"}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000144"},{"@id":"https://homosaurus.org/v5/homoit0000486"},{"@id":"https://homosaurus.org/v5/homoit0000734"},{"@id":"https://homosaurus.org/v5/homoit0001171"},{"@id":"https://homosaurus.org/v5/homoit0001404"},{"@id":"https://homosaurus.org/v5/homoit0001512"},{"@id":"https://homosaurus.org/v5/homoit0002775"},{"@id":"https://homosaurus.org/v5/homoit0002968"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000297"},{"@id":"https://homosaurus.org/v5/homoit0002689"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2021008660"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000830"},"dc:replaces":{"@id":"http://homosaurus.org/v2/communityCentresLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000145","dc:identifier":"homoit0000145","skos:prefLabel":[{"@language":"en","@value":"Bisexual couples"},{"@language":"es","@value":"Parejas bisexuales"},{"@language":"de","@value":"Bisexuelle Paare"},{"@language":"nl","@value":"Biseksuele paren"},{"@language":"sv","@value":"Bisexuella par"}],"rdfs:comment":[{"@language":"en","@value":"Partnerships in which both people are bisexual."},{"@language":"es","@value":"Relaciones en las que ambas personas son bisexuales."},{"@language":"de","@value":"Partnerschaften, in denen beide Personen bisexuell sind."},{"@language":"nl","@value":"Partnerschappen waarin beide personen biseksueel zijn"},{"@language":"sv","@value":"Parrelationer där båda parterna är bisexuella."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000310"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000182"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001237"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualCouples"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000310","dc:identifier":"homoit0000310","skos:prefLabel":[{"@language":"en","@value":