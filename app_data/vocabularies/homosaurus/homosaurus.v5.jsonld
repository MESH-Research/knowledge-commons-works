org/v5/homoit0002426"},{"@id":"https://homosaurus.org/v5/homoit0002430"},{"@id":"https://homosaurus.org/v5/homoit0002436"},{"@id":"https://homosaurus.org/v5/homoit0002438"},{"@id":"https://homosaurus.org/v5/homoit0002444"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0002484"},{"@id":"https://homosaurus.org/v5/homoit0002487"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2023-01-17"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002506","dc:identifier":"homoit0002506","skos:prefLabel":[{"@language":"en","@value":"Megasexual fiction"},{"@language":"es","@value":"Ficción megasexual"},{"@language":"nl","@value":"Megaseksuele fictie"},{"@language":"sv","@value":"Megasexuell skönlitteratur"}],"rdfs:comment":[{"@language":"en","@value":"Genre of written works that depicts imagined events or people. Use for fiction focusing on megasexual characters or themes.\t\t"},{"@language":"es","@value":"Obras escritas que describen eventos o personas imaginadas; utilícese en referencia a obras de ficción que se centran en personajes o temas megasexuales."},{"@language":"nl","@value":"Geschreven werken waarin verbeelde gebeurtenissen of personen worden beschreven; te gebruiken voor fictie die zich richt op megaseksuele personages of thema's."},{"@language":"sv","@value":"Litterära verk som beskriver fiktiva händelser eller personer. Används för skönlitteratur med megasexuella karaktärer eller teman."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000443"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0002496"},{"@id":"https://homosaurus.org/v5/homoit0002497"},{"@id":"https://homosaurus.org/v5/homoit0002498"},{"@id":"https://homosaurus.org/v5/homoit0002499"},{"@id":"https://homosaurus.org/v5/homoit0002495"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0002150"},{"@id":"https://homosaurus.org/v5/homoit0002505"},{"@id":"https://homosaurus.org/v5/homoit0002507"},{"@id":"https://homosaurus.org/v5/homoit0002508"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-11"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002565","dc:identifier":"homoit0002565","skos:prefLabel":[{"@language":"en","@value":"Non-binary fiction"},{"@language":"es","@value":"Ficción no binaria"},{"@language":"nl","@value":"Non-binaire fictie"},{"@language":"sv","@value":"Ickebinär skönlitteratur"}],"skos:altLabel":{"@language":"en","@value":"Nonbinary fiction"},"rdfs:comment":[{"@language":"en","@value":"Genre of written works that depicts imagined events or people. Use for fiction focusing on non-binary characters or themes."},{"@language":"es","@value":"Obras escritas que describen eventos o personas imaginadas; utilícese en referencia a obras de ficción que se centran en personajes o temas no binarios."},{"@language":"nl","@value":"Geschreven publicaties waarin ingebeelde gebeurtenissen of personen worden beschreven; gebruik om te verwijzen naar fictieve werken die zich richten op non-binaire personages of thema's."},{"@language":"sv","@value":"Litterära verk som beskriver fiktiva händelser eller personer. Används för skönlitteratur med ickebinära karaktärer eller teman."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000443"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0002566"},{"@id":"https://homosaurus.org/v5/homoit0002567"},{"@id":"https://homosaurus.org/v5/homoit0002568"},{"@id":"https://homosaurus.org/v5/homoit0002570"},{"@id":"https://homosaurus.org/v5/homoit0002571"},{"@id":"https://homosaurus.org/v5/homoit0004303"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-12"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004295","dc:identifier":"homoit0004295","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ historical fiction"},{"@language":"nl","@value":"LHBTQ+-historische literatuur"},{"@language":"sv","@value":"Historiska skildringar (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"Historical fiction (LGBTQ)"},{"@language":"en","@value":"LGBTQ historial fiction"},{"@language":"nl","@value":"LHBTQ-historische literatuur"},{"@language":"sv","@value":"Historiska romaner (hbtq+)"}],"rdfs:comment":[{"@language":"en","@value":"Genre of written works that depicts events set during particular real historical events. Use for historical fiction focusing on LGBTQ+ characters or themes."},{"@language":"nl","@value":"Geschreven fictieve werken waarin het verhaal zich afspeelt tegen de achtergrond van specifieke, waargebeurde historische gebeurtenissen; gebruik in verwijzing naar historische fictie met LGBTQ+-personages of -thema's."},{"@language":"sv","@value":"Skönlitterära verk där intriger vävs samman med verkliga historiska händelser och miljöer. Används för historiska skildringar med fokus på hbtq+-karaktärer eller teman."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000443"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0004298"},{"@id":"https://homosaurus.org/v5/homoit0004299"},{"@id":"https://homosaurus.org/v5/homoit0004300"},{"@id":"https://homosaurus.org/v5/homoit0004301"},{"@id":"https://homosaurus.org/v5/homoit0004302"},{"@id":"https://homosaurus.org/v5/homoit0004303"},{"@id":"https://homosaurus.org/v5/homoit0004304"},{"@id":"https://homosaurus.org/v5/homoit0004305"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0004296"},{"@id":"https://homosaurus.org/v5/homoit0004297"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2026-02-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001751","dc:identifier":"homoit0001751","skos:prefLabel":[{"@language":"en","@value":"Two-Spirit fiction"},{"@language":"es","@value":"Ficción dos espíritus"},{"@language":"nl","@value":"Two-Spirit fictie"},{"@language":"sv","@value":"Two-spirit-skönlitteratur"}],"skos:altLabel":[{"@language":"en","@value":"2S fiction"},{"@language":"en","@value":"Two Spirit fiction"},{"@language":"en","@value":"Two Spirited fiction"},{"@language":"en","@value":"Two-Spirited fiction"}],"rdfs:comment":[{"@language":"en","@value":"Genre of written works that depicts imagined events or people. Use for fiction focusing on Two-Spirit characters or themes."},{"@language":"es","@value":"Obras de ficción escritas donde figuran personajes dos espíritus o se abordan temas dos espíritus."},{"@language":"nl","@value":"Fictie met two-spirit personages of two-spirit thema's"},{"@language":"sv","@value":"Litterära verk som beskriver fiktiva händelser eller personer. Används för skönlitteratur med Two-spirit-karaktärer eller teman."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002710"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0002646"},{"@id":"https://homosaurus.org/v5/homoit0002649"},{"@id":"https://homosaurus.org/v5/homoit0002650"},{"@id":"https://homosaurus.org/v5/homoit0002651"},{"@id":"https://homosaurus.org/v5/homoit0003188"},{"@id":"https://homosaurus.org/v5/homoit0002647"},{"@id":"https://homosaurus.org/v5/homoit0004297"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000443"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0002710"},"dc:issued":{"@type":"xsd:date","@value":"2021-11-09"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002153","dc:identifier":"homoit0002153","skos:prefLabel":[{"@language":"en","@value":"Bury your gays"},{"@language":"es","@value":"Bury your gays"},{"@language":"de","@value":"Bury Your Gays"},{"@language":"nl","@value":"Begraaf je homo's"},{"@language":"sv","@value":"Bury your gays"}],"skos:altLabel":[{"@language":"en","@value":"Dead lesbian syndrome"},{"@language":"es","@value":"Dead lesbian syndrome"},{"@language":"de","@value":"Begrabe deine Homosexuellen"},{"@language":"de","@value":"Begrabe deine Schwulen"},{"@language":"de","@value":"Begrabe deine Gays"},{"@language":"de","@value":"Dead Lesbian Trope"},{"@language":"de","@value":"Tote Lesben Trope"},{"@language":"nl","@value":"Dead lesbian syndrome"}],"rdfs:comment":[{"@language":"en","@value":"The trope in fiction that requires that LGBTQ+ characters die or meet some other type of unhappy ending. The trope is also known as \"dead lesbian syndrome\" due to the tendency for lesbian characters and bisexual female characters to be the targets. Transgender characters have also often been subjected to this trope."},{"@language":"es","@value":"El tropo de ficción que requiere que los personajes LGBTQ+ mueran o tengan otro tipo de final infeliz. El tropo también se conoce como el \"síndrome de lesbiana muerta\" debido a la tendencia de que personajes lésbicos y personajes femeninos bisexuales sean el foco del tropo. Las personajes transgénero a menudo también han sido sometidas a este tropo."},{"@language":"de","@value":"Der Trope in der Fiktion, der verlangt, dass LGBTQ+-Charaktere sterben oder ein anderes unglückliches Ende nehmen. Der Trope ist auch als „Dead Lesbian Trope“ bekannt, da lesbische und bisexuelle weibliche Charaktere häufig das Ziel sind. Auch Transgender-Charaktere sind häufig diesem Trope unterworfen worden. Sowohl \"Bury Your Gays\" als auch \"Dead Lesbian Trope\" wird meist auch im deutschen Sprachraum nicht übersetzt."},{"@language":"nl","@value":"De troop in fictie waarbij LHBTQ+-personages sterven of op een andere manier ongelukkig aan hun einde komen. De troop is ook bekend als \"dead lesbian syndrome\" omdat lesbische en biseksuele vrouwelijke personages vaak het doelwit zijn. Ook bij transgender-personages komt deze troop vaak voor"},{"@language":"sv","@value":"En trop inom fiktion som kräver att hbtq+-karaktärer dör eller möter ett olyckligt slut. Tropen kallas även ”dead lesbian syndrome” eftersom lesbiska och bisexuella kvinnliga karaktärer ofta är måltavlor. Transkaraktärer har också ofta utsatts för denna trop."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002160"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000443"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002159","dc:identifier":"homoit0002159","skos:prefLabel":[{"@language":"en","@value":"Fanfiction"},{"@language":"es","@value":"Fanficcion"},{"@language":"de","@value":"Fanfiction"},{"@language":"nl","@value":"Fanfictie"},{"@language":"sv","@value":"Fanfiction"}],"skos:altLabel":[{"@language":"en","@value":"Fan fic"},{"@language":"en","@value":"Fan fiction"},{"@language":"en","@value":"Fanfic"},{"@language":"es","@value":"Fan fic"},{"@language":"es","@value":"Fanfic"},{"@language":"es","@value":"Fanfiction"},{"@language":"de","@value":"Fan-Fiction"},{"@language":"nl","@value":"Fan fictie"},{"@language":"nl","@value":"Fanfic"}],"rdfs:comment":[{"@language":"en","@value":"Written works of fiction created by fans that use the characters, settings, and/or plots of other media properties in a transformative way."},{"@language":"es","@value":"Obras escritas de ficción creadas por fanáticos que utilizan los personajes, escenarios y/o tramas de otras propiedades mediáticas de manera transformadora."},{"@language":"de","@value":"Von Fans verfasste fiktionale Werke, die die Figuren, Schauplätze und/oder Handlungen anderer Medien auf transformative Weise verwenden."},{"@language":"nl","@value":"Geschreven fictie gemaakt door fans die de personages, settings en/of plots van andere media-uitingen op een transformatieve manier gebruiken"},{"@language":"sv","@value":"Skrivna skönlitterära verk skapade av fans som använder karaktärer, miljöer och/eller handlingar från andra medier på ett transformerande sätt."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002161"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0002160"},{"@id":"https://homosaurus.org/v5/homoit0002179"},{"@id":"https://homosaurus.org/v5/homoit0002205"},{"@id":"https://homosaurus.org/v5/homoit0002210"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000443"},{"@id":"https://homosaurus.org/v5/homoit0002155"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2006002523"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002179","dc:identifier":"homoit0002179","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ fanfiction"},{"@language":"es","@value":"Fanfiction LGBTQ+"},{"@language":"ja","@value":"LGBTQ+ファンフィクション"},{"@language":"nl","@value":"LHBTQ+-fanfictie"},{"@language":"sv","@value":"Hbtq+-fanfiction"}],"skos:altLabel":[{"@language":"en","@value":"Fan fic (LGBTQ)"},{"@language":"en","@value":"Fan fics (LGBTQ)"},{"@language":"en","@value":"Fan fiction (LGBTQ)"},{"@language":"en","@value":"Fanfiction (LGBTQ)"},{"@language":"en","@value":"LGBTQ+ fan fics"},{"@language":"en","@value":"LGBTQ+ fan fiction"},{"@language":"en","@value":"LGBTQ+ fanfics"},{"@language":"ja","@value":"ファンフィクション（LGBTQ）"},{"@language":"nl","@value":"Fan fics (LHBTQ+)"},{"@language":"nl","@value":"Fan fictie (LHBTQ+)"},{"@language":"nl","@value":"Fanfictie (LHBTQ+)"},{"@language":"nl","@value":"LHBTQ+-fan fics"},{"@language":"nl","@value":"LHBTQ+-fan fictie"},{"@language":"nl","@value":"LHBTQ+-fanfics"}],"rdfs:comment":[{"@language":"en","@value":"Fanfiction that primarily focuses on LGBTQ+ people, communities, and relationships, often using characters who are not stated to be LGBTQ+ in canon."},{"@language":"es","@value":"Fanfiction que se centra principalmente en personas, comunidades y relaciones LGBTQ+, y que a menudo utiliza personajes que no están declarados como LGBTQ+ en el canon."},{"@language":"ja","@value":"主にLGBTQ+の人々、コミュニティ、そして人間関係を題材としたファンフィクション。原作ではLGBTQ+であると明示されていないキャラクターが登場することが多い。"},{"@language":"nl","@value":"Fanfictie die zich voornamelijk richt op LHBTQ+-personen, gemeenschappen en relaties, waarbij vaak personages worden gebruikt waarvan in de canon niet wordt vermeld dat ze LHBTQ+ zijn"},{"@language":"sv","@value":"Fanfiction som i första hand fokuserar på hbtq+-personer, gemenskaper och relationer, ofta med karaktärer som inte är hbtq+ i originalberättelsen."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002159"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000443"},{"@id":"https://homosaurus.org/v5/homoit0001522"},{"@id":"https://homosaurus.org/v5/homoit0001723"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002180","dc:identifier":"homoit0002180","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ headcanons"},{"@language":"es","@value":"Headcanons LGBTQ+"},{"@language":"nl","@value":"LHBTQ+-headcanons"},{"@language":"sv","@value":"Headcanon (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"Headcanons (LGBTQ)"},{"@language":"es","@value":"Headcanons (LGBTQ)"},{"@language":"sv","@value":"Huvudkanon (hbtq+)"}],"rdfs:comment":[{"@language":"en","@value":"Fans' personal interpretations of media properties and texts, particularly relating to the personalities and behaviors of characters. Use to describe headcanons that certain characters or relationships are LGBTQ+, as well as headcanons about other LGBTQ+ people and issues in the universe of the text."},{"@language":"es","@value":"Interpretaciones personales de los fanáticos de las propiedades y textos de los medios, particularmente en relación con las personalidades y comportamientos de los personajes. Utilícese para describir cánones principales de que ciertos personajes o relaciones son LGBTQ+, así como cánones principales sobre otras personas y problemas LGBTQ+ en el universo del texto."},{"@language":"nl","@value":"Persoonlijke interpretaties door fans van media-uitingen en teksten, met name met betrekking tot de persoonlijkheden en het gedrag van personages. Gebruik om headcanons te beschrijven dat bepaalde karakters of relaties LHBTQ+ zijn, evenals headcanons over andere LHBTQ+-personen en -zaken in de tekst"},{"@language":"sv","@value":"Personliga tolkningar av medieinnehåll och berättelser av fans, särskilt kring karaktärers personlighet och beteende. Används för att beskriva headcanons om att vissa karaktärer eller relationer är hbtq+, samt tolkningar av hbtq+-personer och frågor i det fiktiva universumet."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001149"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000443"},{"@id":"https://homosaurus.org/v5/homoit0002199"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001149"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002188","dc:identifier":"homoit0002188","skos:prefLabel":[{"@language":"en","@value":"Original slash fiction"},{"@language":"es","@value":"Ficción slash original"},{"@language":"nl","@value":"Originele slash fictie"},{"@language":"sv","@value":"Original slash fiction"}],"skos:altLabel":[{"@language":"es","@value":"Fan ficción slash original"},{"@language":"es","@value":"Fan fic slash original"},{"@language":"es","@value":"Slash fic original"},{"@language":"es","@value":"Fanfiction slash original"},{"@language":"es","@value":"Fanfic slash original"}],"rdfs:comment":[{"@language":"en","@value":"Original works of creative fiction that focus on same-sex or same-gender relationships and incorporate tropes from fanfiction; includes femslash fiction."},{"@language":"es","@value":"Obras originales de ficción creativa que se centran en relaciones entre personas del mismo sexo o del mismo género e incorporan tropos de fanfiction; incluye la ficción femslash."},{"@language":"nl","@value":"Originele werken van creatieve fictie die zich richten op relaties tussen mensen van hetzelfde geslacht of gender en met stijlfiguren uit fanfictie; inclusief femslash-fictie"},{"@language":"sv","@value":"Originalverk inom skönlitteratur som fokuserar på samkönade relationer och som använder berättargrepp hämtade från fanfiction. Inkluderar även så kallad femslash-litteratur."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002205"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000443"},{"@id":"https://homosaurus.org/v5/homoit0000859"},{"@id":"https://homosaurus.org/v5/homoit0002217"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002632","dc:identifier":"homoit0002632","skos:prefLabel":[{"@language":"en","@value":"Māhū fiction"},{"@language":"es","@value":"Ficción māhū"},{"@language":"nl","@value":"Māhū fictie"},{"@language":"sv","@value":"Māhū-skönlitteratur"}],"skos:altLabel":{"@language":"en","@value":"Mahu fiction"},"rdfs:comment":[{"@language":"en","@value":"Genre of written works that depicts imagined events or people. Use for fiction focusing on māhū characters or themes."},{"@language":"es","@value":"Obras escritas que describen eventos o personas imaginadas; utilícese en referencia a obras de ficción que se centran en personajes o temas māhū."},{"@language":"nl","@value":"Geschreven werken die denkbeeldige gebeurtenissen of personen beschrijven; gebruik met betrekking tot fictieve werken die zich richten op Māhū-personages of -thema's."},{"@language":"sv","@value":"Litterära verk som beskriver fiktiva händelser eller personer. Används för skönlitteratur med māhū-karaktärer eller teman."}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0002636"},{"@id":"https://homosaurus.org/v5/homoit0002639"},{"@id":"https://homosaurus.org/v5/homoit0002640"},{"@id":"https://homosaurus.org/v5/homoit0002641"},{"@id":"https://homosaurus.org/v5/homoit0002637"},{"@id":"https://homosaurus.org/v5/homoit0004296"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000443"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0002632"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000446","dc:identifier":"homoit0000446","skos:prefLabel":[{"@language":"en","@value":"Fingering"},{"@language":"de","@value":"Fingern"},{"@language":"es","@value":"Dedear"},{"@language":"nl","@value":"Vingeren"},{"@language":"sv","@value":"Fingersex"}],"skos:altLabel":[{"@language":"en","@value":"Finger banging"},{"@language":"en","@value":"Finger fucking"},{"@language":"es","@value":"Dar dedo"},{"@language":"es","@value":"Dedeo"},{"@language":"es","@value":"Penetración digital"},{"@language":"es","@value":"Hacer un dedo"},{"@language":"es","@value":"Hacerse un dedo"},{"@language":"es","@value":"Hacer dedos"},{"@language":"es","@value":"Hacerse dedos"},{"@language":"es","@value":"Fingering"},{"@language":"es","@value":"Penetración con los dedos"},{"@language":"sv","@value":"Pulla"}],"rdfs:comment":[{"@language":"en","@value":"Sexual act involving the use of and insertion of the fingers to stimulate the vagina and/or anus."},{"@language":"de","@value":"Sexueller Akt, bei dem die Finger zur Stimulation der Vagina und/oder des Anus verwendet und eingeführt werden."},{"@language":"es","@value":"Acto sexual que consiste en utilizar e introducir los dedos para estimular la vagina y/o el ano."},{"@language":"sv","@value":"Sexuell handling som innebär att använda och föra in fingrar för att stimulera vagina och/eller anus."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000988"},{"@id":"https://homosaurus.org/v5/homoit0001487"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000445"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001267"},"dc:replaces":{"@id":"http://homosaurus.org/v2/fingering"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000447","dc:identifier":"homoit0000447","skos:prefLabel":[{"@language":"en","@value":"Flagellation"},{"@language":"de","