ment":[{"@language":"en","@value":"Auditory content broadcast on the radio (analog or digital) about bisexuality and bisexual issues."},{"@language":"de","@value":"Im Radio ausgestrahlte hörbare Inhalte (analog oder digital) über Bisexualität und bisexuelle Themen."},{"@language":"es","@value":"Contenido auditivo emitido por radio (analógica o digital) sobre la bisexualidad y asuntos bisexuales."},{"@language":"nl","@value":"Auditieve inhoud uitgezonden op de radio (analoog of digitaal) over biseksuele personen en biseksuele kwesties."},{"@language":"sv","@value":"Ljudinnehåll som sänds i radio, analog eller digital, och som handlar om bisexuella personer eller bisexuella frågor."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001231"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0004320"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001231"},"dc:replaces":{"@id":"http://homosaurus.org/v2/bisexualRadio"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001231","dc:identifier":"homoit0001231","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ radio"},{"@language":"es","@value":"Radio LGBTQ+"},{"@language":"nl","@value":"LHBTQ+-radio"},{"@language":"sv","@value":"Hbtq+-radio"}],"skos:altLabel":[{"@language":"en","@value":"Radio (LGBTQ)"},{"@language":"es","@value":"Radio (LGBTQ)"},{"@language":"sv","@value":"Gayradio"}],"rdfs:comment":[{"@language":"en","@value":"Auditory content broadcast on the radio (analog or digital) about LGBTQ+ people and/or LGBTQ+ issues."},{"@language":"es","@value":"Contenido auditivo emitido en radio (analógica o digital) sobre personas LGBTQ+ y/o asuntos LGBTQ+."},{"@language":"nl","@value":"Auditieve inhoud uitgezonden op de radio (analoog of digitaal) over LHBTQ+-personen en LHBTQ+-kwesties."},{"@language":"sv","@value":"Ljudinnehåll som sänds i radio, analog eller digital, och som handlar om hbtq+-personer eller hbtq+-frågor."}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000181"},{"@id":"https://homosaurus.org/v5/homoit0000528"},{"@id":"https://homosaurus.org/v5/homoit0000772"},{"@id":"https://homosaurus.org/v5/homoit0001204"},{"@id":"https://homosaurus.org/v5/homoit0001441"},{"@id":"https://homosaurus.org/v5/homoit0002806"},{"@id":"https://homosaurus.org/v5/homoit0002938"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0002721"},{"@id":"https://homosaurus.org/v5/homoit0004317"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001231"},"dc:replaces":{"@id":"http://homosaurus.org/v2/radioLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004320","dc:identifier":"homoit0004320","skos:prefLabel":[{"@language":"en","@value":"Bisexual podcasts"},{"@language":"nl","@value":"Biseksuele podcasts"},{"@language":"sv","@value":"Bisexuella poddar"}],"skos:altLabel":[{"@language":"en","@value":"Bi podcasts"},{"@language":"sv","@value":"Bisexuella podcaster"}],"rdfs:comment":[{"@language":"en","@value":"A recorded series (primarily in audio, but sometimes with a video component) with recurring hosts that feature content about bisexual people and/or bisexual issues and that are available digitally for streaming or download. Podcasts are typically episodic and may feature different guests."},{"@language":"nl","@value":"Een opgenomen serie (voornamelijk audio, maar soms met een video-onderdeel) met terugkerende presentatoren die content presenteren over biseksuele personen en/of biseksuele thema's en die digitaal beschikbaar zijn om te streamen of te downloaden. Podcasts bestaan ​​doorgaans uit afleveringen en kunnen verschillende gasten hebben."},{"@language":"sv","@value":"Inspelade radioprogram (inslag av video kan förekomma) med återkommande programledare och innehåll om/för bisexuella och/eller bisexuella frågor som är digitalt tillgängliga genom streaming eller nedladdning. Poddar är vanligen uppdelade i episoder och kan ha olika gäster."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0004317"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000181"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0004317"},"dc:issued":{"@type":"xsd:date","@value":"2026-02-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000529","dc:identifier":"homoit0000529","skos:prefLabel":[{"@language":"en","@value":"Gay relationships"},{"@language":"es","@value":"Relaciones gay"},{"@language":"de","@value":"Schwule Beziehungen"},{"@language":"nl","@value":"Homorelaties"},{"@language":"sv","@value":"Bögrelationer"}],"skos:altLabel":{"@language":"sv","@value":"Relationer mellan homosexuella män"},"rdfs:comment":[{"@language":"en","@value":"Ongoing connections (romantic, sexual, or platonic) between two or more gay men."},{"@language":"es","@value":"Conexiones continuas (románticas, sexuales o platónicas) entre dos o más hombres gay."},{"@language":"de","@value":"Dauerhafte Beziehungen (romantischer, sexueller oder platonischer Natur) zwischen zwei oder mehr schwulen Männern."},{"@language":"nl","@value":"Voortdurende connecties (romantisch, seksueel of platonisch) tussen twee of meer homomannen."},{"@language":"sv","@value":"Pågående relationer, romantiska, sexuella eller platoniska, mellan två eller flera bögar."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001237"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000182"},{"@id":"https://homosaurus.org/v5/homoit0001205"},{"@id":"ht