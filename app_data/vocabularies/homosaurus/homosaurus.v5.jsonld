 non-binaire personen of bedoeld is voor gebruik door Non-binaire personen."},{"@language":"sv","@value":"Bibliotek som samlar material som främst rör ickebinära personer eller är avsett att användas av ickebinära personer."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000968"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001755"},"dc:issued":{"@type":"xsd:date","@value":"2026-02-24"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001813","dc:identifier":"homoit0001813","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ special collections"},{"@language":"es","@value":"Colecciones especiales LGBTQ+"},{"@language":"nl","@value":"LHBTQ+-speciale collecties"},{"@language":"sv","@value":"Specialsamlingar (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"Hidden collections (LGBTQ)"},{"@language":"en","@value":"LGBTQ+ hidden collections"},{"@language":"en","@value":"Special collections (LGBTQ)"},{"@language":"es","@value":"Colecciones especiales LGBTQ"},{"@language":"es","@value":"Colecciones especiales (LGBTQ)"},{"@language":"es","@value":"Colecciones ocultas (LGBTQ)"},{"@language":"nl","@value":"Speciale collecties (LHBTQ)"},{"@language":"nl","@value":"Verborgen collecties (LHBTQ)"}],"rdfs:comment":[{"@language":"en","@value":"Special collections that hold materials primarily pertaining to LGBTQ+ people or intended for use by LGBTQ+ people. Special collections tend to be a blend of institutional types (e.g., an archives with a museum component). This term should be applied to institutions that refer to themselves as special collections; otherwise, use the term \"LGBTQ+ cultural heritage institutions.\""},{"@language":"es","@value":"Colecciones especiales que contienen materiales principalmente relacionados con personas LGBTQ+ o destinados a ser utilizados por personas LGBTQ+. Las colecciones especiales tienden a ser una combinación de tipos institucionales (por ejemplo, archivos con un componente de museo). Este término debe aplicarse a instituciones que se refieran a sí mismas como colecciones especiales; de lo contrario, utilícese el término \"instituciones de patrimonio cultural LGBTQ+\"."},{"@language":"nl","@value":"Speciale collecties met materialen die voornamelijk betrekking hebben op LHBTQ+-personen of bedoeld zijn voor gebruik door LHBTQ+-personen. Bijzondere collecties zijn vaak een mix van institutionele typen (bijvoorbeeld een archief met een museale component). Deze term moet worden toegepast op instellingen met bijzondere collecties; in andere gevallen gebruik LHBTQ+-cultureel erfgoed instellingen"},{"@language":"sv","@value":"Specialsamlingar som innehåller material som främst rör hbtq+-personer eller är avsedda för hbtq+-personer. Används för institutioner som själva definierar sig som specialsamlingar, annars använd termen ”Hbtq+-kulturarvsinstitutioner”."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001755"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000968"},{"@id":"https://homosaurus.org/v5/homoit0001030"},{"@id":"https://homosaurus.org/v5/homoit0001363"},{"@id":"https://homosaurus.org/v5/homoit0003547"},{"@id":"https://homosaurus.org/v5/homoit0004328"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001755"},"dc:issued":{"@type":"xsd:date","@value":"2022-01-24"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002697","dc:identifier":"homoit0002697","skos:prefLabel":[{"@language":"en","@value":"Two-Spirit libraries"},{"@language":"es","@value":"Bibliotecas dos espíritus"},{"@language":"de","@value":"Two-Spirit-Bibliotheken"},{"@language":"nl","@value":"Two-Spirit bibliotheken"},{"@language":"sv","@value":"Two-spirit-bibliotek"}],"skos:altLabel":[{"@language":"en","@value":"2S libraries"},{"@language":"en","@value":"Two Spirit libraries"},{"@language":"en","@value":"Two Spirited libraries"},{"@language":"en","@value":"Two-Spirited libraries"},{"@language":"de","@value":"Bibliotheken für Two-Spirit-Personen"}],"rdfs:comment":[{"@language":"en","@value":"Libraries that hold materials primarily pertaining to Two-Spirit people or intended for use by Two-Spirit people."},{"@language":"es","@value":"Bibliotecas que contienen materiales principalmente relacionados con personas dos espíritus o destinados a ser utilizados por personas dos espíritus."},{"@language":"de","@value":"Bibliotheken, die in erster Linie Materialien zu Two-Spirit-Personen und -Themen oder für die Nutzung durch Two-Spirit-Personen bereithalten."},{"@language":"nl","@value":"Bibliotheken met materiaal dat voornamelijk betrekking heeft op Two-Spirit people of bedoeld is voor gebruik door Two-Spirit people."},{"@language":"sv","@value":"Bibliotek som samlar material som främst rör Two-spirit-personer eller är avsett att användas av Two-spirit-personer."}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000968"},{"@id":"https://homosaurus.org/v5/homoit0004331"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0002697"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-26"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003547","dc:identifier":"homoit0003547","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ archivists"},{"@language":"ja","@value":"LGBTQ+のアーキビスト"},{"@language":"nl","@value":"LHBTQ+-archivarissen"},{"@language":"sv","@value":"Hbtq+-arkivarier"}],"skos:altLabel":{"@language":"en","@value":"Archivists (LGBTQ+)"},"rdfs:comment":[{"@language":"en","@value":"LGBTQ+ people who assess, curate, manage, process, preserve, steward, and/or provide access to records and archives of enduring historical value."},{"@language":"ja","@value":"永続的な歴史的価値を持つ記録やアーカイブの評価、選定、管理、処理、保存、維持管理、利用提供を行うLGBTQ+の人々。"},{"@language":"nl","@value":"LHBTQ+-personen die documenten en archieven met blijvende historische waarde beoordelen, beheren, verwerken, bewaren, en/of toegankelijk maken."},{"@language":"sv","@value":"Hbtq+-personer som bedömer, kuraterar, hanterar, bearbetar, bevarar, förvaltar och/eller tillgängliggör arkiv och dokument av bestående historiskt värde."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0003617"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0003548"},{"@id":"https://homosaurus.org/v5/homoit0003549"},{"@id":"https://homosaurus.org/v5/homoit0003550"},{"@id":"https://homosaurus.org/v5/homoit0003551"},{"@id":"https://homosaurus.org/v5/homoit0003552"},{"@id":"https://homosaurus.org/v5/homoit0003553"},{"@id":"https://homosaurus.org/v5/homoit0003554"},{"@id":"https://homosaurus.org/v5/homoit0003555"},{"@id":"https://homosaurus.org/v5/homoit0003633"},{"@id":"https://homosaurus.org/v5/homoit0003634"},{"@id":"https://homosaurus.org/v5/homoit0003635"},{"@id":"https://homosaurus.org/v5/homoit0003636"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000968"},{"@id":"https://homosaurus.org/v5/homoit0001813"},{"@id":"https://homosaurus.org/v5/homoit0003556"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0003617"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-22"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003618","dc:identifier":"homoit0003618","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ librarians"},{"@language":"nl","@value":"LHBTQ+-bibliothecarissen"},{"@language":"sv","@value":"Hbtq+-bibliotekarier"}],"skos:altLabel":{"@language":"en","@value":"Librarians (LGBTQ+)"},"rdfs:comment":[{"@language":"en","@value":"LGBTQ+ people, typically with degrees in library science, who work, manage, or assist in a library setting."},{"@language":"nl","@value":"LHBTQ+-personen, meestal met een bibliotheekopleiding, die in een bibliotheek werken, daar leidinggeven of assisteren."},{"@language":"sv","@value":"Hbtq+-personer, vanligtvis med examen i biblioteks- och informationsvetenskap, som arbetar, leder eller assisterar i en biblioteksverksamhet."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0003617"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0003620"},{"@id":"https://homosaurus.org/v5/homoit0003621"},{"@id":"https://homosaurus.org/v5/homoit0003622"},{"@id":"https://homosaurus.org/v5/homoit0003623"},{"@id":"https://homosaurus.org/v5/homoit0003624"},{"@id":"https://homosaurus.org/v5/homoit0003625"},{"@id":"https://homosaurus.org/v5/homoit0003626"},{"@id":"https://homosaurus.org/v5/homoit0003628"},{"@id":"https://homosaurus.org/v5/homoit0003629"},{"@id":"https://homosaurus.org/v5/homoit0003630"},{"@id":"https://homosaurus.org/v5/homoit0003631"},{"@id":"https://homosaurus.org/v5/homoit0003632"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000968"},{"@id":"https://homosaurus.org/v5/homoit0000972"},{"@id":"https://homosaurus.org/v5/homoit0003247"},{"@id":"https://homosaurus.org/v5/homoit0003627"},{"@id":"https://homosaurus.org/v5/homoit0004335"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0003617"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-22"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001183","dc:identifier":"homoit0001183","skos:prefLabel":[{"@language":"en","@value":"Queer literature"},{"@language":"es","@value":"Literatura queer"},{"@language":"nl","@value":"Queer literatuur"},{"@language":"sv","@value":"Queer litteratur"}],"r