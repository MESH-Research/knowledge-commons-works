aurus.org/v5/homoit0002658"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0004337"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-26"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002664","dc:identifier":"homoit0002664","skos:prefLabel":[{"@language":"en","@value":"Asexual neurodivergent people"},{"@language":"de","@value":"Asexuelle neurodivergente Personen"},{"@language":"es","@value":"Personas asexuales neurodivergentes"},{"@language":"nl","@value":"Aseksuele neurodivergente personen"},{"@language":"sv","@value":"Asexuella neurodivergenta personer"}],"skos:altLabel":[{"@language":"en","@value":"Ace neurodivergent people"},{"@language":"en","@value":"Asexual neuroatypical people"},{"@language":"en","@value":"Ace neuroatypical people"},{"@language":"de","@value":"Neurodivergente asexuelle Personen"},{"@language":"de","@value":"Neurodivergente ace Personen"},{"@language":"de","@value":"Ace neurodivergente Personen"},{"@language":"es","@value":"Personas neurodivergentes asexuales"},{"@language":"nl","@value":"Ace neurodivergente personen"},{"@language":"nl","@value":"Aseksuele neuro-atypische personen"}],"rdfs:comment":[{"@language":"en","@value":"Asexual people with neurodevelopmental differences in areas such as cognition, sensory processing, emotionality, and sociality."},{"@language":"de","@value":"Asexuelle Menschen, deren Gehirn anders verarbeitet, lernt und/oder sich anders verhält als gesellschaftlich üblich. Einige dieser neurologischen Unterschiede können sich in Lernschwierigkeiten, medizinischen Störungen und anderen Erkrankungen äussern."},{"@language":"es","@value":"Personas asexuales cuyos cerebros procesan, aprenden y/o se comportan de forma diferente a lo que la sociedad considera típico. Algunas de estas diferencias neurológicas pueden presentarse como dificultades de aprendizaje, trastornos médicos y otras condiciones."},{"@language":"nl","@value":"Aseksuele personen met neurodevelopmentale verschillen op gebieden zoals cognitie, zintuiglijke verwerking, emotionaliteit en sociale vaardigheden."},{"@language":"sv","@value":"Asexuella personer vars kognition, sensoriska bearbetning, emotionalitet eller sociala förmåga skiljer sig från normen. Dessa variationer kan för vissa innebära funktionsnedsättningar eller medicinska tillstånd, medan de för andra är egenskaper som ingår i deras identitet."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0002658"},{"@id":"https://homosaurus.org/v5/homoit0002782"}],"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0002675"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-26"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002665","dc:identifier":"homoit0002665","skos:prefLabel":[{"@language":"en","@value":"Intersex neurodivergent people"},{"@language":"de","@value":"Inter* neurodivergente Personen"},{"@language":"es","@value":"Personas intersexuales neurodivergentes"},{"@language":"nl","@value":"Intersekse neurodivergente personen"},{"@language":"sv","@value":"Neurodivergenta intersexpersoner"}],"skos:altLabel":[{"@language":"en","@value":"Intersex neuroatypical people"},{"@language":"de","@value":"Neurodivergente inter* Personen"},{"@language":"es","@value":"Personas intersex neurodivergentes"}],"rdfs:comment":[{"@language":"en","@value":"Intersex people with neurodevelopmental differences in areas such as cognition, sensory processing, emotionality, and sociality."},{"@language":"de","@value":"Inter* Personen, deren Gehirn anders verarbeitet, lernt und/oder sich anders verhält als gesellschaftlich üblich. Einige dieser neurologischen Unterschiede können sich in Lernschwierigkeiten, medizinischen Störungen und anderen Erkrankungen äussern."},{"@language":"es","@value":"Personas intersex cuyos cerebros procesan, aprenden y/o se comportan de manera diferente a lo que la sociedad considera típico. Algunas de estas diferencias neurológicas pueden presentarse como problemas de aprendizaje, trastornos médicos y otras condiciones."},{"@language":"nl","@value":"Intersekse personen met neurodevelopmentale verschillen op gebieden zoals cognitie, zintuiglijke verwerking, emotionaliteit en sociale vaardigheden."},{"@language":"sv","@value":"Intersexpersoner vars kognition, sensoriska bearbetning, emotionalitet eller sociala förmåga skiljer sig från normen. Dessa variationer kan för vissa innebära funktionsnedsättningar eller medicinska tillstånd, medan de för andra är egenskaper som ingår i deras identitet."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002658"},"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0002674"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-26"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002667","dc:identifier":"homoit0002667","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ autistic people"},{"@language":"es","@value":"Personas LGBTQ+ autistas"},{"@language":"ja","@value":"LGBTQ+の自閉症の人々"},{"@language":"nl","@value":"LHBTQ+-autistische personen"},{"@language":"sv","@value":"Hbtq+-personer med autism"}],"skos:altLabel":[{"@language":"en","@value":"LGBTQ+ people with autism"},{"@language":"es","@value":"Personas LGBTQ+ con autismo"},{"@language":"es","@value":"Personas autistas LGBTQ+"},{"@language":"ja","@value":"自閉症のあるLGBTQ+の人々"},{"@language":"sv","@value":"Autistiska hbtq+-personer"}],"rdfs:comment":[{"@language":"en","@value":"LGBTQ+ people who are autistic."},{"@language":"es","@value":"Personas LGBTQ+ que son autistas."},{"@language":"ja","@value":"自閉症のLGBTQ+の人々。"},{"@language":"nl","@value":"LHBTQ+-personen die autistisch zijn."},{"@language":"sv","@value":"Hbtq+-personer som är autistiska."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002658"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0002668"},{"@id":"https://homosaurus.org/v5/homoit0002669"},{"@id":"https://homosaurus.org/v5/homoit0002670"},{"@id":"https://homosaurus.org/v5/homoit0002671"},{"@id":"https://homosaurus.org/v5/homoit0002672"},{"@id":"https://homosaurus.org/v5/homoit0002673"},{"@id":"https://homosaurus.org/v5/homoit0002674"},{"@id":"https://homosaurus.org/v5/homoit0002675"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0002676"},{"@id":"https://homosaurus.org/v5/homoit0003825"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-26"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004337","dc:identifier":"homoit0004337","skos:prefLabel":[{"@language":"en","@value":"Neuroqueer"},{"@language":"nl","@value":"Neuroqueer"},{"@language":"sv","@value":"Neuroqueer"}],"rdfs:comment":[{"@language":"en","@value":"Term used to describe individuals who are both neurodivergent and queer or for those whose neurodivergence greatly affects and cannot be unlinked from their experiences or identity as queer people. Can also refer to the practice of queering neuronormativity and heteronormativity. Note that the usage of the word queer in this term refers more to one's social identity and behavior rather than one's gender or sexual orientation. Only use to describe neurodivergent people who describe themselves as neuroqueer."},{"@language":"nl","@value":"Een term die gebruikt wordt om individuen te beschrijven die zowel neurodivergent als queer zijn, of voor mensen bij wie neurodivergentie een grote invloed heeft op hun ervaringen of identiteit als queer persoon en daar niet los van te zien is. Kan ook verwijzen naar de praktijk van het 'queeren' van neuronormativiteit en heteronormativiteit. Merk op dat het gebruik van het woord 'queer' in deze term meer verwijst naar iemands sociale identiteit en gedrag dan naar iemands gender of seksuele geaardheid. Gebruik deze term alleen om neurodivergente mensen te beschrijven die zichzelf als neuroqueer omschrijven."},{"@language":"sv","@value":"Term som används för att beskriva personer som är både neurodivergenta och queera eller för personer vars neurodivergens påverkar och ej kan frånkopplas från deras sexualitet eller könsuttryck. Kan också referera till praktiken att queera neuronormativitet och heteronormativitet. Observera att användandet av ordet queer här refererar till en personers sociala identitet och beteende snarare än till någons könstillhörighet eller sexuella identitet. Används endast för neurodivergenta personer som själva identifierar sig som neuroqueer."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002658"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0004336"},{"@id":"https://homosaurus.org/v5/homoit0003824"},{"@id":"https://homosaurus.org/v5/homoit0002663"},{"@id":"https://homosaurus.org/v5/homoit0002672"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2026-02-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002669","dc:identifier":"homoit0002669","skos:prefLabel":[{"@language":"en","@value":"Gay autistic men"},{"@language":"es","@value":"Hombres gay autistas"},{"@language":"de","@value":"Schwule autistische Männer"},{"@language":"nl","@value":"Autistische homomannen"},{"@language":"sv","@value":"Bögar med autism"}],"skos:altLabel":[{"@language":"en","@value":"Gay men with autism"},{"@language":"en","@value":"Gay autistic people"},{"@language":"en","@value":"Gay people with autistic"},{"@language":"en","@value":"Gay autists"},{"@language":"en","@value":"Autistic gay men"},{"@language":"en","@value":"Autistic gay people"},{"@language":"es","@value":"Hombres autistas gay"},{"@language":"es","@value":"Hombres gay con autismo"},{"@language":"de","@value":"Autistische schwule Männer"},{"@language":"de","@value":"Schwule Autisten"},{"@language":"nl","@value":"Homo-autistische mannen"},{"@language":"nl","@value":"Homo-autistische personen"},{"@language":"nl","@value":"Homomannen met autisme"},{"@language":"sv","@value":"Autistiska bögar"}],"rdfs:comment":[{"@language":"en","@value":"Gay men who are autistic."},{"@language":"es","@value":"Hombres gay que son autistas."},{"@language":"de","@value":"Schwule Männer, die autistisch sind."},{"@language":"nl","@value":"Homomannen die autistisch zijn"},{"@language":"sv","@value":"Bögar som är autistiska."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0002667"},{"@id":"https://homosaurus.org/v5/homoit0002659"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-26"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002670","dc:identifier":"homoit0002670","skos:prefLabel":[{"@language":"en","@value":"Bisexual autistic people"},{"@language":"es","@value":"Personas bisexuales autistas"},{"@language":"de","@value":"Bisexuelle autistische Personen"},{"@language":"nl","@value":"Biseksuele autistische personen"},{"@language":"sv","@value":"Bisexuella personer med autism"}],"skos:altLabel":[{"@language":"en","@value":"Bisexual people with autism"},{"@language":"es","@value":"Personas bisexuales con autismo"},{"@language":"es","@value":"Personas autistas bisexuales"},{"@language":"de","@value":"Autistische bisexuelle Personen"},{"@language":"sv","@value":"Bisexuella autister"}],"rdfs:comment":[{"@language":"en","@value":"Bisexual people who are autistic."},{"@language":"es","@value":"Personas bisexuales que son autistas."},{"@language":"de","@value":"Bisexuelle Personen, die autistisch sind."},{"@language":"nl","@value":"Biseksuele personen die autistisch zijn."},{"@language":"sv","@value":"Bisexuella personer som är autistiska."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0002667"},{"@id":"https://homosaurus.org/v5/homoit0002661"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-26"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004336","dc:identifier":"homoit0004336","skos:prefLabel":[{"@language":"en","@value":"Neurotrans"},{"@language":"nl","@value":"Neurotrans"},{"@language":"sv","@value":"Neurotrans"}],"rdfs:comment":[{"@language":"en","@value":"Term used to describe individuals who are both neurodivergent and trans or for those whose neurodivergence greatly affects and cannot be unlinked from their experiences or identity as trans people. Only use to describe neurodivergent people who describe themselves as neurotrans."},{"@language":"nl","@value":"Term die wordt gebruikt om personen te beschrijven die zowel neurodivergent als trans zijn, of voor personen bij wie de neurodivergentie een grote invloed heeft op hun ervaringen of identiteit als transpersoon en daar niet los van kan worden gezien. Alleen gebruiken om neurodivergente personen te beschrijven die zichzelf als neurotrans omschrijven."},{"@language":"sv","@value":"Term som används för att beskriva personer som är både neurodivergenta och trans eller för personer vars neurodivergens påverkar och ej kan frånkopplas från deras upplevelse och identitet som transpersoner. Används endast för neurodivergenta personer som själva identifierar sig som neurotrans."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0003824"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0002662"},{"@id":"https://homosaurus.org/v5/homoit0002671"},{"@id":"https://homosaurus.org/v5/homoit0003825"},{"@id":"https://homosaurus.org/v5/homoit0004337"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2026-02-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002675","dc:identifier":"homoit0002675","skos:prefLabel":[{"@language":"en","@value":"Asexual autistic people"},{"@language":"es","@value":"Personas autistas asexuales"},{"@language":"de","@value":"Asexuelle autistische Personen"},{"@language":"nl","@value":"Aseksuele autistische personen"},{"@language":"sv","@value":"Asexuella personer med autism"}],"skos:altLabel":[{"@language":"en","@value":"Asexual people with autism"},{"@language":"en","@value":"Autistic asexual people"},{"@language":"es","@value":"Personas asexuales con autismo"},{"@language":"es","@value":"Autistas asexuales"},{"@language":"de","@value":"Ace autistische Personen"},{"@language":"de","@value":"Autistische ace Personen"},{"@language":"nl","@value":"Autistische aseksuele personen"}],"rdfs:comment":[{"@language":"en","@value":"Asexual people who are autistic."},{"@language":"es","@value":"Personas asexuales que son autistas."},{"@language":"de","@value":"Asexuelle Personen, die autistisch sind."},{"@language":"nl","@value":"Aseksuele personen die autistisch zijn"},{"@language":"sv","@value":"Asexuella personer som är autistiska."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0002667"},{"@id":"https://homosaurus.org/v5/homoit0002664"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-26"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002674","dc:identifier":"homoit0002674","skos:prefLabel":[{"@language":"en","@value":"Intersex autistic people"},{"@language":"es","@value":"Personas intersexuales autistas"},{"@language":"nl","@value":"Intersekse autistische personen"},{"@language":"sv","@value":"Intersexpersoner med autism"}],"skos:altLabel":[{"@language":"en","@value":"Autistic intersex people"},{"@language":"en","@value":"Intersex people with autism"},{"@language":"es","@value":"Personas autistas intersex"},{"@language":"es","@value":"Personas intersex con autismo"},{"@language":"es","@value":"Personas intersex autistas"},{"@language":"nl","@value":"Intersekse personen met autisme"},{"@language":"sv","@value":"Intersexautister"}],"rdfs:comment":[{"@language":"en","@value":"Intersex people who are autistic."},{"@language":"es","@value":"Personas intersex que son autistas."},{"@language":"nl","@value":"Intersekse personen die autistisch zijn."},{"@language":"sv","@value":"Intersexpersoner som är autistiska."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0002665"},{"@id":"https://homosaurus.org/v5/homoit0002667"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-26"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002676","dc:identifier":"homo