nguage":"nl","@value":"Zwangere personen"},{"@language":"sv","@value":"Gravida personer"}],"rdfs:comment":[{"@language":"en","@value":"People who are pregnant, meaning that a fertilized egg is developing in their uterus."},{"@language":"es","@value":"Personas que están embarazadas, lo que significa que un óvulo fecundado se está desarrollando en su útero."},{"@language":"nl","@value":"Personen die zwanger zijn, wat betekent dat er zich een bevruchte eicel in hun baarmoeder ontwikkelt."},{"@language":"sv","@value":"Personer som är gravida, det vill säga som bär ett befruktat ägg i livmodern."}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0003223"},{"@id":"https://homosaurus.org/v5/homoit0003224"},{"@id":"https://homosaurus.org/v5/homoit0003225"},{"@id":"https://homosaurus.org/v5/homoit0003226"},{"@id":"https://homosaurus.org/v5/homoit0003227"},{"@id":"https://homosaurus.org/v5/homoit0003230"},{"@id":"https://homosaurus.org/v5/homoit0003231"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0003364"},"dc:issued":{"@type":"xsd:date","@value":"2024-06-19"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003233","dc:identifier":"homoit0003233","skos:prefLabel":[{"@language":"en","@value":"Palestinian gay men"},{"@language":"es","@value":"Hombres gay palestinos"},{"@language":"nl","@value":"Palestijnse homomannen"},{"@language":"sv","@value":"Palestinska bögar"}],"skos:altLabel":[{"@language":"en","@value":"Gay Palestinians"},{"@language":"es","@value":"Palestinos gay"},{"@language":"nl","@value":"Homo-Palestijnen"}],"rdfs:comment":[{"@language":"en","@value":"Gay men who were born in, reside in, and/or are descended from those indigenous to the country of Palestine."},{"@language":"es","@value":"Hombres gay que nacieron, residen y/o descienden de los pueblos indígenas del país de Palestin