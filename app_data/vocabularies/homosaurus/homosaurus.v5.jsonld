.0"},{"@id":"https://homosaurus.org/v5/homoit0003851","dc:identifier":"homoit0003851","skos:prefLabel":[{"@language":"en","@value":"Dehumanization (Erotic)"},{"@language":"nl","@value":"Dehumanisering (Erotisch)"},{"@language":"sv","@value":"Avhumanisering (erotik)"}],"rdfs:comment":[{"@language":"en","@value":"Acts or practices in which one person behaves or is treated as an object (e.g., a table) for erotic enjoyment, sometimes as a form of humiliation."},{"@language":"nl","@value":"Handelingen of praktijken waarbij één persoon zich gedraagt ​​of wordt behandeld als een object (bijvoorbeeld een tafel) voor erotisch genot, soms als een vorm van vernedering."},{"@language":"sv","@value":"Handlingar eller praktiker där en person beter sig som eller behandlas som ett objekt (t.ex. ett bord) för erotisk njutning, ibland som en form av förnedring."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000442"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0003052"},{"@id":"https://homosaurus.org/v5/homoit0003082"},{"@id":"https://homosaurus.org/v5/homoit0003126"},{"@id":"https://homosaurus.org/v5/homoit0003070"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000404"},"dc:issued":{"@type":"xsd:date","@value":"2025-01-09"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000609","dc:identifier":"homoit0000609","skos:prefLabel":[{"@language":"en","@value":"Handkerchief codes"},{"@language":"de","@value":"Hanky Code"},{"@language":"es","@value":"Códigos de pañuelos"},{"@language":"nl","@value":"Zakdoek codes"},{"@language":"sv","@value":"Hanky codes"}],"skos:altLabel":[{"@language":"en","@value":"Hanky codes"},{"@language":"de","@value":"Handkerchief code"},{"@language":"de","@value":"Taschentuch-Code"},{"@language":"es","@value":"Hanky code"},{"@language":"es","@value":"Código del pañuelo"}],"rdfs:comment":[{"@language":"en","@value":"A color-coded system to indicate preferred sexual fetishes and identify whether a person is a top/dominant or bottom/submissive."},{"@language":"de","@value":"Tücher in diversen Farben, die von queeren Personen, in den meisten Fällen von schwulen Männern, getragen werden können, um bevorzugte sexuelle Vorlieben zu äußern und festzustellen, ob eine Person zum Beispiel top/dominant oder bottom/passiv ist."},{"@language":"es","@value":"Un sistema codificado por colores para indicar fetiches sexuales preferidos e identificar si una persona es activa/dominante o pasiva/sumisa."},{"@language":"sv","@value":"Ett färgkodat system för att visa sexuella preferenser och ange om en person är topp/dominant eller bottom/undergiven."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000954"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000442"},{"@id":"https://homosaurus.org/v5/homoit0001267"},{"@id":"https://homosaurus.org/v5/homoit0001299"},{"@id":"https://homosaurus.org/v5/homoit0001304"},{"@id":"https://homosaurus.org/v5/homoit0002192"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh00003702"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000954"},"dc:replaces":{"@id":"http://homosaurus.org/v2/handkerchiefCodes"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003082","dc:identifier":"homoit0003082","skos:prefLabel":[{"@language":"en","@value":"Animal roleplay"},{"@language":"de","@value":"Petplay"},{"@language":"nl","@value":"Dierenrollenspel"},{"@language":"sv","@value":"Animal roleplay"}],"skos:altLabel":[{"@language":"en","@value":"Pet play"},{"@language":"de","@value":"Animal Roleplay"},{"@language":"de","@value":"Pet Play"},{"@language":"sv","@value":"Petplay"},{"@language":"sv","@value":"Djurrollspel"}],"rdfs:comment":[{"@language":"en","@value":"The act of roleplaying as an animal or animal character, sometimes with someone acting as a trainer, handler or pet owner, for fun or erotic enjoyment."},{"@language":"de","@value":"Rollenspiel, bei dem eine Person die Rolle eines Tieres oder Tiercharakters übernimmt, manchmal mit jemandem in der Rolle eines:einer Trainer:in, Betreuer:in oder Tierhalter:in – zum Spass oder zur erotischen Unterhaltung."},{"@language":"nl","@value":"Het rollenspel van een dier of dierlijk personage, soms met iemand die optreedt als trainer, baas of huisdierbezitter, voor het plezier of erotisch genot."},{"@language":"sv","@value":"Att rollspela som ett djur eller en djurkaraktär, ibland tillsammans med någon som agerar tränare, skötare eller ägare, för nöjes skull eller för erotisk njutning."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001242"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0003081"},{"@id":"https://homosaurus.org/v5/homoit0003083"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000442"},{"@id":"https://homosaurus.org/v5/homoit0002165"},{"@id":"https://homosaurus.org/v5/homoit0003123"},{"@id":"https://homosaurus.org/v5/homoit0003851"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001267"},"dc:issued":{"@type":"xsd:date","@value":"2023-12-18"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003140","dc:identifier":"homoit0003140","skos:prefLabel":[{"@language":"en","@value":"Anti-kink discrimination"},{"@language":"es","@value":"Discriminación anti-kink"},{"@language":"de","@value":"Diskriminierung von Personen mit Kinks"},{"@language":"nl","@value":"Anti-kink discriminatie"},{"@language":"sv","@value":"Antikinkdiskriminering"}],"skos:altLabel":{"@language":"de","@value":"Anti-Kink Diskriminierung"},"rdfs:comment":[{"@language":"en","@value":"The unjust or prejudicial treatment of individuals or communities due to their kinks and/or kinky sexual practices; may include adverse legal judgment and/or the denial of legal rights, employment, and housing."},{"@language":"es","@value":"El trato injusto o perjudicial hacia personas o comunidades debido a sus kinks y/o prácticas sexuales kinky; puede incluir sentencias legales adversas y/o la denegación de derechos legales de empleo y vivienda."},{"@language":"de","@value":"Die ungerechte oder vorurteilsbehaftete Behandlung von Einzelpersonen oder Gemeinschaften aufgrund ihrer Kinks und/oder kinky Sexualpraktiken; kann eine nachteilige gerichtliche Verurteilung und/oder die Verweigerung von Rechtsansprüchen, Beschäftigung und Wohnraum beinhalten."},{"@language":"nl","@value":"De onrechtvaardige of vooroordelende behandeling van individuen of gemeenschappen vanwege hun kinks en/of kinky seksuele praktijken; dit kan een negatief juridisch oordeel en/of de ontkenning van wettelijke rechten, werkgelegenheid en huisvesting omvatten. ​"},{"@language":"sv","@value":"Systematiskt orättvis eller fördomsfull behandling av individer eller gemenskaper på grund av deras kinks eller sexuella praktiker kopplat till kink, vilket kan ta sig uttryck i begränsad tillgång till arbete, bostad eller rättsligt erkännande."}],"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0003141"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000442"},{"@id":"https://homosaurus.org/v5/homoit0000705"},{"@id":"https://homosaurus.org/v5/homoit0003084"},{"@id":"https://homosaurus.org/v5/homoit0003691"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0003140"},"dc:issued":{"@type":"xsd:date","@value":"2023-12-20"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000493","dc:identifier":"homoit0000493","skos:prefLabel":[{"@language":"en","@value":"Gay fiction"},{"@language":"es","@value":"Ficción gay"},{"@language":"de","@value":"Schwule Fiction"},{"@language":"nl","@value":"Homofictie"},{"@language":"sv","@value":"Gay skönlitteratur"}],"skos:altLabel":[{"@language":"sv","@value":"Skönlitteratur med bögkaraktärer och/eller tema"},{"@language":"sv","@value":"Homosexuell manlig litteratur"}],"rdfs:comment":[{"@language":"en","@value":"Genre of written works that depicts imagined events or people. Use for fiction focusing on gay characters or themes."},{"@language":"es","@value":"Obras escritas que describen eventos o personas imaginadas; utilícese en referencia a obras de ficción que se centran en personajes o temas gay."},{"@language":"de","@value":"Werke, in denen imaginäre Ereignisse oder Personen beschrieben werden; Verwendung in Bezug auf fiktionale Werke, die sich auf schwule Charaktere oder Themen konzentrieren."},{"@language":"nl","@value":"Geschreven werken die ingebeelde gebeurtenissen of mensen beschrijven; gebruiken met betrekking tot fictieve werken die zich richten op homopersonages of thema's."},{"@language":"sv","@value":"Litterära verk som beskriver fiktiva händelser eller personer. Används för skönlitteratur med bögar som karaktärer eller teman."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000443"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0004300"},{"@id":"https://homosaurus.org/v5/homoit0001582"},{"@id":"https://homosaurus.org/v5/homoit0001566"},{"@id":"https://homosaurus.org/v5/homoit0001571"},{"@id":"https://homosaurus.org/v5/homoit0001593"},{"@id":"https://homosaurus.org/v5/homoit0001576"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001725"},{"@id":"https://homosaurus.org/v5/homoit0001752"},{"@id":"https://homosaurus.org/v5/homoit0001753"},{"@id":"https://homosaurus.org/v5/homoit0001754"},{"@id":"https://homosaurus.org/v5/homoit0002170"},{"@id":"https://homosaurus.org/v5/homoit0002217"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2008105062"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/gayFiction"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000742","dc:identifier":"homoit0000742","skos:prefLabel":[{"@language":"en","@value":"Lesbian fiction"},{"@language":"es","@value":"Ficción lésbica"},{"@language":"nl","@value":"Lesbische fictie"},{"@language":"sv","@value":"Lesbisk skönlitteratur"}],"skos:altLabel":[{"@language":"sv","@value":"Flatböcker"},{"@language":"sv","@value":"Flatlitteratur"}],"rdfs:comment":[{"@language":"en","@value":"Genre of written works that depicts imagined events or people. Use for fiction focusing on lesbian characters or themes."},{"@language":"es","@value":"Obras escritas que describen eventos o personas imaginadas; utilícese en referencia a obras de ficción que se centran en personajes o temas lésbicos."},{"@language":"nl","@value":"Geschreven werken die ingebeelde gebeurtenissen of mensen beschrijven; gebruiken met betrekking tot fictieve werken die zich richten op lesbische personages of thema's."},{"@language":"sv","@value":"Litterära verk som beskriver fiktiva händelser eller personer. Används för skönlitteratur med lesbiska karaktärer eller teman."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000443"},{"@id":"https://homosaurus.org/v5/homoit0002162"}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0004302"},{"@id":"https://homosaurus.org/v5/homoit0001581"},{"@id":"https://homosaurus.org/v5/homoit0001565"},{"@id":"https://homosaurus.org/v5/homoit0001570"},{"@id":"https://homosaurus.org/v5/homoit0001592"},{"@id":"https://homosaurus.org/v5/homoit0001575"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001724"},{"@id":"https://homosaurus.org/v5/homoit0002178"},{"@id":"https://homosaurus.org/v5/homoit0002220"},{"@id":"https://homosaurus.org/v5/homoit0003507"},{"@id":"https://homosaurus.org/v5/homoit0003508"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2008106911"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lesbianFiction"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000841","dc:identifier":"homoit0000841","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ comics"},{"@language":"es","@value":"Cómics LGBTQ+"},{"@language":"ja","@value":"LGBTQ+のコミック"},{"@language":"nl","@value":"LHBTQ+-stripverhalen"},{"@language":"sv","@value":"Tecknade serier (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"Comics (LGBTQ)"},{"@language":"es","@value":"Cómics (LGBTQ)"},{"@language":"es","@value":"Historietas LGBTQ+"},{"@language":"es","@value":"Historietas LGBTQ"},{"@language":"ja","@value":"コミックス(LGBTQ)"},{"@language":"ja","@value":"漫画 (LGBTQ)"}],"rdfs:comment":[{"@language":"en","@value":"Works consisting of sequential images often accompanied by text; use in reference to comics focusing on LGBTQ+ characters or themes."},{"@language":"es","@value":"Obras que consisten en imágenes secuenciales, a menudo acompañadas de texto; utilícese en referencia a cómics centrados en personajes o temas LGBTQ+."},{"@language":"ja","@value":"連続した画像で構成され、しばしばテキストが添えられる作品。LGBTQ+の登場人物やテーマを扱った漫画を指す場合に用いられる。"},{"@language":"nl","@value":"Publicaties bestaande uit opeenvolgende afbeeldingen, vaak vergezeld van tekst; gebruikt met betrekking tot strips die zich richten op LGBTQ+-personages of thema's"},{"@language":"sv","@value":"Verk som består av bilder i följd, ofta tillsammans med text. Används för serier med hbtq+-karaktärer eller teman."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000443"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000828"},{"@id":"https://homosaurus.org/v5/homoit0000874"},{"@id":"https://homosaurus.org/v5/homoit0000897"},{"@id":"https://homosaurus.org/v5/homoit0001587"},{"@id":"https://homosaurus.org/v5/homoit0001588"},{"@id":"https://homosaurus.org/v5/homoit0001589"},{"@id":"https://homosaurus.org/v5/homoit0001590"},{"@id":"https://homosaurus.org/v5/homoit0001591"},{"@id":"https://homosaurus.org/v5/homoit0002400"},{"@id":"https://homosaurus.org/v5/homoit0002402"},{"@id":"https://homosaurus.org/v5/homoit0002404"},{"@id":"https://homosaurus.org/v5/homoit0002406"},{"@id":"https://homosaurus.org/v5/homoit0002503"},{"@id":"https://homosaurus.org/v5/homoit0002524"},{"@id":"https://homosaurus.org/v5/homoit0002575"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0002631"},{"@id":"https://homosaurus.org/v5/homoit0002643"},{"@id":"https://homosaurus.org/v5/homoit0003660"},{"@id":"https://homosaurus.org/v5/homoit0003661"},{"@id":"https://homosaurus.org/v5/homoit0003881"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/comicsLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000852","dc:identifier":"homoit0000852","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ mystery and detective fiction"},{"@language":"es","@value":"Ficción LGBTQ+ de misterio y de detectives"},{"@language":"nl","@value":"LHBTQ+-detectiveverhalen"},{"@language":"sv","@value":"Hbtq+-deckare"}],"skos:altLabel":[{"@language":"en","@value":"Mystery and detective fiction (LGBTQ)"},{"@language":"sv","@value":"Deckare (hbtq+)"}],"rdfs:comment":[{"@language":"en","@value":"Genre of written works that depicts the investigation of crime or the work of detectives. Use for mystery and detective fiction focusing on LGBTQ+ characters or themes."},{"@language":"es","@value":"Obras literarias escritas sobre la investigación de crímenes o el trabajo de detectives; utilícese en referencia a la ficción de misterio y de detectives centrada en personajes y temas LGBTQ+."},{"@language":"nl","@value":"Geschreven literaire werken over misdaadonderzoek of het werk van rechercheurs; gebruik in verwijzing naar mysterie en detective fictie gericht op LHBTQ+-personages en thema's."},{"@language":"sv","@value":"Skönlitterära verk om brottsutredningar eller detektivarbete. Används för deckare och mysterielitteratur med hbtq+-karaktärer eller teman."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000443"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0001575"},{"@id":"https://homosaurus.org/v5/homoit0001576"},{"@id":"https://homosaurus.org/v5/homoit0001577"},{"@id":"https://homosaurus.org/v5/homoit0001578"},{"@id":"https://homosaurus.org/v5/homoit0001579"},{"@id":"https://homosaurus.org/v5/homoit0002429"},{"@id":"https://homosaurus.org/v5/homoit0002430"},{"@id":"https://homosaurus.org/v5/homoit0002431"},{"@id":"https://homosaurus.org/v5/homoit0002432"},{"@id":"https://homosaurus.org/v5/homoit0002497"},{"@id":"https://homosaurus.org/v5/homoit0002518"},{"@id":"https://homosaurus.org/v5/homoit0002567"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0002640"},{"@id":"https://homosaurus.org/v5/homoit0002650"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/mysteryAndDetectiveFictionLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000865","dc:identifier":"homoit0000865","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ fantasy fiction"},{"@language":"es","@value":"Ficción fantástica LGBTQ+"},{"@language":"ja","@value":"LGBTQ+ のファンタジー小説"},{"@language":"nl","@value":"LHBTQ+-fantasy"},{"@language":"sv","@value":"Hbtq+-fantasy"}],"skos:altLabel":[{"@language":"en","@value":"Fantasy fiction (LGBTQ)"},{"@language":"en","@value":"ファンタジー小説 (LGBTQ)"},{"@language":"sv","@value":"Fantasy (hbtq+)"}],"rdfs:comment":[{"@language":"en","@value":"Genre of written works that depicts magical, fantastical, and/or supernatural elements. Use for fantasy fiction focusing on LGBTQ+ characters or themes."},{"@language":"es","@value":"Género que utiliza la magia y otros fenómenos sobrenaturales como elemento principal de la trama, el tema y/o el escenario; utilícese para ficción fantástica que se centre en personajes o temas LGBTQ+."},{"@language":"ja","@value":"プロット、テーマ、舞台設定の主要な要素として魔法やその他の超自然現象を用いるジャンル。LGBTQ+の登場人物やテーマに焦点を当てたファンタジー小説を指す。"},{"@language":"nl","@value":"Genre dat magie en andere bovennatuurlijke verschijnselen gebruikt als primair element van plot, thema en/of setting; gebruik om te verwijzen naar fantasy gericht op LHBTQ+-personages of thema's."},{"@language":"sv","@value":"Genre som använder magi och andra övernaturliga fenomen som centrala inslag i handling, tema och/eller miljö. Används för fantasy med hbtq+-karaktärer eller teman."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000443"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0001565"},{"@id":"https://homosaurus.org/v5/homoit0001566"},{"@id":"https://homosaurus.org/v5/homoit0001567"},{"@id":"https://homosaurus.org/v5/homoit0001568"},{"@id":"https://homosaurus.org/v5/homoit0001569"},{"@id":"https://homosaurus.org/v5/homoit0002417"},{"@id":"https://homosaurus.org/v5/homoit0002418"},{"@id":"https://homosaurus.org/v5/homoit0002419"},{"@id":"https://homosaurus.org/v5/homoit0002420"},{"@id":"https://homosaurus.org/v5/homoit0002495"},{"@id":"https://homosaurus.org/v5/homoit0002516"},{"@id":"https://homosaurus.org/v5/homoit0002571"},{"@id":"https://homosaurus.org/v5/homoit0003179"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0002636"},{"@id":"https://homosaurus.org/v5/homoit0002646"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/fantasyFictionLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000874","dc:identifier":"homoit0000874","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ graphic novels"},{"@language":"es","@value":"Novelas gráficas LGBTQ+"},{"@language":"nl","@value":"LHBTQ+-beeldverhalen"},{"@language":"sv","@value":"Hbtq+-serieromaner"}],"skos:altLabel":[{"@language":"en","@value":"LGBTQ graphic novels"},{"@language":"es","@value":"Novelas gráficas (LGBTQ)"},{"@language":"sv","@value":"Serieromaner (hbtq+)"}],"rdfs:comment":[{"@language":"en","@value":"Works consisting of sequential images often accompanied by text that generally contain stand-alone stories; used in reference to graphic novels focusing on LGBTQ+ characters or themes."},{"@language":"es","@value":"Obras que consisten en imágenes secuenciales, a menudo acompañadas de texto, que generalmente contienen historias independientes; utilizado en referencia a novelas gráficas que se centran en personajes o temas LGBTQ+."},{"@language":"nl","@value":"Werken bestaande uit opeenvolgende afbeeldingen, vaak vergezeld van tekst die over het algemeen op zichzelf staande verhalen bevatten; gebruikt in verwijzing naar beeldverhalen die zich richten op LHBTQ+-personages of -thema's."},{"@language":"sv","@value":"Verk bestående av sekventiella bilder, ofta tillsammans med text, som vanligtvis innehåller fristående berättelser. Används för grafiska romaner som fokuserar på hbtq+-karaktärer eller teman."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000443"},{"@id":"https://homosaurus.org/v5/homoit0000841"}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0002421"},{"@id":"https://homosaurus.org/v5/homoit0002422"},{"@id":"https://homosaurus.org/v5/homoit0002423"},{"@id":"https://homosaurus.org/v5/homoit0002424"},{"@id":"https://homosaurus.org/v5/homoit0002569"},{"@id":"https://homosaurus.org/v5/homoit0003427"},{"@id":"https://homosaurus.org/v5/homoit0003428"},{"@id":"https://homosaurus.org/v5/homoit0003429"},{"@id":"https://homosaurus.org/v5/homoit0003430"},{"@id":"https://homosaurus.org/v5/homoit0003431"},{"@id":"https://homosaurus.org/v5/homoit0003432"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0002638"},{"@id":"https://homosaurus.org/v5/homoit0002648"},{"@id":"https://homosaurus.org/v5/homoit0003881"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQGraphicNovels"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000934","dc:identifier":"homoit0000934","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ science fiction"},{"@language":"es","@value":"Ciencia ficción LGBTQ+"},{"@language":"de","@value":"LGBTQ+-Science-Fiction"},{"@language":"nl","@value":"LHBTQ+-science fiction"},{"@language":"sv","@value":"Science fiction (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"Science fiction (LGBTQ)"},{"@language":"es","@value":"Ciencia ficción (LGBTQ)"},{"@language":"sv","@value":"Sci fi (hbtq+)"},{"@language":"sv","@value":"Sf (hbtq+)"}],"rdfs:comment":[{"@language":"en","@value":"Genre of written works that depicts imaginative or futuristic concepts incorporating science, technology, space, time travel, and other speculative elements. Use for science fiction focusing on LGBTQ+ characters or themes."},{"@language":"es","@value":"Obras literarias escritas sobre conceptos imaginativos o futuristas que incorporen la ciencia, la tecnología, el espacio, los viajes en el tiempo y otros elementos especulativos; utilícese en referencia a la ciencia ficción centrada en personajes o temas LGBTQ+."},{"@language":"de","@value":"Werk über phantasievolle oder futuristische Konzepte, die Wissenschaft, Technologie, Raumfahrt, Zeitreisen und andere spekulative Elemente beinhalten; Verwendung in Bezug auf Science Fiction mit einem Schwerpunkt auf LGBTQ+-Charakteren oder Themen."},{"@language":"nl","@value":"Geschreven literair werk over fantasierijke of futuristische concepten waarin wetenschap, technologie, ruimte, tijdreizen en andere speculatieve elementen zijn verwerkt; gebruik in verwijzing naar science fiction gericht op LHBTQ+-personages of thema's."},{"@language":"sv","@value":"Skönlitterära verk om imaginära eller futuristiska koncept som involverar vetenskap, teknologi, rymden, tidsresor och andra spekulativa element. Används för science fiction med hbtq+-karaktärer eller teman."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000443"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0001570"},{"@id":"https://homosaurus.org/v5/homoit0001571"},{"@id":"https://homosaurus.org/v5/homoit0001572"},{"@id":"https://homosaurus.org/v5/homoit0001573"},{"@id":"https://homosaurus.org/v5/homoit0001574"},{"@id":"https://homosaurus.org/v5/homoit0002437"},{"@id":"https://homosaurus.org/v5/homoit0002438"},{"@id":"https://homosaurus.org/v5/homoit0002439"},{"@id":"https://homosaurus.org/v5/homoit0002440"},{"@id":"https://homosaurus.org/v5/homoit0002499"},{"@id":"https://homosaurus.org/v5/homoit0002520"},{"@id":"https://homosaurus.org/v5/homoit0002570"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0002177"},{"@id":"https://homosaurus.org/v5/homoit0002637"},{"@id":"https://homosaurus.org/v5/homoit0002647"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/scienceFictionLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001177","dc:identifier":"homoit0001177","skos:prefLabel":[{"@language":"en","@value":"Queer fiction"},{"@language":"es","@value":"Ficción queer"},{"@language":"nl","@value":"Queer fictie"},{"@language":"sv","@value":"Queer skönlitteratur"}],"rdfs:comment":[{"@language":"en","@value":"Genre of written works that depicts imagined events or people. Use for fiction focusing on queer characters or themes."},{"@language":"es","@value":"Obras escritas que describen eventos o personas imaginadas; utilícese en referencia a obras de ficción que se centran en personajes o temas queer."},{"@language":"nl","@value":"Geschreven werken die ingebeelde gebeurtenissen of mensen beschrijven; gebruiken met betrekking tot fictieve werken die zich richten op queer personages of thema's."},{"@language":"sv","@value":"Litterära verk som beskriver fiktiva händelser eller personer. Används för skönlitteratur med queera karaktärer eller teman."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000443"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0004304"},{"@id":"https://homosaurus.org/v5/homoit0001585"},{"@id":"https://homosaurus.org/v5/homoit0001596"},{"@id":"https://homosaurus.org/v5/homoit0001569"},{"@id":"https://homosaurus.org/v5/homoit0001574"},{"@id":"https://homosaurus.org/v5/homoit0001579"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001728"},{"@id":"https://homosaurus.org/v5/homoit0001752"},{"@id":"https://homosaurus.org/v5/homoit0001753"},{"@id":"https://homosaurus.org/v5/homoit0001754"},{"@id":"https://homosaurus.org/v5/homoit0002193"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerFiction"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001414","dc:identifier":"homoit0001414","skos:prefLabel":[{"@language":"en","@value":"Transgender fiction"},{"@language":"es","@value":"Ficción transgénero"},{"@language":"nl","@value":"Transgender fictie"},{"@language":"sv","@value":"Skönlitteratur om transpersoner och -teman"}],"skos:altLabel":{"@language":"en","@value":"Trans fiction"},"rdfs:comment":[{"@language":"en","@value":"Genre of written works that depicts imagined events or people. Use for fiction focusing on transgender characters or themes."},{"@language":"es","@value":"Obras escritas que describen eventos o personas imaginadas; utilícese en referencia a obras de ficción que se centran en personajes o temas transgénero."},{"@language":"nl","@value":"Geschreven werken die ingebeelde gebeurtenissen of mensen beschrijven; gebruiken met betrekking tot fictieve werken die zich richten op transgender personages of thema's."},{"@language":"sv","@value":"Litterära verk som beskriver fiktiva händelser eller personer. Används för skönlitteratur med transkaraktärer eller har transfokuserade teman."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000443"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0004305"},{"@id":"https://homosaurus.org/v5/homoit0001584"},{"@id":"https://homosaurus.org/v5/homoit0001568"},{"@id":"https://homosaurus.org/v5/homoit0001573"},{"@id":"https://homosaurus.org/v5/homoit0001595"},{"@id":"https://homosaurus.org/v5/homoit0001578"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001727"},{"@id":"https://homosaurus.org/v5/homoit0001752"},{"@id":"https://homosaurus.org/v5/homoit0001753"},{"@id":"https://homosaurus.org/v5/homoit0001754"},{"@id":"https://homosaurus.org/v5/homoit0002210"},{"@id":"https://homosaurus.org/v5/homoit0002211"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transgenderFiction"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001580","dc:identifier":"homoit0001580","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ horror fiction"},{"@language":"es","@value":"Ficción de horror LGBTQ+"},{"@language":"de","@value":"LGBTQ+-Horror-Fiction"},{"@language":"nl","@value":"LHBTQ+-horrorverhalen"},{"@language":"sv","@value":"Hbtq+-skräck"}],"skos:altLabel":[{"@language":"en","@value":"Horror fiction (LGBTQ)"},{"@language":"es","@value":"Ficción de horror (LGBTQ)"}],"rdfs:comment":[{"@language":"en","@value":"Genre of written works that intend to frighten, scare, or disgust. Use for horror fiction focusing on LGBTQ+ characters or themes."},{"@language":"es","@value":"Obras de ficción escritas con la intención de asustar, atemorizar o provocar disgusto; utilícese en referencia a la ficción de horror centrada en personajes o temas LGBTQ+."},{"@language":"de","@value":"Fiktionale Werke, die erschrecken, ängstigen oder abstoßen sollen; Verwendung in Bezug auf fiktionale Werke, die sich auf LGBTQ+-Charaktere oder Themen konzentrieren."},{"@language":"nl","@value":"Geschreven fictie bedoeld om angst aan te jagen, bang te maken of te walgen; gebruik in verwijzing naar horrorfictie gericht op LHBTQ+-personages of thema's."},{"@language":"sv","@value":"Skönlitterära verk skrivna för att skrämma, oroa eller äckla. Används för skräcklitteratur med hbtq+-karaktärer eller teman."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000443"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0001581"},{"@id":"https://homosaurus.org/v5/homoit0001582"},{"@id":"https://homosaurus.org/v5/homoit0001583"},{"@id":"https://homosaurus.org/v5/homoit0001584"},{"@id":"https://homosaurus.org/v5/homoit0001585"},{"@id":"https://homosaurus.org/v5/homoit0002426"},{"@id":"https://homosaurus.org/v5/homoit0002427"},{"@id":"https://homosaurus.org/v5/homoit0002428"},{"@id":"https://homosaurus.org/v5/homoit0002473"},{"@id":"https://homosaurus.org/v5/homoit0002496"},{"@id":"https://homosaurus.org/v5/homoit0002517"},{"@id":"https://homosaurus.org/v5/homoit0002568"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0002639"},{"@id":"https://homosaurus.org/v5/homoit0002649"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/horrorFictionLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-03"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001586","dc:identifier":"homoit0001586","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ romance fiction"},{"@language":"es","@value":"Ficción romántica LGBTQ+"},{"@language":"de","@value":"LGBTQ+-Liebesromane"},{"@language":"nl","@value":"LHBTQ+-liefdesverhalen"},{"@language":"sv","@value":"Kärleksromaner (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"Romance fiction (LGBTQ)"},{"@language":"es","@value":"Ficción romántica (LGBTQ)"},{"@language":"sv","@value":"Kärleksskildringar (hbtq+)"},{"@language":"sv","@value":"Romance (hbtq+)"}],"rdfs:comment":[{"@language":"en","@value":"Genre of written works that depicts romantic and/or sexual relationships between the main characters. Use for romance fiction focusing on LGBTQ+ characters or themes."},{"@language":"es","@value":"Obras de ficción que giran en torno a relaciones románticas y/o sexuales entre los personajes principales; utilícese en referencia a la ficción romántica centrada en personajes LGBTQ+."},{"@language":"de","@value":"Werke der Belletristik, die sich um romantische und/oder sexuelle Beziehungen zwischen den Hauptfiguren drehen; Verwendung in Bezug auf Liebesromane, die sich auf LGBTQ+-Figuren und Themen konzentrieren."},{"@language":"nl","@value":"Fictie die draait om romantische en/of seksuele relaties tussen de hoofdpersonen; gebruik in verwijzing naar romantische fictie gericht op LHBTQ+-personages."},{"@language":"sv","@value":"Skönlitterära verk som kretsar kring romantiska och/eller sexuella relationer mellan huvudkaraktärerna. Används för kärleksromaner med hbtq+-karaktärer."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000443"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0001592"},{"@id":"https://homosaurus.org/v5/homoit0001593"},{"@id":"https://homosaurus.org/v5/homoit0001594"},{"@id":"https://homosaurus.org/v5/homoit0001595"},{"@id":"https://homosaurus.org/v5/homoit0001596"},{"@id":"https://homosaurus.org/v5/homoit0002433"},{"@id":"https://homosaurus.org/v5/homoit0002434"},{"@id":"https://homosaurus.org/v5/homoit0002435"},{"@id":"https://homosaurus.org/v5/homoit0002436"},{"@id":"https://homosaurus.org/v5/homoit0002498"},{"@id":"https://homosaurus.org/v5/homoit0002519"},{"@id":"https://homosaurus.org/v5/homoit0002566"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0002641"},{"@id":"https://homosaurus.org/v5/homoit0002651"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/romanceFictionLGBTQ"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-03"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001608","dc:identifier":"homoit0001608","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ short stories"},{"@language":"es","@value":"Cuentos cortos LGBTQ+"},{"@language":"nl","@value":"LHBTQ+-korte verhalen"},{"@language":"sv","@value":"Noveller (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"Short stories (LGBTQ)"},{"@language":"es","@value":"Cuentos cortos (LGBTQ)"},{"@language":"es","@value":"Relatos LGBTQ+"},{"@language":"es","@value":"Relatos (LGBTQ)"}],"rdfs:comment":[{"@language":"en","@value":"Written literary works that are short in length and detail a self-contained incident or concept; use in reference to short stories focusing on LGBTQ+ characters or themes."},{"@language":"es","@value":"Obras literarias escritas que son breves y detallan un incidente o concepto autónomo; utilícese en referencia a cuentos cortos que se centren en personajes o temas LGBTQ+."},{"@language":"nl","@value":"Geschreven literaire werken die kort van lengte zijn en een op zichzelf staand incident of concept detailleren; gebruiken in verwijzing naar korte verhalen die zich richten op LHBTQ+-personages of thema's."},{"@language":"sv","@value":"Skönlitterära verk som är korta till formatet och skildrar en avslutad händelse eller idé. Används för noveller med fokus på hbtq+-karaktärer eller teman."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000443"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0001609"},{"@id":"https://homosaurus.org/v5/homoit0001610"},{"@id":"https://homosaurus.org/v5/homoit0001611"},{"@id":"https://homosaurus.org/v5/homoit0001612"},{"@id":"https://homosaurus.org/v5/homoit0001613"},{"@id":"https://homosaurus.org/v5/homoit0002441"},{"@id":"https://homosaurus.org/v5/homoit0002442"},{"@id":"https://homosaurus.org/v5/homoit0002443"},{"@id":"https://homosaurus.org/v5/homoit0002444"},{"@id":"https://homosaurus.org/v5/homoit0002500"},{"@id":"https://