":{"@language":"es","@value":"Universitarios transgénero"},"rdfs:comment":[{"@language":"en","@value":"Transgender people who are attending college."},{"@language":"es","@value":"Personas transgénero que asisten a la universidad."},{"@language":"nl","@value":"Transgender personen die naar de universiteit gaan."},{"@language":"sv","@value":"Transpersoner som studerar vid college."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001378"},{"@id":"https://homosaurus.org/v5/homoit0003041"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0003032"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-12-05"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003226","dc:identifier":"homoit0003226","skos:prefLabel":[{"@language":"en","@value":"Pregnant transgender people"},{"@language":"es","@value":"Personas transgénero embarazadas"},{"@language":"nl","@value":"Zwangere transgender personen"},{"@language":"sv","@value":"Gravida transpersoner"}],"skos:altLabel":[{"@language":"en","@value":"Pregnant trans people"},{"@language":"es","@value":"Personas embarazadas transgénero"},{"@language":"es","@value":"Personas trans embarazadas"},{"@language":"es","@value":"Personas embarazadas trans"}],"rdfs:comment":[{"@language":"en","@value":"Pregnant people who are transgender."},{"@language":"es","@value":"Personas embarazadas que son transgénero."},{"@language":"nl","@value":"Zwangere personen die transgender zijn."},{"@language":"sv","@value":"Gravida personer som är transpersoner."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001378"},{"@id":"https://homosaurus.org/v5/homoit0003364"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2024-05-24"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001818","dc:identifier":"homoit0001818","skos:prefLabel":[{"@language":"en","@value":"Trans inclusivity"},{"@language":"es","@value":"Inclusión trans"},{"@language":"nl","@value":"Trans inclusiviteit"},{"@language":"sv","@value":"Transinkludering"}],"skos:altLabel":[{"@language":"en","@value":"Trans affirming"},{"@language":"en","@value":"Trans inclusion"},{"@language":"en","@value":"Trans inclusive"},{"@language":"en","@value":"Trans supportive"},{"@language":"en","@value":"Trans-inclusive"},{"@language":"nl","@value":"Trans inclusief"}],"rdfs:comment":[{"@language":"en","@value":"The practice or policy of providing equal access and support to trans people."},{"@language":"es","@value":"La práctica o política de brindar igualdad de acceso y apoyo a las personas trans."},{"@language":"nl","@value":"De praktijk of het beleid om transgender personen gelijke toegang en ondersteuning te bieden."},{"@language":"sv","@value":"Praktik eller policy som syftar till att ge transpersoner lika tillgång och stöd."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002291"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001378"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0002291"},"dc:issued":{"@type":"xsd:date","@value":"2022-02-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001883","dc:identifier":"homoit0001883","skos:prefLabel":[{"@language":"en","@value":"Transgender people with chronic illnesses"},{"@language":"es","@value":"Personas transgénero con enfermedades crónicas"},{"@language":"nl","@value":"Transgender personen met chronische ziekten"},{"@language":"sv","@value":"Transpersoner med kronisk sjukdom"}],"skos:altLabel":[{"@language":"en","@value":"Chronically ill transgender people"},{"@language":"es","@value":"Personas con enfermedades crónicas transgénero"},{"@language":"es","@value":"Enfermos crónicos transgénero"},{"@language":"es","@value":"Enfermas crónicas transgénero"},{"@language":"sv","@value":"Kroniskt sjuka transpersoner"}],"rdfs:comment":[{"@language":"en","@value":"Transgender people who have long-term health conditions that require continued medical attention and/or significantly impact or limit daily life; some but not all people with chronic illnesses consider themselves disabled."},{"@language":"es","@value":"Personas transgénero que tienen condiciones de salud a largo plazo que requieren atención médica continua y/o impactan o limitan significativamente la vida diaria; algunas, pero no todas, las personas con enfermedades crónicas se consideran discapacitadas."},{"@language":"nl","@value":"Transgender personen met langdurige gezondheidsproblemen die voortdurende medische aandacht vereisen en/of een significante impact hebben op het dagelijks leven of deze beperken; sommige, maar niet alle personen met chronische ziekten beschouwen zichzelf als gehandicapt"},{"@language":"sv","@value":"Transpersoner med långvariga hälsotillstånd som kräver kontinuerlig medicinsk behandling och/eller har en betydande påverkan på eller begränsar det dagliga livet. Vissa, men inte alla, personer med kroniska sjukdomar identifierar sig som personer med funktionsnedsättning."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001879"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001378"},{"@id":"https://homosaurus.org/v5/homoit0001858"},{"@id":"https://homosaurus.org/v5/homoit0001889"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-02-17"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002033","dc:identifier":"homoit0002033","skos:prefLabel":[{"@language":"en","@value":"Transgender people in the workplace"},{"@language":"es","@value":"Personas transgénero en el lugar de trabajo"},{"@language":"nl","@value":"Transgender personen op de werkvloer"},{"@language":"sv","@value":"Arbetslivsvillkor för transpersoner"}],"skos:altLabel":{"@language":"es","@value":"Personas trans en el lugar de trabajo"},"rdfs:comment":[{"@language":"en","@value":"The presence of transgender people in the workplace, including acceptance of and issues faced by transgender workers."},{"@language":"es","@value":"La presencia de personas transgénero en el lugar de trabajo, incluida la aceptación de los trabajadores transgénero y los problemas a los que se enfrentan."},{"@language":"nl","@value":"De aanwezigheid van transgender personen op de werkplek, inclusief acceptatie van en problemen waarmee transgender werknemers worden geconfronteerd"},{"@language":"sv","@value":"Transpersoners situation på arbetsplatsen, inklusive acceptans, bemötande och villkor i arbetslivet."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002029"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001378"},{"@id":"https://homosaurus.org/v5/homoit0001739"},{"@id":"https://homosaurus.org/v5/homoit0001745"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001717"},"dc:issued":{"@type":"xsd:date","@value":"2022-06-15"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002211","dc:identifier":"homoit0002211","skos:prefLabel":[{"@language":"en","@value":"Transgender people in fandom"},{"@language":"es","@value":"Personas transgénero en fandom"},{"@language":"nl","@value":"Transgender personen in fandom"},{"@language":"sv","@value":"Transpersoner inom fandom"}],"skos:altLabel":[{"@language":"en","@value":"Trans people in fandom"},{"@language":"es","@value":"Personas trans en fandom"}],"rdfs:comment":[{"@language":"en","@value":"The participation and inclusion of transgender people in fan communities."},{"@language":"es","@value":"La participación e inclusión de personas transgénero en las comunidades de fans."},{"@language":"nl","@value":"De participatie en inclusie van transgender personen in fan-gemeenschappen"},{"@language":"sv","@value":"Transpersoners deltagande och inkludering i fangemenskaper."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0002171"},{"@id":"https://homosaurus.org/v5/homoit0002181"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001378"},{"@id":"https://homosaurus.org/v5/homoit0001414"},{"@id":"https://homosaurus.org/v5/homoit0001727"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001380","dc:identifier":"homoit0001380","skos:prefLabel":[{"@language":"en","@value":"Transsexuality"},{"@language":"es","@value":"Transexualidad"},{"@language":"nl","@value":"Transseksualiteit"},{"@language":"sv","@value":"Transsexualitet"}],"skos:altLabel":[{"@language":"en","@value":"Transexuality"},{"@language":"es","@value":"Transsexualidad"}],"rdfs:comment":[{"@language":"en","@value":"Term used to describe the identity of people who transition from female to male or male to female. Generally refers to individuals who transition their physical bodies to align with their gender identities. Though this term was popular in the 20th century and is still in use today, it has been largely replaced by \"transgender identity\" and \"trans identity.\" Some but not all people regard this term as outdated and offensive. Only use to describe people who self-identify as transsexual."},{"@language":"es","@value":"Término utilizado para describir la identidad de las personas que hacen la transición de mujer a hombre o de hombre a mujer. Generalmente se refiere a personas que hacen la transición de sus cuerpos físicos para alinearse con sus identidades de género. Aunque este término fue popular en el siglo XX y todavía se utiliza hoy en día, ha sido reemplazado en gran medida por \"identidad transgénero\" e \"identidad trans\". Algunas personas, pero no todas, consideran este término obsoleto y ofensivo. Utilícese únicamente para describir a personas que se identifiquen como transexuales."},{"@language":"nl","@value":"Term die wordt gebruikt om de identiteit te beschrijven van personen die overgaan van vrouw naar man of van man naar vrouw. Verwijst over het algemeen naar personen die hun fysieke lichaam veranderen om zich aan te passen aan hun genderidentiteit. Hoewel deze term populair was in de 20e eeuw en nog steeds in gebruik is, is hij grotendeels vervangen door 'transgenderidentiteit' en 'transidentiteit'. Sommige maar niet alle personen beschouwen deze term als achterhaald en beledigend. Alleen gebruiken om personen te beschrijven die zichzelf identificeren als transseksueel."},{"@language":"sv","@value":"Term som beskriver identiteten hos personer som genomgår transition från kvinna till man eller från man till kvinna. Termen används oftast för att beskriva individer som förändrar sin kropp fysiskt för att stämma överens med sin könsidentitet. Även om termen var vanlig under 1900-talet och fortfarande används, har den i stor utsträckning ersatts av transidentitet eller transperson. Vissa, men inte alla, uppfattar termen som föråldrad och stigmatiserande. Bör endast användas för personer som själva identifierar sig som transsexuella."}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001381"},{"@id":"https://homosaurus.org/v5/homoit0001468"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001380"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transsexuality"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004331","dc:identifier":"homoit0004331","skos:prefLabel":[{"@language":"en","@value":"Metadata for trans and gender diverse resources"},{"@language":"nl","@value":"Metadata voor trans en genderdiverse bronnen"},{"@language":"sv","@value":"Metadata för resurser om trans och könsdiversitet"}],"skos:altLabel":[{"@language":"en","@value":"Trans and gender diverse metadata"},{"@language":"en","@value":"Trans metadata"},{"@language":"en","@value":"Gender diverse metadata"},{"@language":"nl","@value":"Trans en genderdiverse metadata"},{"@language":"nl","@value":"Trans metadata"}],"rdfs:comment":[{"@language":"en","@value":"Works dealing with best practices and issues around cataloging and other descriptive metadata for resources by and/or about trans and gender diverse people, issues, or cultures, in repositories such as libraries, archives, and museums."},{"@language":"nl","@value":"Werken die zich bezighouden met best practices en vraagstukken rondom catalogisering en andere beschrijvende metadata voor bronnen van en/of over trans- en genderdiverse personen, thema's of culturen, in instellingen zoals bibliotheken, archieven en musea."},{"@language":"sv","@value":"Verk som behandlar praxis och frågor kring katalogisering och andra beskrivande metadata för resurser av och/eller om trans- och könsdiversa personer, frågor och kulturer, i samlingsförvaltande institutioner som bibliotek, arkiv och museum."}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001418"},{"@id":"https://homosaurus.org/v5/homoit0001389"},{"@id":"https://homosaurus.org/v5/homoit0001424"},{"@id":"https://homosaurus.org/v5/homoit0002697"},{"@id":"https://homosaurus.org/v5/homoit0002677"},{"@id":"https://homosaurus.org/v5/homoit0002716"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0004331"},"dc:issued":{"@type":"xsd:date","@value":"2026-02-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003502","dc:identifier":"homoit0003502","skos:prefLabel":[{"@language":"en","@value":"Transgender health care bans for children and youth"},{"@language":"es","@value":"Prohibiciones de asistencia médica transgénero para niños y jóvenes"},{"@language":"nl","@value":"Verboden op transgender gezondheidszorg voor kinderen en jongeren"},{"@language":"sv","@value":"Förbud mot könsbekräftande vård för barn och unga"}],"skos:altLabel":[{"@language":"es","@value":"Prohibiciones de asistencia médica transgénero para niñxs y jóvenes"},{"@language":"es","@value":"Prohibiciones de asistencia médica trans para niños y jóvenes"},{"@language":"es","@value":"Prohibiciones de asistencia médica trans para niñxs y jóvenes"}],"rdfs:comment":[{"@language":"en","@value":"Laws or policies instituted that prevent trans and non-binary youth and children from seeking and/or obtaining medical treatment or gender-affirming care, including but not limited to surgery, hormone treatment, and mental health care. "},{"@language":"es","@value":"Leyes o políticas instituidas para impedir que las personas jóvenes y niñxs trans y no binarixs busquen tratamiento o atención médica para la afirmación de su género, incluidos, entre otros, la cirugía, el tratamiento hormonal y la atención de salud mental."},{"@language":"nl","@value":"Wetten of beleidsmaatregelen die transgender en non-binaire jongeren en kinderen ervan weerhouden medische behandeling of genderbevestigende zorg te zoeken en/of te verkrijgen, waaronder maar niet beperkt tot operaties, hormoonbehandelingen en geestelijke gezondheidszorg."},{"@language":"sv","@value":"Lagar eller policys som begränsar trans- och ickebinära barns möjligheter att ta del av medicinsk behandling och könsbekräftande vård, däribland kirurgi, hormonbehandling och insatser för psykisk hälsa."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0003499"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001400"},{"@id":"https://homosaurus.org/v5/homoit0001452"},{"@id":"https://homosaurus.org/v5/homoit0003514"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000702"},"dc:issued":{"@type":"xsd:date","@value":"2024-07-31"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003708","dc:identifier":"homoit0003708","skos:prefLabel":[{"@language":"en","@value":"Trans joy"},{"@language":"nl","@value":"Trans vreugde"},{"@language":"sv","@value":"Transglädje"}],"skos:altLabel":[{"@language":"en","@value":"Transgender joy"},{"@language":"nl","@value":"Transgender joy"},{"@language":"nl","@value":"Transgender vreugde"},{"@language":"sv","@value":"Transeufori"}],"rdfs:comment":[{"@language":"en","@value":"A positive feeling connected to trans identity, being, community, activism, and/or culture that counters the impact of living in a discriminatory society. "},{"@language":"nl","@value":"Een positief gevoel dat verbonden is met de identiteit, het wezen, de gemeenschap, het activisme en/of de cultuur van transgender personen, en dat de impact van het leven in een discriminerende maatschappij tegengaat."},{"@language":"sv","@value":"En positiv känsla kopplad till transidentitet, transnärvaro, gemenskap, aktivism och/eller kultur som motverkar effekterna av att leva i ett diskriminerande samhälle."}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0003193"},{"@id":"https://homosaurus.org/v5/homoit0002256"},{"@id":"https://homosaurus.org/v5/homoit0001403"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0003708"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001727","dc:identifier":"homoit0001727","skos:prefLabel":[{"@language":"en","@value":"Transgender authors"},{"@language":"es","@value":"Autores transgénero"},{"@language":"nl","@value":"Transgender auteurs"},{"@language":"sv","@value":"Författare som är transpersoner"}],"rdfs:comment":[{"@language":"en","@value":"Transgender creators of written works."},{"@language":"es","@value":"Creadores de obras escritas conocidos por ser transgénero."},{"@language":"nl","@value":"Transgender makers van geschreven werken."},{"@language":"sv","@value":"Transpersoner som är skapare av skrivna verk."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001723"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001411"},{"@id":"https://homosaurus.org/v5/homoit0001414"},{"@id":"https://homosaurus.org/v5/homoit0001419"},{"@id":"https://homosaurus.org/v5/homoit0001433"},{"@id":"https://homosaurus.org/v5/homoit0001606"},{"@id":"https://homosaurus.org/v5/homoit0001733"},{"@id":"https://homosaurus.org/v5/homoit0002211"},{"@id":"https://homosaurus.org/v5/homoit0001618"}],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2007003735"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2021-11-02"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004305","dc:identifier":"homoit0004305","skos:prefLabel":[{"@language":"en","@value":"Transgender historical fiction"},{"@language":"nl","@value":"Transgender historische literatuur"},{"@language":"sv","@value":"Historiska skildringar om transpersoner"}],"skos:altLabel":[{"@language":"en","@value":"Trans historical fiction"},{"@language":"sv","@value":"Historiska romaner om transpersoner"}],"rdfs:comment":[{"@language":"en","@value":"Genre of written works that depicts events set during particular real historical events. Use for historical fiction focusing on transgender characters or themes."},{"@language":"nl","@value":"Geschreven fictieve werken waarin het verhaal zich afspeelt tegen de achtergrond van specifieke, waargebeurde historische gebeurtenissen; gebruik in verwijzing naar historische fictie met transgender personages of thema's."},{"@language":"sv","@value":"Skönlitterära verk som utspelar sig i historisk tid, med verkliga händelser och miljöer. Används för historiska skildringar med fokus på transkaraktärer eller teman."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001414"},{"@id":"https://homosaurus.org/v5/homoit0004295"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2026-02-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001584","dc:identifier":"homoit0001584","skos:prefLabel":[{"@language":"en","@value":"Transgender horror fiction"},{"@language":"es","@value":"Ficción de horror transgénero"},{"@language":"de","@value":"trans Horror-Fiction"},{"@language":"nl","@value":"Transgender horrorverhalen"},{"@language":"sv","@value":"Skräck om transpersoner och -teman"}],"skos:altLabel":[{"@language":"en","@value":"Trans horror fiction"},{"@language":"sv","@value":"Transskräck"}],"rdfs:comment":[{"@language":"en","@value":"Genre of written works that intend to frighten, scare, or disgust. Use for horror fiction focusing on transgender characters or themes."},{"@language":"es","@value":"Obras de ficción escritas con la intención de asustar, atemorizar o provocar disgusto; utilícese en referencia a la ficción de horror centrada en personajes o temas transgénero."},{"@language":"de","@value":"Fiktionale Werke, die erschrecken, ängstigen oder abstoßen sollen; Verwendung in Bezug auf fiktionale Werke, die sich auf trans Charaktere oder Themen konzentrieren."},{"@language":"nl","@value":"Geschreven fictie bedoeld om angst aan te jagen, bang te maken of te walgen; gebruik in verwijzing naar horrorfictie gericht op transgender personages of thema's."},{"@language":"sv","@value":"Skönlitterära verk skrivna för att skrämma, oroa eller äckla. Används för skräcklitteratur med transkaraktärer eller transfokuserade teman."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001580"},{"@id":"https://homosaurus.org/v5/homoit0001414"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transgenderHorrorFiction"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-03"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001595","dc:identifier":"homoit0001595","skos:prefLabel":[{"@language":"en","@value":"Transgender romance fiction"},{"@language":"es","@value":"Ficción romántica transgénero"},{"@language":"de","@value":"trans Liebesromane"},{"@language":"nl","@value":"Transgender liefdesverhalen"},{"@language":"sv","@value":"Kärleksromaner om transpersoner och transteman"}],"skos:altLabel":[{"@language":"en","@value":"Trans romance fiction"},{"@language":"sv","@value":"Kärleksskildringar om transpersoner och transteman"},{"@language":"sv","@value":"Trans-romance"}],"rdfs:comment":[{"@language":"en","@value":"Genre of written works that depicts romantic and/or sexual relationships between the main characters. Use for romance fiction focusing on transgender characters or themes."},{"@language":"es","@value":"Obras literarias escritas centradas en las relaciones románticas y el amor entre personas; utilícese en referencia a la ficción romántica centrada en personajes y temas transgénero."},{"@language":"de","@value":"Werke der Belletristik, die sich um romantische und/oder sexuelle Beziehungen zwischen den Hauptfiguren drehen; Verwendung in Bezug auf Liebesromane, die sich auf trans Figuren und Themen konzentrieren."},{"@language":"nl","@value":"Geschreven literair werk gericht op romantische relaties en liefde tussen mensen; gebruik in verwijzing naar romantische fictie gericht op transgender personages of thema's."},{"@language":"sv","@value":"Skönlitterära verk som kretsar kring romantiska och/eller sexuella relationer mellan huvudkaraktärerna. Används för kärleksromaner med transkaraktärer."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001586"},{"@id":"https://homosaurus.org/v5/homoit0001414"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transgenderRomanceFiction"},"dc:issued":{"@type":"xsd:date","@value":"2020-06-03"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004022","dc:identifier":"homoit0004022","skos:prefLabel":[{"@language":"en","@value":"Transgender people in literature"},{"@language":"nl","@value":"Transgender personen in de literatuur"},{"@language":"sv","@value":"Transpersoner i litteraturen"}],"skos:altLabel":{"@language":"en","@value":"Trans people in literature"},"rdfs:comment":[{"@language":"en","@value":"The depiction of trans people in literature."},{"@language":"nl","@value":"Het weergeven van transgender personen in de literatuur."},{"@language":"sv","@value":"Skildringen av transpersoner i litteraturen."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0004018"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001419"},"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2007003737"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2025-04-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002610","dc:identifier":"homoit0002610","skos:prefLabel":[{"@language":"en","@value":"Transgender erotic art "},{"@language":"es","@value":"Arte erótico transgénero"},{"@language":"nl","@value":"Transgender erotische kunst"},{"@language":"sv","@value":"Erotisk transkonst"}],"rdfs:comment":[{"@language":"en","@value":"Erotic art, created by transgender artists, depicting transgender people, or that are regarded as important within transgender culture."},{"@language":"es","@value":"Arte erótico, creado por artistas transgénero, que representa a personas transgénero, o personas consideradas importantes dentro de la cultura transgénero."},{"@language":"nl","@value":"Erotische kunst, gemaakt door transgenderkunstenaars, waarin transgender personen worden afgebeeld, of die binnen de transgendercultuur als belangrijk worden beschouwd."},{"@language":"sv","@value":"Erotisk konst skapad av transpersoner, som avbildar transpersoner eller som betraktas som betydelsefull inom transkulturen."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002579"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0001435"},{"@id":"https://homosaurus.org/v5/homoit0002549"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0002596"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002549","dc:identifier":"homoit0002549","skos:prefLabel":[{"@language":"en","@value":"Transgender erotic films"},{"@language":"es","@value":"Películas eróticas transgénero"},{"@language":"nl","@value":"Transgender erotische films"},{"@language":"sv","@value":"Erotiska transfilmer"}],"rdfs:comment":[{"@language":"en","@value":"Erotic films or movies, created by transgender directors, depicting transgender people, or that are regarded as important within transgender culture."},{"@language":"es","@value":"Filmes o películas eróticas, creadas por directores transgénero, que representan a personas transgénero o a personas consideradas importantes dentro de la cultura transgénero."},{"@language":"nl","@value":"Erotische films, gemaakt door transgenderregisseurs, waarin transgender personen worden afgebeeld, of die binnen de transgendercultuur als belangrijk worden beschouwd."},{"@language":"sv","@value":"Erotiska filmer skapade av transregissörer, som skildrar transpersoner eller som betraktas som betydelsefulla inom transkultur."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0002544"},{"@id":"https://homosaurus.org/v5/homoit0002610"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001435"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-12"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004624","dc:identifier":"homoit0004624","skos:prefLabel":{"@language":"en","@value":"Transgender personals"},"skos:altLabel":[{"@language":"en","@value":"Transgender personal ads"},{"@language":"en","@value":"Transgender personal advertisements"},{"@language":"en","@value":"Trans personals"},{"@language":"en","@value":"Trans personal ads"},{"@language":"en","@value":"Trans personal advertisements"}],"rdfs:comment":{"@language":"en","@value":"A form of classified advertising for trans people interested in seeking connections around sex, romance, and/or community. The content of these ads focus largely on the type of arrangement sought and details or criteria about the writer and the type of person they are looking for (e.g. personality traits, physical looks, etc.). While trans personals are most commonly thought of as existing in print media, they also have existed online in spaces such as Craigslist."},"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0004621"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001442"},{"@id":"https://homosaurus.org/v5/homoit0001436"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0004621"},"dc:issued":{"@type":"xsd:date","@value":"2026-06-08"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-08"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004321","dc:identifier":"homoit0004321","skos:prefLabel":[{"@language":"en","@value":"Transgender podcasts"},{"@language":"nl","@value":"Transgender podcasts"},{"@language":"sv","@value":"Transpoddar"}],"skos:altLabel":[{"@language":"en","@value":"Trans podcasts"},{"@language":"sv","@value":"Transpodcaster"},{"@language":"sv","@value":"Transpodcasts"}],"rdfs:comment":[{"@language":"en","@value":"A recorded series (primarily in audio, but sometimes with a video component) with recurring hosts that feature content about transgender people and/or transgender issues and that are available digitally for streaming or download. Podcasts are typically episodic and may feature different guests."},{"@language":"nl","@value":"Een opgenomen serie (voornamelijk audio, maar soms met een video-onderdeel) met terugkerende presentatoren die content presenteren over transgender personen en/of transgender thema's en die digitaal beschikbaar zijn om te streamen of te downloaden. Podcasts bestaan ​​doorgaans uit afleveringen en kunnen verschillende gasten hebben."},{"@language":"sv","@value":"Inspelade radioprogram (inslag av video kan förekomma) med återkommande programledare och innehåll om/för transpersoner och/eller transfrågor som är digitalt tillgängliga genom streaming eller nedladdning. Poddar är vanligen uppdelade i episoder och kan ha olika gäster."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0004317"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001441"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0004317"},"dc:issued":{"@type":"xsd:date","@value":"2026-02-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001462","dc:identifier":"homoit0001462","skos:prefLabel":[{"@language":"en","@value":"Transgender youth literature"},{"@language":"es","@value":"Literatura juvenil transgénero"},{"@language":"nl","@value":"Transgender jeugdliteratuur"},{"@language":"sv","@value":"Ungdomslitteratur om transpersoner och transteman"}],"skos:altLabel":{"@language":"sv","@value":"Transungdomslitteratur"},"rdfs:comment":[{"@language":"en","@value":"Written literary works for an audience of readers from 12-18 years of age, also known as young adult literature or YA; use in reference to youth literature focusing on transgender characters or themes."},{"@language":"es","@value":"Obras literarias escritas para una audiencia de lectores de 12 a 18 años de edad, también conocidas como literatura para adultos jóvenes o YA (por sus siglas en inglés); utilícese en referencia a la literatura juvenil que se centra en personajes o temas transgénero."},{"@language":"nl","@value":"Geschreven literaire werken voor een lezerspubliek van 12-18 jaar, ook wel young adult literatuur of YA genoemd; gebruik in verwijzing naar jeugdliteratuur gericht op transgender personages of thema's."},{"@language":"sv","@value":"Litterära verk för läsare mellan 12 och 18 år, även kallat YA. Används för ungdomslitteratur med fokus på transpersoner eller transfokuserade teman."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001522"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001452"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transgenderYouthLiterature"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001460","dc:identifier":"homoit0001460","skos:prefLabel":[{"@language":"en","@value":"Transgender victims' rights"},{"@language":"es","@value":"Derechos de víctimas transgénero"},{"@language":"nl","@value":"Slachtofferrechten voor transgender personen"},{"@language":"sv","@value":"Transpersoners rättigheter som brottsoffer"}],"rdfs:comment":[{"@language":"en","@value":"Transgender people’s legal rights to be informed, present, and heard within the criminal justice system after having been harmed or injured as the result of of a crime, accident, or other event."},{"@language":"es","@value":"Los derechos legales de las personas transgénero a estar informadas, estar presentes y ser escuchadas dentro del sistema de justicia penal después de haber sido perjudicadas o lesionadas como resultado de un delito, accidente u otro evento."},{"@language":"nl","@value":"De wettelijke rechten van transgender personen om te worden geïnformeerd, aanwezig te zijn en gehoord te worden binnen het strafrechtsysteem nadat ze zijn geschaad of gewond zijn geraakt als gevolg van een misdrijf, ongeval of andere gebeurtenis."},{"@language":"sv","@value":"Transpersoners juridiska rättigheter som brottsoffer att få information, närvara och komma till tals inom rättsväsendet efter att ha utsatts för brott, olycka eller annan händelse som orsakat skada."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001492"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000702"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transgenderVictimsRights"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001834","dc:identifier":"homoit0001834","skos:prefLabel":[{"@language":"en","@value":"Detransitioning"},{"@language":"es","@value":"Detransicionar"},{"@language":"de","@value":"Detransition"},{"@language":"nl","@value":"Detransitie"},{"@language":"sv","@value":"Detransitionering"}],"skos:altLabel":[{"@language":"en","@value":"Detransition"},{"@language":"es","@value":"Detransición"},{"@language":"de","@value":"Retransition"},{"@language":"sv","@value":"Detransition"},{"@language":"sv","@value":"Omtransition"},{"@language":"sv","@value":"Omtransitionering"},{"@language":"sv","@value":"Retransition"},{"@language":"sv","@value":"Retransitionering"}],"rdfs:comment":[{"@language":"en","@value":"Ceasing or reversing the process of gender transition for any reason, including personal safety, stigma, costs associated with transitioning, health concerns, to regain fertility, etc."},{"@language":"es","@value":"Cesar o revertir el proceso de transición de género por cualquier motivo, incluida la seguridad personal, el estigma, los costos asociados con la transición, problemas de salud, para recuperar la fertilidad, etc."},{"@language":"de","@value":"Die Unterbrechung oder Umkehrung des Geschlechtsangleichungsprozesses aus beliebigen Gründen, darunter persönliche Sicherheit, Stigmatisierung, mit der Angleichung verbundene Kosten, gesundheitliche Bedenken, die Wiederherstellung der Fruchtbarkeit, etc."},{"@language":"nl","@value":"Het proces van gendertransitie om welke reden dan ook stopzetten of omkeren, inclusief persoonlijke veiligheid, stigma, kosten in verband met transitie, gezondheidsproblemen, het herwinnen van vruchtbaarheid, enz."},{"@language":"sv","@value":"Att avbryta eller ändra en könsbekräftande transition, oavsett anledning, inklusive personlig säkerhet, stigma, kostnader förknippade med transitionen, hälsoskäl eller för att återfå fertilitet."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001465"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001464"},{"@id":"https://homosaurus.org/v5/homoit0001835"},{"@id":"https://homosaurus.org/v5/homoit0001836"},{"@id":"https://homosaurus.org/v5/homoit0004327"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001465"},"dc:issued":{"@type":"xsd:date","@value":"2022-02-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001835","dc:identifier":"homoit0001835","skos:prefLabel":[{"@language":"en","@value":"Retransitioning"},{"@language":"es","@value":"Retransicionar"},{"@language":"nl","@value":"Retransitie"},{"@language":"sv","@value":"Retransitionering"}],"skos:altLabel":[{"@language":"en","@value":"Retransition"},{"@language":"es","@value":"Retransición"}],"rdfs:comment":[{"@language":"en","@value":"Restarting the process of gender transition after a period of detransitioning."},{"@language":"es","@value":"Reiniciar el proceso de transición de género después de un período de detransición."},{"@language":"nl","@value":"Het proces van gendertransitie herstarten na een periode van detransitie"},{"@language":"sv","@value":"Att påbörja en könsövergång på nytt efter att tidigare ha avbrutit eller delvis återgått i processen."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001465"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001464"},{"@id":"https://homosaurus.org/v5/homoit0001834"},{"@id":"https://homosaurus.org/v5/homoit0001836"},{"@id":"https://homosaurus.org/v5/homoit0004327"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001465"},"dc:issued":{"@type":"xsd:date","@value":"2022-02-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001836","dc:identifier":"homoit0001836","skos:prefLabel":[{"@language":"en","@value":"Desistance (Gender)"},{"@language":"es","@value":"Desistimiento (Género)"},{"@language":"de","@value":"Desistenz (Gender)"},{"@language":"nl","@value":"Desistentie (Gender)"},{"@language":"sv","@value":"Desistering"}],"skos:altLabel":[{"@language":"de","@value":"Desistence"},{"@language":"sv","@value":"Återidentifiering"},{"@language":"sv","@value":"Deidentifiering"}],"rdfs:comment":[{"@language":"en","@value":"No longer identifying as transgender, or, more broadly, no longer identifying as some particular gender."},{"@language":"es","@value":"Ya no identificarse como transgénero o, en términos más generales, ya no identificarse con algún género en particular."},{"@language":"de","@value":"Sich nicht mehr als trans zu identifizieren oder sich im Allgemeinen nicht mehr einem bestimmten Geschlecht zuzuordnen."},{"@language":"nl","@value":"Niet langer identificeren als transgender, of, meer in het algemeen, niet langer identificeren als een bepaald gender"},{"@language":"sv","@value":"Att inte längre identifiera sig som transperson, eller mer generellt, att inte längre identifiera sig med ett visst kön."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001465"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001464"},{"@id":"https://homosaurus.org/v5/homoit0001834"},{"@id":"https://homosaurus.org/v5/homoit0001835"},{"@id":"https://homosaurus.org/v5/homoit0004327"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001465"},"dc:issued":{"@type":"xsd:date","@value":"2022-02-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001838","dc:identifier":"homoit0001838","skos:prefLabel":[{"@language":"en-us","@value":"Facial masculinization surgery"},{"@language":"es","@value":"Cirugía de masculinización facial"},{"@language":"de","@value":"Gesichtsmaskulinisierende Operation"},{"@language":"nl","@value":"Faciale masculiniserende chirurgie"},{"@language":"sv","@value":"Maskuliniserande ansiktskirurgi"},{"@language":"en-gb","@value":"Facial masculinisation surgery"}],"skos:altLabel":[{"@language":"en","@value":"FMS"},{"@language":"sv","@value":"Maskuliniserande ansiktsplastik"}],"rdfs:comment":[{"@language":"en","@value":"Any of various surgeries undertaken to masculinize the face or facial features."},{"@language":"es","@value":"Cualquiera de las diversas cirugías realizadas para masculinizar el rostro o los rasgos faciales."},{"@language":"de","@value":"Eine von verschiedenen Operationen zur Maskulinisierung des Gesichts oder der Gesichtszüge."},{"@language":"nl","@value":"Elk van de verschillende operaties die zijn uitgevoerd om het gezicht of de gelaatstrekken te masculiniseren"},{"@language":"sv","@value":"Kirurgiska ingrepp som syftar till att maskulinisera ansiktsdrag eller ansiktets helhet."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001837"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001464"},{"@id":"https://homosaurus.org/v5/homoit0001465"},{"@id":"https://homosaurus.org/v5/homoit0001839"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001004"},"dc:issued":{"@type":"xsd:date","@value":"2022-02-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001839","dc:identifier":"homoit0001839","skos:prefLabel":[{"@language":"en-us","@value":"Facial feminization surgery"},{"@language":"es","@value":"Cirugía de feminización facial"},{"@language":"de","@value":"Gesichtsfeminisierende Operation"},{"@language":"nl","@value":"Faciale feminiserende chirurgie"},{"@language":"sv","@value":"Feminiserande ansiktskirurgi"},{"@language":"en-gb","@value":"Facial feminisation surgery"}],"skos:altLabel":[{"@language":"en","@value":"FFS"},{"@language":"es","@value":"CFF"},{"@language":"sv","@value":"Feminiserande ansiktsplastik"}],"rdfs:comment":[{"@language":"en","@value":"Any of various surgeries undertaken to feminize the face or facial features."},{"@language":"es","@value":"Cualquiera de las diversas cirugías realizadas para feminizar el rostro o los rasgos faciales."},{"@language":"de","@value":"Eine von verschiedenen Operationen zur Feminisierung des Gesichts oder der Gesichtszüge."},{"@language":"nl","@value":"Elk van de verschillende operaties die worden uitgevoerd om het gezicht of de gelaatstrekken te feminiseren"},{"@language":"sv","@value":"Kirurgiska ingrepp som syftar till att feminisera ansiktsdrag eller ansiktets helhet."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001837"},"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0001849"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001464"},{"@id":"https://homosaurus.org/v5/homoit0001465"},{"@id":"https://homosaurus.org/v5/homoit0001838"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001004"},"dc:issued":{"@type":"xsd:date","@value":"2022-02-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001841","dc:identifier":"homoit0001841","skos:prefLabel":[{"@language":"en","@value":"Chest reconstruction surgery"},{"@language":"es","@value":"Cirugía de reconstrucción torácica"},{"@language":"de","@value":"Chirurgische Brustrekonstruktion"},{"@language":"nl","@value":"Borstreconstructiechirurgie"},{"@language":"sv","@value":"Bröstrekonstruktion"}],"skos:altLabel":[{"@language":"en","@value":"Chest wall reconstruction"},{"@language":"es","@value":"Reconstrucción de la pared toráxica"},{"@language":"de","@value":"Chirurgische Rekonstruktion der Brust"},{"@language":"de","@value":"Operation zur Brustrekonstruktion"}],"rdfs:comment":[{"@language":"en","@value":"Reconstruction of the chest, typically following a mastectomy, to give the chest a more masculine appearance."},{"@language":"es","@value":"Reconstrucción del tórax, generalmente después de una mastectomía, para darle al tórax una apariencia más masculina."},{"@language":"de","@value":"Rekonstruktion der Brust, typischerweise nach einer Mastektomie, um der Brust ein männlicheres Erscheinungsbild zu verleihen."},{"@language":"nl","@value":"Reconstructie van de borstkas, meestal na of samen met een borstamputatie, die wordt uitgevoerd om de borst een mannelijker uiterlijk te geven"},{"@language":"sv","@value":"Rekonstruktion av bröstpartiet, vanligtvis efter en mastektomi, för att ge bröstpartiet ett mer maskulint utseende."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001840"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001465"},{"@id":"https://homosaurus.org/v5/homoit0001631"},{"@id":"https://homosaurus.org/v5/homoit0003118"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001004"},"dc:issued":{"@type":"xsd:date","@value":"2022-02-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001849","dc:identifier":"homoit0001849","skos:prefLabel":[{"@language":"en","@value":"Tracheal shave"},{"@language":"es","@value":"Afeitado traqueal"},{"@language":"nl","@value":"Adamsappelcorrectie"},{"@language":"sv","@value":"Hyvling av sköldbrosk"}],"skos:altLabel":[{"@language":"en","@value":"Adam's apple reduction"},{"@language":"en","@value":"Chondrolaryngoplasty"},{"@language":"en","@value":"TCR"},{"@language":"en","@value":"Thyroid cartilage reduction"},{"@language":"en","@value":"Trache shave"},{"@language":"en","@value":"Trachea shave"},{"@language":"nl","@value":"Adamsappelverkleining"},{"@language":"nl","@value":"Tracheal shave"},{"@language":"nl","@value":"Tracheale scheerbeurt"}],"rdfs:comment":[{"@language":"en","@value":"A surgery in which the laryngeal prominence, colloquially referred to as the Adam's apple, is reduced in size, often as part of facial feminization surgery for transfeminine people. Cisgender men and cisgender women may also undergo tracheal shaves if they feel their laryngeal prominence is too prominent."},{"@language":"es","@value":"Una cirugía en la que se reduce de tamaño la prominencia laríngea, coloquialmente conocida como la nuez de Adán, a menudo como parte de una cirugía de feminización facial para personas transfemeninas. Los hombres y las mujeres cisgénero también pueden someterse a un afeitado traqueal si sienten que su prominencia laríngea es demasiado prominente."},{"@language":"nl","@value":"Een operatie waarbij het uitsteeksel van het strottenhoofd, in de volksmond de adamsappel genoemd, wordt verkleind, vaak als onderdeel van faciale feminiserende chirurgie voor transvrouwen. Cisgender-mannen en cisgender-vrouwen kunnen ook adamsappelcorrectie ondergaan als ze vinden dat hun adamsappel te prominent is"},{"@language":"sv","@value":"En operation där struphuvudets utskjutande del, i vardagligt tal kallad adamsäpplet, minskas i storlek. Operationen är ofta en del av feminiserande ansiktskirurgi för transfeminina personer men kan även genomföras av cismän och ciskvinnor som upplever att deras struphuvud är för framträdande."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001839"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001465"},{"@id":"https://homosaurus.org/v5/homoit0001837"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001004"},"dc:issued":{"@type":"xsd:date","@value":"2022-02-15"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002212","dc:identifier":"homoit0002212","skos:prefLabel":[{"@language":"en","@value":"Transphobia in fandom"},{"@language":"es","@value":"Transfobia en fandom"},{"@language":"nl","@value":"Transfobie in fandom"},{"@language":"sv","@value":"Transfobi inom fandom"}],"rdfs:comment":[{"@language":"en","@value":"Issues and discussions about the presence of transphobia in fan spaces and works."},{"@language":"es","@value":"Asuntos y debates sobre la presencia de la transfobia en espacios y obras de fans."},{"@language":"nl","@value":"Kwesties en discussies over de aanwezigheid van transfobie in fan-ruimtes en uitingen"},{"@language":"sv","@value":"Frågor och diskussioner om förekomsten av transfobi i fangemenskaper och fanverk."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001467"},{"@id":"https://homosaurus.org/v5/homoit0002171"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0002181"},{"@id":"https://homosaurus.org/v5/homoit0002194"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000920"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002593","dc:identifier":"homoit0002593","skos:prefLabel":[{"@language":"en","@value":"Internalized transphobia"},{"@language":"es","@value":"Transfobia internalizada"},{"@language":"nl","@value":"Geïnternaliseerde transfobie"},{"@language":"sv","@value":"Internaliserad transfobi"}],"rdfs:comment":[{"@language":"en","@value":"The phenomenon in which transgender people internalize or adopt transphobic beliefs (i.e., negative perceptions of and intolerance toward transgender people and trans identities) as a result of being raised or socialized within a transphobic environment or culture."},{"@language":"es","@value":"El fenómeno a través del cual las personas transgénero internalizan o adoptan creencias transfóbicas (es decir, percepciones negativas e intolerancia hacia las personas transgénero y las identidades trans) como resultado de haber sido criadas o socializadas dentro de un entorno o una cultura transfóbica."},{"@language":"nl","@value":"Het fenomeen waarbij transgender personen transfobe overtuigingen internaliseren of overnemen (d.w.z. negatieve percepties van en intolerantie jegens transgender personen en transidentiteiten) als gevolg van het feit dat ze zijn opgegroeid of gesocialiseerd in een transfobe omgeving of cultuur."},{"@language":"sv","@value":"Företeelsen att transpersoner internaliserar eller anammar transfobiska föreställningar – det vill säga negativa uppfattningar om och intolerans mot transpersoner och transidentiteter – till följd av att ha vuxit upp eller socialiserats i en transfobisk miljö eller kultur."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001467"},{"@id":"https://homosaurus.org/v5/homoit0002590"}],"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0003095"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000920"},"dc:issued":{"@type":"xsd:date","@value":"2023-04-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001750","dc:identifier":"homoit0001750","skos:prefLabel":[{"@language":"en","@value":"Two-Spirit authors"},{"@language":"es","@value":"Autores dos espíritus"},{"@language":"nl","@value":"Two-Spirit auteurs"},{"@language":"sv","@value":"Two-spirit-författare"}],"skos:altLabel":[{"@language":"en","@value":"2S authors"},{"@language":"en","@value":"2S writers"},{"@language":"en","@value":"Two Spirit authors"},{"@language":"en","@value":"Two Spirit writers"},{"@language":"en","@value":"Two Spirited authors"},{"@language":"en","@value":"Two Spirited writers"},{"@language":"en","@value":"Two-Spirit writers"},{"@language":"en","@value":"Two-Spirited authors"},{"@language":"en","@value":"Two-Spirited writers"},{"@language":"es","@value":"Autores dos espíritus"},{"@language":"es","@value":"Escritores dos espíritus"},{"@language":"nl","@value":"Two spirit schrijvers"},{"@language":"nl","@value":"Two-spirit schrijvers"}],"rdfs:comment":[{"@language":"en","@value":"Two-Spirit creators of written works."},{"@language":"es","@value":"Creadoras de obras escritas conocidas por ser dos espíritus."},{"@language":"nl","@value":"Two Spirit makers van geschreven werken."},{"@language":"sv","@value":"Two-spirit-personer som är skapare av skrivna verk."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001480"},"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0003671"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001723"},{"@id":"https://homosaurus.org/v5/homoit0002710"},{"@id":"https://homosaurus.org/v5/homoit0002679"},{"@id":"https://homosaurus.org/v5/homoit0002680"},{"@id":"https://homosaurus.org/v5/homoit0003876"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2021-11-09"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001760","dc:identifier":"homoit0001760","skos:prefLabel":[{"@language":"en","@value":"Two-Spirit families"},{"@language":"es","@value":"Familias dos espíritus"},{"@language":"fr","@value":"Familles bispirituelles"},{"@language":"nl","@value":"Two-Spirit gezinnen"},{"@language":"sv","@value":"Two-spirit-familjer"}],"skos:altLabel":[{"@language":"en","@value":"2S families"},{"@language":"en","@value":"Two Spirit families"},{"@language":"en","@value":"Two Spirited families"},{"@language":"en","@value":"Two-Spirited families"},{"@language":"fr","@value":"Familles de personnes bispirituelles"}],"rdfs:comment":[{"@language":"en","@value":"Families, whether biological, adoptive, or chosen, in which one or more individuals identify as Two-Spirit."},{"@language":"es","@value":"Familias, ya sean biológicas, adoptivas o elegidas, en las que una o más personas se autoidentifican como dos espíritus."},{"@language":"fr","@value":"Familles biologiques, adoptives ou choisies, dans lesquelles une ou plusieurs personnes s'identifient comme bispirituelles."},{"@language":"nl","@value":"Gezinnen, biologisch, adoptief of gekozen, waarin een of meer individuen zich identificeren als Two-Spirit."},{"@language":"sv","@value":"Familjer – biologiska, adoptiva eller valda – där en eller flera personer identifierar sig som Two-spirit."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001480"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001768"},{"@id":"https://homosaurus.org/v5/homoit0003242"},{"@id":"https://homosaurus.org/v5/homoit0003243"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2021-11-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001764","dc:identifier":"homoit0001764","skos:prefLabel":[{"@language":"en","@value":"Two-Spirit parents"},{"@language":"es","@value":"Madres y padres dos espíritus"},{"@language":"nl","@value":"Two-Spirit ouders"},{"@language":"sv","@value":"Two-spirit-föräldrar"}],"skos:altLabel":[{"@language":"en","@value":"2S parents"},{"@language":"en","@value":"Two Spirit parents"},{"@language":"en","@value":"Two Spirited parents"},{"@language":"en","@value":"Two-Spirited parents"},{"@language":"es","@value":"Madres dos espíritus"},{"@language":"es","@value":"Padres dos espíritus"}],"rdfs:comment":[{"@language":"en","@value":"Two-Spirit people who are parents."},{"@language":"es","@value":"Padres y/o madres que son dos espíritus."},{"@language":"nl","@value":"Ouders die two-spirit zijn"},{"@language":"sv","@value":"Two-spirit-personer som är föräldrar."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001480"},{"@id":"https://homosaurus.org/v5/homoit0002372"}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0003242"},{"@id":"https://homosaurus.org/v5/homoit0003243"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001768"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2021-11-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001778","dc:identifier":"homoit0001778","skos:prefLabel":[{"@language":"en","@value":"Two-Spirit chefs"},{"@language":"es","@value":"Cocineros dos espíritus"},{"@language":"nl","@value":"Two-Spirit chefkoks"},{"@language":"sv","@value":"Two-spirit-kökschefer"}],"skos:altLabel":[{"@language":"en","@value":"2S chefs"},{"@language":"en","@value":"Two Spirit chefs"},{"@language":"en","@value":"Two Spirited chefs"},{"@language":"en","@value":"Two-Spirited chefs"},{"@language":"es","@value":"Chefs dos espíritus"}],"rdfs:comment":[{"@language":"en","@value":"Two-Spirit people who are trained, professional cooks, typically holding a leadership role in the kitchen in which they are employed."},{"@language":"es","@value":"Personas dos espíritus que son cocineras profesionales capacitadas y que normalmente desempeñan un papel de liderazgo en la cocina en la que trabajan."},{"@language":"nl","@value":"Two-spirit personen die zijn opgeleid tot professionele koks, en doorgaans een leidende rol vervullen in de keuken waarin ze werken"},{"@language":"sv","@value":"Two-spirit-personer som är utbildade professionella kockar och som vanligtvis har en ledande roll i köket där de arbetar."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001480"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001771"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2021-12-07"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001936","dc:identifier":"homoit0001936","skos:prefLabel":[{"@language":"en","@value":"Two-Spirit athletes"},{"@language":"es","@value":"Atletas dos espíritus"},{"@language":"nl","@value":"Two-Spirit sportbeoefenaars"},{"@language":"sv","@value":"Two-spirit-idrottare"}],"skos:altLabel":[{"@language":"en","@value":"2S athletes"},{"@language":"en","@value":"Two Spirited athletes"},{"@language":"en","@value":"Two-Spirit sports players"},{"@language":"en","@value":"Two-Spirit sportspeople"},{"@language":"en","@value":"Two-Spirit sportspersons"},{"@language":"en","@value":"Two-Spirited athletes"},{"@language":"es","@value":"Jugadores de deportes dos espíritus"},{"@language":"es","@value":"Deportistas dos espíritus"}],"rdfs:comment":[{"@language":"en","@value":"Professional or recreational sports players who self-identify as Two-Spirit."},{"@language":"es","@value":"Jugadores de deportes profesionales o recreativos que se autoidentifican como dos espíritus."},{"@language":"nl","@value":"Professionele of amateur/recreatieve sporters die zichzelf identificeren als Two-Spirit"},{"@language":"sv","@value":"Two-spirit-personer som ägnar sig åt professionell eller rekreationell idrott."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001480"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0004474"},{"@id":"https://homosaurus.org/v5/homoit0004516"},{"@id":"https://homosaurus.org/v5/homoit0004528"},{"@id":"https://homosaurus.org/v5/homoit0004538"},{"@id":"https://homosaurus.org/v5/homoit0004548"},{"@id":"https://homosaurus.org/v5/homoit0004558"},{"@id":"https://homosaurus.org/v5/homoit0004568"},{"@id":"https://homosaurus.org/v5/homoit0004578"},{"@id":"https://homosaurus.org/v5/homoit0004588"},{"@id":"https://homosaurus.org/v5/homoit0004600"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001929"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2022-05-03"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001997","dc:identifier":"homoit0001997","skos:prefLabel":[{"@language":"en","@value":"Two-Spirit victims of bullying"},{"@language":"es","@value":"Víctimas dos espíritus de acoso"},{"@language":"fr","@value":"Personnes bispirituelles victimes d'intimidation"},{"@language":"nl","@value":"Two-Spirit slachtoffers van pesten"},{"@language":"sv","@value":"Two-spirit-personer är mobbningsoffer"}],"skos:altLabel":[{"@language":"en","@value":"2S victims of bullying"},{"@language":"en","@value":"Two Spirit victims of bullying"},{"@language":"en","@value":"Two Spirited victims of bullying"},{"@language":"en","@value":"Two-Spirited victims of bullying"},{"@language":"sv","@value":"Two-spirit-personer som utsatts för mobbning"}],"rdfs:comment":[{"@language":"en","@value":"Two-Spirit people who have experienced bullying due to their gender or sexual identity and may or may not have survived; follow the individual's preference for \"victims\" or \"survivors\" whenever possible."},{"@language":"es","@value":"Personas dos espíritus que han sufrido acoso por su identidad sexual y pueden o no haber sobrevivido; siga la preferencia de la persona sobre el uso de \"víctimas\" o \"supervivientes\" siempre que sea posible."},{"@language":"fr","@value":"Personnes bispirituelles qui ont subi et survécu à de l'intimidation en raison de leur identité bispirituelle; respecter la préférence de la personne concernée entre les termes « victimes » ou « survivantes » dans la mesure du possible."},{"@language":"nl","@value":"Two-Spirit people die pesten hebben meegemaakt vanwege hun gender of seksuele identiteit en het al dan niet hebben overleefd; volg waar mogelijk de voorkeur van het individu voor \"slachtoffers\" of \"overlevenden\""},{"@language":"sv","@value":"Two-spirit-personer som har upplevt mobbning på grund av sin könsidentitet eller sexuella identitet och som kan ha överlevt eller inte. Följ individens eget språkbruk om de föredrar offer eller överlevare."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001480"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0003487"},{"@id":"https://homosaurus.org/v5/homoit0002006"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001989"},{"@id":"https://homosaurus.org/v5/homoit0003748"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2022-05-11"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002035","dc:identifier":"homoit0002035","skos:prefLabel":[{"@language":"en","@value":"Two-Spirit people in the workplace"},{"@language":"es","@value":"Personas dos espíritus en el lugar de trabajo"},{"@language":"nl","@value":"Two-Spirit people op de werkvloer"},{"@language":"sv","@value":"Arbetslivsvillkor för Two-spirit-personer"}],"rdfs:comment":[{"@language":"en","@value":"The presence of Two-Spirit people in the workplace, including acceptance of and issues faced by Two-Spirit workers."},{"@language":"es","@value":"La presencia de personas dos espíritus en el lugar de trabajo, incluida la aceptación de los trabajadores dos espíritus y los problemas a los que se enfrentan.\r\n"},{"@language":"nl","@value":"De aanwezigheid van Two-Spirit people op de werkplek, inclusief acceptatie van en problemen waarmee Two-Spirit-werknemers worden geconfronteerd"},{"@language":"sv","@value":"Two-spirit-personers situation på arbetsplatsen, inklusive acceptans, bemötande och villkor i arbetslivet."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001480"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0002029"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2022-06-15"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002666","dc:identifier":"homoit0002666","skos:prefLabel":[{"@language":"en","@value":"Two-Spirit neurodivergent people "},{"@language":"es","@value":"Personas dos espíritus neurodivergentes"},{"@language":"nl","@value":"Two-Spirit neurodivergente personen"},{"@language":"sv","@value":"Neurodivergenta Two-spirit-personer"}],"skos:altLabel":[{"@language":"en","@value":"Two-Spirit neurodivergent people"},{"@language":"en","@value":"Two Spirit neurodivergent people"},{"@language":"en","@value":"Two-Spirited neurodivergent people"},{"@language":"en","@value":"Two Spirited neurodivergent people"},{"@language":"en","@value":"2S neurodivergent people"},{"@language":"en","@value":"Two Spirit neuroatypical people"},{"@language":"en","@value":"Two-Spirited neuroatypical people"},{"@language":"en","@value":"Two Spirited neuroatypical people"},{"@language":"en","@value":"2S neuroatypical people"},{"@language":"es","@value":"Personas neurodivergentes dos espíritus"},{"@language":"nl","@value":"Two-Spirit neuro-atypische personen"}],"rdfs:comment":[{"@language":"en","@value":"Two-Spirit people with neurodevelopmental differences in areas such as cognition, sensory processing, emotionality, and sociality."},{"@language":"es","@value":"Personas dos espíritus cuyos cerebros procesan, aprenden y/o se comportan de forma diferente a lo que la sociedad considera típico. Algunas de estas diferencias neurológicas pueden presentarse como dificultades de aprendizaje, trastornos médicos y otras condiciones."},{"@language":"nl","@value":"Two-Spirit people met neurodevelopmentale verschillen op gebieden zoals cognitie, zintuiglijke verwerking, emotionaliteit en sociale vaardigheden."},{"@language":"sv","@value":"Two-spirit-personer vars kognition, sensoriska bearbetning, emotionalitet eller sociala förmåga skiljer sig från normen. Dessa variationer kan för vissa innebära funktionsnedsättningar eller medicinska tillstånd, medan de för andra är egenskaper som ingår i deras identitet."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001480"},"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0002676"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0002658"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-26"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002682","dc:identifier":"homoit0002682","skos:prefLabel":[{"@language":"en","@value":"Two-Spirit disabled people "},{"@language":"es","@value":"Personas dos espíritus discapacitadas"},{"@language":"nl","@value":"Gehandicapte Two-Spirit people"},{"@language":"sv","@value":"Funktionsnedsatta Two-spirit-personer"}],"skos:altLabel":[{"@language":"en","@value":"2S disabled people "},{"@language":"en","@value":"Disabled 2S people "},{"@language":"en","@value":"Disabled Two Spirit people "},{"@language":"en","@value":"Disabled Two-Spirited people "},{"@language":"en","@value":"Two Spirit disabled people "},{"@language":"en","@value":"Two Spirited disabled people "},{"@language":"en","@value":"Two-Spirited disabled people "},{"@language":"es","@value":"Personas dos espíritus con discapacidades"},{"@language":"es","@value":"Discapacitados dos espíritus"},{"@language":"es","@value":"Personas discapacitadas dos espíritus"},{"@language":"sv","@value":"Funktionshindrade Two-spirit-personer"}],"rdfs:comment":[{"@language":"en","@value":"Two-Spirit people who are disabled"},{"@language":"es","@value":"Personas dos espíritus con discapacidad."},{"@language":"nl","@value":"Two-Spirit people die gehandicapt zijn."},{"@language":"sv","@value":"Two-spirit-personer med funktionsnedsättning/funktionsnedsättningar."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001480"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0002676"},{"@id":"https://homosaurus.org/v5/homoit0002683"},{"@id":"https://homosaurus.org/v5/homoit0002684"},{"@id":"https://homosaurus.org/v5/homoit0002693"},{"@id":"https://homosaurus.org/v5/homoit0002695"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001854"},{"@id":"https://homosaurus.org/v5/homoit0002694"},{"@id":"https://homosaurus.org/v5/homoit0004226"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-26"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002709","dc:identifier":"homoit0002709","skos:prefLabel":[{"@language":"en","@value":"Two-Spirit comedians"},{"@language":"es","@value":"Comediantes dos espíritus"},{"@language":"nl","@value":"Two-Spirit komieken"},{"@language":"sv","@value":"Two-spirit-komiker"}],"skos:altLabel":[{"@language":"en","@value":"2S comedians"},{"@language":"en","@value":"2S comics (Persons)"},{"@language":"en","@value":"Two Spirited comedians"},{"@language":"en","@value":"Two Spirited comics (Persons)"},{"@language":"en","@value":"Two-Spirited comedians"},{"@language":"en","@value":"Two-Spirited comics (Persons)"},{"@language":"es","@value":"Cómicos dos espíritus"}],"rdfs:comment":[{"@language":"en","@value":"Two-Spirit people who seek to entertain an audience by making them laugh, through jokes, slapstick, employing prop comedy, or other amusing means."},{"@language":"es","@value":"Personas dos espíritus que buscan entretener a la audiencia haciéndolas reír, mediante bromas, payasadas, empleando comedia de utilería u otros medios divertidos."},{"@language":"nl","@value":"Two-Spirit people die een publiek willen vermaken door ze aan het lachen te maken, door middel van grappen, slapstick, comedy of andere grappige middelen."},{"@language":"sv","@value":"Two-spirit-personer som underhåller en publik genom att få dem att skratta, till exempel med hjälp av skämt, fysisk komik, rekvisita eller andra humoristiska uttryck."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001480"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0002701"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-27"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002717","dc:identifier":"homoit0002717","skos:prefLabel":[{"@language":"en","@value":"Two-Spirit partners"},{"@language":"es","@value":"Parejas dos espíritus"},{"@language":"nl","@value":"Two-Spirit partners"},{"@language":"sv","@value":"Two-spirit-partners"}],"skos:altLabel":[{"@language":"en","@value":"2S partners"},{"@language":"en","@value":"Two Spirit partners"},{"@language":"en","@value":"Two Spirited partners"},{"@language":"en","@value":"Two-Spirited partners"}],"rdfs:comment":[{"@language":"en","@value":"Two-Spirit people who are the romantic, sexual, or play partners of another person or people."},{"@language":"es","@value":"Personas dos espíritus que son la pareja romántica, sexual o de juegos de otra persona o personas."},{"@language":"nl","@value":"Two-Spirit people die een romantisch, seksueel of speel partnerschap delen met een andere persoon of personen."},{"@language":"sv","@value":"Two-spirit-personersom har en romantisk, sexuell eller kinkbaserad relation med en eller flera andra personer."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001480"},{"@id":"https://homosaurus.org/v5/homoit0002365"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-27"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002817","dc:identifier":"homoit0002817","skos:prefLabel":[{"@language":"en","@value":"Two-Spirit politicians"},{"@language":"es","@value":"Políticos dos espíritus"},{"@language":"nl","@value":"Two-Spirit politici"},{"@language":"sv","@value":"Two-spirit-politiker"}],"skos:altLabel":[{"@language":"en","@value":"2S politicians"},{"@language":"en","@value":"2S public officials"},{"@language":"en","@value":"Two Spirited politicians"},{"@language":"en","@value":"Two Spirited public officials"},{"@language":"en","@value":"Two-Spirit public officials"},{"@language":"en","@value":"Two-Spirited public officials"},{"@language":"en","@value":"Two-Spiritied politicians"},{"@language":"es","@value":"Oficiales públicos dos espíritus"}],"rdfs:comment":[{"@language":"en","@value":"Two-Spirit people who are candidates for public office, are currently holding public office, or have held political positions. Politicians can be elected by public election or otherwise appointed."},{"@language":"es","@value":"Personas dos espíritus que son candidatas a cargos públicos, ocupan actualmente cargos públicos o han ocupado cargos políticos. Los políticos pueden ser elegidos por sufragio público o designados de otro modo."},{"@language":"sv","@value":"Two-spirit-personer som är kandidater till politiska uppdrag, som innehar eller har innehaft politiska uppdrag. Politiker kan vara folkvalda eller utsedda genom andra former av tillsättning."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001480"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0002809"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003046","dc:identifier":"homoit0003046","skos:prefLabel":[{"@language":"en","@value":"Two-Spirit college students"},{"@language":"de","@value":"Two-Spirit-Hochschulstudierende"},{"@language":"es","@value":"Estudiantes universitarios dos espíritus"},{"@language":"nl","@value":"Two-Spirit studenten"},{"@language":"sv","@value":"Two-spirit-personer som är collegestudenter"}],"skos:altLabel":[{"@language":"en","@value":"2S college students"},{"@language":"en","@value":"Two Spirit college students"},{"@language":"en","@value":"Two Spirited college students"},{"@language":"en","@value":"Two-Spirited college students"},{"@language":"es","@value":"Universitarios dos espíritus"}],"rdfs:comment":[{"@language":"en","@value":"Two-Spirit people who are attending college."},{"@language":"de","@value":"Two-Spirit-Personen, die eine Hochschule besuchen. Achtung: Das US-amerikanische College entspricht nicht exakt der Hochschule im deutschen Sprachraum, wird aber häufig als Hochschule übersetzt."},{"@language":"es","@value":"Personas dos espíritus que asisten a la universidad."},{"@language":"nl","@value":"Two-Spirit people die naar de universiteit gaan."},{"@language":"sv","@value":"Two-spirit-personer som studerar vid college."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001480"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0003032"},{"@id":"https://homosaurus.org/v5/homoit0003041"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2023-12-05"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003230","dc:identifier":"homoit0003230","skos:prefLabel":[{"@language":"en","@value":"Pregnant Two-Spirit people"},{"@language":"es","@value":"Personas dos espíritus embarazadas"},{"@language":"nl","@value":"Zwangere Two-Spirit people"},{"@language":"sv","@value":"Gravida Two-spirit-personer"}],"skos:altLabel":[{"@language":"en","@value":"Pregnant 2S people"},{"@language":"en","@value":"Pregnant Two Spirit people"},{"@language":"en","@value":"Pregnant Two Spirited people"},{"@language":"en","@value":"Pregnant Two-Spirited people"},{"@language":"es","@value":"Personas embarazadas dos espíritus"}],"rdfs:comment":[{"@language":"en","@value":"Pregnant people who are Two-Spirit."},{"@language":"es","@value":"Personas embarazadas que son dos espíritus."},{"@language":"nl","@value":"Zwangere personen die Two-Sprit zijn."},{"@language":"sv","@value":"Gravida personer som är Two-spirit."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001480"},{"@id":"https://homosaurus.org/v5/homoit0003364"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2024-05-24"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003244","dc:identifier":"homoit0003244","skos:prefLabel":[{"@language":"en","@value":"Two-Spirit sons"},{"@language":"es","@value":"Hijos dos espíritus"},{"@language":"nl","@value":"Two-Spirit zonen"},{"@language":"sv","@value":"Two-spirit-söner"}],"skos:altLabel":[{"@language":"en","@value":"2S sons"},{"@language":"en","@value":"Two Spirit sons"},{"@language":"en","@value":"Two Spirited sons"},{"@language":"en","@value":"Two-Spirited sons"}],"rdfs:comment":[{"@language":"en","@value":"Two-Spirit people who are sons. Only use to describe individuals who identify as sons."},{"@language":"es","@value":"Personas dos espíritus que son hijos. Utilícese únicamente para personas que se autoidentifican como hijos."},{"@language":"nl","@value":"Two-Spirit personen die zonen zijn. Alleen te gebruiken om individuen te beschrijven die zich identificeren als zonen."},{"@language":"sv","@value":"Two-spirit-personer som är söner. Används endast för personer som själva identifierar sig som söner."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001480"},{"@id":"https://homosaurus.org/v5/homoit0002353"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2024-05-24"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003261","dc:identifier":"homoit0003261","skos:prefLabel":[{"@language":"en","@value":"Two-Spirit teachers"},{"@language":"es","@value":"Docentes dos espíritus"},{"@language":"nl","@value":"Two-Spirit leraren"},{"@language":"sv","@value":"Two-spirit-lärare"}],"skos:altLabel":[{"@language":"en","@value":"2S teachers"},{"@language":"en","@value":"Two Spirit teachers"},{"@language":"en","@value":"Two Spirited teachers"},{"@language":"en","@value":"Two-Sprited teachers"},{"@language":"es","@value":"Profesoras dos espíritus"},{"@language":"es","@value":"Profesores dos espíritus"},{"@language":"nl","@value":"Two Spirit leraren"},{"@language":"nl","@value":"Two Spirited leraren"},{"@language":"nl","@value":"Two-Spirited leraren"}],"rdfs:comment":[{"@language":"en","@value":"Indigenous teachers who self-identify as Two-Spirit."},{"@language":"es","@value":"Docentes o profesores que se autoidentifican como dos espíritus."},{"@language":"nl","@value":"Leraren die zichzelf als Two-Spirited identificeren."},{"@language":"sv","@value":"Lärare med urfolksbakgrund som identifierar sig som Two-spirit-personer."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001480"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0003247"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2024-05-24"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003276","dc:identifier":"homoit0003276","skos:prefLabel":[{"@language":"en","@value":"Two-Spirit academics"},{"@language":"es","@value":"Académicos dos espíritus"},{"@language":"nl","@value":"Two-Spirit academici"},{"@language":"sv","@value":"Two-spirit-personer som är akademiker"}],"skos:altLabel":[{"@language":"en","@value":"2S academics"},{"@language":"en","@value":"Two spirit academics"},{"@language":"en","@value":"Two spirited academics"},{"@language":"en","@value":"Two-Spirit college teachers"},{"@language":"en","@value":"Two-Spirit professors"},{"@language":"en","@value":"Two-Spirit researchers"},{"@language":"en","@value":"Two-sprited academics"},{"@language":"es","@value":"Profesores de universidad dos espíritus"},{"@language":"es","@value":"Investigadores dos espíritus"},{"@language":"es","@value":"Profesoras de universidad dos espíritus"},{"@language":"es","@value":"Investigadoras dos espíritus"},{"@language":"es","@value":"Académicas dos espíritus"},{"@language":"nl","@value":"Two spirit academici"},{"@language":"nl","@value":"Two spirited academici"},{"@language":"nl","@value":"Two-Spirit onderzoekers"},{"@language":"nl","@value":"Two-Spirit professoren"},{"@language":"nl","@value":"Two-Spirit universiteitsdocenten"},{"@language":"nl","@value":"Two-sprited academici"}],"rdfs:comment":[{"@language":"en","@value":"Two-spirit researchers and/or educators working in higher education.  "},{"@language":"es","@value":"Investigadores y/o educadores dos espíritus que trabajan en la enseñanza superior."},{"@language":"nl","@value":"Two-spirit onderzoekers en/of docenten die werkzaam zijn in het hoger onderwijs."},{"@language":"sv","@value":"Two-spirit-personer som arbetar som forskare och/eller lärare verksamma inom högre utbildning."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001480"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0003263"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2024-05-24"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003380","dc:identifier":"homoit0003380","skos:prefLabel":[{"@language":"en","@value":"Rural Two-Spirit people"},{"@language":"es","@value":"Personas dos espíritus rurales"},{"@language":"nl","@value":"Two-Spirit people in landelijke gebieden"},{"@language":"sv","@value":"Two spirit-personer på landsbygden"}],"skos:altLabel":[{"@language":"en","@value":"2S rural people"},{"@language":"en","@value":"Rural 2S people"},{"@language":"en","@value":"Rural Two Spirit people"},{"@language":"en","@value":"Rural Two Spirited people"},{"@language":"en","@value":"Rural Two-Spirited people"},{"@language":"en","@value":"Two Spirit rural people"},{"@language":"en","@value":"Two Spirited rural people"},{"@language":"en","@value":"Two-Spirit rural people"},{"@language":"en","@value":"Two-Spirited rural people"},{"@language":"es","@value":"Personas rurales dos espíritus"},{"@language":"nl","@value":"Two Spirit people in landelijke gebieden"},{"@language":"nl","@value":"Two Spirited people in landelijke gebieden"},{"@language":"nl","@value":"Two-Spirited people in landelijke gebieden"},{"@language":"sv","@value":"Two spirit-personer i glesbygden"}],"rdfs:comment":[{"@language":"en","@value":"Two-Spirit people who are currently living in or consider themselves to be from agricultural or forested areas with low population densities."},{"@language":"es","@value":"Personas dos espíritus que viven o se consideran originarias de zonas agrícolas o forestales con baja densidad de población."},{"@language":"nl","@value":"Two-Spirit people die momenteel in landbouw- of bosgebieden met een lage bevolkingsdichtheid wonen of zichzelf hiertoe rekenen."},{"@language":"sv","@value":"Two-spirit-personer som bor på landsbygden eller glesbygd, eller har anknytning till landsbygd eller glesbygd."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001480"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0003370"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2024-07-11"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003546","dc:identifier":"homoit0003546","skos:prefLabel":[{"@language":"en","@value":"Two-Spirit students"},{"@language":"nl","@value":"Two-Spirit leerlingen"},{"@language":"sv","@value":"Two-spirit-elever"}],"skos:altLabel":[{"@language":"en","@value":"2S students"},{"@language":"en","@value":"Two Spirited students"},{"@language":"en","@value":"Two-Spirited students"},{"@language":"en","@value":"Two Spirit students"},{"@language":"sv","@value":"Two-spirit-studenter"}],"rdfs:comment":[{"@language":"en","@value":"Two-Spirit people who are formally engaged in learning at an educational institution of some kind."},{"@language":"nl","@value":"Two-Spirit people die formeel een opleiding volgen aan een onderwijsinstelling."},{"@language":"sv","@value":"Two-spirit-personer som formellt deltar i lärande vid någon form av institution för utbildning."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001480"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0003571"},{"@id":"https://homosaurus.org/v5/homoit0003586"},{"@id":"https://homosaurus.org/v5/homoit0003591"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0003533"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2024-09-19"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003619","dc:identifier":"homoit0003619","skos:prefLabel":[{"@language":"en","@value":"Two-Spirit information professionals"},{"@language":"nl","@value":"Two-Spirit informatieprofessionals"},{"@language":"sv","@value":"Informationsspecialister som är Two-spirit"}],"skos:altLabel":[{"@language":"en","@value":"Two Spirit information professionals"},{"@language":"en","@value":"Two-Spirited information professionals"},{"@language":"en","@value":"Two Spirited information professionals"},{"@language":"en","@value":"2s information professionals"}],"rdfs:comment":[{"@language":"en","@value":"Two-Spirit people whose profession involves managing information by collecting, organizing, storing and disseminating it. This can include but is not limited to librarians, archivists, metadata and IT workers, web developers, and chief information officers. Use more specific terms when possible."},{"@language":"nl","@value":"Two-Spirit people wiens beroep het beheren van informatie omvat door het verzamelen, organiseren, opslaan en verspreiden ervan. Dit kan omvatten, maar is niet beperkt tot bibliothecarissen, archivarissen, metadata- en IT-medewerkers, webontwikkelaars en chief information officers. Gebruik specifiekere termen wanneer mogelijk."},{"@language":"sv","@value":"Two-spirit-personer vars yrke innebär att hantera information genom att samla in, organisera, lagra och sprida den. Detta kan inkludera men är inte begränsat till bibliotekarier, arkivarier, metadata- och IT-specialister, webbutvecklare och informationschefer. Använd mer specifika termer när det är möjligt."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001480"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0003556"},{"@id":"https://homosaurus.org/v5/homoit0003627"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0003617"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-22"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003646","dc:identifier":"homoit0003646","skos:prefLabel":[{"@language":"en","@value":"Two-Spirit scientists"},{"@language":"nl","@value":"Two-Spirit wetenschappers"},{"@language":"sv","@value":"Two-spirit-naturvetare"}],"skos:altLabel":[{"@language":"en","@value":"Two-Spirited scientists"},{"@language":"en","@value":"Two Spirit scientists"},{"@language":"en","@value":"2S scientists"},{"@language":"sv","@value":"Two-spirit-personer som är vetenskapare"}],"rdfs:comment":[{"@language":"en","@value":"Two-Spirit people who either study or have expert knowledge in one of the fields of the physical and/or natural sciences, including but not limited to chemists, biologists, physicists, psychologists, and multidisciplinary researchers."},{"@language":"nl","@value":"Two-Spirit people die een studie volgen of deskundige kennis hebben op één van de gebieden van de natuurwetenschappen, waaronder maar niet beperkt tot scheikundigen, biologen, natuurkundigen, psychologen en multidisciplinaire onderzoekers."},{"@language":"sv","@value":"Two-spirit-personer som studerar eller har expertkunskap inom naturvetenskapliga discipliner, inklusive men inte begränsat till kemi, biologi, fysik, psykologi och tvärvetenskaplig forskning."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001480"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0003637"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-22"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003686","dc:identifier":"homoit0003686","skos:prefLabel":[{"@language":"en","@value":"Two-Spirit television personalities"},{"@language":"nl","@value":"Two-Spirit televisiepersoonlijkheden"},{"@language":"sv","@value":"Two-spirit-personer som är tv-profiler"}],"skos:altLabel":[{"@language":"en","@value":"Two-Spirited television personalities"},{"@language":"en","@value":"Two Spirit television personalities"},{"@language":"en","@value":"Two Spirited television personalities"},{"@language":"en","@value":"2S television personalities"},{"@language":"en","@value":"Two-Spirited TV personalities"},{"@language":"en","@value":"Two Spirit TV personalities"},{"@language":"en","@value":"Two Spirited TV personalities"},{"@language":"en","@value":"2S TV personalities"}],"rdfs:comment":[{"@language":"en","@value":"Two-Spirit people who are well-known to the public through their appearances on television shows, typically as themselves rather than in scripted roles."},{"@language":"nl","@value":"Two-Spirit people die bij het publiek bekend zijn door hun optredens in televisieshows, meestal als zichzelf en niet in een voorgeschreven rol."},{"@language":"sv","@value":"Two-spirit-personer som är kända för allmänheten genom sina framträdanden i tv-program, vanligtvis som sig själva snarare än i manusbundna roller."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001480"},{"@id":"https://homosaurus.org/v5/homoit0003903"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0003677"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-22"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003748","dc:identifier":"homoit0003748","skos:prefLabel":[{"@language":"en","@value":"Two-Spirit victims of crime"},{"@language":"nl","@value":"Two-Spirit slachtoffers van misdrijven"},{"@language":"sv","@value":"Two-spirit-personer som är brottsoffer"}],"skos:altLabel":[{"@language":"en","@value":"Two Spirit victims of crime"},{"@language":"en","@value":"Two-Spirited victims of crime"},{"@language":"en","@value":"Two Spirited victims of crime"},{"@language":"en","@value":"2S victims of crime"},{"@language":"en","@value":"Two-Spirit crime victims"}],"rdfs:comment":[{"@language":"en","@value":"Two-Spirit people who have experienced crimes and may or may not have survived. Use more specific terms and follow the individual's preference for \"victims\" or \"survivors\" whenever possible."},{"@language":"nl","@value":"Two-Spirit-people die misdaden hebben meegemaakt en die het misschien wel of niet hebben overleefd. Gebruik specifiekere termen en volg waar mogelijk de voorkeur van het individu voor \"slachtoffers\" of \"overlevenden\"."},{"@language":"sv","@value":"Two-spirit-personer som har utsatts för brott och som kan ha överlevt eller inte. Använd mer specifika termer när det är möjligt och följ individens eget språkbruk om de föredrar offer eller överlevare."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001480"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0002732"},{"@id":"https://homosaurus.org/v5/homoit0002733"},{"@id":"https://homosaurus.org/v5/homoit0002734"},{"@id":"https://homosaurus.org/v5/homoit0002735"},{"@id":"https://homosaurus.org/v5/homoit0003747"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001997"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-30"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003903","dc:identifier":"homoit0003903","skos:prefLabel":[{"@language":"en","@value":"Two-Spirit celebrities"},{"@language":"nl","@value":"Two-Spirit beroemdheden"},{"@language":"sv","@value":"Kändisar som är Two-spirit-personer"}],"skos:altLabel":[{"@language":"en","@value":"Two Spirit celebrities"},{"@language":"en","@value":"Two-Spirited celebrities"},{"@language":"en","@value":"Two Spirited celebrities"},{"@language":"en","@value":"2S celebrities"},{"@language":"en","@value":"Two-Spirit celebs"},{"@language":"en","@value":"Famous Two-Spirit people"},{"@language":"en","@value":"Two-Spirit famous people"},{"@language":"sv","@value":"Kända two-spirit-personer"}],"rdfs:comment":[{"@language":"en","@value":"Two-Spirit people who have achieved fame and broad public recognition due to the attention given to them by mass media."},{"@language":"nl","@value":"Two-Spirit people die roem en brede publieke erkenning hebben verworven dankzij de aandacht die ze krijgen in de massamedia."},{"@language":"sv","@value":"Two-spirit-personer som har uppnått berömmelse och brett offentligt erkännande genom uppmärksamhet i massmedia."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001480"},"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0003686"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0003895"},{"@id":"https://homosaurus.org/v5/homoit0004017"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2025-03-20"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003954","dc:identifier":"homoit0003954","skos:prefLabel":[{"@language":"en","@value":"Two-Spirit dancers"},{"@language":"nl","@value":"Two-Spirit dansers"},{"@language":"sv","@value":"Two-spirit-dansare"}],"skos:altLabel":[{"@language":"en","@value":"Two Spirit dancers"},{"@language":"en","@value":"Two-Spirited dancers"},{"@language":"en","@value":"Two Spirited dancers"},{"@language":"en","@value":"2S dancers"},{"@language":"sv","@value":"Two-spirit-personer som är dansare"}],"rdfs:comment":[{"@language":"en","@value":"Two-Spirit people who dance, either professionally or as a hobby."},{"@language":"sv","@value":"Two-spirit-personer som dansar, professionellt eller som hobby."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001480"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0003946"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2025-04-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003999","dc:identifier":"homoit0003999","skos:prefLabel":[{"@language":"en","@value":"Two-Spirit people in arts and media"},{"@language":"nl","@value":"Two-Spirit people in de kunsten en media"},{"@language":"sv","@value":"Two-spirit-personer inom konst och media"}],"skos:altLabel":[{"@language":"en","@value":"Two Spirit people in arts and media"},{"@language":"en","@value":"Two-Spirited people in arts and media"},{"@language":"en","@value":"Two Spirited people in arts and media"},{"@language":"en","@value":"2S people in arts and media"}],"rdfs:comment":[{"@language":"en","@value":"Umbrella term for the depiction of Two-Spirit people and communities in different forms of creative activity and cultural production, including literature, visual art, and popular media. Use more specific terms if possible."},{"@language":"nl","@value":"Overkoepelende term voor Two-Spirit people en -gemeenschappen in verschillende vormen van creatieve activiteit en culturele productie, waaronder literatuur, beeldende kunst en populaire media. Gebruik indien mogelijk specifiekere termen."},{"@language":"sv","@value":"Paraplyterm för skildringen av two-spirit-personer och two-spirit-grupper i olika former av kreativ aktivitet och kulturell produktion, inklusive litteratur, bildkonst och populärmedia. Använd mer specifika termer om möjligt."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001480"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0004008"},{"@id":"https://homosaurus.org/v5/homoit0004026"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0003991"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2025-04-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004228","dc:identifier":"homoit0004228","skos:prefLabel":[{"@language":"en","@value":"Two-Spirit people with addictions"},{"@language":"nl","@value":"Two-Spirit people met een verslaving"},{"@language":"sv","@value":"Two-spirit-personer med beroende"}],"skos:altLabel":[{"@language":"en","@value":"Two-Spirit addicts"},{"@language":"en","@value":"Two Spirit people with addictions"},{"@language":"en","@value":"Two-Spirited people with addictions"},{"@language":"en","@value":"Two Spirited people with addictions"},{"@language":"en","@value":"2S people with addictions"}],"rdfs:comment":[{"@language":"en","@value":"Umbrella term for Two-Spirit people experiencing addictions, dependencies, or use disorders of some kind. Only use to refer to individuals who describe themselves as having addictions. Apply more specific terms if possible."},{"@language":"nl","@value":"Overkoepelende term voor Two-Spirit people die verslavingen, afhankelijkheid of een of andere soort gebruiksstoornissen ervaren. Alleen gebruiken om te verwijzen naar personen die zichzelf beschrijven als verslaafden. Pas indien mogelijk meer specifieke termen toe."},{"@language":"sv","@value":"Paraplybegrepp för two-spirit-personer som upplever beroendeproblematik, beroende eller substansbrukssyndrom av något slag. Används endast för personer som själva beskriver sig som att de har ett beroende. Mer specifika termer bör användas när det är möjligt."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001480"},{"@id":"https://homosaurus.org/v5/homoit0004225"}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0004229"},{"@id":"https://homosaurus.org/v5/homoit0004230"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001550"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2025-04-24"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004231","dc:identifier":"homoit0004231","skos:prefLabel":[{"@language":"en","@value":"Two-Spirit people practicing sobriety"},{"@language":"nl","@value":"Two-Spirit people die nuchterheid praktiseren"},{"@language":"sv","@value":"Nyktra two-spirit-personer"}],"skos:altLabel":[{"@language":"en","@value":"Two-Spirit sober people"},{"@language":"en","@value":"Two Spirit people practicing sobriety"},{"@language":"en","@value":"Two-Spirited people practicing sobriety"},{"@language":"en","@value":"Two Spirited people practicing sobriety"},{"@language":"en","@value":"2S people practicing sobriety"}],"rdfs:comment":[{"@language":"en","@value":"Two-Spirit people intentionally refraining from substance use (typically drugs or alcohol). Follow the individual's preference for \"sobriety\" or \"recovery\" whenever possible."},{"@language":"nl","@value":"Two-Spirit people die bewust afzien van middelengebruik (meestal drugs of alcohol). Volg waar mogelijk de voorkeur van het individu voor \"nuchterheid\" of \"herstel\""},{"@language":"sv","@value":"Two-spirit-personer som medvetet avstår från att använda substanser (vanligtvis alkohol eller droger). Följ individens eget språkbruk om de föredrar ”nykterhet” eller ”återhämtning”."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001480"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0002228"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2025-04-24"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004232","dc:identifier":"homoit0004232","skos:prefLabel":[{"@language":"en","@value":"Two-Spirit people in recovery"},{"@language":"nl","@value":"Two-Spirit people in herstel"},{"@language":"sv","@value":"Two-spirit-personer i återhämtning"}],"skos:altLabel":[{"@language":"en","@value":"Two Spirit people in recovery"},{"@language":"en","@value":"Two-Spirited people in recovery"},{"@language":"en","@value":"Two Spirited people in recovery"},{"@language":"en","@value":"2S people practicing in recovery"},{"@language":"sv","@value":"Two-spirit-personer i 12-stegsprogram"},{"@language":"sv","@value":"Two-spirit-personer i avvänjning"}],"rdfs:comment":[{"@language":"en","@value":"Two-Spirit people currently in recovery from use disorders, conditions, or addictions. Follow the individual's preference for \"recovery\" or \"sobriety\" whenever possible."},{"@language":"nl","@value":"Two-Spirit people die momenteel herstellen van gebruiksstoornissen, aandoeningen of verslavingen. Volg waar mogelijk de voorkeur van personen voor \"herstel\" of \"nuchterheid\"."},{"@language":"sv","@value":"Two-spirit-personer som befinner sig i återhämtning från substansbrukssyndrom, skadligt bruk eller beroendeproblematik. Följ individens eget språkbruk när det gäller om de föredrar att beskriva sin situation som återhämtning eller nykterhet."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001480"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001549"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2025-04-24"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004233","dc:identifier":"homoit0004233","skos:prefLabel":[{"@language":"en","@value":"Two-Spirit people in recovery groups"},{"@language":"nl","@value":"Two-Spirit people in herstelgroepen"},{"@language":"sv","@value":"Two-spirit-personer i stödgrupper"}],"skos:altLabel":[{"@language":"en","@value":"Two Spirit people in recovery groups"},{"@language":"en","@value":"Two-Spirited people in recovery groups"},{"@language":"en","@value":"Two Spirited people in recovery groups"},{"@language":"en","@value":"2S people practicing in recovery groups"}],"rdfs:comment":[{"@language":"en","@value":"Two-Spirit people who are members of recovery groups, or voluntary associations of people in recovery from use disorders, conditions, or addictions."},{"@language":"nl","@value":"Two-Spirit people die lid zijn van herstelgroepen, of vrijwillige verenigingen van mensen in herstel van gebruik stoornissen, aandoeningen of verslavingen."},{"@language":"sv","@value":"Two-spirit-personer som är medlemmar i stödgrupper, det vill säga frivilliga sammanslutningar av personer som befinner sig i återhämtning från substansbrukssyndrom, skadligt bruk eller beroendeproblematik."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001480"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0002227"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2025-04-24"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003926","dc:identifier":"homoit0003926","skos:prefLabel":[{"@language":"en","@value":"Two-Spirit journalists"},{"@language":"nl","@value":"Two-Spirit journalisten"},{"@language":"sv","@value":"Two-spirit-personer som är journalister"}],"skos:altLabel":[{"@language":"en","@value":"Two Spirit journalists"},{"@language":"en","@value":"Two-Spirited journalists"},{"@language":"en","@value":"Two Spirited journalists"},{"@language":"en","@value":"2S journalists"},{"@language":"sv","@value":"Two spirit-journalister"}],"rdfs:comment":[{"@language":"en","@value":"Two-Spirit people who gather information in the form of text, audio, or pictures, process it into a newsworthy form, and disseminate it to the public."},{"@language":"nl","@value":"Two-Spirit people die informatie verzamelen in de vorm van tekst, audio of afbeeldingen, en deze verwerken tot een nieuwswaardig formaat en verspreiden onder het publiek."},{"@language":"sv","@value":"Two-spirit-personer som samlar information i form av text, ljud eller bilder, bearbetar den till något med nyhetsvärde och sprider det till allmänheten."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001480"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0003864"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2025-03-26"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004355","dc:identifier":"homoit0004355","skos:prefLabel":[{"@language":"en","@value":"Canadian Two-Spirit people"},{"@language":"nl","@value":"Canadese Two-Spirit people"},{"@language":"sv","@value":"Kanadensiska two-spirit-personer"}],"skos:altLabel":[{"@language":"en","@value":"Two-Spirit Canadians"},{"@language":"en","@value":"Two-Spirit Canadian people"},{"@language":"en","@value":"2S Canadians"},{"@language":"en","@value":"2S Canadian people"},{"@language":"en","@value":"Two Spirit Canadians"},{"@language":"en","@value":"Two Spirit Canadian people"},{"@language":"en","@value":"Two Spirited Canadians"},{"@language":"en","@value":"Two Spirited Canadian people"},{"@language":"en","@value":"Two-Spirited Canadians"},{"@language":"en","@value":"Two-Spirited Canadian people"}],"rdfs:comment":[{"@language":"en","@value":"Two-Spirit people who were born, raised, or currently reside in Canada, or who hold Canadian citizenship. Only use to describe people who self-identify as Canadian and Two-Spirit."},{"@language":"nl","@value":"Two-Spirit people die geboren, opgegroeid of momenteel woonachtig zijn in Canada, of die de Canadese nationaliteit bezitten. Deze term wordt uitsluitend gebruikt om personen te beschrijven die zichzelf identificeren als Canadees en Two-Spirit."},{"@language":"sv","@value":"Two-spirit-personer som är födda, uppvuxna eller för närvarande bor i Kanada, eller som har kanadensiskt medborgarskap. Används endast för personer som identifierar sig som kanadensare och two-spirit."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001480"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0004349"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2026-02-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004368","dc:identifier":"homoit0004368","skos:prefLabel":[{"@language":"en","@value":"Two-Spirit brides"},{"@language":"nl","@value":"Two-Spirit bruiden"},{"@language":"sv","@value":"Two-spirit-brudar"}],"skos:altLabel":[{"@language":"en","@value":"Two Spirit brides"},{"@language":"en","@value":"Two Spirited brides"},{"@language":"en","@value":"Two-Spirited brides"},{"@language":"en","@value":"2S brides"},{"@language":"sv","@value":"Brudar som är two-spirit-personer"}],"rdfs:comment":[{"@language":"en","@value":"Two-Spirit people who are getting married and identify as a bride."},{"@language":"nl","@value":"Two-Spirit people die gaan trouwen en zich identificeren als bruid."},{"@language":"sv","@value":"Two-spirit-personer som ska gifta sig och identifierar sig som brudar."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001480"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0004341"},{"@id":"https://homosaurus.org/v5/homoit0004360"},{"@id":"https://homosaurus.org/v5/homoit0004369"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2026-02-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004369","dc:identifier":"homoit0004369","skos:prefLabel":[{"@language":"en","@value":"Two-Spirit grooms"},{"@language":"nl","@value":"Two-Spirit bruidegoms"},{"@language":"sv","@value":"Two-spirit-brudgummar"}],"skos:altLabel":[{"@language":"en","@value":"Two Spirit grooms"},{"@language":"en","@value":"Two Spirited grooms"},{"@language":"en","@value":"Two-Spirited grooms"},{"@language":"en","@value":"2S grooms"},{"@language":"sv","@value":"Brudgummar som är two-spirit-personer"}],"rdfs:comment":[{"@language":"en","@value":"Two-Spirit people who are getting married and identify as a groom."},{"@language":"nl","@value":"Two-Spirit people die gaan trouwen en zich identificeren als bruidegom."},{"@language":"sv","@value":"Two-spirit-personer som ska gifta sig och identifierar sig som brudgummar."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001480"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0004341"},{"@id":"https://homosaurus.org/v5/homoit0004361"},{"@id":"https://homosaurus.org/v5/homoit0004368"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2026-02-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004388","dc:identifier":"homoit0004388","skos:prefLabel":[{"@language":"en","@value":"Two-Spirit shepherds"},{"@language":"nl","@value":"Two-Spirit schaapherders"},{"@language":"sv","@value":"Herdar som är two-spirit-personer"}],"skos:altLabel":[{"@language":"en","@value":"2S shepherds"},{"@language":"en","@value":"Two Spirit shepherds"},{"@language":"en","@value":"Two Spirited shepherds"},{"@language":"en","@value":"Two-Spirited shepherds"}],"rdfs:comment":[{"@language":"en","@value":"Two-Spirit people who tend sheep."},{"@language":"nl","@value":"Two-Spirit people die schapen hoeden."},{"@language":"sv","@value":"Two-spirit-personer som vallar får."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001480"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0004380"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2026-02-24"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004399","dc:identifier":"homoit0004399","skos:prefLabel":[{"@language":"en","@value":"Two-Spirit law students"},{"@language":"nl","@value":"Two-Spirit rechtenstudenten"},{"@language":"sv","@value":"Two-spirit-personer som är juridikstudenter"}],"skos:altLabel":[{"@language":"en","@value":"Two Spirit law students"},{"@language":"en","@value":"Two-Spirited law students"},{"@language":"en","@value":"Two Spirited law students"},{"@language":"en","@value":"2S law students"}],"rdfs:comment":[{"@language":"en","@value":"Two-Spirit people who are studying law at an institution of higher education in preparation to become lawyers."},{"@language":"nl","@value":"Two-Spirit people die rechten studeren aan een instelling voor hoger onderwijs ter voorbereiding op een carrière als advocaat."},{"@language":"sv","@value":"Two-spirit-personer som studerar juridik vid en utbildningsinstitution som förberedelse för att bli jurister."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001480"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0004391"},{"@id":"https://homosaurus.org/v5/homoit0004421"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2026-02-24"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004410","dc:identifier":"homoit0004410","skos:prefLabel":[{"@language":"en","@value":"Two-Spirit cattle herders"},{"@language":"nl","@value":"Two-Spirit veehouders"},{"@language":"sv","@value":"Two-spirit-personer som är nötvallare"}],"skos:altLabel":[{"@language":"en","@value":"Two Spirit cattle herders"},{"@language":"en","@value":"Two Spirited cattle herders"},{"@language":"en","@value":"Two-Spirited cattle herders"},{"@language":"en","@value":"2S cattle herders"},{"@language":"sv","@value":"Two-spirit-personer som vallar kor"}],"rdfs:comment":[{"@language":"en","@value":"Two-Spirit people who tend cattle."},{"@language":"nl","@value":"Two-Spirit people die vee verzorgen."},{"@language":"sv","@value":"Two-spirit-personer som vallar nötboskap."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001480"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0004401"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2026-02-24"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004421","dc:identifier":"homoit0004421","skos:prefLabel":[{"@language":"en","@value":"Two-Spirit lawyers"},{"@language":"nl","@value":"Two-Spirit advocaten"},{"@language":"sv","@value":"Jurister som är two-spirit-personer"}],"skos:altLabel":[{"@language":"en","@value":"Two Spirit lawyers"},{"@language":"en","@value":"Two-Spirited lawyers"},{"@language":"en","@value":"Two Spirited lawyers"},{"@language":"en","@value":"2S lawyers"},{"@language":"sv","@value":"Advokater som är two-spirit-personer"}],"rdfs:comment":[{"@language":"en","@value":"Two-Spirit people who are licensed to provide legal advice, draft legal documents, and represent others in legal matters."},{"@language":"nl","@value":"Two-Spirit people die bevoegd zijn om juridisch advies te geven, juridische documenten op te stellen en anderen te vertegenwoordigen in juridische zaken."},{"@language":"sv","@value":"Two-spirit-personer som har juridisk examen och ger juridisk rådgivning, utarbetar juridiska dokument och företräder andra i juridiska frågor."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001480"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0004414"},{"@id":"https://homosaurus.org/v5/homoit0004399"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2026-02-24"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004438","dc:identifier":"homoit0004438","skos:prefLabel":[{"@language":"en","@value":"Two-Spirit police officers"},{"@language":"nl","@value":"Two-Spirit politieagenten"},{"@language":"sv","@value":"Poliser som är two-spirit-personer"}],"skos:altLabel":[{"@language":"en","@value":"Two Spirit police officers"},{"@language":"en","@value":"Two Spirited police officers"},{"@language":"en","@value":"Two-Spirited police officers"},{"@language":"en","@value":"2S police officers"},{"@language":"en","@value":"Two Spirit cops"},{"@language":"en","@value":"Two Spirited cops"},{"@language":"en","@value":"Two-Spirited cops"},{"@language":"en","@value":"2S cops"},{"@language":"en","@value":"Two-Spirit cops"},{"@language":"sv","@value":"Two-spirit-poliser"}],"rdfs:comment":[{"@language":"en","@value":"Two-Spirit people who are members of a police force. "},{"@language":"nl","@value":"Two-Spirit people die lid zijn van een politiekorps."},{"@language":"sv","@value":"Two-spirit-personer som är poliser."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001480"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0004431"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2026-02-24"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.or