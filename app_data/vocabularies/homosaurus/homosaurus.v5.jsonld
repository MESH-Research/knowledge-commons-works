uage":"es","@value":"Personas LGBTQ+ con dificultades de audición"},{"@language":"es","@value":"Personas LGBTQ+ con dificultades auditivas"},{"@language":"nl","@value":"Slechthorende LHBTQ+-personen"},{"@language":"nl","@value":"Slechthorende personen (LHBTQ+)"}],"rdfs:comment":[{"@language":"en","@value":"LGBTQ+ people with significant or total hearing loss who may or may not consider themselves d/Deaf."},{"@language":"es","@value":"Personas LGBTQ+ con pérdida auditiva significativa o total, que pueden o no considerarse S/sordas."},{"@language":"nl","@value":"LGBTQ+-personen met aanzienlijk of totaal gehoorverlies die zichzelf al dan niet als doof beschouwen"},{"@language":"sv","@value":"Hbtq+-personer med betydande eller total hörselförlust."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001854"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0001861"},{"@id":"https://homosaurus.org/v5/homoit0001862"},{"@id":"https://homosaurus.org/v5/homoit0001863"},{"@id":"https://homosaurus.org/v5/homoit0001864"},{"@id":"https://homosaurus.org/v5/homoit0001865"},{"@id":"https://homosaurus.org/v5/homoit0002785"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001878"},{"@id":"https://homosaurus.org/v5/homoit0002693"},{"@id":"https://homosaurus.org/v5/homoit0004316"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-02-17"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001866","dc:identifier":"homoit0001866","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ Deaf people"},{"@language":"en","@value":"LGBTQ+の聴覚障害者"},{"@language":"es","@value":"Personas LGBTQ+ sordas"},{"@language":"sv","@value":"Döva (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"Deaf people (LGBTQ)"},{"@language":"en","@value":"聴覚障害者（LGBTQ）"},{"@language":"es","@value":"Personas sordas (LGBTQ)"},{"@language":"sv","@value":"Döve hbtq+-personer"}],"rdfs:comment":[{"@language":"en","@value":"LGBTQ+ people with significant or total hearing loss. Some but not all Deaf people prefer to capitalize Deaf in recognition of the cultural and linguistic identity they share with other Deaf people."},{"@language":"es","@value":"Personas LGBTQ+ con pérdida auditiva significativa o total. Algunas personas sordas, pero no todas, prefieren escribir “Sorda/o” con mayúscula  en reconocimiento de la identidad cultural y lingüística que comparten con otras personas sordas."},{"@language":"ja","@value":"重度または完全な聴覚障害を持つLGBTQ+の人々。すべてのろう者というわけではないが、一部のろう者は、他のろう者たちと共有する文化的・言語的アイデンティティを認識し、英語圏では「Deaf」を大文字で表記することを好む傾向がある。"},{"@language":"sv","@value":"Hbtq+-personer med betydande eller total hörselförlust."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001854"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0001867"},{"@id":"https://homosaurus.org/v5/homoit0001868"},{"@id":"https://homosaurus.org/v5/homoit0001869"},{"@id":"https://homosaurus.org/v5/homoit0001870"},{"@id":"https://homosaurus.org/v5/homoit0001871"},{"@id":"https://homosaurus.org/v5/homoit0002784"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001878"},{"@id":"https://homosaurus.org/v5/homoit0002684"},{"@id":"https://homosaurus.org/v5/homoit0004316"}],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2004001342"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-02-17"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001877","dc:identifier":"homoit0001877","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ wheelchair users"},{"@language":"es","@value":"Usuarios LGBTQ+ de sillas de ruedas"},{"@lan