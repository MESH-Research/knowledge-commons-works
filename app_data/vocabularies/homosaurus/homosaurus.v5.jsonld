e":"en","@value":"LGBTQ+ co-mothers"},{"@language":"es","@value":"Co-madres LGBTQ+"},{"@language":"ja","@value":"LGBTQ+の共同親権を持つ母親たち"},{"@language":"nl","@value":"LHBTQ+-meemoeders"},{"@language":"sv","@value":"Medmammor (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"LGBTQ co-mothers"},{"@language":"es","@value":"Co-madres LGBTQ"},{"@language":"es","@value":"Co-mamás LGBTQ"},{"@language":"ja","@value":"LGBTQの共同親権を持つ母親たち"},{"@language":"sv","@value":"Medmödrar (hbtq+)"}],"rdfs:comment":[{"@language":"en","@value":"Co-parenting mothers who are LGBTQ+ people. They may or may not be partners."},{"@language":"es","@value":"Madres coparentales que son personas LGBTQ+. Pueden o no ser pareja."},{"@language":"ja","@value":"LGBTQ+の共同養育を行う母親たち。彼女たちはパートナーである場合もあれば、そうでない場合もある。"},{"@language":"nl","@value":"Co-ouderschap van moeders die LHBTQ+-personen zijn. Ze kunnen al dan niet partners zijn."},{"@language":"sv","@value":"Mammor i medföräldraskap/samföräldraskap som är hbtq+-personer. De kan vara partners eller inte."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000840"},{"@id":"https://homosaurus.org/v5/homoit0001021"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000420"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQCoMothers"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000839","dc:identifier":"homoit0000839","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ co-parenthood"},{"@language":"es","@value":"Co-maternidad y co-paternidad LGBTQ+"},{"@language":"ja","@value":"LGBTQ+の共同養育"},{"@language":"nl","@value":"LHBTQ+-co-ouderschap"},{"@language":"sv","@value":"Medföräldraskap (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"LGBTQ co-parenthood"},{"@language":"es","@value":"Co-paternidad LGBTQ+"},{"@languag