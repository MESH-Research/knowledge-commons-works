urus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-06-27"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002088","dc:identifier":"homoit0002088","skos:prefLabel":[{"@language":"en","@value":"Bengali gay men"},{"@language":"es","@value":"Hombres gay bengalíes"},{"@language":"de","@value":"Bengalische schwule Männer"},{"@language":"nl","@value":"Bengaalse homomannen"},{"@language":"sv","@value":"Bengaliska bögar"}],"skos:altLabel":[{"@language":"en","@value":"Gay Bengali people"},{"@language":"en","@value":"Gay Bengalis"},{"@language":"es","@value":"Bengalíes gay"},{"@language":"de","@value":"Schwule Bengalis"}],"rdfs:comment":[{"@language":"en","@value":"Gay men who speak the Bengali language or are of Bengali descent."},{"@language":"es","@value":"Hombres gay que hablan el idioma bengalí o son de ascendencia bengalí. Correferenciar con hombres gay de Bangladesh cuando una persona es tanto de etnia bengalí como de nacionalidad bangladesí."},{"@language":"de","@value":"Schwule Männer, die die bengalische Sprache sprechen oder bengalischer Abstammung sind."},{"@language":"nl","@value":"Homomannen die de Bengaalse taal spreken en van Bengaalse afkomst zijn. Tevens verwijzing naar Bengaalse homomannen wanneer een persoon zowel de Bengaalse etniciteit als de Bengaalse nationaliteit heeft"},{"@language":"sv","@value":"Bögar som talar bengali eller är av bengalisk härkomst."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002086"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2022-06-27"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002089","dc:identifier"