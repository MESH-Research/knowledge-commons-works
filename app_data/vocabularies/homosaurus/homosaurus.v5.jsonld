"@language":"en","@value":"Trans soccer players"},"rdfs:comment":{"@language":"en","@value":"Transgender people who play soccer. "},"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001933"},{"@id":"https://homosaurus.org/v5/homoit0004561"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2026-06-02"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-02"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004579","dc:identifier":"homoit0004579","skos:prefLabel":{"@language":"en","@value":"Transgender gymnasts"},"skos:altLabel":{"@language":"en","@value":"Trans gymnasts"},"rdfs:comment":{"@language":"en","@value":"Transgender people who perform gymnastics."},"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001933"},{"@id":"https://homosaurus.org/v5/homoit0004571"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2026-06-05"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-05"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004589","dc:identifier":"homoit0004589","skos:prefLabel":{"@language":"en","@value":"Transgender cyclists"},"skos:altLabel":[{"@language":"en","@value":"Trans cyclists"},{"@language":"en","@value":"Transgender bicyclists"},{"@language":"en","@value":"Trans bicyclists"}],"rdfs:comment":{"@language":"en","@value":"Transgender people who ride bicycles."},"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001933"},{"@id":"https://homosaurus.org/v5/homoit0004581"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2026-06-05"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-05"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004598","dc:identifier":"homoit0004598","skos:prefLabel":{"@language":"en","@value":"Transgender ice hockey players"},"skos:altLabel":{"@language":"en","@value":"Trans ice hockey players"},"rdfs:comment":{"@language":"en","@value":"Transgender people who play ice hockey."},"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0004591"},{"@id":"https://homosaurus.org/v5/homoit0001933"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2026-06-08"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-08"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003510","dc:identifier":"homoit0003510","skos:prefLabel":[{"@language":"en","@value":"Sports bans"},{"@language":"es","@value":"Prohibiciones en los deportes"},{"@language":"nl","@value":"Sportverboden"},{"@language":"sv","@value":"Idrottsförbud"}],"skos:altLabel":[{"@language":"en","@value":"Sport bans"},{"@language":"es","@value":"Prohibiciones en el deporte"},{"@language":"sv","@value":"Förbud mot transidrottare"}],"rdfs:comment":[{"@language":"en","@value":"Laws or policies instituted to prevent trans and non-binary individuals from participating in gendered sports leagues or competitions, typically to force players to compete as their sex assigned at birth rather than as their gender. This ranges from criminalizing schools and programs that allow trans and non-binary youth participation to banning players, particularly trans women, from competing in gendered leagues or competitions."},{"@language":"es","@value":"Leyes o políticas instituidas para impedir que las personas trans y no binarias participen en ligas o competencias deportivas clasificadas por género, normalmente para obligar a lxs jugadorxs a competir según su sexo asignado al nacer y no según su identidad de género. Esto va desde la penalización de las escuelas y programas que permiten la participación de jóvenes trans y no binarixs hasta la prohibición de que lxs jugadorxs, especialmente las mujeres trans, compitan en ligas o competencias deportivas clasificadas por género."},{"@language":"nl","@value":"Wetten of beleidsmaatregelen die zijn ingesteld om te voorkomen dat transgender- en non-binaire personen deelnemen aan gendergebonden sportcompetities, doorgaans om spelers te dwingen om uit te gaan van het geslacht dat ze bij geboorte hebben gekregen in plaats van hun gender. Dit varieert van het criminaliseren van scholen en programma's die transgender- en non-binaire jeugddeelname toestaan ​​tot het verbieden van spelers, met name transvrouwen, om deel te nemen aan gendergebonden competities."},{"@language":"sv","@value":"Lagar eller riktlinjer som syftar till att hindra transpersoner och ickebinära från att delta i könsuppdelade idrottsgrenar eller tävlingar. De tvingar ofta deltagare att tävla enligt det kön de tilldelats vid födseln snarare än enligt sin könsidentitet. Det kan handla om allt från att kriminalisera skolor och program som tillåter transungdomars deltagande till att förbjuda särskilt transkvinnor från att delta i könsuppdelade ligor eller tävlingar."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0003499"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001933"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000702"},"dc:issued":{"@type":"xsd:date","@value":"2024-07-31"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004476","dc:identifier":"homoit0004476","skos:prefLabel":[{"@language":"en","@value":"Queer basketball players"},{"@language":"nl","@value":"Queer basketbalspelers"},{"@language":"sv","@value":"Queera basketspelare"}],"rdfs:comment":