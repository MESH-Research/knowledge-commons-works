zt."},{"@language":"es","@value":"Personas no binarias que asisten a la universidad."},{"@language":"nl","@value":"Non-binaire personen die naar de universiteit gaan."},{"@language":"sv","@value":"Ickebinära personer som studerar vid college."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001048"},{"@id":"https://homosaurus.org/v5/homoit0003041"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0003032"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-12-05"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003227","dc:identifier":"homoit0003227","skos:prefLabel":[{"@language":"en","@value":"Pregnant non-binary people"},{"@language":"es","@value":"Personas no binarias embarazadas"},{"@language":"nl","@value":"Zwangere non-binaire personen"},{"@language":"sv","@value":"Gravida ickebinära"}],"skos:altLabel":[{"@language":"en","@value":"Pregnant nonbinary people"},{"@language":"es","@value":"No binarixs embarazadxs"},{"@language":"es","@value":"Embarazadxs no binarixs"}],"rdfs:comment":[{"@language":"en","@value":"Pregnant people who are non-binary."},{"@language":"es","@value":"Personas embarazadas que son no binarias."},{"@language":"nl","@value":"Zwangere personen die non-binair zijn."},{"@language":"sv","@value":"Gravida personer som är ickebinära."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001048"},{"@id":"https://homosaurus.org/v5/homoit0003364"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2024-05-24"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004639","dc:identifier":"homoit0004639","skos:prefLabel":{"@language":"en","@value":"Non-binary women"},"skos:altLabel":{"@language":"en","@value":"Nonbinary women"},"rdfs:comment":{"@language":"en","@value":"Women who are non-binary. Only use to describe people who identify both as women and non-binary."},"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001509"},{"@id":"https://homosaurus.org/v5/homoit0001048"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000560"},"dc:issued":{"@type":"xsd:date","@value":"2026-06-10"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-10"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002185","dc:identifier":"homoit0002185","skos:prefLabel":[{"@language":"en","@value":"Non-binary people in fandom"},{"@language":"es","@value":"Personas no binarias en fandom"},{"@language":"nl","@value":"Non-binaire personen in fandom"},{"@language":"sv","@value":"Ickebinära personer inom fandom"}],"skos:altLabel":{"@language":"en","@value":"Nonbinary people in fandom"},"rdfs:comment":[{"@language":"en","@value":"The participation and inclusion of non-binary people in fan communities."},{"@language":"es","@value":"La participación e inclusión de personas no binarias en las comunidades de fans."},{"@language":"nl","@value":"De participatie en inclusie van non-binaire personen in fan-gemeenschappen"},{"@language":"sv","@value":"Ickebinära personers deltagande och inkludering i fangemenskaper."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0002171"},{"@id":"https://homosaurus.org/v5/homoit0002181"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001048"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004617","dc:identifier":"homoit0004617","skos:prefLabel":{"@language":"en","@value":"Androgyne"},"rdfs:comment":{"@language":"en","@value":"A gender identity which includes both masculine and feminine expression, or sometimes neither. This term was more commonly used in the 20th century."},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001048"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0004617"},"dc:issued":{"@type":"xsd:date","@value":"2026-06-08"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-08"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001062","dc:identifier":"homoit0001062","skos:prefLabel":[{"@language":"en","@value":"Orgasms"},{"@language":"es","@value":"Orgasmo"},{"@language":"nl","@value":"Orgasmes"},{"@language":"sv","@value":"Orgasm"}],"skos:altLabel":{"@language":"en","@value":"Climaxes"},"rdfs:comment":[{"@language":"en","@value":"Climaxes of sexual excitement, typically characterized by feelings of pleasure and physical sensations including rapid muscle contractions, higher blood pressure and heart rate, release of endorphins, and ejaculation."},{"@language":"es","@value":"Clímax de la excitación sexual, típicamente caracterizado por sentimientos de placer y sensaciones físicas que incluyen contracciones musculares rápidas, presión arterial y frecuencia cardíaca más altas, liberación de endorfinas y eyaculación."},{"@language":"nl","@value":"Climaxen van seksuele opwinding, typisch gekenmerkt door gevoelens van plezier en fysieke gewaarwordingen, waaronder snelle spiercontracties, hogere bloeddruk en hartslag, afgifte van endorfine en ejaculatie."},{"@language":"sv","@value":"Klimax av sexuell upphetsning, vanligtvis kännetecknat av njutning, muskelkontraktioner, ökad puls och blodtryck, endorfinfrisättning och eventuell ejakulation."}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh85095593"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001062"},"dc:replaces":{"@id":"http://homosaurus.org/v2/orgasm"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002392","dc:identifier":"homoit0002392","skos:prefLabel":[{"@language":"en","@value":"Identification of LGBTQ+ people by police"},{"@language":"es","@value":"Identificación de personas LGBTQ+ por la policía"},{"@language":"nl","@value":"Identificatie van LHBTQ+-personen door de politie"},{"@language":"sv","@value":"Polisiär identifiering av hbtq+-personer"}],"rdfs:comment":[{"@language":"en","@value":"Identification of LGBTQ+ people, or people believed to be LGBTQ+, by police using any of various tools and mechanisms, many of which are pseudoscientific in nature. Such data is then used to entrap and prosecute LGBTQ+ persons, especially in areas where being LGBTQ+ is still criminalized."},{"@language":"es","@value":"Identificación de personas LGBTQ+, o personas que se cree que son LGBTQ+, por parte de la policía utilizando cualquiera de diversas herramientas y mecanismos, muchas de los cuales son de naturaleza pseudocientífica. Luego, esos datos se utilizan para atrapar y procesar a personas LGBTQ+, especialmente en áreas donde ser LGBTQ+ todavía está criminalizado."},{"@language":"nl","@value":"Identificatie van LHBTQ+-personen, of personen waarvan wordt aangenomen dat ze LHBTQ+ zijn, door de politie met behulp van verschillende instrumenten en mechanismen, waarvan er vele pseudowetenschappelijk van aard zijn. Dergelijke gegevens worden vervolgens gebruikt om LHBTQ+-personen in de val te lokken en te vervolgen, vooral in gebieden waar LHBTQ+-zijn nog steeds strafbaar is."},{"@language":"sv","@value":"Identifiering av hbtq+-personer, eller personer som tros vara hbtq+, av polis med hjälp av olika metoder, varav många saknar vetenskaplig grund. Informationen används för att övervaka, gripa eller lagföra hbtq+-personer, särskilt i regioner där hbtq+-identiteter är kriminaliserade."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002373"},"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0002393"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001065"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0002373"},"dc:issued":{"@type":"xsd:date","@value":"2023-01-13"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001068","dc:identifier":"homoit0001068","skos:prefLabel":[{"@language":"en","@value":"Spanking paddles"},{"@language":"es","@value":"Paletas para nalgadas"},{"@language":"nl","@value":"Spanking paddles"},{"@language":"sv","@value":"Smiskpaddlar"}],"skos:altLabel":[{"@language":"sv","@value":"Paddlar (BDSM)"},{"@language":"sv","@value":"Sexpaddlar"},{"@language":"sv","@value":"Spanking paddles"}],"rdfs:comment":[{"@language":"en","@value":"A tool with a short handle at one end and a wide, flat surface at the other that is used to strike the buttocks as a form of impact play."},{"@language":"es","@value":"Herramienta con un mango corto en un extremo y una superficie ancha y plana en el otro que se utiliza para golpear las nalgas como forma de juego de impacto."},{"@language":"nl","@value":"Een hulpmiddel met een korte steel aan de ene kant en een breed, plat oppervlak aan de andere kant, waarmee je op de billen kunt slaan als vorm van impactspel."},{"@language":"sv","@value":"Ett redskap med kort handtag i ena änden och en bred, platt yta i den andra, som används för att slå på skinkorna vid impact play."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001266"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001335"},{"@id":"https://homosaurus.org/v5/homoit0003075"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001266"},"dc:replaces":{"@id":"http://homosaurus.org/v2/spankingPaddles"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001193","dc:identifier":"homoit0001193","skos:prefLabel":[{"@language":"en","@value":"Queer Pagans"},{"@language":"es","@value":"Paganos queer"},{"@language":"nl","@value":"Queer paganisten"},{"@language":"sv","@value":"Queera hedningar"}],"skos:altLabel":{"@language":"sv","@value":"Queera nyhedningar"},"rdfs:comment":[{"@language":"en","@value":"Queer people who are members of polytheistic religions or other religions outside of the dominant culture that typically incorporate nature worship and/or the sacred feminine, such as Wicca, Druidry, Heathenry, etc. Use to describe queer people who self-identify as Pagan."},{"@language":"es","@value":"Personas queer que son miembros de religiones politeístas u otras religiones fuera de la cultura dominante que típicamente incorporan el culto a la naturaleza y/o lo sagrado femenino, como la Wicca, el druidismo, el paganismo, etc. Utilícese para describir a las personas queer que se autoidentifiquen como paganas."},{"@language":"nl","@value":"Queer personen die lid zijn van polytheïstische religies of andere religies buiten de dominante cultuur die natuuraanbidding en/of het heilige vrouwelijke incorporeren, zoals Wicca, Druidendom, Heidendom, enz. Gebruik om queer personen te beschrijven die zichzelf identificeren als Paganistisch."},{"@language":"sv","@value":"Queera personer som tillhör polyteistiska religioner, eller andra religioner utanför den dominerande kulturen, som ofta innefattar naturdyrkan och/eller det heliga feminina, såsom wicca, druidism, hednisk tro m.m. Används för queera personer som själva identifierar sig som hedningar."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001069"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001912"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000928"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerPagans"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001429","dc:identifier":"homoit0001429","skos:prefLabel":[{"@language":"en","@value":"Transgender Pagans"},{"@language":"es","@value":"Paganos transgénero"},{"@language":"nl","@value":"Transgender paganisten"},{"@language":"sv","@value":"Hedniska transpersoner"}],"skos:altLabel":[{"@language":"es","@value":"Paganos trans"},{"@language":"sv","@value":"Nyhedniska transpersoner"}],"rdfs:comment":[{"@language":"en","@value":"Transgender people who are members of polytheistic religions or other religions outside of the dominant culture that typically incorporate nature worship and/or the sacred feminine, such as Wicca, Druidry, Heathenry, etc. Use to describe transgender people who self-identify as Pagan."},{"@language":"es","@value":"Personas transgénero que son miembros de religiones politeístas u otras religiones fuera de la cultura dominante que típicamente incorporan el culto a la naturaleza y/o lo sagrado femenino, como la Wicca, el druidismo, el paganismo, etc. Utilícese para describir a las personas transgénero que se autoidentifican como paganas."},{"@language":"nl","@value":"Transgender personen die lid zijn van polytheïstische religies of andere religies buiten de dominante cultuur die natuuraanbidding en/of het heilige vrouwelijke incorporeren, zoals Wicca, Druidendom, Heidendom, enz. Gebruik om transgender personen te beschrijven die zichzelf identificeren als Paganistisch."},{"@language":"sv","@value":"Transpersoner som tillhör polyteistiska religioner, eller andra religioner utanför den dominerande kulturen, som ofta innefattar naturdyrkan och/eller det heliga feminina, såsom wicca, druidism, hednisk tro m.m. Används för transpersoner som själva identifierar sig som hedningar."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001069"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001911"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000928"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transgenderPagans"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002977","dc:identifier":"homoit0002977","skos:prefLabel":[{"@language":"en","@value":"Intersex Pagans"},{"@language":"de","@value":"Inter* Heid:innen"},{"@language":"es","@value":"Paganos intersexuales"},{"@language":"nl","@value":"Intersekse paganisten"},{"@language":"sv","@value":"Hedniska intersexpersoner"}],"skos:altLabel":[{"@language":"de","@value":"Inter* heidnische Personen"},{"@language":"es","@value":"Paganos intersex"},{"@language":"sv","@value":"Nyhedniska intersexpersoner"}],"rdfs:comment":[{"@language":"en","@value":"Intersex people who are members of polytheistic religions or other religions outside of the dominant culture that typically incorporate nature worship and/or the sacred feminine, such as Wicca, Druidry, Heathenry, etc. Use to describe intersex people who self-identify as Pagan."},{"@language":"de","@value":"Inter* Personen, die polytheistischen Religionen oder anderen Religionen ausserhalb der vorherrschenden Kultur angehören, die typischerweise die Naturverehrung und/oder das heilige Weibliche beinhalten, wie Wicca, Druidentum, Heidentum usw. Wird verwendet, um inter* Personen zu beschreiben, die sich selbst als heidnisch bezeichnen."},{"@language":"es","@value":"Personas intersex que son miembros de religiones politeístas u otras religiones fuera de la cultura dominante que típicamente incorporan el culto a la naturaleza y/o lo sagrado femenino, como la Wicca, el druidismo, el paganismo, etc. Utilícese para describir a las personas intersex que se autoidentifican como paganas."},{"@language":"nl","@value":"Intersekse personen die lid zijn van polytheïstische religies of andere religies buiten de dominante cultuur die natuuraanbidding en/of het heilige vrouwelijke incorporeren, zoals Wicca, Druidendom, Heidendom, enz. Gebruik om intersekse personen te beschrijven die zichzelf identificeren als Paganistisch."},{"@language":"sv","@value":"Intersexpersoner som tillhör polyteistiska religioner, eller andra religioner utanför den dominerande kulturen, som ofta innefattar naturdyrkan och/eller det heliga feminina, såsom wicca, druidism, hednisk tro m.m. Används för intersexpersoner som själva identifierar sig som hedningar."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001069"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000928"},"dc:issued":{"@type":"xsd:date","@value":"2023-09-29"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002983","dc:identifier":"homoit0002983","skos:prefLabel":[{"@language":"en","@value":"Asexual Pagans"},{"@language":"es","@value":"Paganos asexuales"},{"@language":"de","@value":"Axexuelle Heid:innen"},{"@language":"nl","@value":"Aseksuele paganisten"},{"@language":"sv","@value":"Asexuella hedningar"}],"skos:altLabel":[{"@language":"de","@value":"Asexuelle Heiden"},{"@language":"de","@value":"Asexuelle Heidinnen"},{"@language":"de","@value":"Asexuelle heidnische Personen"},{"@language":"de","@value":"Ace Heid:innen"},{"@language":"de","@value":"Heidnische ace Personen"},{"@language":"sv","@value":"Asexuella nyhedningar"}],"rdfs:comment":[{"@language":"en","@value":"Asexual people who are members of polytheistic religions or other religions outside of the dominant culture that typically incorporate nature worship and/or the sacred feminine, such as Wicca, Druidry, Heathenry, etc. Use to describe asexual people who self-identify as Pagan."},{"@language":"es","@value":"Personas asexuales que son miembros de religiones politeístas u otras religiones fuera de la cultura dominante que típicamente incorporan el culto a la naturaleza y/o a lo sagrado femenino, tal como la wicca, el druidismo, el paganismo, etc. Utilícese para describir a las personas asexuales que se autoidentifiquen como paganas."},{"@language":"de","@value":"Asexuelle Menschen, die polytheistischen Religionen oder anderen Religionen ausserhalb der vorherrschenden Kultur angehören, die typischerweise die Naturverehrung und/oder das heilige Weibliche beinhalten, wie Wicca, Druidentum, Heidentum usw. Wird verwendet, um asexuelle Personen zu beschreiben, die sich selbst als heidnisch bezeichnen."},{"@language":"sv","@value":"Asexuella som tillhör polyteistiska religioner, eller andra religioner utanför den dominerande kulturen, som ofta innefattar naturdyrkan och/eller det heliga feminina, såsom wicca, druidism, hednisk tro m.m. Används för asexuella som själva identifierar sig som hedningar."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001069"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000928"},"dc:issued":{"@type":"xsd:date","@value":"2023-10-27"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001926","dc:identifier":"homoit0001926","skos:prefLabel":[{"@language":"en","@value":"Pansexuality"},{"@language":"es","@value":"Pansexualidad"},{"@language":"nl","@value":"Panseksualiteit"},{"@language":"sv","@value":"Pansexualitet"}],"rdfs:comment":[{"@language":"en","@value":"Sexual identity used to describe sexual and/or romantic attraction to people of all genders."},{"@language":"es","@value":"Identidad sexual utilizada para describir la atracción sexual y/o romántica hacia personas de todos los géneros."},{"@language":"nl","@value":"Seksuele identiteit die wordt gebruikt om seksuele en/of romantische aantrekking tot mensen van alle genders te beschrijven"},{"@language":"sv","@value":"Sexuell identitet som beskriver sexuell och/eller romantisk attraktion till personer oavsett kön."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001295"},{"@id":"https://homosaurus.org/v5/homoit0001298"},{"@id":"https://homosaurus.org/v5/homoit0001558"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001073"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001295"},"dc:issued":{"@type":"xsd:date","@value":"2022-03-31"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001077","dc:identifier":"homoit0001077","skos:prefLabel":[{"@language":"en","@value":"Parents of queer people"},{"@language":"es","@value":"Madres y padres de personas queer"},{"@language":"fr","@value":"Parents de personnes queers"},{"@language":"nl","@value":"Ouders van queer personen"},{"@language":"sv","@value":"Föräldrar till queera personer"}],"skos:altLabel":[{"@language":"en","@value":"Queer people's parents"},{"@language":"es","@value":"Madres de personas queer"},{"@language":"es","@value":"Padres de personas queer"}],"rdfs:comment":[{"@language":"en","@value":"People who act as parents to one or more queer person. For parents who are themselves queer, use the term \"Queer parents.\""},{"@language":"es","@value":"Personas que actúan como padres de una o más personas queer. Para los padres que son queer, utilice el término \"madres y padres queer\"."},{"@language":"fr","@value":"Personnes qui assument le rôle de parent auprès d'une personne queer."},{"@language":"nl","@value":"Personen die een ouderlijke rol op zich nemen voor een queer persoon of mensen; omvat biologische, adoptie- en gekozen ouders"},{"@language":"sv","@value":"Personer som fungerar som föräldrar till en eller flera queera personer. För föräldrar som själva är queera, använd termen ”Queera föräldrar”."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002224"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001195"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000421"},"dc:replaces":{"@id":"http://homosaurus.org/v2/parentsOfQueerPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001078","dc:identifier":"homoit0001078","skos:prefLabel":[{"@language":"en","@value":"Parents of transgender people"},{"@language":"es","@value":"Padres y madres de personas transgénero"},{"@language":"fr","@value":"Parents de personnes trans"},{"@language":"nl","@value":"Ouders van transgender personen"},{"@language":"sv","@value":"Föräldrar till transpersoner"}],"skos:altLabel":[{"@language":"en","@value":"Transgender people's parents"},{"@language":"es","@value":"Padres de personas transgénero"},{"@language":"es","@value":"Madres de personas transgénero"}],"rdfs:comment":[{"@language":"en","@value":"People who act as parents to one or more transgender person. For parents who are themselves transgender, use the term \"Transgender parents.\""},{"@language":"es","@value":"Personas que actúan como padres de una o más personas transgénero. Para los padres que son transgénero, utilice el término \"madres y padres transgénero\"."},{"@language":"fr","@value":"Personnes qui assument le rôle de parent auprès d'une personne trans."},{"@language":"nl","@value":"Personen die een ouderrol op zich nemen voor een transgender persoon of personen; omvat biologische, adoptie- en gekozen ouders"},{"@language":"sv","@value":"Personer som fungerar som föräldrar till en eller flera transpersoner. För föräldrar som själva är trans, använd termen ”Transföräldrar”."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002224"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001378"},"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2016000194"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000421"},"dc:replaces":{"@id":"http://homosaurus.org/v2/parentsOfTransgenderPeople"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001080","dc:identifier":"homoit0001080","skos:prefLabel":[{"@language":"en","@value":"Partner notification"},{"@language":"es","@value":"Notificación a la pareja"},{"@language":"nl","@value":"Partnernotificatie"},{"@language":"sv","@value":"Smittspårning"}],"skos:altLabel":[{"@language":"es","@value":"Partner notification"},{"@language":"sv","@value":"Närståendeupplysning"}],"rdfs:comment":[{"@language":"en","@value":"The practice of notifying the sexual partners of a person who has been newly diagnosed with a sexually transmitted infection to inform them that they have been exposed to the infection."},{"@language":"es","@value":"La práctica de notificar a las parejas sexuales de una persona a la que se le ha diagnosticado recientemente una infección de transmisión sexual para informarles que han estado expuestas a la infección."},{"@language":"nl","@value":"het op de hoogte brengen van de seksuele partners van een persoon die gediagnosticeerd is met een seksueel overdraagbare aandoening, dat zij blootgesteld kunnen zijn aan de infectie"},{"@language":"sv","@value":"Att meddela sexuella partners till en person som nyligen fått en sexuellt överförbar infektion diagnostiserad att de kan ha exponerats för smittan. I Sverige regleras detta i Smittskyddslagen för vissa sjukdomar och den meddelade parten har krav på att testa sig."}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001302"},{"@id":"https://homosaurus.org/v5/homoit0001308"},{"@id":"https://homosaurus.org/v5/homoit0001311"},{"@id":"https://homosaurus.org/v5/homoit0002365"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001080"},"dc:replaces":{"@id":"http://homosaurus.org/v2/partnerNotification"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002365","dc:identifier":"homoit0002365","skos:prefLabel":[{"@language":"en","@value":"Partners"},{"@language":"es","@value":"Parejas"},{"@language":"nl","@value":"Partners"},{"@language":"sv","@value":"Partners"}],"rdfs:comment":[{"@language":"en","@value":"People who share a romantic, sexual, or play partnership with another person or people."},{"@language":"es","@value":"Personas que comparten una relación romántica, sexual o de juego con otra persona o personas."},{"@language":"nl","@value":"Personen die een romantisch, seksueel of speel partnerschap delen met een andere persoon of personen."},{"@language":"sv","@value":"Personer som har en romantisk, sexuell eller kinkbaserad relation med en eller flera andra personer."}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0001083"},{"@id":"https://homosaurus.org/v5/homoit0001085"},{"@id":"https://homosaurus.org/v5/homoit0001635"},{"@id":"https://homosaurus.org/v5/homoit0001638"},{"@id":"https://homosaurus.org/v5/homoit0001645"},{"@id":"https://homosaurus.org/v5/homoit0001657"},{"@id":"https://homosaurus.org/v5/homoit0002366"},{"@id":"https://homosaurus.org/v5/homoit0002717"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001080"},{"@id":"https://homosaurus.org/v5/homoit0001081"},{"@id":"https://homosaurus.org/v5/homoit0001082"},{"@id":"https://homosaurus.org/v5/homoit0001311"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0002365"},"dc:issued":{"@type":"xsd:date","@value":"2022-12-13"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002255","dc:identifier":"homoit0002255","skos:prefLabel":[{"@language":"en","@value":"Polygamous people"},{"@language":"es","@value":"Personas polígamas"},{"@language":"nl","@value":"Polygame personen"},{"@language":"sv","@value":"Polygama personer"}],"rdfs:comment":[{"@language":"en","@value":"Individuals who engage in relationships in which the dominant partner has multiple spouses, though the marriages are not typically recognized by society or law."},{"@language":"es","@value":"Personas que entablan relaciones en las que la pareja dominante tiene múltiples cónyuges, aunque los matrimonios no suelen ser reconocidos por la sociedad o la ley."},{"@language":"nl","@value":"Personen die relaties aangaan waarin de dominante partner meerdere echtgenoten heeft, hoewel de huwelijken doorgaans niet worden erkend door de samenleving of de wet"},{"@language":"sv","@value":"Personer som ingår i relationer där den dominerande partnern har flera makar, även om dessa äktenskap vanligtvis inte erkänns juridiskt eller socialt."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001637"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0001081"},{"@id":"https://homosaurus.org/v5/homoit0001123"},{"@id":"https://homosaurus.org/v5/homoit0001124"},{"@id":"https://homosaurus.org/v5/homoit0001629"},{"@id":"https://homosaurus.org/v5/homoit0001659"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001637"},"dc:issued":{"@type":"xsd:date","@value":"2022-09-09"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002367","dc:identifier":"homoit0002367","skos:prefLabel":[{"@language":"en","@value":"Lesbian partners"},{"@language":"es","@value":"Parejas lésbicas de otras personas"},{"@language":"nl","@value":"Lesbische partners"},{"@language":"sv","@value":"Lesbiska partners"}],"rdfs:comment":[{"@language":"en","@value":"Lesbians who are the romantic, sexual, or play partners of another person or people."},{"@language":"es","@value":"Lesbianas que son compañeras románticas, sexuales o de juego de otra persona o personas."},{"@language":"nl","@value":"Lesbische vrouwen die de romantische, seksuele of speelpartners zijn van een andere persoon of personen."},{"@language":"sv","@value":"Lesbiska som har en romantisk, sexuell eller kinkbaserad relation med en eller flera andra personer."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001083"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000420"},"dc:issued":{"@type":"xsd:date","@value":"2022-12-13"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002368","dc:identifier":"homoit0002368","skos:prefLabel":[{"@language":"en","@value":"Gay partners"},{"@language":"de","@value":"Schwule Partner"},{"@language":"es","@value":"Parejas gay de otras personas"},{"@language":"nl","@value":"Homopartners"},{"@language":"sv","@value":"Bögpartners"}],"skos:altLabel":[{"@language":"sv","@value":"Gaypartners"},{"@language":"sv","@value":"Homosexuella manliga partners"}],"rdfs:comment":[{"@language":"en","@value":"Gay men who are the romantic, sexual, or play partners of another person or people."},{"@language":"de","@value":"Schwule Männer, die romantische, sexuelle oder Spielpartner einer anderen Person oder anderer Personen sind."},{"@language":"es","@value":"Hombres gay que son pareja pareja romántica, sexual o de juegos de otra persona o personas."},{"@language":"nl","@value":"Homomannen die de romantische, seksuele of speelpartners zijn van een andere persoon of personen."},{"@language":"sv","@value":"Bögar som har en romantisk, sexuell eller kinkbaserad relation med en eller flera andra personer."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001083"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000420"},"dc:issued":{"@type":"xsd:date","@value":"2022-12-13"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002369","dc:identifier":"homoit0002369","skos:prefLabel":[{"@language":"en","@value":"Bisexual partners"},{"@language":"de","@value":"Bisexuelle Partner:innen"},{"@language":"es","@value":"Parejas bisexuales"},{"@language":"nl","@value":"Biseksuele partners"},{"@language":"sv","@value":"Bisexuella partners"}],"rdfs:comment":[{"@language":"en","@value":"Bisexual people who are the romantic, sexual, or play partners of another person or people."},{"@language":"de","@value":"Bisexuelle Menschen, die Liebes-, Sexual- oder Spielpartner:innen einer anderen Person oder mehrerer Personen sind."},{"@language":"es","@value":"Personas bisexuales que son las parejas románticas, sexuales o de juego de otra persona o personas."},{"@language":"nl","@value":"Biseksuele personen die de romantische, seksuele of speelpartners zijn van een andere persoon of personen."},{"@language":"sv","@value":"Bisexuella personer som har en romantisk, sexuell 