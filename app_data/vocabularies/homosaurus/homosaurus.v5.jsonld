nary pride"},{"@language":"sv","@value":"Ickebinär pride"}],"rdfs:comment":[{"@language":"en","@value":"The recognition and celebration of non-binary people and culture, thereby affirming the visibility, dignity, and diversity of non-binary communities."},{"@language":"nl","@value":"De erkenning en viering van non-binaire personen en cultuur, waarmee de zichtbaarheid, waardigheid en diversiteit van non-binaire gemeenschappen wordt bevestigd."},{"@language":"sv","@value":"Firande och synliggörande av ickebinära personer och ickebinär kultur, vilket därmed bekräftar synlighet, värdighet och mångfalden i ickebinära gemenskaper."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0003653"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0003653"},"dc:issued":{"@type":"xsd:date","@value":"2025-04-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003944","dc:identifier":"homoit0003944","skos:prefLabel":[{"@language":"en","@value":"Asexual pride"},{"@language":"nl","@value":"Asexual pride"},{"@language":"sv","@value":"Asexuell stolthet"}],"skos:altLabel":[{"@language":"en","@value":"Ace pride"},{"@language":"sv","@value":"Asexuell pride"}],"rdfs:comment":[{"@language":"en","@value":"The recognition and celebration of asexual people and culture, thereby affirming the visibility, dignity, and diversity of asexual communities."},{"@language":"nl","@value":"De erkenning en viering van aseksuele personen en cultuur, waarmee de zichtbaarheid, waardigheid en diversiteit van aseksuele gemeenschappen wordt bevestigd."},{"@language":"sv","@value":"Firande och synliggörande av asexuella personer och asexuell kultur, vilket därmed bekräftar synlighet, värdighet och mångfalden i queera gemenskaper."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0003653"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0003653"},"dc:issued":{"@type":"xsd:date","@value":"2025-04-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003945","dc:identifier":"homoit0003945","skos:prefLabel":[{"@language":"en","@value":"Two-Spirit pride"},{"@language":"nl","@value":"Two-Spirit pride"},{"@language":"sv","@value":"Two-spirit-stolthet"}],"skos:altLabel":[{"@language":"en","@value":"Two Spirit pride"},{"@language":"en","@value":"Two-Spirited pride"},{"@language":"en","@value":"Two Spirited pride"},{"@language":"en","@value":"2S pride"},{"@language":"sv","@value":"Two-spirit-pride"}],"rdfs:comment":[{"@language":"en","@value":"The recognition and celebration of Two-Spirit people and culture, thereby affirming the visibility, dignity, and diversity of Two-Spirit communities."},{"@language":"nl","@value":"De erkenning en viering van Two-Spirit people en cultuur, waarmee de zichtbaarheid, waardigheid en diversiteit van Two-Spirit gemeenschappen wordt bevestigd."},{"@language":"sv","@value":"Firande och synliggörande av two-spirit-personer och two-spirit-kultur, vilket därmed bekräftar synlighet, värdighet och mångfalden i two-spirit-gemenskaper."}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0003653"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0003945"},"dc:issued":{"@type":"xsd:date","@value":"2025-04-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003658","dc:identifier":"homoit0003658","skos:prefLabel":[{"@language":"en","@value":"Intersex-affirming care"},{"@language":"nl","@value":"Intersekse-bevestigende zorg"},{"@language":"sv","@value":"Intersexbekräftande vård"}],"skos:altLabel":{"@language":"en","@value":"Intersex affirming care"},"rdfs:comment":[{"@language":"en","@value":"Social, psychological, behavioral, and medical interventions designed to support and affirm individuals belonging to the intersex community. Intersex-affirming care includes but is not limited to equal access to health care facilities, access to medical records and information about one's intersex status and traits, and informed consent regarding medical procedures or treatments related to intersex traits."},{"@language":"nl","@value":"Sociale, psychologische, gedragsmatige en medische interventies die zijn ontworpen om personen die tot de interseksegemeenschap behoren te ondersteunen en te bevestigen. Intersekse-bevestigende zorg omvat, maar is niet beperkt tot, gelijke toegang tot gezondheidszorgfaciliteiten, toegang tot medische dossiers en informatie over iemands interseksestatus en -kenmerken, en geïnformeerde toestemming met betrekking tot medische procedures of behandelingen met betrekking tot intersekse-kenmerken."},{"@language":"sv","@value":"Sociala, psykologiska, beteenderelaterade och medicinska insatser som syftar till att stödja och bekräfta personer som tillhör intersexgemenskapen. Intersexbekräftande vård omfattar bland annat likvärdig tillgång till hälso- och sjukvård, tillgång till medicinska journaler och information om den egna intersexstatusen och intersexdrag, samt informerat samtycke vid medicinska ingrepp eller behandlingar som rör intersexdrag."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0003657"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000614"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-22"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003659","dc:identifier":"homoit0003659","skos:prefLabel":[{"@language":"en","@value":"Transgender-affirming care"},{"@language":"nl","@value":"Transgenderbevestigende zorg"},{"@language":"sv","@value":"Transbekräftande vård"}],"skos:altLabel":[{"@language":"en","@value":"Trans-affirming care"},{"@language":"en","@value":"Transgender affirming care"},{"@language":"en","@value":"Trans affirming care"}],"rdfs:comment":[{"@language":"en","@value":"Social, psychological, behavioral, and medical interventions designed to support and affirm a transgender individual's gender identity. Transgender-affirming care includes but is not limited to equal access to health care facilities, counseling, puberty blockers, hormone therapy, and gender-affirming surgeries. It can also include resources to aid in social transition, such as affirming policies regarding name and pronoun changes, access to non-gendered restrooms and facilities, etc."},{"@language":"nl","@value":"Sociale, psychologische, gedragsmatige en medische interventies die zijn ontworpen om de genderidentiteit van een transgender persoon te ondersteunen en te bevestigen. Transgender-bevestigende zorg omvat, maar is niet beperkt tot, gelijke toegang tot gezondheidszorgfaciliteiten, counseling, puberteitsremmers, hormoontherapie en genderbevestigende operaties. Het kan ook middelen omvatten om te helpen bij de sociale transitie, zoals het bevestigen van beleid met betrekking tot naam- en voornaamwoordveranderingen, toegang tot niet-gendergebonden toiletten en faciliteiten, etc."},{"@language":"sv","@value":"Sociala, psykologiska, beteendemässiga och medicinska insatser som syftar till att stödja och bekräfta en transpersons könsidentitet. Transbekräftande vård innefattar men begränsas inte till jämlik tillgång till vård, samtalsstöd, pubertetsblockerare, hormonbehandling och könsbekräftande kirurgi. Det kan också inkludera resurser för social transition såsom policyer för namn- och pronomenändring samt tillgång till könsneutrala toaletter och utrymmen."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0003657"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000614"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-22"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003664","dc:identifier":"homoit0003664","skos:prefLabel":[{"@language":"en","@value":"Lesbian poets"},{"@language":"nl","@value":"Lesbische dichters"},{"@language":"sv","@value":"Lesbiska poeter"}],"rdfs:comment":[{"@language":"en","@value":"Creators of written or spoken verse who identify as lesbian."},{"@language":"nl","@value":"Auteurs van geschreven of gesproken gedichten die zich identificeren als lesbisch."},{"@language":"sv","@value":"Skapare av poesi som identifierar sig som lesbiska."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0003663"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-22"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003665","dc:identifier":"homoit0003665","skos:prefLabel":[{"@language":"en","@value":"Gay poets"},{"@language":"nl","@value":"Homo-dichters"},{"@language":"sv","@value":"Bögpoeter"}],"skos:altLabel":{"@language":"sv","@value":"Homosexuella manliga poeter"},"rdfs:comment":[{"@language":"en","@value":"Creators of written or spoken verse who identify as gay."},{"@language":"nl","@value":"Auteurs van geschreven of gesproken gedichten die zich identificeren als homoman."},{"@language":"sv","@value":"Skapare av poesi som identifierar sig som bögar."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0003663"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-22"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003666","dc:identifier":"homoit0003666","skos:prefLabel":[{"@language":"en","@value":"Bisexual poets"},{"@language":"nl","@value":"Biseksuele dichters"},{"@language":"sv","@value":"Bisexuella poeter"}],"rdfs:comment":[{"@language":"en","@value":"Creators of written or spoken verse who identify as bisexual."},{"@language":"nl","@value":"Auteurs van geschreven of gesproken gedichten die zich identificeren als biseksueel."},{"@language":"sv","@value":"Skapare av poesi som identifierar sig som bisexuella."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0003663"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-22"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003667","dc:identifier":"homoit0003667","skos:prefLabel":[{"@language":"en","@value":"Transgender poets"},{"@language":"nl","@value":"Transgender dichters"},{"@language":"sv","@value":"Transpoeter"}],"skos:altLabel":{"@language":"en","@value":"Trans poets"},"rdfs:comment":[{"@language":"en","@value":"Creators of written or spoken verse who identify as transgender."},{"@language":"nl","@value":"Auteurs van geschreven of gesproken gedichten die zich identificeren als transgender."},{"@language":"sv","@value":"Skapare av poesi som identifierar sig som transpersoner."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0003663"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-22"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaur