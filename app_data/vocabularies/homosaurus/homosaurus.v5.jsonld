zing."},{"@language":"es","@value":"Personas transgénero que trabajan para lograr cambios políticos o sociales a través de la organización pública."},{"@language":"nl","@value":"Transgender personen die politieke of sociale verandering proberen te bewerkstelligen door middel van publieke acties."},{"@language":"sv","@value":"Transpersoner som verkar för politisk eller social förändring genom offentlig organisering och mobilisering."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000007"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001383"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transgenderPoliticalActivists"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002803","dc:identifier":"homoit0002803","skos:prefLabel":[{"@language":"en","@value":"Asexual political activists"},{"@language":"es","@value":"Activistas políticos asexuales"},{"@language":"de","@value":"Asexuelle politische Aktivist:innen"},{"@language":"nl","@value":"Aseksuele activisten"},{"@language":"sv","@value":"Asexuella politiska aktivister"}],"skos:altLabel":[{"@language":"de","@value":"Asexuelle politisch aktivistische Personen"},{"@language":"de","@value":"Politisch akivistische Asexuelle"},{"@language":"de","@value":"Ace politisch aktivistische Personen"},{"@language":"de","@value":"Politisch aktivistische Aces"}],"rdfs:comment":[{"@language":"en","@value":"Asexual people working to bring about political or social change through public organizing."},{"@language":"es","@value":"Personas asexuales que trabajan para lograr cambios políticos o sociales mediante la organización pública."},{"@language":"de","@value":"Asexuelle Personen, die sich durch öffentliche Organisation für politische oder soziale Veränderungen einsetzen."},{"@language":"nl","@value":"Aseksuele personen die politieke of sociale verandering proberen te bewerkstelligen door middel van publieke acties."},{"@language":"sv","@value":"Asexuella personer som verkar för politisk eller social förändring genom offentlig organisering och mobilisering."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000007"},{"@id":"https://homosaurus.org/v5/homoit0002758"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-28"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002933","dc:identifier":"homoit0002933","skos:prefLabel":[{"@language":"en","@value":"Intersex political activists"},{"@language":"de","@value":"Inter* Aktivist:innen"},{"@language":"es","@value":"Activistas políticos intersexuales"},{"@language":"nl","@value":"Intersekse activisten"},{"@language":"sv","@value":"Intersexpersoner som är politiska aktivister"}],"skos:altLabel":{"@language":"es","@value":"Activistas políticos intersex"},"rdfs:comment":[{"@language":"en","@value":"Intersex people working to bring about political or social change through public organizing."},{"@language":"de","@value":"Inter* Personen, die sich durch öffentliche Organisation für politische oder soziale Veränderungen einsetzen."},{"@language":"es","@value":"Personas intersex que trabajan para lograr cambios políticos o sociales a través de la organización pública."},{"@language":"nl","@value":"Intersekse personen die politieke of sociale veranderingen proberen te bewerkstelligen door middel van publieke acties."},{"@language":"sv","@value":"Intersexpersoner som verkar för politisk eller social förändring genom offentlig organisering och mobilisering."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000007"},{"@id":"https://homosaurus.org/v5/homoit0002751"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-30"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004329","dc:identifier":"homoit0004329","skos:prefLabel":[{"@language":"en","@value":"Non-binary political activists"},{"@language":"nl","@value":"Non-binaire activisten"},{"@language":"sv","@value":"Ickebinära politiska aktivister"}],"skos:altLabel":{"@language":"en","@value":"Nonbinary political activists"},"rdfs:comment":[{"@language":"en","@value":"Non-binary people working to bring about political or social change through public organizing."},{"@language":"nl","@value":"Non-binaire personen die zich inzetten voor politieke of sociale verandering door middel van publieke acties."},{"@language":"sv","@value":"Ickebinära personer som verkar för politisk eller social förändring genom offentlig organisering och mobilisering."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000007"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0004330"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2026-02-23"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001905","dc:identifier":"homoit0001905","skos:prefLabel":[{"@language":"en","@value":"Zaps"},{"@language":"es","@value":"Zaps"},{"@language":"fr","@value":"Zaps"},{"@language":"nl","@value":"Zaps"},{"@language":"sv","@value":"Zaps"}],"rdfs:comment":[{"@language":"en","@value":"Popularized by the gay liberation group Gays Activists Alliance, zaps are public demonstrations focused on confronting or embarrassing specific politicians or public officials while calling attention to the liberation movement."},{"@language":"es","@value":"Popularizados por el grupo de liberación gay Alianza de Activistas Gay, los zaps son manifestaciones públicas centradas en confrontar o avergonzar a políticos o funcionarios públicos específicos mientras llaman atención sobre el movimiento de liberación."},{"@language":"fr","@value":"Manifestations publiques organisées pour confronter ou à mettre dans l'embarras des politicien·nes ou fonctionnaires, tout en attirant l'attention sur le mouvement de libération gaie. Terme popularisé par le groupe de libération gaie Gays Activists Alliance."},{"@language":"nl","@value":"Gepopulariseerd door de homobevrijdingsgroep Gays Activists Alliance, zijn zaps openbare demonstraties gericht op het confronteren of in verlegenheid brengen van specifieke politici of ambtenaren, terwijl de aandacht wordt gevestigd op de bevrijdingsbeweging"},{"@language":"sv","@value":"Zaps är offentliga aktioner som populariserades av homosexuella befrielsegruppen Gays Activists Alliance. De syftar till att konfrontera eller genera enskilda politiker eller offentliga företrädare, samtidigt som de riktar uppmärksamhet mot den homosexuella befrielserörelsen."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000851"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000007"},{"@id":"https://homosaurus.org/v5/homoit0001026"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000006"},"dc:issued":{"@type":"xsd:date","@value":"2022-03-29"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002657","dc:identifier":"homoit0002657","skos:prefLabel":[{"@language":"en","@value":"Two-Spirit political activists "},{"@language":"es","@value":"Activistas políticos dos espíritus"},{"@language":"nl","@value":"Two-Spirit activisten"},{"@language":"sv","@value":"Politiska Two-spirit-aktivister"}],"skos:altLabel":[{"@language":"en","@value":"2S political activists "},{"@language":"en","@value":"Two Spirit political activists "},{"@language":"en","@value":"Two Spirited political activists "},{"@language":"en","@value":"Two-Spirited political activists "}],"rdfs:comment":[{"@language":"en","@value":"Two-Spirit people working to bring about political or social change through public organizing."},{"@language":"es","@value":"Personas dos espíritus que trabajan para lograr cambios políticos o sociales mediante la organización pública."},{"@language":"nl","@value":"Two-Spirit people die politieke of sociale veranderingen tot stand proberen te brengen door middel van activisme."},{"@language":"sv","@value":"Two-spirit-personer som verkar för politisk eller social förändring genom offentlig organisering och mobilisering."}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000007"},{"@id":"https://homosaurus.org/v5/homoit0002656"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0002657"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-26"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000008","dc:identifier":"homoit0000008","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ actors"},{"@language":"ja","@value":"LGBTQ+の俳優"},{"@language":"es","@value":"Actores LGBTQ+"},{"@language":"nl","@value":"LHBTQ+-acteurs"},{"@language":"sv","@value":"Hbtq+-skådespelare"}],"skos:altLabel":[{"@language":"en","@value":"Actors (LGBTQ)"},{"@language":"en","@value":"Actresses (LGBTQ)"},{"@language":"en","@value":"LGBTQ actors"},{"@language":"ja","@value":"俳優（LGBTQ）"},{"@language":"ja","@value":"女優（LGBTQ）"},{"@language":"ja","@value":"LGBTQの俳優"},{"@language":"es","@value":"Actores LGBTQ"},{"@language":"es","@value":"Actores (LGBTQ)"},{"@language":"es","@value":"Actorxs LGBTQ+"},{"@language":"nl","@value":"Actrices (LHBTQ+)"}],"rdfs:comment":[{"@language":"en","@value":"LGBTQ+ people who act in stage plays, movies, television shows, broadcasts, or other productions."},{"@language":"ja","@value":"舞台劇、映画、テレビ番組、放送番組、その他の制作物に出演するLGBTQ+の人々。"},{"@language":"es","@value":"Personas LGBTQ+ que actúan en obras de teatro, películas, programas de televisión, transmisiones u otras producciones."},{"@language":"nl","@value":"LHBTQ+-personen die optreden in toneelstukken, films, televisieshows, uitzendingen of andere producties."},{"@language":"sv","@value":"Hbtq+-personer som agerar i scenproduktioner, filmer, tv-program, radiosändningar eller andra produktioner."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000915"},"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0003798"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000816"},{"@id":"https://homosaurus.org/v5/homoit0002142"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQActors"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003798","dc:identifier":"homoit0003798","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ porn stars"},{"@language":"nl","@value":"LHBTQ+-pornosterren"},{"@language":"sv","@value":"Hbtq+-porrstjärnor"}],"skos:altLabel":[{"@language":"en","@value":"LGBTQ+ pornstars"},{"@language":"en","@value":"LGBTQ+ porn actors"},{"@language":"en","@value":"LGBTQ+ porn actresses"},{"@language":"en","@value":"Porn stars (LGBTQ)"},{"@language":"en","@value":"Pornstars (LGBTQ)"},{"@language":"en","@value":"Porn actors (LGBTQ)"},{"@language":"en","@value":"Porn actresses (LGBTQ)"},{"@language":"en","@value":"LGBTQ+ adult entertainers"},{"@language":"en","@value":"Adult entertainers (LGBTQ)"},{"@language":"nl","@value":"LHBTQ+-pornoactrices"},{"@language":"nl","@value":"Pornoacteurs (LHBTQ)"},{"@language":"nl","@value":"Pornoactrices (LHBTQ)"},{"@language":"nl","@value":"Pornosterren (LHBTQ)"}],"rdfs:comment":[{"@language":"en","@value":"LGBTQ+ actors in erotic or sexually explicit films."},{"@language":"nl","@value":"LGBTQ+ acteurs in erotische of seksueel expliciete films."},{"@language":"sv","@value":"Hbtq+-skådespelare i erotiska eller sexuellt explicita filmer."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001127"},{"@id":"https://homosaurus.org/v5/homoit0000008"},{"@id":"https://homosaurus.org/v5/homoit0001277"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000013"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0003758"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-30"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000816","dc:identifier":"homoit0000816","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ arts"},{"@language":"es","@value":"Artes LGBTQ+"},{"@language":"ja","@value":"LGBTQ+のアート"},{"@language":"ja","@value":"LGBTQ+の芸術"},{"@language":"nl","@value":"LHBTQ+-kunsten"},{"@language":"sv","@value":"Hbtq+-konst"}],"skos:altLabel":[{"@language":"en","@value":"LGBTQ arts"},{"@language":"es","@value":"Artes LGBTQ"},{"@language":"ja","@value":"LGBTQのアート"},{"@language":"ja","@value":"LGBTQの芸術"}],"rdfs:comment":[{"@language":"en","@value":"Umbrella term for different forms of creative activity, including visual, material, and performing arts, by LGBTQ+ artists or about LGBTQ+ topics and communities. Use a more specific term if possible."},{"@language":"es","@value":"Término general para diferentes formas de actividad creativa, incluidas las artes visuales, materiales y escénicas, realizadas por artistas LGBTQ+ o sobre temas y comunidades LGBTQ+. Utilícese un término más específico de ser posible."},{"@language":"ja","@value":"LGBTQ+のアーティストによる、あるいはLGBTQ+のテーマやコミュニティを扱った、視覚芸術、工芸、舞台芸術など、さまざまな形態の創造的活動を総称する言葉。可能であれば、より具体的な用語を使用してください。"},{"@language":"nl","@value":"Overkoepelende term voor verschillende vormen van creatieve activiteit, waaronder visuele, materiële en podiumkunsten, door LHBTQ+-artiesten of over LHBTQ+-onderwerpen en -gemeenschappen. Gebruik indien mogelijk een specifiekere term."},{"@language":"sv","@value":"Paraplyterm för olika former av konstnärligt skapande, inklusive bildkonst, materiell konst och scenkonst, skapade av hbtq+konstnärer eller som skildrar hbtq+-gemenskaper och teman. Använd en mer specifik term om möjligt."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001831"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0001031"},{"@id":"https://homosaurus.org/v5/homoit0002327"},{"@id":"https://homosaurus.org/v5/homoit0002579"},{"@id":"https://homosaurus.org/v5/homoit0002596"},{"@id":"https://homosaurus.org/v5/homoit0002598"},{"@id":"https://homosaurus.org/v5/homoit0002599"},{"@id":"https://homosaurus.org/v5/homoit0002600"},{"@id":"https://homosaurus.org/v5/homoit0002601"},{"@id":"https://homosaurus.org/v5/homoit0002602"},{"@id":"https://homosaurus.org/v5/homoit0002603"},{"@id":"https://homosaurus.org/v5/homoit0002604"},{"@id":"https://homosaurus.org/v5/homoit0002605"},{"@id":"https://homosaurus.org/v5/homoit0002886"},{"@id":"https://homosaurus.org/v5/homoit0003610"},{"@id":"https://homosaurus.org/v5/homoit0003662"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000008"},{"@id":"https://homosaurus.org/v5/homoit0000070"},{"@id":"https://homosaurus.org/v5/homoit0000367"},{"@id":"https://homosaurus.org/v5/homoit0000403"},{"@id":"https://homosaurus.org/v5/homoit0000815"},{"@id":"https://homosaurus.org/v5/homoit0000833"},{"@id":"https://homosaurus.org/v5/homoit0000869"},{"@id":"https://homosaurus.org/v5/homoit0000908"},{"@id":"https://homosaurus.org/v5/homoit0000972"},{"@id":"https://homosaurus.org/v5/homoit0001051"},{"@id":"https://homosaurus.org/v5/homoit0001052"},{"@id":"https://homosaurus.org/v5/homoit0001363"},{"@id":"https://homosaurus.org/v5/homoit0001755"},{"@id":"https://homosaurus.org/v5/homoit0002201"},{"@id":"https://homosaurus.org/v5/homoit0002597"},{"@id":"https://homosaurus.org/v5/homoit0003991"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQArts"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002142","dc:identifier":"homoit0002142","skos:prefLabel":[{"@language":"en","@value":"Actorfic"},{"@language":"es","@value":"Actorfic"},{"@language":"de","@value":"Schauspieler:innen-Fanfiction"},{"@language":"nl","@value":"Actorfic"},{"@language":"sv","@value":"Actorfic"}],"skos:altLabel":[{"@language":"en","@value":"Actor fanfic"},{"@language":"en","@value":"Actor fic"},{"@language":"es","@value":"Actor fanfic"},{"@language":"es","@value":"Actor fic"},{"@language":"de","@value":"Actorfic"},{"@language":"de","@value":"Schauspieler-Fanfiction"},{"@language":"nl","@value":"Actor fic"}],"rdfs:comment":[{"@language":"en","@value":"Fanfiction that focuses on, incorporates, or details the relationships of real-life actors, often of the same sex or gender."},{"@language":"es","@value":"Fanfiction que se centra, incorpora o detalla las relaciones de actores de la vida real, a menudo del mismo sexo o género."},{"@language":"de","@value":"Fanfiction, die sich auf die Beziehungen von realen Schauspielern, oft desselben Geschlechts, konzentriert, diese einbezieht oder detailliert beschreibt."},{"@language":"nl","@value":"Fanfictie die zich richt op, incorporeert of details geeft over de relaties van echte acteurs, vaak van hetzelfde geslacht of gender"},{"@language":"sv","@value":"Fanfiction som fokuserar på, innehåller eller beskriver relationerna mellan verkliga skådespelare, ofta av samma kön."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0002196"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000008"},{"@id":"https://homosaurus.org/v5/homoit0000869"},{"@id":"https://homosaurus.org/v5/homoit0001806"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001345"},"dc:issued":{"@type":"xsd:date","@value":"2022-07-04"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000009","dc:identifier":"homoit0000009","skos:prefLabel":[{"@language":"en","@value":"Adoptive parenthood"},{"@language":"es","@value":"Maternidad adoptiva / Paternidad adoptiva"},{"@language":"de","@value":"Adoptivelternschaft"},{"@language":"nl","@value":"Adoptief Ouderschap"},{"@language":"sv","@value":"Adoptivföräldraskap"}],"skos:altLabel":[{"@language":"es","@value":"Maternidad adoptiva"},{"@language":"es","@value":"Paternidad adoptiva"}],"rdfs:comment":[{"@language":"en","@value":"The experience of being an adoptive parent to a child or children. An adoptive parent is the person or persons who become permanent parents through adoption with all the responsibilities therein."},{"@language":"es","@value":"La experiencia de ser madre adoptiva o padre adoptivo de un(a) niño(a) o niños(as). Es la persona o las personas que se convierten en madres o padres permanentes mediante la adopción con todas las responsabilidades que ello implica."},{"@language":"de","@value":"Die Erfahrung, ein Adoptivelternteil für ein Kind oder mehrere Kinder zu sein. Ein Adoptivelternteil ist die Person oder die Personen, die durch eine Adoption zu dauerhaften Eltern werden, mit allen damit verbundenen Pflichten."},{"@language":"nl","@value":"De ervaring om adoptieouder te zijn van een kind of kinderen. Een adoptieouder is de persoon of personen die door adoptie permanente ouders worden met alle verantwoordelijkheden die daarbij horen."},{"@language":"sv","@value":"Erfarenheten av att vara adoptivförälder till ett eller flera barn. En adoptivförälder är en person eller personer som genom adoption blir barnets permanenta föräldrar med allt ansvar som det innebär."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000914"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000451"},{"@id":"https://homosaurus.org/v5/homoit0000809"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000914"},"dc:replaces":{"@id":"http://homosaurus.org/v2/adoptiveParenthood"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000914","dc:identifier":"homoit0000914","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ parenthood"},{"@language":"es","@value":"Maternidad y paternidad LGBTQ+"},{"@language":"nl","@value":"LHBTQ+-ouderschap"},{"@language":"sv","@value":"Hbtq+-föräldraskap"}],"skos:altLabel":[{"@language":"en","@value":"Parenting"},{"@language":"en","@value":"LGBTQ parenthood"},{"@language":"es","@value":"Paternidad LGBTQ+"},{"@language":"es","@value":"Maternidad LGBTQ+"},{"@language":"sv","@value":"Föräldaskap (hbtq+)"}],"rdfs:comment":[{"@language":"en","@value":"The experiences of being an LGBTQ+ parent and the responsibilities involved."},{"@language":"es","@value":"Las experiencias de ser padre LGBTQ+ y las responsabilidades que implica."},{"@language":"nl","@value":"De ervaring om een LHBTQ+-ouder te zijn en de verantwoordelijkheden die daarbij komen kijken."},{"@language":"sv","@value":"Föräldraskapserfarenheter så som de upplevs av hbtq+-personer."}],"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000009"},{"@id":"https://homosaurus.org/v5/homoit0000116"},{"@id":"https://homosaurus.org/v5/homoit0000811"},{"@id":"https://homosaurus.org/v5/homoit0000812"},{"@id":"https://homosaurus.org/v5/homoit0000839"},{"@id":"https://homosaurus.org/v5/homoit0000866"},{"@id":"https://homosaurus.org/v5/homoit0000871"},{"@id":"https://homosaurus.org/v5/homoit0000905"},{"@id":"https://homosaurus.org/v5/homoit0000945"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000347"},{"@id":"https://homosaurus.org/v5/homoit0000420"},{"@id":"https://homosaurus.org/v5/homoit0000583"},{"@id":"https://homosaurus.org/v5/homoit0000809"},{"@id":"https://homosaurus.org/v5/homoit0000819"},{"@id":"https://homosaurus.org/v5/homoit0000870"},{"@id":"https://homosaurus.org/v5/homoit0001001"},{"@id":"https://homosaurus.org/v5/homoit0001074"},{"@id":"https://homosaurus.org/v5/homoit0001075"},{"@id":"https://homosaurus.org/v5/homoit0001093"},{"@id":"https://homosaurus.org/v5/homoit0001176"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000914"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQParenthood"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000451","dc:identifier":"homoit0000451","skos:prefLabel":[{"@language":"en","@value":"Social parenthood"},{"@language":"es","@value":"Paternidad social"},{"@language":"nl","@value":"Sociaal ouderschap"},{"@language":"sv","@value":"Socialt föräldraskap"}],"skos:altLabel":[{"@language":"en","@value":"Foster parenthood"},{"@language":"es","@value":"Familias de acogida"}],"rdfs:comment":[{"@language":"en","@value":"A basis of parenthood understood to be in opposition to biological parenthood, that challenges the assumption that parenthood presupposes blood relation. Social parenthood is the full- or part-time care, nurturing, and protection of a child by an adult who has taken on that duty. "},{"@language":"es","@value":"Una base de la paternidad entendida como opuesta a la paternidad biológica, que desafía la suposición de que la paternidad presupone una relación de sangre. La paternidad social es el cuidado, la crianza y la protección a tiempo completo o parcial de un niño por parte de un adulto que ha asumido ese deber."},{"@language":"nl","@value":"Een vorm van ouderschap die in strijd is met biologisch ouderschap, die de veronderstelling uitdaagt dat ouderschap bloedverwantschap veronderstelt. Sociaal ouderschap is de volledige of parttime zorg, opvoeding en bescherming van een kind door een volwassene die die taak op zich heeft genomen."},{"@language":"sv","@value":"En form av föräldraskap som utmanar antagandet att föräldraskap förutsätter biologiskt släktskap. Socialt föräldraskap innebär helt eller delvis ansvar för barnets vård, omsorg och skydd."}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000009"},{"@id":"https://homosaurus.org/v5/homoit0000010"},{"@id":"https://homosaurus.org/v5/homoit0000116"},{"@id":"https://homosaurus.org/v5/homoit0000452"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000451"},"dc:replaces":{"@id":"http://homosaurus.org/v2/socialParenthood"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000809","dc:identifier":"homoit0000809","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ adoption"},{"@language":"es","@value":"Adopción LGBTQ+"},{"@language":"ja","@value":"LGBTQ+による養子縁組"},{"@language":"nl","@value":"LHBTQ+-adoptie"},{"@language":"sv","@value":"Adoption (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"LGBTQ adoption"},{"@language":"es","@value":"Adopción (LGBTQ)"},{"@language":"ja","@value":"LGBTQによる養子縁組"}],"rdfs:comment":[{"@language":"en","@value":"Adoption of a child or children, either by legal or informal processes, by LGBTQ+ people. "},{"@language":"es","@value":"La adopción de un niño o niños, ya sea por procesos legales o informales, por personas LGBTQ+."},{"@language":"ja","@value":"LGBTQ+の人々による、法的な手続きまたは非公式な手続きを通じた、1人または複数の子どもの養子縁組。"},{"@language":"nl","@value":"Adoptie van een kind of kinderen, via legale of informele processen, door LHBTQ+-personen."},{"@language":"sv","@value":"Adoption av barn, antingen genom juridiska eller informella processer, av hbtq+-personer."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000864"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0000304"},{"@id":"https://homosaurus.org/v5/homoit0000811"},{"@id":"https://homosaurus.org/v5/homoit0000812"},{"@id":"https://homosaurus.org/v5/homoit0000821"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000009"},{"@id":"https://homosaurus.org/v5/homoit0000010"},{"@id":"https://homosaurus.org/v5/homoit0000121"},{"@id":"https://homosaurus.org/v5/homoit0000254"},{"@id":"https://homosaurus.org/v5/homoit0000260"},{"@id":"https://homosaurus.org/v5/homoit0000420"},{"@id":"https://homosaurus.org/v5/homoit0000810"},{"@id":"https://homosaurus.org/v5/homoit0000870"},{"@id":"https://homosaurus.org/v5/homoit0000914"},{"@id":"https://homosaurus.org/v5/homoit0000918"},{"@id":"https://homosaurus.org/v5/homoit0001075"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000864"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQAdoption"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000010","dc:identifier":"homoit0000010","skos:prefLabel":[{"@language":"en","@value"