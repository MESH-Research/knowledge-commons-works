s"},{"@language":"es","@value":"No binarixs judíxs"},{"@language":"nl","@value":"Non-binaire Joden"},{"@language":"nl","@value":"Nonbinaire Joden"},{"@language":"sv","@value":"Ickebinära judar"}],"rdfs:comment":[{"@language":"en","@value":"Non-binary people who are Jewish."},{"@language":"es","@value":"Personas no binarixs que son judías."},{"@language":"nl","@value":"Non-binaire personen die Joods zijn."},{"@language":"sv","@value":"Ickebinära personer som är judar."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000682"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2024-07-11"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000696","dc:identifier":"homoit0000696","skos:prefLabel":[{"@language":"en","@value":"Labrys"},{"@language":"es","@value":"Labrys"},{"@language":"de","@value":"Doppelaxt"},{"@language":"fr","@value":"Labrys"},{"@language":"nl","@value":"Labrys"},{"@language":"sv","@value":"Dubbeleggad yxa"}],"skos:altLabel":[{"@language":"de","@value":"Labrys"},{"@language":"sv","@value":"Dubbelyxa"},{"@language":"sv","@value":"Labrys"}],"rdfs:comment":[{"@language":"en","@value":"Symbol used to represent lesbianism and feminism."},{"@language":"es","@value":"Símbolo utilizado para representar el lesbianismo y el feminismo."},{"@language":"de","@value":"Symbol, das für Lesbentum und Feminismus steht."},{"@language":"fr","@value":"Symbole parfois utilisé pour représenter le lesbianisme et le féminisme. Le labrys est une hache à double tranchant associée dans l'imaginaire aux Amazones d'où sa réappropriation par les mouvements féministes et lesbiens."},{"@language":"nl","@value":"lesbisch en feministisch symbool"},{"@language":"sv","@value":"Symbol som används för att representera lesbiskhet och feminism."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000954"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000954"},"dc:replaces":{"@id":"http://homosaurus.org/v2/labrys"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000698","dc:identifier":"homoit0000698","skos:prefLabel":[{"@language":"en","@value":"Lambda"},{"@language":"es","@value":"Lambda"},{"@language":"de","@value":"Lambda"},{"@language":"nl","@value":"Lambda"},{"@language":"sv","@value":"Lambda"}],"rdfs:comment":[{"@language":"en","@value":"Symbol for lesbian and gay rights."},{"@language":"es","@value":"Símbolo de los derechos de lesbianas y hombres gay."},{"@language":"de","@value":"Symbol für lesbische und schwule Rechte."},{"@language":"nl","@value":"symbool voor lesbische en homorechten"},{"@language":"sv","@value":"Symbol för homosexuellas rättigheter."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000954"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000954"},"dc:replaces":{"@id":"http://homosaurus.org/v2/lambda"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000700","dc:identifier":"homoit0000700","skos:prefLabel":[{"@language":"en","@value":"Latex gloves"},{"@language":"es","@value":"Guantes de latex"},{"@language":"de","@value":"Latexhandschuhe"},{"@language":"nl","@value":"Latex handschoenen"},{"@language":"sv","@value":"Latexhandskar"}],"rdfs:comment":[{"@language":"en","@value":"Protective coverings for the hands made from latex, a thin-plastic like material; often used as a barrier to protect against STIs while engaging in safer sex practices."},{"@language":"es","@value":"Cubiertas protectoras de látex, un material fino parecido al plástico, para las manos; a menudo se utilizan como barrera para protegerse de las ITS mientras se practican relaciones sexuales seguras."},{"@language":"de","@value":"Handschutz aus Latex, einem dünnen, kunststoffähnlichen Material; wird häufig als Barriere zum Schutz vor sexuell übertragbaren Infektionen bei Safer-Sex-Praktiken verwendet."},{"@language":"nl","@value":"Beschermende bedekkingen voor de handen gemaakt van latex, een dun plastic-achtig materiaal; vaak gebruikt als bescherming tegen soa's bij het veiliger vrijen."},{"@language":"sv","@value":"Skyddande handbeklädnad tillverkad av latex eller ett tunt plastliknande material. Används ofta som barriär för att skydda mot sexuellt överförbara infektioner vid säkrare sexpraktiker."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001266"},{"@id":"https://homosaurus.org/v5/homoit0003111"}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001251"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001266"},"dc:replaces":{"@id":"http://homosaurus.org/v2/latexGloves"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003111","dc:identifier":"homoit0003111","skos:prefLabel":[{"@language":"en","@value":"Gloves (Erotic)"},{"@language":"es","@value":"Guantes (erótico)"},{"@language":"de","@value":"Handschuhe"},{"@language":"nl","@value":"Handschoenen"},{"@language":"sv","@value":"Handskar (erotik)"}],"rdfs:comment":[{"@language":"en","@value":"A garment covering the hand and used in kink or erotic play."},{"@language":"es","@value":"Una prenda para vestir que cubre la mano y se utiliza para juegos kinki o eróticos."},{"@language":"de","@value":"Ein Kleidungsstück, das die Hand bedeckt und bei Kink- oder Erotikspielen verwendet wird."},{"@language":"nl","@value":"Een kledingstuk dat de hand bedekt en gebruikt wordt bij kink of erotisch spel."},{"@language":"sv","@value":"Ett plagg som täcker handen och används i kink- eller erotisk aktivitet."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0001266"},{"@id":"https://homosaurus.org/v5/homoit0003066"}],"skos:narrower":{"@id":"https://homosaurus.org/v5/homoit0000700"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0003053"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001266"},"dc:issued":{"@type":"xsd:date","@value":"2023-12-20"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0003772","dc:identifier":"homoit0003772","skos:prefLabel":[{"@language":"en","@value":"Sex work legislation"},{"@language":"nl","@value":"Sekswerk-wetgeving"},{"@language":"sv","@value":"Prostitutionslagstiftning"}],"skos:altLabel":[{"@language":"en","@value":"Sex work laws"},{"@language":"en","@value":"Prostitution legislation"},{"@language":"en","@value":"Prostitution laws"},{"@language":"nl","@value":"Prostitutie-wetten"},{"@language":"nl","@value":"Sekswerk-wetten"},{"@language":"sv","@value":"Sexarbeteslagstiftning"}],"rdfs:comment":[{"@language":"en","@value":"Laws and regulations addressing the practice, solitiation, and/or facilitation of sex work, including its legality. Legislation may variously address the actions of sex workers, their clients, third parties, and/or other individuals who work in proximity to or seek to aid sex workers."},{"@language":"nl","@value":"Wetten en regels die betrekking hebben op de praktijk, werving en/of facilitering van sekswerk, inclusief de legaliteit ervan. Wetgeving kan op verschillende manieren betrekking hebben op de acties van sekswerkers, hun cliënten, derden en/of andere personen die in de buurt van sekswerkers werken of sekswerkers willen helpen."},{"@language":"sv","@value":"Lagar och regler som reglerar utövande, uppsökande och/eller förmedling av sexarbete och/eller prostitution, inklusive dess rättsliga status. Lagstiftning kan rikta sig mot sexarbetare och/eller personer i prostitution, kunder, tredje parter eller andra personer som arbetar i närhet till eller bistår sexarbetare och/eller personer i prostitution."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000702"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0003775"},{"@id":"https://homosaurus.org/v5/homoit0003776"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0003773"},{"@id":"https://homosaurus.org/v5/homoit0003774"}],"skos:exactMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2013003427"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000702"},"dc:issued":{"@type":"xsd:date","@value":"2024-10-30"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000893","dc:identifier":"homoit0000893","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ lobbying"},{"@language":"es","@value":"Cabildeo LGBTQ+"},{"@language":"nl","@value":"LHBTQ+-lobbyen"},{"@language":"sv","@value":"Lobbying (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"LGBTQ lobbying"},{"@language":"es","@value":"Cabildeo LGBTQ"},{"@language":"es","@value":"Lobbying LGBTQ+"},{"@language":"es","@value":"Lobbying LGBTQ"}],"rdfs:comment":[{"@language":"en","@value":"Actions taken by individuals or groups to influence legislative action (or non-action), policies, or decisions of government officials in favor of LGBTQ+ people, communities, or issues."},{"@language":"es","@value":"Acciones tomadas por personas o grupos para influir en la acción (o inacción) legislativa, las políticas o las decisiones de funcionarios gubernamentales, a favor de personas, comunidades o asuntos LGBTQ+."},{"@language":"nl","@value":"Inspanningen ondernomen door personen of groepen om wetgevende actie (of niet-actie), beleid of beslissingen van overheidsfunctionarissen ten gunste van LHBTQ+-personen, -gemeenschappen of -kwesties te beïnvloeden"},{"@language":"sv","@value":"Åtgärder vidtagna av individer eller grupper för att påverka lagstiftning, policy eller beslut av offentliga tjänstemän till förmån för hbtq+-personer, gemenskaper eller frågor."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000853"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0000702"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000006"},"dc:replaces":{"@id":"http://homosaurus.org/v2/LGBTQLobbying"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001482","dc:identifier":"homoit0001482","skos:prefLabel":[{"@language":"en","@value":"Undocumented LGBTQ+ residents"},{"@language":"es","@value":"Residentes LGBTQ+ indocumentados"},{"@language":"nl","@value":"Ongedocumenteerde LHBTQ+-personen"},{"@language":"sv","@value":"Papperslösa hbtq+-personer"}],"skos:altLabel":[{"@language":"en","@value":"Undocumented LGBTQ residents"},{"@language":"es","@value":"Residentes LGBTQ indocumentados"}],"rdfs:comment":[{"@language":"en","@value":"LGBTQ+ people who do not have official documentation to remain legal residents of the countries in which they live."},{"@language":"es","@value":"Personas LGBTQ+ que no cuentan con documentación oficial para seguir siendo residentes legales de los países en los que viven."},{"@language":"nl","@value":"LHBTQ+-personen die geen officiële documenten hebben om legaal te verblijven in de landen waarin ze wonen"},{"@language":"sv","@value":"Hbtq+-personer som saknar giltiga tillstånd för att lagligt vistas i det land där de bor."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000915"},"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000702"},{"@id":"https://homosaurus.org/v5/homoit0000712"},{"@id":"https://homosaurus.org/v5/homoit0000860"},{"@id":"https://homosaurus.org/v5/homoit0000883"},{"@id":"https://homosaurus.org/v5/homoit0000902"},{"@id":"https://homosaurus.org/v5/homoit0000927"},{"@id":"https://homosaurus.org/v5/homoit0001108"},{"@id":"https://homosaurus.org/v5/homoit0001815"},{"@id":"https://homosaurus.org/v5/homoit0001853"}],"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/undocumentedLGBTQResidents"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0004414","dc:identifier":"homoit0004414","skos:prefLabel":[{"@language":"en","@value":"LGBTQ+ lawyers"},{"@language":"nl","@value":"LHBTQ+-advocaten"},{"@language":"sv","@value":"Jurister (hbtq+)"}],"skos:altLabel":[{"@language":"en","@value":"LGBTQ+ solicitors"},{"@language":"en","@value":"LGBTQ+ barristers"},{"@language":"en","@value":"LGBTQ+ law practitioners"},{"@language":"sv","@value":"Advokater (hbtq+)"}],"rdfs:comment":[{"@language":"en","@value":"LGBTQ+ people who are licensed to provide legal advice, draft legal documents, and represent others in legal matters."},{"@language":"nl","@value":"LHBTQ+-personen die bevoegd zijn om juridisch advies te geven, juridische documenten op te stellen en anderen te vertegenwoordigen in juridische zaken."},{"@language":"sv","@value":"Hbtq+-personer som har juridisk examen och ger juridisk rådgivning, utarbetar juridiska dokument och företräder andra i juridiska frågor."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0000915"},"skos:narrower":[{"@id":"https://homosaurus.org/v5/homoit0004415"},{"@id":"https://homosaurus.org/v5/homoit0004416"},{"@id":"https://homosaurus.org/v5/homoit0004417"},{"@id":"https://homosaurus.org/v5/homoit0004418"},{"@id":"https://homosaurus.org/v5/homoit0004419"},{"@id":"https://homosaurus.org/v5/homoit0004420"},{"@id":"https://homosaurus.org/v5/homoit0004422"},{"@id":"https://homosaurus.org/v5/homoit0004423"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000702"},{"@id":"https://homosaurus.org/v5/homoit0004421"},{"@id":"https://homosaurus.org/v5/homoit0004391"}],"skos:closeMatch":{"@id":"http://id.loc.gov/authorities/subjects/sh2005002146"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2026-02-24"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000704","dc:identifier":"homoit0000704","skos:prefLabel":[{"@language":"en","@value":"Leashes"},{"@language":"de","@value":"Leine"},{"@language":"es","@value":"Correas"},{"@language":"nl","@value":"Riemen"},{"@language":"sv","@value":"Koppel"}],"skos:altLabel":[{"@language":"de","@value":"Leash"},{"@language":"es","@value":"Correa de perro"}],"rdfs:comment":[{"@language":"en","@value":"A length of rope or similar material used to control an individual, often to increase sexual arousal."},{"@language":"de","@value":"Ein Stück Seil oder ähnliches Material, das dazu dient, eine Person zu fesseln, oft um die sexuelle Erregung zu steigern."},{"@language":"es","@value":"Un trozo de cuerda o material similar utilizado para controlar a una persona, a menudo para aumentar la excitación sexual."},{"@language":"nl","@value":"Een stuk touw of soortgelijk materiaal dat wordt gebruikt om een persoon onder controle te houden, vaak voor seksuele stimulatie"},{"@language":"sv","@value":"Ett rep eller liknande material som används för att kontrollera en person, ofta för att öka sexuell upphetsning."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001266"},"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001238"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0001266"},"dc:replaces":{"@id":"http://homosaurus.org/v2/leashes"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0000706","dc:identifier":"homoit0000706","skos:prefLabel":[{"@language":"en","@value":"Leather daddies"},{"@language":"de","@value":"Lederdaddys"},{"@language":"es","@value":"Papis leather"},{"@language":"nl","@value":"Leather daddies"},{"@language":"sv","@value":"Läderdaddies"}],"skos:altLabel":[{"@language":"de","@value":"Leatherdaddies"},{"@language":"es","@value":"Leather daddies"},{"@language":"es","@value":"Daddies leather"},{"@language":"sv","@value":"Läderpappor"},{"@language":"sv","@value":"Leather daddies"},{"@language":"sv","@value":"Läderfarsor"}],"rdfs:comment":[{"@language":"en","@value":"People who participate in leather communities and identify as leather daddies."},{"@language":"de","@value":"Personen, die in Leder-Communities aktiv sind und sich als Lederdaddys bezeichnen."},{"@language":"es","@value":"Personas que participan en comunidades leather y se autoidentifican como papis leather."},{"@language":"nl","@value":"Personen die participeren in leer gemeenschappen en zich identificeren als \"leather daddies\"."},{"@language":"sv","@value":"Personer som deltar i lädergemenskaper och identifierar sig som leather daddies."}],"skos:broader":[{"@id":"https://homosaurus.org/v5/homoit0000705"},{"@id":"https://homosaurus.org/v5/homoit0003086"}],"skos:related":[{"@id":"https://homosaurus.org/v5/homoit0000707"},{"@id":"https://homosaurus.org/v