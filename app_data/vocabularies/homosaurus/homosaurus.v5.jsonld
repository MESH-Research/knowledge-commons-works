eople in the military"},{"@language":"en","@value":"Two Spirit people in the military"},{"@language":"en","@value":"Two Spirited people in the military"},{"@language":"en","@value":"Two-Spirited people in the military"},{"@language":"es","@value":"Personas dos espíritus en las fuerzas armadas"},{"@language":"de","@value":"Two-Spirit-Militärangehörige"}],"rdfs:comment":[{"@language":"en","@value":"Two-Spirit people serving in state and national armed forces."},{"@language":"es","@value":"Personas dos espíritus que sirven en las fuerzas armadas estatales y nacionales."},{"@language":"de","@value":"Two-Spirit-Personen, die in Streitkräften dienen."},{"@language":"nl","@value":"Two-Spirit people die dienen in staats- en nationale strijdkrachten."},{"@language":"sv","@value":"Two-spirit-personer som tjänstgör inom nationella försvarsstyrkor."}],"skos:related":{"@id":"https://homosaurus.org/v5/homoit0001100"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0002718"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-27"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001146","dc:identifier":"homoit0001146","skos:prefLabel":[{"@language":"en-us","@value":"Queer people of color"},{"@language":"es","@value":"Personas queer de color"},{"@language":"nl","@value":"Queer personen van kleur"},{"@language":"sv","@value":"Queera icke-vita personer"},{"@language":"en-gb","@value":"Queer people of colour"}],"skos:altLabel":[{"@language":"en","@value":"QPOC"},{"@language":"sv","@value":"Queera POC"},{"@language":"sv","@value":"Queera people of color"}],"rdfs:comment":[{"@language":"en","@value":"Primarily used in the United States, this term refers to queer people who are not white and who identify as people of color."},{"@language":"es","@value":"Personas queer que no son blancas y que se autoidentifican como personas de color."},{"@language":"nl","@value":"Queer personen die niet wit zijn en die zich identificeren als personen van kleur."},{"@language":"sv","@value":"Queera personer som inte är vita och som identifierar sig som icke-vita/people of color."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001101"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/queerPeopleOfColour"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0001432","dc:identifier":"homoit0001432","skos:prefLabel":[{"@language":"en-us","@value":"Transgender people of color"},{"@language":"es","@value":"Personas transgénero de color"},{"@language":"nl","@value":"Transgender personen van kleur"},{"@language":"sv","@value":"Ickevita transpersoner"},{"@language":"en-gb","@value":"Transgender people of colour"}],"skos:altLabel":[{"@language":"en","@value":"Trans people of color"},{"@language":"sv","@value":"Transpersoner som är people of color"},{"@language":"sv","@value":"Transpersoner som är POC"}],"rdfs:comment":[{"@language":"en","@value":"Primarily used in the United States, this term refers to transgender people who are not white and who identify as people of color."},{"@language":"es","@value":"Personas transgénero que no son blancas y que se autoidentifican como personas de color."},{"@language":"nl","@value":"Transgender personen die niet wit zijn en die zich identificeren als personen van kleur."},{"@language":"sv","@value":"Transpersoner som inte är vita och som identifierar sig som icke-vita/people of color."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001101"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:replaces":{"@id":"http://homosaurus.org/v2/transgenderPeopleOfColour"},"dc:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dc:modified":{"@type":"xsd:date","@value":"2026-06-30"},"@type":"skos:Concept","skos:inScheme":{"@id":"https://homosaurus.org/v5"},"skos:changeNote":"Version 5.0.0"},{"@id":"https://homosaurus.org/v5/homoit0002755","dc:identifier":"homoit0002755","skos:prefLabel":[{"@language":"en","@value":"Intersex people of color"},{"@language":"de","@value":"Inter* Personen of Color"},{"@language":"es","@value":"Personas intersexuales de color"},{"@language":"nl","@value":"Intersekse personen van kleur"},{"@language":"sv","@value":"Ickevita intersexpersoner"}],"skos:altLabel":[{"@language":"en","@value":"Intersex people of colour"},{"@language":"de","@value":"inter* Menschen of Color"},{"@language":"de","@value":"inter* People of Color"},{"@language":"de","@value":"inter* Menschen von Farbe"},{"@language":"de","@value":"inter* Personen von Farbe"},{"@language":"de","@value":"inter* PoC"},{"@language":"es","@value":"Personas intersex de color"},{"@language":"sv","@value":"POC intersexpersoner"},{"@language":"sv","@value":"Intersexpersoner som är people of color"}],"rdfs:comment":[{"@language":"en","@value":"Primarily used in the United States, this term refers to intersex people who are not white and who identify as people of color."},{"@language":"de","@value":"Inter* Personen, die nicht weiß sind und sich als People of Color identifizieren."},{"@language":"es","@value":"Personas intersex que no son blancas y que se autoidentifican como personas de color."},{"@language":"nl","@value":"Intersekse personen die niet wit zijn en zich identificeren als personen van kleur."},{"@language":"sv","@value":"Intersexpersoner som inte är vita och som identifierar sig som icke-vita/people of color."}],"skos:broader":{"@id":"https://homosaurus.org/v5/homoit0001101"},"skos:hasTopConcept":{"@id":"https://homosaurus.org/v5/homoit0000915"},"dc:issued":{"@type":"xsd:date","@value":"2023-06-27"},"dc:modified":{"@type":"xsd:date","@val